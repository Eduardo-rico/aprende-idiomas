#!/bin/sh
# Rechaza el commit si el typecheck o los tests AFECTADOS fallan. Existe
# porque en E2#30 dos commits salieron con tsc en rojo y uno con vitest en
# rojo: el `| tail` se comía el código de salida y el verde mentía. Lo que
# depende de acordarse, falla; esto no depende de acordarse.
# `vitest run --changed` corre sólo los tests que tocan lo cambiado; la
# suite entera queda para el cierre de sesión y antes de push.
# Activar con: git config core.hooksPath .githooks
#
# ── CHECKOUT COMPARTIDO ─────────────────────────────────────────────
# `tsc` mira TODO el repo y `--changed` mira el ÁRBOL DE TRABAJO, no lo
# que va en el commit. Con tres sesiones a la vez, eso significaba que
# ninguna podía commitear mientras otra estaba a medias, aunque sus rutas
# fueran disjuntas.
#
# LA COMPROBACIÓN AMPLIA SE QUEDA, y a propósito: el 3-sep cazó siete
# errores de `tsc` en un fichero cuyas propias pruebas daban 10/10, porque
# vitest no hace typecheck. Estrecharla a lo staged habría dejado pasar
# justo eso.
#
# ── POR QUÉ SE TOLERA EL ROJO AJENO (2026-09-12) ────────────────────
# La salida hasta hoy era commitear desde un worktree limpio. Funciona,
# pero cuesta **874 MB por worktree** medidos, y este Mac vive entre 0,2 y
# 3 GB libres: hoy el disco llegó a 202 MB con dos worktrees olvidados a
# la vez. Una maniobra que hay que repetir cada hora y que cuesta casi un
# giga no es una salida, es una avería con instrucciones.
#
# Lo que se tolera NO es «rojo ajeno» en general: es el caso en que
# **TODOS** los errores caen en ficheros que este commit no contiene. Y
# eso es correcto por construcción, no una concesión:
#
#   · un fichero sin nada en el índice NO entra en el árbol que produce
#     este commit — si está `untracked` no está, y si está modificado sin
#     stagear, el commit lleva la versión de HEAD;
#   · si algo staged DEPENDE de ese fichero roto, `tsc` reporta también un
#     error EN el fichero staged, y entonces esto falla como siempre.
#
# O sea: se valida **el árbol que el commit produce**, que es la pregunta
# correcta, en vez del directorio de trabajo, que es donde vive el trabajo
# en vuelo de otros. Si algún error cae en un fichero con cambios en el
# índice, el commit se rechaza igual que antes.
set -e

staged() { git diff --cached --name-only; }
# Ajeno = tiene cambios en el árbol o no está trackeado, Y NO tiene nada
# en el índice. Un fichero staged con modificaciones extra NO es ajeno:
# parte de él va en el commit.
ajenos() {
  { git diff --name-only; git ls-files --others --exclude-standard; } \
    | sort -u | comm -23 - "$TMP_STAGED"
}

TMP_STAGED=$(mktemp); TMP_TSC=$(mktemp); TMP_AJENOS=$(mktemp)
limpia() { rm -f "$TMP_STAGED" "$TMP_TSC" "$TMP_AJENOS"; }

de_quien_es() {
  echo ""
  echo "──────────────────────────────────────────────────────────────"
  echo "  pre-commit EN ROJO — antes de tocar nada, mira de quién es."
  echo ""
  echo "  EN TU COMMIT:"
  staged | sed 's/^/      /'
  aj=$(ajenos)
  if [ -n "$aj" ]; then
    echo ""
    echo "  EN EL ÁRBOL PERO NO EN TU COMMIT (otra sesión, probablemente):"
    printf '%s\n' "$aj" | sed 's/^/      /'
    echo ""
    echo "  OJO: la tolerancia al rojo ajeno cubre TSC y cubre VITEST"
    echo "  SÓLO si tu commit no toca código ni tests (docs, .md,"
    echo "  .githooks). Si tu commit lleva código, un vitest rojo por"
    echo "  trabajo ajeno TE BLOQUEA y es correcto: no hay forma barata"
    echo "  de saber si el fallo es del código de otro o del tuyo."
    echo "  --no-verify no lo arregla, lo esconde: espera o pregúntale."
  else
    echo ""
    echo "  El árbol no tiene nada de nadie más: el rojo es tuyo."
  fi
  echo ""
  echo "  ⚠ Y LO PRIMERO, ANTES DE INVESTIGAR: haz \`git reset\`."
  echo "     El ÍNDICE es COMPARTIDO entre las sesiones. Si tu commit se"
  echo "     rechaza y dejas los ficheros staged, el siguiente \`git commit\`"
  echo "     de otra sesión SE LOS LLEVA dentro de su commit. Ya ha pasado"
  echo "     dos veces. No se pierde contenido, pero la autoría y el"
  echo "     mensaje quedan mal — y el mensaje es donde vive el"
  echo "     razonamiento, que es la mitad del trabajo aquí."
  echo "──────────────────────────────────────────────────────────────"
  limpia
}
trap de_quien_es EXIT

staged | sort -u > "$TMP_STAGED"

# ── LA RAMA COMPARTIDA PUEDE PERDER COMMITS EN SILENCIO (2026-09-12) ──
# Un `reset` sobre la rama tiró un commit ya hecho y NADA avisó: el árbol
# de trabajo conservaba los ficheros, los tests pasaban y la cobertura
# salía bien. Sólo se veía mirando fichero a fichero contra HEAD. Y la
# ruta de `git update-ref` desde un worktree siguió adelante desde el
# punto reseteado sin enterarse, cuando un `git commit` normal habría
# dado conflicto.
#
# La señal es barata: si el commit al que apunta `origin` NO es ancestro
# de HEAD, el historial local ha DEJADO DE CONTENER algo que ya estaba
# publicado. Va como AVISO y no como rechazo, porque la misma condición
# se da de forma legítima cuando otra sesión acaba de empujar y tú aún no
# has hecho pull — y bloquear eso pararía el trabajo sin motivo.
rama=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '')
if [ -n "$rama" ] && git rev-parse --verify --quiet "origin/$rama" >/dev/null; then
  if ! git merge-base --is-ancestor "origin/$rama" HEAD 2>/dev/null; then
    echo ""
    echo "  ⚠⚠ TU HEAD NO CONTIENE LO QUE HAY EN origin/$rama."
    echo "     O bien otra sesión empujó y te falta un pull —lo normal—,"
    echo "     o bien un reset se ha llevado commits ya publicados, que es"
    echo "     la avería que no da ningún síntoma: los ficheros siguen en"
    echo "     el árbol y los tests pasan igual."
    echo ""
    echo "     Compruébalo ANTES de seguir:"
    echo "       git fetch origin && git log --oneline HEAD..origin/$rama"
    echo "     Si ahí aparece trabajo que creías tener, NO commitees encima."
    echo ""
  fi
fi

echo "pre-commit: tsc --noEmit"
if ! npx tsc --noEmit > "$TMP_TSC" 2>&1; then
  cat "$TMP_TSC"
  # Ficheros que aparecen en los errores, en formato `ruta(l,c): error TSxxxx`
  culpables=$(sed -n 's/^\([^(]*\)(.*): error TS.*/\1/p' "$TMP_TSC" | sort -u)
  if [ -z "$culpables" ]; then exit 1; fi
  ajenos > "$TMP_AJENOS"
  propios=$(printf '%s\n' "$culpables" | comm -23 - "$TMP_AJENOS")
  if [ -n "$propios" ]; then exit 1; fi
  echo ""
  echo "  ⚠ tsc en rojo, pero TODOS los errores caen en ficheros que este"
  echo "     commit NO contiene (trabajo en vuelo de otra sesión):"
  printf '%s\n' "$culpables" | sed 's/^/       /'
  echo "     El árbol que produce este commit NO los lleva, así que sigue."
  echo ""
fi

# ── VITEST Y EL ROJO AJENO ──────────────────────────────────────────
# La tolerancia de `tsc` no se puede copiar tal cual: un test que falla
# puede estar fallando por un fichero STAGED aunque el test mismo no lo
# esté, y separar eso pide el grafo de importaciones. Así que se tolera
# sólo un caso **demostrablemente** seguro: cuando NADA de lo que va en
# el commit puede ser cargado por un test — commits de documentación, de
# `.md` o del propio hook. Ahí un vitest rojo no puede ser de este
# commit, y punto. Si el commit lleva código, el rojo bloquea aunque sea
# ajeno: es molesto y es correcto, porque la alternativa sería adivinar.
puede_afectar_tests=$(staged | grep -vE '^docs/|^\.githooks/|\.md$' || true)

echo "pre-commit: vitest run --changed"
if ! npx vitest run --changed --passWithNoTests > "$TMP_TSC" 2>&1; then
  cat "$TMP_TSC"
  if [ -n "$puede_afectar_tests" ]; then exit 1; fi
  ajenos > "$TMP_AJENOS"
  if [ ! -s "$TMP_AJENOS" ]; then exit 1; fi
  echo ""
  echo "  ⚠ vitest en rojo, pero este commit sólo lleva documentación:"
  staged | sed 's/^/       /'
  echo "     Nada de eso lo carga un test, así que el rojo NO es de este"
  echo "     commit. Hay trabajo en vuelo de otra sesión en el árbol."
  echo ""
fi

trap - EXIT
limpia
