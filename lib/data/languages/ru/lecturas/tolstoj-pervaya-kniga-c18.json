 "parrafos": [
  {
   "texto": "Задумал дурень"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати."
  },
  {
   "texto": "Увидел дурень"
  },
  {
   "texto": "Две избы пусты;"
  },
  {
   "texto": "Глянул в подполье:"
  },
  {
   "texto": "В подполье черти,"
  },
  {
   "texto": "Востроголовы,"
  },
  {
   "texto": "Глаза, что ложки,"
  },
  {
   "texto": "Усы, что вилы,"
  },
  {
   "texto": "Руки, что грабли,"
  },
  {
   "texto": "В карты играют,"
  },
  {
   "texto": "Костью бросают,"
  },
  {
   "texto": "Деньги считают."
  },
  {
   "texto": "Дурень им молвил:"
  },
  {
   "texto": "«Бог да на помочь"
  },
  {
   "texto": "Вам, добрым людям»."
  },
  {
   "texto": "Черти не любят, —"
  },
  {
   "texto": "Схватили дурня,"
  },
  {
   "texto": "Зачали бити,"
  },
  {
   "texto": "Стали давити,"
  },
  {
   "texto": "Еле живого"
  },
  {
   "texto": "Дурня пустили."
  },
  {
   "texto": "Приходит дурень"
  },
  {
   "texto": "Домой, сам плачет,"
  },
  {
   "texto": "На голос воет."
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена пеняти,"
  },
  {
   "texto": "Сестра-то тоже:"
  },
  {
   "texto": "«Дурень ты дурень,"
  },
  {
   "texto": "Глупый ты Бабин,"
  },
  {
   "texto": "То же ты слово"
  },
  {
   "texto": "Не так бы молвил;"
  },
  {
   "texto": "А ты бы молвил:"
  },
  {
   "texto": "„Будь ты, враг, проклят"
  },
  {
   "texto": "Имем господним!“"
  },
  {
   "texto": "Черти ушли бы,"
  },
  {
   "texto": "Тебе бы, дурню,"
  },
  {
   "texto": "Деньги достались"
  },
  {
   "texto": "Заместо клада»."
  },
  {
   "texto": "«Добро же, баба,"
  },
  {
   "texto": "Ты, бабариха."
  },
  {
   "texto": "Матерь Лукерья,"
  },
  {
   "texto": "Сестра Чернава,"
  },
  {
   "texto": "Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати."
  },
  {
   "texto": "Увидел дурень, —"
  },
  {
   "texto": "Четырех братов, —"
  },
  {
   "texto": "Ячмень молотят."
  },
  {
   "texto": "Он братьям молвил:"
  },
  {
   "texto": "«Будь ты, враг, проклят"
  },
  {
   "texto": "Имем господним!»"
  },
  {
   "texto": "Как сграбят дурня"
  },
  {
   "texto": "Четыре брата,"
  },
  {
   "texto": "Зачали бити,"
  },
  {
   "texto": "Еле живого"
  },
  {
   "texto": "Дурня пустили."
  },
  {
   "texto": "Приходит дурень"
  },
  {
   "texto": "Домой, сам плачет"
  },
  {
   "texto": "На голос воет."
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена пеняти,"
  },
  {
   "texto": "Сестра-то также:"
  },
  {
   "texto": "\"Дурень ты дурень,"
  },
  {
   "texto": "Глупый ты Бабин,"
  },
  {
   "texto": "То же ты слово"
  },
  {
   "texto": "Не так бы молвил."
  },
  {
   "texto": "Ты бы им молвил:"
  },
  {
   "texto": "«Бог вам на помочь,"
  },
  {
   "texto": "Чтоб по сту на день,"
  },
  {
   "texto": "Чтоб не сносити»."
  },
  {
   "texto": "«Добро же, баба,"
  },
  {
   "texto": "Ты, бабариха,"
  },
  {
   "texto": "Матерь Лукерья,"
  },
  {
   "texto": "Сестра Чернава,"
  },
  {
   "texto": "Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати."
  },
  {
   "texto": "Увидел дурень, —"
  },
  {
   "texto": "Семеро братьев"
  },
  {
   "texto": "Матерь хоронят;"
  },
  {
   "texto": "Все они плачут,"
  },
  {
   "texto": "Голосом воют."
  },
  {
   "texto": "Он им и молвил:"
  },
  {
   "texto": "«Бог вам на помочь,"
  },
  {
   "texto": "Семеро братьев,"
  },
  {
   "texto": "Мать хоронити,"
  },
  {
   "texto": "Чтоб по сту на день,"
  },
  {
   "texto": "Чтоб не сносити»."
  },
  {
   "texto": "Сграбили дурня"
  },
  {
   "texto": "Семеро братьев,"
  },
  {
   "texto": "Зачали бити,"
  },
  {
   "texto": "Стали таскати,"
  },
  {
   "texto": "В грязи валяти,"
  },
  {
   "texto": "Еле живого"
  },
  {
   "texto": "Дурня пустили."
  },
  {
   "texto": "Идет он, дурень,"
  },
  {
   "texto": "Домой да плачет,"
  },
  {
   "texto": "На голос воет."
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена пеняти,"
  },
  {
   "texto": "Сестра-то также:"
  },
  {
   "texto": "«Дурень ты дурень,"
  },
  {
   "texto": "То же ты слово"
  },
  {
   "texto": "Не так бы молвил,"
  },
  {
   "texto": "А ты бы молвил:"
  },
  {
   "texto": "„Канун да ладан,"
  },
  {
   "texto": "Дай же господь бог"
  },
  {
   "texto": "Царство небесно,"
  },
  {
   "texto": "Пресветлый рай ей“."
  },
  {
   "texto": "Тебя бы, дурня,"
  },
  {
   "texto": "Там накормили"
  },
  {
   "texto": "Кутьей с блинами»."
  },
  {
   "texto": "«Добро же, баба,"
  },
  {
   "texto": "Ты, бабариха,"
  },
  {
   "texto": "Матерь Лукерья,"
  },
  {
   "texto": "Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати;"
  },
  {
   "texto": "Навстречу свадьба, —"
  },
  {
   "texto": "Он им и молвил:"
  },
  {
   "texto": "«Канун да ладан,"
  },
  {
   "texto": "Дай господь бог вам"
  },
  {
   "texto": "Царство небесно,"
  },
  {
   "texto": "Пресветлый рай всем»."
  },
  {
   "texto": "Скочили дружки,"
  },
  {
   "texto": "Схватили дурня,"
  },
  {
   "texto": "Зачали бити,"
  },
  {
   "texto": "Плетьми стегати,"
  },
  {
   "texto": "В лицо хлестати."
  },
  {
   "texto": "Пошел, заплакал,"
  },
  {
   "texto": "Идет да воет."
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена пеняти,"
  },
  {
   "texto": "Сестра-то также:"
  },
  {
   "texto": "\"Дурень ты дурень,"
  },
  {
   "texto": "Ты глупый Бабин;"
  },
  {
   "texto": "Ты то же слово"
  },
  {
   "texto": "Не так бы молвил;"
  },
  {
   "texto": "А ты бы молвил:"
  },
  {
   "texto": "«Дай господь бог вам,"
  },
  {
   "texto": "Князю с княгиней,"
  },
  {
   "texto": "Закон приняти,"
  },
  {
   "texto": "Любовно жити,"
  },
  {
   "texto": "Детей сводити»."
  },
  {
   "texto": "«Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати."
  },
  {
   "texto": "Попался дурню"
  },
  {
   "texto": "Навстречу старец."
  },
  {
   "texto": "Он ему молвил:"
  },
  {
   "texto": "«Дай бог те, старцу,"
  },
  {
   "texto": "Закон приняти,"
  },
  {
   "texto": "Любовно жити,"
  },
  {
   "texto": "Детей сводити»."
  },
  {
   "texto": "Как схватит старец"
  },
  {
   "texto": "За ворот дурня,"
  },
  {
   "texto": "Стал его бити,"
  },
  {
   "texto": "Стал колотити,"
  },
  {
   "texto": "Сломал костыль весь."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "Домой, сам плачет,"
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена журити,"
  },
  {
   "texto": "Сестра-то также:"
  },
  {
   "texto": "\"Ты дурень, дурень,"
  },
  {
   "texto": "Ты глупый Бабин;"
  },
  {
   "texto": "Ты то же слово"
  },
  {
   "texto": "Не так бы молвил;"
  },
  {
   "texto": "А ты бы молвил:"
  },
  {
   "texto": "«Благослови мя,"
  },
  {
   "texto": "Святой игумен»."
  },
  {
   "texto": "«Добро же, баба,"
  },
  {
   "texto": "Ты, бабариха,"
  },
  {
   "texto": "Матерь Лукерья,"
  },
  {
   "texto": "Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "В лесу ходити."
  },
  {
   "texto": "Увидел дурень"
  },
  {
   "texto": "В бору медведя, —"
  },
  {
   "texto": "Медведь за елью"
  },
  {
   "texto": "Дерет корову."
  },
  {
   "texto": "Он ему молвит:"
  },
  {
   "texto": "«Благослови мя,"
  },
  {
   "texto": "Святой игумен»."
  },
  {
   "texto": "Медведь на дурня"
  },
  {
   "texto": "Кинулся, сграбил,"
  },
  {
   "texto": "Зачал коверкать,"
  },
  {
   "texto": "Зачал ломати:"
  },
  {
   "texto": "Едва живого"
  },
  {
   "texto": "Дурня оставил."
  },
  {
   "texto": "Приходит дурень"
  },
  {
   "texto": "Домой, сам плачет,"
  },
  {
   "texto": "На голос воет,"
  },
  {
   "texto": "Матери скажет."
  },
  {
   "texto": "А мать бранити,"
  },
  {
   "texto": "Жена пеняти,"
  },
  {
   "texto": "Сестра-то также:"
  },
  {
   "texto": "«Ты дурень, дурень,"
  },
  {
   "texto": "Ты глупый Бабин;"
  },
  {
   "texto": "Ты то же слово"
  },
  {
   "texto": "Не так бы молвил,"
  },
  {
   "texto": "Ты бы зауськал,"
  },
  {
   "texto": "Ты бы загайкал,"
  },
  {
   "texto": "Заулюлюкал»."
  },
  {
   "texto": "«Добро же, баба,"
  },
  {
   "texto": "Ты, бабариха,"
  },
  {
   "texto": "Матерь Лукерья,"
  },
  {
   "texto": "Сестра Чернава,"
  },
  {
   "texto": "Вперед я, дурень,"
  },
  {
   "texto": "Таков не буду»."
  },
  {
   "texto": "Пошел он, дурень,"
  },
  {
   "texto": "На Русь гуляти,"
  },
  {
   "texto": "Людей видати,"
  },
  {
   "texto": "Себя казати."
  },
  {
   "texto": "Идет он, дурень,"
  },
  {
   "texto": "Во чистом поле, —"
  },
  {
   "texto": "Навстречу дурню"
  },
  {
   "texto": "Идет полковник."
  },
  {
   "texto": "Зауськал дурень,"
  },
  {
   "texto": "Загайкал дурень,"
  },
  {
   "texto": "Заулюлюкал."
  },
  {
   "texto": "Сказал полковник"
  },
  {
   "texto": "Своим солдатам."
  },
  {
   "texto": "Схватили дурня, —"
  },
  {
   "texto": "Зачали бити;"
  },
  {
   "texto": "До смерти дурня"
  },
  {
   "texto": "Тут и убили."
  }
 ]
