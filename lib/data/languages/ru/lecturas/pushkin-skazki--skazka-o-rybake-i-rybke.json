{
 "id": "pushkin-skazki--skazka-o-rybake-i-rybke",
 "titulo": "Сказка о рыбаке и рыбке",
 "autor": "Александр Пушкин",
 "muerteAutor": 1837,
 "fuenteUrl": "https://ru.wikisource.org/wiki/%D0%A1%D0%BA%D0%B0%D0%B7%D0%BA%D0%B0_%D0%BE_%D1%80%D1%8B%D0%B1%D0%B0%D0%BA%D0%B5_%D0%B8_%D1%80%D1%8B%D0%B1%D0%BA%D0%B5_(%D0%9F%D1%83%D1%88%D0%BA%D0%B8%D0%BD)",
 "fuente": "ru.wikisource.org, «Сказки (Пушкин)»",
 "licencia": "dominio público (autor muerto en 1837)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC, sin acentos de intensidad editoriales. La transcripción sigue la ortografía posterior a la reforma de 1918 y escribe la «ё» (2 formas); la «ё» opcional se deja como está en la fuente. Nivel B1 DECLARADO a mano: cuentos en verso, léxico de сказка y rima fácil; el verso engaña a la densidad (CS lo pagó).",
 "serie": {
  "id": "pushkin-skazki",
  "titulo": "Сказки (Пушкин)",
  "orden": 3
 },
 "variante": "ru",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Сказка"
  },
  {
   "texto": "о рыбаке и рыбке"
  },
  {
   "texto": "Жил старик со своею старухой"
  },
  {
   "texto": "У самого синего моря;"
  },
  {
   "texto": "Они жили в ветхой землянке"
  },
  {
   "texto": "Ровно тридцать лет и три года."
  },
  {
   "texto": "Старик ловил неводом рыбу,"
  },
  {
   "texto": "Старуха пряла свою пряжу."
  },
  {
   "texto": "Раз он в море закинул невод, —"
  },
  {
   "texto": "Пришел невод с одною тиной."
  },
  {
   "texto": "Он в другой раз закинул невод,"
  },
  {
   "texto": "Пришел невод с травой морскою."
  },
  {
   "texto": "В третий раз закинул он невод, —"
  },
  {
   "texto": "Пришел невод с одною рыбкой,"
  },
  {
   "texto": "С непростою рыбкой, — золотою."
  },
  {
   "texto": "Как взмолится золотая рыбка!"
  },
  {
   "texto": "Голосом молвит человечьим:"
  },
  {
   "texto": "«Отпусти ты, старче, меня в море,"
  },
  {
   "texto": "Дорогой за себя дам откуп:"
  },
  {
   "texto": "Откуплюсь чем только пожелаешь.»"
  },
  {
   "texto": "Удивился старик, испугался:"
  },
  {
   "texto": "Он рыбачил тридцать лет и три года"
  },
  {
   "texto": "И не слыхивал, чтоб рыба говорила."
  },
  {
   "texto": "Отпустил он рыбку золотую"
  },
  {
   "texto": "И сказал ей ласковое слово:"
  },
  {
   "texto": "«Бог с тобою, золотая рыбка!"
  },
  {
   "texto": "Твоего мне откупа не надо;"
  },
  {
   "texto": "Ступай себе в синее море,"
  },
  {
   "texto": "Гуляй там себе на просторе»."
  },
  {
   "texto": "Воротился старик ко старухе,"
  },
  {
   "texto": "Рассказал ей великое чудо."
  },
  {
   "texto": "«Я сегодня поймал было рыбку,"
  },
  {
   "texto": "Золотую рыбку, не простую;"
  },
  {
   "texto": "По-нашему говорила рыбка,"
  },
  {
   "texto": "Домой в море синее просилась,"
  },
  {
   "texto": "Дорогою ценою откупалась:"
  },
  {
   "texto": "Откупалась чем только пожелаю."
  },
  {
   "texto": "Не посмел я взять с нее выкуп;"
  },
  {
   "texto": "Так пустил ее в синее море»."
  },
  {
   "texto": "Старика старуха забранила:"
  },
  {
   "texto": "«Дурачина ты, простофиля!"
  },
  {
   "texto": "Не умел ты взять выкупа с рыбки!"
  },
  {
   "texto": "Хоть бы взял ты с нее корыто,"
  },
  {
   "texto": "Наше-то совсем раскололось»."
  },
  {
   "texto": "Вот пошел он к синему морю;"
  },
  {
   "texto": "Видит, — море слегка разыгралось."
  },
  {
   "texto": "Стал он кликать золотую рыбку,"
  },
  {
   "texto": "Приплыла к нему рыбка и спросила:"
  },
  {
   "texto": "«Чего тебе надобно, старче?»"
  },
  {
   "texto": "Ей с поклоном старик отвечает:"
  },
  {
   "texto": "«Смилуйся, государыня рыбка,"
  },
  {
   "texto": "Разбранила меня моя старуха,"
  },
  {
   "texto": "Не дает старику мне покою:"
  },
  {
   "texto": "Надобно ей новое корыто;"
  },
  {
   "texto": "Наше-то совсем раскололось»."
  },
  {
   "texto": "Отвечает золотая рыбка:"
  },
  {
   "texto": "«Не печалься, ступай себе с богом,"
  },
  {
   "texto": "Будет вам новое корыто»."
  },
  {
   "texto": "Воротился старик ко старухе,"
  },
  {
   "texto": "У старухи новое корыто."
  },
  {
   "texto": "Еще пуще старуха бранится:"
  },
  {
   "texto": "«Дурачина ты, простофиля!"
  },
  {
   "texto": "Выпросил, дурачина, корыто!"
  },
  {
   "texto": "В корыте много ль корысти?"
  },
  {
   "texto": "Воротись, дурачина, ты к рыбке;"
  },
  {
   "texto": "Поклонись ей, выпроси уж избу»."
  },
  {
   "texto": "Вот пошел он к синему морю,"
  },
  {
   "texto": "(Помутилося синее море.)"
  },
  {
   "texto": "Стал он кликать золотую рыбку,"
  },
  {
   "texto": "Приплыла к нему рыбка, спросила:"
  },
  {
   "texto": "«Чего тебе надобно, старче?»"
  },
  {
   "texto": "Ей старик с поклоном отвечает:"
  },
  {
   "texto": "«Смилуйся, государыня рыбка!"
  },
  {
   "texto": "Еще пуще старуха бранится,"
  },
  {
   "texto": "Не дает старику мне покою:"
  },
  {
   "texto": "Избу просит сварливая баба»."
  },
  {
   "texto": "Отвечает золотая рыбка:"
  },
  {
   "texto": "«Не печалься, ступай себе с богом,"
  },
  {
   "texto": "Так и быть: изба вам уж будет»."
  },
  {
   "texto": "Пошёл он ко своей землянке,"
  },
  {
   "texto": "А землянки нет уж и следа;"
  },
  {
   "texto": "Перед ним изба со светелкой,"
  },
  {
   "texto": "С кирпичною, беленою трубою,"
  },
  {
   "texto": "С дубовыми, тесовыми вороты."
  },
  {
   "texto": "Старуха сидит под окошком,"
  },
  {
   "texto": "На чем свет стоит мужа ругает."
  },
  {
   "texto": "«Дурачина ты, прямой простофиля!"
  },
  {
   "texto": "Выпросил, простофиля, избу!"
  },
  {
   "texto": "Воротись, поклонися рыбке:"
  },
  {
   "texto": "Не хочу быть черной крестьянкой,"
  },
  {
   "texto": "Хочу быть столбовою дворянкой»."
  },
  {
   "texto": "Пошел старик к синему морю;"
  },
  {
   "texto": "(Не спокойно синее море.)"
  },
  {
   "texto": "Стал он кликать золотую рыбку."
  },
  {
   "texto": "Приплыла к нему рыбка, спросила:"
  },
  {
   "texto": "«Чего тебе надобно, старче?»"
  },
  {
   "texto": "Ей с поклоном старик отвечает:"
  },
  {
   "texto": "«Смилуйся, государыня рыбка!"
  },
  {
   "texto": "Пуще прежнего старуха вздурилась,"
  },
  {
   "texto": "Не дает старику мне покою:"
  },
  {
   "texto": "Уж не хочет быть она крестьянкой,"
  },
  {
   "texto": "Хочет быть столбовою дворянкой»."
  },
  {
   "texto": "Отвечает золотая рыбка:"
  },
  {
   "texto": "«Не печалься, ступай себе с богом»."
  },
  {
   "texto": "Воротился старик ко старухе."
  },
  {
   "texto": "Что ж он видит? Высокий терем."
  },
  {
   "texto": "На крыльце стоит его старуха"
  },
  {
   "texto": "В дорогой собольей душегрейке,"
  },
  {
   "texto": "Парчовая на маковке кичка,"
  },
  {
   "texto": "Жемчуги огрузили шею,"
  },
  {
   "texto": "На руках золотые перстни,"
  },
  {
   "texto": "На ногах красные сапожки."
  },
  {
   "texto": "Перед нею усердные слуги;"
  },
  {
   "texto": "Она бьет их, за чупрун таскает."
  },
  {
   "texto": "Говорит старик своей старухе:"
  },
  {
   "texto": "«Здравствуй, барыня сударыня дворянка!"
  },
  {
   "texto": "Чай, теперь твоя душенька довольна»."
  },
  {
   "texto": "На него прикрикнула старуха,"
  },
  {
   "texto": "На конюшне служить его послала."
  },
  {
   "texto": "Вот неделя, другая проходит,"
  },
  {
   "texto": "Еще пуще старуха вздурилась:"
  },
  {
   "texto": "Опять к рыбке старика посылает."
  },
  {
   "texto": "«Воротись, поклонися рыбке:"
  },
  {
   "texto": "Не хочу быть столбовою дворянкой,"
  },
  {
   "texto": "А хочу быть вольною царицей»."
  },
  {
   "texto": "Испугался старик, взмолился:"
  },
  {
   "texto": "«Что ты, баба, белены объелась?"
  },
  {
   "texto": "Ни ступить, ни молвить не умеешь,"
  },
  {
   "texto": "Насмешишь ты целое царство»."
  },
  {
   "texto": "Осердилася пуще старуха,"
  },
  {
   "texto": "По щеке ударила мужа."
  },
  {
   "texto": "«Как ты смеешь, мужик, спорить со мною,"
  },
  {
   "texto": "Со мною, дворянкой столбовою? —"
  },
  {
   "texto": "Ступай к морю, говорят тебе честью,"
  },
  {
   "texto": "Не пойдешь, поведут поневоле»."
  },
  {
   "texto": "Старичок отправился к морю,"
  },
  {
   "texto": "(Почернело синее море.)"
  },
  {
   "texto": "Стал он кликать золотую рыбку."
  },
  {
   "texto": "Приплыла к нему рыбка, спросила:"
  },
  {
   "texto": "«Чего тебе надобно, старче?»"
  },
  {
   "texto": "Ей с поклоном старик отвечает:"
  },
  {
   "texto": "«Смилуйся, государыня рыбка!"
  },
  {
   "texto": "Опять моя старуха бунтует:"
  },
  {
   "texto": "Уж не хочет быть она дворянкой,"
  },
  {
   "texto": "Хочет быть вольною царицей»."
  },
  {
   "texto": "Отвечает золотая рыбка:"
  },
  {
   "texto": "«Не печалься, ступай себе с богом!"
  },
  {
   "texto": "Добро! будет старуха царицей!»"
  },
  {
   "texto": "Старичок к старухе воротился."
  },
  {
   "texto": "Что ж? пред ним царские палаты."
  },
  {
   "texto": "В палатах видит свою старуху,"
  },
  {
   "texto": "За столом сидит она царицей,"
  },
  {
   "texto": "Служат ей бояре да дворяне,"
  },
  {
   "texto": "Наливают ей заморские вины;"
  },
  {
   "texto": "Заедает она пряником печатным;"
  },
  {
   "texto": "Вкруг ее стоит грозная стража,"
  },
  {
   "texto": "На плечах топорики держат."
  },
  {
   "texto": "Как увидел старик, — испугался!"
  },
  {
   "texto": "В ноги он старухе поклонился,"
  },
  {
   "texto": "Молвил: «Здравствуй, грозная царица!"
  },
  {
   "texto": "Ну, теперь твоя душенька довольна»."
  },
  {
   "texto": "На него старуха не взглянула,"
  },
  {
   "texto": "Лишь с очей прогнать его велела."
  },
  {
   "texto": "Подбежали бояре и дворяне,"
  },
  {
   "texto": "Старика взашеи затолкали."
  },
  {
   "texto": "А в дверях-то стража подбежала,"
  },
  {
   "texto": "Топорами чуть не изрубила."
  },
  {
   "texto": "А народ-то над ним насмеялся:"
  },
  {
   "texto": "«Поделом тебе, старый невежа!"
  },
  {
   "texto": "Впредь тебе, невежа, наука:"
  },
  {
   "texto": "Не садися не в свои сани!»"
  },
  {
   "texto": "Вот неделя, другая проходит,"
  },
  {
   "texto": "Еще пуще старуха вздурилась:"
  },
  {
   "texto": "Царедворцев за мужем посылает,"
  },
  {
   "texto": "Отыскали старика, привели к ней."
  },
  {
   "texto": "Говорит старику старуха:"
  },
  {
   "texto": "«Воротись, поклонися рыбке."
  },
  {
   "texto": "Не хочу быть вольною царицей,"
  },
  {
   "texto": "Хочу быть владычицей морскою,"
  },
  {
   "texto": "Чтобы жить мне в Окияне-море,"
  },
  {
   "texto": "Чтоб служила мне рыбка золотая"
  },
  {
   "texto": "И была б у меня на посылках»."
  },
  {
   "texto": "Старик не осмелился перечить,"
  },
  {
   "texto": "Не дерзнул поперек слова молвить."
  },
  {
   "texto": "Вот идет он к синему морю,"
  },
  {
   "texto": "Видит, на море черная буря:"
  },
  {
   "texto": "Так и вздулись сердитые волны,"
  },
  {
   "texto": "Так и ходят, так воем и воют."
  },
  {
   "texto": "Стал он кликать золотую рыбку."
  },
  {
   "texto": "Приплыла к нему рыбка, спросила:"
  },
  {
   "texto": "«Чего тебе надобно, старче?»"
  },
  {
   "texto": "Ей старик с поклоном отвечает:"
  },
  {
   "texto": "«Смилуйся, государыня рыбка!"
  },
  {
   "texto": "Что мне делать с проклятою бабой?"
  },
  {
   "texto": "Уж не хочет быть она царицей,"
  },
  {
   "texto": "Хочет быть владычицей морскою;"
  },
  {
   "texto": "Чтобы жить ей в Окияне-море,"
  },
  {
   "texto": "Чтобы ты сама ей служила"
  },
  {
   "texto": "И была бы у ней на посылках»."
  },
  {
   "texto": "Ничего не сказала рыбка,"
  },
  {
   "texto": "Лишь хвостом по воде плеснула"
  },
  {
   "texto": "И ушла в глубокое море."
  },
  {
   "texto": "Долго у моря ждал он ответа,"
  },
  {
   "texto": "Не дождался, к старухе воротился —"
  },
  {
   "texto": "Глядь: опять перед ним землянка;"
  },
  {
   "texto": "На пороге сидит его старуха,"
  },
  {
   "texto": "А пред нею разбитое корыто."
  },
  {
   "texto": "14 октября 1833"
  },
  {
   "texto": "Вариант"
  },
  {
   "texto": "В черновой рукописи — после стиха «Не садися не в свои сани!» имеется следующий эпизод, не включенный Пушкиным в окончательный текст:"
  },
  {
   "texto": "Проходит другая неделя,"
  },
  {
   "texto": "Вздурилась опять его старуха,"
  },
  {
   "texto": "Отыскать мужика приказала —"
  },
  {
   "texto": "Приводят старика к царице,"
  },
  {
   "texto": "Говорит старику старуха:"
  },
  {
   "texto": "«Не хочу я быть вольною царицей,"
  },
  {
   "texto": "Я хочу быть римскою папой!»"
  },
  {
   "texto": "Старик не осмелился перечить,"
  },
  {
   "texto": "Не дерзнул поперек слова молвить."
  },
  {
   "texto": "Пошел он к синему морю,"
  },
  {
   "texto": "Видит: бурно черное море,"
  },
  {
   "texto": "Так и ходят сердитые волны,"
  },
  {
   "texto": "Так и воют воем зловещим."
  },
  {
   "texto": "Стал он кликать золотую рыбку."
  },
  {
   "texto": "Добро, будет она римскою папой."
  },
  {
   "texto": "Воротился старик к старухе,"
  },
  {
   "texto": "Перед ним монастырь латынский,"
  },
  {
   "texto": "На стенах латынские монахи"
  },
  {
   "texto": "Поют латынскую обедню."
  },
  {
   "texto": "Перед ним вавилонская башня."
  },
  {
   "texto": "На самой на верхней на макушке"
  },
  {
   "texto": "Сидит его старая старуха."
  },
  {
