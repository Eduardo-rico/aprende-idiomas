{
 "id": "tolstoj-vtoraya-kniga-c21",
 "titulo": "СУХМАН (Стихи-сказка)",
 "autor": "Лев Толстой",
 "muerteAutor": 1910,
 "fuenteUrl": "https://ru.wikisource.org/wiki/%D0%92%D1%82%D0%BE%D1%80%D0%B0%D1%8F_%D1%80%D1%83%D1%81%D1%81%D0%BA%D0%B0%D1%8F_%D0%BA%D0%BD%D0%B8%D0%B3%D0%B0_%D0%B4%D0%BB%D1%8F_%D1%87%D1%82%D0%B5%D0%BD%D0%B8%D1%8F_(%D0%9B%D0%B5%D0%B2_%D0%A2%D0%BE%D0%BB%D1%81%D1%82%D0%BE%D0%B9)",
 "fuente": "ru.wikisource.org, «Вторая русская книга для чтения»",
 "licencia": "dominio público (autor muerto en 1910)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC, sin acentos de intensidad editoriales. La transcripción sigue la ortografía posterior a la reforma de 1918 y no distingue la «ё»; la «ё» opcional se deja como está en la fuente. Nivel A2 DECLARADO por criterio (anclas-ru.mjs): literatura escrita para niños que empiezan a leer — frase corta, léxico concreto, fórmulas repetidas; la densidad polisilábica rusa la sube a B1 por morfología, no por dificultad.",
 "serie": {
  "id": "tolstoj-vtoraya-kniga",
  "titulo": "Вторая русская книга для чтения",
  "orden": 21
 },
 "variante": "ru",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Как у ласкова князь Владимира"
  },
  {
   "texto": "Пированье шло, шел почестен пир"
  },
  {
   "texto": "На бояр, князей, добрых молодцов."
  },
  {
   "texto": "На пиру-то все порасхвастались:"
  },
  {
   "texto": "Один хвастает золотой казной,"
  },
  {
   "texto": "Другой хвастает что добрым конем,"
  },
  {
   "texto": "Сильный хвастает своей силою,"
  },
  {
   "texto": "Глупый хвастает молодой женой,"
  },
  {
   "texto": "Умный хвастает старой матерью."
  },
  {
   "texto": "За столом сидит, призадумавшись,"
  },
  {
   "texto": "Богатырь Сухман Одихмантьевич,"
  },
  {
   "texto": "И ничем Сухман он не хвастает."
  },
  {
   "texto": "Тут Владимир-князь, красно солнышко,"
  },
  {
   "texto": "Сам по горенке он похажива(е)т,"
  },
  {
   "texto": "Желтыми кудрями он потряхива(е)т,"
  },
  {
   "texto": "Одихмантьичу выговарива(е)т:"
  },
  {
   "texto": "«Что, Сухмантьюшка, ты задумался?"
  },
  {
   "texto": "Что не ешь, не пьешь и не кушаешь,"
  },
  {
   "texto": "Белой лебеди ты не рушаешь,"
  },
  {
   "texto": "И ничем в пиру ты не хвастаешь?»"
  },
  {
   "texto": "Взговорил Сухман таковы слова:"
  },
  {
   "texto": "«Если хвастать мне ты приказываешь,"
  },
  {
   "texto": "Привезу ж тебе я, похвастаю,"
  },
  {
   "texto": "Лебедь белую не кровавлену"
  },
  {
   "texto": "И не ранену, а живьем в руках»."
  },
  {
   "texto": "И вставал Сухман на резвы ноги,"
  },
  {
   "texto": "Он седлал коня свого доброго,"
  },
  {
   "texto": "Выезжал Сухман ко синю морю,"
  },
  {
   "texto": "Ко синю морю, к тихим заводям."
  },
  {
   "texto": "Подъезжал Сухман к первой заводи,"
  },
  {
   "texto": "Не наезживал белых лебедей."
  },
  {
   "texto": "Подъезжал Сухман к другой заводи,"
  },
  {
   "texto": "Не нахаживал гусей-лебедей,"
  },
  {
   "texto": "И у третией тихой заводи —"
  },
  {
   "texto": "Нет серых гусей, белых лебедей."
  },
  {
   "texto": "Тут Сухмантьюшка призадумался:"
  },
  {
   "texto": "«Как поеду я в славный Киев-град?"
  },
  {
   "texto": "Что сказать будет князь Владимиру?»"
  },
  {
   "texto": "И поехал он к мать Непре-реке:"
  },
  {
   "texto": "Глядь, течет Непра не по-старому,"
  },
  {
   "texto": "Не по-старому, не по-прежнему,"
  },
  {
   "texto": "А вода с песком в ней смутилася."
  },
  {
   "texto": "Тут Непру-реку Сухман спрашивал:"
  },
  {
   "texto": "«Что течешь ты так, мать Непра-река,"
  },
  {
   "texto": "Не по-старому, не по-прежнему,"
  },
  {
   "texto": "А вода с песком помутилася?»"
  },
  {
   "texto": "Испровещится мать Непра-река:"
  },
  {
   "texto": "«Я затем теку не по-старому,"
  },
  {
   "texto": "Не по-прежнему, по-старинному,"
  },
  {
   "texto": "Что стоят за мной, за Непрой-рекой,"
  },
  {
   "texto": "Сорок тысячей злых татаровей."
  },
  {
   "texto": "Они мост мостят с утра до ночи."
  },
  {
   "texto": "Что намостят днем, то в ночь вырою."
  },
  {
   "texto": "Да из сил уж я выбиваюся»."
  },
  {
   "texto": "Взговорил Сухман таковы слова:"
  },
  {
   "texto": "«То не честь-хвала молодецкая —"
  },
  {
   "texto": "Не отведать мне сил татарскиих»."
  },
  {
   "texto": "И пустил коня свого доброго."
  },
  {
   "texto": "Чрез Непру-реку перескакивал,"
  },
  {
   "texto": "Не мочил копыт его добрый конь."
  },
  {
   "texto": "Подбежал Сухман ко сыру дубу,"
  },
  {
   "texto": "Ко сыру дубу, кряковистому,"
  },
  {
   "texto": "Дуб с кореньями выворачивал."
  },
  {
   "texto": "А с комля дуба белый сок бежал;"
  },
  {
   "texto": "Ту дубиночку за вершину брал"
  },
  {
   "texto": "И пустил коня на татаровей."
  },
  {
   "texto": "Стал Сухмантьюшка поворачивать,"
  },
  {
   "texto": "Той дубиночкой стал помахивать."
  },
  {
   "texto": "Как махнет вперед — станет улица,"
  },
  {
   "texto": "Отвернет назад — переулочек."
  },
  {
   "texto": "Всех побил татар Одихмантьевич,"
  },
  {
   "texto": "Убежало ли три татарчонка, —"
  },
  {
   "texto": "Под кусточками, под ракитовыми"
  },
  {
   "texto": "У Непры-реки схоронилися."
  },
  {
   "texto": "Подъезжал Сухман к мать Непре-реке,"
  },
  {
   "texto": "Из-под кустиков в Одихмантьича"
  },
  {
   "texto": "Три татарчонка стрелки пустили"
  },
  {
   "texto": "Во его бока, в тело белое."
  },
  {
   "texto": "Свет Сухмантьюшка стрелки выдернул"
  },
  {
   "texto": "Из своих боков, из кровавых ран,"
  },
  {
   "texto": "Листьем маковым позатыкивал"
  },
  {
   "texto": "И спорол ножом трех татарчонков."
  },
  {
   "texto": "Приезжал Сухман к князь Владимиру."
  },
  {
   "texto": "Привязал коня на дворе к столбу."
  },
  {
   "texto": "Сам входил Сухман во столовую."
  },
  {
   "texto": "Тут Владимир-князь, красно солнышко,"
  },
  {
   "texto": "Сам по горенке он похаживает,"
  },
  {
   "texto": "Одихмантьичу выговаривает:"
  },
  {
   "texto": "«Что ж, Сухмантьюшка, не привез ты мне"
  },
  {
   "texto": "Лебедь белую не кровавлену?»"
  },
  {
   "texto": "Взговорит Сухман таковы слова:"
  },
  {
   "texto": "«Гой, Владимир-князь, за Непрой-рекой"
  },
  {
   "texto": "Доходило мне не до лебедей."
  },
  {
   "texto": "Повстречалась мне за Непрой-рекой"
  },
  {
   "texto": "Сила ратная в сорок тысячей:"
  },
  {
   "texto": "Шли во Киев-град злы татаровья,"
  },
  {
   "texto": "С утра до ночи мосты ладили,"
  },
  {
   "texto": "А Непра-река вырывала в ночь,"
  },
  {
   "texto": "Да из сил она выбивалася."
  },
  {
   "texto": "Я пустил коня на татаровей"
  },
  {
   "texto": "И побил их всех до единого»."
  },
  {
   "texto": "Володимир-князь, красно солнышко,"
  },
  {
   "texto": "Тем словам, его не уверовал,"
  },
  {
   "texto": "Приказал слугам своим верныим"
  },
  {
   "texto": "Брать Сухмантия за белы руки,"
  },
  {
   "texto": "В погреба сажать во глубокие;"
  },
  {
   "texto": "А Добрынюшку посылал к Непре"
  },
  {
   "texto": "Про Сухмантьевы сведать заработки."
  },
  {
   "texto": "Встал Добрынюшка на резвы ноги,"
  },
  {
   "texto": "Он седлал коня свого доброго,"
  },
  {
   "texto": "Выезжал в поле к мать Непре-реке,"
  },
  {
   "texto": "Увидал — лежит сила ратная,"
  },
  {
   "texto": "В сорок тысячей, вся побитая."
  },
  {
   "texto": "И валяется дуб с кореньями,"
  },
  {
   "texto": "На лучиночки весь исщепанный."
  },
  {
   "texto": "Дуб Добрынюшка подымал с земли,"
  },
  {
   "texto": "Привозил его ко Владимиру,"
  },
  {
   "texto": "Так Добрынюшка выговаривал:"
  },
  {
   "texto": "«Правдой хвастает Одихмантьевич:"
  },
  {
   "texto": "За Непрой-рекой я видал — лежат"
  },
  {
   "texto": "Сорок тысячей злых татаровей,"
  },
  {
   "texto": "И дубиночка Одихмантьича"
  },
  {
   "texto": "На лучиночки вся исщепана»."
  },
  {
   "texto": "Тут велел слугам Володимир-князь"
  },
  {
   "texto": "В погреба идти во глубокие,"
  },
  {
   "texto": "Выводить скорей Одихмантьича,"
  },
  {
   "texto": "Приводить к себе на ясны очи;"
  },
  {
   "texto": "Таковы слова выговаривал:"
  },
  {
   "texto": "«За услуги те за великие"
  },
  {
   "texto": "Добра молодца буду миловать,"
  },
  {
   "texto": "Буду жаловать его до люби"
  },
  {
   "texto": "Городами ли с пригородками,"
  },
  {
   "texto": "Еще селами да с приселками,"
  },
  {
   "texto": "Золотой казной да бессчетною»."
  },
  {
   "texto": "В погреба идут во глубокие"
  },
  {
   "texto": "К Одихмантьичу слуги верные,"
  },
  {
   "texto": "Говорят ему таковы слова:"
  },
  {
   "texto": "«Выходи, Сухман, ты из погреба:"
  },
  {
   "texto": "Володимир-князь тебя милует,"
  },
  {
   "texto": "За твои труды за великие"
  },
  {
   "texto": "Хочет солнышко тебя жаловать"
  },
  {
   "texto": "Городами ли с пригородками,"
  },
  {
   "texto": "Еще селами да с приселками,"
  },
  {
   "texto": "Золотой казной да бессчетною»."
  },
  {
   "texto": "Выходил Сухман во чисто поле,"
  },
  {
   "texto": "Говорил Сухман таковы слова:"
  },
  {
   "texto": "«Гой, Владимир-князь, красно солнышко,"
  },
  {
   "texto": "Не умел меня в пору миловать,"
  },
  {
   "texto": "Не умел же ты в пору жаловать,"
  },
  {
   "texto": "А теперь тебе не видать будет,"
  },
  {
   "texto": "Не видать меня во ясны очи»."
  },
  {
   "texto": "И выдергивал Одихмантьевич"
  },
  {
   "texto": "Из кровавых ран листье маково,"
  },
  {
   "texto": "Свет Сухмантьюшка приговаривал:"
  },
  {
   "texto": "«Потеки река от моей крови,"
  },
  {
   "texto": "От моей крови от горючие,"
  },
  {
   "texto": "От горючие, от напрасные,"
  },
  {
   "texto": "Потеки Сухман, ах Сухман-река,"
  },
  {
   "texto": "Будь Непре-реке ты родна сестра»."
  }
 ]
}