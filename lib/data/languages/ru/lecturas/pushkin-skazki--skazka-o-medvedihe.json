 },
 "variante": "ru",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Сказка"
  },
  {
   "texto": "о медведихе"
  },
  {
   "texto": "Как весенней теплою порою"
  },
  {
   "texto": "Из-под утренней белой зорюшки,"
  },
  {
   "texto": "Что из лесу, из лесу из дремучего"
  },
  {
   "texto": "Выходила бурая медведиха"
  },
  {
   "texto": "Со милыми детушками-медвежатами"
  },
  {
   "texto": "Погулять, посмотреть, себя показать."
  },
  {
   "texto": "Села медведиха под белой березою;"
  },
  {
   "texto": "Стали медвежата промеж собой играть,"
  },
  {
   "texto": "По муравушке валятися,"
  },
  {
   "texto": "Боротися, кувыркатися."
  },
  {
   "texto": "Отколь ни возьмись, мужик идёт,"
  },
  {
   "texto": "Он во руках несёт рогатину,"
  },
  {
   "texto": "А нож-то у него за поясом."
  },
  {
   "texto": "А мешок-то у него за плечьми."
  },
  {
   "texto": "Как завидела медведиха"
  },
  {
   "texto": "Мужика со рогатиной,"
  },
  {
   "texto": "Заревела медведиха,"
  },
  {
   "texto": "Стала кликать малых детушек,"
  },
  {
   "texto": "Своих глупых медвежатушек."
  },
  {
   "texto": "Ах вы, детушки, медвежатушки,"
  },
  {
   "texto": "Перестаньте играть, валятися,"
  },
  {
   "texto": "Боротися, кувыркатися."
  },
  {
   "texto": "Уж как, знать, на нас мужик идёт."
  },
  {
   "texto": "Становитесь, хоронитесь за меня,"
  },
  {
   "texto": "Уж как я вас мужику не выдам"
  },
  {
   "texto": "И сама мужику .... выем."
  },
  {
   "texto": "Медвежатушки испугалися,"
  },
  {
   "texto": "За медведиху бросалися,"
  },
  {
   "texto": "А медведиха осержалася,"
  },
  {
   "texto": "На дыбы подымалася."
  },
  {
   "texto": "А мужик-от он догадлив был,"
  },
  {
   "texto": "Он пускался на медведиху,"
  },
  {
   "texto": "Он сажал в неё рогатину"
  },
  {
   "texto": "Что повыше пупа, пониже печени."
  },
  {
   "texto": "Грянулась медведиха о сыру землю,"
  },
  {
   "texto": "А мужик-то ей брюхо порол,"
  },
  {
   "texto": "Брюхо порол да шкуру сымал,"
  },
  {
   "texto": "Малых медвежатушек в мешок поклал,"
  },
  {
   "texto": "А поклавши-то, домой пошёл."
  },
  {
   "texto": "«Вот тебе, жена, подарочек,"
  },
  {
   "texto": "Что медвежия шуба в пятьдесят рублёв,"
  },
  {
   "texto": "А что вот тебе другой подарочек,"
  },
  {
   "texto": "Трои медвежата по пять рублёв»."
  },
  {
   "texto": "Не звоны пошли по городу,"
  },
  {
   "texto": "Пошли вести по всему по лесу,"
  },
  {
   "texto": "Дошли вести до медведя чернобурого,"
  },
  {
   "texto": "Что убил мужик его медведиху,"
  },
  {
   "texto": "Распорол ей брюхо белое,"
  },
  {
   "texto": "Брюхо распорол да шкуру сымал,"
  },
  {
   "texto": "Медвежатушек в мешок поклал."
  },
  {
   "texto": "В ту пору медведь запечалился,"
  },
  {
   "texto": "Голову повесил, голосом завыл"
  },
  {
   "texto": "Про свою ли сударушку,"
  },
  {
   "texto": "Чернобурую медведиху."
  },
  {
   "texto": "«Ах ты, свет моя медведиха,"
  },
  {
   "texto": "На кого меня покинула,"
  },
  {
   "texto": "Вдовца печального,"
  },
  {
   "texto": "Вдовца горемычного?"
  },
  {
   "texto": "Уж как мне с тобой, моей боярыней,"
  },
  {
   "texto": "Весёлой игры не игрывати,"
  },
  {
   "texto": "Милых детушек не родити,"
  },
  {
   "texto": "Медвежатушек не качати,"
  },
  {
   "texto": "Не качати, не баюкати»."
  },
  {
   "texto": "В ту пору звери собиралися"
  },
  {
   "texto": "Ко тому ли медведю, к большому боярину,"
  },
  {
   "texto": "Приходили звери большие,"
  },
  {
   "texto": "Прибегали тут зверишки меньшие."
  },
  {
   "texto": "Прибегал туто волк-дворянин,"
  },
  {
   "texto": "У него-то зубы закусливые,"
  },
  {
   "texto": "У него-то глаза завистливые."
  },
  {
   "texto": "Приходил тут бобр, торговый гость,"
  },
  {
   "texto": "У него-то, бобра, жирный хвост."
  },
  {
   "texto": "Приходила ласточка-дворяночка,"
  },
  {
   "texto": "Приходила белочка-княгинечка,"
  },
  {
   "texto": "Приходила лисица-подьячиха,"
  },
  {
   "texto": "Подьячиха-казначеиха,"
  },
  {
   "texto": "Приходил скоморох-горностаюшка,"
  },
  {
   "texto": "Приходил байбак тут игумен,"
  },
  {
   "texto": "Живет он, байбак, позадь гумен."
  },
  {
   "texto": "Прибегал тут зайка-смерд,"
  },
  {
   "texto": "Зайка беленький, зайка серенький."
  },
  {
   "texto": "Приходил целовальник-еж,"
  },
  {
   "texto": "Всё-то, ёж, он ёжится,"
  },
  {
   "texto": "Всё-то он щетинится."
  },
  {
   "texto": "Около 1830"
  }
 ]
}