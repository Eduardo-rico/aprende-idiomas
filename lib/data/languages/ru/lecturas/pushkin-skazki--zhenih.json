 "modo": "texto",
 "parrafos": [
  {
   "texto": "Жених"
  },
  {
   "texto": "Три дня купеческая дочь"
  },
  {
   "texto": "Наташа пропадала;"
  },
  {
   "texto": "Она на двор на третью ночь"
  },
  {
   "texto": "Без памяти вбежала."
  },
  {
   "texto": "C вопросами отец и мать"
  },
  {
   "texto": "К Наташе стали приступать."
  },
  {
   "texto": "Наташа их не слышит,"
  },
  {
   "texto": "Дрожит и еле дышит."
  },
  {
   "texto": "Тужила мать, тужил отец,"
  },
  {
   "texto": "10 И долго приступали,"
  },
  {
   "texto": "И отступились наконец,"
  },
  {
   "texto": "А тайны не узнали."
  },
  {
   "texto": "Наташа стала, как была,"
  },
  {
   "texto": "Опять румяна, весела,"
  },
  {
   "texto": "Опять пошла с сестрами"
  },
  {
   "texto": "Сидеть за воротами."
  },
  {
   "texto": "Раз у тесовых у ворот,"
  },
  {
   "texto": "С подружками своими,"
  },
  {
   "texto": "Сидела девица — и вот"
  },
  {
   "texto": "20 Промчалась перед ними"
  },
  {
   "texto": "Лихая тройка с молодцом."
  },
  {
   "texto": "Конями, крытыми ковром,"
  },
  {
   "texto": "В санях он стоя правит"
  },
  {
   "texto": "И гонит всех, и давит."
  },
  {
   "texto": "Он, поровнявшись, поглядел,"
  },
  {
   "texto": "Наташа поглядела,"
  },
  {
   "texto": "Он вихрем мимо пролетел,"
  },
  {
   "texto": "Наташа помертвела."
  },
  {
   "texto": "Стремглав домой она бежит."
  },
  {
   "texto": "30 «Он! он! узнала! — говорит, —"
  },
  {
   "texto": "Он, точно он! держите,"
  },
  {
   "texto": "Друзья мои, спасите!»"
  },
  {
   "texto": "Печально слушает семья,"
  },
  {
   "texto": "Качая головою;"
  },
  {
   "texto": "Отец ей: «Милая моя,"
  },
  {
   "texto": "Откройся предо мною."
  },
  {
   "texto": "Обидел кто тебя, скажи,"
  },
  {
   "texto": "Хоть только след нам укажи»."
  },
  {
   "texto": "Наташа плачет снова."
  },
  {
   "texto": "40 И более ни слова."
  },
  {
   "texto": "Наутро сваха к ним на двор"
  },
  {
   "texto": "Нежданая приходит."
  },
  {
   "texto": "Наташу хвалит, разговор"
  },
  {
   "texto": "С отцом её заводит:"
  },
  {
   "texto": "«У вас товар, у нас купец;"
  },
  {
   "texto": "Собою парень молодец,"
  },
  {
   "texto": "И статный, и проворный,"
  },
  {
   "texto": "Не вздорный, не зазорный."
  },
  {
   "texto": "Богат, умён, ни перед кем"
  },
  {
   "texto": "50 Не кланяется в пояс,"
  },
  {
   "texto": "А как боярин между тем"
  },
  {
   "texto": "Живёт, не беспокоясь;"
  },
  {
   "texto": "А подарит невесте вдруг"
  },
  {
   "texto": "И лисью шубу, и жемчуг,"
  },
  {
   "texto": "И перстни золотые,"
  },
  {
   "texto": "И платья парчевые."
  },
  {
   "texto": "Катаясь, видел он вчера"
  },
  {
   "texto": "Её за воротами;"
  },
  {
   "texto": "Не по рукам ли, да с двора,"
  },
  {
   "texto": "60 Да в церковь с образами?»"
  },
  {
   "texto": "Она сидит за пирогом,"
  },
  {
   "texto": "Да речь ведет обиняком,"
  },
  {
   "texto": "А бедная невеста"
  },
  {
   "texto": "Себе не видит места."
  },
  {
   "texto": "«Согласен, — говорит отец; —"
  },
  {
   "texto": "Ступай благополучно,"
  },
  {
   "texto": "Моя Наташа, под венец:"
  },
  {
   "texto": "Одной в светёлке скучно."
  },
  {
   "texto": "Не век девицей вековать,"
  },
  {
   "texto": "70 Не всё косатке распевать,"
  },
  {
   "texto": "Пора гнездо устроить,"
  },
  {
   "texto": "Чтоб детушек покоить»."
  },
  {
   "texto": "Наташа к стенке уперлась"
  },
  {
   "texto": "И слово молвить хочет —"
  },
  {
   "texto": "Вдруг зарыдала, затряслась,"
  },
  {
   "texto": "И плачет и хохочет."
  },
  {
   "texto": "В смятеньи сваха к ней бежит,"
  },
  {
   "texto": "Водой студеною поит"
  },
  {
   "texto": "И льёт остаток чаши"
  },
  {
   "texto": "80 На голову Наташи."
  },
  {
   "texto": "Крушится, охает семья."
  },
  {
   "texto": "Опомнилась Наташа"
  },
  {
   "texto": "И говорит: «Послушна я,"
  },
  {
   "texto": "Святая воля ваша."
  },
  {
   "texto": "Зовите жениха на пир,"
  },
  {
   "texto": "Пеките хлебы на весь мир,"
  },
  {
   "texto": "На славу мёд варите,"
  },
  {
   "texto": "Да суд на пир зовите»."
  },
  {
   "texto": "«Изволь, Наташа, ангел мой!"
  },
  {
   "texto": "90 Готов тебе в забаву"
  },
  {
   "texto": "Я жизнь отдать!» — И пир горой;"
  },
  {
   "texto": "Пекут, варят на славу."
  },
  {
   "texto": "Вот гости честные нашли,"
  },
  {
   "texto": "За стол невесту повели;"
  },
  {
   "texto": "Поют подружки, плачут,"
  },
  {
   "texto": "А вот и сани скачут."
  },
  {
   "texto": "Вот и жених — и все за стол."
  },
  {
   "texto": "Звенят, гремят стаканы,"
  },
  {
   "texto": "Заздравный ковш кругом пошёл;"
  },
  {
   "texto": "100 Всё шумно, гости пьяны."
  },
  {
   "texto": "Жених."
  },
  {
   "texto": "«А что же, милые друзья,"
  },
  {
   "texto": "Невеста красная моя"
  },
  {
   "texto": "Не пьёт, не ест, не служит:"
  },
  {
   "texto": "О чём невеста тужит?»"
  },
  {
   "texto": "Невеста жениху в ответ:"
  },
  {
   "texto": "«Откроюсь на удачу."
  },
  {
   "texto": "Душе моей покоя нет,"
  },
  {
   "texto": "И день, и ночь я плачу."
  },
  {
   "texto": "Недобрый сон меня крушит»."
  },
  {
   "texto": "110 Отец ей: «Что ж твой сон гласит?"
  },
  {
   "texto": "Скажи нам, что такое,"
  },
  {
   "texto": "Дитя мое родное?»"
  },
  {
   "texto": "«Мне снилось, — говорит она, —"
  },
  {
   "texto": "Зашла я в лес дремучий,"
  },
  {
   "texto": "И было поздно; чуть луна"
  },
  {
   "texto": "Светила из-за тучи;"
  },
  {
   "texto": "С тропинки сбилась я: в глуши"
  },
  {
   "texto": "Не слышно было ни души,"
  },
  {
   "texto": "И сосны лишь да ели"
  },
  {
   "texto": "120 Вершинами шумели."
  },
  {
   "texto": "И вдруг, как будто наяву,"
  },
  {
   "texto": "Изба передо мною."
  },
  {
   "texto": "Я к ней, стучу — молчат. Зову —"
  },
  {
   "texto": "Ответа нет; с мольбою"
  },
  {
   "texto": "Дверь отворила я. Вхожу —"
  },
  {
   "texto": "В избе свеча горит; гляжу —"
  },
  {
   "texto": "Везде сребро да злато,"
  },
  {
   "texto": "Всё светло и богато»."
  },
  {
   "texto": "Жених."
  },
  {
   "texto": "«А чем же худ, скажи, твой сон?"
  },
  {
   "texto": "130 Знать жить тебе богато»."
  },
  {
   "texto": "Невеста."
  },
  {
   "texto": "«Постой, сударь, не кончен он."
  },
  {
   "texto": "На серебро, на злато,"
  },
  {
   "texto": "На сукна, коврики, парчу,"
  },
  {
   "texto": "На новгородскую камчу"
  },
  {
   "texto": "Я молча любовалась"
  },
  {
   "texto": "И диву дивовалась."
  },
  {
   "texto": "Вдруг слышу крик и конский топ…"
  },
  {
   "texto": "Подъехали к крылечку."
  },
  {
   "texto": "Я поскорее дверью хлоп,"
  },
  {
   "texto": "140 И спряталась за печку."
  },
  {
   "texto": "Вот слышу много голосов…"
  },
  {
   "texto": "Взошли двенадцать молодцов,"
  },
  {
   "texto": "И с ними голубица"
  },
  {
   "texto": "Красавица-девица."
  },
  {
   "texto": "Взошли толпой, не поклонясь,"
  },
  {
   "texto": "Икон не замечая;"
  },
  {
   "texto": "За стол садятся, не молясь"
  },
  {
   "texto": "И шапок не снимая."
  },
  {
   "texto": "На первом месте брат большой,"
  },
  {
   "texto": "150 По праву руку брат меньшой,"
  },
  {
   "texto": "По леву голубица"
  },
  {
   "texto": "Красавица-девица."
  },
  {
   "texto": "Крик, хохот, песни, шум и звон,"
  },
  {
   "texto": "Разгульное похмелье…»"
  },
  {
   "texto": "Жених."
  },
  {
   "texto": "«А чем же худ, скажи, твой сон?"
  },
  {
   "texto": "Вещает он веселье»."
  },
  {
   "texto": "Невеста."
  },
  {
   "texto": "«Постой, сударь, не кончен он."
  },
  {
   "texto": "Идёт похмелье, гром и звон,"
  },
  {
   "texto": "Пир весело бушует,"
  },
  {
   "texto": "160 Лишь девица горюет."
  },
  {
   "texto": "Сидит, молчит, ни ест, ни пьёт"
  },
  {
   "texto": "И током слёзы точит,"
  },
  {
   "texto": "А старший брат свой нож берёт,"
  },
  {
   "texto": "Присвистывая точит;"
  },
  {
   "texto": "Глядит на девицу-красу,"
  },
  {
   "texto": "И вдруг хватает за косу,"
  },
  {
   "texto": "Злодей девицу губит,"
  },
  {
   "texto": "Ей праву руку рубит»."
  },
  {
   "texto": "«Ну, это, — говорит жених,—"
  },
  {
   "texto": "170 Прямая небылица!"
  },
  {
   "texto": "Но не тужи, твой сон не лих,"
  },
  {
   "texto": "Поверь, душа-девица»."
  },
  {
   "texto": "Она глядит ему в лицо."
  },
  {
   "texto": "«А это с чьей руки кольцо?»"
  },
  {
   "texto": "Вдруг молвила невеста,"
  },
  {
   "texto": "И все привстали с места."
  },
  {
   "texto": "Кольцо катится и звенит,"
  },
  {
   "texto": "Жених дрожит бледнея;"
  },
  {
   "texto": "Смутились гости. — Суд гласит:"
  },
  {
   "texto": "180 «Держи, вязать злодея!»"
  },
  {
   "texto": "Злодей окован, обличён,"
  },
  {
   "texto": "И скоро смертию казнён."
  },
  {
   "texto": "Прославилась Наташа!"
  },
  {
   "texto": "И вся тут песня наша."
  },
  {
   "texto": "<1825>"
  },
  {
   "texto": "Примечания редакторов Викитеки"
  }
 ]
}