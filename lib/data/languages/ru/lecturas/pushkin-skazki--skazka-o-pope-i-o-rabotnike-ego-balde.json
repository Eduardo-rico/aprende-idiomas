{
 "id": "pushkin-skazki--skazka-o-pope-i-o-rabotnike-ego-balde",
 "titulo": "Сказка о попе и о работнике его Балде",
 "autor": "Александр Пушкин",
 "muerteAutor": 1837,
 "fuenteUrl": "https://ru.wikisource.org/wiki/%D0%A1%D0%BA%D0%B0%D0%B7%D0%BA%D0%B0_%D0%BE_%D0%BF%D0%BE%D0%BF%D0%B5_%D0%B8_%D0%BE_%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D0%BD%D0%B8%D0%BA%D0%B5_%D0%B5%D0%B3%D0%BE_%D0%91%D0%B0%D0%BB%D0%B4%D0%B5_(%D0%9F%D1%83%D1%88%D0%BA%D0%B8%D0%BD)",
 "fuente": "ru.wikisource.org, «Сказки (Пушкин)»",
