{
 "id": "pushkin-skazki--skazka-o-zolotom-petushke",
 "titulo": "Сказка о золотом петушке",
 "autor": "Александр Пушкин",
 "muerteAutor": 1837,
 "fuenteUrl": "https://ru.wikisource.org/wiki/%D0%A1%D0%BA%D0%B0%D0%B7%D0%BA%D0%B0_%D0%BE_%D0%B7%D0%BE%D0%BB%D0%BE%D1%82%D0%BE%D0%BC_%D0%BF%D0%B5%D1%82%D1%83%D1%88%D0%BA%D0%B5_(%D0%9F%D1%83%D1%88%D0%BA%D0%B8%D0%BD)",
 "fuente": "ru.wikisource.org, «Сказки (Пушкин)»",
 "licencia": "dominio público (autor muerto en 1837)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC, sin acentos de intensidad editoriales. La transcripción sigue la ortografía posterior a la reforma de 1918 y escribe la «ё» (7 formas); la «ё» opcional se deja como está en la fuente. Nivel B1 DECLARADO a mano: cuentos en verso, léxico de сказка y rima fácil; el verso engaña a la densidad (CS lo pagó).",
 "serie": {
  "id": "pushkin-skazki",
  "titulo": "Сказки (Пушкин)",
  "orden": 5
 },
 "variante": "ru",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Сказка"
  },
  {
   "texto": "о золотом петушке"
  },
  {
   "texto": "Негде, в тридевятом царстве,"
  },
  {
   "texto": "В тридесятом государстве,"
  },
  {
   "texto": "Жил-был славный царь Дадон."
  },
  {
   "texto": "С молоду был грозен он"
  },
  {
   "texto": "И соседям то и дело"
  },
  {
   "texto": "Наносил обиды смело;"
  },
  {
   "texto": "Но под старость захотел"
  },
  {
   "texto": "Отдохнуть от ратных дел"
  },
  {
   "texto": "И покой себе устроить."
  },
  {
   "texto": "Тут соседи беспокоить"
  },
  {
   "texto": "Стали старого царя,"
  },
  {
   "texto": "Страшный вред ему творя."
  },
  {
   "texto": "Чтоб концы своих владений"
  },
  {
   "texto": "Охранять от нападений,"
  },
  {
   "texto": "Должен был он содержать"
  },
  {
   "texto": "Многочисленную рать."
  },
  {
   "texto": "Воеводы не дремали,"
  },
  {
   "texto": "Но никак не успевали."
  },
  {
   "texto": "Ждут бывало с юга, — глядь, —"
  },
  {
   "texto": "Ан с востока лезет рать!"
  },
  {
   "texto": "Справят здесь, — лихие гости"
  },
  {
   "texto": "Идут от моря. Со злости"
  },
  {
   "texto": "Инда плакал царь Дадон,"
  },
  {
   "texto": "Инда забывал и сон."
  },
  {
   "texto": "Что и жизнь в такой тревоге!"
  },
  {
   "texto": "Вот он с просьбой о помоге"
  },
  {
   "texto": "Обратился к мудрецу,"
  },
  {
   "texto": "Звездочету и скопцу."
  },
  {
   "texto": "Шлет за ним гонца с поклоном."
  },
  {
   "texto": "Вот мудрец перед Дадоном"
  },
  {
   "texto": "Стал и вынул из мешка"
  },
  {
   "texto": "Золотого петушка."
  },
  {
   "texto": "«Посади ты эту птицу, —"
  },
  {
   "texto": "Молвил он царю, — на спицу;"
  },
  {
   "texto": "Петушок мой золотой"
  },
  {
   "texto": "Будет верный сторож твой:"
  },
  {
   "texto": "Коль кругом всё будет мирно,"
  },
  {
   "texto": "Так сидеть он будет смирно;"
  },
  {
   "texto": "Но лишь чуть со стороны"
  },
  {
   "texto": "Ожидать тебе войны,"
  },
  {
   "texto": "Иль набега силы бранной,"
  },
  {
   "texto": "Иль другой беды незванной,"
  },
  {
   "texto": "Вмиг тогда мой петушок"
  },
  {
   "texto": "Приподымет гребешок,"
  },
  {
   "texto": "Закричит и встрепенется"
  },
  {
   "texto": "И в то место обернется»."
  },
  {
   "texto": "Царь скопца благодарит,"
  },
  {
   "texto": "Горы золота сулит."
  },
  {
   "texto": "«За такое одолженье, —"
  },
  {
   "texto": "Говорит он в восхищеньи, —"
  },
  {
   "texto": "Волю первую твою"
  },
  {
   "texto": "Я исполню, как мою»."
  },
  {
   "texto": "Петушок с высокой спицы"
  },
  {
   "texto": "Стал стеречь его границы."
  },
  {
   "texto": "Чуть опасность где видна,"
  },
  {
   "texto": "Верный сторож как со сна"
  },
  {
   "texto": "Шевельнется, встрепенется,"
  },
  {
   "texto": "К той сторонке обернется"
  },
  {
   "texto": "И кричит: «Кири-ку-ку."
  },
  {
   "texto": "Царствуй, лежа на боку!»"
  },
  {
   "texto": "И соседи присмирели,"
  },
  {
   "texto": "Воевать уже не смели:"
  },
  {
   "texto": "Таковой им царь Дадон"
  },
  {
   "texto": "Дал отпор со всех сторон!"
  },
  {
   "texto": "Год, другой проходит мирно;"
  },
  {
   "texto": "Петушок сидит всё смирно."
  },
  {
   "texto": "Вот однажды царь Дадон"
  },
  {
   "texto": "Страшным шумом пробужден:"
  },
  {
   "texto": "«Царь ты наш! отец народа! —"
  },
  {
   "texto": "Возглашает воевода: —"
  },
  {
   "texto": "Государь! проснись! беда!»"
  },
  {
   "texto": "— «Что такое, господа?—"
  },
  {
   "texto": "Говорит Дадон, зевая: —"
  },
  {
   "texto": "А?.. Кто там?.. беда какая?»"
  },
  {
   "texto": "Воевода говорит:"
  },
  {
   "texto": "«Петушок опять кричит;"
  },
  {
   "texto": "Страх и шум во всей столице»."
  },
  {
   "texto": "Царь к окошку, — ан на спице,"
  },
  {
   "texto": "Видит, бьется петушок,"
  },
  {
   "texto": "Обратившись на восток."
  },
  {
   "texto": "Медлить нечего: «Скорее!"
  },
  {
   "texto": "Люди, на конь! Эй, живее!»"
  },
  {
   "texto": "Царь к востоку войско шлет,"
  },
  {
   "texto": "Старший сын его ведет."
  },
  {
   "texto": "Петушок угомонился,"
  },
  {
   "texto": "Шум утих, и царь забылся."
  },
  {
   "texto": "Вот проходит восемь дней,"
  },
  {
   "texto": "А от войска нет вестей:"
  },
  {
   "texto": "Было ль, не было ль сраженья, —"
  },
  {
   "texto": "Нет Дадону донесенья."
  },
  {
   "texto": "Петушок кричит опять."
  },
  {
   "texto": "Кличет царь другую рать;"
  },
  {
   "texto": "Сына он теперь меньшого"
  },
  {
   "texto": "Шлет на выручку большого."
  },
  {
   "texto": "Петушок опять утих."
  },
  {
   "texto": "Снова вести нет от них!"
  },
  {
   "texto": "Снова восемь дней проходят;"
  },
  {
   "texto": "Люди в страхе дни проводят;"
  },
  {
   "texto": "Петушок кричит опять;"
  },
  {
   "texto": "Царь скликает третью рать"
  },
  {
   "texto": "И ведет ее к востоку, —"
  },
  {
   "texto": "Сам не зная, быть ли проку."
  },
  {
   "texto": "Войска идут день и ночь;"
  },
  {
   "texto": "Им становится не в мочь."
  },
  {
   "texto": "Ни побоища, ни стана,"
  },
  {
   "texto": "Ни надгробного кургана"
  },
  {
   "texto": "Не встречает царь Дадон."
  },
  {
   "texto": "«Что за чудо?» — мыслит он."
  },
  {
   "texto": "Вот осьмой уж день проходит,"
  },
  {
   "texto": "Войско в горы царь приводит,"
  },
  {
   "texto": "И промеж высоких гор"
  },
  {
   "texto": "Видит шелковый шатёр."
  },
  {
   "texto": "Всё в безмолвии чудесном"
  },
  {
   "texto": "Вкруг шатра; в ущельи тесном"
  },
  {
   "texto": "Рать побитая лежит."
  },
  {
   "texto": "Царь Дадон к шатру спешит…"
  },
  {
   "texto": "Что за страшная картина!"
  },
  {
   "texto": "Перед ним его два сына;"
  },
  {
   "texto": "Без шеломов и без лат"
  },
  {
   "texto": "Оба мертвые лежат,"
  },
  {
   "texto": "Меч вонзивши друг во друга."
  },
  {
   "texto": "Бродят кони их средь луга,"
  },
  {
   "texto": "По притоптанной траве,"
  },
  {
   "texto": "По кровавой мураве…"
  },
  {
   "texto": "Царь завыл: «Ох дети, дети!"
  },
  {
   "texto": "Горе мне! попались в сети"
  },
  {
   "texto": "Оба наши сокола!"
  },
  {
   "texto": "Горе! смерть моя пришла.»"
  },
  {
   "texto": "Все завыли за Дадоном,"
  },
  {
   "texto": "Застонала тяжким стоном"
  },
  {
   "texto": "Глубь долин, и сердце гор"
  },
  {
   "texto": "Потряслося. Вдруг шатёр"
  },
  {
   "texto": "Распахнулся… и девица,"
  },
  {
   "texto": "Шамаханская царица,"
  },
  {
   "texto": "Вся сияя как заря,"
  },
  {
   "texto": "Тихо встретила царя."
  },
  {
   "texto": "Как пред солнцем птица ночи,"
  },
  {
   "texto": "Царь умолк, ей глядя в очи,"
  },
  {
   "texto": "И забыл он перед ней"
  },
  {
   "texto": "Смерть обоих сыновей."
  },
  {
   "texto": "И она перед Дадоном"
  },
  {
   "texto": "Улыбнулась — и с поклоном"
  },
  {
   "texto": "Его за руку взяла"
  },
  {
   "texto": "И в шатер свой увела."
  },
  {
   "texto": "Там за стол его сажала,"
  },
  {
   "texto": "Всяким яством угощала;"
  },
  {
   "texto": "Уложила отдыхать"
  },
  {
   "texto": "На парчевую кровать."
  },
  {
   "texto": "И потом, неделю ровно, —"
  },
  {
   "texto": "Покорясь ей безусловно, —"
  },
  {
   "texto": "Околдован, восхищён,"
  },
  {
   "texto": "Пировал у ней Дадон."
  },
  {
   "texto": "Наконец и в путь обратный"
  },
  {
   "texto": "Со своею силой ратной"
  },
  {
   "texto": "И с девицей молодой"
  },
  {
   "texto": "Царь отправился домой."
  },
  {
   "texto": "Перед ним молва бежала,"
  },
  {
   "texto": "Быль и небыль разглашала."
  },
  {
   "texto": "Под столицей, близ ворот"
  },
  {
   "texto": "С шумом встретил их народ, —"
  },
  {
   "texto": "Все бегут за колесницей,"
  },
  {
   "texto": "За Дадоном и царицей;"
  },
  {
   "texto": "Всех приветствует Дадон…"
  },
  {
   "texto": "Вдруг в толпе увидел он,"
  },
  {
   "texto": "В сарачинской шапке белой,"
  },
  {
   "texto": "Весь как лебедь поседелый,"
  },
  {
   "texto": "Старый друг его, скопец."
  },
  {
   "texto": "«А, здорово, мой отец, —"
  },
  {
   "texto": "Молвил царь ему, — что скажешь?"
  },
  {
   "texto": "Подь поближе! Что прикажешь?»"
  },
  {
   "texto": "— «Царь! — ответствует мудрец, —"
  },
  {
   "texto": "Разочтемся наконец."
  },
  {
   "texto": "Помнишь? за мою услугу"
  },
  {
   "texto": "Обещался мне, как другу,"
  },
  {
   "texto": "Волю первую мою"
  },
  {
   "texto": "Ты исполнить как свою."
  },
  {
   "texto": "Подари ж ты мне девицу,"
  },
  {
   "texto": "Шамаханскую царицу.» —"
  },
  {
   "texto": "Крайне царь был изумлён."
  },
  {
   "texto": "«Что ты? — старцу молвил он: —"
  },
  {
   "texto": "Или бес в тебя ввернулся?"
  },
  {
   "texto": "Или ты с ума рехнулся?"
  },
  {
   "texto": "Что ты в голову забрал?"
  },
  {
   "texto": "Я конечно обещал,"
  },
  {
   "texto": "Но всему же есть граница!"
  },
  {
   "texto": "И зачем тебе девица?"
  },
  {
   "texto": "Полно, знаешь ли кто я?"
  },
  {
   "texto": "Попроси ты от меня"
  },
  {
   "texto": "Хоть казну, хоть чин боярской,"
  },
  {
   "texto": "Хоть коня с конюшни царской,"
  },
  {
   "texto": "Хоть пол-царства моего!»"
  },
  {
   "texto": "— «Не хочу я ничего!"
  },
  {
   "texto": "Подари ты мне девицу,"
  },
  {
   "texto": "Шамаханскую царицу,» —"
  },
  {
   "texto": "Говорит мудрец в ответ. —"
  },
  {
   "texto": "Плюнул царь: «Так лих же: нет!"
  },
  {
   "texto": "Ничего ты не получишь."
  },
  {
   "texto": "Сам себя ты, грешник, мучишь;"
  },
  {
   "texto": "Убирайся, цел пока!"
  },
  {
   "texto": "Оттащите старика!»"
  },
  {
   "texto": "Старичок хотел заспорить,"
  },
  {
   "texto": "Но с иным накладно вздорить;"
  },
  {
   "texto": "Царь хватил его жезлом"
  },
  {
   "texto": "По лбу; тот упал ничком,"
  },
  {
   "texto": "Да и дух вон. — Вся столица"
  },
  {
   "texto": "Содрогнулась; а девица —"
  },
  {
   "texto": "Хи-хи-хи! да ха-ха-ха!"
  },
  {
   "texto": "Не боится знать греха."
  },
  {
   "texto": "Царь, хоть был встревожен сильно,"
  },
  {
   "texto": "Усмехнулся ей умильно."
  },
  {
   "texto": "Вот — въезжает в город он;"
  },
  {
   "texto": "Вдруг раздался легкой звон,"
  },
  {
   "texto": "И в глазах у всей столицы"
  },
  {
   "texto": "Петушок спорхнул со спицы;"
  },
  {
   "texto": "К колеснице полетел"
  },
  {
   "texto": "И царю на темя сел,"
  },
  {
   "texto": "Встрепенулся, клюнул в темя"
  },
  {
   "texto": "И взвился… и в то же время"
  },
  {
   "texto": "С колесницы пал Дадон!"
  },
  {
   "texto": "Охнул раз, — и умер он."
  },
  {
   "texto": "А царица вдруг пропала,"
  },
  {
   "texto": "Будто вовсе не бывало."
  },
  {
   "texto": "Сказка ложь, да в ней намек!"
  },
  {
   "texto": "Добрым молодцам урок."
  },
  {
   "texto": "1834"
  },
  {
   "texto": "Примечания"
  }
 ]
}