 "modo": "texto",
 "parrafos": [
  {
   "texto": "428"
  },
  {
   "texto": "Старину скажу стародавнюю,"
  },
  {
   "texto": "Стародавнюю, небывалую;"
  },
  {
   "texto": "Старика свяжу со старухою,"
  },
  {
   "texto": "Со старухою с кособрюхою."
  },
  {
   "texto": "То вам не чудо, не диковинка,"
  },
  {
   "texto": "Я видал чуда чуднее того:"
  },
  {
   "texto": "Середи моря овин горит,"
  },
  {
   "texto": "По чисту полю корабль бежит!"
  },
  {
   "texto": "То вам не чудо, не диковинка,"
  },
  {
   "texto": "Ещё вот вам чудо чуднее того:"
  },
  {
   "texto": "Уж как кутюшка бычка родила,"
  },
  {
   "texto": "Поросёночек яичко снёс!"
  },
  {
   "texto": "Это вам не чудо, не диковинка,"
  },
  {
   "texto": "Я видал чуда чуднее того:"
  },
  {
   "texto": "Мужики на улице заезки бьют,"
  },
  {
   "texto": "Заезки бьют, они рыб ловят!"
  },
  {
   "texto": "То вам не чудо, не диковинка,"
  },
  {
   "texto": "Я видал чуда чуднее того:"
  },
  {
   "texto": "По поднебесью медведь летит,"
  },
  {
   "texto": "Ушками, лапками помахивает,"
  },
  {
   "texto": "Серым хвостиком поправливает;"
  },
  {
   "texto": "На дубу кобыла белку злаяла,"
  },
  {
   "texto": "В стойле сука в запрягу стоит,"
  },
  {
   "texto": "В осеку овца гнездо свила!"
  },
  {
   "texto": "И тому чуду не дивуйтеся:"
  },
  {
   "texto": "С горы корова на лыжах катится,"
  },
  {
   "texto": "Расширя ноги, глаза выпуча!"
  },
  {
   "texto": "И то не чудо, не диковинка,"
  },
  {
   "texto": "Я видал чуда чуднее того:"
  },
  {
   "texto": "Сын на матери снопы возил,"
  },
  {
   "texto": "Молода жена в пристяжи была;"
  },
  {
   "texto": "Сын матушку припонюживал,"
  },
  {
   "texto": "Молоду жену призадёрживал!"
  },
  {
   "texto": "Я ещё видел чудо-диковинку:"
  },
  {
   "texto": "Бьётся сноха со свекровкою,"
  },
  {
   "texto": "Большим боём бьются — мутовками,"
  },
  {
   "texto": "Ложками стреляли во чисто поле;"
  },
  {
   "texto": "Устрелили татарина мёртвого,"
  },
  {
   "texto": "Кафтан с него сняли рогозяный,"
  },
  {
   "texto": "Опоясочку с него сняли лычану,"
  },
  {
   "texto": "Сапоги с него сняли берестяные."
  },
  {
   "texto": "Кто богат да скуп: пива не варит,"
  },
  {
   "texto": "Нас, молодцев, не кормит, не поит,"
  },
  {
   "texto": "Тому даст бог кошечье вздыханье,"
  },
  {
   "texto": "Собачье взрыданье."
  },
  {
   "texto": "Небогатому, да тороватому,"
  },
  {
   "texto": "Кто пиво варит, нас, молодцев, поит,"
  },
  {
   "texto": "Даст бог на поле приплод,"
  },
  {
   "texto": "На гумне примолот."
  },
  {
   "texto": "В квашне спорину,"
  },
  {
   "texto": "На столе сдвижину."
  },
  {
   "texto": "С пива с того приупился мужик,"
  },
  {
   "texto": "Приупившись, сам на сарае лежит,"
  },
  {
   "texto": "У рта кроха — полтора колпака…"
  }
 ]
}