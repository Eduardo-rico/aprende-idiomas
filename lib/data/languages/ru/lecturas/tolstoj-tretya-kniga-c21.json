{
 "id": "tolstoj-tretya-kniga-c21",
 "titulo": "Вольга-Богатырь",
 "autor": "Лев Толстой",
 "muerteAutor": 1910,
 "fuenteUrl": "https://ru.wikisource.org/wiki/%D0%A2%D1%80%D0%B5%D1%82%D1%8C%D1%8F_%D1%80%D1%83%D1%81%D1%81%D0%BA%D0%B0%D1%8F_%D0%BA%D0%BD%D0%B8%D0%B3%D0%B0_%D0%B4%D0%BB%D1%8F_%D1%87%D1%82%D0%B5%D0%BD%D0%B8%D1%8F_(%D0%9B%D0%B5%D0%B2_%D0%A2%D0%BE%D0%BB%D1%81%D1%82%D0%BE%D0%B9)",
 "fuente": "ru.wikisource.org, «Третья русская книга для чтения»",
 "licencia": "dominio público (autor muerto en 1910)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC, sin acentos de intensidad editoriales. La transcripción sigue la ortografía posterior a la reforma de 1918 y escribe la «ё» (1 formas); la «ё» opcional se deja como está en la fuente. Nivel A2 DECLARADO por criterio (anclas-ru.mjs): literatura escrita para niños que empiezan a leer — frase corta, léxico concreto, fórmulas repetidas; la densidad polisilábica rusa la sube a B1 por morfología, no por dificultad.",
 "serie": {
  "id": "tolstoj-tretya-kniga",
  "titulo": "Третья русская книга для чтения",
  "orden": 21
 },
 "variante": "ru",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "(Стихи-сказка)"
  },
  {
   "texto": "Что не мелки часты звездочки"
  },
  {
   "texto": "Рассажалися по поднебесью,"
  },
  {
   "texto": "Что ни ясен светел месяц"
  },
  {
   "texto": "Просветил в небе высокоем, —"
  },
  {
   "texto": "Осветило красно солнышко"
  },
  {
   "texto": "Нашу землю святорусскую:"
  },
  {
   "texto": "На святой Руси на матушке"
  },
  {
   "texto": "Народился удал молодец"
  },
  {
   "texto": "Свет Вольга — сударь Буслаевич;"
  },
  {
   "texto": "От рожденья богатырского"
  },
  {
   "texto": "Потряслася мать сыра земля,"
  },
  {
   "texto": "Море сине всколыбалося,"
  },
  {
   "texto": "Рыбы вглубь моря забилися,"
  },
  {
   "texto": "Звери в чащи схоронилися,"
  },
  {
   "texto": "Потряслось царство турецкое."
  },
  {
   "texto": "Вырастал Вольга семи годов —"
  },
  {
   "texto": "Захотел он много мудрости."
  },
  {
   "texto": "К мудрецам задался в выучку,"
  },
  {
   "texto": "И в наук пошло учение."
  },
  {
   "texto": "Понимал Вольга все мудрости:"
  },
  {
   "texto": "Обучился первой мудрости —"
  },
  {
   "texto": "Оборачиваться птицею;"
  },
  {
   "texto": "Обучился другой мудрости —"
  },
  {
   "texto": "Оборачиваться рыбою;"
  },
  {
   "texto": "Обучился третьей мудрости —"
  },
  {
   "texto": "Серым волком ся обертывать."
  },
  {
   "texto": "Как и стал Вольга в пятнадцать лет,"
  },
  {
   "texto": "Подбирал Вольга дружинушку;"
  },
  {
   "texto": "И собрал он себе ровнюшек —"
  },
  {
   "texto": "Удалых ли добрых молодцев —"
  },
  {
   "texto": "Тридцать братьев без единого,"
  },
  {
   "texto": "Становился сам в тридцатыих."
  },
  {
   "texto": "Как и стал Вольга с дружиною"
  },
  {
   "texto": "На крутом яру у Киева,"
  },
  {
   "texto": "Взговорит Вольга Буслаевич:"
  },
  {
   "texto": "«Вы, дружина моя храбрая,"
  },
  {
   "texto": "«Тридцать братьев без единого,"
  },
  {
   "texto": "«Сам Вольга я во тридцатыих, —"
  },
  {
   "texto": "«Вы большого брата слушайте,"
  },
  {
   "texto": "«Повелено дело делайте:"
  },
  {
   "texto": "«Повяжите сети шелковы."
  },
  {
   "texto": "«Опускайте в море синее»."
  },
  {
   "texto": "Тут Вольгу дружина слушалась:"
  },
  {
   "texto": "Повязала сети шелковы,"
  },
  {
   "texto": "Опускала в море синее."
  },
  {
   "texto": "Рыбой Вольга ся обертывал,"
  },
  {
   "texto": "Рыбой-щукою зубастою,"
  },
  {
   "texto": "Во станы поплыл глубокие,"
  },
  {
   "texto": "Распугал всю рыбу красную,"
  },
  {
   "texto": "Загонял рыбу во часты сети."
  },
  {
   "texto": "Как и стал Вольга с дружиною"
  },
  {
   "texto": "На крутом яру у Киева,"
  },
  {
   "texto": "Взговорит Вольга Буслаевич:"
  },
  {
   "texto": "«Вы, дружина моя храбрая,"
  },
  {
   "texto": "«Тридцать братьев без единого,"
  },
  {
   "texto": "«Сам Вольга я во тридцатыих, —"
  },
  {
   "texto": "«Брата большего вы слушайте,"
  },
  {
   "texto": "«Повелено дело делайте:"
  },
  {
   "texto": "«Вейте шелковы веревочки,"
  },
  {
   "texto": "«Расстанавливайте по лесу,"
  },
  {
   "texto": "«На звериных ли на тропочках»."
  },
  {
   "texto": "Тут Вольгу дружина слушалась:"
  },
  {
   "texto": "Вила шелковы веревочки,"
  },
  {
   "texto": "Расстанавливала по лесу,"
  },
  {
   "texto": "Зверем Вольга ся обертывал,"
  },
  {
   "texto": "Серым волком голенастыим,"
  },
  {
   "texto": "Поскакал в леса дремучие,"
  },
  {
   "texto": "Во глухи ломы, во чащицы."
  },
  {
   "texto": "Распугал он зверя кунного,"
  },
  {
   "texto": "Загонял зверя во петельки."
  },
  {
   "texto": "Как и стал Вольга с дружиною"
  },
  {
   "texto": "На крутом яру у Киева,"
  },
  {
   "texto": "Взговорит Вольга Буслаевич:"
  },
  {
   "texto": "«Половили мы всю рыбушку"
  },
  {
   "texto": "«Из синя моря глубокого,"
  },
  {
   "texto": "«Половили зверя кунного"
  },
  {
   "texto": "«Из темных лесов дремучиих:"
  },
  {
   "texto": "«А и будет ли тот молодец,"
  },
  {
   "texto": "«Чтоб сходил в царство турецкое"
  },
  {
   "texto": "«Ко царю Салтан Бекетычу,"
  },
  {
   "texto": "«Сведать думу его царскую»."
  },
  {
   "texto": "Молодцы тут стали прятаться,"
  },
  {
   "texto": "Что большой да за середнего,"
  },
  {
   "texto": "А середний что за меньшего,"
  },
  {
   "texto": "А ответа нет от меньшего."
  },
  {
   "texto": "Говорит Вольга Буслаевич:"
  },
  {
   "texto": "«Вольге будет самому идти»."
  },
  {
   "texto": "Птицей Вольга ся обертывал,"
  },
  {
   "texto": "Высоко взвился под небесью:"
  },
  {
   "texto": "Прилетал в царство турецкое,"
  },
  {
   "texto": "На оконце сел косящато."
  },
  {
   "texto": "Сидит царь Салтан Бекетович"
  },
  {
   "texto": "Со царицею Давыдьевной, —"
  },
  {
   "texto": "Разговоры разговарива(е)т:"
  },
  {
   "texto": "Говорит Салтан Бекетович:"
  },
  {
   "texto": "«Ты, жена моя возлюбленна,"
  },
  {
   "texto": "«Молода ли свет Давыдьевна,"
  },
  {
   "texto": "«Воевать хочу святую Русь,"
  },
  {
   "texto": "«Хочу взять я славный Киев-град,"
  },
  {
   "texto": "«Подарить хочу по городу"
  },
  {
   "texto": "«Девяти сынам по русскому;"
  },
  {
   "texto": "«Да привезть хочу я шубоньку"
  },
  {
   "texto": "«Дорогую, соболиную»."
  },
  {
   "texto": "Взговорит ему Давыдьевна:"
  },
  {
   "texto": "«Гой ты, царь Салтан Бекетович!"
  },
  {
   "texto": "«Ты напрасно снаряжаешься"
  },
  {
   "texto": "«Воевать на землю русскую."
  },
  {
   "texto": "«Али ты того не ведаешь —"
  },
  {
   "texto": "«На Руси всё не по-старому."
  },
  {
   "texto": "«Осветило красно солнышко"
  },
  {
   "texto": "«Славну землю святорусскую:"
  },
  {
   "texto": "«Народился удал молодец"
  },
  {
   "texto": "«Богатырь Вольга Буслаевич."
  },
  {
   "texto": "«Он теперь Вольга Буслаевич"
  },
  {
   "texto": "«На окне сидит и слушает"
  },
  {
   "texto": "«Наши речи с тобой тайные."
  },
  {
   "texto": "«Не возьмешь ты славный Киев-град,"
  },
  {
   "texto": "«Не подаришь ты по городу"
  },
  {
   "texto": "«Девяти сынам по русскому,"
  },
  {
   "texto": "«А пропасть твоей головушке"
  },
  {
   "texto": "«От того Вольги Бусла(е)вича»."
  },
  {
   "texto": "Тем словам Салтан не веровал,"
  },
  {
   "texto": "На царицу царь прогневался —"
  },
  {
   "texto": "По лицу ударил белому,"
  },
  {
   "texto": "Прогонял он с глаз Давыдьевну."
  },
  {
   "texto": "Догадался Вольг Буслаевич,"
  },
  {
   "texto": "Горностаем ся обертывал,"
  },
  {
   "texto": "В погреба бежал глубокие. —"
  },
  {
   "texto": "Он тетивочки шелковые"
  },
  {
   "texto": "На луках тугих накусывал,"
  },
  {
   "texto": "С каленых-от стрел железочки"
  },
  {
   "texto": "Он повынимал — закапывал,"
  },
  {
   "texto": "Оборачивался птицею,"
  },
  {
   "texto": "Прилетал назад ко Киеву,"
  },
  {
   "texto": "Собирал свою дружинушку,"
  },
  {
   "texto": "Подходил к царству турецкому."
  },
  {
   "texto": "Царство крепко огорожено"
  },
  {
   "texto": "Стеной каменной, высокою."
  },
  {
   "texto": "Во стене ворота крепкие,"
  },
  {
   "texto": "По булату золоченые,"
  },
  {
   "texto": "А засовы — крюки медные,"
  },
  {
   "texto": "Подворотня — дорог рыбий зуб,"
  },
  {
   "texto": "Мелким вырезом вырезана,"
  },
  {
   "texto": "По мудреным мелким вырезам,"
  },
  {
   "texto": "В пору ли пролезть мурашику."
  },
  {
   "texto": "Тут дружина закручинилась:"
  },
  {
   "texto": "«Как пройти нам стены каменны?"
  },
  {
   "texto": "«Погубить ли добрым молодцам"
  },
  {
   "texto": "«Нам головушки напрасные?»"
  },
  {
   "texto": "Догадался Вольг Буслаевич:"
  },
  {
   "texto": "Мурашом себя обертывал,"
  },
  {
   "texto": "Добрых молодцев мурашками, —"
  },
  {
   "texto": "Пролезал с своей дружиною"
  },
  {
   "texto": "В подворотню зуба рыбьего;"
  },
  {
   "texto": "За стеной Вольга Буслаевич"
  },
  {
   "texto": "Оборачивал мурашиков"
  },
  {
   "texto": "Молодцами с сбруей ратною."
  },
  {
   "texto": "Взговорит ли Вольг Буслаевич:"
  },
  {
   "texto": "«Вы большого брата слушайте,"
  },
  {
   "texto": "«Повелено дело делайте:"
  },
  {
   "texto": "«В славном царстве во турецкиим"
  },
  {
   "texto": "«Вырубайте стар и малого."
  },
  {
   "texto": "«Изведите всех до кореня:"
  },
  {
   "texto": "«Оставляйте только лучшиих"
  },
  {
   "texto": "«Тридцать душек красных девушек»."
  },
  {
   "texto": "Тут Вольгу дружина слушалась:"
  },
  {
   "texto": "В славном царстве во турецкиим"
  },
  {
   "texto": "Вырубала стар и малого,"
  },
  {
   "texto": "Изводила всех до кореня,"
  },
  {
   "texto": "Не оставила на семена;"
  },
  {
   "texto": "Оставляла только лучшиих"
  },
  {
   "texto": "Тридцать душек красных девушек."
  },
  {
   "texto": "Сам Вольга царя отыскивал"
  },
  {
   "texto": "Во палатах его каменных:"
  },
  {
   "texto": "Двери заперты железные,"
  },
  {
   "texto": "Во дверях засовы крепкие:"
  },
  {
   "texto": "Взговорит ли Вольг Буслаевич:"
  },
  {
   "texto": "«Хоть ногу сломать, а выставить!»"
  },
  {
   "texto": "Пнул ногой двери железные,"
  },
  {
   "texto": "Поломал засовы крепкие;"
  },
  {
   "texto": "Царя славного турецкого"
  },
  {
   "texto": "Брал Вольга за ручки белые."
  },
  {
   "texto": "Говорил Вольга Буслаевич:"
  },
  {
   "texto": "«А не бьют царей, не казнят вас», —"
  },
  {
   "texto": "Царя хлопнул о кирпищат пол,"
  },
  {
   "texto": "И расшиб Салтана вдребезги."
  },
  {
   "texto": "Тут дружину свою храбрую"
  },
  {
   "texto": "Вольга поровну оделивал —"
  },
  {
   "texto": "Табунов коней по тысяче,"
  },
  {
   "texto": "По боченку красна золота"
  },
  {
   "texto": "Да по девушке на молодца."
  }
 ]
}