  {
   "texto": "Což plátno, že ten slavíček"
  },
  {
   "texto": "Což platno, že ten slavíček"
  },
  {
   "texto": "tak přelíbezně zpívá,"
  },
  {
   "texto": "když odcizeno srdce mé"
  },
  {
   "texto": "a u Tebe jen dlívá."
  },
  {
   "texto": "A kdyby ještě líbezněj"
  },
  {
   "texto": "zpěv jeho vábil uši:"
  },
  {
   "texto": "což platno, když Tě v srdci mám"
  },
  {
   "texto": "a plnou Tebe duši!"
  },
  {
   "texto": "A to tak krásně líbeznou,"
  },
  {
   "texto": "že člověk sotva tuší,"
  },
  {
   "texto": "že bych Ti s nebe hvězdy snes"
  },
  {
   "texto": "a za Tebe dal duši."
  },
  {
   "texto": "Mně zdálo se, žes umřela;"
  },
  {
   "texto": "slyšel jsem zvonit hrany,"
  },
  {
   "texto": "a pláče bylo, kvílení"
  },
  {
   "texto": "a nářku na vše strany."
  },
  {
   "texto": "Tak divně Ti tam ustlali!"
  },
  {
   "texto": "Na hrob Ti kámen dali,"
  },
  {
   "texto": "a abych na něj napsal verš"
  },
  {
   "texto": "mne vlídně požádali."
  },
  {
   "texto": "O lidé, lidé z kamene,"
  },
  {
   "texto": "zde srdce mé si mějte,"
  },
  {
   "texto": "a co jsem ještě nezpíval,"
  },
  {
   "texto": "to do kamene vrejte!"
  },
  {
   "texto": "Mé lásce jste nevěřili"
  },
  {
   "texto": "a zhrdli mými slovy,"
  },
  {
   "texto": "když bude kámen mluvit k vám,"
  },
  {
   "texto": "snad vám to lépe poví."
  },
  {
   "texto": "Když Bůh byl nejvíc rozkochán,"
  },
  {
   "texto": "tu lidské srdce stvořil,"
  },
  {
   "texto": "a pak na věčnou památku"
  },
  {
   "texto": "v ně svoji lásku vložil."
  },
  {
   "texto": "A když pak na něm utkvělo"
  },
  {
   "texto": "to oko jeho věstí,"
  },
  {
   "texto": "radostí až se rozplakal,"
  },
  {
   "texto": "když viděl vše to štěstí."
  },
  {
   "texto": "Leč při tom pláči — do srdce"
  },
  {
   "texto": "se jedna slza vkradla,"
  },
  {
   "texto": "jako ta rosa v kalíšek,"
  },
  {
   "texto": "a na samé dno padla."
  },
  {
   "texto": "A proto láska velký bol,"
  },
  {
   "texto": "leč bol tak sladký, milý,"
  },
  {
   "texto": "že škoda srdcí nastokrát,"
  },
  {
   "texto": "jež bol ten necítily."
  },
  {
   "texto": "A proto láska štěstí půl"
  },
  {
   "texto": "a polovic je muka,"
  },
  {
   "texto": "leč když se srdce rozvlní"
  },
  {
   "texto": "tu leckdy srdce puká."
  },
  {
   "texto": "Tak mnoho věcí na světě,"
  },
  {
   "texto": "k nimž člověk klíče nemá,"
  },
  {
   "texto": "a všechněm jeho otázkám"
  },
  {
   "texto": "vždy odpověď jen němá."
  },
  {
   "texto": "To lidské srdce — strastí v něm"
  },
  {
   "texto": "jak hejno vlků vyje,"
  },
  {
   "texto": "a přec to srdce, Bože můj,"
  },
  {
   "texto": "jen samé lásce žije."
  },
  {
   "texto": "A schopno lásky takové,"
  },
  {
   "texto": "že až by člověk šílel,"
  },
  {
   "texto": "a zklamán, jak ten holoubek"
  },
  {
   "texto": "na věky věkův kvílel."
  }
 ]
