 "parrafos": [
  {
   "texto": "Má milá, pojď, přisedni blíž"
  },
  {
   "texto": "Má milá, pojď, přisedni blíž,"
  },
  {
   "texto": "ať zobejímám Tebe;"
  },
  {
   "texto": "Pánbůh Ti krásnou duši dal,"
  },
  {
   "texto": "žes jako anděl z nebe."
  },
  {
   "texto": "Mně jest tak často, jako bych"
  },
  {
   "texto": "se zpovídat měl Tobě,"
  },
  {
   "texto": "leč slova v ústech zamknutá"
  },
  {
   "texto": "tak jako mrtvý v hrobě."
  },
  {
   "texto": "A co tak často Ti chci říc',"
  },
  {
   "texto": "to ani jména nemá,"
  },
  {
   "texto": "má duše toho plna jest,"
  },
  {
   "texto": "leč ústa moje němá."
  },
  {
   "texto": "Jen když Tě mám obejmutou"
  },
  {
   "texto": "a duši v Tebe vhroužím,"
  },
  {
   "texto": "tu zdá se mi, že všechno víš,"
  },
  {
   "texto": "co povědět Ti toužím."
  },
  {
   "texto": "Když jsem se díval do nebe"
  },
  {
   "texto": "skrz ty hvězdičky zlaty,"
  },
  {
   "texto": "mně zdálo se, žes světice"
  },
  {
   "texto": "a já že anděl svatý."
  },
  {
   "texto": "Tu vzal jsem harfu do ruky"
  },
  {
   "texto": "a písně jsem Ti zpíval,"
  },
  {
   "texto": "že písně svatých umlkly"
  },
  {
   "texto": "a každý k nám se díval."
  },
  {
   "texto": "Ba sám Bůh Otec na chvíli"
  },
  {
   "texto": "v svých tvůrčích plánech stanul,"
  },
  {
   "texto": "a zdá se mi, že po tváři"
  },
  {
   "texto": "mu slzný démant kanul."
  },
  {
   "texto": "Ty hvězdičky tam na nebi —"
  },
  {
   "texto": "to veliké jsou světy;"
  },
  {
   "texto": "a já bych jenom věděl rád,"
  },
  {
   "texto": "jaké tam tvory vsety."
  },
  {
   "texto": "Zda také někdo odtamtud"
  },
  {
   "texto": "se k nám sem dolů dívá,"
  },
  {
   "texto": "a jestli tam, jako zde já,"
  },
  {
   "texto": "o lásce písně zpívá."
  },
  {
   "texto": "Ten není rekem největším,"
  },
  {
   "texto": "kdo udeřen zas udeří;"
  },
  {
   "texto": "ten velký, kdo byl oklamán"
  },
  {
   "texto": "a přec se nezpronevěří."
  },
  {
   "texto": "Kdo lásce doved' zlořečit,"
  },
  {
   "texto": "ten nepoznal ji ani,"
  },
  {
   "texto": "neb láska umí odpustit"
  },
  {
   "texto": "a nezná proklínání."
  },
  {
   "texto": "Kdo není schopen oběti,"
  },
  {
   "texto": "ten lásky hoden není,"
  },
  {
   "texto": "a špatný kněz, kdo sebe víc"
  },
  {
   "texto": "než svoji oběť cení."
  },
  {
   "texto": "A kdyby láska žádala"
  },
  {
   "texto": "mé žití i mé nebe"
  },
  {
   "texto": "já šel bych jak ten beránek,"
  },
  {
   "texto": "že miloval jsem Tebe."
  }
 ]
