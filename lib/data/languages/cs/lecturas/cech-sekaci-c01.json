{
 "id": "cech-sekaci-c01",
 "titulo": "Zpěv I.-VIII.",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Sek%C3%A1%C4%8Di/I.",
 "fuente": "cs.wikisource.org, «Sekáči»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (1 formas) con el actual en «-t» (8). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-sekaci",
  "titulo": "Sekáči",
  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I."
  },
  {
   "texto": "Vy lány široké a luhy,"
  },
  {
   "texto": "polí nesčíslné pruhy,"
  },
  {
   "texto": "kam až sahá chodce zor,"
  },
  {
   "texto": "jak smavo mi,"
  },
  {
   "texto": "jakzdravo mi,"
  },
  {
   "texto": "když letí zraky nespoutané"
  },
  {
   "texto": "přes vaše vzorce pestrotkané"
  },
  {
   "texto": "až k modru hor,"
  },
  {
   "texto": "jichž obrys lehce vdechnut na obzor!"
  },
  {
   "texto": "Vy líchy zelené a zlaté,"
  },
  {
   "texto": "s českou duší pevně spjaté,"
  },
  {
   "texto": "její vzpomínka i sen,"
  },
  {
   "texto": "z těch vašich pout"
  },
  {
   "texto": "se těžko zout:"
  },
  {
   "texto": "nechť kdekoli váš rodák vězí,"
  },
  {
   "texto": "jej oblétá dech vašich mezí"
  },
  {
   "texto": "a ve vás jen"
  },
  {
   "texto": "klid nachází, sám sobě navrácen."
  },
  {
   "texto": "Jen jedna hymna k nebi vznáší"
  },
  {
   "texto": "pravé vzlety země naší,"
  },
  {
   "texto": "z jejích citův utkána:"
  },
  {
   "texto": "když pod blankyt"
  },
  {
   "texto": "nad mořem žit,"
  },
  {
   "texto": "nad sekáčů a žneček davy"
  },
  {
   "texto": "svůj vznese trylek rokotavý"
  },
  {
   "texto": "zpěv skřivana"
  },
  {
   "texto": "a práci pěje libé hosanna!"
  },
  {
   "texto": "Nechť klasy ducha žít nám třeba"
  },
  {
   "texto": "nebo jít za skývou chleba"
  },
  {
   "texto": "v trhů vír a dílen hluk,"
  },
  {
   "texto": "v ten ruch a shon"
  },
  {
   "texto": "jak dálný zvon,"
  },
  {
   "texto": "jež zabloudilce volá zpátky"
  },
  {
   "texto": "v kraj, kde je doma, na klín matky,"
  },
  {
   "texto": "vždy onen zvuk"
  },
  {
   "texto": "se ozve zas a zrychlí srdce tluk."
  },
  {
   "texto": "Nechť valem tíhnem’ v městské vřavy,"
  },
  {
   "texto": "přece náš je živel pravý,"
  },
  {
   "texto": "pravým teplem dýše krb"
  },
  {
   "texto": "tam jedině"
  },
  {
   "texto": "v té šířině,"
  },
  {
   "texto": "kde v dál se táhnou lány, luhy,"
  },
  {
   "texto": "kde voní doškou mezi stuhy,"
  },
  {
   "texto": "kde zvoní srp"
  },
  {
   "texto": "ve žlutém obilí a modru chrp."
  },
  {
   "texto": "II."
  },
  {
   "texto": "Na širokých polích,"
  },
  {
   "texto": "na dalekých polích"
  },
  {
   "texto": "jaká krása dnes!"
  },
  {
   "texto": "Stébel husté davy"
  },
  {
   "texto": "výše mužské hlavy"
  },
  {
   "texto": "stojí jako les."
  },
  {
   "texto": "Klasů jasné vlny"
  },
  {
   "texto": "těžkým zrním plny"
  },
  {
   "texto": "šumí vedle cest,"
  },
  {
   "texto": "a když van je sehne,"
  },
  {
   "texto": "mezi nimi šlehne"
  },
  {
   "texto": "na sta modrých hvězd."
  },
  {
   "texto": "V brokátovém hávě,"
  },
  {
   "texto": "v plné letní slávě"
  },
  {
   "texto": "září každý lán,"
  },
  {
   "texto": "těší se své kráse,"
  },
  {
   "texto": "všecek usmívá se,"
  },
  {
   "texto": "sluncem zulíbán."
  },
  {
   "texto": "Však tu nivou náhle"
  },
  {
   "texto": "prochvělo cos táhle"
  },
  {
   "texto": "jako teskný vzdech,"
  },
  {
   "texto": "jakby všechno zbledlo,"
  },
  {
   "texto": "s uleknutím vzhledlo"
  },
  {
   "texto": "k hrstce šedých střech."
  },
  {
   "texto": "Odtud blesklo cosi —"
  },
  {
   "texto": "zasvitly tam kosy"
  },
  {
   "texto": "v jitřním pablesku,"
  },
  {
   "texto": "s nimi na rameně"
  },
  {
   "texto": "muži odměřeně"
  },
  {
   "texto": "vyšli na stezku."
  },
  {
   "texto": "Postavy to silné;"
  },
  {
   "texto": "ruce tvrdé žilné;"
  },
  {
   "texto": "osmahlá je pleť;"
  },
  {
   "texto": "i hruď, zpráhlá žárem,"
  },
  {
   "texto": "režných košil spárem"
  },
  {
   "texto": "svítí jako měď."
  },
  {
   "texto": "Sbor ten, s krbci v pasu,"
  },
  {
   "texto": "došel k moři klasů,"
  },
  {
   "texto": "kosy sklonil v zem,"
  },
  {
   "texto": "nahoře pak na ně"
  },
  {
   "texto": "složil drsné dlaně,"
  },
  {
   "texto": "chvíli postál něm."
  },
  {
   "texto": "Ještě v zadumání"
  },
  {
   "texto": "rozhlíží se plání"
  },
  {
   "texto": "přes ten zlatý les,"
  },
  {
   "texto": "pnoucí se tu v pýše"
  },
  {
   "texto": "po široké líše"
  },
  {
   "texto": "naposledy dnes."
  },
  {
   "texto": "III."
  },
  {
   "texto": "Starý sekáč:"
  },
  {
   "texto": "Úroda tu požehnaná -"
  },
  {
   "texto": "jenom hleďte na ni!"
  },
  {
   "texto": "jako jiskřící se zlato"
  },
  {
   "texto": "v boží štědré dlani."
  },
  {
   "texto": "Jiskra:"
  },
  {
   "texto": "Boží dlaň je otevřena,"
  },
  {
   "texto": "a v ní hojné dary,"
  },
  {
   "texto": "jen že u ní s holí v ruce"
  },
  {
   "texto": "hlídač volá: Vari!"
  },
  {
   "texto": "Šimon:"
  },
  {
   "texto": "Smíšek jsi - mně nad tím řádem"
  },
  {
   "texto": "jenom žluč se pění,"
  },
  {
   "texto": "že i boží ruku vlídnou"
  },
  {
   "texto": "v pěst si na nás mění."
  },
  {
   "texto": "Starý sekáč:"
  },
  {
   "texto": "Nechte, hoši, mudrování,"
  },
  {
   "texto": "raděj’čile k dílu,"
  },
  {
   "texto": "dokud slunce v plném ohni"
  },
  {
   "texto": "nesedí nám v týlu."
  },
  {
   "texto": "A ty, mladý jonáku,"
  },
  {
   "texto": "čiperný náš zpěváku,"
  },
  {
   "texto": "než schystáme kosy,"
  },
  {
   "texto": "zazpívej nám cosi!"
  },
  {
   "texto": "IV."
  },
  {
   "texto": "Píseň mladého sekáče:"
  },
  {
   "texto": "Sekáči jak vojáci"
  },
  {
   "texto": "jdou si pěkně řadou,"
  },
  {
   "texto": "jdou si polem veselí,"
  },
  {
   "texto": "a kde máchnou ocelí,"
  },
  {
   "texto": "všechno na zem kladou."
  },
  {
   "texto": "Kosa pěkně zkřivená,"
  },
  {
   "texto": "naklepaná, broušená,"
  },
  {
   "texto": "do kola se blyští"
  },
  {
   "texto": "a jak vítr sviští."
  },
  {
   "texto": "V jeden ráz hned celý šik"
  },
  {
   "texto": "leží porubaný,"
  },
  {
   "texto": "ale jeho mrtvoly"
  },
  {
   "texto": "jsou jen klasů chocholy,"
  },
  {
   "texto": "krví mák je planý."
  },
  {
   "texto": "Nejdem vraždit do boje,"
  },
  {
   "texto": "vojáci jsme pokoje,"
  },
  {
   "texto": "a náš palaš křivý"
  },
  {
   "texto": "nás i jiné živí."
  },
  {
   "texto": "Jako voják vesele"
  },
  {
   "texto": "jdu si pěkně v řadě,"
  },
  {
   "texto": "za kloboukem chrpu mám,"
  },
  {
   "texto": "na zrak modrý vzpomínám,"
  },
  {
   "texto": "důlek v bílé bradě…"
  },
  {
   "texto": "Kosa k tomu tančící"
  },
  {
   "texto": "rozvlněnou pšenicí"
  },
  {
   "texto": "dokola se blyští"
  },
  {
   "texto": "a jak vítr sviští."
  },
  {
   "texto": "Šimon"
  },
  {
   "texto": "Věčně jen kol modrých očí"
  },
  {
   "texto": "tvoje myšlenky se točí."
  },
  {
   "texto": "Co nás moudré těší, tísní,"
  },
  {
   "texto": "marno čekat ve tvé písni."
  },
  {
   "texto": "V."
  },
  {
   "texto": "Zpěv jiného sekáče:"
  },
  {
   "texto": "Pěkně sekat z rána,"
  },
  {
   "texto": "hnedjak sejde rosa:"
  },
  {
   "texto": "v ruce ještě čerstvé"
  },
  {
   "texto": "letí pírkem kosa."
  },
  {
   "texto": "K tomu vyhrávají"
  },
  {
   "texto": "skřivanové shora"
  },
  {
   "texto": "krásnější než hudba"
  },
  {
   "texto": "královského dvora."
  },
  {
   "texto": "Dobře se nám seče -"
  },
  {
   "texto": "ale škoda, braši,"
  },
  {
   "texto": "že ty naše kosy,"
  },
  {
   "texto": "nežnou pšenku naši."
  },
  {
   "texto": "Požehnané lány"
  },
  {
   "texto": "vůkol přeširoko,"
  },
  {
   "texto": "dvory, sady, luka,"
  },
  {
   "texto": "kam až sahá oko,"
  },
  {
   "texto": "i les, který v dáli"
  },
  {
   "texto": "kraj náš vroubí temně -"
  },
  {
   "texto": "všechno pánům patří,"
  },
  {
   "texto": "nám ni hrstka země."
  },
  {
   "texto": "Naše v širém světě"
  },
  {
   "texto": "jsou ty kosy pouze"
  },
  {
   "texto": "a ty zdravé svaly,"
  },
  {
   "texto": "k tomu s bídou nouze."
  },
  {
   "texto": "VI."
  },
  {
   "texto": "Šimon:"
  },
  {
   "texto": "Toť už jiné! Tvoje noty"
  },
  {
   "texto": "lípnám zvoní do roboty. -"
  },
  {
   "texto": "Ptám se, bratři, kdo ty meze"
  },
  {
   "texto": "jakými táh’ právy?"
  },
  {
   "texto": "lánů sta propány, kněze,"
  },
  {
   "texto": "nám ni hrstku trávy?"
  },
  {
   "texto": "A proč rukou mozolnatou"
  },
  {
   "texto": "lopotím se v poli,"
  },
  {
   "texto": "z něhož jiný žeň si zlatou"
  },
  {
   "texto": "vozí do stodoly?"
  },
  {
   "texto": "Jiskra"
  },
  {
   "texto": "Vždyť on královským ti platem"
  },
  {
   "texto": "každý mozol zlatí!"
  },
  {
   "texto": "Jiní"
  },
  {
   "texto": "Baže! Kdo z nás hodí kosou,"
  },
  {
   "texto": "věru málo ztratí."
  },
  {
   "texto": "Šimon"
  },
  {
   "texto": "Spíš tou kosou - -"
  },
  {
   "texto": "Starý sekáč"
  },
  {
   "texto": "Ticho,konec!"
  },
  {
   "texto": "Už nás práce volá."
  },
  {
   "texto": "Před polednem až tam k dubu"
  },
  {
   "texto": "ať je lícha holá!"
  },
  {
   "texto": "Pak nám schaldí horká čela"
  },
  {
   "texto": "větev rozložitá,"
  },
  {
   "texto": "kde už z jitra jakýs lenoch"
  },
  {
   "texto": "- hleďte! - lelky chytá."
  },
  {
   "texto": "VII."
  },
  {
   "texto": "Poeta (na procházce):"
  },
  {
   "texto": "Dub osamělý vévodí tu kraji"
  },
  {
   "texto": "jak obr zasmušilý v plesu žní,"
  },
  {
   "texto": "snad zbytek doubravy, kam nosil v taji"
  },
  {
   "texto": "svou ještě oběť pohan poslední."
  },
  {
   "texto": "Zde usednu si na omšelý kořen,"
  },
  {
   "texto": "bych - druid nový střízlivějších dnů -"
  },
  {
   "texto": "svým zrakem v půvab nivy letní vnořen"
  },
  {
   "texto": "tkal po ní vlákna pavoučí svých snů."
  },
  {
   "texto": "A snad můj vzdech nad tímto divadlem"
  },
  {
   "texto": "sám jediný zde rozkoš, obdiv hlásí,"
  },
  {
   "texto": "má duše jediným snad zrcadlem,"
  },
  {
   "texto": "v němž obhlíží ten kraj své letní krásy."
  },
  {
   "texto": "Snům vesnickým v tom klasů vlnobití"
  },
  {
   "texto": "jen zlato zisku příštího se třpytí,"
  },
  {
   "texto": "a kdyby víla Poesie tam"
  },
  {
   "texto": "se vánkem přikradla, kde slunce mění"
  },
  {
   "texto": "kos prostých ostří v démantový plam,"
  },
  {
   "texto": "zvuk hrubých slov o všední péči denní"
  },
  {
   "texto": "by zaplašil ji, šprýmy ošumělé"
  },
  {
   "texto": "jak cáry na sekáčů snědém těle."
  },
  {
   "texto": "Leč víla ta jen z dáli v jemnou duhu"
  },
  {
   "texto": "mi šatí oněch postav prostý řad,"
  },
  {
   "texto": "a skromnou žatvu skutečného luhu"
  },
  {
   "texto": "v lán mění snů, v žeň pohádkových vnad:"
  },
  {
   "texto": "tu převysoko jako zlaté háje"
  },
  {
   "texto": "pnou klasy nezemské svůj třpytný stvol,"
  },
  {
   "texto": "květ máku, chrp z nich svítí ohněm báje,"
  },
  {
   "texto": "sta purpurových, safírových kol,"
  },
  {
   "texto": "a velký srp jak oblouk půlměsíce,"
  },
  {
   "texto": "ze stříbra lesku tajemného skut,"
  },
  {
   "texto": "plá pod oválem něžným snivé líce,"
  },
  {
   "texto": "jíž Boza jímá uzardělá Rut."
  },
  {
   "texto": "Můj život sám - zda bděním jest či sněním?"
  },
  {
   "texto": "Co přelud pouhý v něm? co skutečnost?"
  },
  {
   "texto": "Jdu světa, lidí ruchem každodenním"
  },
  {
   "texto": "jak z jiných sfér jsem zabloudilý host."
  },
  {
   "texto": "Jak mydlin vzdušný třpyt se pro mne skvěje"
  },
  {
   "texto": "zjev menivý té zemské oblasti -"
  },
  {
   "texto": "co podstata mi jeho? Lidské děje"
  },
  {
   "texto": "mně divadlo, v němž nemám účasti."
  },
  {
   "texto": "I v nitru vlastním citů vlnobití"
  },
  {
   "texto": "- ples, bolest, rozkoš s vášně závratí -"
  },
  {
   "texto": "mně zdá se jiného jak odraz žití,"
  },
  {
   "texto": "kde světa řády toho neplatí,"
  },
  {
   "texto": "kde tupým snem se jeví život davu,"
  },
  {
   "texto": "jenž tyje z požitku neb jako skot"
  },
  {
   "texto": "ve stálé robotě svůj lije pot"
  },
  {
   "texto": "pod těsným jařmem smluveného mravu."
  },
  {
   "texto": "Snad Kosmu duch, když vzbudil dechem žití"
  },
  {
   "texto": "na zemské kouli mravenčí ten rod,"
  },
  {
   "texto": "by tvář jí zryli chodeb svojich sítí,"
  },
  {
   "texto": "v níž žili, tyli, krmili svůj plod"
  },
  {
   "texto": "a boje sváděli o stébla, střepy,"
  },
  {
   "texto": "v tom shonu žití pro vše jiné slepi, -"
  },
  {
   "texto": "k nim vtrousil jiné též, by jejich zorem"
  },
  {
   "texto": "sám pozoroval svého díla vděk,"
  },
  {
   "texto": "lad barev skrytý ostatním a forem,"
  },
  {
   "texto": "pel tajemný svých tvůrčích myšlenek…"
  },
  {
   "texto": "Hle! tito kolem v potu kosí, žnou,"
  },
  {
   "texto": "by pána krmili a sami syti"
  },
  {
   "texto": "po práci večer, nízkým stropem kryti,"
  },
  {
   "texto": "kam sklonit měli hlavu zemdlenou."
  },
  {
   "texto": "I my jsme ženci, ale k práci jiné"
  },
  {
   "texto": "nám vlání klasůmyšlenkových kyne:"
  },
  {
   "texto": "z těch zrn, jež ruka naše zasije,"
  },
  {
   "texto": "dav nechystá si všední těla chleby,"
  },
  {
   "texto": "než svatozářná duchů hostie"
  },
  {
   "texto": "od prachu zemského se vznáší k nebi!"
  },
  {
   "texto": "VIII."
  },
  {
   "texto": "Myšlenky sekáčů."
  },
  {
   "texto": "Starý."
  },
  {
   "texto": "Co my jsme se natančili"
  },
  {
   "texto": "spolu vesele,"
  },
  {
   "texto": "co jsme, koso, pokosili"
  },
  {
   "texto": "pšenky, jetele!"
  },
  {
   "texto": "A nechť hlava teď se bělá,"
  },
  {
   "texto": "nakřivuje plec,"
  },
  {
   "texto": "ruka stará dále tančit"
  },
  {
   "texto": "musí s tebou přec."
  },
  {
   "texto": "Koso, neustaň,"
  },
  {
   "texto": "dokud slouží dlaň!"
  },
  {
   "texto": "U syna sic, Bohu díky,"
  },
  {
   "texto": "suchý koutek mám,"
  },
  {
   "texto": "ale chuďas drobet chleba"
  },
  {
   "texto": "s nouzí shání sám."
  },
  {
   "texto": "Z holých dlaní hejno dětí"
  },
  {
   "texto": "uživit je kříž -"
  },
  {
   "texto": "nesmí k tomu starý táta"
  },
  {
   "texto": "padnout na obtíž."
  },
  {
   "texto": "Koso, neustaň,"
  },
  {
   "texto": "dokud stačí dlaň!"
  },
  {
   "texto": "Beztoho za krátkou dobu"
  },
  {
   "texto": "bude konec as,"
  },
  {
   "texto": "službu vypoví mi ruka,"
  },
  {
   "texto": "stářím klesne vaz,"
  },
  {
   "texto": "a pak musím rozloučit se"
  },
  {
   "texto": "navždy s robotou,"
  },
  {
   "texto": "chodit pěkně po staveních"
  },
  {
   "texto": "v pátek žebrotou."
  },
  {
   "texto": "Koso, braň se, braň,"
  },
  {
   "texto": "dokud stačí dlaň!"
  },
  {
   "texto": "Za humny už jiný sekáč"
  },
  {
   "texto": "očekává mne,"
  },
  {
   "texto": "samého mě jako stéblo"
  },
  {
   "texto": "rázem podetne."
  },
  {
   "texto": "Po lopotě odpočinu"
  },
  {
   "texto": "tamhle nad bory"
  },
  {
   "texto": "na hřbitově vedle vrátek"
  },
  {
   "texto": "u své Barbory."
  },
  {
   "texto": "Koso, neustaň,"
  },
  {
   "texto": "dokud slouží dlaň!"
  },
  {
   "texto": "Ženich"
  },
  {
   "texto": "Kosa kruhem zavíří,"
  },
  {
   "texto": "složí k řádce řádku,"
  },
  {
   "texto": "by též halíř k halíři,"
  },
  {
   "texto": "klad se na hromádku."
  },
  {
   "texto": "Svatba bude za krátko,"
  },
  {
   "texto": "třeba platit štolu,"
  },
  {
   "texto": "až, mé drahé děvčátko,"
  },
  {
   "texto": "z chrámu půjdem spolu."
  },
  {
   "texto": "Samo potom obilí"
  },
  {
   "texto": "klást se bude řadou,"
  },
  {
   "texto": "vzpomenu-li co chvíli"
  },
  {
   "texto": "na svou ženu mladou."
  },
  {
   "texto": "A když kraj se zašeří,"
  },
  {
   "texto": "půjdu vesel domů,"
  },
  {
   "texto": "kde mě přijme k večeři"
  },
  {
   "texto": "a s hubičkou k tomu."
  },
  {
   "texto": "Budem v polích, ve dvoře"
  },
  {
   "texto": "spolu práci shánět,"
  },
  {
   "texto": "úsporu si k úspoře"
  },
  {
   "texto": "do truhlice shránět,"
  },
  {
   "texto": "bude těšit za krátko"
  },
  {
   "texto": "stříbrným nás hlasem,"
  },
  {
   "texto": "koupíme si prasátko"
  },
  {
   "texto": "a snad kravku časem."
  },
  {
   "texto": "A bůh dá, že k posledu"
  },
  {
   "texto": "i svou vlastní střechu"
  },
  {
   "texto": "pořídit si dovedu,"
  },
  {
   "texto": "třeba z došků, mechu,"
  },
  {
   "texto": "usedneme pod jabloň"
  },
  {
   "texto": "ve svém vlastním sádku -"
  },
  {
   "texto": "Vesele dál, koso, zvoň,"
  },
  {
   "texto": "a klaď k řádce řádku!"
  },
  {
   "texto": "Starší muž"
  },
  {
   "texto": "Lopotila se mnou žena"
  },
  {
   "texto": "od úsvitu do noci,"
  },
  {
   "texto": "pak i synek mladou rukou,"
  },
  {
   "texto": "dcera byla k pomoci,"
  },
  {
   "texto": "scházely se, trocha k troše,"
  },
  {
   "texto": "trpce naspořené groše,"
  },
  {
   "texto": "každý z nich byl skropen potem"
  },
  {
   "texto": "z vrásek čela našeho - -"
  },
  {
   "texto": "Vzpomenu-li, takhle kosou"
  },
  {
   "texto": "vztekle máchnout do všeho!"
  },
  {
   "texto": "Pojednou sem zpráva letí,"
  },
  {
   "texto": "jaký v městě shon a hluk:"
  },
  {
   "texto": "zpronevěra - hýřili tam"
  },
  {
   "texto": "z mozolů sta chudých ruk!"
  },
  {
   "texto": "Rázem bylo po všem veta,"
  },
  {
   "texto": "zač jsme soužili se leta,"
  },
  {
   "texto": "nechť si potom kočár vezl"
  },
  {
   "texto": "k soudu toho, onoho - -"
  },
  {
   "texto": "Věru kosou, jenom kosou,"
  },
  {
   "texto": "takhle kosou do toho!"
  },
  {
   "texto": "Žena ulehla z té rány -"
  },
  {
   "texto": "dosud chodí jako duch."
  },
  {
   "texto": "Drahé léky - práce málo -"
  },
  {
   "texto": "u žida mi roste dluh."
  },
  {
   "texto": "Zmizel ženich naší Bětky,"
  },
  {
   "texto": "lačný jen té peněz špetky,"
  },
  {
   "texto": "ona teď jak stín se plouží,"
  },
  {
   "texto": "stále pláče pro něho - -"
  },
  {
   "texto": "Jářku, kosou, jenom kosou,"
  },
  {
   "texto": "takhle kosou do všeho!"
  },
  {
   "texto": "A teď pomocník mi ještě,"
  },
  {
   "texto": "Józa můj, na vojnu vzat,"
  },
  {
   "texto": "když mi rozkvet’ v plné síle,"
  },
  {
   "texto": "do práce jak lítý kat."
  },
  {
   "texto": "Nyní steskem hlavu věsí"
  },
  {
   "texto": "a snad chřadne v dálce kdesi,"
  },
  {
   "texto": "nebo zvětřilce mi vrátí"
  },
  {
   "texto": "místo synka hodného -"
  },
  {
   "texto": "Inu, kosou, jenom kosou,"
  },
  {
   "texto": "takhle kosou do všeho!"
  },
  {
   "texto": "Šimon"
  },
  {
   "texto": "Jeden pluhem brázdy ryl,"
  },
  {
   "texto": "potem svým je smáčel,"
  },
  {
   "texto": "druhý pilně zrní sil,"
  },
  {
   "texto": "třetí pole zvláčel,"
  },
  {
   "texto": "a když vzejde klasů houšť"
  },
  {
   "texto": "na bohaté líše,"
  },
  {
   "texto": "ten, kdo prstem nehnul tam,"
  },
  {
   "texto": "obchází jí v pýše."
  },
  {
   "texto": "Vedrem s čela prýští pot,"
  },
  {
   "texto": "umdlévají páže,"
  },
  {
   "texto": "hejno lidí o překot"
  },
  {
   "texto": "kosí, hrabe, váže,"
  },
  {
   "texto": "jenom jeden ve stínu"
  },
  {
   "texto": "hoví sobě tady,"
  },
  {
   "texto": "hledě vesel, jak mu tam"
  },
  {
   "texto": "rostou snopů řady."
  },
  {
   "texto": "Mlatci tepou o závod,"
  },
  {
   "texto": "až je ruka brní,"
  },
  {
   "texto": "a s čel jejich horký pot"
  },
  {
   "texto": "skrápá v jasné zrní,"
  },
  {
   "texto": "v sýpce pak jich dílo pán"
  },
  {
   "texto": "zkumným zrakem cení,"
  },
  {
   "texto": "rád, že pšenky hromadu"
  },
  {
   "texto": "v kupu zlata změní."
  },
  {
   "texto": "A když mouku vyrobí"
  },
  {
   "texto": "práce mlánské chasy,"
  },
  {
   "texto": "nejbělejší ozdobí"
  },
  {
   "texto": "dortem panské kvasy,"
  },
  {
   "texto": "z nejhoršího pak chleba kus"
  },
  {
   "texto": "stačí na den celý"
  },
  {
   "texto": "těm, co v potu orali,"
  },
  {
   "texto": "sili, žali, mleli."
  },
  {
   "texto": "Mladík"
  },
  {
   "texto": "S hráběmi a srpem"
  },
  {
   "texto": "děvčátka už jdou"
  },
  {
   "texto": "ve vysokém žitě"
  },
  {
   "texto": "bílou pěšinou,"
  },
  {
   "texto": "a já sebe sám"
  },
  {
   "texto": "častokrát se ptám,"
  },
  {
   "texto": "proč z nich vidím ustavičně"
  },
  {
   "texto": "jen tu jedinou."
  },
  {
   "texto": "Rozkývá-li stébla"
  },
  {
   "texto": "vánku tichý šust,"
  },
  {
   "texto": "myslím na krok lehký,"
  },
  {
   "texto": "svižný její vzrůst,"
  },
  {
   "texto": "akdyž v osení"
  },
  {
   "texto": "mák se rumění,"
  },
  {
   "texto": "vidím její zapýření,"
  },
  {
   "texto": "úsměv milých úst."
  },
  {
   "texto": "Z chrpy, která kmitne"
  },
  {
   "texto": "podmou ocelí,"
  },
  {
   "texto": "svitne modrých očí"
  },
  {
   "texto": "pohled veselý"
  },
  {
   "texto": "a hned celá zem"
  },
  {
   "texto": "rozkvete mi v něm,"
  },
  {
   "texto": "jak bych kráčel nejkrásnější"
  },
  {
   "texto": "jarní nedělí."
  },
  {
   "texto": "Zmizelami v žitě"
  },
  {
   "texto": "za vysoký klas,"
  },
  {
   "texto": "nad ním třepetá se"
  },
  {
   "texto": "jenom světlý vlas,"
  },
  {
   "texto": "koso, v hon se dej,"
  },
  {
   "texto": "cestu prosekej,"
  },
  {
   "texto": "ať ji spatřím s hlavy k patě"
  },
  {
   "texto": "celou krásnou zas!"
  },
  {
   "texto": "Mladý manžel"
  },
  {
   "texto": "Odveď jsem si od oltáře"
  },
  {
   "texto": "ženušku jak růže květ,"
  },
  {
   "texto": "jeden zpěv a jedna záře"
  },
  {
   "texto": "byl mi tehdáž celý svět."
  },
  {
   "texto": "Řek jsem: Tvé ručky bílé"
  },
  {
   "texto": "neosmáhnou v hrubém díle,"
  },
  {
   "texto": "nechť sama ztvrdne prací"
  },
  {
   "texto": "moje dlaň jak oblázek,"
  },
  {
   "texto": "bych tě mohl doma chovat"
  },
  {
   "texto": "jako drahý obrázek."
  },
  {
   "texto": "Tu se odkuds vrátil z dálky,"
  },
  {
   "texto": "hráč a hýřil, mladý pán,"
  },
  {
   "texto": "ze zahálky do zahálky,"
  },
  {
   "texto": "našperkován, ulízán."
  },
  {
   "texto": "A když prvně jsem ho zočil,"
  },
  {
   "texto": "kterak okem lačným točil"
  },
  {
   "texto": "po zástupu ženské chasy,"
  },
  {
   "texto": "zlá mě jala předtucha -"
  },
  {
   "texto": "Radost prchla od té chvíle,"
  },
  {
   "texto": "černý pták mi used’ v týle,"
  },
  {
   "texto": "věčně skuhrá do ucha."
  },
  {
   "texto": "Divný úsměv, šepot lidí"
  },
  {
   "texto": "dobré věci nevěstí,"
  },
  {
   "texto": "lecos vlastní zrak můj vidí,"
  },
  {
   "texto": "z čeho tuším neštěstí."
  },
  {
   "texto": "Strach se druží k mojim pracím,"
  },
  {
   "texto": "zamračen se v jizbu vracím,"
  },
  {
   "texto": "odkud všechny chvíle zlaté"
  },
  {
   "texto": "vichrem zlým jsou rozváty -"
  },
  {
   "texto": "Žena přísahá sic, pláče,"
  },
  {
   "texto": "ale mně dál v ucho kráče"
  },
  {
   "texto": "temný havran proklatý."
  },
  {
   "texto": "Co můj život? Z jitra k šeru"
  },
  {
   "texto": "v zimní mráz i letní žár"
  },
  {
   "texto": "za tuhou se prací beru"
  },
  {
   "texto": "pro kus chleba, šatu cár."
  },
  {
   "texto": "Jenom jedna hvězda světlá"
  },
  {
   "texto": "na mém tmavém nebi zkvetla,"
  },
  {
   "texto": "jedna v poušti růže krásná"
  },
  {
   "texto": "za můj trud a horký pot:"
  },
  {
   "texto": "chtěl jsem jen, by láska ženy"
  },
  {
   "texto": "blažila mě bez promeny,"
  },
  {
   "texto": "ta mi dražší nad život."
  },
  {
   "texto": "Zatím co zde s kosou pílí"
  },
  {
   "texto": "do umdlení moje pěst,"
  },
  {
   "texto": "hejsek líný, rozmařilý,"
  },
  {
   "texto": "snad tam spřádá svůdnou lest,"
  },
  {
   "texto": "aby hříčkou beze studu"
  },
  {
   "texto": "mohl ukrátit si nudu - -"
  },
  {
   "texto": "Ne! - Již pouhým pomyšlením"
  },
  {
   "texto": "pěsť mi svírá lítý hněv,"
  },
  {
   "texto": "všechna se mi k čelu valí,"
  },
  {
   "texto": "rudou mlhou oči kalí"
  },
  {
   "texto": "vztekem rozpěněná krev."
  },
  {
   "texto": "Ještě chvilkou mračno mizí,"
  },
  {
   "texto": "červa v duši přemáhám,"
  },
  {
   "texto": "mimo pouštím šepty cizí,"
  },
  {
   "texto": "věřím ženy přísahám."
  },
  {
   "texto": "Jestli však mé oči jednou"
  },
  {
   "texto": "v lotřích drápech poklad shlednou,"
  },
  {
   "texto": "který jediný mne těšil"
  },
  {
   "texto": "pod tou boží oblohou:"
  },
  {
   "texto": "kosa má se strašně mihne,"
  },
  {
   "texto": "nechť ať potom skáza stihne"
  },
  {
   "texto": "i mou hlavu nebohou!"
  },
  {
   "texto": "Jiskra"
  },
  {
   "texto": "Raděj než kosit"
  },
  {
   "texto": "v úpalu lán"
  },
  {
   "texto": "pod lipou v chládku"
  },
  {
   "texto": "zvedal bych žbán,"
  },
  {
   "texto": "zvonil tam skleničkou,"
  },
  {
   "texto": "šenkýřku mladičkou"
  },
  {
   "texto": "volal jak pán. - -"
  },
  {
   "texto": "Přeškoda jen,"
  },
  {
   "texto": "že je to sen,"
  },
  {
   "texto": "lípa i sklenička,"
  },
  {
   "texto": "hezounká vdovička,"
  },
  {
   "texto": "pivečko křen"
  },
  {
   "texto": "našinci nekvetou ve všední den."
  },
  {
   "texto": "Našinci teprv"
  },
  {
   "texto": "před nedělí"
  },
  {
   "texto": "může se zdáti"
  },
  {
   "texto": "o veselí,"
  },
  {
   "texto": "zbude-li v sobotu"
  },
  {
   "texto": "na trochu výskotu"
  },
  {
   "texto": "do pondělí. -"
  },
  {
   "texto": "Panská jen lest"
  },
  {
   "texto": "kalendář jest,"
  },
  {
   "texto": "týden teď v oplátku"
  },
  {
   "texto": "v jinakém pořádku"
  },
  {
   "texto": "měl by se vést:"
  },
  {
   "texto": "všední den jediný, neděl mít šest."
  },
  {
   "texto": "V ledačem chtěl bych"
  },
  {
   "texto": "zavésti řád"
  },
  {
   "texto": "na chvilku aspoň"
  },
  {
   "texto": "jinačí řád,"
  },
  {
   "texto": "jednou též po práci"
  },
  {
   "texto": "našinci v paláci"
  },
  {
   "texto": "bažantů přát,"
  },
  {
   "texto": "panský pak host"
  },
  {
   "texto": "chleb měj - a dost!"
  },
  {
   "texto": "Vodou jej zavlažuj,"
  },
  {
   "texto": "a k tomu rozvažuj:"
  },
  {
   "texto": "Střídmost je cnost,"
  },
  {
   "texto": "nejlepší s málem je spokojenost."
  },
  {
   "texto": "Ale co platno"
  },
  {
   "texto": "přát si a chtět,"
  },
  {
   "texto": "po staru dále,"
  },
  {
   "texto": "točí se svět,"
  },
  {
   "texto": "nejraděj’ chuďasu"
  },
  {
   "texto": "uchystá ke kvasu"
  },
  {
   "texto": "s pelyňkem jed. -"
  },
  {
   "texto": "Mně však je hej,"
  },
  {
   "texto": "děj se co děj,"
  },
  {
   "texto": "chvíli tu zůstanu,"
  },
  {
   "texto": "čapku pak na stranu,"
  },
  {
   "texto": "zavolám: Ej,"
  },
  {
   "texto": "vesničko, krajino dobře se měj!"
  },
  {
   "texto": "S loučením nemám"
  },
  {
   "texto": "veliký žel,"
  },
  {
   "texto": "pěkně jít krajem"
