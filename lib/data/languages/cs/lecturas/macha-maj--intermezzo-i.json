 "modo": "texto",
 "parrafos": [
  {
   "texto": "Půlnoc\n(krajina)"
  },
  {
   "texto": "V rozlehlých rovinách spí bledé lůny svit,"
  },
  {
   "texto": "kolem hor temno je, v jezeru hvězdný kmit,"
  },
  {
   "texto": "nad jezerem pahorek stojí."
  },
  {
   "texto": "Na něm se sloup, s tím kolo zdvíhá,"
  },
  {
   "texto": "nad tím se bílá lebka míhá,"
  },
  {
   "texto": "kol kola duchů dav se rojí;"
  },
  {
   "texto": "hrůzných to postav sbor se stíhá."
  },
  {
   "texto": "Sbor duchů"
  },
  {
   "texto": "„V půlnočních ticho je dobách;"
  },
  {
   "texto": "světýlka bloudí po hrobách,"
  },
  {
   "texto": "a jejich modrá mrtvá zář"
  },
  {
   "texto": "svítí v dnes pohřbeného tvář,"
  },
  {
   "texto": "jenž na stráži — co druzí spí —"
  },
  {
   "texto": "o vlastní křížek opřený"
  },
  {
   "texto": "poslední z pohřbených zde dlí."
  },
  {
   "texto": "V zenitu stojí šedý mrak"
  },
  {
   "texto": "a na něm měsíc složený"
  },
  {
   "texto": "v ztrhaný mrtvý strážce zrak,"
  },
  {
   "texto": "i v pootevřené huby"
  },
  {
   "texto": "přeskřípené svítí zuby.“"
  },
  {
   "texto": "Jeden hlas"
  },
  {
   "texto": "„Teď pravý čas! — připravte stán —"
  },
  {
   "texto": "neb zítra strašný lesů pán"
  },
  {
   "texto": "mezi nás bude uveden.“"
  },
  {
   "texto": "Sbor duchů\n(sundávaje lebku)"
  },
  {
   "texto": "„Z mrtvého kraje vystup ven,"
  },
  {
   "texto": "nabudiž život — přijmi hlas,"
  },
  {
   "texto": "buď mezi námi — vítej nám."
  },
  {
   "texto": "Dlouho jsi tady bydlil sám,"
  },
  {
   "texto": "jiný tvé místo zajme zas.“"
  },
  {
   "texto": "Lebka\n(mezi nimi kolem se točíc)"
  },
  {
   "texto": "„Jaké to oudů toužení,"
  },
  {
   "texto": "chtí opět býti jedno jen."
  },
  {
   "texto": "Jaké to strašné hemžení,"
  },
  {
   "texto": "můj nový sen. — Můj nový sen! —“"
  },
  {
   "texto": "Jeden hlas"
  },
  {
   "texto": "„Připraven jestiť jeho stán."
  },
  {
   "texto": "Až zítra půlnoc nastane,"
  },
  {
   "texto": "vichr nás opět přivane."
  },
  {
   "texto": "Pak mu buď slavný pohřeb dán.“"
  },
  {
   "texto": "Sbor duchů"
  },
  {
   "texto": "„Připraven jestiť jeho stán."
  },
  {
   "texto": "Až zítra půlnoc nastane,"
  },
  {
   "texto": "vichr nás opět přivane."
  },
  {
   "texto": "Pak mu buď slavný pohřeb dán.“"
  },
  {
   "texto": "Jeden hlas"
  },
  {
   "texto": "„Rozlehlým polem leť můj hlas;"
  },
  {
   "texto": "pohřeb v půlnoční bude čas!"
  },
  {
   "texto": "Co k pohřbu dá, každý mi zjev!“"
  },
  {
   "texto": "Čekan s kolem"
  },
  {
   "texto": "„Mrtvému rakví budu já.“"
  },
  {
   "texto": "Žáby z bažiny"
  },
  {
   "texto": "„My odbudem pohřební zpěv.“"
  },
  {
   "texto": "Vichr po jezeru"
  },
  {
   "texto": "„Pohřební hudbu vichr má.“"
  },
  {
   "texto": "Měsíc v zenitu"
  },
  {
   "texto": "„Já bílý příkrov tomu dám.“"
  },
  {
   "texto": "Mlha po horách"
  },
  {
   "texto": "„Já truchloroušky obstarám.“"
  },
  {
   "texto": "Noc"
  },
  {
   "texto": "„Já černá roucha doručím.“"
  },
  {
   "texto": "Hory v kolo krajiny"
  },
  {
   "texto": "„Roucha i roušky dejte nám.“"
  },
  {
   "texto": "Padající rosa"
  },
  {
   "texto": "„A já vám slzy zapůjčím.“"
  },
  {
   "texto": "Suchopar"
  },
  {
   "texto": "„Pak já rozduji vonný dým.“"
  },
  {
   "texto": "Zapadající mračno"
  },
  {
   "texto": "„Já rakev deštěm pokropím.“"
  },
  {
   "texto": "Padající květ"
  },
  {
   "texto": "„Já k tomu věnce uviji.“"
  },
  {
   "texto": "Lehké větry"
  },
  {
   "texto": "„My na rakev je donesem.“"
  },
  {
   "texto": "Svatojánské mušky"
  },
  {
   "texto": "„My drobné svíce ponesem.“"
  },
  {
   "texto": "Bouře z hluboka"
  },
  {
   "texto": "„Já zvonů dutý vzbudím hlas.“"
  },
  {
   "texto": "Krtek pod zemí"
  },
  {
   "texto": "„Já zatím hrob mu vyryji.“"
  },
  {
   "texto": "Čas"
  },
  {
   "texto": "„Náhrobkem já ho přikryji.“"
  },
  {
   "texto": "Přes měsíc letící hejno nočního ptactva"
  },
  {
   "texto": "„My na pohřební přijdem kvas.“"
  },
  {
   "texto": "Jeden hlas"
  },
  {
   "texto": "„Slavný mu pohřeb připraven."
  },
  {
   "texto": "Ubledlý měsíc umírá,"
  },
  {
   "texto": "Jitřena brány otvírá,"
  },
  {
   "texto": "již je den, již je den!“"
  },
  {
   "texto": "Sbor duchů"
  },
  {
   "texto": "„Již je den, již je den!“"
  },
  {
   "texto": "(zmizí)"
  }
 ]
}