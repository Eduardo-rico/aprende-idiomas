 "parrafos": [
  {
   "texto": "Přilítlo jaro z daleka"
  },
  {
   "texto": "Přilítlo jaro z daleka,"
  },
  {
   "texto": "a všude plno touhy,"
  },
  {
   "texto": "vše tlačilo se k slunci ven,"
  },
  {
   "texto": "že snilo sen tak dlouhý."
  },
  {
   "texto": "Vylítly z hnízda pěnkavy"
  },
  {
   "texto": "a drobné děti z chýše,"
  },
  {
   "texto": "a pestré kvítí na lukách"
  },
  {
   "texto": "přesladkou vůni dýše."
  },
  {
   "texto": "Z větví se lístek tlačí ven"
  },
  {
   "texto": "a ptáčkům z hrdla hlásky,"
  },
  {
   "texto": "a v ňadrech v srdci mlaďounkém —"
  },
  {
   "texto": "tam klíčí poupě lásky."
  },
  {
   "texto": "Já jsem ten rytíř z pohádky,"
  },
  {
   "texto": "jenž hrdě vyjel do světa,"
  },
  {
   "texto": "abych tu pannu uviděl,"
  },
  {
   "texto": "jež jako růže vykvétá."
  },
  {
   "texto": "O ní šla věsť: kdo spatří ji —"
  },
  {
   "texto": "ten s kletbou prý to odnese,"
  },
  {
   "texto": "budže se v kámen promění,"
  },
  {
   "texto": "budže mu srdce vyrve se."
  },
  {
   "texto": "I myslil jsem si u sebe:"
  },
  {
   "texto": "Snad přec je někdo vyjmutý!"
  },
  {
   "texto": "A vyjel jsem, a za ten hřích"
  },
  {
   "texto": "teď — v zpěváka jsem zakletý!"
  },
  {
   "texto": "Umlklo stromů šumění,"
  },
  {
   "texto": "a lístek sotva dýše,"
  },
  {
   "texto": "a ptáček dřímá krásný sen"
  },
  {
   "texto": "tak tichounce, tak tiše."
  },
  {
   "texto": "Na nebi vzešlo mnoho hvězd,"
  },
  {
   "texto": "a kolem je tak volno,"
  },
  {
   "texto": "jenom v těch ňadrech teskno tak"
  },
  {
   "texto": "a u srdce tak bolno."
  },
  {
   "texto": "Ve kvítku pěkný kalíšek"
  },
  {
   "texto": "se bílá rosa skládá —"
  },
  {
   "texto": "můj Bože, a ta rosa též"
  },
  {
   "texto": "se v moje oči vkrádá."
  },
  {
   "texto": "Vše na světě teď usnulo,"
  },
  {
   "texto": "až na to srdce v těle."
  },
  {
   "texto": "Bůh sám ví, že to srdce jen"
  },
  {
   "texto": "si nikdy neustele."
  },
  {
   "texto": "V tom božím světě zmlklo vše,"
  },
  {
   "texto": "až na zvuk srdce hravý."
  },
  {
   "texto": "Bůh sám ví, že to srdce jen"
  },
  {
   "texto": "se nikdy neunaví."
  },
  {
   "texto": "Myšlenku spánek přemáhá,"
  },
  {
   "texto": "noc se dnem se v bdění střídá —"
  },
  {
   "texto": "jen srdce v prsou stále bdí"
  },
  {
   "texto": "a tam si lásku hlídá."
  },
  {
   "texto": "Na nebi na sta hvězdiček,"
  },
  {
   "texto": "měsíc se s nimi bratří,"
  },
  {
   "texto": "a s nebe Pánbůh s anděly"
  },
  {
   "texto": "sem na svět dolů patří."
  },
  {
   "texto": "A s nebe anděl sstupuje,"
  },
  {
   "texto": "na tváři ani vráska,"
  },
  {
   "texto": "a krásný jako jarní dech —"
  },
  {
   "texto": "ten anděl, to je láska."
  },
  {
   "texto": "Ten kamkoliv se přiblíží,"
  },
  {
   "texto": "vše trne sladkou mukou,"
  },
  {
   "texto": "a slavíci a hrdličky —"
  },
  {
   "texto": "ty pěkné písně tlukou."
  },
  {
   "texto": "A koho křídlem dotkne se,"
  },
  {
   "texto": "ten celičký se změní"
  },
  {
   "texto": "a v srdci něco pocítí,"
  },
  {
   "texto": "co není k vyslovení."
  }
 ]
}