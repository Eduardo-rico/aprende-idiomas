 "modo": "texto",
 "parrafos": [
  {
   "texto": "45"
  },
  {
   "texto": "Nad blázincem věž se štíhlá vzpíná,"
  },
  {
   "texto": "jako pomoc z nebes dálných vzývá,"
  },
  {
   "texto": "či jak nade rovem zpustlým leckdy"
  },
  {
   "texto": "matkobijce ruka vyschlá čnívá."
  },
  {
   "texto": "Což ti zaživa zde pohrobení,"
  },
  {
   "texto": "což jsou matkobijci mezi nimi? -"
  },
  {
   "texto": "Ovšem! - Chtěli nad věhlasnou matku,"
  },
  {
   "texto": "nad přírodu býti moudřejšími."
  },
  {
   "texto": "Z Kateřinek dlouhý tah se,"
  },
  {
   "texto": "černý tah se vleče -"
  },
  {
   "texto": "co se vleče,"
  },
  {
   "texto": "neuteče."
  },
  {
   "texto": "Přece blázni jsou též moudří,"
  },
  {
   "texto": "moudrého cos mají,"
  },
  {
   "texto": "moudrého co mají? -"
  },
  {
   "texto": "Umírají."
  },
  {
   "texto": "V vlasti jsem, a přece divná tužba"
  },
  {
   "texto": "svírá prsa těsným okovem,"
  },
  {
   "texto": "stoupám místa od dětinství milá,"
  },
  {
   "texto": "a přec nejsem zde víc domovem."
  },
  {
   "texto": "Cizé tváře, cizé chladné zvyky,"
  },
  {
   "texto": "cizé citům zvuky kolem znějí,"
  },
  {
   "texto": "že bych zaplakal si v domě vlastním"
  },
  {
   "texto": "píseň tužby - toužnou Odysseji."
  },
  {
   "texto": "Otce, matku, lásku oželíme,"
  },
  {
   "texto": "jsou-li pohrobeni zemí svatou,"
  },
  {
   "texto": "hůř však, dokud trapná nejistota"
  },
  {
   "texto": "budoucí nám hrozí teprv ztrátou."
  },
  {
   "texto": "U matčina lože s bratry stojím,"
  },
  {
   "texto": "chudák, dlouho nám již postonává,"
  },
  {
   "texto": "darmo tážem se, zdaž naděje nám,"
  },
  {
   "texto": "zdaž snad sirotkům nám dokonává."
  },
  {
   "texto": "U matčina lože doktor starý,"
  },
  {
   "texto": "neví nic a moudře hlavou kývá:"
  },
  {
   "texto": "„Neumře-li, buďte bez starostí,"
  },
  {
   "texto": "zůstane vám jistě dlouho živa.“"
  },
  {
   "texto": "Upřímně se, bratři, zpovídejme,"
  },
  {
   "texto": "upřímně si sdělme svoje hříchy,"
  },
  {
   "texto": "vyznejme, že co nám škodí, jesti -"
  },
  {
   "texto": "příliš dobrá vůle, málo pýchy."
  },
  {
   "texto": "Každý dál chce letět, nežli může,"
  },
  {
   "texto": "slabého být celku silná půle,"
  },
  {
   "texto": "a ten kámen, přes nějž klopýtáme, -"
  },
  {
   "texto": "málo pýchy, příliš dobrá vůle."
  },
  {
   "texto": "Vlastní ceny žádný dobře nezná,"
  },
  {
   "texto": "kde má mluvit, tam je mdlý a tichý,"
  },
  {
   "texto": "a kde mluví, tam mu zase vadí -"
  },
  {
   "texto": "příliš dobrá vůle, málo pýchy."
  },
  {
   "texto": "Milost! - Můž-li slavík jemný mnohým"
  },
  {
   "texto": "krásnějšího slova zapěti?"
  },
  {
   "texto": "Může-li však noční šedá sova"
  },
  {
   "texto": "hrůznějšího také úpěti? - -"
  },
  {
   "texto": "Strom bych žití svého v zemi vsadil,"
  },
  {
   "texto": "krví vřelou denně zalíval,"
  },
  {
   "texto": "tlukotem ho srdce okopával,"
  },
  {
   "texto": "aby s časem stejně prospíval."
  },
  {
   "texto": "A kdy prsou hrany vyzvánějí,"
  },
  {
   "texto": "že jsem smrt si pracně vydobyl,"
  },
  {
   "texto": "ze stromu bych zestárlého sobě"
  },
  {
   "texto": "motyku a prkna vyrobil."
  },
  {
   "texto": "Motykou a prkny připravil si"
  },
  {
   "texto": "jámu, lůžko, jež mne pohostí,"
  },
  {
   "texto": "ó kéž vichr jámu sám zaváje! -"
  },
  {
   "texto": "jiných žádných nechci milostí."
  },
  {
   "texto": "51"
  },
  {
   "texto": "Strom květ nese, dokud neuchřadne,"
  },
  {
   "texto": "lilje voní, dokud neuvadne,"
  },
  {
   "texto": "hvězda svítí, dokud nezapadne,"
  },
  {
   "texto": "sopka pálí, dokud nevychladne,"
  },
  {
   "texto": "sníh se bělí, než se v vodu shlukne, -"
  },
  {
   "texto": "pěvec zpívá, než mu slabá struna,"
  },
  {
   "texto": "nebo srdce v úzkých prsou pukne."
  },
  {
   "texto": "Blaha dáno, že až k přesycení,"
  },
  {
   "texto": "strastí dáno,že až k nesnesení,"
  },
  {
   "texto": "však to přejde, až se ve hrob svinu,"
  },
  {
   "texto": "vždyť si také jednou odpočinu."
  },
  {
   "texto": "Na rozcestí roste pěkné kvítí:"
  },
  {
   "texto": "„Že nemusí píseň věčně žíti.“"
  },
  {
   "texto": "Zhlížela se vrba u potoku,"
  },
  {
   "texto": "zkalilo se oko bystrých toků -"
  },
  {
   "texto": "nedbá o mne žádný, ba pražádný,"
  },
  {
   "texto": "nedbámť o žádného, v srdci chladný."
  },
  {
   "texto": "Vítám led, jenž kol hrudi se klade,"
  },
  {
   "texto": "vždyť i led má svoje něžné kvítí; -"
  },
  {
   "texto": "pěknýmť bodlák v růžovém i sadě, -"
  },
  {
   "texto": "proč by nemoh též své trní míti?"
  }
 ]
}