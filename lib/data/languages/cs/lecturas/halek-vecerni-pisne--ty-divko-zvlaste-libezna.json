 "parrafos": [
  {
   "texto": "Ty, dívko zvláště líbezná"
  },
  {
   "texto": "Ty, dívko zvláště líbezná,"
  },
  {
   "texto": "jíž v světě rovné není,"
  },
  {
   "texto": "mně v Tobě se zalíbilo"
  },
  {
   "texto": "a Tys mé potěšení."
  },
  {
   "texto": "Tys čistá, jak ta rosička,"
  },
  {
   "texto": "co ráno s nebe splývá,"
  },
  {
   "texto": "a jemná, jak ta hrdlička,"
  },
  {
   "texto": "když svoji píseň zpívá."
  },
  {
   "texto": "Tys pěkná jako lilium,"
  },
  {
   "texto": "jež vůní odívá se,"
  },
  {
   "texto": "a vznešenás jak dennice,"
  },
  {
   "texto": "když vchází — rozdnívá se."
  },
  {
   "texto": "Již stalo se. Má duše bez Tebe"
  },
  {
   "texto": "se necítí již celou víc;"
  },
  {
   "texto": "ba sebe myslit bez Tebe,"
  },
  {
   "texto": "by bylo — nebýt živu víc."
  },
  {
   "texto": "S mou duší již jsi setkaná."
  },
  {
   "texto": "Tys chloubou její, radostí —"
  },
  {
   "texto": "Tys chloubou mou, mou útěchou,"
  },
  {
   "texto": "mou rozkoší — mou žalostí."
  },
  {
   "texto": "Z mých pustých snů mi nebe tkáš,"
  },
  {
   "texto": "jak nevěsta svatební šat;"
  },
  {
   "texto": "Ty ve mně bdíš, Ty ve mně sníš,"
  },
  {
   "texto": "co já, co Ty — již nelze rozeznat."
  },
  {
   "texto": "Co osud můj — mne lhostejno."
  },
  {
   "texto": "Vímť, čí jej ruka upřádá."
  },
  {
   "texto": "Z Tvé ruky — byť i zkázu vzít —"
  },
  {
   "texto": "i v tom se nebe zakládá."
  },
  {
   "texto": "Když tak se na Tě dívám —"
  },
  {
   "texto": "Tys holubička krotká,"
  },
  {
   "texto": "ta jemná, hravá, líbezná,"
  },
  {
   "texto": "když s holoubkem se potká."
  },
  {
   "texto": "Mně nelze dost nahledět"
  },
  {
   "texto": "na to Tvé krásné oko —"
  },
  {
   "texto": "to modrojasné brány jsou"
  },
  {
   "texto": "do ňader přehluboko."
  },
  {
   "texto": "Mně nelze dost se nahledět"
  },
  {
   "texto": "na tu Tvou tvář tak jemnou —"
  },
  {
   "texto": "z ní celá duše bez klamu"
  },
  {
   "texto": "i srdce mluví se mnou."
  },
  {
   "texto": "A když se na Tě díváme,"
  },
  {
   "texto": "ó sladká s nebe manno"
  },
  {
   "texto": "zdaž to ta ústa nejsou též,"
  },
  {
   "texto": "která mi řekla: Ano!"
  },
  {
   "texto": "Tvé oko krásné jezero,"
  },
  {
   "texto": "jež v šeru tam se houpá;"
  },
  {
   "texto": "v něm nočních světel milá zář"
  },
  {
   "texto": "s modrým se nebem koupá."
  },
  {
   "texto": "A čistá jako křišťál je,"
  },
  {
   "texto": "v něm vidět je až na dno —"
  },
  {
   "texto": "leč hlouběj kdo v ně nahlédne,"
  },
  {
   "texto": "ten utone v něm snadno."
  }
 ]
}