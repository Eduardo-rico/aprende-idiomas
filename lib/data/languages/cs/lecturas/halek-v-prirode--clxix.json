 "modo": "texto",
 "parrafos": [
  {
   "texto": "CLXIX."
  },
  {
   "texto": "Žeť ztráta drobných radovánek"
  },
  {
   "texto": "tak velkou klá mne žalostí!"
  },
  {
   "texto": "Vždyť ztratím jednou mnohem více,"
  },
  {
   "texto": "až hrob mne zcela uhostí."
  },
  {
   "texto": "Tam nikdo nebude se ptáti,"
  },
  {
   "texto": "co zde jsem ještě neztratil,"
  },
  {
   "texto": "tam jenom zamknou mi dvě víčka —"
  },
  {
   "texto": "a celý svět jsem utratil."
  },
  {
   "texto": "A budu bez přítele, dívky,"
  },
  {
   "texto": "bez lásky — a to horší jest,"
  },
  {
   "texto": "že ze všeho, co dáti musím,"
  },
  {
   "texto": "mně nezbude ni na bolest."
  },
  {
   "texto": "Ni na naděj, ni na myšlenku,"
  },
  {
   "texto": "ni na zvuk, na vzdech jediný —"
  },
  {
   "texto": "ó, jaký pak to budu obr,"
  },
  {
   "texto": "a jaký teď jsem dětinný!"
  },
  {
   "texto": "Zpíval tesař a bral míru"
  },
  {
   "texto": "z pokácených v prkna dřev:"
  },
  {
   "texto": "„Vezmu já vás na kolébku,"
  },
  {
   "texto": "vezmu hned i na rakev.“"
  },
  {
   "texto": "Jak to zpíváš, muži dobrý,"
  },
  {
   "texto": "což to obé v jednom jest?"
  },
  {
   "texto": "Naměřímť já mezi nimi"
  },
  {
   "texto": "celý život, na mou čest!"
  },
  {
   "texto": "A on zas: „Netešte rakev"
  },
  {
   "texto": "u kolébky dítěte;"
  },
  {
   "texto": "odneste ji na kraj světa,"
  },
  {
   "texto": "jenom k nám zas přijděte.“"
  },
  {
   "texto": "Co jsem slyšel dobrých písní,"
  },
  {
   "texto": "ta mně nejvíc v duši tkví,"
  },
  {
   "texto": "dle níž zpěvák žil i umřel —"
  },
  {
   "texto": "tam, hle, jdou mu za rakví."
  },
  {
   "texto": "Na pozdním poli, po strništi,"
  },
  {
   "texto": "jdu s puškou, hotov na ránu,"
  },
  {
   "texto": "a přede mnou, jak na bojišti,"
  },
  {
   "texto": "v prch lítá národ skřivanů."
  },
  {
   "texto": "Již lítnou bez zpěvu a hlasu,"
  },
  {
   "texto": "nic pro radost, nic pro žaly —"
  },
  {
   "texto": "tak vám vše do posledních klasů"
  },
  {
   "texto": "až na to srdce požali!"
  },
  {
   "texto": "A lítnou přede mnou jak v bázni,"
  },
  {
   "texto": "že smrt k nim ze mne doletí —"
  },
  {
   "texto": "ach, těchto strachů buďte prázdni,"
  },
  {
   "texto": "vysloužilí vy poeti."
  },
  {
   "texto": "Za vámi já poslati ránu?"
  },
  {
   "texto": "Radš ruku sežhu v plameni:"
  },
  {
   "texto": "kdy čas odzvání pěvci hranu,"
  },
  {
   "texto": "všakť luza najde kamení."
  },
  {
   "texto": "Uzrá-li v skutek naše víra"
  },
  {
   "texto": "po věstích duchů tušení —"
  },
  {
   "texto": "ty blahý pěvče, jehož lyra"
  },
  {
   "texto": "se nad tím v píseň rozvlní!"
  },
  {
   "texto": "Až v kráse vstanou málo známé"
  },
  {
   "texto": "ty věty srdcí líbezných,"
  },
  {
   "texto": "a zač my ještě umíráme,"
  },
  {
   "texto": "až v tónech zahrá vítězných —"
  },
  {
   "texto": "Až bez pouta a bez tajemství"
  },
  {
   "texto": "myšlenka říš svou obletí,"
  },
  {
   "texto": "a příroda a člověčenství"
  },
  {
   "texto": "se pojmou v svatém objetí —"
  },
  {
   "texto": "Ty blahá písni, které přáno"
  },
  {
   "texto": "pak v skřivaní se pnouti let:"
  },
  {
   "texto": "ach, býti pěvcem v také ráno,"
  },
  {
   "texto": "a potom zhasnout třeba hned!"
  }
 ]
}