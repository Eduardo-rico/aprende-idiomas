 "parrafos": [
  {
   "texto": "Starý kozák"
  },
  {
   "texto": "V hospodě ruchu a puchu,"
  },
  {
   "texto": "tam housle, klarinet, bas,"
  },
  {
   "texto": "pošinul čepici k uchu —"
  },
  {
   "texto": "„Stůjte, ať do toho ďas!“"
  },
  {
   "texto": "Zakroutil našedlé kníry"
  },
  {
   "texto": "a rukou podepřel bok:"
  },
  {
   "texto": "„Kozák jsem ze staré míry,"
  },
  {
   "texto": "já vím, co do kulí krok.“"
  },
  {
   "texto": "„Ale mně s takovou směle,"
  },
  {
   "texto": "mne českým poplivnout psem:"
  },
  {
   "texto": "jedna, dvě — a má ji v těle,"
  },
  {
   "texto": "pak ať mne ubije v zem!"
  },
  {
   "texto": "Koukáte, kuřata měkká,"
  },
  {
   "texto": "to každý jak sysel je tich,"
  },
  {
   "texto": "pošeptmo kleje a heká"
  },
  {
   "texto": "a nahlas polyká smích!"
  },
  {
   "texto": "Koukáte, výkvěte mladý —"
  },
  {
   "texto": "mít k tanci ohnivý kvap,"
  },
  {
   "texto": "pro holky hlazené brady,"
  },
  {
   "texto": "fi! a krev ze srdce bab."
  },
  {
   "texto": "Neznat, co muži je svato,"
  },
  {
   "texto": "co krásné, veliké dost,"
  },
  {
   "texto": "však na všem trpěti bláto,"
  },
  {
   "texto": "a mít je za pravý skvost —"
  },
  {
   "texto": "Fintit se, čechrat si vlasy,"
  },
  {
   "texto": "být klepnám hledaný rek,"
  },
  {
   "texto": "hejřiti pitky a kvasy,"
  },
  {
   "texto": "tvář mít jen na políček —"
  },
  {
   "texto": "Na velkost zvedati tretku,"
  },
  {
   "texto": "mít v hádku bojovný sluch,"
  },
  {
   "texto": "odvahy však ani špetku,"
  },
  {
   "texto": "a zvát to mladistvý ruch —"
  },
  {
   "texto": "Koukáte na tu krev línou,"
  },
  {
   "texto": "jak sešlá v mém zrcadle jest —"
  },
  {
   "texto": "při sám —, tvář nemáte jinou,"
  },
  {
   "texto": "dosud v ní nevidím čest!“"
  },
  {
   "texto": "Stanula mládež dnes v kole,"
  },
  {
   "texto": "jak v kámen utuhla, v led —"
  },
  {
   "texto": "vytáh’ dnes kozáček v pole"
  },
  {
   "texto": "a jest jak bez krve bled."
  },
  {
   "texto": "V hospodě ruchu a puchu,"
  },
  {
   "texto": "tam housle, klarinet, bas,"
  },
  {
   "texto": "pošinul čepici k uchu —"
  },
  {
   "texto": "„Hrajte, ať do toho ďas!“"
  },
  {
   "texto": "Kravičku vedou ze chléva,"
  },
  {
   "texto": "dvůr plný, sotva že stačí,"
  },
  {
   "texto": "na prahu vdova omdlévá"
  },
  {
   "texto": "a škytá v oněmlém pláči."
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Pět zlatých poprvé, kdo dá víc?“"
  },
  {
   "texto": "Na prahu zalká žaloba:"
  },
  {
   "texto": "„Mé děti, robátka milá,"
  },
  {
   "texto": "života naše zásoba,"
  },
  {
   "texto": "váš chléb a jediná síla!“ —"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Pět zlatých podruhé, kdo dá víc?“"
  },
  {
   "texto": "„Otce smrt náhlá zlomila,"
  },
  {
   "texto": "pět dítek při holé dlani,"
  },
  {
   "texto": "a já se v práci schromila,"
  },
  {
   "texto": "kde vzít a doplatit k dani?“ —"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Šest zlatých poprvé, kdo dá víc!“"
  },
  {
   "texto": "„Z telátka jsem ji chovala;"
  },
  {
   "texto": "když jsme ji na pastvu vedli,"
  },
  {
   "texto": "každou jsem krůpěj žehnala,"
  },
  {
   "texto": "vždyť z mléka děti mé jedly!“"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Šest zlatých poprvé, kdo dá víc?“"
  },
  {
   "texto": "„Každou jsem zvedla travičku,"
  },
  {
   "texto": "jíž mléko sladne a tuční,"
  },
  {
   "texto": "děti si sedly k ohníčku"
  },
  {
   "texto": "a byly na pastvě učni.“ —"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Šest zlatých podruhé, kdo dá víc?“"
  },
  {
   "texto": "„O hladu a přec bezpeční!"
  },
  {
   "texto": "Groš za sýr ukápne v schránku —"
  },
  {
   "texto": "byly to hody sváteční,"
  },
  {
   "texto": "když zbylo na pomazánku.“ —"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Šest zlatých podruhé, nikdo víc?“"
  },
  {
   "texto": "„Hrozná to, děti, siroba!"
  },
  {
   "texto": "Šest zlatých za moje muka!"
  },
  {
   "texto": "Prázdna je naše zásoba —"
  },
  {
   "texto": "tak srdce matčino puká!“ —"
  },
  {
   "texto": "Dráb z drsných vyvolá plic:"
  },
  {
   "texto": "„Šest zlatých po třetí, nikdo víc!“"
  }
 ]
}