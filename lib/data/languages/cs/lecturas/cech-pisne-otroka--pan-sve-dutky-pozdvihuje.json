  {
   "texto": "Pán své důtky pozdvihuje,"
  },
  {
   "texto": "mává jimi nad hlavou"
  },
  {
   "texto": "a hvizd jejich doprovází"
  },
  {
   "texto": "řečí zpupně rouhavou:"
  },
  {
   "texto": "„Hle, jak pestří se tu pěkně,"
  },
  {
   "texto": "v ladné uzly spleteny,"
  },
  {
   "texto": "jako chumáč hadů lesklých"
  },
  {
   "texto": "různobarvé řemeny!"
  },
  {
   "texto": "Slyšte, v libé harmonii"
  },
  {
   "texto": "jak tu syčí každý had!"
  },
  {
   "texto": "Hle, jak svíjí se a kroutí,"
  },
  {
   "texto": "vašich plecí chtiv a zad!"
  },
  {
   "texto": "A by zub jich jedovatý"
  },
  {
   "texto": "méně krutým zdál se vám,"
  },
  {
   "texto": "každé z peřestých těch zmijí"
  },
  {
   "texto": "blahozvučné jméno dám."
  },
  {
   "texto": "Hle, ten řemen sluje Vírou,"
  },
  {
   "texto": "jež vám káže: Zbožně nes"
  },
  {
   "texto": "jho svých pánů, za trud žití"
  },
  {
   "texto": "v ráji najdeš věčný ples."
  },
  {
   "texto": "Ten zas řemen zovu Právem,"
  },
  {
   "texto": "z vašich vlastních zad je drán,"
  },
  {
   "texto": "vaší krví na něm psáno,"
  },
  {
   "texto": "že jste raby a já pán."
  },
  {
   "texto": "Zde ten uzel Zvyk je dávný,"
  },
  {
   "texto": "onde Mrav, tam Osvěta,"
  },
  {
   "texto": "ba, i Svobody se fraška"
  },
  {
   "texto": "s Pořádkem zde prolétá."
  },
  {
   "texto": "Lidskostí ten řemen sluje,"
  },
  {
   "texto": "onen Pravdou, Ctností ten —"
  },
  {
   "texto": "Co tu svistí v mojich důtkách"
  },
  {
   "texto": "na vybranou krásných jmen!"
  },
  {
   "texto": "Otce, pradědy již vaše"
  },
  {
   "texto": "mrskaly ty řemeny,"
  },
  {
   "texto": "ctihodný jsou odkaz věků,"
  },
  {
   "texto": "staletími svěceny;"
  },
  {
   "texto": "chcete-li však, vyfintím je"
  },
  {
   "texto": "hrstkou z brusu nových cet —"
  },
  {
   "texto": "jen když pěst má jimi vládnout,"
  },
  {
   "texto": "cítit je váš bude hřbet!“"
  },
  {
   "texto": "Rabkyně, jež nad robátkem"
  },
  {
   "texto": "stinnou chýlíš snět,"
  },
  {
   "texto": "v lianovém lůžku vratkém"
  },
  {
   "texto": "houpajíc své lásky květ:"
  },
  {
   "texto": "odlož kvetoucí tu snítku —"
  },
  {
   "texto": "naučím tě raba dítku"
  },
  {
   "texto": "kolébavku pět."
  },
  {
   "texto": "„Zavři milá očka svoje,"
  },
  {
   "texto": "malý otroku!"
  },
  {
   "texto": "Již se třpytí hvězdné roje"
  },
  {
   "texto": "v temnomodrém vysoku;"
  },
  {
   "texto": "tvoje máť, den celý štvaná,"
  },
  {
   "texto": "oddechnout smí, utýraná,"
  },
  {
   "texto": "tobě po boku."
  },
  {
   "texto": "Co tě vinu do náručí,"
  },
  {
   "texto": "ve tvůj dětský sluch"
  },
  {
   "texto": "otrocká již hudba zvučí:"
  },
  {
   "texto": "pout mých drsnohlasý ruch."
  },
  {
   "texto": "Nevíš ach! co v sobě chová,"
  },
  {
   "texto": "že i tobě již se ková"
  },
  {
   "texto": "železný ten kruh."
  },
  {
   "texto": "Zrodila jsem tebe s bolem"
  },
  {
   "texto": "a přec nejsi můj,"
  },
  {
   "texto": "jako sup již krouží kolem"
  },
  {
   "texto": "nedočkavě katan tvůj;"
  },
  {
   "texto": "sotva rozum tvůj se vzbudí,"
  },
  {
   "texto": "do dětské již zatkne hrudi"
  },
  {
   "texto": "dravý pazour svůj."
  },
  {
   "texto": "Přikážou ti v prachu ctíti"
  },
  {
   "texto": "strůjce našich běd,"
  },
  {
   "texto": "dětský duch již bude píti"
  },
  {
   "texto": "rabské povrhlosti jed,"
  },
  {
   "texto": "abys pána stroj byl pouhý,"
  },
  {
   "texto": "každé volné dumy, touhy"
  },
  {
   "texto": "zdusí v tobě sled."
  },
  {
   "texto": "Až pak vzrosteš v jaré síle,"
  },
  {
   "texto": "modla snivých děv,"
  },
  {
   "texto": "odvlekou tě s jařmem v týle"
  },
  {
   "texto": "pod pánovu korouhev,"
  },
  {
   "texto": "poženou tě v pusté vřavě"
  },
  {
   "texto": "prolít k jeho cti a slávě"
  },
  {
   "texto": "mladou, vřelou krev."
  },
  {
   "texto": "Potem svým proň půdu rosit"
  },
  {
   "texto": "budeš do hrobu"
  },
  {
   "texto": "neb — hůř ještě! — mrzkou nosit"
  },
  {
   "texto": "drábův jeho ozdobu,"
  },
  {
   "texto": "budeš vlastní bratry týrat,"
  },
  {
   "texto": "pomůžeš mu vaz jim svírat"
  },
  {
   "texto": "v tužší porobu."
  },
  {
   "texto": "Temné křídlo noční můry"
  },
  {
   "texto": "ochvívá tvou líc,"
  },
  {
   "texto": "nad palmami s modré hůry"
  },
  {
   "texto": "svítí hvězd už na tisíc;"
  },
  {
   "texto": "zavři očka, moje kvítí —"
  },
  {
   "texto": "k potupnému raba žití"
  },
  {
   "texto": "neprobuď se víc!“"
  }
 ]
