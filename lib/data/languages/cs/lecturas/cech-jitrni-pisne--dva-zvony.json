 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Dva zvony visí pod Petřínem,"
  },
  {
   "texto": "dva věrní druzi mnohý čas,"
  },
  {
   "texto": "nad mariánským vzletá týnem"
  },
  {
   "texto": "tři staletí jich velký hlas,"
  },
  {
   "texto": "jej opětují stráně kolem,"
  },
  {
   "texto": "on mocně duní širým dolem"
  },
  {
   "texto": "a plní Prahu zpěvem svým;"
  },
  {
   "texto": "však nasloucháš-li bystrým sluchem,"
  },
  {
   "texto": "zvuk proznívá těch zvonů ruchem:"
  },
  {
   "texto": "Hus, Hus, Jeroným!"
  },
  {
   "texto": "Mnich bosák obraz matky boží"
  },
  {
   "texto": "kdys před vítězným vojskem nes’,"
  },
  {
   "texto": "a svaté panně na podnoží"
  },
  {
   "texto": "vzdor lidu kacířského kles’,"
  },
  {
   "texto": "na popravišti strašným soudem"
  },
  {
   "texto": "krev odbojníků tekla proudem"
  },
  {
   "texto": "a znovu v Čechách vládl Řím;"
  },
  {
   "texto": "meč břitký s ohněm vyplel sémě,"
  },
  {
   "texto": "jež zasili v prsť naší země"
  },
  {
   "texto": "Jan Hus, Jeroným!"
  },
  {
   "texto": "A řád, jenž zažeh’ svaté hněvy,"
  },
  {
   "texto": "zde vyvolil si byt a chrám,"
  },
  {
   "texto": "v něm spasný obraz rajské děvy"
  },
  {
   "texto": "nad oltář vztyčil k modlitbám"
  },
  {
   "texto": "a za slavíky štíhlé věži"
  },
  {
   "texto": "ze staré kaple bludných kněží"
  },
  {
   "texto": "dva zvony vyrval ssutým zdím,"
  },
  {
   "texto": "dva zvony, s nichžto vyhlazena"
  },
  {
   "texto": "zlá dvojí líc, dvě kletá jmena:"
  },
  {
   "texto": "Jan Hus, Jeroným!"
  },
  {
   "texto": "Tak sám ten arcikacíř dvojí,"
  },
  {
   "texto": "jenž chystal pravé víře zmar,"
  },
  {
   "texto": "měl nyní slavit v novém kroji"
  },
  {
   "texto": "pád bludařství a církve zdar -"
  },
  {
   "texto": "Než, poprvé když v bytě novém"
  },
  {
   "texto": "zpěv jejich zazněl zvučným kovem,"
  },
  {
   "texto": "tu mnichy zděsil pekla šprým -"
  },
  {
   "texto": "Jak výsměch vzdorný v jejich cely"
  },
  {
   "texto": "ty zvony nepodajné hřměly:"
  },
  {
   "texto": "Hus, Hus, Jeroným!"
  },
  {
   "texto": "Hned snešeny jsou zvony s hůry"
  },
  {
   "texto": "a vytržena srdce z nich"
  },
  {
   "texto": "i přelity jsou v nové stvůry,"
  },
  {
   "texto": "jež vykropil a žehnal mnich,"
  },
  {
   "texto": "kol vryta do nich zbožná slova,"
  },
  {
   "texto": "šperk svatých znaků,jmena nová -"
  },
  {
   "texto": "kříž zvítězil nad čarem zlým:"
  },
  {
   "texto": "již umlklo na české nivě:"
  },
  {
   "texto": "Hus, Hus, Jeroným…"
  },
  {
   "texto": "Leč nikoli! V tom kovu starém"
  },
  {
   "texto": "přec vytrval i starý zvuk"
  },
  {
   "texto": "a pod vnuceným cizím tvarem"
  },
  {
   "texto": "bil tajně dávný srdce tluk."
  },
  {
   "texto": "Jej nevytiskla z věrných zvonů"
  },
  {
   "texto": "moc exorcismu, svatých konů,"
  },
  {
   "texto": "on pod útlakem pouze zdřím’,"
  },
  {
   "texto": "a duším věrným v jejich znění"
  },
  {
   "texto": "vždy duníval jak dávné hřmění:"
  },
  {
   "texto": "Hus, Hus, Jeroným!"
  },
  {
   "texto": "A teď jej slyší tisíc uší,"
  },
  {
   "texto": "těch družnýchzvonů pravý hlas,"
  },
  {
   "texto": "jenž z mrtvých srdcí k živým buší"
  },
  {
   "texto": "jak mučedníků svatých vzkaz:"
  },
  {
   "texto": "„Jak zvonů nám, i lide, tobě"
  },
  {
   "texto": "sok vyrval jaré srdce v zlobě,"
  },
  {
   "texto": "znak cizí údům vtiskna mdlým,"
  },
  {
   "texto": "byl’s přelit v nástroj svého vraha,"
  },
  {
   "texto": "z úst vyrvána Ti jména drahá:"
  },
  {
   "texto": "Jan Hus, Jeroným.“"
  },
  {
   "texto": "Však nechať tebe přetvořili"
  },
  {
   "texto": "všem zemím v pohrdu a smích,"
  },
  {
   "texto": "přec v mošně žebrácké ti zbyly"
  },
  {
   "texto": "dva skvosty vzácné předků tvých:"
  },
  {
   "texto": "Ať svalili tvůj Sion v rumy"
  },
  {
   "texto": "a zdeptali tvé smělé dumy,"
  },
  {
   "texto": "tvé bible vmetli v žár a dým:"
  },
  {
   "texto": "vždy tajně choval’s pravdy žízeň,"
  },
  {
   "texto": "s níž podstoupili ohně trýzeň"
  },
  {
   "texto": "Jan Hus, Jeroným."
  },
  {
   "texto": "A druhý odkaz, klenot ryzí:"
  },
  {
   "texto": "to milý hlahol rodných slov;"
  },
  {
   "texto": "nechť přeléván ve tvary cizí,"
  },
  {
   "texto": "jím stále zvonil český kov."
  },
  {
   "texto": "Ó chraň jej dál jak záři oka"
  },
  {
   "texto": "před úskokem a zlobou soka,"
  },
  {
   "texto": "vždyť rosteš, vadneš, hyneš s ním -"
  },
  {
   "texto": "stůj v boji zaň jak tvrdá skála,"
  },
  {
   "texto": "jak dvojice ta velká stála:"
  },
  {
   "texto": "Jan Hus, Jeroným!"
  },
  {
   "texto": "Je trudno kol. - Na nivy naše"
  },
  {
   "texto": "voj stínů slavý smutný vjezd"
  },
  {
   "texto": "a mraky šeré halí plaše"
  },
  {
   "texto": "nám dvojici těch jasných hvězd."
  },
  {
   "texto": "Teď prapor světla lichá třáseň,"
  },
  {
   "texto": "a s ostychem jen volí báseň"
  },
  {
   "texto": "o řeči rodné sešlý rým -"
  },
  {
   "texto": "Pryč, péro chabé! - - Náhle ke mně"
  },
  {
   "texto": "hlas dalných zvonů donik’ temně:"
  },
  {
   "texto": "Hus, Hus, Jeroným!"
  },
  {
   "texto": "Ó nebe, rozhluč uraganem"
  },
  {
   "texto": "těch zvonů rety kovové,"
  },
  {
   "texto": "ať znovu svatým ohněm vzplanem’"
  },
  {
   "texto": "v jich staré písni hromové,"
  },
  {
   "texto": "ať v čela vrátí hrdé vzdory"
  },
  {
   "texto": "a zápal zhaslý v chabé zory,"
  },
  {
   "texto": "ať sílu pažím vdechnou mdlým,"
  },
  {
   "texto": "ať k novému se vypne vzletu"
  },
  {
   "texto": "duch český, z něhož bleskli světu"
  },
  {
   "texto": "Jan Hus, Jeroným!"
  }
 ]
}