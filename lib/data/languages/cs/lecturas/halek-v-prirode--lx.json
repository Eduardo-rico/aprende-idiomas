 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-v-prirode",
  "titulo": "V přírodě",
  "orden": 16
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LX."
  },
  {
   "texto": "Prosáklé zpěvem slavičím"
  },
  {
   "texto": "a prodchlé vůní pažitů,"
  },
  {
   "texto": "prohřáté jarem slunečným —"
  },
  {
   "texto": "již leťte, písně, z úkrytu!"
  },
  {
   "texto": "Jste tažní pěvci, vím to, vím,"
  },
  {
   "texto": "mně na čas jenom příhodní,"
  },
  {
   "texto": "já nesmím déle držet vás,"
  },
  {
   "texto": "čas váš je tu, jste svobodni."
  },
  {
   "texto": "Já s vámi dřímal za rosy,"
  },
  {
   "texto": "vás k lesům vodil probdělé,"
  },
  {
   "texto": "potůček dal vám za koupel —"
  },
  {
   "texto": "víc nemám pro vás úděle."
  },
  {
   "texto": "Jen jedno prosím: v návratu,"
  },
  {
   "texto": "za chvíle nových radostí,"
  },
  {
   "texto": "nezapomeňte, srdce mé"
  },
  {
   "texto": "že vás vždy rádo uhostí."
  },
  {
   "texto": "Jeť hostinný v něm každý keř"
  },
  {
   "texto": "a na květ všecka poupátka,"
  },
  {
   "texto": "jeť největší slast — hájem být,"
  },
  {
   "texto": "kdy líhne písním robátka."
  },
  {
   "texto": "To v háji bylo vavřínovém:"
  },
  {
   "texto": "háj dýchal nesmrtelný sen,"
  },
  {
   "texto": "a chvílemi zas šuměl slovem,"
  },
  {
   "texto": "jež dělí spoustu v noc a den."
  },
  {
   "texto": "A v háje pološerém stínu,"
  },
  {
   "texto": "tam kráčí Sláva s velebou,"
  },
  {
   "texto": "šat na těle má cherubinů,"
  },
  {
   "texto": "a věčnou hvězdu nad sebou."
  },
  {
   "texto": "Tam větve kropí, hlídá v stesku,"
  },
  {
   "texto": "než hvězda plá jen do pola,"
  },
  {
   "texto": "když ale uzrá v plném lesku:"
  },
  {
   "texto": "to hlasně hájem provolá."
  },
  {
   "texto": "Tu každý list u blahém hnutí"
  },
  {
   "texto": "sám sebou prchá zápasem,"
  },
  {
   "texto": "chce ve věnci být, v obejmutí,"
  },
  {
   "texto": "a háj se chvěje úžasem."
  },
  {
   "texto": "Teď právě kroky zastavila:"
  },
  {
   "texto": "les mlčí němý dokola,"
  },
  {
   "texto": "zář nad ní ve hvězdu se slila —"
  },
  {
   "texto": "čí asi jmeno provolá?"
  },
  {
   "texto": "Kdos unaven a světa syt,"
  },
  {
   "texto": "za svět se rouhat nechci tobě;"
  },
  {
   "texto": "jen ještě svěř mi ruku svou,"
  },
  {
   "texto": "než počne kopat o tvém hrobě."
  },
  {
   "texto": "A pojďme spolu k ptáčeti,"
  },
  {
   "texto": "když z jara počne život hravý —"
  },
  {
   "texto": "přes moře právě přilítlo,"
  },
  {
   "texto": "a už si v keři domov staví."
  },
  {
   "texto": "Už letí pro mech do lesa,"
  },
  {
   "texto": "a v polích hledá měkké vlásky,"
  },
  {
   "texto": "od rána snáší s klopotem,"
  },
  {
   "texto": "a večer zná jen mluvu lásky."
  },
  {
   "texto": "A hnízdo sotva do pola,"
  },
  {
   "texto": "už našlo k písním také družku,"
  },
  {
   "texto": "a kropenatá vajíčka"
  },
  {
   "texto": "má doma přes noc za vejslužku."
  },
  {
   "texto": "A pak už jako na hodech,"
  },
  {
   "texto": "za písní píseň beze mdloby —"
  },
  {
   "texto": "to vše nemá-li mluvy dost:"
  },
  {
   "texto": "jdi, stel si lůžko mezi hroby."
  }
 ]
}