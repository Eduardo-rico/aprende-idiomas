{
 "id": "neruda-knihy-versu--jenik",
 "titulo": "Jeník",
 "autor": "Jan Neruda",
 "muerteAutor": 1891,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Knihy_ver%C5%A1%C5%AF/Jen%C3%ADk",
 "fuente": "cs.wikisource.org, «Knihy veršů»",
 "licencia": "dominio público (autor muerto en 1891)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (2 formas) con el actual en «-t» (3). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "neruda-knihy-versu",
  "titulo": "Knihy veršů",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Kolem lásky rozmarína —"
  },
  {
   "texto": "Žlutá rozmarína."
  },
  {
   "texto": "I."
  },
  {
   "texto": "Naposled už zvony při mši zazvonily,"
  },
  {
   "texto": "naposled se lidé zbožně poklonili."
  },
  {
   "texto": "Jedni poklekali ještě po hřbitovu,"
  },
  {
   "texto": "druzí pospíchali polem ku domovu —"
  },
  {
   "texto": "a ten mysliveček v kamizolce šedé"
  },
  {
   "texto": "černooké děvče polní cestou vede. —"
  },
  {
   "texto": "„Lituju tě věru, milý můj Jeníčku,"
  },
  {
   "texto": "poradím ti dobře, dej na velkou svíčku!“"
  },
  {
   "texto": "„„Svěcená ta svíčka ovšem plamem hoří,"
  },
  {
   "texto": "ale moje srdce větší plamen moří;"
  },
  {
   "texto": "svěcená ta svíčka ovšem mnoho platí,"
  },
  {
   "texto": "ale moje bolesť víc se nevytratí!"
  },
  {
   "texto": "Černooké děvče se ‚mnou‘ chodívalo,"
  },
  {
   "texto": "se ‚mnou‘ za ruce se polem vodívalo."
  },
  {
   "texto": "Cestičku jsem zoral, dělal jsem ji užší,"
  },
  {
   "texto": "abych blíž se tisknul k milované duši;"
  },
  {
   "texto": "drobné kamení jsem na cestičku házel,"
  },
  {
   "texto": "abych pomaloučku děvče doprovázel:"
  },
  {
   "texto": "ztratila se láska drobném ve kamení —"
  },
  {
   "texto": "však mně nebohému pomoci víc není!“"
  },
  {
   "texto": "II."
  },
  {
   "texto": "Trouby hrajou, chasa výská,"
  },
  {
   "texto": "myslivec si vesel zpívá —"
  },
  {
   "texto": "dveřmi tvář se bledá dívá,"
  },
  {
   "texto": "jak když k smrti se jí stýská."
  },
  {
   "texto": "„Hrejte, páni, lenit nechci,"
  },
  {
   "texto": "dá se vám sic do trub plíseň,"
  },
  {
   "texto": "zahrejte mi, vesele chci"
  },
  {
   "texto": "černým očím zpívat píseň! —"
  },
  {
   "texto": "Když jsi plela len,"
  },
  {
   "texto": "měla's krásný sen —"
  },
  {
   "texto": "jedna láska z hlavy vyšla,"
  },
  {
   "texto": "druhá do srdce zas přišla"
  },
  {
   "texto": "byl to krásný sen!“"
  },
  {
   "texto": "Trouby znějí—„Do kola!“"
  },
  {
   "texto": "myslivec zas zavolá."
  },
  {
   "texto": "Bledá tvář se nedívá,"
  },
  {
   "texto": "z venku ale zaznívá"
  },
  {
   "texto": "píseň jako v umírání,"
  },
  {
   "texto": "jak by srdce šlo tam spát."
  },
  {
   "texto": "„„Škoda toho milování,"
  },
  {
   "texto": "že netrvá do skonání,"
  },
  {
   "texto": "škoda nastokrát!““"
  },
  {
   "texto": "III."
  },
  {
   "texto": "Měsíc zašel, byl už k tomu čas,"
  },
  {
   "texto": "zejtra se nám časně zase vrátí —"
  },
  {
   "texto": "kdo as řekne, když se láska tratí,"
  },
  {
   "texto": "že mu láska přijde zejtra zas ? —"
  },
  {
   "texto": "Nestůj, hochu, při okénku,"
  },
  {
   "texto": "nevolej už svou milenku,"
  },
  {
   "texto": "popřej černým očím spánek:"
  },
  {
   "texto": "tvoje doby veselé"
  },
  {
   "texto": "ulítly tak jak skřivánek"
  },
  {
   "texto": "z bílého by jetele! —"
  },
  {
   "texto": "„Moje milá Bětuška,"
  },
  {
   "texto": "s věnečkem ve hlavě,"
  },
  {
   "texto": "byla jak ta beruška"
  },
  {
   "texto": "při zelené trávě."
  },
  {
   "texto": "Roztomilé dívčiny"
  },
  {
   "texto": "velké černé oči"
  },
  {
   "texto": "jak ty černé maliny,"
  },
  {
   "texto": "když je rosa smočí!"
  },
  {
   "texto": "Černé oči, tvrdě spíte,"
  },
  {
   "texto": "o mé lásce víc nevíte!"
  },
  {
   "texto": "černé oči jako trny,"
  },
  {
   "texto": "nejste více bez poskvrny —"
  },
  {
   "texto": "proč jste lásce výhost daly,"
  },
  {
   "texto": "když jste srdce ubodaly?"
  },
  {
   "texto": "IV."
  },
  {
   "texto": "„V polním co dešti je krápějí,"
  },
  {
   "texto": "po cestičce je mých šlápějí —"
  },
  {
   "texto": "kolik je kostelů ve světě,"
  },
  {
   "texto": "tolikkrát byl jsem u děvčete!"
  },
  {
   "texto": "Kolik je ve světě klášterů,"
  },
  {
   "texto": "tolikkrát šel jsem k ní k večeru —"
  },
  {
   "texto": "kolik je po kraji kapliček,"
  },
  {
   "texto": "tolik mně dávala hubiček!"
  },
  {
   "texto": "Kdybych byl klíče měl od nebe,"
  },
  {
   "texto": "nebyl bych z rána šel od tebe,"
  },
  {
   "texto": "nebyl bych lásku si pochoval,"
  },
  {
   "texto": "byl bych tě matičce dochoval!"
  },
  {
   "texto": "Na hřbitov lásku svou ponesu,"
  },
  {
   "texto": "na hřbitov, černých tam do lesů."
  },
  {
   "texto": "Vejdu tam malými dvířkami,"
  },
  {
   "texto": "zavřeny dvěma jsou klikami —"
  },
  {
   "texto": "jedna je pro panny bez věnce,"
  },
  {
   "texto": "druhá pro sklamané mládence."
  },
  {
   "texto": "Zaleskne tolik se slziček,"
  },
  {
   "texto": "kolik je po hrobích traviček."
  },
  {
   "texto": "Zlaté ty po nebi hvězdičky"
  },
  {
   "texto": "napláčou studené rosičky:"
  },
  {
   "texto": "zelenou kytku že nasázel,"
  },
  {
   "texto": "žlutý že rozmarín vycházel!“"
  },
  {
   "texto": "V."
  },
  {
   "texto": "Letí deštík po poli"
  },
  {
   "texto": "za ním stíny lehce —"
  },
  {
   "texto": "„Ach, že šírý mne ten svět"
  },
  {
   "texto": "více těšit nechce!"
  },
  {
   "texto": "Nač bych sadem chodila,"
  },
  {
   "texto": "když už stínu nemá,"
  },
  {
   "texto": "nač bych cestu šlapala,"
  },
  {
   "texto": "když už pro mne němá!"
  },
  {
   "texto": "Růže moje vybledlá"
  },
  {
   "texto": "s tváře opadává —"
  },
  {
   "texto": "druhý mne už opustil,"
  },
  {
   "texto": "první postonává!"
  },
  {
   "texto": "Nepatřím víc matičce,"
  },
  {
   "texto": "nepatřím víc sobě —"
  },
  {
   "texto": "nevinnost má v kolíbce,"
  },
  {
   "texto": "mladosť má už v hrobě!“"
  },
  {
   "texto": "VI."
  },
  {
   "texto": "„Kdo to klepe v pozdní noci,"
  },
  {
   "texto": "jde snad kněz nám ku pomoci?“"
  },
  {
   "texto": "„„Vy mne po tak krátkém času"
  },
  {
   "texto": "neznáte už podlé hlasu!"
  },
  {
   "texto": "Milá vašeho jsem syna,"
  },
  {
   "texto": "jeho smrtí jsem já vinna."
  },
  {
   "texto": "Život jsem mu otrávila,"
  },
  {
   "texto": "o mladosť ho připravila."
  },
  {
   "texto": "Musel se až k smrti soužit,"
  },
  {
   "texto": "jdu mu ku hodince sloužit.““"
  },
  {
   "texto": "„Mého syna vražednice,"
  },
  {
   "texto": "nemám místa pro vinnice!“"
  },
  {
   "texto": "„„„Pusť ji ke mně, matko milá,"
  },
  {
   "texto": "snad už hříchy svoje smyla."
  },
  {
   "texto": "Pověz ty mně, moje milá,"
  },
  {
   "texto": "čím jsi hříchy svoje myla?“'\"'"
  },
  {
   "texto": "„„Slzami jsem si je myla,"
  },
  {
   "texto": "předc jsem žalu nepozbyla!““"
  },
  {
   "texto": "„„„Pověz, až mé srdce stane,"
  },
  {
   "texto": "jaký tělo šat dostane!““"
  },
  {
   "texto": "„„Bílý rubáš jsem ti šila,"
  },
  {
   "texto": "slzami jej vybílila.““"
  },
  {
   "texto": "„„„Pověz, jakou poctíš truhlou"
  },
  {
   "texto": "pak tu hlavu moji ztuhlou?“““"
  },
  {
   "texto": "„„Na barvu si myslím jasnou,"
  },
  {
   "texto": "že jsi ztratil mladosť krásnou,"
  },
  {
   "texto": "a na truhlu bílé věnce,"
  },
  {
   "texto": "jak se sluší pro mládence;"
  },
  {
   "texto": "hnědé trny, růže bílé,"
  },
  {
   "texto": "že's byl sklamán od své milé!"
  },
  {
   "texto": "Až se budeš s zemí snoubit,"
  },
  {
   "texto": "počnou pěkné písně troubit,"
  },
  {
   "texto": "počnou troubit písně tvoje,"
  },
  {
   "texto": "bude pukat srdce moje!““"
  },
  {
   "texto": "VII."
  },
  {
   "texto": "Zlehka probudit ho zkusí —"
  },
  {
   "texto": "„Zbuď se, těžký sen tě dusí!“"
  },
  {
   "texto": "„„Těžký sen? Já spal tak lehce,"
  },
  {
   "texto": "že se ani vstávat nechce!\"\""
  },
  {
   "texto": "„Vidíš-li mne, ty můj milý?"
  },
  {
   "texto": "tvoje oči „jsou tak bíly!"
  },
  {
   "texto": "„„Bílé oči? To je zdání,"
  },
  {
   "texto": "jsou tak bíly po vyspání!"
  },
  {
   "texto": "Dej mně vodu, žízeň trýzní,"
  },
  {
   "texto": "rty se lepí krutou žízní.““"
  },
  {
   "texto": "„Nepij vody — divné znění,"
  },
  {
   "texto": "jak když padá na kamení!“"
  },
  {
   "texto": "„„Divné máš, má milá, zdání,"
  },
  {
   "texto": "to tak vždycky po vyspání!\"“"
  },
  {
   "texto": "„Což se ti tvůj dech už tratí?“"
  },
  {
   "texto": "„„To se chvilkami jen krátí,"
  },
  {
   "texto": "někdy dlouhý, někdy krátký,"
  },
  {
   "texto": "jako u písničky řádky!\"“"
  },
  {
   "texto": "„Mám ti polštář dát snad výše,"
  },
  {
   "texto": "když se ti tak ztěžka dýše?“ —"
  },
  {
   "texto": "Bílé oči hledí na ni"
  },
  {
   "texto": "a z těch očí — věčné spaní;"
  },
  {
   "texto": "půlnoc byla, půlnoc bila,"
  },
  {
   "texto": "milá s mrtvým sama byla."
  }
 ]
}