 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "VIII."
  },
  {
   "texto": "Já laňku vidím za šera"
  },
  {
   "texto": "červánky pít z hor jezera,"
  },
  {
   "texto": "pak stála s němým okem,"
  },
  {
   "texto": "pak v lesy mihla skokem."
  },
  {
   "texto": "Co se to se mnou stalo jen,"
  },
  {
   "texto": "že jsem v tu laňku proměněn?"
  },
  {
   "texto": "Má noha do vod vrůstá,"
  },
  {
   "texto": "v červánky ztápím ústa."
  },
  {
   "texto": "A piju lesk jak padlý sníh,"
  },
  {
   "texto": "a nad ním hvězd večerní mih,"
  },
  {
   "texto": "i zlatý blankyt výše — —"
  },
  {
   "texto": "z té modré břehů číše."
  },
  {
   "texto": "A stojím němý, udiven;"
  },
  {
   "texto": "ten krásný svět toť krásný sen,"
  },
  {
   "texto": "teď k duši cestu pne si —"
  },
  {
   "texto": "já za laňkou jdu v lesy."
  },
  {
   "texto": "Pojď, drahá — než se dohodnou,"
  },
  {
   "texto": "čí zpěv víc dojmout umí,"
  },
  {
   "texto": "my sobě zajdem v pásmo hor,"
  },
  {
   "texto": "kdy sterým hvozdem šumí."
  },
  {
   "texto": "Zpod řeka švarně na pochod"
  },
  {
   "texto": "zve pramének si tenký,"
  },
  {
   "texto": "a nad ní ptáků kmitný roj"
  },
  {
   "texto": "hrá sobě na myšlénky."
  },
  {
   "texto": "A strání zvukotkaný dech,"
  },
  {
   "texto": "hněv slavný vodopádů,"
  },
  {
   "texto": "a všecko to jak z jedněch prs,"
  },
  {
   "texto": "jak z velké duše skladu —"
  },
  {
   "texto": "A jak tu píseň skládají,"
  },
  {
   "texto": "až vyslechnem je vřele:"
  },
  {
   "texto": "pak poznalas mou knihu kněh,"
  },
  {
   "texto": "i mého učitele."
  },
  {
   "texto": "Dech jara sezval přátele,"
  },
  {
   "texto": "a jakby neznal hrází,"
  },
  {
   "texto": "i té mé duši pokynul,"
  },
  {
   "texto": "že do všech růží vchází."
  },
  {
   "texto": "Že v modro letí s skřivánkem"
  },
  {
   "texto": "a v jeho písni prýská,"
  },
  {
   "texto": "že bydlí v hájích, ve stromech"
  },
  {
   "texto": "a s ptáčaty si stýská."
  },
  {
   "texto": "Že rozkládá se na luhu"
  },
  {
   "texto": "a s vánkem dýchá jemně,"
  },
  {
   "texto": "že s jitrem jásá po horách —"
  },
  {
   "texto": "a s písněmi dlí ve mně."
  },
  {
   "texto": "Vyběhla bříza běličká"
  },
  {
   "texto": "jak ze stáda ta kozička,"
  },
  {
   "texto": "vyběhla z lesa na pokraj,"
  },
  {
   "texto": "že prý už táhne jara báj."
  },
  {
   "texto": "Vyběhla jako panenka,"
  },
  {
   "texto": "tak hebká a tak do tenka,"
  },
  {
   "texto": "že až to lesem projelo,"
  },
  {
   "texto": "a vše se touhou zachvělo."
  },
  {
   "texto": "A táhne šumem jara báj,"
  },
  {
   "texto": "vzduch jak na housle, na šalmaj,"
  },
  {
   "texto": "vzduch samá vůně, samý květ,"
  },
  {
   "texto": "a mladý úsměv celý svět."
  },
  {
   "texto": "Hned každý strom zelený šat"
  },
  {
   "texto": "jme svátečně se oblíkat,"
  },
  {
   "texto": "a každá haluz, každá snět"
  },
  {
   "texto": "chce novou řečí rozprávět."
  },
  {
   "texto": "A jakby k hodům zavolal,"
  },
  {
   "texto": "přilítli hosté z blíž i dál,"
  },
  {
   "texto": "a za den, za dva širý kraj"
  },
  {
   "texto": "a celý svět byl jara báj."
  }
 ]
}