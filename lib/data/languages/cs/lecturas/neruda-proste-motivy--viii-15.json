 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "VIII"
  },
  {
   "texto": "Když dal osud píseň tobě - jen ne dlouhou, jen ne dlouhou!"
  },
  {
   "texto": "Posluchači hlavy věsí,"
  },
  {
   "texto": "každý již se poodvrací,"
  },
  {
   "texto": "zavzdychne si, zašeptne si:"
  },
  {
   "texto": "„Zestár pěvec - hlas už ztrácí!“"
  },
  {
   "texto": "Když dal osud cestu tobě - jen ne dlouhou, jen ne dlouhou!"
  },
  {
   "texto": "Poutník pak už sice všaký,"
  },
  {
   "texto": "bujně okolo se nesa,"
  },
  {
   "texto": "outrpně tě měří zraky:"
  },
  {
   "texto": "„Chudáček, užklesá - klesá!“"
  },
  {
   "texto": "Jesenní kraj jsem, znavený"
  },
  {
   "texto": "po bujném, úrodném létu,"
  },
  {
   "texto": "šerá se po nebi chmúra pne"
  },
  {
   "texto": "a písně mé mají se k letu."
  },
  {
   "texto": "Uprostřed kraje je bílý chrám"
  },
  {
   "texto": "- tužby mé posud jej staví -"
  },
  {
   "texto": "kol jeho věží se písně mé"
  },
  {
   "texto": "teď slétají v šveholné davy."
  },
  {
   "texto": "Zmatený švehol! Víc žádný zpěv,"
  },
  {
   "texto": "žádné v tom popěvy tklivé,"
  },
  {
   "texto": "slyším jen pípnutí tázavé"
  },
  {
   "texto": "a vzkřiknutí netrpělivé."
  },
  {
   "texto": "Odleťte tedy, již odleťte"
  },
  {
   "texto": "do krajin mladistvě stinných -"
  },
  {
   "texto": "sbohem si leťte, já oněmím,"
  },
  {
   "texto": "vy leťte si do srdcí jiných."
  },
  {
   "texto": "Den vznesl se z údolu; výš a výš"
  },
  {
   "texto": "teď kráčí svým světelným krokem -"
  },
  {
   "texto": "„Kam jdeš teď, kam jdeš?“ - „Vždyť vydíš přec,"
  },
  {
   "texto": "že ku výši hory bokem.“"
  },
  {
   "texto": "A pojednou ztemněla hora se,"
  },
  {
   "texto": "a zhaslo i zlacené témě -"
  },
  {
   "texto": "„Kde jsi teď, kde jsi?“ Však ticho kol"
  },
  {
   "texto": "a němá je širá země."
  },
  {
   "texto": "Já cítím se pojednou opuštěn -"
  },
  {
   "texto": "kam asi se den můj vznesl?!"
  },
  {
   "texto": "A v zimničném, v toužebném pospěchu"
  },
  {
   "texto": "můj k údolu zrak zas sklesl."
  },
  {
   "texto": "Ach celá má minulost - vždyť to tam"
  },
  {
   "texto": "již plujou jen mráčkové šedí -"
  },
  {
   "texto": "a mně je tak ouzko, tak tesklivo,"
  },
  {
   "texto": "jak měl bych jít ku zpovědi."
  },
  {
   "texto": "Přede dvorem stará vrba,"
  },
  {
   "texto": "pně už vydoutnalé,"
  },
  {
   "texto": "samá jizva, samá troucheň -"
  },
  {
   "texto": "kdy ji podtít ale?"
  },
  {
   "texto": "Z jara, když jí zbylá větev"
  },
  {
   "texto": "květem pookřeje?"
  },
  {
   "texto": "V létě, když své staré tělo"
  },
  {
   "texto": "na sluníčku hřeje?"
  },
  {
   "texto": "Či snad v zimě? Spí pak jistě?"
  },
  {
   "texto": "Necítí to ani?"
  },
  {
   "texto": "Starý strom a starý člověk"
  },
  {
   "texto": "má tak málo spaní!"
  }
 ]
}