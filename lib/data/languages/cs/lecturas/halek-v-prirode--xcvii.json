 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XCVII."
  },
  {
   "texto": "Stál v polích hřbitov osamělý —"
  },
  {
   "texto": "noc jistá za dni probdělé,"
  },
  {
   "texto": "kol do polí sil oráč zrnka"
  },
  {
   "texto": "a hvízdal písně veselé."
  },
  {
   "texto": "Dnes u zdi oral; rovy vpadlé,"
  },
  {
   "texto": "bez křížků, s vyschlým trávníkem,"
  },
  {
   "texto": "tam za zdí stojí hrobník s rýčem"
  },
  {
   "texto": "a jediným je pomníkem."
  },
  {
   "texto": "A počal hrobník také orat,"
  },
  {
   "texto": "jen s rýčem, ale hluboko;"
  },
  {
   "texto": "co vseje, nikdy nevychází,"
  },
  {
   "texto": "žně jsou tu jen tak na oko."
  },
  {
   "texto": "A hrobník zpíval: „Škoda očí"
  },
  {
   "texto": "a sladkého v nich plamene!“"
  },
  {
   "texto": "Smek’ oráč, z ruky pustil oprať,"
  },
  {
   "texto": "sám stál jak pomník z kamene."
  },
  {
   "texto": "Čas dávno ještě není starcem;"
  },
  {
   "texto": "tam sedí u skal rodiny,"
  },
  {
   "texto": "ty drobí zrnkem do propasti —"
  },
  {
   "texto": "v své přesejpací hodiny."
  },
  {
   "texto": "Ne roky, dni a luny měří,"
  },
  {
   "texto": "však věky velkým rozhledem:"
  },
  {
   "texto": "za krásný čin vždy jedno zrnko,"
  },
  {
   "texto": "když bez krve jej provedem."
  },
  {
   "texto": "A lehká práce ta je těžká,"
  },
  {
   "texto": "po lidstva pátrat ozdobách;"
  },
  {
   "texto": "i vidím propast skoro prázdnou"
  },
  {
   "texto": "a skály v plných zásobách."
  },
  {
   "texto": "Však jedno přec mně utěšením —"
  },
  {
   "texto": "žeť hošík ten tak při síle,"
  },
  {
   "texto": "a s důvěrou zve lidstvo celé:"
  },
  {
   "texto": "„Pojď, pomáhej mi při díle!“"
  },
  {
   "texto": "Já smrt přistihnul na číhané"
  },
  {
   "texto": "a v hněvu ved’ ji k přírodě:"
  },
  {
   "texto": "„Tu rdousí nám jenom ty dobré"
  },
  {
   "texto": "a špatní jsou u výhodě."
  },
  {
   "texto": "Ji v těžkou dávám obžalobu,"
  },
  {
   "texto": "jak hřeší po všem národě,"
  },
  {
   "texto": "a jestliže v tom tvoje vůle,"
  },
  {
   "texto": "s kým zákonem to ve shodě?“"
  },
  {
   "texto": "Smrt v smíchu cení lačné zuby:"
  },
  {
   "texto": "„Ved’s k nepravé mne stolici;"
  },
  {
   "texto": "tu ptej se dříve té tvé matky,"
  },
  {
   "texto": "proč rodí takou směsici?"
  },
  {
   "texto": "Proč bezcenných těch mužův loutek"
  },
  {
   "texto": "na léta tolik doživí,"
  },
  {
   "texto": "že bráti pořád jen tu chamraď,"
  },
  {
   "texto": "i smrti již se protiví?“"
  },
  {
   "texto": "A řekla příroda mně s výtkou:"
  },
  {
   "texto": "„Smrt stiháš ve při nevzorné;"
  },
  {
   "texto": "své bratry nauč býti lidmi,"
  },
  {
   "texto": "smrt bude brát jen výborné.“"
  },
  {
   "texto": "Mne světa krása nepodplatí,"
  },
  {
   "texto": "bych neviděl v ní prach a kost,"
  },
  {
   "texto": "bych u života zůstal státi,"
  },
  {
   "texto": "a nepoznal v něm k smrti most."
  },
  {
   "texto": "Však ze všech jdou mi nejmíň k duhu"
  },
  {
   "texto": "ti skuhralové u lidí,"
  },
  {
   "texto": "jenž s kostmi jen se v prachu válí"
  },
  {
   "texto": "a pro prach krásu nevidí."
  },
  {
   "texto": "Máť život právo nejpřednější,"
  },
  {
   "texto": "jeť krása žití výkvětem."
  },
  {
   "texto": "A život v květu! Víc mně jmenuj,"
  },
  {
   "texto": "a jsi mé písně předmětem."
  }
 ]
}