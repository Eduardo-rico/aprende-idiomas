 "parrafos": [
  {
   "texto": "23"
  },
  {
   "texto": "Že skály již Země plameny"
  },
  {
   "texto": "v nezdolná pouta kují?"
  },
  {
   "texto": "Vždyť já je zřím, ty plameny,"
  },
  {
   "texto": "vrch Země poskakují!"
  },
  {
   "texto": "Vidím je svítit po keřích"
  },
  {
   "texto": "ve vonných růží tvaru,"
  },
  {
   "texto": "slyším je v ptačích hrdélcích"
  },
  {
   "texto": "klokotat v plném varu."
  },
  {
   "texto": "Děvčátko když si mlaďounké"
  },
  {
   "texto": "ku prsoum mocně vinu,"
  },
  {
   "texto": "cítím, že vinu ohně sloup"
  },
  {
   "texto": "žhavý, až žárem hynu."
  },
  {
   "texto": "A když si lidstvu nahlédnu"
  },
  {
   "texto": "do vzníceného oka,"
  },
  {
   "texto": "do oka, jež jak hvězdná tůň"
  },
  {
   "texto": "bájně jde do hluboka;"
  },
  {
   "texto": "do oka, ježto v mžiknutí"
  },
  {
   "texto": "rekovným ohněm zjásá,"
  },
  {
   "texto": "volá-li voj svůj do boje"
  },
  {
   "texto": "svoboda, pravda, krása;"
  },
  {
   "texto": "v něž při slově lidsky šlechetném"
  },
  {
   "texto": "vpryskne hned slzná něha:"
  },
  {
   "texto": "cítím, jak vlastní plamen můj"
  },
  {
   "texto": "vzhůru až k nebi šlehá."
  },
  {
   "texto": "Dík budiž vám, zlaté hvězdičky,"
  },
  {
   "texto": "dík za jeden ze všech darů,"
  },
  {
   "texto": "že umím lidmi zatočit"
  },
  {
   "texto": "vesele do rozmaru!"
  },
  {
   "texto": "Že dovedu někdy alespoň"
  },
  {
   "texto": "mžik mladistvé ranní záře"
  },
  {
   "texto": "a živý poblesk radosti"
  },
  {
   "texto": "do české vkouzlit tváře."
  },
  {
   "texto": "Což - což je ta mysl národa"
  },
  {
   "texto": "tak ztýrána, potrápena,"
  },
  {
   "texto": "bojácná jako děťátko,"
  },
  {
   "texto": "tichounká jako pěna!"
  },
  {
   "texto": "Což - což je ta lidu mého líc"
  },
  {
   "texto": "tak zsínale, mrtvě bledá,"
  },
  {
   "texto": "kdo jednou na ni pohlédnul,"
  },
  {
   "texto": "více mu spáti nedá!"
  },
  {
   "texto": "Ach když po té tváři dojemné"
  },
  {
   "texto": "jen okamžik úsměv skáče -"
  },
  {
   "texto": "co na tom, že pak humorist"
  },
  {
   "texto": "do koutku jde a pláče!"
  },
  {
   "texto": "„Vlast svou máš nade vše milovat!“"
  },
  {
   "texto": "to ve hvězdách zlatě psáno"
  },
  {
   "texto": "a krasšího hvězdám nad zákon ten"
  },
  {
   "texto": "zákona není dáno."
  },
  {
   "texto": "Proto má planeta slunce své,"
  },
  {
   "texto": "jež k druhům ji měkce pojí,"
  },
  {
   "texto": "a každý má hvězdnatý nárůdek"
  },
  {
   "texto": "odvěkou oblast svoji."
  },
  {
   "texto": "Proto i kometa jiskrná"
  },
  {
   "texto": "tak dlouze své tělo plouží,"
  },
  {
   "texto": "že do světa zahnané atomy"
  },
  {
   "texto": "po vlasti nazpět touží."
  }
 ]
}