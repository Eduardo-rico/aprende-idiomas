  "orden": 20
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LXXII."
  },
  {
   "texto": "Matičko rci — byl bůh kdy mlád"
  },
  {
   "texto": "a bylas krásné dítě snad:"
  },
  {
   "texto": "jakou to chodil cestičkou,"
  },
  {
   "texto": "bys všem se stala matičkou?"
  },
  {
   "texto": "„Mé dítě, ke dni zásnubí"
  },
  {
   "texto": "bůh tkal mi nebes obrubí,"
  },
  {
   "texto": "oblohu modrou, hvězdy v ní,"
  },
  {
   "texto": "a to byl šat můj svatební."
  },
  {
   "texto": "A v lásky čas, v dne oslavu,"
  },
  {
   "texto": "já chystala si výbavu:"
  },
  {
   "texto": "dům nesmírný svůj, veliký,"
  },
  {
   "texto": "v něm moře, háje, slavíky."
  },
  {
   "texto": "Pak v lásky čas, v den záslibu,"
  },
  {
   "texto": "bůh líbal v žhoucím polibu,"
  },
  {
   "texto": "až prohřál světy hnedličko,"
  },
  {
   "texto": "a vylíbal jim sluníčko."
  },
  {
   "texto": "To bylo v máji. Doba ta"
  },
  {
   "texto": "je věčně láskou prohřáta,"
  },
  {
   "texto": "zem, nebe nejde z objetí —"
  },
  {
   "texto": "vy čiňte k naší paměti.“"
  },
  {
   "texto": "Vím já, kdy k modlitbě se kleká:"
  },
  {
   "texto": "když v kláscích hne se země ret,"
  },
  {
   "texto": "kdy duše má jest plna zvuku"
  },
  {
   "texto": "a duše mé jest plný svět."
  },
  {
   "texto": "Vím já, kdy zpovídat se bohu:"
  },
  {
   "texto": "kdy šípek v květ se upraví,"
  },
  {
   "texto": "kdy bůh rozpráví s každým broučkem"
  },
  {
   "texto": "a též se mnou se zastaví."
  },
  {
   "texto": "Vím já, kdy světit velký svátek:"
  },
  {
   "texto": "když otevrou se nebesa,"
  },
  {
   "texto": "a mladá země z plné duše"
  },
  {
   "texto": "v květ, vůni, píseň zaplesá."
  },
  {
   "texto": "Tak sic to není v kalendáři,"
  },
  {
   "texto": "však světů kniha od věků"
  },
  {
   "texto": "a každý lístek jara ví to,"
  },
  {
   "texto": "kdy bůh je nejblíž člověku."
  },
  {
   "texto": "Ti ptáci jak vojsko v pochodě:"
  },
  {
   "texto": "jen o zrnu žijou, o vodě,"
  },
  {
   "texto": "co za každým holek, kdož to ví,"
  },
  {
   "texto": "a ne-li, to hned si namluví."
  },
  {
   "texto": "Jsou jako ti naši šumaři:"
  },
  {
   "texto": "vždy bez práce a vždy v rozjaři,"
  },
  {
   "texto": "den hvízdaje probije celičký,"
  },
  {
   "texto": "a na noc má ještě písničky."
  },
  {
   "texto": "Jsou jako ten národ poetů:"
  },
  {
   "texto": "vždy bez pouta a jen do letu,"
  },
  {
   "texto": "nic nesejou a nic neklidí,"
  },
  {
   "texto": "všad doma hned, nejmíň u lidí."
  },
  {
   "texto": "Den májový, jak ze zlata,"
  },
  {
   "texto": "stráň po srdce až zahřáta,"
  },
  {
   "texto": "po ní si ptáček pěnká jen:"
  },
  {
   "texto": "„Den májový, jen pojďte ven!“"
  },
  {
   "texto": "A co jen zve se kytičkou,"
  },
  {
   "texto": "už běží s zlatou hlavičkou,"
  },
  {
   "texto": "však též, co ani nekvete,"
  },
  {
   "texto": "vybíhá přes prah z doupěte."
  },
  {
   "texto": "Dva stíny mušek s bzukotem,"
  },
  {
   "texto": "k nim lašťovičky mihotem,"
  },
  {
   "texto": "a kolčavka, ta bělrouchá,"
  },
  {
   "texto": "ta kouká jen a poslouchá."
  },
  {
   "texto": "A teď, jak puklé poupátko,"
  },
  {
   "texto": "jde modrooké děvčátko,"
  },
  {
   "texto": "to sedne, v dál se zadívá,"
  },
  {
   "texto": "a slunce v květ je zahřívá."
  },
  {
   "texto": "A nedaleko s kamena"
  },
  {
   "texto": "ještěrka šustne zelená,"
  },
  {
   "texto": "a ptáček pěnká v plesání:"
  },
  {
   "texto": "„Jsme na výsluní, na stráni.“"
  }
 ]
}