 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Své čelo mi do okna vtlačila"
  },
  {
   "texto": "a bílým svým okem se dívá -"
  },
  {
   "texto": "já vidím ji, zimu, tu paní zlou,"
  },
  {
   "texto": "jak mlhavým prstem svým kývá."
  },
  {
   "texto": "Je ticho, je mráz a mdlá noha má"
  },
  {
   "texto": "si na prahu vykročit váhá,"
  },
  {
   "texto": "však zima po horoucí dlani mé"
  },
  {
   "texto": "již mlhavou rukou svou sáhá."
  },
  {
   "texto": "A pozvolna ruku tu pozvedá"
  },
  {
   "texto": "a klade ji kolem mé šíje -"
  },
  {
   "texto": "ta vražedná žena! Vždyť cítím již,"
  },
  {
   "texto": "jak ze prsou dechy mi pije!"
  },
  {
   "texto": "A cítím, jak v ledovém objetí"
  },
  {
   "texto": "tvář bledne, ret rychle jak chladne,"
  },
  {
   "texto": "jak tepna se ve skoku zaráží"
  },
  {
   "texto": "a srdce jak klesá a vadne."
  },
  {
   "texto": "(Marii)"
  },
  {
   "texto": "Znal jsem ji ještě tak maličkou."
  },
  {
   "texto": "Viděl, jak s dětskou svou sesličkou"
  },
  {
   "texto": "ku oknu pracně se táhla."
  },
  {
   "texto": "Vystoupla, špulila drobný ret -"
  },
  {
   "texto": "kamkoli pusinkou sáhla,"
  },
  {
   "texto": "naskočil čisťoučký ledový květ."
  },
  {
   "texto": "Vidím ji dorostlou, rozkvětlou;"
  },
  {
   "texto": "rozkvětlou, v oku však uhnětlou,"
  },
  {
   "texto": "po tváři bledost ji běží."
  },
  {
   "texto": "Ku stolu níží svůj chvějný ret,"
  },
  {
   "texto": "na stole v rakvičce leží"
  },
  {
   "texto": "děťátko, čisťoučký ledový květ."
  },
  {
   "texto": "(Motiv národní)"
  },
  {
   "texto": "Proč vyhlíd jsem oknem teď k lesu ven?"
  },
  {
   "texto": "Tam u lesa okno se třpytí,"
  },
  {
   "texto": "tam vloni byl sněhový ještě lán"
  },
  {
   "texto": "a letos už chaloupka svítí."
  },
  {
   "texto": "Já vsázím se, že se tam za stolem"
  },
  {
   "texto": "dvě mladistvé tulí teď hlavy,"
  },
  {
   "texto": "vždyť v chaloupce mladý je páreček"
  },
  {
   "texto": "a první svůj Svatvečer slaví."
  },
  {
   "texto": "A na nebi nad malou chaloupkou"
  },
  {
   "texto": "tak do dálky hvězda se třpytí -"
  },
  {
   "texto": "snad aby Tři králové věděli,"
  },
  {
   "texto": "kam napřesrok s poklonou jíti."
  },
  {
   "texto": "V očích mně cos světélkuje,"
  },
  {
   "texto": "lebkou mně to lehce cinká -"
  },
  {
   "texto": "mojí duší náhle vane"
  },
  {
   "texto": "mladá, bujná upomínka:"
  },
  {
   "texto": "Jasný měsíc, rovná pole,"
  },
  {
   "texto": "všude plno sněhu na nich,"
  },
  {
   "texto": "a my z chrámu od půlnoční"
  },
  {
   "texto": "na zvonivých jedem saních."
  },
  {
   "texto": "V huňaté své kožešině"
  },
  {
   "texto": "vedle mne si dívka hoví -"
  },
  {
   "texto": "teploučká jak letní vánek,"
  },
  {
   "texto": "hezoučká jak dukát nový."
  },
  {
   "texto": "V chrámě jsem se na ni díval,"
  },
  {
   "texto": "nosíkem jak v knize leží -"
  },
  {
   "texto": "při modlitbě ve dřímotách,"
  },
  {
   "texto": "při hubičkách teď tak svěží!"
  },
  {
   "texto": "„Dej mi ještě třetí - čtvrtou -"
  },
  {
   "texto": "a pak pátou - šestou, dítlo,“-"
  },
  {
   "texto": "tolik medu, tolik vůně"
  },
  {
   "texto": "a tak droboulinké kvítko!"
  },
  {
   "texto": "„A teď ty mi navrať všecky,“"
  },
  {
   "texto": "v smíchu dívčina zas praví -"
  },
  {
   "texto": "pěkně se to v saních sedí,"
  },
  {
   "texto": "že se nesrážějí hlavy!"
  },
  {
   "texto": "Tepny létly, srdce bilo,"
  },
  {
   "texto": "jak by rozskočit se chtělo -"
  },
  {
   "texto": "rád bych ještě jednou prožil"
  },
  {
   "texto": "v myšlenách vše, co se dělo!"
  },
  {
   "texto": "Ale jasný měsíc bledne,"
  },
  {
   "texto": "slaběj to vždy hlavou cinká -"
  },
  {
   "texto": "za sněhová lada letí"
  },
  {
   "texto": "mladá smavá upomínka."
  }
 ]
}