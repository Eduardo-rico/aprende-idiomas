 "parrafos": [
  {
   "texto": "25"
  },
  {
   "texto": "Lehko nyní zamilovanému;"
  },
  {
   "texto": "co se chuďas dříve navzdychal,"
  },
  {
   "texto": "a než rýmy svedl přece k čemu,"
  },
  {
   "texto": "jako kovář ohně nadmýchal!"
  },
  {
   "texto": "Otcové nám dávno přezpívali"
  },
  {
   "texto": "lásku všelikým už způsobem"
  },
  {
   "texto": "a ty písně pěkně napísali,"
  },
  {
   "texto": "než se seznámili se hrobem."
  },
  {
   "texto": "Synu, kdy pocítíš lásky tísně,"
  },
  {
   "texto": "nepotřebně ohně nedmýchej,"
  },
  {
   "texto": "čti jen otců přecitlivé písně,"
  },
  {
   "texto": "a k těm písním sobě povzdychej."
  },
  {
   "texto": "Co jest láska? Divná smísenina"
  },
  {
   "texto": "z citů časně mládí šálících,"
  },
  {
   "texto": "lék to pro rychlejší živobytí"
  },
  {
   "texto": "z bejlí ostře v prsou pálících."
  },
  {
   "texto": "Z přátelství, jenž pojí nerozlučně"
  },
  {
   "texto": "v štěstí, v strasti prsa blahorodá, -"
  },
  {
   "texto": "jistý pud pak - zvyk i mnoho dělá,"
  },
  {
   "texto": "pak snad soupeřů též náhlá shoda."
  },
  {
   "texto": "Aby nevymřelo člověčenstvo,"
  },
  {
   "texto": "kdy se osud zvrátí větrnatý,"
  },
  {
   "texto": "tvoří příroda ty slíčné tváře,"
  },
  {
   "texto": "slíčné tváře, a ty - pěkné šaty."
  },
  {
   "texto": "„Povždy znovu pochybuju,"
  },
  {
   "texto": "je-li cudná, je-li čistá,"
  },
  {
   "texto": "nezřím-li jí, kde ji hledám,"
  },
  {
   "texto": "juž má nedůvěra jistá."
  },
  {
   "texto": "Jak to přijde, u ní víra,"
  },
  {
   "texto": "u mne nedůvěra vkvap?“"
  },
  {
   "texto": "Klidně přítel odpovídá:"
  },
  {
   "texto": "„Protože jsi špatný chlap!“"
  },
  {
   "texto": "Láska shořela jak tenká svíce,"
  },
  {
   "texto": "která ve průvanu zaplála,"
  },
  {
   "texto": "řek jsem jí, že necítím nic více,"
  },
  {
   "texto": "ona hloupě pro to plakala."
  },
  {
   "texto": "Zaštkála, že obecně juž ví se,"
  },
  {
   "texto": "že jsem u jiných juž býval dareba,"
  },
  {
   "texto": "pravila, že jistě utopí se,"
  },
  {
   "texto": "že jí více žití netřeba."
  },
  {
   "texto": "Rozběhla se a já osel za ní,"
  },
  {
   "texto": "moh jsem klidně zůstat seděti,"
  },
  {
   "texto": "o utopení že ani zdání,"
  },
  {
   "texto": "moh jsem tenkráte juž věděti."
  },
  {
   "texto": "Blázny jsem si dělal z hezké děvy,"
  },
  {
   "texto": "nazpíval jsem o lásce jí mnoho,"
  },
  {
   "texto": "a když věřila v mé lživé zpěvy,"
  },
  {
   "texto": "měl jsem nevinnou svou radost z toho."
  },
  {
   "texto": "Však ti blázni, již mne těšívali,"
  },
  {
   "texto": "jsou teď starší a jsou zcela jiní,"
  },
  {
   "texto": "a že blázni lásku pochovali,"
  },
  {
   "texto": "zbláznil bych se s chutí sám už nyní."
  }
 ]
}