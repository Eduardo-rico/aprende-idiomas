 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (2 formas) con el actual en «-t» (4). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-lesetinsky-kovar",
  "titulo": "Lešetínský kovář",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "VII."
  },
  {
   "texto": "Ještě jen dále pojď,"
  },
  {
   "texto": "k lesu mne vyprovoď,"
  },
  {
   "texto": "přitul se ke mně blíž,"
  },
  {
   "texto": "Liduško má!"
  },
  {
   "texto": "Ztratíš mě za krátko,"
  },
  {
   "texto": "mé zlaté poupátko,"
  },
  {
   "texto": "najdeš až po letech,"
  },
  {
   "texto": "když pán bůh dá."
  },
  {
   "texto": "Ruku svou podej mi,"
  },
  {
   "texto": "ještě mne obejmi —"
  },
  {
   "texto": "už tebe v náručí"
  },
  {
   "texto": "nebudu brát."
  },
  {
   "texto": "Ještě dnes naposled"
  },
  {
   "texto": "slaďoučká jako med"
  },
  {
   "texto": "ústa dej zulíbat"
  },
  {
   "texto": "na tisíckrát!"
  },
  {
   "texto": "S bohem, ty údolí,"
  },
  {
   "texto": "vesničko s topoly,"
  },
  {
   "texto": "ty stará kovárno"
  },
  {
   "texto": "pod jabloní!"
  },
  {
   "texto": "Zvonil tam vesele"
  },
  {
   "texto": "do želez, ocele"
  },
  {
   "texto": "perlík můj — nikdy už"
  },
  {
   "texto": "nezazvoní!"
  },
  {
   "texto": "Krásný květ uvadne,"
  },
  {
   "texto": "s jabloně opadne,"
  },
  {
   "texto": "kde jsem tě, Liduško,"
  },
  {
   "texto": "míval tak rád."
  },
  {
   "texto": "Až vyjdou hvězdičky"
  },
  {
   "texto": "jak z oulu včeličky,"
  },
  {
   "texto": "budu kdes v cizině"
  },
  {
   "texto": "pro tebe lkát."
  },
  {
   "texto": "Po řece, po stráni"
  },
  {
   "texto": "soumrak se uklání,"
  },
  {
   "texto": "do smutku šatí se"
  },
  {
   "texto": "louka i les."
  },
  {
   "texto": "Nikdy mi nezněly,"
  },
  {
   "texto": "Lešetský kosteli,"
  },
  {
   "texto": "zvony tvé truchlivě"
  },
  {
   "texto": "tak jako dnes!"
  },
  {
   "texto": "Smutně šumí vítr"
  },
  {
   "texto": "do zelené chvoje,"
  },
  {
   "texto": "že mi s bohem dává"
  },
  {
   "texto": "potěšení moje."
  },
  {
   "texto": "Srdéčka dvě ryju"
  },
  {
   "texto": "s pláčem na kmen buku —"
  },
  {
   "texto": "a žežulka z dálí"
  },
  {
   "texto": "volá: kuku, kuku!"
  },
  {
   "texto": "Pověz, žežulinko,"
  },
  {
   "texto": "zdali v brzkém čase"
  },
  {
   "texto": "srdce tady k srdci"
  },
  {
   "texto": "přitulí se zase?"
  },
  {
   "texto": "Kdy tu opět blaze"
  },
  {
   "texto": "ruka stiskne ruku?"
  },
  {
   "texto": "A žežulka z dálí"
  },
  {
   "texto": "volá: kuku, kuku!"
  },
  {
   "texto": "Dost již, milý ptáčku!"
  },
  {
   "texto": "Roků dvou je dosti"
  },
  {
   "texto": "v hoři pro miláčka,"
  },
  {
   "texto": "v těžké toužebnosti."
  },
  {
   "texto": "Ach, ty jistě neznáš"
  },
  {
   "texto": "rozloučení muka —"
  },
  {
   "texto": "A žežulka z dálí"
  },
  {
   "texto": "kuká jen a kuká."
  },
  {
   "texto": "Léta, dlouhá léta"
  },
  {
   "texto": "čítám s těžkým vzdechem —"
  },
  {
   "texto": "dřív ta srdce v buku"
  },
  {
   "texto": "obalí se mechem."
  },
  {
   "texto": "Ustaň! Srdce v ňadrech"
  },
  {
   "texto": "žalostí mi puká —"
  },
  {
   "texto": "A žežulka z dálí"
  },
  {
   "texto": "kuká jen, ach! kuká."
  },
  {
   "texto": "Neplačte, vy modré oči,"
  },
  {
   "texto": "však se brzy vrátím k vám!"
  },
  {
   "texto": "Kam jen moje noha vkročí,"
  },
  {
   "texto": "tichý lesk váš uhlídám;"
  },
  {
   "texto": "pozdraví mne chrpou v žitě,"
  },
  {
   "texto": "jitřní hvězdou na blankytě,"
  },
  {
   "texto": "bude sílit ruce mé,"
  },
  {
   "texto": "by den celý"
  },
  {
   "texto": "kuly, hřměly"
  },
  {
   "texto": "pro ty hvězdy překrásné."
  },
  {
   "texto": "Zjasněte se, krásné líce,"
  },
  {
   "texto": "však vás brzy zlíbám zas!"
  },
  {
   "texto": "Ať mil přejdu na tisíce,"
  },
  {
   "texto": "všude uvidím jen vás;"
  },
  {
   "texto": "vzejdete mi růží v sadě"
  },
  {
   "texto": "a červánkem na západě"
  },
  {
   "texto": "posilníte ruce mé,"
  },
  {
   "texto": "by den celý"
  },
  {
   "texto": "kuly, hřměly"
  },
  {
   "texto": "pro ty růže rozkošné."
  },
  {
   "texto": "Setři slzu, ruko měkká,"
  },
  {
   "texto": "však zas brzy stiskneš mou!"
  },
  {
   "texto": "Ať nás dělí sterá řeka,"
  },
  {
   "texto": "všude spatřím krásu tvou;"
  },
  {
   "texto": "svitneš sněhem v zimním vání,"
  },
  {
   "texto": "konvalinkou v jarním tání,"
  },
  {
   "texto": "budeš sílit ruce mé,"
  },
  {
   "texto": "by den celý"
  },
  {
   "texto": "kuly, hřměly"
  },
  {
   "texto": "pro to kvítko bělostné."
  },
  {
   "texto": "Rozbalím uzlíček"
  },
  {
   "texto": "v bílém šátku,"
  },
  {
   "texto": "dám ti ten prstýnek"
  },
  {
   "texto": "na památku!"
  },
  {
   "texto": "Když se ti zaleskne,"
  },
  {
   "texto": "srdce si zasteskne"
  },
  {
   "texto": "po děvčátku."
  },
  {
   "texto": "Zlatý ten prstýnek,"
  },
  {
   "texto": "perlička v něm,"
  },
  {
   "texto": "slzu ti připomeň"
  },
  {
   "texto": "na líčku mém,"
  },
  {
   "texto": "smutnou tu perličku,"
  },
  {
   "texto": "hořkou tu slzičku"
  },
  {
   "texto": "před rozchodem."
  },
  {
   "texto": "Půjdu sem každý den"
  },
  {
   "texto": "v zelený les,"
  },
  {
   "texto": "usednu pod bukem"
  },
  {
   "texto": "na hustý vřes,"
  },
  {
   "texto": "vzpomenu, můj milý,"
  },
  {
   "texto": "jak jsme se loučili"
  },
  {
   "texto": "s žalostí dnes."
  },
  {
   "texto": "Vyhlednu z doubravy"
  },
  {
   "texto": "jak smutná laň,"
  },
  {
   "texto": "povzdechnu: Bože můj,"
  },
  {
   "texto": "chraň mi ho, chraň"
  },
  {
   "texto": "kraj světa širého,"
  },
  {
   "texto": "ať nosí měkce ho"
  },
  {
   "texto": "jak Tvoje dlaň."
  },
  {
   "texto": "Zlatý, ach! prstýnek,"
  },
  {
   "texto": "perlička v něm —"
  },
  {
   "texto": "vrať se s ním, hochu můj,"
  },
  {
   "texto": "brzičko sem!"
  },
  {
   "texto": "Jasně pak zasvítí,"
  },
  {
   "texto": "krásně se zatřpytí"
  },
  {
   "texto": "před oltářem!"
  },
  {
   "texto": "Nuže, s bohem! Není pomoci —"
  },
  {
   "texto": "Ještě chvilku jen! Mně těžko tak!"
  },
  {
   "texto": "Hvězdičky už svítí do noci —"
  },
  {
   "texto": "A má hvězda zajde v temný mrak."
  },
  {
   "texto": "Jednou z mraku jasně vyskočí."
  },
  {
   "texto": "Ještě políbení —"
  },
  {
   "texto": "Drahý můj!"
  },
  {
   "texto": "Ještě jedno — v čelo — na oči —"
  },
  {
   "texto": "s bohem buď!"
  },
  {
   "texto": "Ach s bohem, pamatuj!"
  },
  {
   "texto": "VIII."
  },
  {
   "texto": "Tak už tedy, Liduško,"
  },
  {
   "texto": "moje zlatá dceruško,"
  },
  {
   "texto": "tak jsme tedy sami spolu"
  },
  {
   "texto": "ve vsi milé, v rodném dolu."
  },
  {
   "texto": "Všichni přátelé a známí"
  },
  {
   "texto": "již se rozloučili s námi,"
  },
  {
   "texto": "opustili starý dům,"
  },
  {
   "texto": "a co zbylo ve vsi, slouží"
  },
  {
   "texto": "bídně pyšným cizincům."
  },
  {
   "texto": "I mně osidlo se ouží"
  },
  {
   "texto": "zkázonosné kolem šíje:"
  },
  {
   "texto": "kladivo mé odpočívá,"
  },
  {
   "texto": "v pusté výhni pavouk tyje,"
  },
  {
   "texto": "nouze hrozebně se dívá"
  },
  {
   "texto": "v jizbu naši ubohou."
  },
  {
   "texto": "Ještě rolí žatva zbývá —"
  },
  {
   "texto": "ale zdaž ty pomohou?!"
  },
  {
   "texto": "Odevšad se na nás tlačí,"
  },
  {
   "texto": "šklebí potupně a mračí"
  },
  {
   "texto": "cizota; jim ku posměchu"
  },
  {
   "texto": "chatrč tato starosvětská,"
  },
  {
   "texto": "sivá střecha v rouně mechu,"
  },
  {
   "texto": "kroj a správa žití všecka,"
  },
  {
   "texto": "i to kouzlo tvého zpěvu —"
  },
  {
   "texto": "vše jim k potupě a hněvu."
  },
  {
   "texto": "S hněvem rodné naše zvuky"
  },
  {
   "texto": "slyší z davů, jejichž ruky"
  },
  {
   "texto": "potřebují k robotě."
  },
  {
   "texto": "Za to dítkám jejich ruší"
  },
  {
   "texto": "odkaz dědů v útlé duši,"
  },
  {
   "texto": "ubohé té drobotě!"
  },
  {
   "texto": "se rtů loupí mluvu ryzí,"
  },
  {
   "texto": "v ústka nutí hlahol cizí."
  },
  {
   "texto": "Zdaliž Otec v nebes výši,"
  },
  {
   "texto": "pod nímž klidně očka mhouří"
  },
  {
   "texto": "ptačí mlád’ ve stébel skrýši,"
  },
  {
   "texto": "na vysoké sosně v bouři,"
  },
  {
   "texto": "který různou píseň vkládá"
  },
  {
   "texto": "v hrdélka té vzdušné chasy"
  },
  {
   "texto": "a vděk pestrý světu spřádá"
  },
  {
   "texto": "sterými kol květy, hlasy —:"
  },
  {
   "texto": "Zda Bůh klidně může zříti,"
  },
  {
   "texto": "jak tu dravčí spáry derou"
  },
  {
   "texto": "dětských myslí něžné kvítí,"
  },
  {
   "texto": "jak mu rosu, vůni berou,"
  },
  {
   "texto": "již On vdechl v duší kalich,"
  },
  {
   "texto": "do poupátka rtíků malých?!"
  },
  {
   "texto": "Odebral se z tiché fary"
  },
  {
   "texto": "na věčnost kněz dobrý, starý,"
  },
  {
   "texto": "a teď odrodil se nám"
  },
  {
   "texto": "i ten starý šedý chrám."
  },
  {
   "texto": "Cizí řeč tam ucho slyší"
  },
  {
   "texto": "s kazatelny, z žáčků řady,"
  },
  {
   "texto": "z lavic, kůru — odevšady"
  },
  {
   "texto": "cizota jen mrazem čiší;"
  },
  {
   "texto": "zdá se, že i z varhan šumí"
  },
  {
   "texto": "hra, jíž srdce nerozumí,"
  },
  {
   "texto": "že své ryzí, tklivé tóny"
  },
  {
   "texto": "ztratily též staré zvony."
  },
  {
   "texto": "Zdá se, že ti dávní páni,"
  },
  {
   "texto": "na náhrobcích vytesaní,"
  },
  {
   "texto": "v sešlé tváři hněvem planou,"
  },
  {
   "texto": "a že svatý Václav stranou"
  },
  {
   "texto": "poukrývá smutnou líci"
  },
  {
   "texto": "do korouhve, pod orlici."
  },
  {
   "texto": "Krev se mi tam v čelo žene —"
  },
  {
   "texto": "přes ty práhy odcizené"
  },
  {
   "texto": "nevšinu již nikdy nohu;"
  },
  {
   "texto": "raděj’ pod tím starým krovem"
  },
  {
   "texto": "pomodlím se svému bohu"
  },
  {
   "texto": "od srdce svým rodným slovem!"
  },
  {
   "texto": "Celou ves již obetkal"
  },
  {
   "texto": "svojí sítí pavouk cizí —"
  },
  {
   "texto": "marně prosil jsem i lál —"
  },
  {
   "texto": "všechny lapil v zlaté přízi,"
  },
  {
   "texto": "již kraj celý zove svým."
  },
  {
   "texto": "Jenom já té dědiny"
  },
  {
   "texto": "troska chudičká zde tkvím"
  },
  {
   "texto": "a chci zůstat do posledu"
  },
  {
   "texto": "památník co jediný"
  },
  {
   "texto": "zhynulého ducha dědů."
  },
  {
   "texto": "Aspoň hrstku rodné země"
  },
  {
   "texto": "chci z těch jícnů vytrhnout!"
  },
  {
   "texto": "Neopustím drahý kout,"
  },
  {
   "texto": "jenž tak mnoho mluví ke mně,"
  },
  {
   "texto": "luka zprahlá, zřídlé bory,"
  },
  {
   "texto": "plné milých vzpomínek,"
  },
  {
   "texto": "řeku, role, stráně, hory,"
  },
  {
   "texto": "kde jsem prožil celý věk."
  },
  {
   "texto": "Nech tu aspoň dvojí duši"
  },
  {
   "texto": "kraj ten sirý šeptá, šumí"
  },
  {
   "texto": "svoje zkazky v cizí hluši,"
  },
  {
   "texto": "jež té řeči nerozumí."
  },
  {
   "texto": "A byť nebyla tak spjata"
  },
  {
   "texto": "duše s nimi — lesku zlata"
  },
  {
   "texto": "nepoddám se; proti chtíči"
  },
  {
   "texto": "jiného má vůle týčí"
  },
  {
   "texto": "hrdou hlavu s pevnou lebí."
  },
  {
   "texto": "Splním, co jsem přisáh’ nebi."
  },
  {
   "texto": "Kovárna s tou chýší chudou,"
  },
  {
   "texto": "země píď, již zovu svojí,"
  },
  {
   "texto": "jak ostrůvek trčet budou"
  },
  {
   "texto": "dále cizím ve příboji."
  },
  {
   "texto": "Třeba s trochou kůrky suché"
  },
  {
   "texto": "budeme tu po svém žíti,"
  },
  {
   "texto": "bude zvuk náš rodný zníti"
  },
  {
   "texto": "v nepřátelské vlny hluché."
  },
  {
   "texto": "A nechť jim všem ku posměchu,"
  },
  {
   "texto": "mně tu sladce pro útěchu"
  },
  {
   "texto": "písněmi zvoň, Liduško,"
  },
  {
   "texto": "moje zlatá dceruško!"
  },
  {
   "texto": "IX."
  },
  {
   "texto": "Louky, háje už se stměly,"
  },
  {
   "texto": "měsíček, můj tichý druh,"
  },
  {
   "texto": "pouští z oulu zlaté včely"
  },
  {
   "texto": "na nebeský modrý luh;"
  },
  {
   "texto": "jedna vyletěla tady…"
  },
  {
   "texto": "druhá tam… a třetí tam…"
  },
  {
   "texto": "už jich svítí celé řady,"
  },
  {
   "texto": "že je těžko spočítám,"
  },
  {
   "texto": "a teď, hoj!"
  },
  {
   "texto": "celé nebe jeden třpytný roj."
  },
  {
   "texto": "Tolik je vás, oček zlatých,"
  },
  {
   "texto": "přehlížíte celou zem;"
  },
  {
   "texto": "které z vás mi, světel svatých,"
  },
  {
   "texto": "poví o miláčku mém?"
  },
  {
   "texto": "Zda k vám, hvězdy, s tichým steskem"
  },
  {
   "texto": "hledí mlhou vzpomínek?"
  },
  {
   "texto": "Či mu zraky slibným leskem"
  },
  {
   "texto": "jasní zlatý prstýnek?"
  },
  {
   "texto": "Či mu sen"
  },
  {
   "texto": "návratu přináší šťastný den?"
  },
  {
   "texto": "Potěšte ho svojí září,"
  },
  {
   "texto": "povězte mu, hvězdičky,"
  },
  {
   "texto": "že tu smutná s bledých tváří"
  },
  {
   "texto": "stírám horké slzičky,"
  },
  {
   "texto": "že z komůrky osamělá"
  },
  {
   "texto": "hledím na horu a les,"
  },
  {
   "texto": "tam, kde širá dálka stmělá"
  },
  {
   "texto": "miláčka mi kryje kdes,"
  },
  {
   "texto": "tam, ach! tam,"
  },
  {
   "texto": "kde své blaho, štěstí všechno mám."
  },
  {
   "texto": "X."
  },
  {
   "texto": "(Daleko za horami.)"
  },
  {
   "texto": "Lešetínské zvony slyšet valné hony,"
  },
  {
   "texto": "přes pole, háje zní ten svatý hlas,"
  },
  {
   "texto": "hlaholí tak jasně, hlaholí tak krásně —"
  },
  {
   "texto": "Lešetínské zvony rád bych slyšel zas!"
  },
  {
   "texto": "Chaloupka tam sivá, shrbená a křivá"
  },
  {
   "texto": "pod mechem a slamou, chudým krovem svým,"
  },
  {
   "texto": "hejno dětí kryla, kuřátka jak čilá"
  },
  {
   "texto": "ukrývá si kvočna křídlem šedivým."
  },
  {
   "texto": "Všichni pod večerem na zápraží šerém"
  },
  {
   "texto": "sedali jsme s matkou, otcem pospolu,"
  },
  {
   "texto": "ve blaženém snění k sobě přituleni"
  },
  {
   "texto": "při slavících zvonů jasném hlaholu."
  },
  {
   "texto": "Dětské moje čelo nejraděj’ tu dlelo"
  },
  {
   "texto": "na rameně sestry, nejmilejší všech,"
  },
  {
   "texto": "v její duši bájí pučelo jak v máji"
  },
  {
   "texto": "zlatoušků se shlíží v jasných pramenech."
  },
  {
   "texto": "Když ty zvony zněly, tu jsme spolu jeli"
  },
  {
   "texto": "v oblakovém voze v divný, krásný svět,"
  },
  {
   "texto": "kde jsou zámky zlaté, princezny v nich jaté,"
  },
  {
   "texto": "k tanci lesním ženkám zvoní zvonků květ."
  },
  {
   "texto": "Truchlily jste se mnou, zvony, hudbou temnou,"
  },
  {
   "texto": "když jsem otci lůžko v černé zemi stlal,"
  },
  {
   "texto": "a když stlali k němu srdci mateřskému,"
  },
  {
   "texto": "se sirotkem smutným hlas váš naříkal."
  },
  {
   "texto": "Milé sestry není, bratři rozptýleni,"
  },
  {
   "texto": "jak podzimní vítr listí rozsívá,"
  },
  {
   "texto": "kopřivy jen husté kryjou místo pusté,"
  },
  {
   "texto": "kde chaloupka naše stála šedivá."
  },
  {
   "texto": "Mně však jinde štěstí počalo zas kvésti,"
  },
  {
   "texto": "rodná ves mi jiné hnízdo ustlala;"
  },
  {
   "texto": "vesele jsem koval, v srdci lásku choval,"
  },
  {
   "texto": "kryla se jak v houští vonná fiala."
  },
  {
   "texto": "Kladiv rána ztichla, prsa blahem vzdychla,"
  },
  {
   "texto": "když mě k milé volal večerní váš zvuk."
  },
  {
   "texto": "Smutně však to znění lkalo při loučení,"
  },
  {
   "texto": "když jsme srdéčka dvě ryli v šedý buk."
  },
  {
   "texto": "Lešetínské zvony slyšet valné hony,"
  },
  {
   "texto": "přes pole a háje zní ten svatý hlas."
  },
  {
   "texto": "Srdce touhou hyne, z prsou vzdech se vine:"
  },
  {
   "texto": "Kdy vás uslyším, ach! milé zvony, zas?!"
  }
 ]
}