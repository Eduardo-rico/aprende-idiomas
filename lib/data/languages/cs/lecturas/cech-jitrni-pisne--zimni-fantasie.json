 "parrafos": [
  {
   "texto": "Letím, letím sanicí"
  },
  {
   "texto": "mlhami a vánicí,"
  },
  {
   "texto": "ze sna slyším frkot koní,"
  },
  {
   "texto": "slyším saní skříp a šum"
  },
  {
   "texto": "a rolničky lehké zvoní"
  },
  {
   "texto": "kolébavkou do mých dum."
  },
  {
   "texto": "Ó jak milo mořem sněhů"
  },
  {
   "texto": "beze břehů"
  },
  {
   "texto": "v závod s vichrem do neznáma"
  },
  {
   "texto": "uháněti v dálku tak!"
  },
  {
   "texto": "Nechť se sype v líce, čelo"
  },
  {
   "texto": "chladné bělo,"
  },
  {
   "texto": "teploučko je v duši klidné,"
  },
  {
   "texto": "zavírá se tiše zrak."
  },
  {
   "texto": "V jasné zvuky dětských hlasů"
  },
  {
   "texto": "z dávných časů"
  },
  {
   "texto": "cinkot rolniček se mění,"
  },
  {
   "texto": "v dívčí šepot, zpěv a smích"
  },
  {
   "texto": "a páv zlatý z bájných luhů"
  },
  {
   "texto": "v jasnou duhu"
  },
  {
   "texto": "před oči nám rozestírá"
  },
  {
   "texto": "péra lesků báječných."
  },
  {
   "texto": "Mořem bílým beze břehu"
  },
  {
   "texto": "do mlhy a do sněhu"
  },
  {
   "texto": "vichrem letí povoz ručí,"
  },
  {
   "texto": "že až prsa úží strach,"
  },
  {
   "texto": "a rolničky divě hlučí"
  },
  {
   "texto": "jako v bouři na poplach."
  },
  {
   "texto": "Co se stalo? Běda, koně"
  },
  {
   "texto": "v divém honě"
  },
  {
   "texto": "zplašili se - ten tam vozka -"
  },
  {
   "texto": "jiný vhoup’ se na saně,"
  },
  {
   "texto": "mužík starý s vousem dlouhým,"
  },
  {
   "texto": "sněhem pouhým,"
  },
  {
   "texto": "sobolinu na kadeřích,"
  },
  {
   "texto": "na obšitém kaftaně,"
  },
  {
   "texto": "metá na mne divné jasy"
  },
  {
   "texto": "z šedé řasy,"
  },
  {
   "texto": "divným slovem oře k letu"
  },
  {
   "texto": "pobádá - Než, jaký div!"
  },
  {
   "texto": "Místo dvou tři koně běží"
  },
  {
   "texto": "pod otěží,"
  },
  {
   "texto": "z podkov jejich jiskry srší,"
  },
  {
   "texto": "vichrem vlajou sněhy hřív"
  },
  {
   "texto": "a nad nimi pestrou duhu"
  },
  {
   "texto": "v polokruhu"
  },
  {
   "texto": "klene jařmo malované,"
  },
  {
   "texto": "na němž visí zlatý zvon,"
  },
  {
   "texto": "jako v bouři sebou zmítá,"
  },
  {
   "texto": "sem tam lítá,"
  },
  {
   "texto": "hudbou hlasnou, divukrásnou"
  },
  {
   "texto": "provází ten běsný hon."
  },
  {
   "texto": "Kam to letím vichřicí"
  },
  {
   "texto": "po závěji jiskřící?"
  },
  {
   "texto": "Sen-li před mé oči staví"
  },
  {
   "texto": "povětrný děj?"
  },
  {
   "texto": "Či mne svými kouzly baví"
  },
  {
   "texto": "mužík čaroděj?"
  },
  {
   "texto": "Neznámý kraj šíro stele"
  },
  {
   "texto": "sněhy skvělé,"
  },
  {
   "texto": "v báječném se koupá světle"
  },
  {
   "texto": "jako v záři severu,"
  },
  {
   "texto": "skvoucí kolos v jeho středu,"
  },
  {
   "texto": "zámek z ledu,"
  },
  {
   "texto": "velkolepých budov týčí"
  },
  {
   "texto": "nevídanou nádheru."
  },
  {
   "texto": "Všechno led je křišťálový:"
  },
  {
   "texto": "stěny, krovy,"
  },
  {
   "texto": "obrovité divné báně,"
  },
  {
   "texto": "kol nich bání menší tlum,"
  },
  {
   "texto": "z ledu kříž jim trojramenný"
  },
  {
   "texto": "nad temeny"
  },
  {
   "texto": "jako zdoba brillantová"
  },
  {
   "texto": "pyšnětrčí k nebesům."
  },
  {
   "texto": "Démant jeden zdá se býti,"
  },
  {
   "texto": "stříbrem svítí,"
  },
  {
   "texto": "hoře z perel podobá se"
  },
  {
   "texto": "tato stavba čarovná -"
  },
  {
   "texto": "jistě na ledovém trůně"
  },
  {
   "texto": "v jejím lůně"
  },
  {
   "texto": "s hermelínem sněžným sedí"
  },
  {
   "texto": "sama zimy královna!"
  },
  {
   "texto": "Ký to palác? Jaký kraj?"
  },
  {
   "texto": "Mlčí divný vozataj."
  },
  {
   "texto": "Zdržel oře v divém cvále,"
  },
  {
   "texto": "skočil na práh ledový,"
  },
  {
   "texto": "kynul, bych s ním kráčel dále"
  },
  {
   "texto": "do zářící budovy."
  },
  {
   "texto": "Sloupořadí, síně, koby,"
  },
  {
   "texto": "stropů zdoby,"
  },
  {
   "texto": "všechno z nejčistšího ledu,"
  },
  {
   "texto": "všechno samý lesk a třpyt"
  },
  {
   "texto": "a na křeslech, na podlaze"
  },
  {
   "texto": "blíž a záze"
  },
  {
   "texto": "komonstvo zříš pestroskvoucí,"
  },
  {
   "texto": "pohroužené v divný klid."
  },
  {
   "texto": "Sedí, leží bez pohnutí,"
  },
  {
   "texto": "ňader dmutí"
  },
  {
   "texto": "jenom svědčí o životě,"
  },
  {
   "texto": "zachvívá se ve snu ret,"
  },
  {
   "texto": "tu tam jen se řasa kmitne,"
  },
  {
   "texto": "ruka chytne"
  },
  {
   "texto": "jilec meče v pasu drahém,"
  },
  {
   "texto": "a zas líně padá zpět."
  },
  {
   "texto": "Sarmantské zříš tváře tady,"
  },
  {
   "texto": "rusé brady"
  },
  {
   "texto": "neb zas kníry dlouhé, temné,"
  },
  {
   "texto": "slovanský tu předčí kroj;"
  },
  {
   "texto": "ale mezi ně se mísí"
  },
  {
   "texto": "jiné rysy,"
  },
  {
   "texto": "severních i jižních končin"
  },
  {
   "texto": "různá tvář i šat i zbroj."
  },
  {
   "texto": "Tu hle! Tatar v pestrém hávu"
  },
  {
   "texto": "kloní hlavu,"
  },
  {
   "texto": "tamo Čerkes pod přilbicí,"
  },
  {
   "texto": "s lesklým kovem pancíře,"
  },
  {
   "texto": "zde muž z luhů Kalevaly,"
  },
  {
   "texto": "v jižní dáli,"
  },
  {
   "texto": "tam host snědý pod turbanem,"
  },
  {
   "texto": "syn tu mrazné Sibiře."
  },
  {
   "texto": "Ale v nejskvostnější síni"
  },
  {
   "texto": "sličná kníní"
  },
  {
   "texto": "v sobolině, hranostaji"
  },
  {
   "texto": "odpočívá na trůně,"
  },
  {
   "texto": "s něhož orel v čisté sloni"
  },
  {
   "texto": "křídla kloní,"
  },
  {
   "texto": "za oporu slouže skráni"
  },
  {
   "texto": "v nejvzácnější koruně."
  },
  {
   "texto": "Na mladistvé tváři leží"
  },
  {
   "texto": "ruměn svěží,"
  },
  {
   "texto": "krásná ňadra dmou se jemně,"
  },
  {
   "texto": "víčka sklání spánku tíž -"
  },
  {
   "texto": "v záři skvostů kněžna dřímá,"
  },
  {
   "texto": "ve snu jímá"
  },
  {
   "texto": "žezlo lilii co skvoucí,"
  },
  {
   "texto": "která zdobí s hvězdou kříž."
  },
  {
   "texto": "Oddechla teď ze hluboka,"
  },
  {
   "texto": "záře oka"
  },
  {
   "texto": "pod řasou se pozableskla,"
  },
  {
   "texto": "pevněj berlu jala dlaň,"
  },
  {
   "texto": "mocněji se prsa dmula,"
  },
  {
   "texto": "rtoma hnula,"
  },
  {
   "texto": "leb se vypjal; však již zase"
  },
  {
   "texto": "tíha spánku lehla naň."
  },
  {
   "texto": "Kdo ta kněžna usnulá?"
  },
  {
   "texto": "kol ta četa ztrnulá?"
  },
  {
   "texto": "Zda je mrazu pouto jímá?"
  },
  {
   "texto": "Či to zámek zakletý,"
  },
  {
   "texto": "princezna kde báje dřímá"
  },
  {
   "texto": "s komonstvem sen stoletý?"
  },
  {
   "texto": "Odpovídá vůdce sivý:"
  },
  {
   "texto": "Zloboh divý"
  },
  {
   "texto": "zhoubu přisáh’ velitelce"
  },
  {
   "texto": "širodálných světa stran,"
  },
  {
   "texto": "rozplašil rod její různo,"
  },
  {
   "texto": "bil jej hrůzno"
  },
  {
   "texto": "nesvorností, zaslepením,"
  },
  {
   "texto": "deštěm nepřátelských ran."
  },
  {
   "texto": "Její dcery mečem zloby"
  },
  {
   "texto": "klesly v hroby,"
  },
  {
   "texto": "jiné již již skonávají"
  },
  {
   "texto": "pod cizáckým čepelem,"
  },
  {
   "texto": "jiné vlekou u nevoli"
  },
  {
   "texto": "život holý,"
  },
  {
   "texto": "bídu, trýzeň, ponížení"
  },
  {
   "texto": "mají denním údělem."
  },
  {
   "texto": "Jenom jedné škůdce starý"
  },
  {
   "texto": "svýmy spáry"
  },
  {
   "texto": "nemoh urvat žezlo mocné,"
  },
  {
   "texto": "prestol rozbít ledový,"
  },
  {
   "texto": "však zlým kouzlem seslal na ni"
  },
  {
   "texto": "těžké spaní,"
  },
  {
   "texto": "sepjal ji snu mrákotného"
  },
  {
   "texto": "tajemnými okovy."
  },
  {
   "texto": "Ona snila o pokladech"
  },
  {
   "texto": "v indských sadech,"
  },
  {
   "texto": "o byzantském trůnu dávném,"
  },
  {
   "texto": "o vavřínu Hellady,"
  },
  {
   "texto": "za výkřik srdce rvoucího"
  },
  {
   "texto": "sester mroucích,"
  },
  {
   "texto": "zatímco jí vlastní berlu"
  },
  {
   "texto": "rvaly vrahův úklady."
  },
  {
   "texto": "Však ji za to, nechať snila,"
  },
  {
   "texto": "rostla síla,"
  },
  {
   "texto": "zmohutněly k činům velkým"
  },
  {
   "texto": "páže krásné obryně"
  },
  {
   "texto": "a duch strážný z její hrudi"
  },
  {
   "texto": "kouzlo pudí,"
  },
  {
   "texto": "prociťujíc řasou knitá,"
  },
  {
   "texto": "chvátí žezlo na klíně."
  },
  {
   "texto": "Brzy prchnou všechny clony,"
  },
  {
   "texto": "zahřmí zvony"
  },
  {
   "texto": "nad obryní probuzenou"
  },
  {
   "texto": "slavným hymnem vzkříšení:"
  },
  {
   "texto": "pak se vypne v síle hrůzné,"
  },
  {
   "texto": "kráse luzné"
  },
  {
   "texto": "a led kolem v jarní kvítí,"
  },
  {
   "texto": "sníh se v rosu promění."
  },
  {
   "texto": "Rozprchnou se před ní vrazi,"
  },
  {
   "texto": "v prach je srazí,"
  },
  {
   "texto": "bědným sestrám z jejich síly"
  },
  {
   "texto": "nové štěstí vypučí"
  },
  {
   "texto": "a máť Sláva prosta stesku,"
  },
  {
   "texto": "v jasném lesku"
  },
  {
   "texto": "obejme zas blahé dítky"
  },
  {
   "texto": "silnou, strážnou náručí."
  },
  {
   "texto": "Ztichl, kolem ani slech,"
  },
  {
   "texto": "slyšeti jen spáčů dech."
  },
  {
   "texto": "Náhle zajásaly shůry"
  },
  {
   "texto": "z ledovité kupole"
  },
  {
   "texto": "zvonů skvoucích valné kůry"
  },
  {
   "texto": "ve hřímavém hlahole."
  },
  {
   "texto": "A touž chvílí kněžna spící"
  },
  {
   "texto": "vznesla líci,"
  },
  {
   "texto": "otevřela krásné oči,"
  },
  {
   "texto": "omlžené ještě snem,"
  },
  {
   "texto": "však již prchá v záři denní"
  },
  {
   "texto": "stopa snění,"
  },
  {
   "texto": "oko svítí bohatýrským"
  },
  {
   "texto": "velké dumy plamenem."
  },
  {
   "texto": "Vstává kněžna na prestolu,"
  },
  {
   "texto": "kráčí dolů,"
  },
  {
   "texto": "do daleka směle zírá,"
  },
  {
   "texto": "vznáší žezlo bleskutné"
  },
  {
   "texto": "a kol kolem shrnuje se"
  },
  {
   "texto": "v šumném plese"
  },
  {
   "texto": "příboj davů probuzených"
  },
  {
   "texto": "k velitelce mohutné."
  },
  {
   "texto": "Před velebnou její tváří,"
  },
  {
   "texto": "slunnou září"
  },
  {
   "texto": "v nadšení mi vlhnou zraky,"
  },
  {
   "texto": "tělo skláním bezděky;"
  },
  {
   "texto": "cítím, že nám vzchází spása,"
  },
  {
   "texto": "lid můj střásá"
  },
  {
   "texto": "s páže velkých činů chtivé"
  },
  {
   "texto": "okov rabství odvěký."
  },
  {
   "texto": "Led kol taje, líbá skráni"
  },
  {
   "texto": "jarní vání,"
  },
  {
   "texto": "květů vonných celé moře"
  },
  {
   "texto": "kypí v luzném rašení"
  },
  {
   "texto": "a v tu vesnu pějí s hůry"
  },
  {
   "texto": "zvonů kůry,"
  },
  {
   "texto": "do širého světa hřmíce"
  },
  {
   "texto": "slavnou hymnu vzkříšení."
  },
  {
   "texto": "Zvolna mizí krásný zjev,"
  },
  {
   "texto": "zvolna tichne zvonů zpěv,"
  },
  {
   "texto": "kolem známé sněžné pláně"
  },
  {
   "texto": "s povědomou vesničkou,"
  },
  {
   "texto": "k domovu mě nesou sáně,"
  },
  {
   "texto": "zápřež zvoní rolničkou."
  },
  {
   "texto": "Ach, vše bylo přelud pouhý"
  },
  {
   "texto": "marné touhy,"
  },
  {
   "texto": "nad nímž jenom usmívá se"
  },
  {
   "texto": "chladný rozum střízlivý,"
  },
  {
   "texto": "a přec v duši plane dále,"
  },
  {
   "texto": "kyne stále"
  },
  {
   "texto": "z šerých mlžin přítomnosti"
  },
  {
   "texto": "fantom onen zářivý."
  },
  {
   "texto": "A jak duch naň toužně zírá,"
  },
  {
   "texto": "pevná víra"
  },
  {
   "texto": "naplňuje nitro moje,"
  },
  {
   "texto": "srdce těchou proniká,"
  },
  {
   "texto": "že to vidmo přece není"
  },
  {
   "texto": "pouhé snění,"
  },
  {
   "texto": "že již zdáli Slávě kyne"
  },
  {
   "texto": "chvíle ona veliká."
  },
  {
   "texto": "Mnohé ještě přejdou boje,"
  },
  {
   "texto": "strastí roje,"
  },
  {
   "texto": "a snad budu dávno spáti"
  },
  {
   "texto": "zapomenout věčný sen -"
  },
  {
   "texto": "však den jednou vzejde spasný,"
  },
  {
   "texto": "kdy sen jasný,"
  },
  {
   "texto": "nejkrásnější mého žití"
  },
  {
   "texto": "slavně bude vyplněn."
  }
 ]
}