  {
   "texto": "Z svých písní trůn Ti udělám"
  },
  {
   "texto": "za velkých pěvců příkladem,"
  },
  {
   "texto": "za žezlo Ti své srdce dám"
  },
  {
   "texto": "a slávu svou za diadem."
  },
  {
   "texto": "Za zákon lásku provolám,"
  },
  {
   "texto": "svou písní oslavím Tvůj den,"
  },
  {
   "texto": "v Tvou duši vleju lásky slasť,"
  },
  {
   "texto": "a sladkou touhu ve Tvůj sen."
  },
  {
   "texto": "Ptáčků Ti písně přivolám,"
  },
  {
   "texto": "máj nastele Ti k nohám květ,"
  },
  {
   "texto": "a nebes hvězdám rozkaz dám"
  },
  {
   "texto": "a v nebe změním celý svět."
  },
  {
   "texto": "A srdce všech Ti podmaním,"
  },
  {
   "texto": "ráj vyzpívám Ti z hrobu zpět,"
  },
  {
   "texto": "a královnou Tě provolám,"
  },
  {
   "texto": "kam širošírý sahá svět."
  },
  {
   "texto": "Nediv se, jestli uslyšíš"
  },
  {
   "texto": "o sobě ptáčky zpívat;"
  },
  {
   "texto": "onehdy přišli pod večír"
  },
  {
   "texto": "se k oknu na mne dívat."
  },
  {
   "texto": "A přišli opět, přišli zas"
  },
  {
   "texto": "co k známému již druhu,"
  },
  {
   "texto": "neb jsem jak oni svoboden"
  },
  {
   "texto": "a doma v jejich kruhu."
  },
  {
   "texto": "Já písně zpíval o Tobě —"
  },
  {
   "texto": "ty byly plny lásky,"
  },
  {
   "texto": "a podle nich si ladili"
  },
  {
   "texto": "i ptáčkové své hlásky."
  },
  {
   "texto": "Onehdy pak sem navštívil"
  },
  {
   "texto": "zas já ty ptáčky v háji —"
  },
  {
   "texto": "tu sem se věru podivil,"
  },
  {
   "texto": "jak ty mé písně znají."
  },
  {
   "texto": "Ten boží svět tak daleký"
  },
  {
   "texto": "a stálého tak málo;"
  },
  {
   "texto": "bolestí v světě na tisíc"
  },
  {
   "texto": "a radostí tak málo."
  },
  {
   "texto": "To srdce za sto bolestí"
  },
  {
   "texto": "si jednu radosť koupí —"
  },
  {
   "texto": "a přec to srdce, bože můj,"
  },
  {
   "texto": "pro lásku vše podstoupí."
  },
  {
   "texto": "Hej, jaká radost v kole"
  },
  {
   "texto": "a v náručí mít holku!"
  },
  {
   "texto": "Pojď, bledý hochu, tančit -"
  },
  {
   "texto": "já dám ti zahrát polku."
  },
  {
   "texto": "Aj, bledý hoch se zachvěl,"
  },
  {
   "texto": "jak mráz by mu vjel v oudy,"
  },
  {
   "texto": "a po těch bledých tvářích"
  },
  {
   "texto": "mu tekly slzí proudy."
  },
  {
   "texto": "Vy malí, drobní ptáčkové,"
  },
  {
   "texto": "vy zpěvosniví spáči,"
  },
  {
   "texto": "zda vzpomene si který z vás"
  },
  {
   "texto": "že já umírám v pláči?"
  },
  {
   "texto": "Měsíčku, postůj na nebi,"
  },
  {
   "texto": "bych potěšil se v tobě;"
  },
  {
   "texto": "mé lásky žár je vychladlý"
  },
  {
   "texto": "my hodíme se k sobě."
  },
  {
   "texto": "Poslední plamen usíná,"
  },
  {
   "texto": "mně zbývají jen slova:"
  },
  {
   "texto": "a přec bych vše zas rozdmychal"
  },
  {
   "texto": "bych nešťastným byl znova."
  }
