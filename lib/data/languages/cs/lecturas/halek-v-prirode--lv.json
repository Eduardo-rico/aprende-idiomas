 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LV."
  },
  {
   "texto": "Takť člověk ve svém blouznění:"
  },
  {
   "texto": "i přírodu klad’ mezi klaté,"
  },
  {
   "texto": "a není v světě bláznovství,"
  },
  {
   "texto": "pro něž by nenašel si svaté."
  },
  {
   "texto": "A taký ve svém znuzení:"
  },
  {
   "texto": "žeť místo hvězd má nebe světy,"
  },
  {
   "texto": "duch volnost místo poroby —"
  },
  {
   "texto": "zem, nebe, člověk jsou mu klety."
  },
  {
   "texto": "A nyní už mu zbývá jen,"
  },
  {
   "texto": "by ještě boha kletbou srážel,"
  },
  {
   "texto": "že stvořiti směl člověka,"
  },
  {
   "texto": "jenž v let se k němu opovážel."
  },
  {
   "texto": "Však, pane bože, neměj strach:"
  },
  {
   "texto": "našli se lidé božské síly,"
  },
  {
   "texto": "že kletbu a smrt hranice"
  },
  {
   "texto": "s úsměvem písně podstoupili."
  },
  {
   "texto": "Jak směšný, bídně horlivý,"
  },
  {
   "texto": "kdo dni chceš ucpat světlo,"
  },
  {
   "texto": "kdo jara proud chceš zadržet,"
  },
  {
   "texto": "by v růže nerozkvetlo."
  },
  {
   "texto": "A kdož by řek’, že lidé jsou,"
  },
  {
   "texto": "jenž tak se v mrzkost halí,"
  },
  {
   "texto": "že místo světa krásného"
  },
  {
   "texto": "chtí svět mít zakrsalý!"
  },
  {
   "texto": "Ba kdož by řek’, že lidé to,"
  },
  {
   "texto": "jenž v pouta svět konejší,"
  },
  {
   "texto": "by člověk místo v svobodě"
  },
  {
   "texto": "byl na něm nejbídnější!"
  },
  {
   "texto": "Však marně sžírá zloby rez,"
  },
  {
   "texto": "co věčným bohem seto:"
  },
  {
   "texto": "máť svoboda již osení,"
  },
  {
   "texto": "a bude mít své léto."
  },
  {
   "texto": "Pravda! Pravda! Velké moře —"
  },
  {
   "texto": "a já kvítkem v záhonce;"
  },
  {
   "texto": "mohu pít jen drobné kapky,"
  },
  {
   "texto": "a to moře bez konce."
  },
  {
   "texto": "Pravda! Pravda! Nebe širé —"
  },
  {
   "texto": "a já pták pod oblaky;"
  },
  {
   "texto": "lítám, co mi křídlo stačí,"
  },
  {
   "texto": "ale prostor daleký."
  },
  {
   "texto": "Pravda! Vesmír beze hrází —"
  },
  {
   "texto": "a mně žít co člověku;"
  },
  {
   "texto": "dýchám jej sic každým dechem,"
  },
  {
   "texto": "ale vesmír bez věků."
  },
  {
   "texto": "To ještě není přírodou,"
  },
  {
   "texto": "když známe cos dle jmen a dat,"
  },
  {
   "texto": "jdeť ona výš než s oblohou,"
  },
  {
   "texto": "nad moře hlubší tisíckrát."
  },
  {
   "texto": "Jeť ona světů plodná slast,"
  },
  {
   "texto": "zpěv mládí, vroucnost bez věku,"
  },
  {
   "texto": "mateřsky-ženská touhy část,"
  },
  {
   "texto": "až dojde těla v člověku."
  },
  {
   "texto": "Až lidských ňader chvělá báň,"
  },
  {
   "texto": "ta blaha báň i s úrazem,"
  },
  {
   "texto": "ji pohostila ve svou schráň"
  },
  {
   "texto": "a stala se jí výrazem."
  },
  {
   "texto": "A není ona jenom list,"
  },
  {
   "texto": "jenž v podzim prchá bezpočet,"
  },
  {
   "texto": "neb kdo ji z prsou nezná číst,"
  },
  {
   "texto": "ten v světě jí se nedočet’."
  },
  {
   "texto": "Mám v povržení každou píseň,"
  },
  {
   "texto": "jež mrav i šat má s lokajem,"
  },
  {
   "texto": "by velmožům se lípla k patám,"
  },
  {
   "texto": "a choutkám byla v pronájem."
  },
  {
   "texto": "Já opovrhám každým pěvcem,"
  },
  {
   "texto": "jenž sebe k vozu zapřáhá,"
  },
  {
   "texto": "by pán se pyšnil na kozlíku,"
  },
  {
   "texto": "kdy on se koňsky namáhá."
  },
  {
   "texto": "Ba při sám bůh, toť zvrhlá píseň,"
  },
  {
   "texto": "jež nemá jiných předmětů,"
  },
  {
   "texto": "leč hlavy prázné, srdce prázné,"
  },
  {
   "texto": "a přec se pouští do letu."
  },
  {
   "texto": "A při sám bůh, ten bídný pěvec"
  },
  {
   "texto": "víc nezaslouží na vzájem,"
  },
  {
   "texto": "leč aby těm, jež opěvoval,"
  },
  {
   "texto": "byl do své smrti lokajem."
  }
 ]
}