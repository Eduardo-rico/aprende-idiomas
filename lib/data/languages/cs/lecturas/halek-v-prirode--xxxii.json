 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XXXII."
  },
  {
   "texto": "Noc bdí a mrká, potok zurčí,"
  },
  {
   "texto": "a ptáček dřímá ve chládku —"
  },
  {
   "texto": "„Matičko přírodo, jsem básník,"
  },
  {
   "texto": "ó povídej mi pohádku!“"
  },
  {
   "texto": "„Mé dítě, nemohu; jen jednou"
  },
  {
   "texto": "jsem musila ji povídat,"
  },
  {
   "texto": "a z slov mých stávaly se hvězdy"
  },
  {
   "texto": "a země, světy napořád."
  },
  {
   "texto": "Teď kdybych chtěla povídati,"
  },
  {
   "texto": "již nemám v světě prostory"
  },
  {
   "texto": "pro nová slova, hvězdy nové"
  },
  {
   "texto": "a nových sluncí útvory."
  },
  {
   "texto": "Však jedno přec ti ráda splním:"
  },
  {
   "texto": "číst naučím tě slova má,"
  },
  {
   "texto": "a ty je svými slovy promluv,"
  },
  {
   "texto": "komu jsou posud neznámá.“"
  },
  {
   "texto": "A tak jsem stal se novým žákem:"
  },
  {
   "texto": "čtu bez bázně a bez zmatku,"
  },
  {
   "texto": "z originálu, ve prařeči,"
  },
  {
   "texto": "čtu světovou vám pohádku."
  },
  {
   "texto": "Květlo v poli jetelíčka,"
  },
  {
   "texto": "jak myšlének v děvčeti,"
  },
  {
   "texto": "a jen jeden čtverolístek"
  },
  {
   "texto": "snil o sladkém dítěti."
  },
  {
   "texto": "A já poslal broučky zlaté,"
  },
  {
   "texto": "by jej spodem hledaly,"
  },
  {
   "texto": "a pak včelky pamlsalky,"
  },
  {
   "texto": "by se v medu zeptaly."
  },
  {
   "texto": "Bylo ptaní, namlouvání,"
  },
  {
   "texto": "šum a slasti výbuchy,"
  },
  {
   "texto": "a ten jetel čtverolístek"
  },
  {
   "texto": "pln panenské předtuchy."
  },
  {
   "texto": "A pak vyšla jak sluníčko,"
  },
  {
   "texto": "když svět jarem oslní —"
  },
  {
   "texto": "sladké dítě, sladké dítě,"
  },
  {
   "texto": "sen se tobě vyplní."
  },
  {
   "texto": "Máť všecko naše pocítění"
  },
  {
   "texto": "své jaro i své odkvěty,"
  },
  {
   "texto": "jen přátelství chcem a tu lásku"
  },
  {
   "texto": "v květ utrmácet stoletý."
  },
  {
   "texto": "Já nikdy neměřil bych délkou,"
  },
  {
   "texto": "čím srdce nám se zachvějí,"
  },
  {
   "texto": "vždyť jedna slza stojí za víc,"
  },
  {
   "texto": "než na sta v tváři krůpějí."
  },
  {
   "texto": "A nikdy nedrobil bych v léta,"
  },
  {
   "texto": "co jest jen jara vanutí,"
  },
  {
   "texto": "vždyť jediný dech lásky víc je,"
  },
  {
   "texto": "než tisíceré dýchnutí."
  },
  {
   "texto": "A krůpěj pravdivá i růže,"
  },
  {
   "texto": "byť potom hned se kladla spát,"
  },
  {
   "texto": "jen když mně z plna zaskvěla se —"
  },
  {
   "texto": "buď požehnána na stokrát."
  },
  {
   "texto": "Má duše teple naladěna,"
  },
  {
   "texto": "jak jarní den, tak ve průhledno,"
  },
  {
   "texto": "a zdá se mi, že ta má duše"
  },
  {
   "texto": "a jarní den jsou jako jedno."
  },
  {
   "texto": "Jakoby ve mně vyzváněli,"
  },
  {
   "texto": "přede mnou květ v každičkou stopu,"
  },
  {
   "texto": "má hlava jako ze skřivánků"
  },
  {
   "texto": "a dovejskne až k nebes stropu."
  },
  {
   "texto": "Svět ještě jednou mně tak velký,"
  },
  {
   "texto": "a přec ho svírám do náruče,"
  },
  {
   "texto": "mé srdce více není srdcem —"
  },
  {
   "texto": "to místo něho slavík tluče."
  },
  {
   "texto": "A všude jako vykropeno,"
  },
  {
   "texto": "tak zleštěno a v blahém puku —"
  },
  {
   "texto": "kde měl jsem duši, mám jen radost,"
  },
  {
   "texto": "ta v písni spěchá do souzvuku."
  }
 ]
}