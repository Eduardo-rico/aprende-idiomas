 "modo": "texto",
 "parrafos": [
  {
   "texto": "Postilion"
  },
  {
   "texto": "Nic nad zvuk neznám trubičky,"
  },
  {
   "texto": "když troubí postilion,"
  },
  {
   "texto": "že v psaních veze hubičky"
  },
  {
   "texto": "a každou za milion."
  },
  {
   "texto": "Pojď ven, ty zlatá děvečko,"
  },
  {
   "texto": "pták lépe nedoletí,"
  },
  {
   "texto": "přilítlo k tobě srdečko —"
  },
  {
   "texto": "zde mám je pod pečetí."
  },
  {
   "texto": "Panenka pečeť rozlomí,"
  },
  {
   "texto": "jak mák jí zaplane líc —"
  },
  {
   "texto": "tu milý dává vědomí,"
  },
  {
   "texto": "že líbá do statisíc."
  },
  {
   "texto": "Hned lístek k srdci uloží,"
  },
  {
   "texto": "a v srdci počne to hřát,"
  },
  {
   "texto": "jak když se v růže položí"
  },
  {
   "texto": "a slyší anděle hrát."
  },
  {
   "texto": "Ten lístek vezme k noclehu,"
  },
  {
   "texto": "s ním bude o nebi snít,"
  },
  {
   "texto": "sny půjdou v tichém úsměvu"
  },
  {
   "texto": "jak zlatý hvězdiček kmit."
  },
  {
   "texto": "Ten lístek vezme do stáří,"
  },
  {
   "texto": "s ním v mládí doletí zpět,"
  },
  {
   "texto": "že jeseň zjihne ve tváři"
  },
  {
   "texto": "a počnou slavíci pět."
  },
  {
   "texto": "Ba ještě v smrti přeletí"
  },
  {
   "texto": "jí na rtech vzpomenutí,"
  },
  {
   "texto": "že duši slyším vyzněti"
  },
  {
   "texto": "co sladké vydechnutí."
  },
  {
   "texto": "Nic nad zvuk není trubičky,"
  },
  {
   "texto": "když troubí postilion,"
  },
  {
   "texto": "a v psaních veze hubičky"
  },
  {
   "texto": "a každou za milion!"
  },
  {
   "texto": "Ta naše stará babička"
  },
  {
   "texto": "jen od pohádek mladne,"
  },
  {
   "texto": "tu zabzučí jak včelička,"
  },
  {
   "texto": "a řeč jí na rtech sladne."
  },
  {
   "texto": "Až po krk v kožich zapjata,"
  },
  {
   "texto": "jde ke kamnům a sedne,"
  },
  {
   "texto": "a hned má všecko ze zlata,"
  },
  {
   "texto": "jak na sluníčku ve dne."
  },
  {
   "texto": "Hrad na vrch zlatý postaví,"
  },
  {
   "texto": "v něj princezny a prince,"
  },
  {
   "texto": "šat zlatý dá jim, z hedbáví,"
  },
  {
   "texto": "a v truhly zlaté mince."
  },
  {
   "texto": "Pan král má zlatou korunu,"
  },
  {
   "texto": "má v očích mnoho spaní,"
  },
  {
   "texto": "spí v ložnici i na trůnu"
  },
  {
   "texto": "a nemá rád svou paní."
  },
  {
   "texto": "Kol trůnu švarní panici,"
  },
  {
   "texto": "ti od zlata se lesknou,"
  },
  {
   "texto": "král zvedá k nebi pravici,"
  },
  {
   "texto": "má dlouhou chvíli, tesknou."
  },
  {
   "texto": "A jedou na hon, do lesa,"
  },
  {
   "texto": "kde zlatý ptáček bydlí,"
  },
  {
   "texto": "kam lítne, má svá nebesa,"
  },
  {
   "texto": "kam sedne, zlatou židli."
  },
  {
   "texto": "A jedou z lesa na louku,"
  },
  {
   "texto": "kde zlatá včelka bzučí,"
  },
  {
   "texto": "tam kvítky v zlatém klobouku,"
  },
  {
   "texto": "kde vdýchnou, vůně pučí."
  },
  {
   "texto": "A jedou dál až po skály,"
  },
  {
   "texto": "kde zlatý pramen prýští,"
  },
  {
   "texto": "kde dívkám zlaté pokály"
  },
  {
   "texto": "se bílou rosou blýští."
  },
  {
   "texto": "Pak les je velká komnata,"
  },
  {
   "texto": "král vystrojí dvě svatby,"
  },
  {
   "texto": "a ptáci, včelky ze zlata"
  },
  {
   "texto": "tam hrajou nové skladby."
  },
  {
   "texto": "A když ta hudba zahrála,"
  },
  {
   "texto": "král pozval na sto dětí,"
  },
  {
   "texto": "nás babička však pozvala:"
  },
  {
   "texto": "„Jen pojďte, zlaté smetí.“"
  },
  {
   "texto": "Ty naše milá babičko,"
  },
  {
   "texto": "bůh živ tě mnohá léta,"
  },
  {
   "texto": "až pozlatíš, jak sluníčko,"
  },
  {
   "texto": "nám všecky krásy světa!"
  }
 ]
}