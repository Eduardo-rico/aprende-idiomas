 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "9"
  },
  {
   "texto": "Stárnoucí lidstvo čte ve hvězdách"
  },
  {
   "texto": "jak dědeček ve kronice,"
  },
  {
   "texto": "vždyť čteme tam samou jen minulost,"
  },
  {
   "texto": "co bylo, co není snad více."
  },
  {
   "texto": "Čtem o nesmírnosti prostory"
  },
  {
   "texto": "a mysl nám trne, žasne,"
  },
  {
   "texto": "že papršlek světla než sletí k nám,"
  },
  {
   "texto": "snad hvězda již zhasla, snad hasne."
  },
  {
   "texto": "Čeho my ještě se dožili!"
  },
  {
   "texto": "Ba na stará kolena divy:"
  },
  {
   "texto": "nám minulé vidět lze přítomně"
  },
  {
   "texto": "a mrtvy zřít jakoby živy!"
  },
  {
   "texto": "Paprsku z Alkyony mé,"
  },
  {
   "texto": "světelný šípe, znáš-li,"
  },
  {
   "texto": "čím si tvá paní líbezná"
  },
  {
   "texto": "luznou svou líci krášlí?"
  },
  {
   "texto": "„Ach snad už líc ta povadla,"
  },
  {
   "texto": "snad už je po všem vděku,"
  },
  {
   "texto": "vždyť já k vám světla s poselstvím"
  },
  {
   "texto": "letím již na šest věků!“"
  },
  {
   "texto": "Poslíčku říše Mlékové,"
  },
  {
   "texto": "po jakém po zákonu"
  },
  {
   "texto": "kupí se světů milion"
  },
  {
   "texto": "světelných do záhonů?"
  },
  {
   "texto": "„Ach snad už zhasly světy ty,"
  },
  {
   "texto": "snad už je po všech veta,"
  },
  {
   "texto": "od mého vzletu vrší se"
  },
  {
   "texto": "v tisíce věků leta!“ -"
  },
  {
   "texto": "Jako ta lidská myšlénka:"
  },
  {
   "texto": "po věcích teprv hřímá,"
  },
  {
   "texto": "po věcích lidstvem zachvěje -"
  },
  {
   "texto": "myslitel dávno dřímá."
  },
  {
   "texto": "V pusté jsme nebeské končině,"
  },
  {
   "texto": "Slunce i se planetami,"
  },
  {
   "texto": "jinde je světů jen naseto,"
  },
  {
   "texto": "my jsme tak světově sami!"
  },
  {
   "texto": "My když i nožičky vyšvihnem"
  },
  {
   "texto": "do šipkých světelných skoků,"
  },
  {
   "texto": "letíme k nejbližší sousedce"
  },
  {
   "texto": "přece jen trojici roků."
  },
  {
   "texto": "„Paničko Alfo Kentauri,"
  },
  {
   "texto": "poptávce dovolte ňáké,"
  },
  {
   "texto": "matička Slunce se dává ptát,"
  },
  {
   "texto": "máte-li dětičky také."
  },
  {
   "texto": "Nás je vám, stydno až vyslovit!"
  },
  {
   "texto": "je nás tam doma jak smetí,"
  },
  {
   "texto": "matička zvláštní má „hvězdáře“,"
  },
  {
   "texto": "kteří jí sčítají děti."
  },
  {
   "texto": "Některé z nás, ty už umřely,"
  },
  {
   "texto": "některé ještě se rodí,"
  },
  {
   "texto": "některým mladicky do skoku,"
  },
  {
   "texto": "jiné jak o berlách chodí."
  },
  {
   "texto": "Uran a Neptun - tak pro příklad -"
  },
  {
   "texto": "dávno jak rampouch jsou tuhy,"
  },
  {
   "texto": "vedle nich v posledním tažení"
  },
  {
   "texto": "Saturn i se svými kruhy."
  },
  {
   "texto": "Jupiter také už zvadlý kmet,"
  },
  {
   "texto": "pleť jeho žlutě tak září,"
  },
  {
   "texto": "ledové ruce, líný chod,"
  },
  {
   "texto": "široké vrásky ve tváři."
  },
  {
   "texto": "Promrzelý je to kolohnát!"
  },
  {
   "texto": "ač že vám sotva se plazí,"
  },
  {
   "texto": "my když se nejpěkněj točíme,"
  },
  {
   "texto": "on nám to, habán ten, kazí."
  },
  {
   "texto": "Mars - no ten ještě by prošel přec,"
  },
  {
   "texto": "jen kdyby nebyl tak rudý -"
  },
  {
   "texto": "to je to: hbitým že pijákem"
  },
  {
   "texto": "voják as po světě všudy."
  },
  {
   "texto": "Země - ach Země! Toť ženuška!"
  },
  {
   "texto": "při práce věčně jen hravá,"
  },
  {
   "texto": "plna je květů a písniček"
  },
  {
   "texto": "mladá jak lípečka zdravá."
  },
  {
   "texto": "Ještě pak: holčička Venuše,"
  },
  {
   "texto": "kypící, bující poupě,"
  },
  {
   "texto": "a skoro matce až na klíně"
  },
  {
   "texto": "Merkur, to nemluvně hloupé."
  },
  {
   "texto": "Je vám to pečlivá matička,"
  },
  {
   "texto": "kol sebe drží nás mladší,"
  },
  {
   "texto": "ale i postárlé propouští,"
  },
  {
   "texto": "jen až kam zraky jí stačí."
  },
  {
   "texto": "A jsou i planety takové,"
  },
  {
   "texto": "které už před časy zvadly,"
  },
  {
   "texto": "jejichžto trouchnivé mrtvoly"
  },
  {
   "texto": "v komety již se rozpadly."
  },
  {
   "texto": "Odlétly, ve hvězdách zmizely,"
  },
  {
   "texto": "už se i rozprchlé zdály,"
  },
  {
   "texto": "matička na ně jen vzpomíná"
  },
  {
   "texto": "v světové myšlének dáli."
  },
  {
   "texto": "Někdy se po nich však roztouží,"
  },
  {
   "texto": "náhle je stáhne až k sobě,"
  },
  {
   "texto": "ohnivé slzičky žíhají"
  },
  {
   "texto": "po nebi, v němé té době.\""
  }
 ]
}