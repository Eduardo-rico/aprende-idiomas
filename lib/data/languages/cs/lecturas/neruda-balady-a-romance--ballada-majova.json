   "texto": "Ballada májová"
  },
  {
   "texto": "V bílé míse vodu vaří"
  },
  {
   "texto": "s úzkostlivě bdělou tváří –"
  },
  {
   "texto": "pěkná holka, lepých tvarů."
  },
  {
   "texto": "Voda v míse v plném varu,"
  },
  {
   "texto": "bubliny jak v dešti chrlí,"
  },
  {
   "texto": "a jak holka varu slouchá,"
  },
  {
   "texto": "voda kloktá, syčí, hrčí,"
  },
  {
   "texto": "jak když cvrček v hroudách cvrlí,"
  },
  {
   "texto": "jak když oknem bzučí moucha,"
  },
  {
   "texto": "jak když v dálce povoz hrčí."
  },
  {
   "texto": "Houkla půlnoc. Holka klekla,"
  },
  {
   "texto": "prsten rychle s ruky svlékla,"
  },
  {
   "texto": "hodila jej varné v lůže."
  },
  {
   "texto": "„Svatá panno Petronillo!"
  },
  {
   "texto": "Dnešní májové své noci"
  },
  {
   "texto": "máš náš osud ve své moci,"
  },
  {
   "texto": "činíš cokoli Ti milo –"
  },
  {
   "texto": "prosím, prosím, dej mi muže!"
  },
  {
   "texto": "Zajisté že muže svého"
  },
  {
   "texto": "každého z Tvé ruky beru,"
  },
  {
   "texto": "nepředpisuju Ti věru,"
  },
  {
   "texto": "svatá panno, nevybírám,"
  },
  {
   "texto": "nemysli si, že se vzpírám –"
  },
  {
   "texto": "jen ne, probůh, zrzavého!“"
  },
  {
   "texto": "Z mísy vrch se páry valí,"
  },
  {
   "texto": "a jak holka blíž se kloní,"
  },
  {
   "texto": "z páry líbezně to zvoní"
