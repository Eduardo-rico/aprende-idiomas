{
 "id": "cech-jitrni-pisne--prave-slovo",
 "titulo": "Pravé slovo · Slovem a kovem",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Jit%C5%99n%C3%AD_p%C3%ADsn%C4%9B/Prav%C3%A9_slovo",
 "fuente": "cs.wikisource.org, «Jitřní písně»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-jitrni-pisne",
  "titulo": "Jitřní písně",
  "orden": 5
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Pravé slovo"
  },
  {
   "texto": "Často hledám v mocném ždání,"
  },
  {
   "texto": "v úsilovném přemítání"
  },
  {
   "texto": "slovo pravé,"
  },
  {
   "texto": "břitké,žhavé,"
  },
  {
   "texto": "jež by strasti vyjevilo,"
  },
  {
   "texto": "v nichž se duch náš potácí,"
  },
  {
   "texto": "jež by bouři ulevilo,"
  },
  {
   "texto": "která v nitru burácí."
  },
  {
   "texto": "A tu slovo kmitne v čele,"
  },
  {
   "texto": "slovo zvonivé a skvělé,"
  },
  {
   "texto": "hrot má řádný,"
  },
  {
   "texto": "důraz pádný,"
  },
  {
   "texto": "jím se trhá chmůra hustá,"
  },
  {
   "texto": "brání život, chrání čest -"
  },
  {
   "texto": "Ale nemluví jím ústa,"
  },
  {
   "texto": "mluví smělá mužná pěst."
  },
  {
   "texto": "Marně, marně! Pro nás není"
  },
  {
   "texto": "v tomto slově vykoupení."
  },
  {
   "texto": "Rozum váže"
  },
  {
   "texto": "chtivé páže:"
  },
  {
   "texto": "Nestihlo by lebku vraha,"
  },
  {
   "texto": "proklálo by vlastní hruď -"
  },
  {
   "texto": "Jenom vroucí, pilná snaha"
  },
  {
   "texto": "přítomnosti slovem buď!"
  },
  {
   "texto": "Když z tribuny polnicí znívá"
  },
  {
   "texto": "z úst výmluvných nadšená řeč,"
  },
  {
   "texto": "když do srdcí lidu se vrývá"
  },
  {
   "texto": "hlas pěvce jak plamenný meč,"
  },
  {
   "texto": "nechť zápal a naděje smělá"
  },
  {
   "texto": "tu povznáší tisíců čela,"
  },
  {
   "texto": "v mém nitru dí mrazivě cos:"
  },
  {
   "texto": "Ne slovem,"
  },
  {
   "texto": "leč kovem"
  },
  {
   "texto": "jen padne nám budoucí los."
  },
  {
   "texto": "Když národ, jejž násilí týrá,"
  },
  {
   "texto": "svůj pozvedá žalobný hlas"
  },
  {
   "texto": "a surovým křivdám se vzpírá,"
  },
  {
   "texto": "jež stínem jsou v osvěty jas,"
  },
  {
   "texto": "soud budoucí tyranu věstí -"
  },
  {
   "texto": "tu násilník, s ocelí v pěsti,"
  },
  {
   "texto": "jen úšklebně křiví svůj ret:"
  },
  {
   "texto": "Ne slovem,"
  },
  {
   "texto": "leč kovem:"
  },
  {
   "texto": "duch dějin si upraví svět."
  },
  {
   "texto": "Zlá myšlenka: Od věků darmo"
  },
  {
   "texto": "hlas boží z úst proroků zněl"
  },
  {
   "texto": "a železné, krvavé jarmo"
  },
  {
   "texto": "duch lásky snít člověku chtěl,"
  },
  {
   "texto": "jsou neplatna osvěty díla -"
  },
  {
   "texto": "Jak před věky divoká síla"
  },
  {
   "texto": "hřmí vítězně v barbarský rej:"
  },
  {
   "texto": "Ne slovem,"
  },
  {
   "texto": "jen kovem"
  },
  {
   "texto": "dál burácí člověčstva děj."
  },
  {
   "texto": "Mrak zlověstný nebesa halí,"
  },
  {
   "texto": "jak před bouří dusný je vzduch,"
  },
  {
   "texto": "již blízko vojsk rachod se valí -"
  },
  {
   "texto": "hen přikloňte k pažitu sluch!"
  },
  {
   "texto": "Snad zítra již spousta se snese"
  },
  {
   "texto": "a národy oněmí v děse,"
  },
  {
   "texto": "jen krvavá zařinčí sbor -"
  },
  {
   "texto": "Ne slovem,"
  },
  {
   "texto": "jen kovem"
  },
  {
   "texto": "se rozhodne velký ten boj."
  },
  {
   "texto": "A bez moci do divé vážky"
  },
  {
   "texto": "zříd bude náš ubohý rod,"
  },
  {
   "texto": "kam schýlí se osudné vážky,"
  },
  {
   "texto": "zda právu či násilí vhod."
  },
  {
   "texto": "Snad pravdu pak bezpráví zdolá"
  },
  {
   "texto": "a nepřítel potupně zvolá,"
  },
  {
   "texto": "šij kruše nám železem pat."
  },
  {
   "texto": "Ne slovem,"
  },
  {
   "texto": "jen kovem"
  },
  {
   "texto": "můj zdržíte smrtící mlat!"
  },
  {
   "texto": "Však nikoli - Jinou mám víru:"
  },
  {
   "texto": "Nech křivdě zdar ověnčí zbraň,"
  },
  {
   "texto": "přec nezajdem’ v záhubném víru,"
  },
  {
   "texto": "zas vypneme zdeptanou skráň."
  },
  {
   "texto": "Žár posvátný ve stálé hrudi"
  },
  {
   "texto": "nás uchrání z mrákoty vzbudí"
  },
  {
   "texto": "a vyvede z ústrků všech -"
  },
  {
   "texto": "Ne kovem"
  },
  {
   "texto": "leč slovem"
  },
  {
   "texto": "vstal jedou již z mohyly Čech."
  },
  {
   "texto": "Tím slovem, jež efeta! dělo"
  },
  {
   "texto": "z úst horoucích v hrobový klid,"
  },
  {
   "texto": "jež v kouzelných knihách se skvělo"
  },
  {
   "texto": "a zázrakem vzbudilo lid -"
  },
  {
   "texto": "To slovo zas národ můj spasý,"
  },
  {
   "texto": "a vytrhne z propasti bět,"
  },
  {
   "texto": "jej zachovává v jasnější časy,"
  },
  {
   "texto": "jež v dálce zří proroků hled,"
  },
  {
   "texto": "kdy slovem,"
  },
  {
   "texto": "ne kovem,"
  },
  {
   "texto": "krok lidstva se pošine vpřed."
  },
  {
   "texto": "Až slovo, jež nadšení plodí,"
  },
  {
   "texto": "to slovo, jímž bojuje duch,"
  },
  {
   "texto": "jež k dobru a ku světlu vodí"
  },
  {
   "texto": "vždy do výše člověctva ruch,"
  },
  {
   "texto": "třesk utiší válečných vzteků"
  },
  {
   "texto": "a na prapor budoucích věků"
  },
  {
   "texto": "v zář napíše krásnějších zor."
  },
  {
   "texto": "Pryč s kovem!"
  },
  {
   "texto": "Jen slovem"
  },
  {
   "texto": "řiď s láskou se národů sbor!"
  }
 ]
}