 "parrafos": [
  {
   "texto": "Můj Bože, všecky nároky"
  },
  {
   "texto": "Můj Bože, všecky nároky"
  },
  {
   "texto": "zde se své duše skládám;"
  },
  {
   "texto": "jen aby zpěv mi zůstal můj, —"
  },
  {
   "texto": "jen o to Tebe žádám."
  },
  {
   "texto": "Kdy bys mně vzít měl zpěvu dar —"
  },
  {
   "texto": "pak nechci déle žíti;"
  },
  {
   "texto": "bys za zpěv chtěl mi štěstí dát —"
  },
  {
   "texto": "já nechci šťastným býti."
  },
  {
   "texto": "Požehnaný, jenž pomazán"
  },
  {
   "texto": "na pěvce rukou Páně;"
  },
  {
   "texto": "on v soudy boží nahlédnul"
  },
  {
   "texto": "i v lidských ňader báně."
  },
  {
   "texto": "On zná ten velký světů žalm"
  },
  {
   "texto": "i zpěv, jejž zpívá ptáče,"
  },
  {
   "texto": "on srdce tlukům rozumí,"
  },
  {
   "texto": "kdy plesá i kdy pláče."
  },
  {
   "texto": "Co jiným lidem tajemstvím,"
  },
  {
   "texto": "to před ním rozestřené,"
  },
  {
   "texto": "on vůdcem lidu božího"
  },
  {
   "texto": "do země zaslíbené."
  },
  {
   "texto": "On králem velkých království,"
  },
  {
   "texto": "on knězem lidstva spásy,"
  },
  {
   "texto": "a co v něm leží pokladů"
  },
  {
   "texto": "jsou neskonalé krásy."
  },
  {
   "texto": "V Tvých rukou mnoho spočívá;"
  },
  {
   "texto": "já srdce své v ně vložil,"
  },
  {
   "texto": "v něž Pánbůh pěkné písně dal,"
  },
  {
   "texto": "bych lidské štěstí množil."
  },
  {
   "texto": "A srdce divná květina —"
  },
  {
   "texto": "ne všude kořen vpustí,"
  },
  {
   "texto": "a od lásky to závisí,"
  },
  {
   "texto": "zda hynout má či růsti."
  },
  {
   "texto": "A srdce divná květina,"
  },
  {
   "texto": "jí nejvíc třeba rosy,"
  },
  {
   "texto": "a jen, kdy nebe příznivé,"
  },
  {
   "texto": "pak krásné plody nosí."
  },
  {
   "texto": "A z Tvých-li rukou srdce mé"
  },
  {
   "texto": "k národa vzejde zdobě,"
  },
  {
   "texto": "věř, pozdní ještě věkové"
  },
  {
   "texto": "že budou žehnat Tobě!"
  },
  {
   "texto": "Já v trouby zahrát rozkázal"
  },
  {
   "texto": "k slavnému z mrtvých vstání;"
  },
  {
   "texto": "já veliký mít budu soud —"
  },
  {
   "texto": "vy buďte předvoláni."
  },
  {
   "texto": "Vy, kdo jste lásce bránili"
  },
  {
   "texto": "a strojili jí muka:"
  },
  {
   "texto": "vám ať je věčné zoufalství"
  },
  {
   "texto": "a věčně srdce puká!"
  },
  {
   "texto": "Leč vy, kdo věrni byli ste"
  },
  {
   "texto": "a vytrvali stále,"
  },
  {
   "texto": "vy pojďte na mou pravici"
  },
  {
   "texto": "a požívejte dále!"
  },
  {
   "texto": "Vám zvláštní nebe v nebi buď,"
  },
  {
   "texto": "neb milovavše sebe,"
  },
  {
   "texto": "již na zemi jste požili,"
  },
  {
   "texto": "co nazývá se nebe."
  }
 ]
}