  "orden": 23
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LXXXV."
  },
  {
   "texto": "V hedbávném mechu pod jedlí"
  },
  {
   "texto": "myšlénky mé si usedly,"
  },
  {
   "texto": "a jak ten pejsek ke stádu,"
  },
  {
   "texto": "srdce mé po jich příkladu."
  },
  {
   "texto": "Kolem nás mechu aksamit"
  },
  {
   "texto": "v lístky a kvítky porozvit,"
  },
  {
   "texto": "v nich jako s hvězdy ukáplá"
  },
  {
   "texto": "rosička mrká nasáklá."
  },
  {
   "texto": "V tom jako do hor pašeři"
  },
  {
   "texto": "mravenci s ranci sem zaměří:"
  },
  {
   "texto": "kudy jde cesta, vědí-li,"
  },
  {
   "texto": "že kol té jedle zbloudili."
  },
  {
   "texto": "Rychle se pavouk s větvice"
  },
  {
   "texto": "v kývadlo změnil na nitce:"
  },
  {
   "texto": "jestliže jim to lahodí,"
  },
  {
   "texto": "sám že je cestou zprovodí."
  },
  {
   "texto": "Jedle si z hloubi oddychne,"
  },
  {
   "texto": "šumí a náhle utichne,"
  },
  {
   "texto": "pavouk se v plánech zastaví —"
  },
  {
   "texto": "pašeři táhnou ve zdraví."
  },
  {
   "texto": "Myšlénka krásná zaťuká-li,"
  },
  {
   "texto": "ó, spěš a duši zotvírej;"
  },
  {
   "texto": "tať nikdy nepřichází sama,"
  },
  {
   "texto": "to za ní táhne velký rej."
  },
  {
   "texto": "To jak ta první lašťovička,"
  },
  {
   "texto": "když kolem okna mihne se,"
  },
  {
   "texto": "ta jde se ptát jen domku tvého,"
  },
  {
   "texto": "zda k němu jaro vejde se."
  },
  {
   "texto": "Zda dost je místa pod tvou římsou:"
  },
  {
   "texto": "že s písničkami přiletí,"
  },
  {
   "texto": "že mladou zemi květným rouchem"
  },
  {
   "texto": "a vzduch ti jasnem posvětí."
  },
  {
   "texto": "Myšlénka krásná! Když jí duše"
  },
  {
   "texto": "jen malý koutek dopřeje —"
  },
  {
   "texto": "ó, přijde jich pak celé jaro,"
  },
  {
   "texto": "že svět se v tobě ohřeje."
  },
  {
   "texto": "Má drahá, pojď, dnes budem hledat,"
  },
  {
   "texto": "kde nejvíc krásy vykvetá,"
  },
  {
   "texto": "a kde ji najdem, tam si sednem,"
  },
  {
   "texto": "vždyť byla nám též zasetá."
  },
  {
   "texto": "A projdem sobě hájův stíny,"
  },
  {
   "texto": "báň nebes, duše hlubiny,"
  },
  {
   "texto": "neb chceš-li, sednem u potůčku,"
  },
  {
   "texto": "neb vplujem v lidstva dějiny."
  },
  {
   "texto": "Však hleď, tu pod tím keřem šípků"
  },
  {
   "texto": "vylítla zšedlá pěnička,"
  },
  {
   "texto": "a v hnízdě zbylo něco písklat"
  },
  {
   "texto": "a každé žvatlá: „Matička!“"
  },
  {
   "texto": "A matka na listnaté olši"
  },
  {
   "texto": "tu zmizí, tu se vynoří,"
  },
  {
   "texto": "pak notuje v lehoučké písni —"
  },
  {
   "texto": "„Tu jsem! Tu jsem!“ k nim hovoří."
  },
  {
   "texto": "Pak přiletí, s každým se vítá,"
  },
  {
   "texto": "a duši má i ústa v něm,"
  },
  {
   "texto": "pak povídá, kde jak co bylo — —"
  },
  {
   "texto": "má milá, tady zůstanem."
  },
  {
   "texto": "Lesy mlčí, podřimují,"
  },
  {
   "texto": "každý dech si odměří,"
  },
  {
   "texto": "a tu letí čtverák větřík,"
  },
  {
   "texto": "začechrá je v kadeři."
  },
  {
   "texto": "Stará sosna hlavou vrtí,"
  },
  {
   "texto": "větve dospat nemohou,"
  },
  {
   "texto": "a to listí zvědavostí"
  },
  {
   "texto": "na buku hned na nohou."
  },
  {
   "texto": "Větřík mluví, kde co sebral,"
  },
  {
   "texto": "sosny ani nevěří,"
  },
  {
   "texto": "buky potřásají hlavou,"
  },
  {
   "texto": "listí jen se hašteří."
  },
  {
   "texto": "Jedněm šeptá cosi tajně,"
  },
  {
   "texto": "ty se kloní, tají dech,"
  },
  {
   "texto": "a ty, co jsou pozdálečí,"
  },
  {
   "texto": "že tu též jsou na poslech."
  },
  {
   "texto": "Čtverák jen tak napověděl,"
  },
  {
   "texto": "poroučí se o les dál,"
  },
  {
   "texto": "ale sosnám a těm bukům"
  },
  {
   "texto": "po celý den v srdci hrál."
  }
 ]
}