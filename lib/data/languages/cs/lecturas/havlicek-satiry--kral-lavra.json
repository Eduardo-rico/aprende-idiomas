 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Byltě jednou jeden"
  },
  {
   "texto": "starý dobrý král,"
  },
  {
   "texto": "ale je to dávno,"
  },
  {
   "texto": "taky od Čech dál,"
  },
  {
   "texto": "troje moře, devatery hory"
  },
  {
   "texto": "dělí ten kraj od české komory,"
  },
  {
   "texto": "kde on panoval."
  },
  {
   "texto": "Bylť král irský Lávra,"
  },
  {
   "texto": "povím zkrátka vám,"
  },
  {
   "texto": "a já o tom králi"
  },
  {
   "texto": "pěknou píseň znám:"
  },
  {
   "texto": "nalej, stará! čerstvého do číše"
  },
  {
   "texto": "a vy, kluci, poslouchejte tiše,"
  },
  {
   "texto": "já ji zazpívám."
  },
  {
   "texto": "Posud krále Lávru"
  },
  {
   "texto": "chválí irský lid,"
  },
  {
   "texto": "nebyl ani tyran,"
  },
  {
   "texto": "nebyl taky žid,"
  },
  {
   "texto": "nenabíjel cizím svoji kasu,"
  },
  {
   "texto": "rekrutýrkou nesužoval chasu,"
  },
  {
   "texto": "nedal chudé dřít."
  },
  {
   "texto": "Jenom jednu slabost"
  },
  {
   "texto": "ten král dobrý měl,"
  },
  {
   "texto": "že jest na holiče"
  },
  {
   "texto": "tuze zanevřel,"
  },
  {
   "texto": "dal se holit jenom jednou v roce,"
  },
  {
   "texto": "dlouhé vlasy po krku široce"
  },
  {
   "texto": "nosil jak roj včel."
  },
  {
   "texto": "Horší ještě bylo:"
  },
  {
   "texto": "vždy na letnice,"
  },
  {
   "texto": "jak očistil holič"
  },
  {
   "texto": "královské líce,"
  },
  {
   "texto": "čekala jej podivná odplata,"
  },
  {
   "texto": "nic na stříbře, ale skrze kata,"
  },
  {
   "texto": "to šibenice!"
  },
  {
   "texto": "Divili se lidé,"
  },
  {
   "texto": "mrzela je dost"
  },
  {
   "texto": "na tom dobrém králi"
  },
  {
   "texto": "tato ukrutnost;"
  },
  {
   "texto": "však co král chce, zdrávoť pro poddané,"
  },
  {
   "texto": "tak po letech zvykli si Irčané"
  },
  {
   "texto": "na tu podivnost."
  },
  {
   "texto": "Jenom holičové,"
  },
  {
   "texto": "zvyknout nemohli,"
  },
  {
   "texto": "na šibenici je"
  },
  {
   "texto": "špatné pohodlí,"
  },
  {
   "texto": "než co dělat? Nic jim nezbývalo,"
  },
  {
   "texto": "leda trpět, neb jich bylo málo"
  },
  {
   "texto": "na rebelii."
  },
  {
   "texto": "Každý rok, když táhlo"
  },
  {
   "texto": "již na letnice,"
  },
  {
   "texto": "sebral se bradýřský"
  },
  {
   "texto": "cech do radnice:"
  },
  {
   "texto": "tam chudáci smutně los metali,"
  },
  {
   "texto": "komu padne holit bradu králi"
  },
  {
   "texto": "a — šibenice."
  },
  {
   "texto": "Padl los, ach! padl:"
  },
  {
   "texto": "letos Kukulín"
  },
  {
   "texto": "bude holit krále,"
  },
  {
   "texto": "staré vdovy syn;"
  },
  {
   "texto": "jak to stará vdova uslyšela,"
  },
  {
   "texto": "omdlévala ustrašená celá:"
  },
  {
   "texto": "„Ach! můj Kukulín!“"
  },
  {
   "texto": "Již posloužil králi,"
  },
  {
   "texto": "již ho vede kat,"
  },
  {
   "texto": "ukrutnou odměnu"
  },
  {
   "texto": "za tu službu brát:"
  },
  {
   "texto": "tu se matka skrze zástup tlačí,"
  },
  {
   "texto": "spěchá, co jí staré síly stačí,"
  },
  {
   "texto": "zaň orodovat."
  },
  {
   "texto": "„Králi, pane králi!"
  },
  {
   "texto": "syn můj jedinej,"
  },
  {
   "texto": "pro Boha tě prosím,"
  },
  {
   "texto": "slitování měj!"
  },
  {
   "texto": "Co si počnu, já ubohá vdova,"
  },
  {
   "texto": "raděj sama umřít jsem hotova,"
  },
  {
   "texto": "jen mi syna dej!"
  },
  {
   "texto": "Králi, milostpane!"
  },
  {
   "texto": "máš to lidský cit?"
  },
  {
   "texto": "nevinného hocha"
  },
  {
   "texto": "katem utratit?"
  },
  {
   "texto": "Muž můj padnul v službě tvého dvoru"
  },
  {
   "texto": "a ty chceš mou jedinkou podporu"
  },
  {
   "texto": "hanebně mi vzít? —"
  },
  {
   "texto": "Jestliže ty, králi,"
  },
  {
   "texto": "dobré srdce máš,"
  },
  {
   "texto": "jistě každoročně"
  },
  {
   "texto": "jednou blázníváš:"
  },
  {
   "texto": "pro nic za nic, pro královské vousy"
  },
  {
   "texto": "kat člověka bez viny zardousí,"
  },
  {
   "texto": "to jsi otec náš?“ —"
  },
  {
   "texto": "Král se na ty řeči"
  },
  {
   "texto": "velmi zastyděl,"
  },
  {
   "texto": "ale ještě více"
  },
  {
   "texto": "slitování měl,"
  },
  {
   "texto": "nezlobil se, vzdychnul jen hluboko,"
  },
  {
   "texto": "dobré srdce tisklo slzu v oko,"
  },
  {
   "texto": "zastavit velel."
  },
  {
   "texto": "Všem se kázal vzdálit,"
  },
  {
   "texto": "jen sám Kukulín,"
  },
  {
   "texto": "povolán ku králi,"
  },
  {
   "texto": "bledý jako stín;"
  },
  {
   "texto": "král tu sedí, na klíně korunu:"
  },
  {
   "texto": "„Přistup, synku, blíže sem ke trůnu"
  },
  {
   "texto": "i pod baldachýn."
  },
  {
   "texto": "Přísahej, že smlčíš"
  },
  {
   "texto": "na věčné časy,"
  },
  {
   "texto": "co jsi na mé hlavě"
  },
  {
   "texto": "viděl pod vlasy,"
  },
  {
   "texto": "pak tobě neublíží v ničem"
  },
  {
   "texto": "a ty budeš mým dvorním holičem"
  },
  {
   "texto": "po všechny časy.“"
  },
  {
   "texto": "Rád přísahal mladík"
  },
  {
   "texto": "a byl propuštěn"
  },
  {
   "texto": "zvěstovati matce,"
  },
  {
   "texto": "jak jest povýšen;"
  },
  {
   "texto": "pak holíval obden králi líce"
  },
  {
   "texto": "a již žádný holič na letnice"
  },
  {
   "texto": "nebýval věšen."
  },
  {
   "texto": "Těšili se lidé,"
  },
  {
   "texto": "že ten dobrý král"
  },
  {
   "texto": "jedinou svou chybu"
  },
  {
   "texto": "vymluvit si dal;"
  },
  {
   "texto": "více však než celý národ irský"
  },
  {
   "texto": "počestný cech holičsko-bradýřský"
  },
  {
   "texto": "si ho liboval. — —"
  },
  {
   "texto": "Stojí mladý holič"
  },
  {
   "texto": "v dvorském obroku,"
  },
  {
   "texto": "raduje se matka"
  },
  {
   "texto": "z toho pokroku,"
  },
  {
   "texto": "jasné hvězdy na fraku se třpytí,"
  },
  {
   "texto": "zlaté porty, vyšívané kvítí,"
  },
  {
   "texto": "břitva po boku."
  },
  {
   "texto": "Než co platí hvězdy,"
  },
  {
   "texto": "zlaté třepení,"
  },
  {
   "texto": "když srdečko trápí"
  },
  {
   "texto": "ostré hryzení:"
  },
  {
   "texto": "nevyjevit nic po věčné časy,"
  },
  {
   "texto": "co vidívá králi pod vlasy"
  },
  {
   "texto": "vždy při holení!"
  },
  {
   "texto": "Husy štěbetají,"
  },
  {
   "texto": "tichá je labuť;"
  },
  {
   "texto": "kdo chce tajnost smlčet,"
  },
  {
   "texto": "holičem nebuď:"
  },
  {
   "texto": "holičovi vědomosti škubou,"
  },
  {
   "texto": "než je poví, přenáramně hudou:"
  },
  {
   "texto": "jazejček je rtuť!"
  },
  {
   "texto": "„Ach! můj milý synu,"
  },
  {
   "texto": "co tě sužuje?"
  },
  {
   "texto": "Ve dne nemáš stání,"
  },
  {
   "texto": "v noci pokoje:"
  },
  {
   "texto": "bývals vesel, teď ti líčko vadne,"
  },
  {
   "texto": "mladé tělo den ode dne chřadne,"
  },
  {
   "texto": "pověz, co ti je?“"
  },
  {
   "texto": "„Má milá matičko,"
  },
  {
   "texto": "ach! pomoc žádná!“"
  },
  {
   "texto": "„Můj milý synáčku,"
  },
  {
   "texto": "moc zví, kdo se ptá;"
  },
  {
   "texto": "v černém lese bydlí poustevníček,"
  },
  {
   "texto": "ten má od všech lidských srdcí klíček,"
  },
  {
   "texto": "on ti radu dá.“"
  },
  {
   "texto": "Pravil starý v lese:"
  },
  {
   "texto": "„Dobře znám tvůj kříž,"
  },
  {
   "texto": "synku, ty jsi holič"
  },
  {
   "texto": "a tajemství víš."
  },
  {
   "texto": "Ty je nesmíš povědít žádnému,"
  },
  {
   "texto": "neulehčíš ale srdci svému,"
  },
  {
   "texto": "až to vyslovíš."
  },
  {
   "texto": "Blíže u Viklova"
  },
  {
   "texto": "na stoku dvou řek"
  },
  {
   "texto": "stojí dutá vrba"
  },
  {
   "texto": "třetí lidský věk;"
  },
  {
   "texto": "všeptej do ní v tiché noční době"
  },
  {
   "texto": "své tajemství, a ulevíš sobě,"
  },
  {
   "texto": "jiný nemám lék.“ —"
  },
  {
   "texto": "Hned tu noc se holič"
  },
  {
   "texto": "z domu vypravil"
  },
  {
   "texto": "zkusit, co mu stařec"
  },
  {
   "texto": "v lese poradil,"
  },
  {
   "texto": "a našeptal do vrby hltavě,"
  },
  {
   "texto": "co král Lávra skrývá na své hlavě,"
  },
  {
   "texto": "pak se uzdravil."
  },
  {
   "texto": "Po tom uzdravení"
  },
  {
   "texto": "prošel krátký čas,"
  },
  {
   "texto": "tu strojil král Lávra"
  },
  {
   "texto": "hlučný dvorní kvas,"
  },
  {
   "texto": "z celé země paničky a páni"
  },
  {
   "texto": "sjeli jsou se k tomu hodování"
  },
  {
   "texto": "na králův rozkaz."
  },
  {
   "texto": "A po hodování"
  },
  {
   "texto": "velikánský sál"
  },
  {
   "texto": "hladce voskovaný"
  },
  {
   "texto": "čekal již na bál;"
  },
  {
   "texto": "ještě k tomu na tu dvorní švandu"
  },
  {
   "texto": "nejslavnější karlovarskou bandu"
  },
  {
   "texto": "objednal si král."
  },
  {
   "texto": "Po Češích je doma"
  },
  {
   "texto": "vždycky malý sled,"
  },
  {
   "texto": "ale všude jinde"
  },
  {
   "texto": "naplňují svět:"
  },
  {
   "texto": "muzikanty, jezdce, harfenice,"
  },
  {
   "texto": "ouředníky, sirky ze Sušice"
  },
  {
   "texto": "najdeš všude hned."
  },
  {
   "texto": "Táhli hudci k bálu,"
  },
  {
   "texto": "až pan Červíček"
  },
  {
   "texto": "silným kvapem ztratil"
  },
  {
   "texto": "z basy kolíček,"
  },
  {
   "texto": "a když přišli k viklovskému brodu,"
  },
  {
   "texto": "zpozoroval tu svou velkou škodu"
  },
  {
   "texto": "na stoku dvou řek."
  },
  {
   "texto": "Tam u duté vrby"
  },
  {
   "texto": "s basou smutně stál:"
  },
  {
   "texto": "„Půjdu-li ho hledat,"
  },
  {
   "texto": "promeškáme bál!“"
  },
  {
   "texto": "Uříz z vrby větev na kolíček,"
  },
  {
   "texto": "co způsobí, o tom pan Červíček"
  },
  {
   "texto": "nic se nenadál."
  },
  {
   "texto": "Způsobil tam s basou"
  },
  {
   "texto": "králi čistou věc,"
  },
  {
   "texto": "jak na bále pustil"
  },
  {
   "texto": "po strunách smyčec,"
  },
  {
   "texto": "tu řve basa, až všechno přehluší:"
  },
  {
   "texto": "„Král Lávra má dlouhé oslí uši,"
  },
  {
   "texto": "král je ušatec!“"
  },
  {
   "texto": "Král dal hned Červíčka"
  },
  {
   "texto": "s basou vyhodit,"
  },
  {
   "texto": "bylo však již pozdě"
  },
  {
   "texto": "basu oběsit,"
  },
  {
   "texto": "a tajemství, pro něž lazebníci"
  },
  {
   "texto": "umírali jsou na šibenici,"
  },
  {
   "texto": "rozneslo se v lid."
  },
  {
   "texto": "Co nyní celý svět"
  },
  {
   "texto": "věděl od basy,"
  },
  {
   "texto": "nebylo nic platno"
  },
  {
   "texto": "skrývat pod vlasy,"
  },
  {
   "texto": "tak král Lávra nosil po tom bálu"
  },
  {
   "texto": "svoje dlouhé uši bez futrálu"
  },
  {
   "texto": "po všechny časy."
  },
  {
   "texto": "A po krátké době,"
  },
  {
   "texto": "když utich povyk,"
  },
  {
   "texto": "líbil se přec lidu"
  },
  {
   "texto": "dobrý panovník,"
  },
  {
   "texto": "zdálo se jim, že ty dlouhé uši"
  },
  {
   "texto": "právě dobře ke koruně sluší,"
  },
  {
   "texto": "všechno může zvyk! —"
  },
  {
   "texto": "Tu je konec písně:"
  },
  {
   "texto": "zdráv buď Lávra král!"
  },
  {
   "texto": "Kukulín ho vždycky"
  },
  {
   "texto": "holil a stříhal,"
  },
  {
   "texto": "neb to nikdy najevo nevyšlo,"
  },
  {
   "texto": "jak tajemství až do basy přišlo"
  },
  {
   "texto": "a z basy na bál."
  },
  {
   "texto": "Není každá vrba"
  },
  {
   "texto": "jako viklovská,"
  },
  {
   "texto": "ani každá basa"
  },
  {
   "texto": "jak červíčkovská:"
  },
  {
   "texto": "a když tě co na jazyku svrbí,"
  },
  {
   "texto": "našeptej to jen do staré vrby,"
  },
  {
   "texto": "dceruško drahá!"
  }
 ]
}