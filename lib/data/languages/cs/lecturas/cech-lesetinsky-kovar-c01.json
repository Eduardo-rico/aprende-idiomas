 "fuenteUrl": "https://cs.wikisource.org/wiki/Le%C5%A1et%C3%ADnsk%C3%BD_kov%C3%A1%C5%99/I.",
 "fuente": "cs.wikisource.org, «Lešetínský kovář»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-lesetinsky-kovar",
  "titulo": "Lešetínský kovář",
  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I."
  },
  {
   "texto": "Lešetínský kovář"
  },
  {
   "texto": "chlapík jak se sluší:"
  },
  {
   "texto": "Ocel rukou láme,"
  },
  {
   "texto": "pěstí kámen kruší,"
  },
  {
   "texto": "hračkou zvedne statný strom,"
  },
  {
   "texto": "jeho perlík jako hrom"
  },
  {
   "texto": "v kovadlinu buší."
  },
  {
   "texto": "Když mu v rukou dílo"
  },
  {
   "texto": "jiskří, kouří, syčí"
  },
  {
   "texto": "a mrak sazí tváře"
  },
  {
   "texto": "na černo mu líčí,"
  },
  {
   "texto": "vlaje temný vous a vlas:"
  },
  {
   "texto": "v rudé záři jako ďas"
  },
  {
   "texto": "do stropu se týčí."
  },
  {
   "texto": "Ku kovárně zděné"
  },
  {
   "texto": "zubovatým štítem"
  },
  {
   "texto": "chaloupka se tulí"
  },
  {
   "texto": "s došků sivých krytem;"
  },
  {
   "texto": "v ní je pěkná světnička,"
  },
  {
   "texto": "čistá jako kaplička,"
  },
  {
   "texto": "a v té anděl bytem."
  },
  {
   "texto": "Panenka tam švarná"
  },
  {
   "texto": "jako jarní kvítí"
  },
  {
   "texto": "v pošívané zlatem"
  },
  {
   "texto": "kordulce se třpytí,"
  },
  {
   "texto": "bílá jako kalina,"
  },
  {
   "texto": "červená jak malina,"
  },
  {
   "texto": "modrým očkem svítí."
  },
  {
   "texto": "Pěkně na hlavičce"
  },
  {
   "texto": "rdí se na vše strany"
  },
  {
   "texto": "šátku hedbáv řasný,"
  },
  {
   "texto": "v babku zavázaný,"
  },
  {
   "texto": "rusým vlasem prokvetá,"
  },
  {
   "texto": "jako hoří za léta"
  },
  {
   "texto": "v obilí mák planý."
  },
  {
   "texto": "S její tváře v jizbu"
  },
  {
   "texto": "štěstí záře splývá,"
  },
  {
   "texto": "z jejích očí radost"
  },
  {
   "texto": "nevinná se dívá,"
  },
  {
   "texto": "z jitra v pozdní červánek"
  },
  {
   "texto": "jako v modru skřivánek"
  },
  {
   "texto": "vesele si zpívá."
  },
  {
   "texto": "V kovárně je živo"
  },
  {
   "texto": "z rána do večera,"
  },
  {
   "texto": "hřímavě tam duní"
  },
  {
   "texto": "kladiv rána sterá"
  },
  {
   "texto": "a když chvilkou oněmí,"
  },
  {
   "texto": "vystřídá je písněmi"
  },
  {
   "texto": "kovářova dcera."
  },
  {
   "texto": "II."
  },
  {
   "texto": "Krásně bylo v Lešetíně:"
  },
  {
   "texto": "Vesnička ta prostomilá"
  },
  {
   "texto": "jak robátko v matky klíně,"
  },
  {
   "texto": "utajena světu, snila"
  },
  {
   "texto": "ve hvozdnatém údolí."
  },
  {
   "texto": "Vížkou rděl se nad dědinou"
  },
  {
   "texto": "kostel mezi topoly,"
  },
  {
   "texto": "a kol něho v zeleň stinnou"
  },
  {
   "texto": "třešní, jabloní a hruší"
  },
  {
   "texto": "tísnila se chatek tlupa"
  },
  {
   "texto": "jako slípky, když je vzruší"
  },
  {
   "texto": "na blankytu přelet supa."
  },
  {
   "texto": "Měly štíty z prken sbité,"
  },
  {
   "texto": "výstupky v nich kruhovité"
  },
  {
   "texto": "jako kazatelen krovy, —"
  },
  {
   "texto": "s holubičkou mnohdy také."
  },
  {
   "texto": "Koberec tkal sametový"
  },
  {
   "texto": "v pěkné barvě všelijaké,"
  },
  {
   "texto": "do zelena, ruda, hněda,"
  },
  {
   "texto": "mech na došků rouna šedá."
  },
  {
   "texto": "Pode střechou bílé pruhy"
  },
  {
   "texto": "propínaly hnědé trámce,"
  },
  {
   "texto": "z bílého pak oken rámce"
  },
  {
   "texto": "zřelo kvítí v barvách duhy."
  },
  {
   "texto": "Pod oknem též sádek něžný"
  },
  {
   "texto": "odíval se pestrým šatem:"
  },
  {
   "texto": "Mák tu ruměný a sněžný"
  },
  {
   "texto": "s plamenným se družil zlatem"
  },
  {
   "texto": "kněžek slunce štíhlounkých,"
  },
  {
   "texto": "růžemi se obeskvíval"
  },
  {
   "texto": "pyšný sléz, an oměj kýval"
  },
  {
   "texto": "modrem přílbic drobounkých."
  },
  {
   "texto": "Tu se chata ukrývala"
  },
  {
   "texto": "z pola v jasnolistém víně,"
  },
  {
   "texto": "tamo dotěravá dýně"
  },
  {
   "texto": "na nízkou se střechu vzpjala,"
  },
  {
   "texto": "stelouc jí své květy zlaté"
  },
  {
   "texto": "a své plody boubelaté."
  },
  {
   "texto": "Tichá říčka vinula se"
  },
  {
   "texto": "oklikou od vísky sterou,"
  },
  {
   "texto": "tu vrb, olší tlupou šerou,"
  },
  {
   "texto": "lučinou tam kyprou zase,"
  },
  {
   "texto": "onde pokraj lesní skály,"
  },
  {
   "texto": "kde tak mnohý do ní vnořen"
  },
  {
   "texto": "spletitý se černal kořen,"
  },
  {
   "texto": "kde se do vln hroužit zdály"
  },
  {
   "texto": "obráceny dolů hlavou"
  },
  {
   "texto": "dříny, jedle chvojí tmavou;"
  },
  {
   "texto": "zřel jsi ve průhledném jase"
  },
  {
   "texto": "každou rybku, škeble misku,"
  },
  {
   "texto": "až i na dně v bílém písku"
  },
  {
   "texto": "míhavé ty kroužky stínu,"
  },
  {
   "texto": "jež tam kreslí drobní honci"
  },
  {
   "texto": "v bystrém běhu přes hladinu"
  },
  {
   "texto": "nožek niťovitých konci."
  },
  {
   "texto": "Úval tento v borů taji"
  },
  {
   "texto": "uchránil si způsob ryzí"
  },
  {
   "texto": "zašlých let, kdy příval cizí"
  },
  {
   "texto": "zakypěl po našem kraji."
  },
  {
   "texto": "Jak mys úzký trčel pevně"
  },
  {
   "texto": "v okeán, jenž drahné doby"
  },
  {
   "texto": "tu v mez naši bouří hněvně,"
  },
  {
   "texto": "tam ji v míru klamném drobí,"
  },
  {
   "texto": "že zrak žalem kalný zírá"
  },
  {
   "texto": "teskně v příboj hltavý —"
  },
  {
   "texto": "však jen práce, v sebe víra"
  },
  {
   "texto": "vzdornou mez mu postaví."
  },
  {
   "texto": "Jako v tajné skrýši tady"
  },
  {
   "texto": "uchránil se odkaz dědů,"
  },
  {
   "texto": "mnoho prostovábných sledů"
  },
  {
   "texto": "v žití, kroji z prchlé vnady,"
  },
  {
   "texto": "kterou kdysi země kvetla"
  },
  {
   "texto": "jako čerstvým vděkem jara,"
  },
  {
   "texto": "než jej chladným vichrem smetla"
  },
  {
   "texto": "přítomnosti jeseň chará,"
  },
  {
   "texto": "v nížto teskně křídla věsí"
  },
  {
   "texto": "vlaštovička poesie,"
  },
  {
   "texto": "vidouc, jak pláň holou, lesy"
  },
  {
   "texto": "sežloutlé stín mutný kryje;"
  },
  {
   "texto": "zachvěje se mrazným dechem,"
  },
  {
   "texto": "náhle peruť vzepne k letu,"
  },
  {
   "texto": "zpět se nese toužným spěchem"
  },
  {
   "texto": "v teplé kraje bájných květů…"
  },
  {
   "texto": "Jarní sny když slétly k dolu,"
  },
  {
   "texto": "nad vesnicí štíhlou jedli"
  },
  {
   "texto": "s pestrou zdobou na vrcholu"
  },
  {
   "texto": "jako Vesny berlu shlédly."
  },
  {
   "texto": "Chasa v jasných barvách stuh"
  },
  {
   "texto": "hrála jako kvítím luh,"
  },
  {
   "texto": "a vsí jaré zpěvy zněly;"
  },
  {
   "texto": "s vískou jásal úval celý"
  },
  {
   "texto": "písněmi, jež z dola, s hůry,"
  },
  {
   "texto": "z luk a hvozdů splývaly"
  },
  {
   "texto": "s teskným plesem píšťaly,"
  },
  {
   "texto": "urobené z vrbí kůry."
  },
  {
   "texto": "Píseň z léta do jeseni"
  },
  {
   "texto": "provázela mladou chasu"
  },
  {
   "texto": "polem v kos a srpů znění;"
  },
  {
   "texto": "při večerních zvonů hlasu"
  },
  {
   "texto": "vracela se s nimi lesem,"
  },
  {
   "texto": "kde tak svůdně v polotemně"
  },
  {
   "texto": "šarlat jahod svítil vřesem"
  },
  {
   "texto": "a hub různotvárné plémě"
  },
  {
   "texto": "zvalo ruku v úkryt stinný"
  },
  {
   "texto": "pod vějíře kapradiny;"
  },
  {
   "texto": "bděla s nimi chvíli mnohou"
  },
  {
   "texto": "v komůrce i v sadě tichém"
  },
  {
   "texto": "pod hvězdnatou pod oblohou,"
  },
  {
   "texto": "zněla pláčem, zněla smíchem,"
  },
  {
   "texto": "slavičí jak písenka"
  },
  {
   "texto": "vůní květů ku měsíci"
  },
  {
   "texto": "rokotala z okénka,"
  },
  {
   "texto": "ze rtů děvy milující."
  },
  {
   "texto": "Hospodáři o neděli"
  },
  {
   "texto": "s rozkoší si poseděli"
  },
  {
   "texto": "ve stařičké lípy stínu."
  },
  {
   "texto": "Zvonila tu víčka z cínu,"
  },
  {
   "texto": "modraly se mráčky kouře,"
  },
  {
   "texto": "hovor volně plynul kruhem;"
  },
  {
   "texto": "bradu hladě, oči mhouře"
  },
  {
   "texto": "druh si zanotoval s druhem"
  },
  {
   "texto": "o žních, daních, o počasí,"
  },
  {
   "texto": "o tom, co se děje světem."
  },
  {
   "texto": "Ba, sám farář bělovlasý"
  },
  {
   "texto": "mnohdy s usmívavým retem"
  },
  {
   "texto": "usedal si mezi nimi;"
  },
  {
   "texto": "jinak vážný duší rádce,"
  },
  {
   "texto": "miloval zde žert a šprýmy"
  },
  {
   "texto": "dobrý pastýř toho stádce."
  },
  {
   "texto": "Když však zimní čepec bílý"
  },
  {
   "texto": "řásně pokryl každou chatu,"
  },
  {
   "texto": "znělo v podvečerní chvíli"
  },
  {
   "texto": "u vrčících kolovratů"
  },
  {
   "texto": "hojně starodávných bájí,"
  },
  {
   "texto": "zkazek divných, zasmušilých,"
  },
  {
   "texto": "na peci až v teskné tísni"
  },
  {
   "texto": "tlum se schoulil dítek čilých,"
  },
  {
   "texto": "bázlivými zraky měně"
  },
  {
   "texto": "žen a přeslic stíny hravé,"
  },
  {
   "texto": "vlající po bílé stěně,"
  },
  {
   "texto": "ve obrysy přelétavé"
  },
  {
   "texto": "děsných příšer, kouzelníků,"
  },
  {
   "texto": "ježibab a pekelníků…"
  },
  {
   "texto": "Takto klidně v lesu stíně"
  },
  {
   "texto": "žil ten vábný horský luh,"
  },
  {
   "texto": "až kdys náhle divný ruch"
  },
  {
   "texto": "rozvlnil se v jeho klíně:"
  },
  {
   "texto": "Od strany, kde v sosen bráně"
  },
  {
   "texto": "dav se jeví zamodralý"
  },
  {
   "texto": "hor těch nevěrných, jimž stráně"
  },
  {
   "texto": "moře cizoty již halí,"
  },
  {
   "texto": "valil se v ten tichý kout"
  },
  {
   "texto": "postav nevídaný proud,"
  },
  {
   "texto": "v nuzném kroji, nad rameny"
  },
  {
   "texto": "s lopatou a toporem;"
  },
  {
   "texto": "plnily dol omámený"
  },
  {
   "texto": "dřevěných buď táborem,"
  },
  {
   "texto": "vřavou řečí pomíchanou,"
  },
  {
   "texto": "směsí zvuků neslýchanou."
  },
  {
   "texto": "Řinčí špičák, boře skály,"
  },
  {
   "texto": "duní topor, kmeny tříště,"
  },
  {
   "texto": "vše kol hemžení, hyb stálý,"
  },
  {
   "texto": "obrovské jak mraveniště."
  },
  {
   "texto": "Hledí úval postrašený,"
  },
  {
   "texto": "hledí teskně družné chýše,"
  },
  {
   "texto": "jak z těch ruchů širé stěny"
  },
  {
   "texto": "chvatné rostou výš a výše,"
  },
  {
   "texto": "jak se otvory v nich šklebí"
  },
  {
   "texto": "oken nesčetných, jak vedle"
  },
  {
   "texto": "komín titán vzrůstá k nebi,"
  },
  {
   "texto": "nad nejvyšší horské jedle,"
  },
  {
   "texto": "teď již nad kostelní kříž"
  },
  {
   "texto": "a dál u závratnou výš’."
  },
  {
   "texto": "Věž to vzpíná pod oblohu"
  },
  {
   "texto": "nový chrám, kde v obětisku"
  },
  {
   "texto": "dýmavém se slouží bohu"
  },
  {
   "texto": "našich časů, bohu zisku;"
  },
  {
   "texto": "kde mu oltář divný spleten"
  },
  {
   "texto": "z koles, řemenů a vřeten,"
  },
  {
   "texto": "kde za hudbu varhan, zvony"
  },
  {
   "texto": "hlučí strojů píle kvačná"
  },
  {
   "texto": "a kde mirrhy oblak vonný"
  },
  {
   "texto": "zastupují páry mračna,"
  },
  {
   "texto": "od jitra kde do soumraku"
  },
  {
   "texto": "v komžích bídy, z cárů tkaných,"
  },
  {
   "texto": "slouží jemu volní rabi:"
  },
  {
   "texto": "muži rysů potrhaných,"
  },
  {
   "texto": "bledé ženy kalných zraků,"
  },
  {
   "texto": "i sval chorých dítek slabý."
  },
  {
   "texto": "V potu, slzách, trudu, hladu"
  },
  {
   "texto": "slouží tam až do úpadu"
  },
  {
   "texto": "zlaté modle, kteráž ryje"
  },
  {
   "texto": "těžkou nohou jejich šije"
  },
  {
   "texto": "krev a mízu jejich ssajíc,"
  },
  {
   "texto": "v pýše chladné pozírajíc"
  },
  {
   "texto": "na ty stíny lidí matné;"
  },
  {
   "texto": "a když některé z kol hřmících,"
  },
  {
   "texto": "ku slávě ji vznášejících,"
  },
  {
   "texto": "zub svůj rabu v srdce zatne,"
  },
  {
   "texto": "rozerve mu mroucí líci:"
  },
  {
   "texto": "bůh ten s tváří odvrácenou"
  },
  {
   "texto": "hodí grešli zkrvácenou"
  },
  {
   "texto": "do siroty bědující!"
  },
  {
   "texto": "Dobyvatel v naše strany"
  },
  {
   "texto": "přikvačil ve voze zlatém —"
  },
  {
   "texto": "vše se vzdalo bez obrany."
  },
  {
   "texto": "Jeho tvrz se věží chvatem,"
  },
  {
   "texto": "roste, sotva dol jí stačí,"
  },
  {
   "texto": "do vísky se zpupně tlačí."
  },
  {
   "texto": "Některé tu z chatek záhy"
  },
  {
   "texto": "pod mohutné její valy"
  },
  {
   "texto": "skromný vděk svůj pochovaly."
  },
  {
   "texto": "Ostatním za tiché prahy"
  },
  {
   "texto": "jeho žoldáctvo se vtírá,"
  },
  {
   "texto": "mění jejich prosté tahy,"
  },
  {
   "texto": "v úsměšku jim s lící stírá"
  },
  {
   "texto": "skromný půvab starosvětský,"
  },
  {
   "texto": "vyhání z nich skřítky bdělé,"
  },
  {
   "texto": "pohádky a písně všecky."
  },
  {
   "texto": "Staří jejich bydlitelé"
  },
  {
   "texto": "s rodnými se loučí krovy;"
  },
  {
   "texto": "zlata hrsť si nesou za to."
  },
  {
   "texto": "Jedni jinde domov nový"
  },
  {
   "texto": "hledají si; jiným zlato"
  },
  {
   "texto": "kulaté se rozkutálí,"
  },
  {
   "texto": "novému pak vísky pánu"
  },
  {
   "texto": "bídně slouží aneb v dáli"
  },
  {
   "texto": "za peřeje oceánu"
  },
  {
   "texto": "v nový svět je svádějí"
  },
  {
   "texto": "hvězdy klamných nadějí."
  },
  {
   "texto": "A jak vábný dol se mění!"
  },
  {
   "texto": "Jedle statné, sekyr třeskem"
  },
  {
   "texto": "z dávného procitše snění,"
  },
  {
   "texto": "shůry sklánějí se bleskem"
  },
  {
   "texto": "za smrtelných těžkých vzdechů"
  },
  {
   "texto": "na zedraný samet mechu."
  },
  {
   "texto": "Ve skal hrudi obnažené"
  },
  {
   "texto": "prach se znímá s řevem hromu,"
  },
  {
   "texto": "v jejich pleci rozražené"
  },
  {
   "texto": "zejí děsné rány lomu."
  },
  {
   "texto": "Kde se luka smála svěží"
  },
  {
   "texto": "květů šperkem líbezným,"
  },
  {
   "texto": "po vysokém náspu běží"
  },
  {
   "texto": "kolej pásmem železným,"
  },
  {
   "texto": "páry oř tu letí mrakem"
  },
  {
   "texto": "a plá v temnu rudým zrakem."
  },
  {
   "texto": "Proměnil se v kalné tůně"
  },
  {
   "texto": "říčky křišťálový proud,"
  },
  {
   "texto": "místo dechů čerstvé vůně"
  },
  {
   "texto": "šíří morný puch a čmoud,"
  },
  {
   "texto": "bažinou se vleče rmutně,"
  },
  {
   "texto": "temnou pěnou šeptá smutně"
  },
  {
   "texto": "sežloutlému rákosí"
  },
  {
   "texto": "o vrbách, jichž klesly řady,"
  },
  {
   "texto": "o děvách, jimž boků vnady"
  },
  {
   "texto": "za šera již nerosí,"
  },
  {
   "texto": "o povadlých květech milých,"
  },
  {
   "texto": "o zhynulých rybkách čilých."
  },
  {
   "texto": "Zpěv se ztajil v údolí"
  },
  {
   "texto": "rozrušeném, rozervaném:"
  },
  {
   "texto": "nejásá již se skřivanem"
  },
  {
   "texto": "nad lukami, nad rolí,"
  },
  {
   "texto": "nezní v luhu k dětským plesům,"
  },
  {
   "texto": "nesvěřuje tichým lesům"
  },
  {
   "texto": "milujících srdcí chvění —"
  },
  {
   "texto": "novým pánům rozmar kalí"
  },
  {
   "texto": "naší řeči zvuk a pění —"
  },
  {
   "texto": "jenom tuhé naše svaly"
  },
  {
   "texto": "hodí se jim k tuhé práci."
  },
  {
   "texto": "Zpěvy, báje oněměly;"
  },
  {
   "texto": "zdá se, že tu sami ptáci"
  },
  {
   "texto": "sladkou notu zapomněli."
  }
 ]
}