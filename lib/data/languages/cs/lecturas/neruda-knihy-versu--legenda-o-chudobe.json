{
 "id": "neruda-knihy-versu--legenda-o-chudobe",
 "titulo": "Legenda o chudobě · Otci",
 "autor": "Jan Neruda",
 "muerteAutor": 1891,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Knihy_ver%C5%A1%C5%AF/Legenda_o_chudob%C4%9B",
 "fuente": "cs.wikisource.org, «Knihy veršů»",
 "licencia": "dominio público (autor muerto en 1891)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "neruda-knihy-versu",
  "titulo": "Knihy veršů",
  "orden": 18
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Legenda o chudobě"
  },
  {
   "texto": "Pěti mudrcům dal Chudobu, svou dceru,"
  },
  {
   "texto": "otec Osud; zetě vybral dobře věru:"
  },
  {
   "texto": "vdal ji za vojáka, kněze, obchodníka,"
  },
  {
   "texto": "za mudrce z pariů i za rolníka."
  },
  {
   "texto": "Pyšně nesli hlavu u mladistvém květu:"
  },
  {
   "texto": "„Třeba chudi, předce prospějeme světu!“"
  },
  {
   "texto": "A když dožili si lidská svoje leta,"
  },
  {
   "texto": "povolal je Osud před soud všeho světa:"
  },
  {
   "texto": "„Každý nechť vystoupí, k otázce odvětí:"
  },
  {
   "texto": "čím že byl jest světu v Chudoby objetí?“"
  },
  {
   "texto": "Vystoupili čtyři. Hlavy k prsoum sklesly —"
  },
  {
   "texto": "o svatbě se byly přede tak pyšně nesly!"
  },
  {
   "texto": "„Nemohl jsem platit učitelův zvěsty,"
  },
  {
   "texto": "byl jsem prázdný rybník podél lidstva, cesty."
  },
  {
   "texto": "Sbíral jsem jen vlastní zkumné mysli zvěsty,"
  },
  {
   "texto": "zas jak rybník v lese, vzdálen lidstva cesty:"
  },
  {
   "texto": "slunce, hvězdy přišly, zář i bouř v mně žila,"
  },
  {
   "texto": "poutníka však vlna moje nesvlažila!“"
  },
  {
   "texto": "Kněz tak dí, a voják vystupuje na to:"
  },
  {
   "texto": "„Chtěl jsem osvobodit, otroctvím co spjato,"
  },
  {
   "texto": "chtěl jsem vymstit všechno, co kdy lidstvo hnětlo,"
  },
  {
   "texto": "povalit v prach, co kdy lidstvu bralo světlo."
  },
  {
   "texto": "Neměl jsem však zbraní — smáli se mně, smáli,"
  },
  {
   "texto": "jako hadu, jemuž zuby vylámali.“"
  },
  {
   "texto": "Rolník na to: „V bídném živobytí boji"
  },
  {
   "texto": "drobně utratil jsem všechnu moudrost svoji"
  },
  {
   "texto": "za chléb, sůl a olej, za lék pro nemoce —"
  },
  {
   "texto": "lidstvu byl jsem stromem suchým, bez ovoce.“"
  },
  {
   "texto": "Obchodník pak: „Chtěl jsem spojit světa konec –"
  },
  {
   "texto": "byl jsem ptákem, jemuž křídla srazil honec.“ —"
  },
  {
   "texto": "„A ty, pario,“ dí Osud, „jak ty s ženou?"
  },
  {
   "texto": "Stojíš jediný zde s hlavou povznešenou!“"
  },
  {
   "texto": "Paria tu stojí s hlavou povznešenou:"
  },
  {
   "texto": "„Děkuji ti, pane, ženu za vznešenou!"
  },
  {
   "texto": "Sotva se mne dotkla prostým svojím květem"
  },
  {
   "texto": "poznávám svět celý, nevšimnut jsa světem.“"
  },
  {
   "texto": "Vzduchem hučí to a zvoní,"
  },
  {
   "texto": "bouří to a hřímá,"
  },
  {
   "texto": "táhnouť zvony ze všech konců"
  },
  {
   "texto": "do starého Říma."
  },
  {
   "texto": "Velké, malé zvony hučí"
  },
  {
   "texto": "mocně černou nocí,"
  },
  {
   "texto": "ve snu slyším je, jak letí"
  },
  {
   "texto": "tichou Velkonocí."
  },
  {
   "texto": "Cítím, jak ty mocné zvuky"
  },
  {
   "texto": "moje srdce budí,"
  },
  {
   "texto": "jak se srdce rozzvonilo"
  },
  {
   "texto": "v třesoucí se hrudi."
  },
  {
   "texto": "Rozzvonilo jak za dávných,"
  },
  {
   "texto": "jak za dětských časů,"
  },
  {
   "texto": "když jsem ještě rozumíval"
  },
  {
   "texto": "kovovému hlasu."
  },
  {
   "texto": "A teď zase srdce zvučí"
  },
  {
   "texto": "hučí, porozumí,"
  },
  {
   "texto": "v rozechvělé pobožnosti"
  },
  {
   "texto": "v chorus zvonů šumí."
  },
  {
   "texto": "Letí s sebou, šumí s sebou,"
  },
  {
   "texto": "celo rozechvělé,"
  },
  {
   "texto": "jak by putovalo k Římu"
  },
  {
   "texto": "ve kovovém těle."
  },
  {
   "texto": "Skáče, jako v dětském těle"
  },
  {
   "texto": "dětské srdce skáče"
  },
  {
   "texto": "bože, zvuk ten k smrti smutný,"
  },
  {
   "texto": "kdož to, bože, pláče?"
  },
  {
   "texto": "Jaký zvonův šumem zvoní"
  },
  {
   "texto": "zvonek pronikavý? —"
  },
  {
   "texto": "jeho zvuk jak smrtná trýzeň,"
  },
  {
   "texto": "jako uhel žhavý!"
  },
  {
   "texto": "Zvonku truchlé naříkání"
  },
  {
   "texto": "v srdce náhle padne,"
  },
  {
   "texto": "že mu zápal horký, žhavý"
  },
  {
   "texto": "náhle v ledy zchladne."
  },
  {
   "texto": "Znám tě, znám tě, zvonku pláče,"
  },
  {
   "texto": "znám tvé naříkání,"
  },
  {
   "texto": "vždyť jsi předrahému otci"
  },
  {
   "texto": "zvonil k umírání!"
  },
  {
   "texto": "Vždyť tvůj pláč mně srdcem mojím"
  },
  {
   "texto": "věčně, věčně zvoní,"
  },
  {
   "texto": "vždyť i v radovánkách náhle"
  },
  {
   "texto": "moji hlavu skloní!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Vždyť mne ze dne vzvoníš v noci,"
  },
  {
   "texto": "z noci vzbudíš ke dni —"
  },
  {
   "texto": "zvoniľs otci ku hodince"
  },
  {
   "texto": "a to ku poslední!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Těch žhavých zvuků umíráčka,"
  },
  {
   "texto": "těch nikdy nezapomenu,"
  },
  {
   "texto": "vždyť jsem je nehty vryl v svá prsa"
  },
  {
   "texto": "a čelem vtlačil ve stěnu."
  },
  {
   "texto": "Vždyť jsem je vdychal ve své plíce"
  },
  {
   "texto": "a posud mne tam dusily,"
  },
  {
   "texto": "že i mé písně umíráčkem"
  },
  {
   "texto": "v svět krásný zvonit musily."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Otec pomalu umírá"
  },
  {
   "texto": "jako naděj zmírající,"
  },
  {
   "texto": "ret se hýbe, jak by předce"
  },
  {
   "texto": "ještě nechtěl „s bohem!“ říci."
  },
  {
   "texto": "Brzo, brzo dojde míru,"
  },
  {
   "texto": "o bolesti snad už neví,"
  },
  {
   "texto": "ale syn — ten si až zoufá,"
  },
  {
   "texto": "že mu bol dán bez úlevy."
  },
  {
   "texto": "V prsa prázdná bůh sám ví co"
  },
  {
   "texto": "by se ještě smutku shluklo,"
  },
  {
   "texto": "ale srdce přeplněné"
  },
  {
   "texto": "malou kapkou už by puklo."
  },
  {
   "texto": "K zemi hledí oko suché,"
  },
  {
   "texto": "oko v uhel rozohněné,"
  },
  {
   "texto": "čelo rozpálené, horké"
  },
  {
   "texto": "tlačí se ku mrtvé stěně."
  },
  {
   "texto": "Oko uhel, čelo plamen"
  },
  {
   "texto": "a ta stěna je tak chladna —"
  },
  {
   "texto": "bože, což mně neuleví"
  },
  {
   "texto": "žádná slza? žádná — žádná?"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Dále, chaso pomáhačská,"
  },
  {
   "texto": "přibiju si sám ty hřeby!"
  },
  {
   "texto": "Nemohu si sám zavříti"
  },
  {
   "texto": "dvéře k ztracenému nebi?"
  },
  {
   "texto": "Jediný mne milovával —"
  },
  {
   "texto": "a vy pomáhat teď chcete? —"
  },
  {
   "texto": "Kdo si lásku pochovává,"
  },
  {
   "texto": "může sám stát v šírém světě!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nad hlubokým, tmavým hrobem"
  },
  {
   "texto": "černá rakev se tu vznáší —"
  },
  {
   "texto": "ach tak černá, že mně černosť"
  },
  {
   "texto": "všechno světlo z oka plaší."
  },
  {
   "texto": "Že mně rozum rozplašila,"
  },
  {
   "texto": "až ta hlava k prsoum sklesla,"
  },
  {
   "texto": "až ta lebka kolotá se"
  },
  {
   "texto": "jako loďka beze vesla."
  },
  {
   "texto": "Byla by mne umučila"
  },
  {
   "texto": "snad ta nekonečná muka,"
  },
  {
   "texto": "štěstí moje, že mne náhle"
  },
  {
   "texto": "vyrušila cizí ruka."
  },
  {
   "texto": "Štěstí moje, že tak náhle"
  },
  {
   "texto": "slova ruší sen můj těžký:"
  },
  {
   "texto": "„Nemá se snad otčenášek"
  },
  {
   "texto": "předříkávat pouze česky?“"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Otce zde už pochovali"
  },
  {
   "texto": "v tmavou hlínu přehluboko —"
  },
  {
   "texto": "posud žádná, — žádná slza,"
  },
  {
   "texto": "posud jako troud mé oko."
  },
  {
   "texto": "Posud ani jedna horká"
  },
  {
   "texto": "slza neskanula k hrobu,"
  },
  {
   "texto": "aby vykouzlila kvítek"
  },
  {
   "texto": "nade rovem v jarní dobu."
  },
  {
   "texto": "Prsa by se rozskočila,"
  },
  {
   "texto": "rozskočilo by se čelo —"
  },
  {
   "texto": "což ni k jedné slze nemůž'"
  },
  {
   "texto": "rozkvést moje mladé tělo?"
  },
  {
   "texto": "Ve mdlobě se hlava náhle"
  },
  {
   "texto": "k přítelovým prsoum sklání —"
  },
  {
   "texto": "„Aj proč jste se nevyplakal —"
  },
  {
   "texto": "máte to jen z přemáhání.“"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Mne to už zase, otče můj,"
  },
  {
   "texto": "ku hrobu tvému pudí,"
  },
  {
   "texto": "a u hrobu ta pýcha zlá"
  },
  {
   "texto": "se v nás zas obou budí."
  },
  {
   "texto": "Jsme blízko zas i daleko,"
  },
  {
   "texto": "jak jsme si vždycky stáli,"
  },
  {
   "texto": "zas rozpínáme ruce své,"
  },
  {
   "texto": "bychom se neobjali."
  },
  {
   "texto": "Jsme blízko zas, však v oči zas"
  },
  {
   "texto": "druh druhu nepohledí,"
  },
  {
   "texto": "zas velká láska pojí nás —"
  },
  {
   "texto": "a dělí nás zas ledy."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Milovali jsme se, otče,"
  },
  {
   "texto": "jak se milovat jen může,"
  },
  {
   "texto": "ctili jsme se, drahý otče,"
  },
  {
   "texto": "muž jak může ctíti muže."
  },
  {
   "texto": "A předc stála jakás síla"
  },
  {
   "texto": "příkré pýchy mezi námi,"
  },
  {
   "texto": "že jsme žili, jako žijou"
  },
  {
   "texto": "dobří ale chladní známí."
  },
  {
   "texto": "Často o samotě náruč"
  },
  {
   "texto": "toužebně jsme rozepjali,"
  },
  {
   "texto": "a když jsme se sešli — chladně"
  },
  {
   "texto": "proti sobě zas jsme stáli."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Já ležel na rov natažen"
  },
  {
   "texto": "a holý rov jsem líbal,"
  },
  {
   "texto": "a zdálo se mi, jako by"
  },
  {
   "texto": "se rov ten holý hýbal."
  },
  {
   "texto": "A tisknul jsem vždy znovu zas"
  },
  {
   "texto": "ku hlíně ret horoucí"
  },
  {
   "texto": "a při líbání cítil jsem"
  },
  {
   "texto": "tam dole srdce tlouci."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Kéž dobudu si jména věčného,"
  },
  {
   "texto": "kéž vydobudu všechnu světa slávu,"
  },
  {
   "texto": "bych nesmrtelností pak ověnčil,"
  },
  {
   "texto": "o otče drahý, syna tvého hlavu!"
  },
  {
   "texto": "Byľs jedním z těch, jimž svět náš věnem dal,"
  },
  {
   "texto": "by pro život se o den oloupili,"
  },
  {
   "texto": "a za ten hřích, že žít a cítit chtí,"
  },
  {
   "texto": "se vlastní krví bídně vykoupili."
  },
  {
   "texto": "Tvůj život pestrý byl a bohatý"
  },
  {
   "texto": "a přemnohé jsi přežil utrpení,"
  },
  {
   "texto": "a když si páni spánkem hověli,"
  },
  {
   "texto": "budilo chudáka tě kůropění."
  },
  {
   "texto": "A práce celé jaké ovoce ? —"
  },
  {
   "texto": "Že zaplatiľs si místo vlastním v hrobě!"
  },
  {
   "texto": "Kde jiným po radostech oddech dán,"
  },
  {
   "texto": "tam po otroctví mír zakoupiľs sobě."
  },
  {
   "texto": "Nad hrobem strmí prostý, černý kříž"
  },
  {
   "texto": "a čtoucím ochotně tvé praví jmeno —"
  },
  {
   "texto": "tak bude kříž ten sedm let tam stát —"
  },
  {
   "texto": "pak bude také jmeno zapomněno."
  }
 ]
}