{
 "id": "erben-kytice--zlaty-kolovrat",
 "titulo": "Zlatý kolovrat",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/Zlat%C3%BD_kolovrat",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (býti, jíti, míti, znáti: 6 formas frente a 3 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error.",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Okolo lesa pole lán,"
  },
  {
   "texto": "hoj jede, jede z lesa pán,"
  },
  {
   "texto": "na vraném bujném jede koni,"
  },
  {
   "texto": "vesele podkovičky zvoní,"
  },
  {
   "texto": "jede sám a sám."
  },
  {
   "texto": "A před chalupou s koně hop"
  },
  {
   "texto": "a na chalupu: klop, klop, klop!"
  },
  {
   "texto": "„Hola hej! otevřte mi dvéře,"
  },
  {
   "texto": "zbloudil jsem při lovení zvěře,"
  },
  {
   "texto": "dejte vody pít!“"
  },
  {
   "texto": "Vyšla dívčina jako květ,"
  },
  {
   "texto": "neviděl také krásy svět;"
  },
  {
   "texto": "přinesla vody ze studnice,"
  },
  {
   "texto": "stydlivě sedla u přeslice,"
  },
  {
   "texto": "předla, předla len."
  },
  {
   "texto": "Pán stojí, nevěda, co chtěl,"
  },
  {
   "texto": "své velké žízně zapomněl;"
  },
  {
   "texto": "diví se tenké, rovné niti,"
  },
  {
   "texto": "nemůže očí odvrátiti"
  },
  {
   "texto": "z pěkné přadleny."
  },
  {
   "texto": "„Svobodna-li jest ruka tvá,"
  },
  {
   "texto": "ty musíš býti žena má!“"
  },
  {
   "texto": "dívčinu k boku svému vine —"
  },
  {
   "texto": "„Ach pane, nemám vůle jiné,"
  },
  {
   "texto": "než jak máti chce.“"
  },
  {
   "texto": "„A kde je, děvče, máti tvá?"
  },
  {
   "texto": "Nikohoť nevidím tu já.“ —"
  },
  {
   "texto": "„Ach pane, má nevlastní máti"
  },
  {
   "texto": "zejtra se s dcerou domů vrátí,"
  },
  {
   "texto": "vyšly do města.“"
  },
  {
   "texto": "II"
  },
  {
   "texto": "Okolo lesa pole lán,"
  },
  {
   "texto": "hoj jede, jede zase pán;"
  },
  {
   "texto": "na vraném bujném jede koni,"
  },
  {
   "texto": "vesele podkovičky zvoní,"
  },
  {
   "texto": "přímo k chaloupce."
  },
  {
   "texto": "A před chalupou s koně hop"
  },
  {
   "texto": "a na chalupu: klop, klop, klop!"
  },
  {
   "texto": "„Hola! otevřte, milí lidi,"
  },
  {
   "texto": "ať oči moje brzo vidí"
  },
  {
   "texto": "potěšení mé!“"
  },
  {
   "texto": "Vyšla babice, kůže a kost:"
  },
  {
   "texto": "„Hoj, co nám nese vzácný host?“"
  },
  {
   "texto": "„Nesu ti, nesu v domě změnu,"
  },
  {
   "texto": "chci tvoji dceru za svou ženu,"
  },
  {
   "texto": "tu tvou nevlastní.“"
  },
  {
   "texto": "„Hoho, panáčku, div a div,"
  },
  {
   "texto": "kdo by pomyslil jaktěživ?"
  },
  {
   "texto": "Pěkně vás vítám, vzácný hoste"
  },
  {
   "texto": "však ani nevím, pane, kdo jste?"
  },
  {
   "texto": "Jak jste přišel k nám?“"
  },
  {
   "texto": "„Jsem této země král a pán,"
  },
  {
   "texto": "náhodou včera zavolán:"
  },
  {
   "texto": "dám tobě stříbro, dám ti zlato,"
  },
  {
   "texto": "dej ty mně svoji dceru za to,"
  },
  {
   "texto": "pěknou přadlenu.“"
  },
  {
   "texto": "„Ach pane králi, div a div,"
  },
  {
   "texto": "kdo by se nadál jaktěživ?"
  },
  {
   "texto": "Vždyť nejsme hodny, pane králi,"
  },
  {
   "texto": "kéž bychom záslužněji stály"
  },
  {
   "texto": "v milosti vaší!"
  },
  {
   "texto": "Ale však radu, radu mám:"
  },
  {
   "texto": "za cizí — dceru vlastní dám;"
  },
  {
   "texto": "jeť podobna té druhé právě"
  },
  {
   "texto": "jak oko oku v jedné hlavě —"
  },
  {
   "texto": "její nit — hedbáv!“"
  },
  {
   "texto": "„Špatná je, babo, rada tvá,"
  },
  {
   "texto": "vykonej, co poroučím já:"
  },
  {
   "texto": "zejtra, až den se ráno zjasní,"
  },
  {
   "texto": "provodíš dceru svou nevlastní"
  },
  {
   "texto": "na královský hrad!“"
  },
  {
   "texto": "III"
  },
  {
   "texto": "„Vstávej, dceruško, již je čas,"
  },
  {
   "texto": "pan král tě čeká, bude kvas;"
  },
  {
   "texto": "však jsem já ani netušila —"
  },
  {
   "texto": "nu bodejž dobře pořídila"
  },
  {
   "texto": "v hradě královském!“"
  },
  {
   "texto": "„Stroj se, sestřičko moje, stroj,"
  },
  {
   "texto": "v královském hradě bude hoj;"
  },
  {
   "texto": "vysoko jsi se podívala,"
  },
  {
   "texto": "nízko mne, hleďte, zanechala —"
  },
  {
   "texto": "nu jen zdráva buď!“"
  },
  {
   "texto": "„Pojď již, Dorničko naše, pojď,"
  },
  {
   "texto": "aby se nehněval tvůj choť;"
  },
  {
   "texto": "až budeš v lese na rozhraní,"
  },
  {
   "texto": "na domov nevzpomeneš ani —"
  },
  {
   "texto": "pojď jen honem, pojď!“"
  },
  {
   "texto": "„Matko, matičko, řekněte"
  },
  {
   "texto": "nač s sebou ten nůž béřete?“ —"
  },
  {
   "texto": "„Nůž bude dobrý — někde v chladu"
  },
  {
   "texto": "vypíchnem oči zlému hadu —"
  },
  {
   "texto": "pojď jen honem, pojď!“"
  },
  {
   "texto": "„Sestro, sestřičko, řekněte,"
  },
  {
   "texto": "nač tu sekeru nesete?“"
  },
  {
   "texto": "„Sekera dobrá — někde v keři"
  },
  {
   "texto": "useknem hnáty líté zvěři —"
  },
  {
   "texto": "pojď jen honem, pojď!“"
  },
  {
   "texto": "A když již přišly v chlad a keř:"
  },
  {
   "texto": "„Hoj, ty jsi ten had, tys ta zvěř!“"
  },
  {
   "texto": "Hory a doly zaplakaly,"
  },
  {
   "texto": "kterak dvě ženy nakládaly"
  },
  {
   "texto": "s pannou ubohou!"
  },
  {
   "texto": "„Nyní se s panem králem těš,"
  },
  {
   "texto": "těš se s ním, kterakkoli chceš:"
  },
  {
   "texto": "objímej jeho svěží tělo,"
  },
  {
   "texto": "pohlížej na to jasné čelo,"
  },
  {
   "texto": "pěkná přadleno!“"
  },
  {
   "texto": "„Mamičko, kterak udělám,"
  },
  {
   "texto": "kam oči a ty hnáty dám?“ —"
  },
  {
   "texto": "„Nenechávej jich podle těla,"
  },
  {
   "texto": "ať někdo jich zas nepřidělá —"
  },
  {
   "texto": "radš je s sebou vem.“"
  },
  {
   "texto": "A když již zašly za tu chvoj:"
  },
  {
   "texto": "„Nic ty se, dcero má, neboj,"
  },
  {
   "texto": "však jsi podobna té tam právě"
  },
  {
   "texto": "jak oko oku v jedné hlavě —"
  },
  {
   "texto": "neboj ty se nic!“"
  },
  {
   "texto": "A když již byly hradu blíž,"
  },
  {
   "texto": "pan král vyhlíží z okna již;"
  },
  {
   "texto": "vychází s pány svými v cestu,"
  },
  {
   "texto": "přivítá matku i nevěstu,"
  },
  {
   "texto": "zrady netuše."
  },
  {
   "texto": "I byla svatba — zralý hřích,"
  },
  {
   "texto": "panna nevěsta samý smích;"
  },
  {
   "texto": "i byly hody, radování,"
  },
  {
   "texto": "plesy a hudby bez ustání"
  },
  {
   "texto": "do sedmého dne."
  },
  {
   "texto": "A když zasvítal osmý den,"
  },
  {
   "texto": "král musí jíti s vojsky ven:"
  },
  {
   "texto": "„Měj se tu dobře, paní moje,"
  },
  {
   "texto": "já jedu do krutého boje,"
  },
  {
   "texto": "na nepřítele."
  },
  {
   "texto": "Navrátím-li se z bitvy zpět,"
  },
  {
   "texto": "omladne naší lásky květ!"
  },
  {
   "texto": "Zatím na věrnou mou památku"
  },
  {
   "texto": "hleď sobě pilně kolovrátku,"
  },
  {
   "texto": "pilně doma přeď!“"
  },
  {
   "texto": "IV"
  },
  {
   "texto": "V hluboké pusté křovině"
  },
  {
   "texto": "kterak se vedlo dívčině?"
  },
  {
   "texto": "Šest otevřených proudů bylo,"
  },
  {
   "texto": "z nich se jí živobytí lilo"
  },
  {
   "texto": "na zelený mech."
  },
  {
   "texto": "Vzešlo jí náhle štěstí moc,"
  },
  {
   "texto": "nynčko jí hrozí smrti noc:"
  },
  {
   "texto": "tělo již chladne, krev se sedá —"
  },
  {
   "texto": "běda té době, běda, běda,"
  },
  {
   "texto": "když ji spatřil král!"
  },
  {
   "texto": "A tu se z lesních kdesi skal"
  },
  {
   "texto": "stařeček nevídaný vzal:"
  },
  {
   "texto": "šedivé vousy po kolena —"
  },
  {
   "texto": "to tělo vloživ na ramena"
  },
  {
   "texto": "v jeskyni je nes."
  },
  {
   "texto": "„Vstaň, mé pachole, běž, je chvat,"
  },
  {
   "texto": "vezmi ten zlatý kolovrat:"
  },
  {
   "texto": "v královském hradě jej prodávej,"
  },
  {
   "texto": "za nic jiného však nedávej"
  },
  {
   "texto": "nežli za nohy.“ —"
  },
  {
   "texto": "Pachole v bráně sedělo,"
  },
  {
   "texto": "zlatý kolovrat drželo."
  },
  {
   "texto": "Královna z okna vyhlížela:"
  },
  {
   "texto": "„Kéž bych ten kolovrátek měla"
  },
  {
   "texto": "z ryzího zlata!“"
  },
  {
   "texto": "„Jděte se, matko, pozeptat,"
  },
  {
   "texto": "zač je ten zlatý kolovrat?“"
  },
  {
   "texto": "„Kupte, paničko, drahý není,"
  },
  {
   "texto": "můj otec příliš nevycení:"
  },
  {
   "texto": "za dvě nohy jest.“"
  },
  {
   "texto": "„Za nohy? Ajaj, divná věc!"
  },
  {
   "texto": "Ale já chci jej míti přec:"
  },
  {
   "texto": "jděte, mamičko, do komory,"
  },
  {
   "texto": "jsou tam ty nohy naší Dory,"
  },
  {
   "texto": "dejte mu je zaň.“"
  },
  {
   "texto": "Pachole nohy přijalo,"
  },
  {
   "texto": "do lesa zpátky spěchalo. —"
  },
  {
   "texto": "„Podej mi, chlapče, živé vody,"
  },
  {
   "texto": "nechť bude tělo beze škody,"
  },
  {
   "texto": "jako bývalo.“"
  },
  {
   "texto": "A ránu k ráně přiložil,"
  },
  {
   "texto": "a v nohou oheň zas ožil,"
  },
  {
   "texto": "a v jeden celek srostlo tělo,"
  },
  {
   "texto": "jako by vždycky bylo celo,"
  },
  {
   "texto": "bez porušení."
  },
  {
   "texto": "„Jdi, mé pachole, k polici,"
  },
  {
   "texto": "vezmi tu zlatou přeslici:"
  },
  {
   "texto": "v královském hradě ji prodávej,"
  },
  {
   "texto": "za nic jiného však nedávej,"
  },
  {
   "texto": "nežli za ruce.“ —"
  },
  {
   "texto": "Pachole v bráně sedělo,"
  },
  {
   "texto": "přeslici v rukou drželo."
  },
  {
   "texto": "Královna z okna vyhlížela:"
  },
  {
   "texto": "„Och, kéž bych tu přesličku měla"
  },
  {
   "texto": "ke kolovrátku!"
  },
  {
   "texto": "Vstaňte, mamičko, z lavice,"
  },
  {
   "texto": "ptejte se, zač ta přeslice?“ —"
  },
  {
   "texto": "„Kupte, paničko, drahá není,"
  },
  {
   "texto": "můj otec příliš nevycení,"
  },
  {
   "texto": "za dvě ruce jest.“"
  },
  {
   "texto": "„Za ruce!? Divná, divná věc!"
  },
  {
   "texto": "Ale já ji chci míti přec:"
  },
  {
   "texto": "jděte, mamičko, do komory,"
  },
  {
   "texto": "jsou tam ty ruce naší Dory,"
  },
  {
   "texto": "přineste mu je.“"
  },
  {
   "texto": "Pachole ruce přijalo,"
  },
  {
   "texto": "do lesa zpátky spěchalo. —"
  },
  {
   "texto": "„Podej mi, chlapče, živé vody,"
  },
  {
   "texto": "nechť bude tělo beze škody,"
  },
  {
   "texto": "jako bývalo.“"
  },
  {
   "texto": "A ránu k ráně přiložil,"
  },
  {
   "texto": "a v rukou oheň zas ožil;"
  },
  {
   "texto": "a v jeden celek srostlo tělo,"
  },
  {
   "texto": "jako by vždycky bylo celo,"
  },
  {
   "texto": "bez porušení."
  },
  {
   "texto": "„Skoč, hochu, na cestu se měj,"
  },
  {
   "texto": "mám zlatý kužel na prodej:"
  },
  {
   "texto": "v královském hradě jej prodávej,"
  },
  {
   "texto": "za nic jiného však nedávej,"
  },
  {
   "texto": "nežli za oči.“ —"
  },
  {
   "texto": "Pachole v bráně sedělo,"
  },
  {
   "texto": "zlatý kuželík drželo."
  },
  {
   "texto": "Královna z okna vyhlížela:"
  },
  {
   "texto": "„Kéž bych ten kuželíček měla"
  },
  {
   "texto": "na tu přesličku!"
  },
  {
   "texto": "Vstaňte, mamičko, jděte zas,"
  },
  {
   "texto": "ptejte se, zač ten kužel as?“ —"
  },
  {
   "texto": "„Za oči, paní, jinak není,"
  },
  {
   "texto": "tak mi dal otec poručení,"
  },
  {
   "texto": "za dvě oči jest.“"
  },
  {
   "texto": "„Za oči!? Neslýchaná věc!"
  },
  {
   "texto": "A kdo je, chlapče, tvůj otec?“ —"
  },
  {
   "texto": "„Netřeba znáti otce mého:"
  },
  {
   "texto": "kdo by ho hledal, nenajde ho,"
  },
  {
   "texto": "jinak přijde sám.“ —"
  },
  {
   "texto": "„Mámo, mamičko, co počít?"
  },
  {
   "texto": "A já ten kužel musím mít!"
  },
  {
   "texto": "Jděte tam zase do komory,"
  },
  {
   "texto": "jsou tam ty oči naší Dory,"
  },
  {
   "texto": "ať je odnese.“"
  },
  {
   "texto": "Pachole oči přijalo,"
  },
  {
   "texto": "do lesa zpátky spěchalo. —"
  },
  {
   "texto": "„Podej mi, chlapče, živé vody,"
  },
  {
   "texto": "nechť bude tělo beze škody,"
  },
  {
   "texto": "jako kdy prve.“"
  },
  {
   "texto": "A oči v důlky položil,"
  },
  {
   "texto": "a zhaslý oheň zas ožil;"
  },
  {
   "texto": "a panna vůkol pohlížela —"
  },
  {
   "texto": "však nikoho tu neviděla,"
  },
  {
   "texto": "než se samotnu."
  },
  {
   "texto": "V"
  },
  {
   "texto": "A když byly tři neděle,"
  },
  {
   "texto": "král jede z vojny vesele:"
  },
  {
   "texto": "„A jak se má, má paní milá,"
  },
  {
   "texto": "a zdalis pamětliva byla"
  },
  {
   "texto": "mých posledních slov?“"
  },
  {
   "texto": "„Och, já je v srdci nosila,"
  },
  {
   "texto": "a hleďte, co jsem koupila:"
  },
  {
   "texto": "jediný mezi kolovraty,"
  },
  {
   "texto": "přeslici, kužel — celý zlatý,"
  },
  {
   "texto": "vše to z lásky k vám!“"
  },
  {
   "texto": "„Pojď se, má paní, posadit,"
  },
  {
   "texto": "upřeď mi z lásky zlatou nit.“ —"
  },
  {
   "texto": "Ke kolovrátku chutě sedla,"
  },
  {
   "texto": "jak zatočila, celá zbledla —"
  },
  {
   "texto": "běda, jaký zpěv!"
  },
  {
   "texto": "„Vrrr — zlou to předeš nit!"
  },
  {
   "texto": "Přišla jsi krále ošidit:"
  },
  {
   "texto": "nevlastní sestru jsi zabila,"
