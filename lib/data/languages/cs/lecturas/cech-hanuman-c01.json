{
 "id": "cech-hanuman-c01",
 "titulo": "Zpěv 1",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Hanuman",
 "fuente": "cs.wikisource.org, «Hanuman»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (1 formas) con el actual en «-t» (2). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-hanuman",
  "titulo": "Hanuman",
  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Vzdychal jsem jak světec pouště"
  },
  {
   "texto": "po vidinách rajské síně,"
  },
  {
   "texto": "zatím rarach pokušitel"
  },
  {
   "texto": "vhopkoval mi do jeskyně,"
  },
  {
   "texto": "po mně drze tančil vzhůru,"
  },
  {
   "texto": "usadil se nad nosem"
  },
  {
   "texto": "jako bůžek na pagodě"
  },
  {
   "texto": "s bajným v ruce lotosem."
  },
  {
   "texto": "Zamáv čaromocným květem"
  },
  {
   "texto": "a hned tisíc divných knotků,"
  },
  {
   "texto": "okřídlených pitvor, gnomů,"
  },
  {
   "texto": "skřítků, rarášků a šotků"
  },
  {
   "texto": "před mušlí se vyrojilo,"
  },
  {
   "texto": "v nížto mořští koníci"
  },
  {
   "texto": "vezli píseň rozpustilou,"
  },
  {
   "texto": "rolničkami zvonící."
  },
  {
   "texto": "Nadarmo jsem volal: Vari!"
  },
  {
   "texto": "Jinde huď tu skočnou notu"
  },
  {
   "texto": "na cimbále žertů sistrem"
  },
  {
   "texto": "satirických hran a hrotů."
  },
  {
   "texto": "Já chci píseň, jejíž struny"
  },
  {
   "texto": "z duše krásou nadšené"
  },
  {
   "texto": "ryzím zlatem poesie"
  },
  {
   "texto": "zvoní hymny vznešené."
  },
  {
   "texto": "A tvůj úbor fantastický,"
  },
  {
   "texto": "falešné ty cizí cety!"
  },
  {
   "texto": "Řeknou: Tolik vábných květů"
  },
  {
   "texto": "čeká jenom na poety"
  },
  {
   "texto": "v našich luzích, tolik hrdin"
  },
  {
   "texto": "v dějů knize domácí -"
  },
  {
   "texto": "a ten kams až do Indie"
  },
  {
   "texto": "pro šašky se trmácí! -"
  },
  {
   "texto": "Marno všecko: dále chřestí"
  },
  {
   "texto": "rolničkami v bujném skoku,"
  },
  {
   "texto": "hledí na mne vyzývavě,"
  },
  {
   "texto": "posměch v jiskřícím se oku,"
  },
  {
   "texto": "lichým duhojasem křídel"
  },
  {
   "texto": "papírových třepetá,"
  },
  {
   "texto": "jako můra krouží vůkol,"
  },
  {
   "texto": "škemrá: Pusť mne do světa!"
  },
  {
   "texto": "Nuže, leť si! Zasviť klamně"
  },
  {
   "texto": "nalepeným křídlem rajek,"
  },
  {
   "texto": "poetické duše chytře"
  },
  {
   "texto": "vlákej do pralesa bajek"
  },
  {
   "texto": "a pak mrkvičku jim strouhej"
  },
  {
   "texto": "na houpačce liany,"
  },
  {
   "texto": "třeba pohoršilas moudré"
  },
  {
   "texto": "neindické bramany!"
  },
  {
   "texto": "II"
  },
  {
   "texto": "Kdesi ve pralesích Hindostanu"
  },
  {
   "texto": "rozvaliny města obrovského"
  },
  {
   "texto": "truchlí v upomínkách slávy zašlé,"
  },
  {
   "texto": "nádhery, jež klesla do hrobu,"
  },
  {
   "texto": "sníce o velebném davu chrámů,"
  },
  {
   "texto": "o hemžení nábožného lidu,"
  },
  {
   "texto": "o palácích, kde se drahokamy"
  },
  {
   "texto": "třpytil prestol pyšných nabobů."
  },
  {
   "texto": "Nyní trosky pagod, minaretů,"
  },
  {
   "texto": "hrdých radžů rozkotaná sídla"
  },
  {
   "texto": "skrývají se pod vějíře palem,"
  },
  {
   "texto": "pod mohutné koše banánů:"
  },
  {
   "texto": "prales ukryl soucitně tu spoustu"
  },
  {
   "texto": "v těžký rubáš z lupení a květů,"
  },
  {
   "texto": "na líc slávy zahynulé spředl"
  },
  {
   "texto": "v hustý závoj sterou lianu."
  },
  {
   "texto": "A v té vzdušné přízi úponkové,"
  },
  {
   "texto": "jako mrštná chasa námořnická"
  },
  {
   "texto": "v síti lan, rod opic dovádivých"
  },
  {
   "texto": "provádí své reje závratné;"
  },
  {
   "texto": "báječného opa Hanumana"
  },
  {
   "texto": "(s nímžto Višnu, přijav tělo Ramy,"
  },
  {
   "texto": "slavně dobyl výspy obrů, Lanky)"
  },
  {
   "texto": "potomstvo to jesti posvátné."
  },
  {
   "texto": "Před časy zde opice ty svaté"
  },
  {
   "texto": "chovány jsou v chrámu velkolepém"
  },
  {
   "texto": "něžnou péčí hindů bohulibých"
  },
  {
   "texto": "pod záštitou Durgy bohyně,"
  },
  {
   "texto": "a když chrám i s městem klesl v rumy"
  },
  {
   "texto": "zlobou nepřátel, zde pozůstaly"
  },
  {
   "texto": "nad troskami, bydliteli jsouce"
  },
  {
   "texto": "jedinými v této pustině."
  },
  {
   "texto": "Sytily se různým sladkým plodem"
  },
  {
   "texto": "lesních obrů, jejich zeleň hustou"
  },
  {
   "texto": "oživoval z jitra do večera"
  },
  {
   "texto": "opičí té obce vřesk a rej;"
  },
  {
   "texto": "pitvorných těl byly; ohon dlouhý"
  },
  {
   "texto": "větví hbitě chápal se jak laso;"
  },
  {
   "texto": "pod náčelkou chlupů rozježených"
  },
  {
   "texto": "téměř lidský měly obličej."
  },
  {
   "texto": "Žily po způsobu jiných opů,"
  },
  {
   "texto": "ale po zákonu zasvěceném"
  },
  {
   "texto": "vždycky jeden mezi nimi králem"
  },
  {
   "texto": "uznáván byl z času dávného;"
  },
  {
   "texto": "dědila se královská ta hodnost"
  },
  {
   "texto": "utvrzeným posloupnosti řádem"
  },
  {
   "texto": "přímo od božského Hanumana,"
  },
  {
   "texto": "opičího reka slavného."
  },
  {
   "texto": "Poslední teď Hanuman jim vzrůstal"
  },
  {
   "texto": "pod laskavou péčí jasné matky,"
  },
  {
   "texto": "ctností mnohou všechna srdce opí"
  },
  {
   "texto": "v tuchu příští slávy ztápěje;"
  },
  {
   "texto": "ale Parvati svým hrozným srpem"
  },
  {
   "texto": "srubla list, jenž poupě skvostné stínil,"
  },
  {
   "texto": "a žár sudby nepřátelské sžehl"
  },
  {
   "texto": "všechny hrdé sny a naděje."
  },
  {
   "texto": "Kdys ve stinném koši sykomory"
  },
  {
   "texto": "královna jej v loktech uspávala,"
  },
  {
   "texto": "něžně odstraňujíc z hebké srsti"
  },
  {
   "texto": "smělce ssající tam vzácnou krev;"
  },
  {
   "texto": "náhle vyšel z bambusové houšti"
  },
  {
   "texto": "netvor lidský v námořnickém šatě,"
  },
  {
   "texto": "neobměkčil kamenné mu srdce"
  },
  {
   "texto": "mateřské té něhy tklivý zjev:"
  },
  {
   "texto": "rozlehl se lesem rachot, výkřik,"
  },
  {
   "texto": "dým se vyvalil a shůry kněžna"
  },
  {
   "texto": "kácela se s listnatého trůnu,"
  },
  {
   "texto": "zastižena smrtným olovem."
  },
  {
   "texto": "Vrah pak syna z loktů matky mroucí"
  },
  {
   "texto": "vyrval, odvlék na mohutný koráb,"
  },
  {
   "texto": "do neznámé odvezl jej dálky"
  },
  {
   "texto": "spoutaného mrzkým okovem."
  },
  {
   "texto": "III"
  },
  {
   "texto": "Jaké boly zmítaly tvým nitrem,"
  },
  {
   "texto": "Hanumane ubohý,"
  },
  {
   "texto": "když ti v dálce soumrak zahaloval"
  },
  {
   "texto": "rodné lesní ostrohy,"
  },
  {
   "texto": "když jsi s kormy rozhlížel se v hoři"
  },
  {
   "texto": "po neznámém, nekonečném moři"
  },
  {
   "texto": "pod hvězdami cizí oblohy!"
  },
  {
   "texto": "Ty, kol jehož skrání svity hvězdné"
  },
  {
   "texto": "tkala dávnověká báj,"
  },
  {
   "texto": "jehož chválou zněla svatá Ganga,"
  },
  {
   "texto": "zněl i sněžný Himalaj,"
  },
  {
   "texto": "jemuž Indů lid se zbožně kořil -"
  },
  {
   "texto": "nyní hrubých šprýmů terč jsi tvořil"
  },
  {
   "texto": "pro surovou námořnickou láj."
  },
  {
   "texto": "Tebe, jenž jsi býval světlou modlou"
  },
  {
   "texto": "bytostí všech sourodných,"
  },
  {
   "texto": "kterýs poznával jen vroucí lásku"
  },
  {
   "texto": "v matky loktech lahodných,"
  },
  {
   "texto": "v jejích pohledech tak plných něhy -"
  },
  {
   "texto": "tebe nutily teď důtek šlehy"
  },
  {
   "texto": "do poklon a kejklů nehodných."
  },
  {
   "texto": "Takto vzácný zajatec se plavil"
  },
  {
   "texto": "mnohou nocí, mnohým dnem;"
  },
  {
   "texto": "cizokrajných břehů pestré zjevy"
  },
  {
   "texto": "vůkol míjely jak snem,"
  },
  {
   "texto": "až pak v dáli koráb na severu"
  },
  {
   "texto": "v albionské mlhy smutném šeru"
  },
  {
   "texto": "stanul ve přístavu hlomozném."
  },
  {
   "texto": "Tamo v dýmu námořnické krčmy"
  },
  {
   "texto": "na rohožce z rákosu"
  },
  {
   "texto": "op se choulil smuten - až tu náhle"
  },
  {
   "texto": "větve známých kolosů"
  },
  {
   "texto": "rozpjaly se nad ním přeširoko,"
  },
  {
   "texto": "z tůně šeřivé jak báje oko"
  },
  {
   "texto": "zasvítil mu kalich lotosu."
  },
  {
   "texto": "Listů obrovitých řásná zeleň"
  },
  {
   "texto": "osvěžila skrání plam,"
  },
  {
   "texto": "větví soumrakem se motýl zaskvěl"
  },
  {
   "texto": "křídlatý jak drahokam,"
  },
  {
   "texto": "svitla listím datle zlatohnědá,"
  },
  {
   "texto": "sáhl po ní - chytil vzduch - ó běda,"
  },
  {
   "texto": "všechno bylo pouhý spánku klam!"
  },
  {
   "texto": "Z jitra pán mu zřídil roucho vzácné:"
  },
  {
   "texto": "dobrodružný jevil tvar"
  },
  {
   "texto": "klobouk dvourohý a chochol zářil"
  },
  {
   "texto": "báječně jak víly dar;"
  },
  {
   "texto": "rudý frak, pln okras filigránských,"
  },
  {
   "texto": "klátil párem šosů dlouhatánských"
  },
  {
   "texto": "kolem fialových šaravar."
  },
  {
   "texto": "Sedě na kvikavém kolovrátku,"
  },
  {
   "texto": "pánovu jenž tížil plec,"
  },
  {
   "texto": "vypravil se na pouť uměleckou"
  },
  {
   "texto": "do Francouz, Vlach, do Němec,"
  },
  {
   "texto": "od rév jihu k jedlím na severu"
  },
  {
   "texto": "půl Evropy proputoval věru"
  },
  {
   "texto": "opičí ten kníže bezzemec."
  },
  {
   "texto": "Vítán dětí jásotem a smíchem,"
  },
  {
   "texto": "musel jeviti svůj um"
  },
  {
   "texto": "v ruchu měst i před vesnickou krčmou,"
  },
  {
   "texto": "bavit obecenstva tlum,"
  },
  {
   "texto": "uklánět se dvorně, klobouk snímat,"
  },
  {
   "texto": "v karty hrát, z lodnické dýmky dýmat,"
  },
  {
   "texto": "chodit po hlavě a píti rum."
  },
  {
   "texto": "Obvázav si zručně kolem šíje"
  },
  {
   "texto": "bílé cípy ubrousku,"
  },
  {
   "texto": "krmě krájel, pěkně na vidličku"
  },
  {
   "texto": "sbíral kousek po kousku,"
  },
  {
   "texto": "sklepníku frank podal velkodušně,"
  },
  {
   "texto": "posléz párátka též užil slušně,"
  },
  {
   "texto": "víno čistě setřev s licousků."
  },
  {
   "texto": "Peníze pak sbíral v pestrý klobouk;"
  },
  {
   "texto": "někdy umělci též vhod"
  },
  {
   "texto": "z ručky štědré zapadl tam sladký"
  },
  {
   "texto": "sadu severního plod,"
  },
  {
   "texto": "spával v loktech svého velitele -"
  },
  {
   "texto": "zdálo se, že pustil z mysli cele"
  },
  {
   "texto": "dálný prales a svůj božský rod."
  },
  {
   "texto": "Ale posléz omrzela plavce"
  },
  {
   "texto": "kočovnická světem pouť,"
  },
  {
   "texto": "zatoužil zas navinovat lana,"
  },
  {
   "texto": "širým oceánem plout,"
  },
  {
   "texto": "a tak jednou vstoupil ve přístavě"
  },
  {
   "texto": "na koráb, jenž uchystal se právě"
  },
  {
   "texto": "plachty k cestě dálné rozepnout. -"
  },
  {
   "texto": "Impresario kýs geniální"
  },
  {
   "texto": "záměrem byl velkým jat"
  },
  {
   "texto": "jako Alexandr umělecký"
  },
  {
   "texto": "dobýt Himalaje pat,"
  },
  {
   "texto": "musám žíznivým v panenské půdě"
  },
  {
   "texto": "pod Indem a Gangou, na Nerbudě"
  },
  {
   "texto": "nový živný pramen vytepat."
  },
  {
   "texto": "A hned sbíhaly se mimů davy"
  },
  {
   "texto": "z východu a západu,"
  },
  {
   "texto": "sletěly se baleriny, divy"
  },
  {
   "texto": "chtivé slávy, pokladů,"
  },
  {
   "texto": "dobýt piruetou, ariemi"
  },
  {
   "texto": "Golkondu tam s diamanty všemi,"
  },
  {
   "texto": "všechny skvosty Allahabadu."
  },
  {
   "texto": "Snily zlatovlasé primadony,"
  },
  {
   "texto": "jak jim sprchne do klínů"
  },
  {
   "texto": "zlatý dešť a liják almandinů,"
  },
  {
   "texto": "safírů a rubínů,"
  },
  {
   "texto": "a sbor baletní tam čekal milce"
  },
  {
   "texto": "pod turbany z perel, chystal štilce"
  },
  {
   "texto": "pro velebné nosy bramínů."
  },
  {
   "texto": "Stěží koráb, archa umělecká,"
  },
  {
   "texto": "stačil pojmout do svých cel"
  },
  {
   "texto": "vše, co svět, jenž z prken buduje se,"
  },
  {
   "texto": "k Indu přeplaviti chtěl:"
  },
  {
   "texto": "ohromnou tu spoustu různé zdoby,"
  },
  {
   "texto": "beden, krabic, skřínek, garderoby,"
  },
  {
   "texto": "vaty, vlásenek a líčidel."
  },
  {
   "texto": "Zpěvem hlaholíc loď Argonautů"
  },
  {
   "texto": "hrdě brázdí mořský luh."
  },
  {
   "texto": "Na ní lodníkem pán Hanumanův"
  },
  {
   "texto": "a s ním op dlí, věrný druh;"
  },
  {
   "texto": "ó jak svitlo Hanumanu oko,"
  },
  {
   "texto": "když kol něho volně, přeširoko"
  },
  {
   "texto": "rozepjal se oceánu kruh!"
  },
  {
   "texto": "Jaké city srdcem jeho vlály,"
  },
  {
   "texto": "an skrz lan a ráhen mříž"
  },
  {
   "texto": "nocí teplou opět v záři skvostné"
  },
  {
   "texto": "uvítal ho jihu kříž,"
  },
  {
   "texto": "když loď, na obzoru zamodralém"
  },
  {
   "texto": "zas mu jevíc sličné sbory palem,"
  },
  {
   "texto": "k otčině ho nesla blíž a blíž!"
  },
  {
   "texto": "A čím blíže k ní, op častěj v dumy"
  },
  {
   "texto": "jakés vážné poklesá."
  },
  {
   "texto": "Jednou vyskočil - zrak postih v dáli"
  },
  {
   "texto": "rodného zjev pralesa - -"
  },
  {
   "texto": "než tu náhlá bouře vzteklou rukou"
  },
  {
   "texto": "rozvířila hudbou hromozvukou"
  },
  {
   "texto": "moře hlubinu i nebesa."
  },
  {
   "texto": "Hoj, tu na korábu přenešťastném"
  },
  {
   "texto": "davy pěvců, aktérů"
  },
  {
   "texto": "tragedii svedly srdcelomnou,"
  },
  {
   "texto": "hrůzně krásnou operu,"
  },
  {
   "texto": "k nížto v tympany a tuby řvoucí"
  },
  {
   "texto": "bouře hudla průvod dušervoucí,"
  },
  {
   "texto": "o němž nesnilo se Wagneru."
  },
  {
   "texto": "Hanuman z té vřavy vyšplhal se"
  },
  {
   "texto": "na stožár - vtom blesku žeh -"
  },
  {
   "texto": "hromu rachot - vrchol stěžně klesl"
  },
  {
   "texto": "v rozkypělé vlny šleh"
  },
  {
   "texto": "a s opičkou pak, jež se na něm pevně"
  },
  {
   "texto": "držela, hloub oceánu hněvně"
  },
  {
   "texto": "vyplila jej na indický břeh."
  },
  {
   "texto": "IV"
  },
  {
   "texto": "Ó pralese, ty spousto nádherná"
  },
  {
   "texto": "krás, velebnosti, kouzel, hrůz i žasů,"
  },
  {
   "texto": "ty pokladnice tvarů nezměrná"
  },
  {
   "texto": "i barev, světel, stínů, vůní, hlasů,"
  },
  {
   "texto": "jak půvabně jsi rázem procitla"
  },
  {
   "texto": "dne polibkem! Jak hrdá temena"
  },
  {
   "texto": "tvých velikánů pod ním zasvitla,"
  },
  {
   "texto": "vrcholků valných zeleň plamenná,"
  },
  {
   "texto": "vln smaragdových bleskotavé moře!"
  },
  {
   "texto": "Leč korunami knížat pralesa"
  },
  {
   "texto": "i v nižší oblasti den poklesá,"
  },
  {
   "texto": "kde druhý les, těm podrost obrům tvoře,"
  },
  {
   "texto": "však spodní houšti sám jsa mocný štít,"
  },
  {
   "texto": "své listy svěží, veliké a malé"
  },
  {
   "texto": "v bohatství forem skládá neskonalé."
  },
  {
   "texto": "Tu báječné je nakupení zřít"
  },
  {
   "texto": "vějířů ohromných a chocholů,"
  },
  {
   "texto": "jež s palmových se šíří vrcholů"
  },
  {
   "texto": "a složeny jsou skvostně, divukrásně"
  },
  {
   "texto": "z čepelů zelených a jemné třásně."
  },
  {
   "texto": "V tom listů mnohotvárném zpeření"
  },
  {
   "texto": "noc potýká se hravě s denním svitem"
  },
  {
   "texto": "v odstínu sterém, vábně rozmanitém,"
  },
  {
   "texto": "až dolej hustší, hustší šeření"
  },
  {
   "texto": "přechází zvolna v soumrak pověčný,"
  },
  {
   "texto": "kam do úžasné směsi bylin všakých,"
  },
  {
   "texto": "v mok, plíseň, v kořenů spleť křivolakých"
  },
  {
   "texto": "den nikdy nesklání zrak všetečný."
  },
  {
   "texto": "Než ve výši svit budí na sta duh"
  },
  {
   "texto": "a pablesků. Tam rozepjatý v kruh"
  },
  {
   "texto": "terč lupenů, jichž konce zohýbané"
  },
  {
   "texto": "jak zdobné třepení jej vroubí kol,"
  },
  {
   "texto": "uprostřed šera osaměle plane"
  },
  {
   "texto": "jak zlatý velmogula parasol."
  },
  {
   "texto": "Zde liana, jež visí girlandami"
  },
  {
   "texto": "se sykomory, v zápleti svých spon"
  },
  {
   "texto": "hrá zvonců sličných barvitými plamy,"
  },
  {
   "texto": "že řek bys: rubín, safír, chalcedon"
  },
  {
   "texto": "to svítí s nádherného bandalíru -"
  },
  {
   "texto": "den rozmetal zde skvostů plnou míru."
  },
  {
   "texto": "A pralesem teď táhne svěží dech,"
  },
  {
   "texto": "jak vál by z Jitra slastiplné hrudi,"
  },
  {
   "texto": "sto vůní nese, v listech šeptá všech,"
  },
  {
   "texto": "ruch žití mnohotvárný kolkol budí."
  },
  {
   "texto": "Tu papoušek svým skřekem slunce zdraví"
  },
  {
   "texto": "a rozkyvuje purpur třepetavý"
  },
  {
   "texto": "svých křídel, čechrá smaragdový bok."
  },
  {
   "texto": "Páv divoký se míhá v přeletu"
  },
  {
   "texto": "jak zářný oblak z duhobarvých ok."
  }
 ]
}