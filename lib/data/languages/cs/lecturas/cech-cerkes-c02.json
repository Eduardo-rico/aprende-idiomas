 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "a když pěje nápěvy své vlasti,"
  },
  {
   "texto": "oko vlhne, srdce v těle skáče -"
  },
  {
   "texto": "Ulétlo mi navždy sladké ptáče!"
  },
  {
   "texto": "Z počátku jsem doufal v lásky štěstí."
  },
  {
   "texto": "Její úsměv, pohled laskavý,"
  },
  {
   "texto": "zamávnuté v dálku pozdravy,"
  },
  {
   "texto": "zdálo se, že tichou přízeň věstí;"
  },
  {
   "texto": "škádlívá mne - nevědomky svodná -"
  },
  {
   "texto": "svěřuje se mi jak sestra rodná."
  },
  {
   "texto": "Povídej mi - říká - o Čerkesích,"
  },
  {
   "texto": "o modrých tam horách, černých lesích!"
  },
  {
   "texto": "Povídej, co staří kozáci"
  },
  {
   "texto": "nad ohněm si vypravují strážným!"
  },
  {
   "texto": "Hovořím jí s obličejem vážným"
  },
  {
   "texto": "o bóře, jak v podzim burácí"
  },
  {
   "texto": "nov´rossijským dolem, o horalech,"
  },
  {
   "texto": "jak nám v lítém vzdorovali boji,"
  },
  {
   "texto": "o brnění jejich, o kinžalech,"
  },
  {
   "texto": "o žen jejich mravu, pestrém kroji,"
  },
  {
   "texto": "o Maruši hříšné, jak jí hostem"
  },
  {
   "texto": "na komůrce býval žhavý Změj,"
  },
  {
   "texto": "jiskřivým až chýš zapálil chvostem …"
  },
  {
   "texto": "Ona sedí, krásný obličej"
  },
  {
   "texto": "bílou rukou snivě podepírá,"
  },
  {
   "texto": "a zrak její - hvězda v zášeří -"
  },
  {
   "texto": "zastíněný svislou kadeří,"
  },
  {
   "texto": "každé slovo ode rtů mi sbírá."
  },
  {
   "texto": "Koni mému sladkých šeptá jmen,"
  },
  {
   "texto": "květ mu vplétá, operlený rosou,"
  },
  {
   "texto": "do hřívy, ba časem ve třemen"
  },
  {
   "texto": "švižně vynáší se nožkou bosou,"
  },
  {
   "texto": "v sedle kolébá se s vábným pychem,"
  },
  {
   "texto": "„Urá! urá!“ s jasným volá smíchem."
  },
  {
   "texto": "Jednou k stanici mne provázela."
  },
  {
   "texto": "Stín již ležel v mořském chobotu"
  },
  {
   "texto": "a hor nad ním temena se rděla;"
  },
  {
   "texto": "racek v bílých křídel tepotu"
  },
  {
   "texto": "nad vlnou se vznášel. Zraky její"
  },
  {
   "texto": "k moři upřené se slzou skvějí."
  },
  {
   "texto": "„Kam tak hledíš,“ ptám se, „v roztoužení?“"
  },
  {
   "texto": "„Na čele tam z dálné končiny"
  },
  {
   "texto": "cítím vánek - pozdrav otčiny!\" -"
  },
  {
   "texto": "„Nač jí želet? Což tu krásno není!“ -"
  },
  {
   "texto": "„Ovšem krásno! Otčina má chladná"
  },
  {
   "texto": "bledším přepjata je blankytem,"
  },
  {
   "texto": "nejsou údolí tam věčně vnadná,"
  },
  {
   "texto": "ani hory v sněhu věčitém,"
  },
  {
   "texto": "aniž racek nad vodou se bělá,"
  },
  {
   "texto": "nevěnčí tam réva stromů čela,"
  },
  {
   "texto": "ba, ni květina tak žárným zrakem"
  },
  {
   "texto": "nevyzírá z temné houštiny -"
  },
  {
   "texto": "a přec letěla bych s každým mrakem,"
  },
  {
   "texto": "s každým ptákem na klín otčiny. -“"
  },
  {
   "texto": "Však již dosti vzpomínání toho,"
  },
  {
   "texto": "chvíle blahé - nebylo jich mnoho!"
  },
  {
   "texto": "Odcizila mi jich náhlá změna,"
  },
  {
   "texto": "nevítá mne, nelichotí koni,"
  },
  {
   "texto": "chladně jako ve snách se mi kloní,"
  },
  {
   "texto": "v koutku sedá sama, zamyšlena."
  },
  {
   "texto": "Marně ptám se, co jí líce smutí,"
  },
  {
   "texto": "vrtí hlavou, k úsměvu se nutí."
  },
  {
   "texto": "Neptává se, neposlouchá ani;"
  },
  {
   "texto": "časem jen, kdy v družném hovoru"
  },
  {
   "texto": "otci povídávám o vzdoru"
  },
  {
   "texto": "Šamilově, slávě ruských zbraní,"
  },
  {
   "texto": "kdy mu líčím zašlý v horách děj, -"
  },
  {
   "texto": "jako bleskem na bělounké dlani"
  },
  {
   "texto": "milostný se zdvíhá obličej"
  },
  {
   "texto": "v temném uzardění, snivě krásen,"
  },
  {
   "texto": "ručka v ňadra vlnivá se vtiská"
  },
  {
   "texto": "a zrak divně pod řasami blýská"
  },
  {
   "texto": "jako kinžal, z pochvy povytasen."
  },
  {
   "texto": "Ba, již zřídka v chatrči mne čeká."
  },
  {
   "texto": "V les prý zašla, po horách snad těká."
  },
  {
   "texto": "Sedáváme s otcem v tísni němé"
  },
  {
   "texto": "a druh druhu péči v oku čteme."
  },
  {
   "texto": "Vracel jsem se jednou, veda koně."
  },
  {
   "texto": "Tu jsem spatřil po vršiny skloně"
  },
  {
   "texto": "s kadeří ji větrem rozvátou"
  },
  {
   "texto": "chvátající stezkou klikatou."
  },
  {
   "texto": "Znáš tu báji o mladistvé ženě,"
  },
  {
   "texto": "k nížto plivník nocí přilétal,"
  },
  {
   "texto": "jak jí obličej v tajemné změně"
  },
  {
   "texto": "nevídaným vděkem rozkvetal,"
  },
  {
   "texto": "že až lidé, vidouce tu krásu,"
  },
  {
   "texto": "žehnali se křížem v němém žasu;"
  },
  {
   "texto": "nuž´, ta báje proletla mi hlavou,"
  },
  {
   "texto": "když jsem pohledl jí tenkráte"
  },
  {
   "texto": "v krásné líce pod kadeří hravou"
  },
  {
   "texto": "šarlatovým okem rozžaté,"
  },
  {
   "texto": "v oči, kteréž se jak slunce skvěly,"
  },
  {
   "texto": "a přec mne ni světa neviděly."
  },
  {
   "texto": "Zachytil jsem pevně její ruku."
  },
  {
   "texto": "„Odkud chvátáš? Co´s tak rozčilena?"
  },
  {
   "texto": "Odkud v chování tvém náhlá změna?"
  },
  {
   "texto": "Svěř mi tajemnou tu slast či muku,"
  },
  {
   "texto": "již tak pevně zamyká tvá hruď!"
  },
  {
   "texto": "Důvěřuj mi - přítelkyní buď!“"
  },
  {
   "texto": "- na ruce jí rty mé zahořely -"
  },
  {
   "texto": "„Vždyť já nad svět miluju tě celý.“"
  },
  {
   "texto": "Vymkla se mi, zastřela si líce,"
  },
  {
   "texto": "pozdvihla je plna bledé krásy,"
  },
  {
   "texto": "slzy lesklé povlekly jí řasy"
  },
  {
   "texto": "a rty zachvěly se šeptajíce:"
  },
  {
   "texto": "„Dobrý kozáče, dík za vše měj!"
  },
  {
   "texto": "Po mém tajemství však nepátrej,"
  },
  {
   "texto": "nech je spáti v srdci přeubohém -"
  },
  {
   "texto": "zapomeň již na mne - s bohem, s bohem!“"
  },
  {
   "texto": "Odkvapila. Pět jsem smutných dnů"
  },
  {
   "texto": "hlavu klonil jako v těžkém snu,"
  },
  {
   "texto": "po čardaku chodě bez účele."
  },
  {
   "texto": "Náhle Javor objevil se v něm,"
  },
  {
   "texto": "zlou jsem zprávu na vrásčitém čele,"
  },
  {
   "texto": "horší v oku četl ztrhaném."
  },
  {
   "texto": "Zdálo se, že okamžik mu zbělil"
  },
  {
   "texto": "prokvetalý vlas. Hle, co mi sdělil:"
  },
  {
   "texto": "Uviděl prý dceru za svítání,"
  },
  {
   "texto": "vzhůru jdoucí po mlhavé stráni"
  },
  {
   "texto": "a pak marně celý den jí čekal,"
  },
  {
   "texto": "poptával se, po vršinách těkal;"
  },
  {
   "texto": "dlouhá, strašná noc se v hory skryla -"
  },
  {
   "texto": "Ludmila však s hor se nevrátila."
  },
  {
   "texto": "Na koně jsme vsedli. Křížem lesy"
  },
  {
   "texto": "projeli jsme v širém okolí,"
  },
  {
   "texto": "přes balvany, vývrať, přes útesy"
  },
  {
   "texto": "drápali se v sněžné vrcholy,"
  },
  {
   "texto": "drahé jméno volali jsme stráním -"
  },
  {
   "texto": "ohlas nám je vracel s temným lkáním."
  },
  {
   "texto": "V němých úvalech den zaplál mnohý -"
  },
  {
   "texto": "neozářil stopu drahé nohy."
  },
  {
   "texto": "Zda ten něžný půvab vlků zuby"
  },
  {
   "texto": "rozsápaly bílé, špičaté,"
  },
  {
   "texto": "neb-li medvěd, záletník ten hrubý,"
  },
  {
   "texto": "v náruči jej zdrtil huňaté,"
  },
  {
   "texto": "v jezeře-li horském sladce dříme -"
  },
  {
   "texto": "nikdy, nikdy snad se nedovíme."
  },
  {
   "texto": "A co dále? Zajdi v českou ves;"
  },
  {
   "texto": "uvidíš tam chatu bídnou, pustou."
  },
  {
   "texto": "Stěny, štít i střechu mříží hustou"
  },
  {
   "texto": "oplétá jí révy, chmelu směs,"
  },
  {
   "texto": "ba, až do jizby se oknem dere,"
  },
  {
   "texto": "A tam v hloubi zelenavě šeré,"
  },
  {
   "texto": "jížto pavouk rozpřádá své sítě,"
  },
  {
   "texto": "hlava sporým stříbrem věnčená,"
  },
  {
   "texto": "nad prastarou knihou skloněná,"
  },
  {
   "texto": "nehnutostí mrtvou zarazí tě."
  },
  {
   "texto": "Vzhledne-li, duch z mohyly to hledí;"
  },
  {
   "texto": "promluvíš-li, neždej odpovědi. - -"
  },
  {
   "texto": "Má pak duše s žalostí je spjata,"
  },
  {
   "texto": "netěší mne druhů žert ni smích:"
  },
  {
   "texto": "réva družná od prsou mi vzata"
  },
  {
   "texto": "a červ upomínky hlodá v nich.\""
  },
  {
   "texto": "Bez hovoru dál kozáci jedou."
  },
  {
   "texto": "Slunéčko již zhaslo za vrcholem"
  },
  {
   "texto": "a zář´ růžová se s plavou, hnědou"
  },
  {
   "texto": "vystřídala po úbočích kolem."
  },
  {
   "texto": "Tma již čirá na úvalu dně,"
  },
  {
   "texto": "s obou stran pak husté vršky lesa"
  },
  {
   "texto": "výš a výš´ až hvězdná po nebesa"
  },
  {
   "texto": "černají se divě, posupně."
  },
  {
   "texto": "Pusto kol. Jen časem na úskalí"
  },
  {
   "texto": "pod kopytem jiskra zasvítí"
  },
  {
   "texto": "aneb šakala se ozve v dáli"
  },
  {
   "texto": "úpěnlivé, táhlé zavytí."
  },
  {
   "texto": "Náhle za balvanem v listů směsi"
  },
  {
   "texto": "zablesklo se, rána houkla v lesy;"
  },
  {
   "texto": "kůň se vzepjal; těsně kolem čela"
  },
  {
   "texto": "junákovi kule zafičela."
  },
  {
   "texto": "Ozvalo se ruské prokletí,"
  },
  {
   "texto": "karabina houkla v zápětí"
  },
  {
   "texto": "a již starý kozák uzdou trhá,"
  },
  {
   "texto": "s koně letí, k balvanu se vrhá,"
  },
  {
   "texto": "s obnaženou šavlí nad čelem."
  },
  {
   "texto": "Již i druhý s lesklým čepelem"
  },
  {
   "texto": "mává nad hlavou a za ním pádí."
  },
  {
   "texto": "V temnu půtka zuřivá se svádí:"
  },
  {
   "texto": "šavle zvoní v rázném setkání,"
  },
  {
   "texto": "křik tam, hřmot a zubů skřípání."
  },
  {
   "texto": "Náhle ticho. Kozáků dvé vleče"
  },
  {
   "texto": "cosi shůry v těžkém oddechu"
  },
  {
   "texto": "a teď starší, nad kořistí kleče,"
  },
  {
   "texto": "rozkřesává světlo v pospěchu:"
  },
  {
   "texto": "zamihly se přílba, mračné brvy,"
  },
  {
   "texto": "koulící se oči, rudé krví,"
  },
  {
   "texto": "pod zahnutým nosem, černým knírem"
  },
  {
   "texto": "sněhobílých zubů záblesky …"
  },
  {
   "texto": "zvolal kozák v udivení čirém:"
  },
  {
   "texto": "„Nastojte! - Toť ďábel čerkeský!“"
  },
  {
   "texto": "Uvázali koně; v stezky lemu"
  },
  {
   "texto": "oheň rozdělali, sedli k němu."
  },
  {
   "texto": "Polo s pýchou, polo zvědavě"
  },
  {
   "texto": "drahnou chvíli na zajatce hledí;"
  },
  {
   "texto": "ten se pracně zdvihl, volně sedí"
  },
  {
   "texto": "se špičatou přílbou na hlavě,"
  },
  {
   "texto": "od níž splývá kolem bledých tváří"
  },
  {
   "texto": "pobleskujíc v rudé ohně záři"
  },
  {
   "texto": "k hrdlu, šíji rouška ochranná,"
  },
  {
   "texto": "ze železných kroužků utkaná."
  },
  {
   "texto": "V železnou též košili se halí"
  },
  {
   "texto": "ramenou a hrudi mocné svaly,"
  },
  {
   "texto": "a kde oderval ji půtky ruch,"
  },
  {
   "texto": "květnatý se pestří archaluch."
  },
  {
   "texto": "V zadu ruce lýčím sepjaté"
  },
  {
   "texto": "zpod burky se jeví huňaté,"
  },
  {
   "texto": "potřísněné krví. Marně blyští"
  },
  {
   "texto": "šupiny se nohou ocelové:"
  },
  {
   "texto": "neboť pod kolenem z rány nové"
  },
  {
   "texto": "rudý mok se řadami jich prýští."
  },
  {
   "texto": "Prázdná pochva na ozdobném pasu"
  },
  {
   "texto": "smutně visí."
  },
  {
   "texto": "Šavle opodál"
  },
  {
   "texto": "travou v modravém se blýská jasu."
  },
  {
   "texto": "Hodil ji tam vítěz na kinžal,"
  },
  {
   "texto": "z jehož rukojeti v rudém svitu"
  },
  {
   "texto": "zírá drahokam, jak oko zmije;"
  },
  {
   "texto": "sáhovou též pušku viděti tu,"
  },
  {
   "texto": "vedle nich pak na okrouhlém štítu"
  },
  {
   "texto": "věncem nápis prastarý se vije."
  },
  {
   "texto": "Přímo sedí Čerkes. V jeho líci"
  },
  {
   "texto": "marně hledáš stopu bolesti,"
  },
  {
   "texto": "v palčivé tam ráně hlodající;"
  },
  {
   "texto": "sklíčenost ni bázeň nevěstí."
  },
  {
   "texto": "Jako z mramoru jsou rysy krásné:"
  },
  {
   "texto": "z černého jen oka vzdor i vztek"
  },
  {
   "texto": "divě blýská, záští neúhasné"
  },
  {
   "texto": "a kol rtů, z nichž zuby svítí jasné,"
  },
  {
   "texto": "pohrdlivý hraje úšklebek."
  },
  {
   "texto": "Drahnou chvíli takto proti sobě"
  },
  {
   "texto": "kozáci a Čerkes mlčky dleli."
  },
  {
   "texto": "Posléz stařík v úžasu a zlobě"
  },
  {
   "texto": "čerkesky se ozval k nepříteli:"
  },
  {
   "texto": "„Oj, kdes - ďáble huňatý - se vzal"
  },
  {
   "texto": "v lůně těchto bohopustých skal,"
  },
  {
   "texto": "kde již léta vlk jen s orlem žijí,"
  },
  {
   "texto": "a kde Čerkesů jen kosti hnijí?!"
  },
  {
   "texto": "Nebojíš se, bloude, pranýře,"
  },
  {
   "texto": "oprátky a sněhů Sibíře?“"
  },
  {
   "texto": "Čerkes mlčel. Roj myšlenek v čele"
  },
  {
   "texto": "vrásky hojné, hluboké mu ryl;"
  },
  {
   "texto": "pak je zdvihl hrdé, pojasnělé"
  },
  {
   "texto": "a tak starci zvučně hovořil:"
  },
  {
   "texto": "„Budiž, ďaure! Otevru ti knihu"
  },
  {
   "texto": "svého života. Tvé skráně sníh"
  },
  {
   "texto": "pokrývá a mnohá šavle v mihu"
  },
  {
   "texto": "rudým písmem zapsala se v nich."
  },
  {
   "texto": "Svědek jsi hrdinský našich činů!"
  },
  {
   "texto": "Víš, jak často meč jsme tasili"
  },
  {
   "texto": "za islam a volnost, za otčinu"
  },
  {
   "texto": "a co krve krásné nasili"
  },
  {
   "texto": "do hor těchto - mučennické setby -"
  },
  {
   "texto": "a jak často kule své a kletby"
  },
  {
   "texto": "za vámi jsme posílali s hor,"
  },
  {
   "texto": "když jste choulili jak v bouři stádo"
  },
  {
   "texto": "znamenané lebky pod prapor."
  },
  {
   "texto": "Ó což myšlení mé dlívá rádo"
  },
  {
   "texto": "u bojů těch slavných, krvavých!"
  },
  {
   "texto": "Přesila nesčetných vašich pluků"
  },
  {
   "texto": "a děl vašich věčně houkavých"
  },
  {
   "texto": "posléz naši odzbrojila ruku."
  },
  {
   "texto": "Podlehli jsme, však se nepoddali."
  },
  {
   "texto": "Národ můj své šíje nesklonil"
  },
  {
   "texto": "v jařmo ďaurů. Raděj v tyto skály"
  },
  {
   "texto": "slzu rozloučení uronil"
  },
  {
   "texto": "a tam daleko za mořem siným"
  },
  {
   "texto": "k souvěrcům se schýlil pohostiným."
  },
  {
   "texto": "Však já pravil sobě: Neopustím"
  },
  {
   "texto": "hory ty, jež otců stíní prach,"
  },
  {
   "texto": "a, by zpupný, nevěřící vrah"
  },
  {
   "texto": "bez trestu je prznil, nedopustím."
  },
  {
   "texto": "V zemi té, z níž vyštvali nás v bídu,"
  },
  {
   "texto": "nedopřeju cizí chátře klidu,"
  },
  {
   "texto": "pomstě zasvětím svůj kinžal skvělý -"
  },
  {
   "texto": "živá kanla za svůj národ celý!"
  },
  {
   "texto": "Přeslechl jsem druhů prosby, hanu -"
  },
  {
   "texto": "přísahu jsem složil na koranu."
  },
  {
   "texto": "Viděl jsem, jak líně připluly"
  },
  {
   "texto": "lodi Turků v hustém, pestrém davu"
  },
  {
   "texto": "a kol černých ráhen ve přístavu"
  },
  {
   "texto": "různotvárné plachty svinuly;"
  },
  {
   "texto": "viděl jsem, jak lehkých člunů roje"
  },
  {
   "texto": "snášely jim na klín houpavý"
  }
 ]
}