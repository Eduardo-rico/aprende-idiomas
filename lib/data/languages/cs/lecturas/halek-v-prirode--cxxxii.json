 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXXXII."
  },
  {
   "texto": "Jde mladistvý potok olšinou,"
  },
  {
   "texto": "hoch usednul si tam s dívčinou,"
  },
  {
   "texto": "a povídají si objetě,"
  },
  {
   "texto": "co nejkrásnější je na světě."
  },
  {
   "texto": "Jak potok se vine pod strání,"
  },
  {
   "texto": "jde ku mlejnu, kola pohání,"
  },
  {
   "texto": "jak každé to okno ve chládku"
  },
  {
   "texto": "si drobounkou vroubí zahrádku."
  },
  {
   "texto": "Jak nad okno k římse, pod krovem"
  },
  {
   "texto": "se jiřička hlásí domovem,"
  },
  {
   "texto": "jak zobaté krčky v napjetí"
  },
  {
   "texto": "jsou na stráži, kdy k nim doletí."
  },
  {
   "texto": "A pak až tak jednou, pospolu,"
  },
  {
   "texto": "z těch oken pohlednou do dolu,"
  },
  {
   "texto": "a na kola, vodu v odletě —"
  },
  {
   "texto": "co může být ještě na světě?"
  },
  {
   "texto": "Nebi dozdály se hvězdy,"
  },
  {
   "texto": "jen ta jedna dennice"
  },
  {
   "texto": "co sen k ránu nejkrásnější"
  },
  {
   "texto": "skví se ještě nejvíce."
  },
  {
   "texto": "Na východě hora v zlatě,"
  },
  {
   "texto": "tajný poklad odmyká,"
  },
  {
   "texto": "a co na ní růží kvete,"
  },
  {
   "texto": "k nebesům až doniká."
  },
  {
   "texto": "Mlhy bílé, jako z týlu,"
  },
  {
   "texto": "z řeky táhnou nad námi,"
  },
  {
   "texto": "kudy táhnou, listí kropí"
  },
  {
   "texto": "stříbrnými kapkami."
  },
  {
   "texto": "Slavík přestal ponocovat,"
  },
  {
   "texto": "z hory paprsk vyletěl —"
  },
  {
   "texto": "den se budí do myšlenek,"
  },
  {
   "texto": "do růží a do světel!"
  },
  {
   "texto": "Od břehu k břehu napíná"
  },
  {
   "texto": "své vody horská krajina,"
  },
  {
   "texto": "a u velké vod zrcadlo"
  },
  {
   "texto": "kus života mi upadlo."
  },
  {
   "texto": "Tu v břehů rámci, s večerem"
  },
  {
   "texto": "já modravým byl jezerem,"
  },
  {
   "texto": "zem, nebe na mém průčelí"
  },
  {
   "texto": "své lesklé barvy zkoušely."
  },
  {
   "texto": "Pak po večer, noc celičkou"
  },
  {
   "texto": "já s každou mluvil hvězdičkou,"
  },
  {
   "texto": "i s měsícem, a nejvíce,"
  },
  {
   "texto": "když přišla bílá dennice."
  },
  {
   "texto": "Po celou noc, až do rána"
  },
  {
   "texto": "má duše z hvězd je utkána,"
  },
  {
   "texto": "já s každou slavím líbánky,"
  },
  {
   "texto": "až jitro stydne v červánky."
  },
  {
   "texto": "Tu v růžích slunce vypne se,"
  },
  {
   "texto": "svět mladý jitrem chvěje se,"
  },
  {
   "texto": "tu ptáci lítnou na zvědy —"
  },
  {
   "texto": "jak královské to rozhledy."
  },
  {
   "texto": "Houštinou háje, s měsíce zlatem"
  },
  {
   "texto": "my k studánce kradem se šeré,"
  },
  {
   "texto": "slova z ní hladká zurčivým chvatem"
  },
  {
   "texto": "a postavy skákají steré."
  },
  {
   "texto": "Nejhezčí panna měsíčně bílá,"
  },
  {
   "texto": "pak družičky v vlnivém reji,"
  },
  {
   "texto": "rusalky hybné, za vílou víla,"
  },
  {
   "texto": "ty v závoji vlasů se krejí."
  },
  {
   "texto": "Za nimi v krok se mužíci tlačí,"
  },
  {
   "texto": "jak cvrčkové tváří i zvukem,"
  },
  {
   "texto": "s bubínkem žabím, píšťalou ptačí,"
  },
  {
   "texto": "s much cimbálem, bzukotem, hukem."
  },
  {
   "texto": "Na konec jinoch, jako ten jelen,"
  },
  {
   "texto": "z hvězd na čele stříbrné tečky,"
  },
  {
   "texto": "v mlhavý šat a v červánky vtělen,"
  },
  {
   "texto": "dvě pážata nesou mu vlečky."
  },
  {
   "texto": "Tam až kde vlnky dohrčí v mechu,"
  },
  {
   "texto": "tam za keře v stíny si zajdou,"
  },
  {
   "texto": "vypijou rosu k tanci a spěchu,"
  },
  {
   "texto": "a pak se zas s měsícem najdou."
  }
 ]
}