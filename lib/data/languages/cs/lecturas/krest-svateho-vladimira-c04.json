{
 "id": "krest-svateho-vladimira-c04",
 "titulo": "Zpěv 4: Zpěv VIII. — Kamarila · Zpěv IX. — Jezovitský marš · Zpěv X. — Konkurs",
 "autor": "Karel Havlíček Borovský",
 "muerteAutor": 1856,
 "fuenteUrl": "https://cs.wikisource.org/wiki/K%C5%99est_svat%C3%A9ho_Vladim%C3%ADra/Zp%C4%9Bv_VIII.",
 "fuente": "cs.wikisource.org, «Křest svatého Vladimíra»",
 "licencia": "dominio público (autor muerto en 1856)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso y lo pondría en A2.",
 "serie": {
  "id": "krest-svateho-vladimira",
  "titulo": "Křest svatého Vladimíra",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Zpěv VIII. — Kamarila"
  },
  {
   "texto": "Jako u všech potentátů"
  },
  {
   "texto": "tak i v Rusku byla"
  },
  {
   "texto": "mocnější než ministerstvo"
  },
  {
   "texto": "dvorní kamarila."
  },
  {
   "texto": "Zachovej nám, pane bože!"
  },
  {
   "texto": "Frantu Šumavského:"
  },
  {
   "texto": "že je každá kamarila"
  },
  {
   "texto": "pohlavní ženského."
  },
  {
   "texto": "Vladimír byl ještě k tomu"
  },
  {
   "texto": "puncto sexti štvanec,"
  },
  {
   "texto": "jako lev kraloval mužům"
  },
  {
   "texto": "a ženským co kanec."
  },
  {
   "texto": "Jednu ženu měl Normanku"
  },
  {
   "texto": "a jednu Řekyni,"
  },
  {
   "texto": "dvě měl Češky, že jsou hezky,"
  },
  {
   "texto": "jednu Bulharyni."
  },
  {
   "texto": "A metresek jako pecek,"
  },
  {
   "texto": "tři sta v Bělehradě,"
  },
  {
   "texto": "dvě stě v sele Berestově,"
  },
  {
   "texto": "tři sta v Vyšehradě."
  },
  {
   "texto": "Ještě kromě těch kasáren"
  },
  {
   "texto": "leckde filiálku:"
  },
  {
   "texto": "Kacík v Hessen-Kasslu nemá"
  },
  {
   "texto": "tolik kafešálků!"
  },
  {
   "texto": "A teď ještě tetky, matky"
  },
  {
   "texto": "k nim přiadýrovat,"
  },
  {
   "texto": "pak to s jejich zpovědníky"
  },
  {
   "texto": "multiplicírovat:"
  },
  {
   "texto": "ó! to byla kamarila"
  },
  {
   "texto": "jako Čimborasso!"
  },
  {
   "texto": "Senát vždycky pohotově"
  },
  {
   "texto": "jak u rasa maso."
  },
  {
   "texto": "Ó! to bylo kandidátů,"
  },
  {
   "texto": "to bylo protekcí:"
  },
  {
   "texto": "tu cár, co jest topit bohy,"
  },
  {
   "texto": "dostal teprv lekcí."
  },
  {
   "texto": "Všechny na něj dorážely,"
  },
  {
   "texto": "každá jinák mlela,"
  },
  {
   "texto": "málem by už byla cáru"
  },
  {
   "texto": "hlava zšedivěla. —"
  },
  {
   "texto": "Večír, když mu Mates lokaj"
  },
  {
   "texto": "přišel zouvat boty,"
  },
  {
   "texto": "začal si cár stěžovati"
  },
  {
   "texto": "na ty své trampoty."
  },
  {
   "texto": "Starý Mates, ten byl ve všem"
  },
  {
   "texto": "cárův hlavní rádce,"
  },
  {
   "texto": "ministry i kamarilu"
  },
  {
   "texto": "vodil na oprátce."
  },
  {
   "texto": "„Ach, Matýsku, Matýsečku!"
  },
  {
   "texto": "hleď mne toho zbavit,"
  },
  {
   "texto": "já, chudák, s těmi ženskými"
  },
  {
   "texto": "nic nemohu spravit!“ —"
  },
  {
   "texto": "Mates, jak jen cár byl svlečen"
  },
  {
   "texto": "a v posteli ležel,"
  },
  {
   "texto": "do redakce vládních novin"
  },
  {
   "texto": "s botma v ruce běžel."
  },
  {
   "texto": "Tam jim cosi diktýroval"
  },
  {
   "texto": "s botama pod paží:"
  },
  {
   "texto": "„Nebude-li to tam zejtra,"
  },
  {
   "texto": "cár vám vousy zpraží!“ —"
  },
  {
   "texto": "Druhý den pak celý Kyjov"
  },
  {
   "texto": "divil se nemálo,"
  },
  {
   "texto": "když v úřední části novin"
  },
  {
   "texto": "velkým písmem stálo:"
  },
  {
   "texto": "„V jménu Jeho Veličenstva"
  },
  {
   "texto": "cára Vladimíra"
  },
  {
   "texto": "na prázdnou prebendu božskou"
  },
  {
   "texto": "konkurs se otvírá."
  },
  {
   "texto": "Výminky a bližší zprávy,"
  },
  {
   "texto": "to kandidátovi"
  },
  {
   "texto": "ministerstvo policejní"
  },
  {
   "texto": "na doptávku poví.“ — —"
  },
  {
   "texto": "Rozběhla se ta novina"
  },
  {
   "texto": "v elektrickém letu"
  },
  {
   "texto": "na drátěných telegrafech"
  },
  {
   "texto": "jako rtuť po světu."
  },
  {
   "texto": "Druhý den již v celém světě"
  },
  {
   "texto": "jak na lípě včely"
  },
  {
   "texto": "telegrafické depeše"
  },
  {
   "texto": "v novinách bzučely. —"
  },
  {
   "texto": "V Římě páni kardináli"
  },
  {
   "texto": "k Červenému raku"
  },
  {
   "texto": "přede mší se scházívají"
  },
  {
   "texto": "na skleňku araku."
  },
  {
   "texto": "Pan kardinál Šamšulini"
  },
  {
   "texto": "mrsknul jen po oku"
  },
  {
   "texto": "do Augsburských všeobecných,"
  },
  {
   "texto": "už se dal do skoku!"
  },
  {
   "texto": "Dal nalejt Lacrimae Christi,"
  },
  {
   "texto": "a to hned do džbánu,"
  },
  {
   "texto": "vylousknul džbán a již letěl"
  },
  {
   "texto": "přímo k Vatikánu."
  },
  {
   "texto": "Tam hned vrazil do pokoje"
  },
  {
   "texto": "a bez zaklepání"
  },
  {
   "texto": "vyburcoval tou novinou"
  },
  {
   "texto": "papeže ze spaní."
  },
  {
   "texto": "Svatý otec, jak vyskočil,"
  },
  {
   "texto": "ještě byl v košili,"
  },
  {
   "texto": "velel, by se Jezovité"
  },
  {
   "texto": "do Rus hned strojili."
  },
  {
   "texto": "Dal je všechny k této cestě"
  },
  {
   "texto": "na ostro kovati"
  },
  {
   "texto": "a marš zvláštní pro ně kázal"
  },
  {
   "texto": "zkomponýrovati."
  },
  {
   "texto": "Zpěv IX. — Jezovitský marš"
  },
  {
   "texto": "Te Deum laudamus —"
  },
  {
   "texto": "v Kyjevě je rámus,"
  },
  {
   "texto": "Dies irae dies illa —"
  },
  {
   "texto": "nastane tam naše víra."
  },
  {
   "texto": "Te rogamus, audi nos —"
  },
  {
   "texto": "ten Vladimír, to je kos!"
  },
  {
   "texto": "Gloria in excelsis Deo —"
  },
  {
   "texto": "držme my se jeho."
  },
  {
   "texto": "Credo in unum Deum —"
  },
  {
   "texto": "náš Bůh je poslušnější nežli Perun,"
  },
  {
   "texto": "Orate, fratres —"
  },
  {
   "texto": "naše víra je ponížená jak pes."
  },
  {
   "texto": "Benedictus, qui venit —"
  },
  {
   "texto": "málo vědět, mnoho věřit."
  },
  {
   "texto": "Sanctus, sanctus, sanctus —"
  },
  {
   "texto": "všem novotářům pardus,"
  },
  {
   "texto": "In nomine Domini —"
  },
  {
   "texto": "čert aby vzal noviny!"
  },
  {
   "texto": "Dignum et justum est —"
  },
  {
   "texto": "starým časům všechna čest!"
  },
  {
   "texto": "Dominus vobiscum —"
  },
  {
   "texto": "lepší hloupost nežli rozum."
  },
  {
   "texto": "Sancta Dei Genitrix —"
  },
  {
   "texto": "zde nám už nevěří nic."
  },
  {
   "texto": "Agnus Dei, qui tollis peccata —"
  },
  {
   "texto": "Rusi nám budou věřit jak telata."
  },
  {
   "texto": "Veni, Sancte Spiritus —"
  },
  {
   "texto": "postěhujem se do Rus,"
  },
  {
   "texto": "Eexaudi nos, Domine —"
  },
  {
   "texto": "ať nás to tam nemine,"
  },
  {
   "texto": "Pleni sunt coeli —"
  },
  {
   "texto": "abychom se tam dobře měli,"
  },
  {
   "texto": "Aequum et salutare —"
  },
  {
   "texto": "počkej, ty kaviáre!"
  },
  {
   "texto": "Salvator mundi —"
  },
  {
   "texto": "to budou jundy!"
  },
  {
   "texto": "In te, Domine, speravi —"
  },
  {
   "texto": "žaludek nám dobře tráví,"
  },
  {
   "texto": "Libera nos a malo —"
  },
  {
   "texto": "sedum liber masa málo!"
  },
  {
   "texto": "Exaudi, Domine, orationem meam —"
  },
  {
   "texto": "sním jelito, když šunku nemám,"
  },
  {
   "texto": "Ex profundis clamavi ad te, Domine —"
  },
  {
   "texto": "když jsem byl ve sklepě na víně,"
  },
  {
   "texto": "Dona nobis pacem —"
  },
  {
   "texto": "s kuchařkami spát chcem,"
  },
  {
   "texto": "A porta inferi —"
  },
  {
   "texto": "aby lidé nevěděli."
  },
  {
   "texto": "Mea culpa, mea maxima culpa —"
  },
  {
   "texto": "kdo neumí dělat zázraky, ten je ťulpa."
  },
  {
   "texto": "Kyrie eleison!"
  },
  {
   "texto": "když peníze nejsou."
  },
  {
   "texto": "Et ne nos inducas in tentationem —"
  },
  {
   "texto": "když ti dávají, ber honem;"
  },
  {
   "texto": "Sicut erat in principio et nunc et semper —"
  },
  {
   "texto": "nedávej nikomu nic, ale všem ber!"
  },
  {
   "texto": "Et in saecula saeculorum. Amen."
  },
  {
   "texto": "Nejvíc nám nese ten pekelný plamen."
  },
  {
   "texto": "Zpěv X. — Konkurs"
  },
  {
   "texto": "Věje vítr černomořský,"
  },
  {
   "texto": "travou v stěpi klátí;"
  },
  {
   "texto": "sbíhají se do Kyjova"
  },
  {
   "texto": "páni kandidáti."
  },
  {
   "texto": "Věje vítr od západu,"
  },
  {
   "texto": "v Kyjově se práší;"
  },
  {
   "texto": "každá firma haní jiné,"
  },
  {
   "texto": "sama se vynáší. —"
  },
  {
   "texto": "Poslal papež dekret z Říma,"
  },
  {
   "texto": "pečeť jako talíř:"
  },
  {
   "texto": "„Co je po té řecké víře,"
  },
  {
   "texto": "nedám za ni halíř!"
  },
  {
   "texto": "Není církev jako církev,"
  },
  {
   "texto": "cáre nejmilejší,"
  },
  {
   "texto": "římská církev mezi všemi"
  },
  {
   "texto": "nejcírkvovatější!“ —"
  },
  {
   "texto": "A carhradský patriarcha,"
  },
  {
   "texto": "pečeť jako miska:"
  },
  {
   "texto": "„Nevěř tomu, Vladimíre,"
  },
  {
   "texto": "co ancikrist píská."
  },
  {
   "texto": "Není církev jako církev,"
  },
  {
   "texto": "cáre nejmilejší,"
  },
  {
   "texto": "řecká církev mezi všemi"
  },
  {
   "texto": "nejcírkvovatější!“"
  },
  {
   "texto": "A rabínské synedrium"
  },
  {
   "texto": "„Šulem, šulem“ píše,"
  },
  {
   "texto": "„nevěř Římu, nevěř Řekům,"
  },
  {
   "texto": "drž se jen Mojžíše."
  },
  {
   "texto": "Není církev jako církev,"
  },
  {
   "texto": "cáre nejmilejší,"
  },
  {
   "texto": "židovská je mezi všemi"
  },
  {
   "texto": "nejcírkvovatější.“"
  },
  {
   "texto": "Také mufti muhamedský"
  },
  {
   "texto": "překřičet se nedá:"
  },
  {
   "texto": "„Potluč ty psy nevěřící,"
  },
  {
   "texto": "uvěř [v] Muhameda!"
  },
  {
   "texto": "Není církev jako církev,"
  },
  {
   "texto": "cáre nejmilejší,"
  },
  {
   "texto": "musulmanská mezi všemi"
  },
  {
   "texto": "nejcírkvovatější!“ —"
  },
  {
   "texto": "V cárském dvoru na Podolu"
  },
  {
   "texto": "psi se o kost hryzli:"
  },
  {
   "texto": "také ty ostatní sekty"
  },
  {
   "texto": "konkurovat přišly."
  },
  {
   "texto": "Čert zná všechna jejich jména!"
  },
  {
   "texto": "Ale jak se ctily,"
  },
  {
   "texto": "z toho se ruské hokyně"
  },
  {
   "texto": "mnoho naučily."
  },
  {
   "texto": "Tenkrát byly zlaté časy"
  },
  {
   "texto": "pro dohazovače,"
  },
  {
   "texto": "rozolku pili z krajáčů,"
  },
  {
   "texto": "jedli jen koláče."
  },
  {
   "texto": "Proto, že jim v tom konkursu"
  },
  {
   "texto": "obchody tak květly,"
  },
  {
   "texto": "jmenují se od té doby"
  },
  {
   "texto": "také „boží metly“."
  }
 ]
}