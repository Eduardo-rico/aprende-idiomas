 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Šumaři"
  },
  {
   "texto": "Jdou šumaři od města k městu,"
  },
  {
   "texto": "ode vsi ke vsi pořadem,"
  },
  {
   "texto": "jak tažní ptáci krátí si cestu,"
  },
  {
   "texto": "zásobí plesem celou zem."
  },
  {
   "texto": "Jdou šumaři, u prahu se staví:"
  },
  {
   "texto": "„Růžové dívky, pojďte ven,"
  },
  {
   "texto": "my na stálé vám zahrajem zdraví,"
  },
  {
   "texto": "dopředem den vám v pěkný sen.“"
  },
  {
   "texto": "Hned v spanilém děvčátka lemu,"
  },
  {
   "texto": "jako když růží nakvěte,"
  },
  {
   "texto": "a kde jsou švarní mládenci k čemu,"
  },
  {
   "texto": "hned se to v kytky proplete."
  },
  {
   "texto": "Neb jak co ti šumaři hrají,"
  },
  {
   "texto": "vjede těm hochům do nohou,"
  },
  {
   "texto": "a které srdce z tvrda se krájí,"
  },
  {
   "texto": "trouby mu roztát pomohou."
  },
  {
   "texto": "Tak praví již soudové boží —"
  },
  {
   "texto": "v hudbě se zákon naplní:"
  },
  {
   "texto": "když kolo roste, láska se množí,"
  },
  {
   "texto": "lidé se v párky doplní."
  },
  {
   "texto": "Tak stvrzují otcové, matky:"
  },
  {
   "texto": "neb když se tanec rozehrá,"
  },
  {
   "texto": "to vyjdou, kývnou na prahu chatky —"
  },
  {
   "texto": "ať jen to pán bůh požehná!"
  },
  {
   "texto": "Jdou šumaři od města k městu,"
  },
  {
   "texto": "ode vsi ke vsi pořadem,"
  },
  {
   "texto": "jak tažní ptáci krátí si cestu,"
  },
  {
   "texto": "vesele zvučno bude všem!"
  },
  {
   "texto": "Sté panoval léto Sáva král"
  },
  {
   "texto": "a byl vždy věhlasem jasný,"
  },
  {
   "texto": "tu knížatům, pánům vědět dal:"
  },
  {
   "texto": "„Chci znáti, kdo z vás je šťastný.“"
  },
  {
   "texto": "Jak knížatům přišla o tom věsť,"
  },
  {
   "texto": "hned každý zadumán sedne,"
  },
  {
   "texto": "životu kouká v zašlou tresť,"
  },
  {
   "texto": "to jak když záclonu zvedne."
  },
  {
   "texto": "A postavy uzří zlačnělé,"
  },
  {
   "texto": "jak po cti vyzábly hladem,"
  },
  {
   "texto": "v nich duše už mrtvě ztupělé —"
  },
  {
   "texto": "v nich sebe poznává snadem."
  },
  {
   "texto": "Zří jeden, jak jaro promrhal"
  },
  {
   "texto": "na časnou jeseně vrásku,"
  },
  {
   "texto": "tam ten, jak žen na sta miloval"
  },
  {
   "texto": "a přece nepoznal lásku."
  },
  {
   "texto": "A ten zde, jak choť má křehkou ctnost,"
  },
  {
   "texto": "to dlouhou nocí jej trápí,"
  },
  {
   "texto": "tam tomu je rozmar řídký host,"
  },
  {
   "texto": "ač často vínem jej ztápí."
  },
  {
   "texto": "Svou každý jen chorou vidí část,"
  },
  {
   "texto": "ta kalným pohledem leká,"
  },
  {
   "texto": "v tom nemnoho blaha, velká strast —"
  },
  {
   "texto": "král smuten na trůně čeká."
  },
  {
   "texto": "Král Sáva jde s trůnu zasmušil,"
  },
  {
   "texto": "jde k moři, po břehu kráčí —"
  },
  {
   "texto": "„Co platno, bych sto let králem byl,"
  },
  {
   "texto": "teď stý rok loučím se v pláči?“"
  },
  {
   "texto": "Tu uvidí chýšku chudobnou,"
  },
  {
   "texto": "v lov rybák spravuje sítě,"
  },
  {
   "texto": "a matka si písní lahodnou"
  },
  {
   "texto": "v sen hejčká anděla dítě."
  },
  {
   "texto": "V kout uloží si je na plenku,"
  },
  {
   "texto": "je postře bělavou sítí,"
  },
  {
   "texto": "a hlídá mu sen i myšlenku,"
  },
  {
   "texto": "jež z plných tvářiček svítí."
  },
  {
   "texto": "A rybák se v práci zastaví,"
  },
  {
   "texto": "jde blíže, pokradmo, v tichu:"
  },
  {
   "texto": "ty tvářičky rdí se do zdraví"
  },
  {
   "texto": "a hrajou v líbezném smíchu!"
  },
  {
   "texto": "On s dítka se dívá na ženu:"
  },
  {
   "texto": "„Toť ráj, toť nebe je vlastní!“"
  },
  {
   "texto": "A žena stře náruč blaženu:"
  },
  {
   "texto": "„Hle, muži, přece jsme šťastni!“"
  },
  {
   "texto": "Jde s úsměvem na trůn Sáva král"
  },
  {
   "texto": "a s trůnu knížatům věstí:"
  },
  {
   "texto": "„Kdo u matky štěstí nepoznal,"
  },
  {
   "texto": "byť král byl, neviděl štěstí!“"
  }
 ]
}