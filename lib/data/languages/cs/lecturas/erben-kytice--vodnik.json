{
 "id": "erben-kytice--vodnik",
 "titulo": "Vodník",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/Vodn%C3%ADk",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (vzpomínati, dáti, míti: 4 formas frente a 2 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error.",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 8
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Na topole nad jezerem"
  },
  {
   "texto": "seděl vodník podvečerem:"
  },
  {
   "texto": "„Sviť, měsíčku, sviť,"
  },
  {
   "texto": "ať mi šije niť."
  },
  {
   "texto": "Šiju, šiju si botičky"
  },
  {
   "texto": "do sucha i do vodičky:"
  },
  {
   "texto": "sviť, měsíčku, sviť,"
  },
  {
   "texto": "ať mi šije niť."
  },
  {
   "texto": "Dnes je čtvrtek, zejtra pátek —"
  },
  {
   "texto": "šiju, šiju si kabátek:"
  },
  {
   "texto": "sviť, měsíčku, sviť,"
  },
  {
   "texto": "ať mi šije niť."
  },
  {
   "texto": "Zelené šaty, botky rudé,"
  },
  {
   "texto": "zejtra moje svatba bude:"
  },
  {
   "texto": "sviť, měsíčku, sviť,"
  },
  {
   "texto": "ať mi šije niť.“"
  },
  {
   "texto": "II"
  },
  {
   "texto": "Ráno, raníčko panna vstala,"
  },
  {
   "texto": "prádlo si v uzel zavázala:"
  },
  {
   "texto": "„Půjdu, matičko, k jezeru,"
  },
  {
   "texto": "šátečky sobě vyperu.“"
  },
  {
   "texto": "„Ach nechoď, nechoď na jezero,"
  },
  {
   "texto": "zůstaň dnes doma, moje dcero!"
  },
  {
   "texto": "Já měla zlý té noci sen:"
  },
  {
   "texto": "nechoď, dceruško, k vodě ven."
  },
  {
   "texto": "Perly jsem tobě vybírala,"
  },
  {
   "texto": "bíle jsem tebe oblíkala,"
  },
  {
   "texto": "v sukničku jako z vodních pěn:"
  },
  {
   "texto": "nechoď, dceruško, k vodě ven."
  },
  {
   "texto": "Bílé šatičky smutek tají,"
  },
  {
   "texto": "v perlách se slzy ukrývají,"
  },
  {
   "texto": "a pátek nešťastný je den,"
  },
  {
   "texto": "nechoď, dceruško, k vodě ven.“ —"
  },
  {
   "texto": "Nemá dceruška, nemá stání,"
  },
  {
   "texto": "k jezeru vždy ji cos pohání,"
  },
  {
   "texto": "k jezeru vždy ji cos nutí,"
  },
  {
   "texto": "nic doma, nic jí po chuti. —"
  },
  {
   "texto": "První šáteček namočila —"
  },
  {
   "texto": "tu se s ní lávka prolomila,"
  },
  {
   "texto": "a po mladičké dívčině"
  },
  {
   "texto": "zavířilo se v hlubině."
  },
  {
   "texto": "Vyvalily se vlny zdola,"
  },
  {
   "texto": "roztáhnuly se v šírá kola;"
  },
  {
   "texto": "a na topole podle skal"
  },
  {
   "texto": "zelený mužík zatleskal."
  },
  {
   "texto": "III"
  },
  {
   "texto": "Nevesely truchlivy"
  },
  {
   "texto": "jsou ty vodní kraje,"
  },
  {
   "texto": "kde si v trávě pod leknínem"
  },
  {
   "texto": "rybka s rybkou hraje."
  },
  {
   "texto": "Tu slunéčko nezahřívá,"
  },
  {
   "texto": "větřík nezavěje:"
  },
  {
   "texto": "chladno, ticho —"
  },
  {
   "texto": "jako žel v srdci bez naděje."
  },
  {
   "texto": "Nevesely truchlivy"
  },
  {
   "texto": "jsou ty kraje vodní;"
  },
  {
   "texto": "v poloutmě a v polousvětle"
  },
  {
   "texto": "mine tu den po dni."
  },
  {
   "texto": "Dvůr vodníkův prostranný,"
  },
  {
   "texto": "bohatství v něm dosti;"
  },
  {
   "texto": "však bezděky jen se v něm"
  },
  {
   "texto": "zastavují hosti."
  },
  {
   "texto": "A kdo jednou v křišťálovou"
  },
  {
   "texto": "bránu jeho vkročí,"
  },
  {
   "texto": "sotva ho kdy uhlédají"
  },
  {
   "texto": "jeho milých oči."
  },
  {
   "texto": "Vodník sedí mezi vraty,"
  },
  {
   "texto": "spravuje své sítě"
  },
  {
   "texto": "a ženuška jeho mladá"
  },
  {
   "texto": "chová malé dítě."
  },
  {
   "texto": "„Hajej, dadej, mé děťátko,"
  },
  {
   "texto": "můj bezděčný synu!"
  },
  {
   "texto": "Ty se na mne usmíváš,"
  },
  {
   "texto": "já žalostí hynu."
  },
  {
   "texto": "Ty radostně vypínáš"
  },
  {
   "texto": "ke mně ručky obě;"
  },
  {
   "texto": "a já bych se radš viděla"
  },
  {
   "texto": "tam na zemi v hrobě."
  },
  {
   "texto": "Tam na zemi za kostelem"
  },
  {
   "texto": "u černého kříže,"
  },
  {
   "texto": "aby má matička zlatá"
  },
  {
   "texto": "měla ke mně blíže."
  },
  {
   "texto": "Hajej, dadej, synku můj,"
  },
  {
   "texto": "můj malý vodníčku!"
  },
  {
   "texto": "Kterak nemám vzpomínati"
  },
  {
   "texto": "smutná na matičku?"
  },
  {
   "texto": "Starala se ubohá,"
  },
  {
   "texto": "komu vdá mne, komu,"
  },
  {
   "texto": "však ani se nenadálá,"
  },
  {
   "texto": "vybyla mne z domu!"
  },
  {
   "texto": "Vdala jsem se, vdala již,"
  },
  {
   "texto": "ale byly chyby:"
  },
  {
   "texto": "starosvati — černí raci,"
  },
  {
   "texto": "a družičky — ryby!"
  },
  {
   "texto": "A můj muž — bůh polituj!"
  },
  {
   "texto": "mokře chodí v suše"
  },
  {
   "texto": "a ve vodě pod hrnečky"
  },
  {
   "texto": "střádá lidské duše."
  },
  {
   "texto": "Hajej, dadej, můj synáčku"
  },
  {
   "texto": "s zelenými vlásky!"
  },
  {
   "texto": "Nevdala se tvá matička"
  },
  {
   "texto": "ve příbytek lásky."
  },
  {
   "texto": "Obluzena, polapena"
  },
  {
   "texto": "v ošemetné sítě,"
  },
  {
   "texto": "nemá žádné zde radosti"
  },
  {
   "texto": "leč tebe, mé dítě!“ —"
  },
  {
   "texto": "„Co to zpíváš, ženo má?"
  },
  {
   "texto": "Nechci toho zpěvu!"
  },
  {
   "texto": "Tvoje píseň proklatá"
  },
  {
   "texto": "popouzí mne k hněvu."
  },
  {
   "texto": "Nic nezpívej, ženo má!"
  },
  {
   "texto": "V těle žluč mi kyne:"
  },
  {
   "texto": "sic učiním rybou tebe"
  },
  {
   "texto": "jako mnohé jiné!“ —"
  },
  {
   "texto": "„Nehněvej se, nehněvej,"
  },
  {
   "texto": "vodníku, můj muži!"
  },
  {
   "texto": "Neměj za zlé rozdrcené,"
  },
  {
   "texto": "zahozené růži."
  },
  {
   "texto": "Mladosti mé jarý štěp"
  },
  {
   "texto": "přelomil jsi v půli;"
  },
  {
   "texto": "a nic jsi mi po tu dobu"
  },
  {
   "texto": "neučinil k vůli."
  },
  {
   "texto": "Stokrát jsem tě prosila,"
  },
  {
   "texto": "přimlouvala sladce,"
  },
  {
   "texto": "bys mi na čas, na kratičký,"
  },
  {
   "texto": "dovolil k mé matce."
  },
  {
   "texto": "Stokrát jsem tě prosila"
  },
  {
   "texto": "v slzí toku mnohém,"
  },
  {
   "texto": "bych jí ještě naposledy"
  },
  {
   "texto": "mohla dáti sbohem!"
  },
  {
   "texto": "Stokrát jsem tě prosila,"
  },
  {
   "texto": "na kolena klekla;"
  },
  {
   "texto": "ale kůra srdce tvého"
  },
  {
   "texto": "ničím neobměkla!"
  },
  {
   "texto": "Nehněvej se, nehněvej,"
  },
  {
   "texto": "vodníku, můj pane,"
  },
  {
   "texto": "anebo se rozhněvej,"
  },
  {
   "texto": "co díš, ať se stane."
  },
  {
   "texto": "A chceš-li mne rybou míti,"
  },
  {
   "texto": "abych byla němá,"
  },
  {
   "texto": "učiň mne radš kamenem,"
  },
  {
   "texto": "jenž paměti nemá."
  },
  {
   "texto": "Učiň mne radš kamenem"
  },
  {
   "texto": "bez mysli a citu,"
  },
  {
   "texto": "by mi věčně žel nebylo"
  },
  {
   "texto": "slunečního svitu!“ —"
  },
  {
   "texto": "„Rád bych, ženo, rád bych já"
  },
  {
   "texto": "věřil tvému slovu;"
  },
  {
   "texto": "ale rybka v šírém moři —"
  },
  {
   "texto": "kdo ji lapí znovu?"
  },
  {
   "texto": "Nezbraňoval bych ti já"
  },
  {
   "texto": "k matce tvojí chůze;"
  },
  {
   "texto": "ale liché mysli ženské"
  },
  {
   "texto": "obávám se tuze!"
  },
  {
   "texto": "Nuže — dovolím ti já,"
  },
  {
   "texto": "dovolím ti z důli;"
  },
  {
   "texto": "však poroučím, ať mi věrně"
  },
  {
   "texto": "splníš moji vůli."
  },
  {
   "texto": "Neobjímej matky své,"
  },
  {
   "texto": "ani duše jiné;"
  },
  {
   "texto": "sic pozemská tvoje láska"
  },
  {
   "texto": "s nezemskou se mine."
  },
  {
   "texto": "Neobjímej nikoho"
  },
  {
   "texto": "z rána do večera;"
  },
  {
   "texto": "před klekáním pak se zase"
  },
  {
   "texto": "vrátíš do jezera."
  },
  {
   "texto": "Od klekání do klekání"
  },
  {
   "texto": "dávám lhůtu tobě;"
  },
  {
   "texto": "avšak mi tu na jistotu"
  },
  {
   "texto": "zůstavíš to robě.“"
  },
  {
   "texto": "IV"
  },
  {
   "texto": "Jaké, jaké by to bylo"
  },
  {
   "texto": "bez slunéčka podletí?"
  },
  {
   "texto": "Jaké bylo by shledání"
  },
  {
   "texto": "bez vroucího objetí?"
  },
  {
   "texto": "A když dcera v dlouhém čase"
  },
  {
   "texto": "matku svou obejme zase,"
  },
  {
   "texto": "aj, kdo může za zlé míti"
  },
  {
   "texto": "laskavému dítěti?"
  },
  {
   "texto": "Celý den se v pláči těší"
  },
  {
   "texto": "s matkou žena z jezera:"
  },
  {
   "texto": "„Sbohem, má matičko zlatá!"
  },
  {
   "texto": "Ach, bojím se večera!“ —"
  },
  {
   "texto": "“Neboj se, má duše drahá,"
  },
  {
   "texto": "nic se neboj toho vraha;"
  },
  {
   "texto": "nedopustím, by tě v moci měla"
  },
  {
   "texto": "vodní příšera!“ —"
  },
  {
   "texto": "Přišel večer. — Muž zelený"
  },
  {
   "texto": "chodí venku po dvoře;"
  },
  {
   "texto": "dvéře klínem zastrčeny,"
  },
  {
   "texto": "matka s dcerou v komoře."
  },
  {
   "texto": "„Neboj se, má drahá duše,"
  },
  {
   "texto": "nic ti neuškodí v suše,"
  },
  {
   "texto": "vrah jezerní nemá k tobě"
  },
  {
   "texto": "žádné moci nahoře.“ —"
  },
  {
   "texto": "Když klekání odzvonili,"
  },
  {
   "texto": "buch buch! venku na dvéře:"
  },
  {
   "texto": "„Pojď již domů, ženo moje,"
  },
  {
   "texto": "nemám ještě večeře.“ —"
  },
  {
   "texto": "„Vari od našeho prahu,"
  },
  {
   "texto": "vari pryč, ty lstivý vrahu,"
  },
  {
   "texto": "a co dřív jsi večeříval,"
  },
  {
   "texto": "večeř zase v jezeře!“ —"
  },
  {
   "texto": "O půlnoci buch buch! zase"
  },
  {
   "texto": "na ty dvéře zpukřelé:"
  },
  {
   "texto": "„Pojď již domů, ženo moje,"
  },
  {
   "texto": "pojď mi ustlat postele.“ —"
  },
  {
   "texto": "„Vari od našeho prahu,"
  },
  {
   "texto": "vari pryč, ty lstivý vrahu,"
  },
  {
   "texto": "a kdo tobě prve stlával,"
  },
  {
   "texto": "ať ti zase ustele!“ —"
  },
  {
   "texto": "A potřetí buch buch! zase,"
  },
  {
   "texto": "když se šeřil ranní svit:"
  },
  {
   "texto": "„Pojď již domů, ženo moje,"
  },
  {
   "texto": "dítě pláče, dej mu pít!“"
  },
  {
   "texto": "„Ach matičko, muka, muka —"
  },
  {
   "texto": "pro děťátko srdce puká!"
  },
  {
   "texto": "Matko má, matičko zlatá,"
  },
  {
   "texto": "nech mne, nech mne zase jít!“ —"
  },
  {
   "texto": "„Nikam nechoď, dcero moje,"
  },
  {
   "texto": "zradu kuje vodní vrah;"
  },
  {
   "texto": "ač že péči máš o dítě,"
  },
  {
   "texto": "mně o tebe větší strach."
  },
  {
   "texto": "Vari, vrahu, do jezera,"
  },
  {
   "texto": "nikam nesmí moje dcera;"
  },
  {
   "texto": "a pláče-li tvé děťátko,"
  },
  {
   "texto": "přines je sem na náš práh.“"
  },
  {
   "texto": "Na jezeře bouře hučí,"
  },
  {
   "texto": "v bouři dítě naříká;"
  },
  {
   "texto": "nářek ostře bodá v duši,"
  },
  {
   "texto": "potom náhle zaniká."
  },
  {
   "texto": "„Ach matičko, běda, běda,"
  },
  {
   "texto": "tím pláčem mi krev usedá;"
  },
  {
   "texto": "matko má, matičko zlatá,"
  },
  {
   "texto": "strachuji se vodníka!“ —"
  },
  {
   "texto": "Něco padlo. — Pode dveřmi"
  },
  {
   "texto": "mok se jeví — krvavý;"
  },
  {
   "texto": "a když stará otevřela,"
  },
  {
   "texto": "kdo leknutí vypraví!"
  },
  {
   "texto": "Dvě věci tu v krvi leží —"
  },
  {
   "texto": "mráz po těle hrůzou běží:"
  },
  {
   "texto": "dětská hlava bez tělíčka"
  },
  {
   "texto": "a tělíčko bez hlavy."
  }
 ]
}