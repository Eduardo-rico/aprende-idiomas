 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "22"
  },
  {
   "texto": "Nalákav se prachu z lidské hlíny,"
  },
  {
   "texto": "pojav hrobů živou myšlénku,"
  },
  {
   "texto": "darmo sháním z oka charé stíny,"
  },
  {
   "texto": "klesám zemdlen v krypty výklenku."
  },
  {
   "texto": "Spánek na oko se zmdlené sklání,"
  },
  {
   "texto": "jako mlha pláni zaplaví, -"
  },
  {
   "texto": "mlhu slunce v rosu rozehání, -"
  },
  {
   "texto": "mysl tvoří ve snu postavy."
  },
  {
   "texto": "Přede mnou se zaskví obraz jasný,"
  },
  {
   "texto": "z démantů jak záře setkaný,"
  },
  {
   "texto": "vystupuje z něho jinoch krásný,"
  },
  {
   "texto": "duševním kýms kouzlem pásaný."
  },
  {
   "texto": "V řasách volných přeskvostného rouna"
  },
  {
   "texto": "hraje sterá barva měňavá,"
  },
  {
   "texto": "tak jak v rouše prý chameleona"
  },
  {
   "texto": "s barvou svou květ každý zahrává."
  },
  {
   "texto": "„Kdož jsi? - Pravda? - Či tě sen můj bájí?“ -"
  },
  {
   "texto": "„Mne co mocnost věčné proměny"
  },
  {
   "texto": "bratři tvoji smrtí nazývají. -"
  },
  {
   "texto": "Sleduj mne jen, spáči zmámený!“"
  },
  {
   "texto": "Mimovolně noha moje vstane,"
  },
  {
   "texto": "spěchám divy uzřít žádaje,"
  },
  {
   "texto": "až duch před náhrobkem jakýms stane,"
  },
  {
   "texto": "bych si nápis četl, kývaje."
  },
  {
   "texto": "„Aj zde odpočívá poezie,"
  },
  {
   "texto": "byla, květla, zvadla, zetlela!“ -"
  },
  {
   "texto": "„V tom se, brachu, leda žert kýs kryje,"
  },
  {
   "texto": "poezie že by zemřela? -"
  },
  {
   "texto": "A co lyry zvuk by přeznít mělo?“"
  },
  {
   "texto": "Pokleknout mně dal duch znamení,"
  },
  {
   "texto": "z nitra země v ucho mocně znělo"
  },
  {
   "texto": "kyklopických kladiv bušení."
  },
  {
   "texto": "Poezie žila, dokud každý"
  },
  {
   "texto": "snům svým víc než pravdě uvěřil,"
  },
  {
   "texto": "dokud věci nám teď malicherné"
  },
  {
   "texto": "obrovským měřítkem vyměřil."
  },
  {
   "texto": "Dokud bájím věřil zastaralým,"
  },
  {
   "texto": "ježto zrodil zpráchnivělý věk,"
  },
  {
   "texto": "dokud v palmách dryádky se kryly -"
  },
  {
   "texto": "a ne ságo našich polívek."
  },
  {
   "texto": "Posud písně lásky rozkvétají,"
  },
  {
   "texto": "posud plynou v proudu časovém,"
  },
  {
   "texto": "chováť láska mnoho neznámého,"
  },
  {
   "texto": "nevysvětleného v lůně svém."
  },
  {
   "texto": "Láska zalétá k nám jak to ptáče"
  },
  {
   "texto": "z krajů neznámých, jih rodících,"
  },
  {
   "texto": "písně jeho - zvonků cinkot ranní,"
  },
  {
   "texto": "k životu novému budících."
  },
  {
   "texto": "Co kdy jinoch myslel, děva snila,"
  },
  {
   "texto": "co kdy nervem chvělo některým,"
  },
  {
   "texto": "uskutečněno mní v lásky době -"
  },
  {
   "texto": "chvějeť mocně tělem veškerým."
  }
 ]
}