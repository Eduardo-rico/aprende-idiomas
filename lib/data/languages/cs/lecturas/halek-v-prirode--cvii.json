 "modo": "texto",
 "parrafos": [
  {
   "texto": "CVII."
  },
  {
   "texto": "Mudrc žákům deklamoval:"
  },
  {
   "texto": "„Pravdu nesu ze rumů"
  },
  {
   "texto": "starých dob, na pergameně"
  },
  {
   "texto": "uloženou z rozumu."
  },
  {
   "texto": "Pravda jen, co tuto psáno"
  },
  {
   "texto": "a co z cifer vypočtem;"
  },
  {
   "texto": "srdce mluva — lichá mluva,"
  },
  {
   "texto": "v té se pravdy nedočtem.“"
  },
  {
   "texto": "A tu vstoupí kvítko z pole,"
  },
  {
   "texto": "jaro dech, máj v pohledu,"
  },
  {
   "texto": "hlavu slunečnou a modrou,"
  },
  {
   "texto": "ústa jako od medu."
  },
  {
   "texto": "Usmálo se, tázalo se:"
  },
  {
   "texto": "„Co jest pravda? Pověz jen!“ —"
  },
  {
   "texto": "Žáci hledí plní žasu,"
  },
  {
   "texto": "mudrc celý pomaten."
  },
  {
   "texto": "Pojď sem, ty pohozená lebko:"
  },
  {
   "texto": "buď nevíš nic, neb nepovíš;"
  },
  {
   "texto": "a co zas já vím a co říkám,"
  },
  {
   "texto": "jsi hluchá, o to nestojíš."
  },
  {
   "texto": "Nuž jaký hovor, kde jen ptaní,"
  },
  {
   "texto": "a zatvrzelé mlčení,"
  },
  {
   "texto": "kde hloubka jen, a žádné mosty,"
  },
  {
   "texto": "neb přechody a změlčení?"
  },
  {
   "texto": "A přec to ptaní náš je život,"
  },
  {
   "texto": "a mřeme sobě v odpověď;"
  },
  {
   "texto": "ba ptaly se už celé věky,"
  },
  {
   "texto": "jen více nikdo nedoved’."
  },
  {
   "texto": "Žít na smrt, kvésti na zvadnutí,"
  },
  {
   "texto": "být vše a ničím — obojím?"
  },
  {
   "texto": "Neptám se víc. Ta lebka mlčí"
  },
  {
   "texto": "a o jinou řeč nestojím."
  },
  {
   "texto": "Ticho! Čas se připozdívá,"
  },
  {
   "texto": "roku táhne na večer,"
  },
  {
   "texto": "příroda má těžká víčka —"
  },
  {
   "texto": "budem dřímat v zimní šer."
  },
  {
   "texto": "Pod hlavu už sobě střádá"
  },
  {
   "texto": "suché listí, zvadlou snět,"
  },
  {
   "texto": "slunce staví pod stínidlo,"
  },
  {
   "texto": "jako lampu v lazaret."
  },
  {
   "texto": "Nebes okna mhou zastírá,"
  },
  {
   "texto": "v lesích hovor zastaví,"
  },
  {
   "texto": "a ty ptáčky štěbetáčky"
  },
  {
   "texto": "k sousedovi dopraví."
  },
  {
   "texto": "Řeky už jen zvolna chodí,"
  },
  {
   "texto": "pokradmo a po špičkách,"
  },
  {
   "texto": "a těch těžkých snů už plno"
  },
  {
   "texto": "v holých číhá větvičkách."
  },
  {
   "texto": "Peří ve sníh nasedrané"
  },
  {
   "texto": "už si sype v závěje —"
  },
  {
   "texto": "ticho, my si podřímneme,"
  },
  {
   "texto": "než zas skřivan zapěje."
  },
  {
   "texto": "Stařičký mezi duby kmet"
  },
  {
   "texto": "přes dvě stě zelenal se let,"
  },
  {
   "texto": "dnes poprvé vstal zamyšlen,"
  },
  {
   "texto": "jak bez řeči, jak žalu plen."
  },
  {
   "texto": "Co jaro obléknul se čist"
  },
  {
   "texto": "v mlaďounký, ve průhledný list,"
  },
  {
   "texto": "a co jen ptáčkem zazvučí,"
  },
  {
   "texto": "to objal ve své náručí."
  },
  {
   "texto": "Jim lůžko ustlal do stínu,"
  },
  {
   "texto": "jim na noc chystal hostinu,"
  },
  {
   "texto": "a než-li v den se rozední,"
  },
  {
   "texto": "jim písně šeptal svatební."
  },
  {
   "texto": "Pak choval mladé zpěváčky"
  },
  {
   "texto": "se žlutavými zobáčky,"
  },
  {
   "texto": "a jak jen dozrál štěbeta,"
  },
  {
   "texto": "už posílal ho do světa."
  },
  {
   "texto": "Stařičký mezi duby kmet"
  },
  {
   "texto": "přes dvě stě nezastesk’ si let —"
  },
  {
   "texto": "dnes ptáčkům stého kolena;"
  },
  {
   "texto": "zda víte, co to znamená?"
  }
 ]
}