 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LXXXIX."
  },
  {
   "texto": "Drozd, lesa kápo, v přepyše"
  },
  {
   "texto": "sed’ na jedli si nejvýše,"
  },
  {
   "texto": "k hrám svolává a k nápěvu:"
  },
  {
   "texto": "„Dnes dostaneme návštěvu!“"
  },
  {
   "texto": "Co ptáček v letu, postojí"
  },
  {
   "texto": "a sáhne k svému nástroji,"
  },
  {
   "texto": "hned hlas i struny probírá,"
  },
  {
   "texto": "že div mi srdce nezmírá."
  },
  {
   "texto": "A hostí táhne do zvůle:"
  },
  {
   "texto": "na západ samá fakule,"
  },
  {
   "texto": "měsíček v záři celičký,"
  },
  {
   "texto": "a hvězdy s ním co dětičky."
  },
  {
   "texto": "A hvězdy malé, drobný svit,"
  },
  {
   "texto": "od jedné k druhé stříbrná nit —"
  },
  {
   "texto": "ty v lesku vedou, za šera"
  },
  {
   "texto": "tvář nejkraššího večera."
  },
  {
   "texto": "A teď už v lese započnou,"
  },
  {
   "texto": "tu na poslech, tu na skočnou,"
  },
  {
   "texto": "a každá hvězda mrká v dík —"
  },
  {
   "texto": "a jenom drozd je kapelník."
  },
  {
   "texto": "A což mne v lese liběj poutá,"
  },
  {
   "texto": "než z podkeří ta jahoda,"
  },
  {
   "texto": "když zardělá se pousmívá"
  },
  {
   "texto": "jak z dívčí tváře lahoda."
  },
  {
   "texto": "Tak pod lístečky, v stínu šerém,"
  },
  {
   "texto": "tak potměšile, s rozmarem,"
  },
  {
   "texto": "půl vábí a na půl se kreje,"
  },
  {
   "texto": "a přece být chce obdarem."
  },
  {
   "texto": "To snad tu někdy v stínu dřímal"
  },
  {
   "texto": "ret dívky za nejsladších chvil,"
  },
  {
   "texto": "a co chtěl vzkázat políbení,"
  },
  {
   "texto": "zde na ty nitky zavěsil."
  },
  {
   "texto": "A snad že chtěly lesy vidět"
  },
  {
   "texto": "tak v drobnojemném obrázku,"
  },
  {
   "texto": "co v šeru mají lesku, vůně"
  },
  {
   "texto": "a sladkých k žertům závazků."
  },
  {
   "texto": "Ba snad že, když se s nimi loučím"
  },
  {
   "texto": "tak ve smutku a ve zmatku,"
  },
  {
   "texto": "ten obrázek si vymyslily,"
  },
  {
   "texto": "bych vzal jej s sebou v památku."
  },
  {
   "texto": "Vzduch jarní naplněn je písní,"
  },
  {
   "texto": "ta hraje v dechu májovém,"
  },
  {
   "texto": "a každá větev aspoň hlásek"
  },
  {
   "texto": "má v lístečku jí domovem."
  },
  {
   "texto": "Vzduch jarní naplněn je krásou,"
  },
  {
   "texto": "ta svítí v nebi májovém,"
  },
  {
   "texto": "a každý kvítek aspoň lístek"
  },
  {
   "texto": "má v kalíšku jí domovem."
  },
  {
   "texto": "Vzduch jarní naplněn je láskou,"
  },
  {
   "texto": "ta kape v dešti májovém,"
  },
  {
   "texto": "a každý ptáček aspoň kapku"
  },
  {
   "texto": "má v hnízdečku jí domovem."
  },
  {
   "texto": "Tu slyšte, co se v lese děje:"
  },
  {
   "texto": "na večer, zrovna před lunou,"
  },
  {
   "texto": "tam stromy chodí jako lidé"
  },
  {
   "texto": "v hedbávném šatě, s korunou."
  },
  {
   "texto": "Ty jedny v hlavě samá pentle,"
  },
  {
   "texto": "ty druhé vážny celičky,"
  },
  {
   "texto": "ty jedny jako s kazatelny,"
  },
  {
   "texto": "ty druhé samé housličky."
  },
  {
   "texto": "Smrk s jedlí, ty se v smutku nosí,"
  },
  {
   "texto": "chtí v baládách jen kvíleti,"
  },
  {
   "texto": "tam u skal jedna píseň skládá"
  },
  {
   "texto": "o osiřelém dítěti."
  },
  {
   "texto": "Co s habrem buk, víc jako muži,"
  },
  {
   "texto": "věc tak si k srdci neberou,"
  },
  {
   "texto": "a je-li javor právě doma,"
  },
  {
   "texto": "i v sousedskou ho přiberou."
  },
  {
   "texto": "A břízy, ty jak vy, panenky,"
  },
  {
   "texto": "jen do větru a do skoku,"
  },
  {
   "texto": "tam kolem lesa plny lesku"
  },
  {
   "texto": "a v rej se drží po boku."
  }
 ]
}