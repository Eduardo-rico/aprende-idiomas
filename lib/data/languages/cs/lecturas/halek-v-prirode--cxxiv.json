 "parrafos": [
  {
   "texto": "CXXIV."
  },
  {
   "texto": "Od modravých hor závrati"
  },
  {
   "texto": "tak snadno již se nevrátí,"
  },
  {
   "texto": "kdo na nich k světla zdroji"
  },
  {
   "texto": "rozpínal duši svoji."
  },
  {
   "texto": "Kdo křídla duše v šíř i dél"
  },
  {
   "texto": "hvězd zlatým pelem posázel,"
  },
  {
   "texto": "a pak nad prostor světů"
  },
  {
   "texto": "se pustil v světlém letu —"
  },
  {
   "texto": "Kdo z červánkových rubínů"
  },
  {
   "texto": "si utkal duše hlubinu,"
  },
  {
   "texto": "a nadšen, Titan velký"
  },
  {
   "texto": "šel přes všech věků délky —"
  },
  {
   "texto": "Kdo s mladým jitrem tam si hrál,"
  },
  {
   "texto": "když den se noci z lože bral"
  },
  {
   "texto": "a shlížel v němém žasu"
  },
  {
   "texto": "na země matky krásu —"
  },
  {
   "texto": "Kdo z všeho míru pramene"
  },
  {
   "texto": "tam v srdce našel znavené"
  },
  {
   "texto": "dávného dětství ladno —"
  },
  {
   "texto": "ten nevrátí se snadno."
  },
  {
   "texto": "Lidičky dobří, co to díte,"
  },
  {
   "texto": "že doby pohádek ty tam?"
  },
  {
   "texto": "Tyť teprv počnou — a já dvéře"
  },
  {
   "texto": "až dokořán jim zotvírám."
  },
  {
   "texto": "To vyjde v děvic vonném reji"
  },
  {
   "texto": "ta slavná jara královna,"
  },
  {
   "texto": "má plná růže, prostřed květů,"
  },
  {
   "texto": "a všem se krásou vyrovná."
  },
  {
   "texto": "Pak vyjde ve průvodu skvělém"
  },
  {
   "texto": "nejspanilejší jara rek,"
  },
  {
   "texto": "můj švarný máj, jak měsíc mladý,"
  },
  {
   "texto": "kdy ještě chmur se nedotek’."
  },
  {
   "texto": "Tu zavzní na zvonění slavné"
  },
  {
   "texto": "malých i velkých kvítků zvon,"
  },
  {
   "texto": "pak udeří na harfy zlaté,"
  },
  {
   "texto": "kde který napjat v lese tón."
  },
  {
   "texto": "Pak budou svatby, budou hody"
  },
  {
   "texto": "po celý měsíc, ještě dýl —"
  },
  {
   "texto": "kus srdce jen, a máte vstupné"
  },
  {
   "texto": "na všechněch světů kratochvíl!"
  },
  {
   "texto": "Les vyšňořen tak do zelena"
  },
  {
   "texto": "jak myslivecký mládenec,"
  },
  {
   "texto": "stráň do běla a do červena,"
  },
  {
   "texto": "na samý květ a pupenec."
  },
  {
   "texto": "Dnes sotva lesu mluva stačí:"
  },
  {
   "texto": "za posly všecko vypraví,"
  },
  {
   "texto": "svých větrů šum i píseň ptačí,"
  },
  {
   "texto": "ty stráň mu pěkně pozdraví."
  },
  {
   "texto": "Stráň v rose ranní trávy česá,"
  },
  {
   "texto": "keř, šípky rozdýchala v květ,"
  },
  {
   "texto": "by ptáčkové, myšlenky lesa,"
  },
  {
   "texto": "kde měli sobě posedět."
  },
  {
   "texto": "Už letí přes řeku, ta v lesku,"
  },
  {
   "texto": "kus nebe do ní zapadlo,"
  },
  {
   "texto": "a poslům ukazuje stezku"
  },
  {
   "texto": "jak nejkrásnější zrcadlo."
  },
  {
   "texto": "Teď k stráni jmou se rozprávěti;"
  },
  {
   "texto": "teď nevím, kde ty nebesa,"
  },
  {
   "texto": "mé srdce s každým poslem letí"
  },
  {
   "texto": "hned na stráň, hned zas do lesa."
  },
  {
   "texto": "Nad staré pne se kořeny"
  },
  {
   "texto": "z kapradí oblouk zelený,"
  },
  {
   "texto": "když na něj brouček vyleze,"
  },
  {
   "texto": "vidět až tamhle za meze."
  },
  {
   "texto": "Vidět až tamhle naproti"
  },
  {
   "texto": "pomněnek modré klenutí,"
  },
  {
   "texto": "kol něho z bílé hladiny"
  },
  {
   "texto": "pramen si dmychá bubliny."
  },
  {
   "texto": "Vidět až mušky v doletě"
  },
  {
   "texto": "dojíždět s poštou o světě,"
  },
  {
   "texto": "některá jak když ze hloubi"
  },
  {
   "texto": "postilion si zatroubí."
  },
  {
   "texto": "Vidět skrz větví zábřesky"
  },
  {
   "texto": "dojíždět zlaté paprsky,"
  },
  {
   "texto": "dole pak zpěvnou stář a mláď"
  },
  {
   "texto": "zobáčkem v jemné vodě hrát."
  },
  {
   "texto": "Vidět až tamhle nad vodou"
  },
  {
   "texto": "keře se chlubit jahodou,"
  },
  {
   "texto": "šeptem se chlubit rákosí —"
  },
  {
   "texto": "jak je mým očím do rosy!"
  }
 ]
}