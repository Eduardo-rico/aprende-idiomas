 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (1 formas) con el actual en «-t» (2). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-lesetinsky-kovar",
  "titulo": "Lešetínský kovář",
  "orden": 2
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "III."
  },
  {
   "texto": "Do kovárny přišel jednou z rána"
  },
  {
   "texto": "správce na rozmluvu, tahy lstivé"
  },
  {
   "texto": "ladě v usmívání přívětivé."
  },
  {
   "texto": "Kovář do světnice vedl pána."
  },
  {
   "texto": "V úklidu již vzorném jizba celá"
  },
  {
   "texto": "v ranním jase čistotou se skvěla."
  },
  {
   "texto": "Liduška tam klonila se právě"
  },
  {
   "texto": "nad truhlicí pestrou, jižto plnil"
  },
  {
   "texto": "plátna sníh, kde různý šat se vlnil"
  },
  {
   "texto": "v hojných varhánků a třásní slávě."
  },
  {
   "texto": "Třesklo víko chvatně přiklopené,"
  },
  {
   "texto": "na němž obrázky vnitř nalepené"
  },
  {
   "texto": "zamihly se v barev, zlata třpytě."
  },
  {
   "texto": "Vyplašená dívka vstala spěšně,"
  },
  {
   "texto": "pozdravila hosta rozpačitě,"
  },
  {
   "texto": "v líci zardělá jak čerstvá třešně."
  },
  {
   "texto": "V zalíbení hleděl správce na ni,"
  },
  {
   "texto": "na zjev milý, zářně stojící"
  },
  {
   "texto": "před ním v čistém blesku záře ranní,"
  },
  {
   "texto": "jenž sem jasných oken dvojicí"
  },
  {
   "texto": "vnikal směsí listů průsvitných,"
  },
  {
   "texto": "květů ruměnných a blankytných;"
  },
  {
   "texto": "a květ jiný, ze zahrádky venku,"
  },
  {
   "texto": "- rosy sled mu svítil na lupénku —"
  },
  {
   "texto": "zdobil ňadra vábně porozvilá"
  },
  {
   "texto": "té, jež sama jitřním květem byla."
  },
  {
   "texto": "Hleděl ještě na postavu švarnou,"
  },
  {
   "texto": "lehounce když světlým fěrtochem"
  },
  {
   "texto": "otřela mu židli hrubotvárnou"
  },
  {
   "texto": "s vykrojeným v srdce lenochem,"
  },
  {
   "texto": "a spěl za ní ještě třpytným okem,"
  },
  {
   "texto": "do síně když vyšla švižným krokem."
  },
  {
   "texto": "Jizbou pak se rozhled’ usmívavě."
  },
  {
   "texto": "Od stěn sněhobílých řadou trámů"
  },
  {
   "texto": "nízký strop se odstiňuje tmavě."
  },
  {
   "texto": "Na všech stranách z úzkých, černých rámů"
  },
  {
   "texto": "vyzírají pestří svatí, svaté,"
  },
  {
   "texto": "v rukách nástroje muk, palmy zlaté;"
  },
  {
   "texto": "za největším zatknuta se bělá"
  },
  {
   "texto": "haluz kočiček. Však mistra Jana"
  },
  {
   "texto": "též tu visí malba neumělá"
  },
  {
   "texto": "a s ní hrdinská tvář Trocnovana"
  },
  {
   "texto": "z pod přílbice hledí zamračeně"
  },
  {
   "texto": "po biskupech na protější stěně."
  },
  {
   "texto": "V rohu postel vypíná se, plna"
  },
  {
   "texto": "peřin kyprých s růžovými pruhy,"
  },
  {
   "texto": "na truhlách čar pestrých mnohá vlna"
  },
  {
   "texto": "září s divným kvítím v barvách duhy."
  },
  {
   "texto": "A nad kamny z kachlů hladkých, tmavých"
  },
  {
   "texto": "visí, různou cetkou ozdobena,"
  },
  {
   "texto": "holubička z vejce urobená"
  },
  {
   "texto": "pestroskvoucích křídel mihotavých."
  },
  {
   "texto": "S úsměvem se rozhled’ po všem správce,"
  },
  {
   "texto": "na židlici sednuv. Proti němu"
  },
  {
   "texto": "kovář usedl na prosté lávce,"
  },
  {
   "texto": "tulící se k širých kamen lemu."
  },
  {
   "texto": "Volně sedí tu, jak nechal díla:"
  },
  {
   "texto": "V předu tělo, mužně ztepilé,"
  },
  {
   "texto": "z kůže zástěra mu obestýlá;"
  },
  {
   "texto": "pod rukávem režné košile,"
  },
  {
   "texto": "vykasaným vzhůru, mocné svaly"
  },
  {
   "texto": "jeví rámě, stmělé žárem, čmoudem;"
  },
  {
   "texto": "obličej pak divě počernalý"
  },
  {
   "texto": "pod havraních vlasů volným proudem"
  },
  {
   "texto": "na hosta pne jiskrnatý zor."
  },
  {
   "texto": "Takový byl obou rozhovor:"
  },
  {
   "texto": "Správce"
  },
  {
   "texto": "Vzrůstá úžasně, jak obr báje"
  },
  {
   "texto": "mladý závod náš. Skráň vypínaje"
  },
  {
   "texto": "nad údolí, každým krokem ničí"
  },
  {
   "texto": "některou vám chatu trpasličí."
  },
  {
   "texto": "Ale za vše, co teď nohou hněte,"
  },
  {
   "texto": "záhy hojné požehnání zkvete."
  },
  {
   "texto": "Za ty pošlapané hříčky dětské,"
  },
  {
   "texto": "za prostičké žití starosvětské"
  },
  {
   "texto": "doba slavnější těm horám vstane:"
  },
  {
   "texto": "Rozepne tu průmyslný duch"
  },
  {
   "texto": "perutě své zlaté, požehnané,"
  },
  {
   "texto": "probudí tu čilý dělný ruch,"
  },
  {
   "texto": "proudem veselým se rozehrají"
  },
  {
   "texto": "blahobyt a pokrok po všem kraji. —"
  },
  {
   "texto": "Než, jak pravil jsem, náš obr mladý"
  },
  {
   "texto": "vyrůstá, že ves vám celou zdolá,"
  },
  {
   "texto": "pravý Otesánek, už ji zpola"
  },
  {
   "texto": "pohltil a ještě zmírá hlady."
  },
  {
   "texto": "Avšak žerty stranou. Vaše jmění"
  },
  {
   "texto": "kovárna, k ní chaloupka ta sivá —"
  },
  {
   "texto": "rozmilé v ní kouzlí ovšem dlení"
  },
  {
   "texto": "dcery vaší ručka přičinlivá,"
  },
  {
   "texto": "ale přece — pravda nezabolí —"
  },
  {
   "texto": "přec to úhrnem jen trochu slámy"
  },
  {
   "texto": "obemšené nad vetchými trámy —"
  },
  {
   "texto": "na dlaň zahrádka, pak něco rolí."
  },
  {
   "texto": "Nám je třeba místa. Nuže, mistře!"
  },
  {
   "texto": "Shodnem’-li se na rozumnou cenu,"
  },
  {
   "texto": "zakoupím to všechno v pána jménu —"
  },
  {
   "texto": "Železo to žhavé kujte bystře!"
  },
  {
   "texto": "Kovář"
  },
  {
   "texto": "Vím, že mnoho nemám. Tato chata"
  },
  {
   "texto": "sivá, slaměná jak hnízdo ptačí"
  },
  {
   "texto": "proti domům vašim. Mně však stačí,"
  },
  {
   "texto": "ba mně milejší než koba zlatá."
  },
  {
   "texto": "Pohled váš tu vidí ovšem leda"
  },
  {
   "texto": "kupu dřev. Než jinak moje zraky:"
  },
  {
   "texto": "Za stolem tam dvojí hlava šedá"
  },
  {
   "texto": "prosvítá jim zašlých časů mraky,"
  },
  {
   "texto": "jim tu zevšad usmívá se vstříc"
  },
  {
   "texto": "ženy milované tichá líc,"
  },
  {
   "texto": "odevšad se noří milé tahy,"
  },
  {
   "texto": "chví se kolem nejen stín drahý —"
  },
  {
   "texto": "jsem tu doma — jsem tu mezi svými,"
  },
  {
   "texto": "třeba v památce jen živoucími."
  },
  {
   "texto": "Tato světnička se obrážela"
  },
  {
   "texto": "s první jitřenkou v mém dětském oku,"
  },
  {
   "texto": "tolik výjevů mně drahých zřela,"
  },
  {
   "texto": "radosti a žaly mnohých roků —"
  },
  {
   "texto": "Rcete mi, jak všechno toto cenit?"
  },
  {
   "texto": "Mám-li teplé toto hnízdo směnit"
  },
  {
   "texto": "za krov cizí, vanoucí jen mrazem?"
  },
  {
   "texto": "Zdá se mi, žeť srostlé sterým svazem"
  },
  {
   "texto": "srdce moje, spjaté poutem sterým"
  },
  {
   "texto": "s těmi stěnami, s tím stropem šerým."
  },
  {
   "texto": "Správce"
  },
  {
   "texto": "Jste muž citu. Zápal váš je chvalný,"
  },
  {
   "texto": "ale ze slov nekyne zisk valný."
  },
  {
   "texto": "Věřím, že jste poután k otců domu"
  },
  {
   "texto": "mnohou vnadnou, jiným utajenou,"
  },
  {
   "texto": "a chci slušný zřetel míti k tomu"
  },
  {
   "texto": "jakous částí nad skutečnou cenou."
  },
  {
   "texto": "Ale s mírou! Nedojdem’-li cíle"
  },
  {
   "texto": "u vás, jinam zanesem’ své zlato —"
  },
  {
   "texto": "Nuže, chutě! — Kdož vám ručí za to,"
  },
  {
   "texto": "vrátí-li se příhodná tak chvíle?!"
  },
  {
   "texto": "Za peníze pučí blaho všude;"
  },
  {
   "texto": "zřídíte se pěkně v domku novém,"
  },
  {
   "texto": "snad vám krásněj’, tepleji tam bude"
  },
  {
   "texto": "nežli pod tím starým, vetchým krovem."
  },
  {
   "texto": "Stejně milou, přívětivou síňku"
  },
  {
   "texto": "dcerušky tam vkouzlí ruce čilé —"
  },
  {
   "texto": "snad si do ní švarnou hospodyňku"
  },
  {
   "texto": "uvedete — jste muž v plné síle —,"
  },
  {
   "texto": "štěstí nového zář tam se vhostí,"
  },
  {
   "texto": "vábnější než stíny minulosti."
  },
  {
   "texto": "Kovárnu si pořídíte větší —"
  },
  {
   "texto": "…jinde snad. — Hm — … Pocítíte v mále,"
  },
  {
   "texto": "že náš závod nehrubě vám svědčí, —"
  },
  {
   "texto": "počet sousedů se tenčí stále,"
  },
  {
   "texto": "nám pak vašich kladiv třeba není —"
  },
  {
   "texto": "Všechno to je hodno uvážení."
  },
  {
   "texto": "Kovář"
  },
  {
   "texto": "Znám tu zlata řeč! Tak svůdně cinká,"
  },
  {
   "texto": "takto zpupně na chuďasa břinká!"
  },
  {
   "texto": "„Já jsem všemohoucím světa pánem!“"
  },
  {
   "texto": "pyšně volá. „Já jsem bohem doby!"
  },
  {
   "texto": "Skloňte se, vy lesků mojich robi!"
  },
  {
   "texto": "Odkoupím vám rodný krb i s lánem,"
  },
  {
   "texto": "domov, předků památky i hroby."
  },
  {
   "texto": "Co vy jste, vy lidé holých dlaní,"
  },
  {
   "texto": "v jařmu práce bičem nouze štvaní,"
  },
  {
   "texto": "co jest vaše vůle, krtčí snaha"
  },
  {
   "texto": "proti mé, jež odpor každý zmáhá?!"
  },
  {
   "texto": "Vaše duše, myšlenky a city,"
  },
  {
   "texto": "všechno moje zaplatí vám třpyty.“"
  },
  {
   "texto": "Znám tu řeč; tak z vašich slov mi zvoní —"
  },
  {
   "texto": "však má šíj’ se před ní neukloní."
  },
  {
   "texto": "Nechať pán váš zaplaví vše kol"
  },
  {
   "texto": "zlatem svým, ať skoupí celý dol,"
  },
  {
   "texto": "všem, kdož bývali tu domovem,"
  },
  {
   "texto": "odloudí krov otců, rodnou zem’:"
  },
  {
   "texto": "já tu pevně setrvám jak z žuly!"
  },
  {
   "texto": "On má zlato své — já mám svou vůli —"
  },
  {
   "texto": "zde chci být, chci podržet, co mám,"
  },
  {
   "texto": "a tím jeho zlatem pohrdám!"
  },
  {
   "texto": "Správce"
  },
  {
   "texto": "Proč ty hněvy?! Máte vůli svou."
  },
  {
   "texto": "Nechcete — nuž dobrá! Půjdu dále."
  },
  {
   "texto": "Však-tě vaši zlobu svéhlavou"
  },
  {
   "texto": "ukrotí as rozum lepší v mále,"
  },
  {
   "texto": "až vám pavouk hustým předivem"
  },
  {
   "texto": "otká kovadlinu s kladivem —"
  },
  {
   "texto": "a snad pozdě bude. S bohem tedy!"
  },
  {
   "texto": "Kovář"
  },
  {
   "texto": "S bohem, pane! A nechť naposledy"
  },
  {
   "texto": "překročil jste práh můj s takým vzkazem!"
  },
  {
   "texto": "Nechť mi pustá výheň fičí mrazem,"
  },
  {
   "texto": "ať ni hřebu nezbude mi kouti,"
  },
  {
   "texto": "spíš ta chatrč nade mnou se shroutí,"
  },
  {
   "texto": "než bych postoupil z ní třísky jedné!"
  },
  {
   "texto": "Zde mí předci žili, zde mi svit’"
  },
  {
   "texto": "oka nebeského první třpyt,"
  },
  {
   "texto": "zde jsem prožil roky šťastné, bědné,"
  },
  {
   "texto": "zde chci dále žít, ať v nouzi, trudě,"
  },
  {
   "texto": "a kde stojím, na té zemru půdě!"
  },
  {
   "texto": "IV."
  },
  {
   "texto": "Srší jiskry, srší,"
  },
  {
   "texto": "s kovadliny prší,"
  },
  {
   "texto": "perlík buší vesele,"
  },
  {
   "texto": "do stropu si poskakuje,"
  },
  {
   "texto": "pro dvě srdce pouto kuje"
  },
  {
   "texto": "ze železa, z ocele."
  },
  {
   "texto": "Co nám oko vlaží,"
  },
  {
   "texto": "co nám duši blaží,"
  },
  {
   "texto": "nikdo neví z dědiny,"
  },
  {
   "texto": "že se dávno rádi máme,"
  },
  {
   "texto": "věrnost sobě přísaháme, —"
  },
  {
   "texto": "ví jen měsíc jediný."
  },
  {
   "texto": "Slunéčko se chýlí,"
  },
  {
   "texto": "vzchází měsíc bílý,"
  },
  {
   "texto": "hvězdy svítí do šera —"
  },
  {
   "texto": "mezi nimi nejskvělejší"
  },
  {
   "texto": "oči mojí znejmilejší,"
  },
  {
   "texto": "když mě čeká z večera."
  },
  {
   "texto": "Čeká mezi vrátky"
  },
  {
   "texto": "dole u zahrádky"
  },
  {
   "texto": "pod košatou jabloní;"
  },
  {
   "texto": "tisíc květů s hůry letí,"
  },
  {
   "texto": "když mi padne do objetí,"
  },
  {
   "texto": "když se ke mně přikloní."
  },
  {
   "texto": "Tvoje ústa malá,"
  },
  {
   "texto": "jako třešně zralá,"
  },
  {
   "texto": "voní nad jabloně květ;"
  },
  {
   "texto": "tvoje sladká, čerstvá líčka"
  },
  {
   "texto": "krásnější jsou nad jablíčka,"
  },
  {
   "texto": "co jich rodí širý svět."
  },
  {
   "texto": "Liduško má milá,"
  },
  {
   "texto": "dívko roztomilá,"
  },
  {
   "texto": "jsi-li z ranních červánků?"
  },
  {
   "texto": "Na srdce když vinu tebe,"
  },
  {
   "texto": "nade mnou hned plno nebe"
  },
  {
   "texto": "jásajících skřivánků."
  },
  {
   "texto": "Pověz, moje zlato,"
  },
  {
   "texto": "odpověz mi na to:"
  },
  {
   "texto": "Máš-li křídla ukrytá?"
  },
  {
   "texto": "Když se ke mně tulíš jemně,"
  },
  {
   "texto": "pod nohou mi klesá země,"
  },
  {
   "texto": "boží ráj mi zasvitá…"
  },
  {
   "texto": "Buší perlík, buší,"
  },
  {
   "texto": "tvrdý ocel kruší,"
  },
  {
   "texto": "jiskry srší do kola —"
  },
  {
   "texto": "ale pouto, které pojí"
  },
  {
   "texto": "duši mou a duši tvoji,"
  },
  {
   "texto": "žádná síla nezdolá."
  }
 ]
}