  "orden": 21
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "N*N*"
  },
  {
   "texto": "Mně jest jak otci v zoufalství,"
  },
  {
   "texto": "o lásko moje mladá,"
  },
  {
   "texto": "jenž nad dítětem v kolébce"
  },
  {
   "texto": "bolestné ruce skládá."
  },
  {
   "texto": "Co měl kdys, zas mu odňato,"
  },
  {
   "texto": "a strach se v prsou množí,"
  },
  {
   "texto": "že nejmilejší poupě své"
  },
  {
   "texto": "ku starším v kryptu vloží."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Kdo může oko zarositi bolem,"
  },
  {
   "texto": "když úsměv, květ a blaho všude kolem?"
  },
  {
   "texto": "Kdož může násilně si vzbudit tíseň,"
  },
  {
   "texto": "když duší táhne jarní zase píseň?"
  },
  {
   "texto": "Kdož může zazlít, že jsem, jarem zmámen,"
  },
  {
   "texto": "vyšlehnout nechal živé lásky plamen?"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Ben Akiba věhlasný děl:"
  },
  {
   "texto": "„Aj vše zde bylo jednou již!“"
  },
  {
   "texto": "Ben Akibo, ty's hlava ctná,"
  },
  {
   "texto": "nemůžeš za to, lež že díš!"
  },
  {
   "texto": "To vše zde bylo ovšem již!"
  },
  {
   "texto": "Byl již tak měkký, černý vlas,"
  },
  {
   "texto": "byl již tak korálový ret,"
  },
  {
   "texto": "i byl tak střlbrozvučný hlas!"
  },
  {
   "texto": "To vše zde bylo ovšem již!"
  },
  {
   "texto": "Aj byla již tak hebká tvář,"
  },
  {
   "texto": "a mnohé oko patřilo"
  },
  {
   "texto": "již v takou divnou oka zář!"
  },
  {
   "texto": "Však s báječným tím kouzlem zde"
  },
  {
   "texto": "v tom souladu — o slyš mne, slyš,"
  },
  {
   "texto": "Ben Akibo, ty's hlava ctná,"
  },
  {
   "texto": "nemůžeš za to, lež že díš!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Jako perleť lesklá, zrcadelná"
  },
  {
   "texto": "skví se krásná matička má Praha,"
  },
  {
   "texto": "vždyť v ní roste, v ní se rozpaluje"
  },
  {
   "texto": "ach tak mnohá, mnohá perla drahá."
  },
  {
   "texto": "Mám se věru za prvního muže,"
  },
  {
   "texto": "duch můj žije u nádherném plesu:"
  },
  {
   "texto": "vždyť z těch drahých perel nejskvostnější"
  },
  {
   "texto": "co svůj šperk na hrdém srdci nesu!"
  },
  {
   "texto": "Již se ta zima milená"
  },
  {
   "texto": "za krátko dokrvácí"
  },
  {
   "texto": "a v rozloučenou její vzdech"
  },
  {
   "texto": "divoce zaburácí."
  },
  {
   "texto": "O pojďte, vichry, k prsoum mým,"
  },
  {
   "texto": "ať mrazem srdce skojím —"
  },
  {
   "texto": "já se těch krásných jarních dnů"
  },
  {
   "texto": "jak všeho štěstí bojím!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Kdo už více jar těch přežil,"
  },
  {
   "texto": "Ví, jak jaro uplyne"
  },
  {
   "texto": "a že jaro, léto, jeseň"
  },
  {
   "texto": "mžikem v zimě zahyne."
  },
  {
   "texto": "Kdo už mnohé jaro přežil,"
  },
  {
   "texto": "blahu více nevěří,"
  },
  {
   "texto": "lehko při novém zas jaru"
  },
  {
   "texto": "na své srdce zanevří."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Vichr nade krovem hučí,"
  },
  {
   "texto": "truchle, bolně hýká,"
  },
  {
   "texto": "zoufale, jak zdravý člověk,"
  },
  {
   "texto": "jenž se umřít zvyká."
  },
  {
   "texto": "Nevím, proč se při těch zvucích"
  },
  {
   "texto": "prsa moje ouží,"
  },
  {
   "texto": "co mne ve vzdechu tom bolí"
  },
  {
   "texto": "a co mne v něm souží."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nevím, proč ta země posud"
  },
  {
   "texto": "v těžkých snech svých mešká,"
  },
  {
   "texto": "že jen leckde prohlíd’ kvítek,"
  },
  {
   "texto": "na něm slza těžká."
  },
  {
   "texto": "Nevím, zdaž mně nějaký sen"
  },
  {
   "texto": "také oči svíral,"
  },
  {
   "texto": "vím však, že jsem náhle s tváře"
  },
  {
   "texto": "velkou slzu stíral."
  },
  {
   "texto": "Tak divně jaro počínává —"
  },
  {
   "texto": "mrak po nebi se plazí"
  },
  {
   "texto": "a celá příroda si vzdychá,"
  },
  {
   "texto": "že to až v duši mrazí!"
  },
  {
   "texto": "Ba i ty větry z krajů dálných"
  },
  {
   "texto": "jen písně smrti nesou"
  },
  {
   "texto": "a v každých prsou ozvěny se"
  },
  {
   "texto": "pašijních písní třesou."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Pašijní píseň, perlo lidstva bolu,"
  },
  {
   "texto": "srdce slzo, v duši ceděná,"
  },
  {
   "texto": "když tvé zvuky v prsa naše skanou,"
  },
  {
   "texto": "vzplápolá v nich bolest plamenná."
  },
  {
   "texto": "Prsa celá ve srdce se zouží,"
  },
  {
   "texto": "hlavou víří divé hučení,"
  },
  {
   "texto": "smrť se blíží, člověk volí zhynout,"
  },
  {
   "texto": "umřít třeba v strašném zmučení!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Zas bude parno jarní zrát"
  },
  {
   "texto": "a v máji nové květy kvést,"
  },
  {
   "texto": "ve květech nové vánky hrát"
  },
  {
   "texto": "a jiné dívky věnce plést."
  },
  {
   "texto": "Zas mnohý hoch ve lásky čas"
  },
  {
   "texto": "z těch věnců jeden dostane"
  },
  {
   "texto": "a z mnohých věnců suchý zas"
  },
  {
   "texto": "jen lístek v knize zůstane."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nevím, mám-li milovat,"
  },
  {
   "texto": "nevím, mám-li zpívat,"
  },
  {
   "texto": "nebo, k jaru lhostejný,"
  },
  {
   "texto": "v zašlý čas se dívat."
  },
  {
   "texto": "Na své lásky lichou pouť,"
  },
  {
   "texto": "na své mládí těžké —"
  },
  {
   "texto": "vzpomínkou se umořit"
  },
  {
   "texto": "též by bylo hezké!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Byl jednou mládec, miloval,"
  },
  {
   "texto": "a miloval jich více,"
  },
  {
   "texto": "že všechny šťastně miloval,"
  },
  {
   "texto": "vybledly jeho líce."
  },
  {
   "texto": "Tak přišlo léto s jesení"
  },
  {
   "texto": "a přišlo jara hrání,"
  },
  {
   "texto": "však mládec žehral s jarem už"
  },
  {
   "texto": "a měl se k umírání."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Rychle hlava myslí,"
  },
  {
   "texto": "rychle srdce bije,"
  },
  {
   "texto": "tužba rychle zraje,"
  },
  {
   "texto": "člověk rychle žije."
  },
  {
   "texto": "Náhle u nového"
  },
  {
   "texto": "člověk jara stojí,"
  },
  {
   "texto": "neví, proč se třese,"
  },
  {
   "texto": "neví, proč se bojí."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Za ty krásné city,"
  },
  {
   "texto": "jichž mé srdce chová,"
  },
  {
   "texto": "nedostalo světem"
  },
  {
   "texto": "víc než holá slova."
  },
  {
   "texto": "Za všechno to zlato,"
  },
  {
   "texto": "co ho v širém světě,"
  },
  {
   "texto": "v srdci jaro citů"
  },
  {
   "texto": "více nerozkvěte!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nový život jaro lije"
  },
  {
   "texto": "v žíly bujně napnuté,"
  },
  {
   "texto": "znova výbojně v svět hledí"
  },
  {
   "texto": "mnohé šíje nahnuté!"
  },
  {
   "texto": "A než květy zvadnou, mnohým"
  },
  {
   "texto": "stláno pro věk ve mechu —"
  },
  {
   "texto": "nade rovem v příštím jaru"
  },
  {
   "texto": "vzrostou květy k posměchu."
  },
  {
   "texto": "Ležím v bujném, pestrém drnu,"
  },
  {
   "texto": "větřík běží travou,"
  },
  {
   "texto": "modrým květem vedlé hlavy,"
  },
  {
   "texto": "bílým nade hlavou."
  },
  {
   "texto": "Běží po vrcholcích stromů,"
  },
  {
   "texto": "v spěchu sadem duje,"
  },
  {
   "texto": "za ním pod stromy se zvolna"
  },
  {
   "texto": "pohřeb pohybuje."
  },
  {
   "texto": "To nesli pramlaďounké"
  },
  {
   "texto": "ku hrobu kolem žití,"
  },
  {
   "texto": "snad teprv poznávalo,"
  },
  {
   "texto": "jak jaro v srdce svítí."
  },
  {
   "texto": "Snad bylo jak ten skřivan,"
  },
  {
   "texto": "jenž jarem teprv vrácen"
  },
  {
   "texto": "a po první hned písni"
  },
  {
   "texto": "zlým krahujem byl zchvácen."
  },
  {
   "texto": "Kolem cesty staré stromy"
  },
  {
   "texto": "lidem soucit hlásaly,"
  },
  {
   "texto": "na vůz černý s lesklou rosou"
  },
  {
   "texto": "bílé květy střásaly."
  },
  {
   "texto": "Bílé květy divný tanec"
  },
  {
   "texto": "na vozíku skákaly,"
  },
  {
   "texto": "a ti lidé k jejich tanci"
  },
  {
   "texto": "truchlou píseň plakali."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Psal jsem v pošmourné své písně"
  },
  {
   "texto": "svoje city zprahlé"
  },
  {
   "texto": "a tu v okno zaskočilo"
  },
  {
   "texto": "jarní slunko náhlé."
  },
  {
   "texto": "Rozsypalo po papíru"
  },
  {
   "texto": "a po péře zlato"
  },
  {
   "texto": "a já píšu jasný konec"
  },
  {
   "texto": "k truchlým písním za to."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "O těš se z jara, třeba by"
  },
  {
   "texto": "tvá prsa prach jen kryla"
  },
  {
   "texto": "a v srdci — žití hodinách —"
  },
  {
   "texto": "jen samá půlnoc bila!"
  },
  {
   "texto": "Nechť každý květ ti mluvou svou"
  },
  {
   "texto": "„Smrť nesu s sebou!“ řekne,"
  },
  {
   "texto": "kdo sám kdys kvetl, tomu je"
  },
  {
   "texto": "i zahynutí pěkné."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Led zmizel, řeka volna zase"
  },
  {
   "texto": "ku modrým dálkám spěje"
  },
  {
   "texto": "a každá vlnka radostí se,"
  },
  {
   "texto": "že pocestuje, chvěje."
  },
  {
   "texto": "Já musil prchnout ode břehů,"
  },
  {
   "texto": "k nimž chvění vln mne táhlo,"
  },
  {
   "texto": "to toužení po modré dálce"
  },
  {
   "texto": "až ku srdci mi sáhlo!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Řekněte mně, větrové vy,"
  },
  {
   "texto": "odkud veslujete,"
  },
  {
   "texto": "že mne jako v pozdravení"
  },
  {
   "texto": "v čelo celujete?"
  },
  {
   "texto": "Plni jste vy divných šeptů,"
  },
  {
   "texto": "plni divné vůně,"
  },
  {
   "texto": "přišli jste snad z krajů oněch,"
  },
  {
   "texto": "k nimž mé srdce stůně?"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "V krátku přijdou horcí dnové"
  },
  {
   "texto": "přijde život líný,"
  },
  {
   "texto": "budou milejší nad slunce"
  },
  {
   "texto": "tmavé jeho stíny."
  },
  {
   "texto": "V chladné trávě, v palných snech svých"
  },
  {
   "texto": "zas se povyválím,"
  },
  {
   "texto": "mysle, jak as rok zas žití"
  },
  {
   "texto": "marně prozahálím!"
  }
 ]
}