 "parrafos": [
  {
   "texto": "Oběšenec"
  },
  {
   "texto": "„Oj! to divně nade krovem hučí!"
  },
  {
   "texto": "bouř se vzpírá v šedých skalinách?"
  },
  {
   "texto": "pláč to snad? či vichr bolně skučí?"
  },
  {
   "texto": "co to hýká v pustých roklinách?"
  },
  {
   "texto": "Modlete se děti — poklekněte!"
  },
  {
   "texto": "Jistě že se někdo oběsil."
  },
  {
   "texto": "Meluzína úpí, naslechněte —"
  },
  {
   "texto": "tak by divý vichor neběsil.“"
  },
  {
   "texto": "Dvé robátek útlé ruce zdvíhá,"
  },
  {
   "texto": "plachá ústa píseň zachvějí."
  },
  {
   "texto": "Hu tu rána! — blesk se v blesku mihá"
  },
  {
   "texto": "dvéře lítnou z vetchých veřejí —"
  },
  {
   "texto": "A na prahu chlapec uděšený,"
  },
  {
   "texto": "oči v sloup a ret má zsinalý;"
  },
  {
   "texto": "„„Otec — na jabloni — oběšený!““"
  },
  {
   "texto": "Klesá — děs mu mysl pokalí."
  },
  {
   "texto": "Dále svítí blesky v hromův víru,"
  },
  {
   "texto": "sotva že se křížem požehnáš;"
  },
  {
   "texto": "neviňátka pějí v blahém míru"
  },
  {
   "texto": "za hříšného otce „Otče náš!“"
  },
  {
   "texto": "Za tabulí u plného"
  },
  {
   "texto": "pytlák Joza vesel sedí,"
  },
  {
   "texto": "na šenkýřku, hezkou vdovu,"
  },
  {
   "texto": "jak by zamilován hledí."
  },
  {
   "texto": "„Ale ženo, vámť se daří!"
  },
  {
   "texto": "rozkvítáte jako růže!“"
  },
  {
   "texto": "„„Viďte? Vždyť jsem pochovala"
  },
  {
   "texto": "třetího teprvé muže!\"\""
  },
  {
   "texto": "„Třetího! — Však povídají,"
  },
  {
   "texto": "že jste jim vždy udělala!“ —"
  },
  {
   "texto": "„„Nu jen potud, abych sama"
  },
  {
   "texto": "dříve v hrob si neustlala!"
  },
  {
   "texto": "První klekl před oltářem"
  },
  {
   "texto": "dřív než já při svatbě naší —"
  },
  {
   "texto": "mohu-liž já za to, že to"
  },
  {
   "texto": "muži dříve smrt přináší?!"
  },
  {
   "texto": "Druhý umyl po hostině"
  },
  {
   "texto": "ruce sobě v vodě živé,"
  },
  {
   "texto": "kdo dřív béře vody živé,"
  },
  {
   "texto": "známo, že též umře dříve."
  },
  {
   "texto": "Třetí za svatební noci"
  },
  {
   "texto": "usnul dřív než já jsem spala —"
  },
  {
   "texto": "to přináší smrť dřívější! —"
  },
  {
   "texto": "tak — no tak jsem udělala!““"
  },
  {
   "texto": "„Eh což! však bych se vás nebál!"
  },
  {
   "texto": "Vdova tří a přede jak růže!“ —"
  },
  {
   "texto": "„„A což myslíte, že bych já"
  },
  {
   "texto": "čtvrtého se bála muže?““"
  },
  {
   "texto": "„Ne? nu tedy na pozoru,"
  },
  {
   "texto": "sic vás k čtvrtým vdavkám svedu!“ —"
  },
  {
   "texto": "„„Budiž tedy, aspoň k peklu"
  },
  {
   "texto": "o třech kolech nepojedu!““"
  }
 ]
}