 "fuenteUrl": "https://cs.wikisource.org/wiki/Hanuman",
 "fuente": "cs.wikisource.org, «Hanuman»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (2 formas) con el actual en «-t» (4). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-hanuman",
  "titulo": "Hanuman",
  "orden": 8
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "stín poslední v tom osvíceném státě."
  },
  {
   "texto": "Řeč lidská příliš chudobarvá jest,"
  },
  {
   "texto": "by vhodně vylíčila slavný vjezd,"
  },
  {
   "texto": "jímž král se vrátil sídelnímu městu:"
  },
  {
   "texto": "jak spoustu kvítí sypaly mu v cestu"
  },
  {
   "texto": "opičky vystrojené v oděv bílý;"
  },
  {
   "texto": "jak před palmovou pyšnou slavobranou"
  },
  {
   "texto": "purkmistr řečí pracně studovanou"
  },
  {
   "texto": "všem způsobil slavnostní dlouhou chvíli;"
  },
  {
   "texto": "jak mračny zvědavců se tměly střechy"
  },
  {
   "texto": "a špalír v ulicích se pestřil cechy;"
  },
  {
   "texto": "jak slávy voláním se země chvěla,"
  },
  {
   "texto": "všem slza nadšení se v očích skvěla,"
  },
  {
   "texto": "kdy vjížděl Hanuman a blahosklonně"
  },
  {
   "texto": "na všechny strany rukou, hlavou kýval,"
  },
  {
   "texto": "an přes plece až po kotníky koně"
  },
  {
   "texto": "obrovský věnec bobkový mu splýval"
  },
  {
   "texto": "i dvojí drahá stuha atlasová,"
  },
  {
   "texto": "v nichž zlatem třpytila se chvály slova -"
  },
  {
   "texto": "na jedné: „Božská Fiametto, dík!“"
  },
  {
   "texto": "a na druhé: „Tvé nožky nevolník!“"
  },
  {
   "texto": "Za králem hrdě bral se pestrý šik,"
  },
  {
   "texto": "na přilbách zeleň palmového mlází,"
  },
  {
   "texto": "květ orchidejí věnčil hroty pík"
  },
  {
   "texto": "a pušky, hrozící jak sluje zkázy,"
  },
  {
   "texto": "i prapory, v jichž středu vzácný plen"
  },
  {
   "texto": "- chvost Vindragupty - k žerdi připevněn."
  },
  {
   "texto": "A téhož dne kotillonových řádů"
  },
  {
   "texto": "déšť bohatý se snesl na armádu."
  },
  {
   "texto": "Vlastenští pěvci lyrou neúnavnou"
  },
  {
   "texto": "čas dlouhý opěvali bitvu slavnou,"
  },
  {
   "texto": "a pedagogů loyální zápal"
  },
  {
   "texto": "rád, jako jinde, látky té se chápal,"
  },
  {
   "texto": "by o vítězném králi do čítanky"
  },
  {
   "texto": "cpal štědře vzletné básničky a články -"
  },
  {
   "texto": "což opíčatům útlá prsa dětská"
  },
  {
   "texto": "vždy rozvlnila pýcha vlastenecká,"
  },
  {
   "texto": "když čítali, jak chrabrý mocnář jejich"
  },
  {
   "texto": "s udatným vojskem bitvu krvavou,"
  },
  {
   "texto": "jíž neshledá se rovné v lidstva dějích,"
  },
  {
   "texto": "své jméno pokryl věčnou oslavou,"
  },
  {
   "texto": "jak útokem, jenž zatřás širou nivou"
  },
  {
   "texto": "a zděsil všechny tygry pralesa,"
  },
  {
   "texto": "nad Vindragupty tvrzí přestrašlivou"
  },
  {
   "texto": "svůj prapor hrdě vztyčil v nebesa!"
  },
  {
   "texto": "VIII"
  },
  {
   "texto": "Takto slávou, blahobytem"
  },
  {
   "texto": "opičí stát rozkvétal;"
  },
  {
   "texto": "však stín jakýs mnohdy čelem"
  },
  {
   "texto": "Hanumanu přelétal -"
  },
  {
   "texto": "bylť mu těsným prales hluchý,"
  },
  {
   "texto": "kde jen papouš slaboduchý"
  },
  {
   "texto": "v posměch opům štěbetal."
  },
  {
   "texto": "Ach, co platno, že zde máme"
  },
  {
   "texto": "všechno jako u lidí,"
  },
  {
   "texto": "- vzdychal - když tu pokročilost"
  },
  {
   "texto": "lidské oko nevidí,"
  },
  {
   "texto": "a když tvůrce toho všeho"
  },
  {
   "texto": "obdiv světa vzdělaného"
  },
  {
   "texto": "po zásluze neklidí!"
  },
  {
   "texto": "Na sněm valný svolal opy"
  },
  {
   "texto": "a tak řečnil s prestolu:"
  },
  {
   "texto": "Nebe přálo, že jsem dostál"
  },
  {
   "texto": "vznešenému úkolu,"
  },
  {
   "texto": "že mou snahou opů plémě"
  },
  {
   "texto": "k lidské výši vzneslo témě,"
  },
  {
   "texto": "k věd a uměn vrcholu."
  },
  {
   "texto": "Však je třeba zjevit lidem,"
  },
  {
   "texto": "že již nejsme divocí;"
  },
  {
   "texto": "třeba čestné místo v řadě"
  },
  {
   "texto": "národů si vymoci;"
  },
  {
   "texto": "nutno též dle státních řádů,"
  },
  {
   "texto": "by mou opí říš a vládu"
  },
  {
   "texto": "stvrdil souhlas velmocí."
  },
  {
   "texto": "Protož odhodlán jsem pevně"
  },
  {
   "texto": "pro národa oslavu"
  },
  {
   "texto": "podniknouti do Evropy"
  },
  {
   "texto": "velkolepou výpravu,"
  },
  {
   "texto": "zjevit žasnoucímu světu"
  },
  {
   "texto": "v plném vzdělanosti květu"
  },
  {
   "texto": "opičí svou državu."
  },
  {
   "texto": "Pouť ta přinese nám velký"
  },
  {
   "texto": "prospěch v každé příčině:"
  },
  {
   "texto": "vzdělanost tam pochytíme"
  },
  {
   "texto": "v každém jemném odstíně."
  },
  {
   "texto": "Naučíme se tam hravě"
  },
  {
   "texto": "beefsteak krájeti tak právě,"
  },
  {
   "texto": "jak se krájí v Londýně."
  },
  {
   "texto": "V Babylonu na Sekvaně,"
  },
  {
   "texto": "ohnisku vší osvěty,"
  },
  {
   "texto": "prostudujem polosvěta"
  },
  {
   "texto": "vrtochy a zálety,"
  },
  {
   "texto": "zřídíme si roucha přesná,"
  },
  {
   "texto": "neb náš oděv - duma děsná! -"
  },
  {
   "texto": "z módy vyšel před lety."
  },
  {
   "texto": "Ale prospěch nejvzácnější"
  },
  {
   "texto": "v Berlíně nám vyklíčí:"
  },
  {
   "texto": "odtud vezmu důstojníky,"
  },
  {
   "texto": "již mé vojsko vycvičí,"
  },
  {
   "texto": "že pak ve zbrani svět celý"
  },
  {
   "texto": "čeliti se neosmělí"
  },
  {
   "texto": "armádě mé opičí."
  },
  {
   "texto": "A pak - již mi teskno věru"
  },
  {
   "texto": "na prestolu sedět sám,"
  },
  {
   "texto": "srdce toužebné mě pudí"
  },
  {
   "texto": "v manželského štěstí chrám:"
  },
  {
   "texto": "rozhlédnu se u všech dvorů,"
  },
  {
   "texto": "ve princezen jasném sboru"
  },
  {
   "texto": "sličnou choť si vyhledám."
  },
  {
   "texto": "Budu vítán od mocnářů,"
  },
  {
   "texto": "ku přehlídkám vojska brán,"
  },
  {
   "texto": "a pluk mnohý po Evropě"
  },
  {
   "texto": "mojím jménem bude zván;"
  },
  {
   "texto": "v novinách se bude čísti,"
  },
  {
   "texto": "co kde ráčil pít a jísti"
  },
  {
   "texto": "královský host Hanuman."
  },
  {
   "texto": "Vždyť tam pocty skvělé získal"
  },
  {
   "texto": "veleby mé pouhý stín,"
  },
  {
   "texto": "zavítavší do Evropy"
  },
  {
   "texto": "polobarbar Nasr-ed-Din;"
  },
  {
   "texto": "sloupce plníval všech listů"
  },
  {
   "texto": "každý z jeho ametystů,"
  },
  {
   "texto": "každý bídný almandin."
  },
  {
   "texto": "Komonstvo mé teprv vzbudí"
  },
  {
   "texto": "všeho světa úžasy -"
  },
  {
   "texto": "Již se strojte! Každý vezmi"
  },
  {
   "texto": "nejdražší své okrasy,"
  },
  {
   "texto": "cestovní též úbor řádný -"
  },
  {
   "texto": "zvláště nezapomeň žádný"
  },
  {
   "texto": "kartáček mi na vlasy!"
  },
  {
   "texto": "IX"
  },
  {
   "texto": "Oblek Hanuman svou řízu zlatou,"
  },
  {
   "texto": "ozdobil se korunou a žezlem,"
  },
  {
   "texto": "vzal své všecky ministry a šperky"
  },
  {
   "texto": "a tak bral se k dálné Kalkutě."
  },
  {
   "texto": "Byla noc, když po svízelích četných"
  },
  {
   "texto": "dostihl tam velebného vodstva,"
  },
  {
   "texto": "na němž právě k pouti do Evropy"
  },
  {
   "texto": "koráb rozpjal bílé perutě."
  },
  {
   "texto": "Královský tu průvod na loď chvátal,"
  },
  {
   "texto": "plavci zdvihli úzké prkno za ním,"
  },
  {
   "texto": "s úsměvem jej vítal vládce lodi -"
  },
  {
   "texto": "klnout bude zrádci příští věk!"
  },
  {
   "texto": "Navždy bude v dějích vzdělanosti"
  },
  {
   "texto": "jmenována s odporem a hrůzou"
  },
  {
   "texto": "tato skvrna člověčenstva:"
  },
  {
   "texto": "zvěrokupec Němčík Hagenbeck."
  },
  {
   "texto": "Úskočný ten zlosyn zajal krále,"
  },
  {
   "texto": "jeho vzácné komonstvo též zajal,"
  },
  {
   "texto": "uvěznil je do velikých klecí"
  },
  {
   "texto": "k divotvárné zvěři rozličné,"
  },
  {
   "texto": "k marabuům, želvám, gaviálům,"
  },
  {
   "texto": "k antilopám, papouškům a boám,"
  },
  {
   "texto": "které schytal po indických lesích"
  },
  {
   "texto": "do zahrady zoologičné."
  },
  {
   "texto": "Tak ach, velký opů reformátor"
  },
  {
   "texto": "s ministerstvem svojím odpovědným"
  },
  {
   "texto": "vecpán mezi makaky a vuvu,"
  },
  {
   "texto": "v nevzdělaných opic posadu;"
  },
  {
   "texto": "tak ach, fíky shnilé pojídaje,"
  },
  {
   "texto": "zakoušeje šlehy pádných důtek,"
  },
  {
   "texto": "ušlechtilý výkvět opí říše"
  },
  {
   "texto": "k osvícenému plul Západu."
  },
  {
   "texto": "Před Hamburkem loď se zakotvila"
  },
  {
   "texto": "a král s komonstvem vystoupil na břeh"
  },
  {
   "texto": "Evropy, jež kolébkou i hrobem"
  },
  {
   "texto": "stala se jich velkolepým snům:"
  },
  {
   "texto": "prodáni jsou za jidášský peníz"
  },
  {
   "texto": "zahradám a sbírkám živočišným,"
  },
  {
   "texto": "zvěřincům a milovníkům opů,"
  },
  {
   "texto": "sprostým kejklířům a šumařům."
  },
  {
   "texto": "Takový byl konec přežalostný"
  },
  {
   "texto": "vznešeného podniku, jenž mohl"
  },
  {
   "texto": "osvěty říš jasnou rozmnožiti"
  },
  {
   "texto": "o tisíce zdárných občanů,"
  },
  {
   "texto": "kteří věru dovedněj by nesli"
  },
  {
   "texto": "pantalony, frak a rukavičky,"
  },
  {
   "texto": "nežli pachtící se nejnověji"
  },
  {
   "texto": "po vzdělání národ Japanů."
  },
  {
   "texto": "Udušen je na věčné snad časy"
  },
  {
   "texto": "plápol osvěty, jenž veleslibně"
  },
  {
   "texto": "Hanumana rukou geniální"
  },
  {
   "texto": "v indském pralese byl roznícen,"
  },
  {
   "texto": "opět asi po lianách tamo"
  },
  {
   "texto": "v čiré nahotě rod opů rejdí,"
  },
  {
   "texto": "manga jí a srká ptačí vejce,"
  },
  {
   "texto": "zapomněv, že byl kdys osvícen."
  },
  {
   "texto": "X"
  },
  {
   "texto": "Uslyšel jsem zvuky divné,"
  },
  {
   "texto": "vystrčil jsem oknem hlavu:"
  },
  {
   "texto": "pestrá dvojice tam září"
  },
  {
   "texto": "v kole smějících se davů;"
  },
  {
   "texto": "nad píšťalou dud se kloní"
  },
  {
   "texto": "snědolící jihu syn,"
  },
  {
   "texto": "děva černooká zvoní"
  },
  {
   "texto": "na strakatý tamburin."
  },
  {
   "texto": "Pištec oděn modrým pláštěm,"
  },
  {
   "texto": "na klobouku rudé stužky;"
  },
  {
   "texto": "barvou žhavých květů plane"
  },
  {
   "texto": "malebný šat jeho družky,"
  },
  {
   "texto": "její oko hárá, nyje,"
  },
  {
   "texto": "loudí ve svůj temný jas,"
  },
  {
   "texto": "luzné hvězdy Italie"
  },
  {
   "texto": "blýskají z těch černých řas."
  },
  {
   "texto": "Ale viz! Op sivý shora"
  },
  {
   "texto": "na mláď bujnou zuby cení,"
  },
  {
   "texto": "sedě švarné dceři jihu"
  },
  {
   "texto": "na okrouhlém na rameni."
  },
  {
   "texto": "Na schouleném jeho těle"
  },
  {
   "texto": "rdí se premovaný frak,"
  },
  {
   "texto": "tajemně zpod čapky skvělé"
  },
  {
   "texto": "mrká vážný, dumný zrak."
  },
  {
   "texto": "Divně upírá se na mne"
  },
  {
   "texto": "pohled opa zádumčivý,"
  },
  {
   "texto": "do hlubin mé duše vniká"
  },
  {
   "texto": "výraz jeho bolně tklivý - -"
  },
  {
   "texto": "Poznávám tě, Hanumane,"
  },
  {
   "texto": "ponížení tvoje zřím"
  },
  {
   "texto": "a té slze, která kane"
  },
  {
   "texto": "z oka tvého, rozumím."
  },
  {
   "texto": "Ty, jenžs osvícenou myslí"
  },
  {
   "texto": "dbával salonního vkusu"
  },
  {
   "texto": "a své opy pilně brousil"
  },
  {
   "texto": "na francouzském jemném brusu,"
  },
  {
   "texto": "musíš vhodně doplňovat"
  },
  {
   "texto": "fantastických barev žár,"
  },
  {
   "texto": "jímžto po vzdělaném světě"
  },
  {
   "texto": "straší divošský ten pár."
  },
  {
   "texto": "Chápu bol tvůj, Hanumane!"
  },
  {
   "texto": "Ale poslyš, co ti pravím:"
  },
  {
   "texto": "Přijdou časy, o nichž sníme"
  },
  {
   "texto": "se zápalem nedočkavým,"
  },
  {
   "texto": "které v širém světě shlédnou"
  },
  {
   "texto": "jeden kroj a jeden zvyk"
  },
  {
   "texto": "a lid jeden s řečí jednou,"
  },
  {
   "texto": "s krásnou řečí volapük."
  },
  {
   "texto": "Všichni budou jedno myslit,"
  },
  {
   "texto": "jedno cítit, jedno robit,"
  },
  {
   "texto": "uniformou vzdělanosti"
  },
  {
   "texto": "jedinou své duchy zdobit;"
  },
  {
   "texto": "pak i rod tvůj, Hanumane,"
  },
  {
   "texto": "uzrá pro všelidství ráj"
  },
  {
   "texto": "a snad pravdou též se stane"
  },
  {
   "texto": "moje pošetilá báj."
  }
 ]
}