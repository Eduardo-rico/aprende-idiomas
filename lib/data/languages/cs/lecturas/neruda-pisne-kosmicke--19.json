 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "19"
  },
  {
   "texto": "Oblaky Země jsou synové tkliví,"
  },
  {
   "texto": "matičku Zemi si krví svou živí,"
  },
  {
   "texto": "slzami smývají starobné vrásky,"
  },
  {
   "texto": "mladí jí líce a svěží jí vlásky,"
  },
  {
   "texto": "ve světů závratně vířivém honu"
  },
  {
   "texto": "od věků přes věky do časů skonu"
  },
  {
   "texto": "nesou si matku jak v bavlnce měkce."
  },
  {
   "texto": "Oblaky, oblaky, labutí křídla,"
  },
  {
   "texto": "šedivé hádanky, mlhová vřídla,"
  },
  {
   "texto": "jiter a večerů zlacené znaky,"
  },
  {
   "texto": "růžové kolébky, rakevní mraky,"
  },
  {
   "texto": "nesete praotců poslední vzdechy,"
  },
  {
   "texto": "nesete potomkům první jich dechy -"
  },
  {
   "texto": "zdravím vás, zašlosti, přišlosti lidská!"
  },
  {
   "texto": "(Mluvíval člověk:)"
  },
  {
   "texto": "Čím člověk já ve světů kruhu jsem?"
  },
  {
   "texto": "Mně skromnost má jazyk víže, -"
  },
  {
   "texto": "však pohleďte někam ke dvoru,"
  },
  {
   "texto": "hned znáte, kdo sluha, kdo kníže."
  },
  {
   "texto": "Já Slunci a Siriu říkám „ty“,"
  },
  {
   "texto": "a ony? - Vzdor skvělé záři"
  },
  {
   "texto": "vždy pokorně stojí opodál"
  },
  {
   "texto": "se služebným úsměvem v tváři."
  },
  {
   "texto": "(A mluví člověk:)"
  },
  {
   "texto": "Jak lvové bijem o mříže,"
  },
  {
   "texto": "jak lvové v kleci jatí,"
  },
  {
   "texto": "my bychom vzhůru k nebesům,"
  },
  {
   "texto": "a jsme zde Zemí spjatí."
  },
  {
   "texto": "Nám zdá se, z hvězd že vane hlas:"
  },
  {
   "texto": "„Nuž pojďte, páni, blíže,"
  },
  {
   "texto": "jen trochu blíže, hrdobci,"
  },
  {
   "texto": "jimž hrouda nohy víže!“"
  },
  {
   "texto": "My přijdem! Odpusť, matičko,"
  },
  {
   "texto": "již jsi nám, Země, malá,"
  },
  {
   "texto": "my blesk k myšlénkám spřaháme"
  },
  {
   "texto": "a noha parou cválá."
  },
  {
   "texto": "My přijdem! Duch náš roste v výš"
  },
  {
   "texto": "a tepny touhou bijí,"
  },
  {
   "texto": "zimniční touhou po světech"
  },
  {
   "texto": "div srdce nerozbijí!"
  },
  {
   "texto": "My přijdem blíž, my přijdem blíž,"
  },
  {
   "texto": "my světů dožijeme,"
  },
  {
   "texto": "my bijem o mříž, ducha lvi,"
  },
  {
   "texto": "a my ji rozbijeme!"
  },
  {
   "texto": "Seděly žáby v kaluži,"
  },
  {
   "texto": "hleděly vzhůru k nebi,"
  },
  {
   "texto": "starý jim žabák učený"
  },
  {
   "texto": "odvíral tvrdé lebi."
  },
  {
   "texto": "Vysvětloval jim oblohu,"
  },
  {
   "texto": "líčil ty světlé drtky,"
  },
  {
   "texto": "mluvil o pánech hvězdářích"
  },
  {
   "texto": "zove je „Světa krtky“."
  },
  {
   "texto": "Pravil, že jejich hvězdný zkum"
  },
  {
   "texto": "zvláštní je mírou veden,"
  },
  {
   "texto": "dvacet že milionů mil"
  },
  {
   "texto": "teprv jim loket jeden."
  },
  {
   "texto": "Tedy že, řekněm pro příklad"
  },
  {
   "texto": "- věříme-li v ty krtky -,"
  },
  {
   "texto": "k Neptunu třicet loket je,"
  },
  {
   "texto": "k Venuši jen tři čtvrtky."
  },
  {
   "texto": "Rozmluvil se pak o Slunci"
  },
  {
   "texto": "- žáby jsou divem němy -,"
  },
  {
   "texto": "ze Slunce že by nastrouhal"
  },
  {
   "texto": "na tři sta tisíc Zemí."
  },
  {
   "texto": "Slunce že velmi slouží nám,"
  },
  {
   "texto": "paprskovými klíny"
  },
  {
   "texto": "štípajíc věčnost na rok a"
  },
  {
   "texto": "směnkové na termíny."
  },
  {
   "texto": "O kometách že těžká řeč,"
  },
  {
   "texto": "rozhodnout že to nechce,"
  },
  {
   "texto": "míní však, že by nemělo"
  },
  {
   "texto": "soudit se příliš lehce."
  },
  {
   "texto": "Nejsou snad všecky nešťastny,"
  },
  {
   "texto": "nejsou snad zhoubny všecky,"
  },
  {
   "texto": "o jedné ale vypráví"
  },
  {
   "texto": "sám rytíř Luběněcki:"
  },
  {
   "texto": "sotva se její paprsky"
  },
  {
   "texto": "odněkud k nám sem vdraly,"
  },
  {
   "texto": "vskutku se v glinské hospodě"
  },
  {
   "texto": "hanebně ševci sprali."
  },
  {
   "texto": "O hvězdách potom podotknul,"
  },
  {
   "texto": "po nebi co jich všude,"
  },
  {
   "texto": "skoro že samá slunce jsou,"
  },
  {
   "texto": "zelené, modré, rudé."
  },
  {
   "texto": "Vezmem-li pak pod spektroskop"
  },
  {
   "texto": "paprslek jejich světla,"
  },
  {
   "texto": "že v něm naleznem kovy tyž,"
  },
  {
   "texto": "z nichž se i Země spletla."
  },
  {
   "texto": "Umlknul. Kolem horlivě"
  },
  {
   "texto": "šuškají posluchači."
  },
  {
   "texto": "Žabák se ptá, zdaž o světech"
  },
  {
   "texto": "ještě cos zvědít ráčí."
  },
  {
   "texto": "„Jen bychom rády věděly,“"
  },
  {
   "texto": "vrch hlavy poulí zraky,"
  },
  {
   "texto": "„jsou-li tam tvoři jako my,"
  },
  {
   "texto": "jsou-li tam žáby taky!“"
  }
 ]
}