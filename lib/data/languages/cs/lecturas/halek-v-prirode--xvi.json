 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XVI."
  },
  {
   "texto": "Jest doba poupátek a růží,"
  },
  {
   "texto": "a rosy, doba slavíků,"
  },
  {
   "texto": "tu každé kvítko má svou vůni"
  },
  {
   "texto": "a ptáček na sta jazyků."
  },
  {
   "texto": "Jest doba povzletu a plesu"
  },
  {
   "texto": "a hraní, doba zásnubí,"
  },
  {
   "texto": "květ každý nejkrásnějším šatem,"
  },
  {
   "texto": "a pták se písní pochlubí."
  },
  {
   "texto": "Jest doba pohádky a báje"
  },
  {
   "texto": "a divů, doba zázraků,"
  },
  {
   "texto": "zem dýchá květem jen a písní"
  },
  {
   "texto": "a úsměv prší s oblaků."
  },
  {
   "texto": "A doba pravdy přec a skutku:"
  },
  {
   "texto": "květ v slovu stojí odvěkém,"
  },
  {
   "texto": "pták bez klamu své srdce zjeví,"
  },
  {
   "texto": "a člověk zas je člověkem."
  },
  {
   "texto": "Ó, vítej, modrá obloho"
  },
  {
   "texto": "a zlaté světla zdroje;"
  },
  {
   "texto": "z čeho se umím radovat,"
  },
  {
   "texto": "to po právu jest moje."
  },
  {
   "texto": "A má jest háje tklivá šeř,"
  },
  {
   "texto": "kdy ušlým dechům ustlá,"
  },
  {
   "texto": "má zřídla jsou, můj jejich ples,"
  },
  {
   "texto": "kdy v souzvuk řeky zhustlá."
  },
  {
   "texto": "Můj hor je modrotkaný pás,"
  },
  {
   "texto": "kdy jako báj se táhne,"
  },
  {
   "texto": "můj je ten lid, má jeho slast,"
  },
  {
   "texto": "kdy ve své srdce sáhne."
  },
  {
   "texto": "A širý kraj a obzor ten,"
  },
  {
   "texto": "kdy v barvách svých se leskne —"
  },
  {
   "texto": "sviť jen, ty zlaté sluníčko,"
  },
  {
   "texto": "a mně se nezasteskne."
  },
  {
   "texto": "Tvá ústa sterou písní šumí,"
  },
  {
   "texto": "jsou mluvou lásky od věků,"
  },
  {
   "texto": "jež nejkrásněj zní člověku —"
  },
  {
   "texto": "a přec ti člověk nerozumí."
  },
  {
   "texto": "Na rtech tvých sterý úsměv hrává,"
  },
  {
   "texto": "kam hledneš, jaro vyskočí,"
  },
  {
   "texto": "kam dýchneš, srdce poskočí —"
  },
  {
   "texto": "a přec tě člověk nepoznává."
  },
  {
   "texto": "V tvých ňadrech zlatá zřídla plují,"
  },
  {
   "texto": "jež matku písní napájí,"
  },
  {
   "texto": "kdy v dítku svém sní o ráji —"
  },
  {
   "texto": "a přec tě lidé nemilují."
  },
  {
   "texto": "Ó, těžko víru tomu soudit:"
  },
  {
   "texto": "po věků dlouhém provodu,"
  },
  {
   "texto": "mít za vůdkyni přírodu,"
  },
  {
   "texto": "být člověkem — a přec tak bloudit!"
  },
  {
   "texto": "Vy světel zřídla hvězdnatá,"
  },
  {
   "texto": "když z hloubi své tak hledím k vám,"
  },
  {
   "texto": "má duše jest jak podťata"
  },
  {
   "texto": "a přec na mysli okřívám."
  },
  {
   "texto": "Neb vy jste věčnost, spřízněny"
  },
  {
   "texto": "tím klidně krásným mihotem,"
  },
  {
   "texto": "bez sporu, stálé, blaženy"
  },
  {
   "texto": "i blažící svým životem."
  },
  {
   "texto": "A já jsem bytost, schvácená"
  },
  {
   "texto": "na délku několika jar,"
  },
  {
   "texto": "tu v žal, tu v slast potácená"
  },
  {
   "texto": "jen bublina, letící v zmar."
  },
  {
   "texto": "A jsem si sotva pohádkou,"
  },
  {
   "texto": "ni sobě nerozluštěný,"
  },
  {
   "texto": "dech činy mé, i s památkou"
  },
  {
   "texto": "do věkův bouří puštěný."
  },
  {
   "texto": "A přec mi jest, že duši mé"
  },
  {
   "texto": "tak příbuzný jste, nejsladší:"
  },
  {
   "texto": "či sestry mé, či hvězdy mé —"
  },
  {
   "texto": "však o vás že jsem bohatší."
  }
 ]
}