 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "IV."
  },
  {
   "texto": "Nic neskojí tak mysl osiřelou,"
  },
  {
   "texto": "jak velduchů nesvadlé výkvěty,"
  },
  {
   "texto": "kdy zvou nás v říše krás u výlety"
  },
  {
   "texto": "a věčnou mladost před duši nám stelou."
  },
  {
   "texto": "Však zajít v hor si osamělou skrejši,"
  },
  {
   "texto": "být u pramene črtám přírody,"
  },
  {
   "texto": "jak rostou v díla věčné lahody —"
  },
  {
   "texto": "to nad slzy nám duši ukonejší."
  },
  {
   "texto": "Tam v tichu dlít a nevnímat ni hlásku,"
  },
  {
   "texto": "ni měkkých ňader k dechu zvednutí,"
  },
  {
   "texto": "ni lístku třepotného šeptnutí,"
  },
  {
   "texto": "jen s myšlénkami v královském být svazku —"
  },
  {
   "texto": "Tu zdá se mi, že vše to velké čítám,"
  },
  {
   "texto": "co z ducha bání v básně prýštělo,"
  },
  {
   "texto": "ba jakby se jim odtud nechtělo,"
  },
  {
   "texto": "já s velduchy všech věků se tu vítám."
  },
  {
   "texto": "U Dodony stál svatý dub"
  },
  {
   "texto": "a mocná slova šeptal:"
  },
  {
   "texto": "ba věřte, vědí lesy víc,"
  },
  {
   "texto": "než se kdy který mudrc zeptal."
  },
  {
   "texto": "V jich šumosnivé samotě"
  },
  {
   "texto": "zpěv dětská trávil léta,"
  },
  {
   "texto": "v nich bohové se zrodili"
  },
  {
   "texto": "a všecka náboženství světa."
  },
  {
   "texto": "A na jich větvích dosavad"
  },
  {
   "texto": "je rozvěšeno písní,"
  },
  {
   "texto": "že celý národ poetův"
  },
  {
   "texto": "je sotva kdy u verše vysní."
  },
  {
   "texto": "A v jejich šeru dosavad"
  },
  {
   "texto": "je tolik náboženství,"
  },
  {
   "texto": "že celé lidstvo může vždy"
  },
  {
   "texto": "v nich obnovit své člověčenství."
  },
  {
   "texto": "Nechť zmudřelí se hádají"
  },
  {
   "texto": "o písmeny a o zákony:"
  },
  {
   "texto": "mně polní kvítko bylo vždy"
  },
  {
   "texto": "nad krále i nad Salomony."
  },
  {
   "texto": "Nechť změří úzkým ňadrem si"
  },
  {
   "texto": "výš odměny i pekla hloubi:"
  },
  {
   "texto": "mně ptáče vzdor jich výměru"
  },
  {
   "texto": "vždy z plných prs zazpívá v loubí."
  },
  {
   "texto": "Nechť barvou, zlatem plýtvají,"
  },
  {
   "texto": "by zhyzdili šat nebi jasný:"
  },
  {
   "texto": "na hvězdy pohled jediný"
  },
  {
   "texto": "mně nad všecka jich nebe krásný."
  },
  {
   "texto": "A nechť i plic namáhají,"
  },
  {
   "texto": "by prázno opili slov kvasem:"
  },
  {
   "texto": "mně dítka žvavá výmluvnost"
  },
  {
   "texto": "všech hlasů přírody jest hlasem."
  },
  {
   "texto": "Zašum mi v ochlad, jaré doubí,"
  },
  {
   "texto": "a půdo měkni, mechem poseta,"
  },
  {
   "texto": "co pták, to notuj z ňader hloubi —"
  },
  {
   "texto": "kdo vchází k vám, jest každý poeta."
  },
  {
   "texto": "Myšlénky jako jiskry skáčí"
  },
  {
   "texto": "a duše velikosti do kořán,"
  },
  {
   "texto": "přede mnou krás, div srdce stačí,"
  },
  {
   "texto": "svět starý za mnou mládím obetkán."
  },
  {
   "texto": "A kvítek jako víla v snění,"
  },
  {
   "texto": "tajemnou věštkou každá šedá snět,"
  },
  {
   "texto": "a laňky vzdušné, bez prodlení —"
  },
  {
   "texto": "jak velká píseň celý kolem svět."
  },
  {
   "texto": "A sestersky mne větev hledá,"
  },
  {
   "texto": "má hlava jako věnci poseta,"
  },
  {
   "texto": "mé oko září, prs se zvedá:"
  },
  {
   "texto": "kdo vchází k vám — jest každý poeta."
  }
 ]
}