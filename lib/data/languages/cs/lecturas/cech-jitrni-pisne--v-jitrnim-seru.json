{
 "id": "cech-jitrni-pisne--v-jitrnim-seru",
 "titulo": "V jitřním šeru · Kouzelná číše",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Jit%C5%99n%C3%AD_p%C3%ADsn%C4%9B/V_jit%C5%99n%C3%ADm_%C5%A1eru",
 "fuente": "cs.wikisource.org, «Jitřní písně»",
