 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXV."
  },
  {
   "texto": "Nic tak mně není proti mysli,"
  },
  {
   "texto": "jak v rýmovačkách planý sten,"
  },
  {
   "texto": "kde každý fušař vydává již"
  },
  {
   "texto": "o vlastní nouzi bulletin."
  },
  {
   "texto": "Kde každý mluvka nasbírá si"
  },
  {
   "texto": "padánčata svých pacitů,"
  },
  {
   "texto": "je na trh veze za ovoce"
  },
  {
   "texto": "a nabízí je k odbytu."
  },
  {
   "texto": "Kde každý pištec nafoukne si"
  },
  {
   "texto": "své neduživé moldánky,"
  },
  {
   "texto": "a na ucha a ducha trýzeň"
  },
  {
   "texto": "má s dlouhou chvílí líbánky."
  },
  {
   "texto": "Na mou tě! Bych byl pánem trestů,"
  },
  {
   "texto": "ty odsoudil bych jediné"
  },
  {
   "texto": "hned vedle krále Herodesa,"
  },
  {
   "texto": "jenž vraždil dítky nevinné."
  },
  {
   "texto": "Hle, na sta písní z lesů letí"
  },
  {
   "texto": "a na sta letí do lesa,"
  },
  {
   "texto": "a každá píseň jeden ptáček,"
  },
  {
   "texto": "a v každém zem i nebesa."
  },
  {
   "texto": "A každý ptáček boháč velký,"
  },
  {
   "texto": "car nejmocnější, ve zbrani,"
  },
  {
   "texto": "jen třeba mu, by v srdce sáhnul,"
  },
  {
   "texto": "a srdce všech si podmaní."
  },
  {
   "texto": "A každý ptáček mistr velký,"
  },
  {
   "texto": "rek, kouzelník v svém nástroji,"
  },
  {
   "texto": "jen třeba mu, by slovo vyřknul,"
  },
  {
   "texto": "a nepřátele odzbrojí."
  },
  {
   "texto": "Tu máte obraz srdce mého:"
  },
  {
   "texto": "sta písní v jeho objetí,"
  },
  {
   "texto": "a sotva z něho jedna prchne,"
  },
  {
   "texto": "již na sta jiných přiletí."
  },
  {
   "texto": "Jen těsněj, přiviňte se blíž,"
  },
  {
   "texto": "vy snové mladých procitnutí,"
  },
  {
   "texto": "vy krásné touhy v letnou říš —"
  },
  {
   "texto": "vás nepustím já z obejmutí."
  },
  {
   "texto": "U srdce krbu hostinně"
  },
  {
   "texto": "vám měkce prostru, milé děti,"
  },
  {
   "texto": "a v teple budem, v rodině"
  },
  {
   "texto": "tak od srdce zas rozprávěti."
  },
  {
   "texto": "Tam venku jako zločince"
  },
  {
   "texto": "vás na soud vedou v pusté kázni,"
  },
  {
   "texto": "a jak byste šly z blázince,"
  },
  {
   "texto": "k vám hledí namudřelí blázni."
  },
  {
   "texto": "Jich prázná, nicochlubná líc,"
  },
  {
   "texto": "ta duše staroba a chladno,"
  },
  {
   "texto": "jde zima z nich jak z popelnic —"
  },
  {
   "texto": "och, jak by vám tam bylo radno!"
  },
  {
   "texto": "Mám na vás úzkostlivý střeh;"
  },
  {
   "texto": "všem tak jste záhy odumřely,"
  },
  {
   "texto": "já byl bych nejbídnější všech,"
  },
  {
   "texto": "vás o den přežit, osamělý."
  },
  {
   "texto": "Pojď, myšlenko, můj lidský květe,"
  },
  {
   "texto": "o příbuzných mne došla věst,"
  },
  {
   "texto": "neb co tu polní krásy zve tě,"
  },
  {
   "texto": "v myšlenkách matka země jest."
  },
  {
   "texto": "A co tu v modrém vzduchu zvoní,"
  },
  {
   "texto": "těch ptáků zpěvem tkaný let,"
  },
  {
   "texto": "co z lesů šumí, dechem voní —"
  },
  {
   "texto": "toť příbuzných, hle, celý svět."
  },
  {
   "texto": "A jest jich víc. V dne uzpomněnce,"
  },
  {
   "texto": "kdy svá noc světla odmyká,"
  },
  {
   "texto": "to myšlenka jest na myšlence,"
  },
  {
   "texto": "jež hlavu nebes proniká."
  },
  {
   "texto": "A jest jich víc. Ty síly svaté,"
  },
  {
   "texto": "z nichž pne se vzduch i země květ"
  },
  {
   "texto": "a v modru slunce, hvězdy zlaté —"
  },
  {
   "texto": "ó pojď se s nimi srozumět."
  },
  {
   "texto": "Ba mnohem víc. Svět, veškerenstvo,"
  },
  {
   "texto": "toť myšlenka jen jediná —"
  },
  {
   "texto": "hle, jaké máš to příbuzenstvo,"
  },
  {
   "texto": "hle, jaká jsme my rodina!"
  }
 ]
}