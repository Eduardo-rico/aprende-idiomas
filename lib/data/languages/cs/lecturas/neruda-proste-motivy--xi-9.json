 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XI"
  },
  {
   "texto": "(Vzpomínka na Hálka)"
  },
  {
   "texto": "Teprvé srpen. S oblohy"
  },
  {
   "texto": "záře a teplo jen srší,"
  },
  {
   "texto": "a přece již s agátu před domem"
  },
  {
   "texto": "vše listí jak v podzimi prší."
  },
  {
   "texto": "Sotvaže větérek zavěje"
  },
  {
   "texto": "a sotvaže větev se skloní,"
  },
  {
   "texto": "již ku zemi sežloutlé listí to"
  },
  {
   "texto": "jak zlacený deštík se roní."
  },
  {
   "texto": "Zamyšlen dívám se oknem ven"
  },
  {
   "texto": "a chvěju se, podoben věchu -:"
  },
  {
   "texto": "musí to přece být pěkné jen,"
  },
  {
   "texto": "když člověku prchnou dny poslední"
  },
  {
   "texto": "tak v plničké záři, tak v spěchu!"
  },
  {
   "texto": "Náš Boubín má šedivou čepičku"
  },
  {
   "texto": "a zvolna si z dýmky kouří,"
  },
  {
   "texto": "on pánem teď, hledí si do kraje"
  },
  {
   "texto": "a lenivě očima mhouří."
  },
  {
   "texto": "Vše vidí: jak jeho že ženuška"
  },
  {
   "texto": "si lesní svůj vrkoč plete,"
  },
  {
   "texto": "jak větrným, měkkounkým chvoštětem"
  },
  {
   "texto": "sníh skalního s úbočí mete."
  },
  {
   "texto": "A vidí, jak kolkolem po řekách"
  },
  {
   "texto": "ti trpaslí synci malí"
  },
  {
   "texto": "si po vodě dolů a nahoru"
  },
  {
   "texto": "své mlhové balvánky valí."
  },
  {
   "texto": "Jak šedivé ze skalní kotliny"
  },
  {
   "texto": "výš výše se kotouč paří,"
  },
  {
   "texto": "kde trpaslí dcerušky pro lidi"
  },
  {
   "texto": "z mlh dešťovou polívku vaří."
  },
  {
   "texto": "A jiné z nich plátna zas utkaly"
  },
  {
   "texto": "a věší je za strom všady,"
  },
  {
   "texto": "že vandrovník náhle se zaráží"
  },
  {
   "texto": "a neví již, kamže a kady."
  },
  {
   "texto": "Zas Boubín se ku řece zahleděl -"
  },
  {
   "texto": "tam věru už stavba celá,"
  },
  {
   "texto": "a od břehu k břehu se z mlhy most"
  },
  {
   "texto": "jak z mramoru do dálky bělá."
  },
  {
   "texto": "A na břehu stojí lid spěchavý"
  },
  {
   "texto": "a radí se zdiven spolu,"
  },
  {
   "texto": "a který z nich mamidlu uvěřil,"
  },
  {
   "texto": "hrš! sklouzl a sletěl až dolů!"
  },
  {
   "texto": "A Boubín se hromově rozchechtal:"
  },
  {
   "texto": "„Ne, mámo, - ti kluci tvoji -"
  },
  {
   "texto": "ej mají ty děti teď nápady,"
  },
  {
   "texto": "že člověku rozum až stojí!"
  },
  {
   "texto": "No mládí je mládí a stvořeno,"
  },
  {
   "texto": "jak myslím, jen ku radosti -"
  },
  {
   "texto": "hoď, mámo, jim mlhy té ještě kus,"
  },
  {
   "texto": "vždyť máme jí, chvalbohu, dosti!“"
  }
 ]
}