 "modo": "texto",
 "parrafos": [
  {
   "texto": "XCIII."
  },
  {
   "texto": "Tu vítr nadmul sobě plíce,"
  },
  {
   "texto": "tvář na sebe vzal vědeckou,"
  },
  {
   "texto": "sňal píšťaly a všecky trouby —"
  },
  {
   "texto": "dnes zahrajou nám tureckou."
  },
  {
   "texto": "Blesk na kůň sed’ a za ním letí,"
  },
  {
   "texto": "vzad šlehem dává znamení,"
  },
  {
   "texto": "hrom rachotí na velký buben,"
  },
  {
   "texto": "na nebes černé sklepení."
  },
  {
   "texto": "Prach již se točí na opatku,"
  },
  {
   "texto": "teď vítr počal větve brát,"
  },
  {
   "texto": "a kde se strom mu staví v cestu,"
  },
  {
   "texto": "hned natáh’ se jak kolohnát."
  },
  {
   "texto": "Věž v úctě naklonila čelo,"
  },
  {
   "texto": "dům střechu smek’ jak čepici,"
  },
  {
   "texto": "a stará chatrč poskakuje,"
  },
  {
   "texto": "jako by zmladla v děvici."
  },
  {
   "texto": "A hudba hřímá přes vsi, města,"
  },
  {
   "texto": "přes vody, s kopců, do letu —"
  },
  {
   "texto": "a slavný úřad v udivení,"
  },
  {
   "texto": "že nedal k hudbě paletu."
  },
  {
   "texto": "Větřík, jak když panna dýchne,"
  },
  {
   "texto": "neobjímá, dotkne se,"
  },
  {
   "texto": "a já se mu vrhnu v náruč,"
  },
  {
   "texto": "ať mne kam chce zanese."
  },
  {
   "texto": "A my lítnem háje lemem,"
  },
  {
   "texto": "jenž se v rosu obléká,"
  },
  {
   "texto": "a my pijem jeho písně,"
  },
  {
   "texto": "jež nás zvou už z daleka."
  },
  {
   "texto": "A my lítnem do osení,"
  },
  {
   "texto": "jež se šeptmo rozvlní,"
  },
  {
   "texto": "a my pijem jeho vůni,"
  },
  {
   "texto": "až nám srdce naplní."
  },
  {
   "texto": "A my lítnem k růže keřům,"
  },
  {
   "texto": "když jim puknou poupata,"
  },
  {
   "texto": "a my pijem jejich lásku,"
  },
  {
   "texto": "až nám duše ohřáta."
  },
  {
   "texto": "A my lítnem pod okénko,"
  },
  {
   "texto": "kde ty dřímáš, anděli,"
  },
  {
   "texto": "a my hudem písně o tom,"
  },
  {
   "texto": "co jsme v světě viděli."
  },
  {
   "texto": "Šustilo mladé rákosí,"
  },
  {
   "texto": "volalo na mne, kývlo si,"
  },
  {
   "texto": "rádo se někdy pozeptá,"
  },
  {
   "texto": "rádo mi lecos pošeptá."
  },
  {
   "texto": "Zvláště kdy v luny potaji"
  },
  {
   "texto": "děvčátka tam se brouzdají,"
  },
  {
   "texto": "každá si něco zavzdychne —"
  },
  {
   "texto": "rákosí hned to zachytne."
  },
  {
   "texto": "Ale dnes šustí ve zmatku:"
  },
  {
   "texto": "stalo se tuhle děvčátku,"
  },
  {
   "texto": "přišlo sem, srdce znavené,"
  },
  {
   "texto": "okřálo, a je studené."
  },
  {
   "texto": "A co mně ještě s podivem:"
  },
  {
   "texto": "rákosí jest jí stelivem,"
  },
  {
   "texto": "poduška hlavě z leknínů,"
  },
  {
   "texto": "přikryvka jen tak ze stínu."
  },
  {
   "texto": "A co mně divno nejvíce,"
  },
  {
   "texto": "němé ty v smutku bělice:"
  },
  {
   "texto": "postojí, sotva uvidí —"
  },
  {
   "texto": "vše to nenašla u lidí."
  },
  {
   "texto": "A jak že bys, ty stará horo,"
  },
  {
   "texto": "mně nemladla den ode dne:"
  },
  {
   "texto": "co za noc v tobě ptáčků dřímá,"
  },
  {
   "texto": "za dne se k nebi pozvedne!"
  },
  {
   "texto": "A letí, letí jasným modrem"
  },
  {
   "texto": "až k zlatých mráčků závrati,"
  },
  {
   "texto": "a co tam najdou zlata, modra,"
  },
  {
   "texto": "s tím zas se k tobě navrátí."
  },
  {
   "texto": "A letí, letí k vodám hladkým,"
  },
  {
   "texto": "když v lesku síť se roztřesou,"
  },
  {
   "texto": "a co tam slyší políbení,"
  },
  {
   "texto": "to v písních tobě donesou."
  },
  {
   "texto": "A letí, letí krajem širým,"
  },
  {
   "texto": "kde kvítků vlídná srdce jsou,"
  },
  {
   "texto": "a co máš stesku v srdci vlastním,"
  },
  {
   "texto": "to do všech světů roznesou."
  }
 ]
}