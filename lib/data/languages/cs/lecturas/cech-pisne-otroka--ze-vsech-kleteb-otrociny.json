 "parrafos": [
  {
   "texto": "Ze všech kleteb otročiny…"
  },
  {
   "texto": "Ze všech kleteb otročiny,"
  },
  {
   "texto": "jíž nás stihl bůh,"
  },
  {
   "texto": "nejtrapnější, nejhroznější"
  },
  {
   "texto": "otrocký je duch."
  },
  {
   "texto": "Hleďme kolem na své řady,"
  },
  {
   "texto": "co tu klamu, lsti a zrady,"
  },
  {
   "texto": "co tu nízkosti se plazí,"
  },
  {
   "texto": "co tu zášti srdce mrazí,"
  },
  {
   "texto": "co tu zmijí"
  },
  {
   "texto": "před cizím se podle svíjí,"
  },
  {
   "texto": "svým pak vztekle syčí v sluch!"
  },
  {
   "texto": "Hle! tu rab, jejž za hlídače"
  },
  {
   "texto": "otrokář dal nám, —"
  },
  {
   "texto": "kterak zapírá nás rázem"
  },
  {
   "texto": "prodejný ten chám!"
  },
  {
   "texto": "Cit svůj, rozum, duši třeba"
  },
  {
   "texto": "prodává mu za kus chleba,"
  },
  {
   "texto": "číhá na kyn jeho brvy,"
  },
  {
   "texto": "by zdvih’ na nás důtky prvý,"
  },
  {
   "texto": "stokrát hůře"
  },
  {
   "texto": "proti vlastním bratrům zuře"
  },
  {
   "texto": "nežli nepřítel náš sám."
  },
  {
   "texto": "Jiným otroctví tak vniklo"
  },
  {
   "texto": "do všech žil a šlach,"
  },
  {
   "texto": "že se hrbí dobrovolně,"
  },
  {
   "texto": "by je šlapal vrah,"
  },
  {
   "texto": "že se derou chtivě k němu,"
  },
  {
   "texto": "dotknout se jen šatů lemu,"
  },
  {
   "texto": "svábit na schýlené hlavy"
  },
  {
   "texto": "pohled jeho pohrdavý,"
  },
  {
   "texto": "sypat květy"
  },
  {
   "texto": "noze, jež ty kopá skety,"
  },
  {
   "texto": "zlíbat jeho stopy prach."
  },
  {
   "texto": "Druzí zas boj mezi sebou"
  },
  {
   "texto": "vedou divoký,"
  },
  {
   "texto": "místo na zhoubce kyj berou"
  },
  {
   "texto": "soci na soky,"
  },
  {
   "texto": "raděj’ v zisk a radost vrahu"
  },
  {
   "texto": "bratr maří bratra snahu,"
  },
  {
   "texto": "sami navzájem se bijem’,"
  },
  {
   "texto": "v útrobách svých vlastních ryjem’,"
  },
  {
   "texto": "srdce jásá,"
  },
  {
   "texto": "i když cizí zloba drásá"
  },
  {
   "texto": "padlé spoluotroky."
  },
  {
   "texto": "Což ach! stejný všech nás útisk"
  },
  {
   "texto": "nikdy k pleci plec"
  },
  {
   "texto": "nepřirazí, nezvítězí"
  },
  {
   "texto": "nikdy svatá věc"
  },
  {
   "texto": "v osobních těch vášní vření,"
  },
  {
   "texto": "kde zášť, závist chléb nám denní,"
  },
  {
   "texto": "což vzlet vyšší shody duhu"
  },
  {
   "texto": "nerozklene v našem kruhu,"
  },
  {
   "texto": "který vřavou"
  },
  {
   "texto": "věčně otřásá se dravou"
  },
  {
   "texto": "jako šelem lítých klec?!"
  },
  {
   "texto": "V bázni boží na rohoži"
  },
  {
   "texto": "šedý rab si hoví syt,"
  },
  {
   "texto": "za svůj hrnec ztuchlé rýže"
  },
  {
   "texto": "poníženě důtky líže,"
  },
  {
   "texto": "jimiž tisíckrát byl zbit."
  },
  {
   "texto": "Za posměchu tretu z plechu"
  },
  {
   "texto": "na hruď zavěsil mu pán,"
  },
  {
   "texto": "a náš dědouš v dětské pýše"
  },
  {
   "texto": "nad námi pne hlavu výše,"
  },
  {
   "texto": "že je rabům za vzor dán."
  },
  {
   "texto": "„Dvé jen v žití hvězd mi svítí:"
  },
  {
   "texto": "pána mého čest a zisk;"
  },
  {
   "texto": "za to vizte! na otroka"
  },
  {
   "texto": "z přejasného Jeho oka"
  },
  {
   "texto": "paprsk přízně vzácné trysk’."
  },
  {
   "texto": "Jak se tělo blahem chvělo,"
  },
  {
   "texto": "slzou štěstí vlhnul zrak,"
  },
  {
   "texto": "když mi na šíj rabstvím křivou"
  },
  {
   "texto": "vlastní rukou milostivou"
  },
  {
   "texto": "zavěsil Své přízně znak!"
  },
  {
   "texto": "Díky vroucí, přehoroucí"
  },
  {
   "texto": "hrudi slastně zavlály,"
  },
  {
   "texto": "když jsem pochýlit směl k zemi"
  },
  {
   "texto": "čelo v Jeho šatů lemy,"
  },
  {
   "texto": "zulíbat Mu sandály."
  },
  {
   "texto": "Vůle boží za podnoží"
  },
  {
   "texto": "určila nás Jeho pat;"
  },
  {
   "texto": "pějme hymny k Jeho chvále,"
  },
  {
   "texto": "a kdo neplazí se stále"
  },
  {
   "texto": "v prachu před Ním, budiž klat!"
  },
  {
   "texto": "Kéž mé tělo kdysi stlelo"
  },
  {
   "texto": "pod stopami Jeho drah,"
  },
  {
   "texto": "pode prahem k Jeho kobě,"
  },
  {
   "texto": "aby šlapal ještě v hrobě"
  },
  {
   "texto": "raba Svého prach!“"
  }
 ]
