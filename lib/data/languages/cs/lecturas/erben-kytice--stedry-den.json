{
 "id": "erben-kytice--stedry-den",
 "titulo": "Štědrý den",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/%C5%A0t%C4%9Bdr%C3%BD_den",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos).",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 5
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Tma jako v hrobě, mráz v okna duje,"
  },
  {
   "texto": "v světnici teplo u kamen;"
  },
  {
   "texto": "v krbu se svítí, stará podřimuje,"
  },
  {
   "texto": "děvčata předou měkký len."
  },
  {
   "texto": "„Toč se a vrč, můj kolovrátku,"
  },
  {
   "texto": "ejhle adventu již nakrátku"
  },
  {
   "texto": "a blízko, blizoučko Štědrý den!"
  },
  {
   "texto": "Mílotě děvčeti přísti, mílo"
  },
  {
   "texto": "za smutných zimních večerů;"
  },
  {
   "texto": "neb nebude darmo její dílo,"
  },
  {
   "texto": "tu pevnou chová důvěru."
  },
  {
   "texto": "I přijde mládenec za pilnou pannou,"
  },
  {
   "texto": "řekne: Pojď za mne, dívko má,"
  },
  {
   "texto": "budiž ty mi ženkou milovanou,"
  },
  {
   "texto": "věrným ti mužem budu já."
  },
  {
   "texto": "Já tobě mužem, ty mně ženkou,"
  },
  {
   "texto": "dej ruku, děvče rozmilé! —"
  },
  {
   "texto": "A dívka, co předla přízi tenkou,"
  },
  {
   "texto": "svatební šije košile."
  },
  {
   "texto": "Toč se a vrč, můj kolovrátku,"
  },
  {
   "texto": "však jest adventu již nakrátku"
  },
  {
   "texto": "a přede dveřmi Štědrý den!“"
  },
  {
   "texto": "II"
  },
  {
   "texto": "Hoj, ty Štědrý večere,"
  },
  {
   "texto": "ty tajemný svátku,"
  },
  {
   "texto": "cože komu dobrého"
  },
  {
   "texto": "neseš na památku?"
  },
  {
   "texto": "Hospodáři štědrovku,"
  },
  {
   "texto": "kravám po výslužce;"
  },
  {
   "texto": "kohoutovi česneku,"
  },
  {
   "texto": "hrachu jeho družce."
  },
  {
   "texto": "Ovocnému stromoví"
  },
  {
   "texto": "od večeře kosti"
  },
  {
   "texto": "a zlatoušky na stěnu"
  },
  {
   "texto": "tomu, kdo se postí."
  },
  {
   "texto": "Hoj, já mladá dívčina,"
  },
  {
   "texto": "srdce nezadané:"
  },
  {
   "texto": "mně na mysli jiného,"
  },
  {
   "texto": "jiného cos tane."
  },
  {
   "texto": "Pod lesem, ach pod lesem,"
  },
  {
   "texto": "na tom panském stavě,"
  },
  {
   "texto": "stojí vrby stařeny,"
  },
  {
   "texto": "sníh na šedé hlavě."
  },
  {
   "texto": "Jedna vrba hrbatá"
  },
  {
   "texto": "tajně dolů kývá,"
  },
  {
   "texto": "kde se modré jezero"
  },
  {
   "texto": "pod ledem ukrývá."
  },
  {
   "texto": "Tu prý dívce v půlnoci,"
  },
  {
   "texto": "při luně pochodni,"
  },
  {
   "texto": "souzený se zjeví hoch"
  },
  {
   "texto": "ve hladině vodní."
  },
  {
   "texto": "Hoj, mne půlnoc neleká,"
  },
  {
   "texto": "ani liché vědy:"
  },
  {
   "texto": "půjdu, vezmu sekeru,"
  },
  {
   "texto": "prosekám ty ledy."
  },
  {
   "texto": "I nahlédnu v jezero"
  },
  {
   "texto": "hluboko — hluboko,"
  },
  {
   "texto": "milému se podívám"
  },
  {
   "texto": "pevně okem v oko."
  },
  {
   "texto": "III"
  },
  {
   "texto": "Marie, Hana, dvě jména milá,"
  },
  {
   "texto": "panny jak jarní růže květ:"
  },
  {
   "texto": "která by z obou milejší byla,"
  },
  {
   "texto": "nikdo nemůže rozumět."
  },
  {
   "texto": "Jestliže jedna promluví k hochu,"
  },
  {
   "texto": "do ohně by jí k vůli šel;"
  },
  {
   "texto": "pakli se druhá usměje trochu —"
  },
  {
   "texto": "na první zas by zapomněl! —"
  },
  {
   "texto": "Nastala půlnoc. Po nebi šíře"
  },
  {
   "texto": "sbor vysypal se hvězdiček"
  },
  {
   "texto": "jako ovečky okolo pastýře,"
  },
  {
   "texto": "a pastýř jasný měsíček."
  },
  {
   "texto": "Nastala půlnoc, všech nocí máti,"
  },
  {
   "texto": "půlnoc po Štědrém večeru;"
  },
  {
   "texto": "na mladém sněhu svěží stopu znáti"
  },
  {
   "texto": "ode vsi přímo k jezeru."
  },
  {
   "texto": "Ta jedna klečí, nad vodou líčko;"
  },
  {
   "texto": "ta druhá stojí podle ní:"
  },
  {
   "texto": "„Hano, Haničko, zlaté srdíčko,"
  },
  {
   "texto": "jaké tam vidíš vidění?“"
  },
  {
   "texto": "„Ach, vidím domek — ale jen v šeře —"
  },
  {
   "texto": "jako co Václav ostává —"
  },
  {
   "texto": "však již se jasní — ach, vidím dvéře,"
  },
  {
   "texto": "ve dveřích mužská postava!"
  },
  {
   "texto": "Na těle kabát zeleni temné,"
  },
  {
   "texto": "klobouk na stranu — znám jej, znám!"
  },
  {
   "texto": "Na něm ta kytka, co dostal ode mne —"
  },
  {
   "texto": "můj milý bože! Václav sám!!“"
  },
  {
   "texto": "Na nohy skočí, srdce jí bije,"
  },
  {
   "texto": "druhá přikleká vedle ní:"
  },
  {
   "texto": "„Zdař bůh, má milá, zlatá Marie,"
  },
  {
   "texto": "jaké ty vidíš vidění?“"
  },
  {
   "texto": "„Ach, vidím, vidím — je mlhy mnoho,"
  },
  {
   "texto": "všecko je mlhou zatmělé;"
  },
  {
   "texto": "červená světla blýskají z toho —"
  },
  {
   "texto": "zdá mi se býti v kostele."
  },
  {
   "texto": "Něco se černá mezi bílými —"
  },
  {
   "texto": "však mi se rozednívá již: —"
  },
  {
   "texto": "jsou to družičky, a mezi nimi"
  },
  {
   "texto": "proboha! rakev — černý kříž!“"
  },
  {
   "texto": "IV"
  },
  {
   "texto": "Vlažný větřík laškuje"
  },
  {
   "texto": "po osení mladém;"
  },
  {
   "texto": "sad i pole květovým"
  },
  {
   "texto": "přioděny vnadem;"
  },
  {
   "texto": "zazněla hudba od kostela zrána"
  },
  {
   "texto": "a za ní hejsa! kvítím osypána"
  },
  {
   "texto": "jede svatba řadem."
  },
  {
   "texto": "Švárný ženich jako květ"
  },
  {
   "texto": "v kole svatebčanů,"
  },
  {
   "texto": "kabát tmavě zelený,"
  },
  {
   "texto": "klobouk v jednu stranu:"
  },
  {
   "texto": "tak viděla jej v osudné té době,"
  },
  {
   "texto": "tak si ji nyní domů vede k sobě,"
  },
  {
   "texto": "švárnou ženku Hanu."
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Zašlo léto. Přes pole"
  },
  {
   "texto": "chladné větry vějí."
  },
  {
   "texto": "Zvoní hrana. Na marách"
  },
  {
   "texto": "tělo vynášejí:"
  },
  {
   "texto": "bílé družičky, planoucí svíce;"
  },
  {
   "texto": "pláč, bědování, trouby hlaholíce"
  },
  {
   "texto": "z hlubokosti znějí:"
  },
  {
   "texto": "Miserere mei!"
  },
  {
   "texto": "Koho věnec zelený,"
  },
  {
   "texto": "koho v rakvi kryje?"
  },
  {
   "texto": "Umřela, ach umřela"
  },
  {
   "texto": "panenská lilie!"
  },
  {
   "texto": "Vykvětla, jak by zalívána rosou,"
  },
  {
   "texto": "uvadla, jak by podsečena kosou —"
  },
  {
   "texto": "ubohá Marie!"
  },
  {
   "texto": "V"
  },
  {
   "texto": "Nastala zima, mráz v okna duje,"
  },
  {
   "texto": "v světnici teplo u kamen;"
  },
  {
   "texto": "v krbu se svítí, stará polehuje,"
  },
  {
   "texto": "děvčata zase předou len."
  },
  {
   "texto": "„Toč se a vrč, můj kolovrátku,"
  },
  {
   "texto": "však jest adventu zase nakrátku"
  },
  {
   "texto": "a nedaleko Štědrý den!"
  },
  {
   "texto": "Ach ty Štědrý večere"
  },
  {
   "texto": "noci divoplodné,"
  },
  {
   "texto": "když si na tě vzpomenu,"
  },
  {
   "texto": "k srdci mne to bodne!"
  },
  {
   "texto": "Seděly jsme také tak"
  },
  {
   "texto": "loni pohromadě:"
  },
  {
   "texto": "a než rok se obrátil,"
  },
  {
   "texto": "dvě nám chybí v řadě!"
  },
  {
   "texto": "Jedna, hlavu zavitou,"
  },
  {
   "texto": "košiličky šije;"
  },
  {
   "texto": "druhá již tři měsíce"
  },
  {
   "texto": "v černé zemi hnije,"
  },
  {
   "texto": "ubohá Marie!"
  },
  {
   "texto": "Seděly jsme také tak,"
  },
  {
   "texto": "jako dnes a včera:"
  },
  {
   "texto": "a než rok se obrátí —"
  },
  {
   "texto": "kde z nás bude která?"
  },
  {
   "texto": "Toč se a vrč, můj kolovrátku,"
  },
  {
   "texto": "všecko ve světě jen na obrátku"
  },
  {
   "texto": "a život lidský jako sen!"
  },
  {
   "texto": "Však lépe v mylné naději sníti,"
  },
  {
   "texto": "před sebou čirou temnotu,"
  },
  {
   "texto": "nežli budoucnost odhaliti,"
  },
  {
   "texto": "strašlivou poznati jistotu!“"
  }
 ]
}