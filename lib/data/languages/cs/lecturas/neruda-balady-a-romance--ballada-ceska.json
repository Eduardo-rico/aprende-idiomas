 "parrafos": [
  {
   "texto": "Žil jednou v Čechách smavý rek,"
  },
  {
   "texto": "Vám známý rytíř Paleček;"
  },
  {
   "texto": "on samý šprým a nápad byl,"
  },
  {
   "texto": "rád dobře jed’ a dobře pil,"
  },
  {
   "texto": "a lidem dobře činil."
  },
  {
   "texto": "Rád jed’ a pil, jak povídám,"
  },
  {
   "texto": "však ještě něco dodat mám:"
  },
  {
   "texto": "on též rád bloudil po Čechách –"
  },
  {
   "texto": "a pak byl vždy jak v mátohách"
  },
  {
   "texto": "a nevěděl, kde stojí."
  },
  {
   "texto": "„Nu, nu“ – kdys zazněl náhle hlas –"
  },
  {
   "texto": "„pan rytíř je už ve snách zas?“"
  },
  {
   "texto": "a Paleček jak přimražen!"
  },
  {
   "texto": "Aj před ním kolo bujných žen,"
  },
  {
   "texto": "a v prostřed Vesna sama."
  },
  {
   "texto": "„Jen neboj se, Ty’s celý muž,"
  },
  {
   "texto": "Ty se mi ze všech líbíš – nuž"
  },
  {
   "texto": "mé slovo k smělosti Tě zve,"
  },
  {
   "texto": "rci jakékoli přání své –"
  },
  {
   "texto": "však vtipně jen a hbitě!“"
  },
  {
   "texto": "Již rytíř bez všech rozpaků"
  },
  {
   "texto": "si hodil hlavou: „Tedy řku"
  },
  {
   "texto": "a prosím: až bych jednou zdech’,"
  },
  {
   "texto": "mne výročně vždy ožít nech,"
  },
  {
   "texto": "na osm dní – to s jara!"
  },
  {
   "texto": "Když svět zas jednou krásným je,"
  },
  {
   "texto": "když zem se celá rozsměje,"
  },
  {
   "texto": "pak, Vesno, milostiva buď,"
  },
  {
   "texto": "na osm dní mne jenom vzbuď!“"
  },
  {
   "texto": "A Vesna kývla: „Staň se!“"
  },
  {
   "texto": "Od časů těch, děj se co děj,"
  },
  {
   "texto": "fialek vůní budí jej,"
  },
  {
   "texto": "slavíkův ven jej volá hlas,"
  },
  {
   "texto": "pan rytíř vstává bujný zas"
  },
  {
   "texto": "a rozkročí se krajem."
  },
  {
   "texto": "Kraj český, jindy smuten, tich,"
  },
  {
   "texto": "je pojednou pak samý smích,"
  },
  {
   "texto": "a celý ten náš český svět"
  },
  {
   "texto": "je samý zpěv a samý květ –"
  },
  {
   "texto": "však krátce jen, ach krátce!"
  },
  {
   "texto": "Vždyť umluvil si rek náš s ní"
  },
  {
   "texto": "jen blažených vždy osm dní!"
  },
  {
   "texto": "Pak vrací se zas v dumnou říš,"
  },
  {
   "texto": "a Vesna dá mu medu číš –"
  },
  {
   "texto": "on opiv se zas usne."
  }
 ]
