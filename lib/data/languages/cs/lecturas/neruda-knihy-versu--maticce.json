 "parrafos": [
  {
   "texto": "Proto mně draha tak"
  },
  {
   "texto": "milá má matička,"
  },
  {
   "texto": "že je tak malička,"
  },
  {
   "texto": "že je tak chudička."
  },
  {
   "texto": "A kdyby byla snad"
  },
  {
   "texto": "chudší než oblázek,"
  },
  {
   "texto": "předc bych ji v srdci svém"
  },
  {
   "texto": "choval co obrázek."
  },
  {
   "texto": "A kdyby byla snad"
  },
  {
   "texto": "svázána v uzlíčku,"
  },
  {
   "texto": "předc bych ji miloval"
  },
  {
   "texto": "tu drahou matičku."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Ze všeho jediná"
  },
  {
   "texto": "zbyla's mně, matičko,"
  },
  {
   "texto": "vychladlé zemi jak"
  },
  {
   "texto": "podzimní sluníčko."
  },
  {
   "texto": "Podzimní sluníčko"
  },
  {
   "texto": "neslní, nepálí,"
  },
  {
   "texto": "předce se zatřesem,"
  },
  {
   "texto": "když se nám zakalí."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Dí matka: „Ty prý písničky"
  },
  {
   "texto": "tak často na mne skládáš,"
  },
  {
   "texto": "to není hezké, tím mne jen"
  },
  {
   "texto": "do lidských úst zas vkládáš.“"
  },
  {
   "texto": "Ty nevíš, drahá matičko,"
  },
  {
   "texto": "co se mým písním dívá:"
  },
  {
   "texto": "k nim nikdo nápěv neskládá"
  },
  {
   "texto": "a nikdo je nezpívá."
  },
  {
   "texto": "Písnička, při níž pláčeme,"
  },
  {
   "texto": "je jiným lidem něma,"
  },
  {
   "texto": "a kdybych složil tisíc jich —"
  },
  {
   "texto": "vždyť mluví jen k nám dvěma!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "V sobě jen a mlčky nesu,"
  },
  {
   "texto": "nechť zakusím čehokoli,"
  },
  {
   "texto": "zamlčím i matce drahé,"
  },
  {
   "texto": "co mne těší, co mne bolí."
  },
  {
   "texto": "Jak to přijde, matičko má,"
  },
  {
   "texto": "že přec všechno uhodnete —"
  },
  {
   "texto": "když mně srdce v těle plesá,"
  },
  {
   "texto": "zrak že jasně pozvednete?"
  },
  {
   "texto": "Jak to přijde, matičko má,"
  },
  {
   "texto": "že tak všechno uhodnete, —"
  },
  {
   "texto": "když mně srdce v těle pláče,"
  },
  {
   "texto": "že si v koutek zasednete?"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Má matka někdy čítává"
  },
  {
   "texto": "ve starém planetáři:"
  },
  {
   "texto": "„Brzy a náhle dokonáš!“"
  },
  {
   "texto": "s prorockou káže tváří."
  },
  {
   "texto": "A denně za mne říkává"
  },
  {
   "texto": "svůj růženec klokočí"
  },
  {
   "texto": "a hořké řinou slzy se"
  },
  {
   "texto": "z těch starých věrných očí."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Znáš, matko drahá, překrásnou tu báji"
  },
  {
   "texto": "o zlatém slunci a o matce jeho,"
  },
  {
   "texto": "jež každé noci na klíně svém sešlém"
  },
  {
   "texto": "kolíbá ve sen syna zemdleného?"
  },
  {
   "texto": "Vždyť chuďas dost a dost se naputuje,"
  },
  {
   "texto": "vždyť po dny celé světem bloudit musí,"
  },
  {
   "texto": "dost šedých chmur a hradů, mračen tmavých,"
  },
  {
   "texto": "ba skoro tolik, co zde člověk zkusí."
  },
  {
   "texto": "Co kmet si lehne a co jinoch vstane"
  },
  {
   "texto": "a s novou silou po novém plá nebi,"
  },
  {
   "texto": "o matko, matko! vždyťs jak anděl dobra —"
  },
  {
   "texto": "mám toho jak to slunko zapotřebí!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nic nemáš víc, vše dala's mně,"
  },
  {
   "texto": "co bůh v Tvé ruce skládal,"
  },
  {
   "texto": "a předce bych já nevděčník"
  },
  {
   "texto": "vždy víc a více žádal!"
  },
  {
   "texto": "Dej ještě bílé vlasy své"
  },
  {
   "texto": "na rubáš svému synu,"
  },
  {
   "texto": "by ještě v hrobě spočíval"
  },
  {
   "texto": "jako by ve Tvém klínu!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Už přišel, matičko, Tvůj zimní čas,"
  },
  {
   "texto": "Tvé ruce jsou jak stromu větve v jíní,"
  },
  {
   "texto": "jak mrazu vzdech je stříbrný kdys hlas,"
  },
  {
   "texto": "a co kdy jarého, je stuhlé nyní."
  },
  {
   "texto": "Nuž vezmi vlasy mé a utkej šat,"
  },
  {
   "texto": "snad zahřeje, co dávno uvadlo,"
  },
  {
   "texto": "snad zahřeje ta chladná prsa Tvoje; —"
  },
  {
   "texto": "na roucho to co šperk a spínadlo"
  },
  {
   "texto": "dám mladobujné teplé srdce svoje."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Neslyšel jsem Tě zazpívat,"
  },
  {
   "texto": "myslím, že už přes tři leta,"
  },
  {
   "texto": "což je i po marianských,"
  },
  {
   "texto": "což je po všem zpěvu veta?"
  },
  {
   "texto": "„Moji smyslové jsou, synu,"
  },
  {
   "texto": "dřímotou už obetkáni;"
  },
  {
   "texto": "večerní jsem odzpívala —"
  },
  {
   "texto": "a teď čekám na klekání.“"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Zakoupila's místo,"
  },
  {
   "texto": "otcova kde hlava"
  },
  {
   "texto": "na sedmé již léto"
  },
  {
   "texto": "věčný sen vyspává."
  },
  {
   "texto": "Hrob ten otcův, matčin,"
  },
  {
   "texto": "mým též hrobem bude,"
  },
  {
   "texto": "povedeme spolu"
  },
  {
   "texto": "hospodářství chudé."
  },
  {
   "texto": "Malý domek z hlíny,"
  },
  {
   "texto": "vlhké čtyry stěny,"
  },
  {
   "texto": "v něm však lásky, že jí"
  },
  {
   "texto": "v šírém světě není."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Dozpěv."
  },
  {
   "texto": "Ty's šla a v naší světničce"
  },
  {
   "texto": "teď žiju samu sobě —"
  },
  {
   "texto": "ach matko, zlatá matko má,"
  },
  {
   "texto": "jak je Ti dole v hrobě?"
  },
  {
   "texto": "Ta naše malá světnička"
  },
  {
   "texto": "se děsně, prázdně šíří,"
  },
  {
   "texto": "o její klenby tlukou se"
  },
  {
   "texto": "myšlénky netopýří."
  },
  {
   "texto": "Já sedím schoulen u lože"
  },
  {
   "texto": "se chvějícíma rtoma —"
  },
  {
   "texto": "ven musím, ven — tam do světa,"
  },
  {
   "texto": "mně je tak zima doma!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "(Psáno na asijském Burghurlu)"
  },
  {
   "texto": "Lož nemá blaha více ani hoře,"
  },
  {
   "texto": "ta krásná zem, to širé, bouřné moře?"
  },
  {
   "texto": "Mne nevábí nic dále v svět,"
  },
  {
   "texto": "mně všude je tak jedno,"
  },
  {
   "texto": "mne nevábí nic k vlasti zpět —"
  },
  {
   "texto": "tam doma je tak ledno!"
  },
  {
   "texto": "Však ne! — Když první kvítek na hrobě se třese,"
  },
  {
   "texto": "když první skřivan nad hřbitov se vznese,"
  },
  {
   "texto": "tu přece bych náhle doma býti chtěl,"
  },
  {
   "texto": "bych utrh' kvítko, zachvěl se — a šel!"
  }
 ]
