 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Byl pozdní večer — první máj —"
  },
  {
   "texto": "večerní máj — byl lásky čas."
  },
  {
   "texto": "Hrdliččin zval ku lásce hlas,"
  },
  {
   "texto": "kde borový zaváněl háj."
  },
  {
   "texto": "O lásce šeptal tichý mech;"
  },
  {
   "texto": "květoucí strom lhal lásky žel,"
  },
  {
   "texto": "svou lásku slavík růži pěl,"
  },
  {
   "texto": "růžinu jevil vonný vzdech."
  },
  {
   "texto": "Jezero hladké v křovích stinných"
  },
  {
   "texto": "zvučelo temně tajný bol,"
  },
  {
   "texto": "břeh je objímal kol a kol;"
  },
  {
   "texto": "a slunce jasná světů jiných"
  },
  {
   "texto": "bloudila blankytnými pásky,"
  },
  {
   "texto": "planoucí tam co slzy lásky."
  },
  {
   "texto": "I světy jich v oblohu skvoucí"
  },
  {
   "texto": "co ve chrám věčné lásky vzešly;"
  },
  {
   "texto": "až se — milostí k sobě vroucí"
  },
  {
   "texto": "změnivše se v jiskry hasnoucí —"
  },
  {
   "texto": "bloudící co milenci sešly."
  },
  {
   "texto": "Ouplné lůny krásná tvář —"
  },
  {
   "texto": "tak bledě jasná, jasně bledá,"
  },
  {
   "texto": "jak milence milenka hledá —"
  },
  {
   "texto": "ve růžovou vzplanula zář;"
  },
  {
   "texto": "na vodách obrazy své zřela"
  },
  {
   "texto": "a sama k sobě láskou mřela."
  },
  {
   "texto": "Dál blyštil bledý dvorů stín,"
  },
  {
   "texto": "jenž k sobě šly vzdy blíž a blíž,"
  },
  {
   "texto": "jak v objetí by níž a níž"
  },
  {
   "texto": "se vinuly v soumraku klín,"
  },
  {
   "texto": "až posléze šerem v jedno splynou."
  },
  {
   "texto": "S nimi se stromy k stromům vinou. —"
  },
  {
   "texto": "Nejzáze stíní šero hor,"
  },
  {
   "texto": "tam bříza k boru, k bříze bor"
  },
  {
   "texto": "se kloní. Vlna za vlnou"
  },
  {
   "texto": "potokem spěchá. Vře plnou —"
  },
  {
   "texto": "v čas lásky — láskou každý tvor."
  },
  {
   "texto": "Za růžového večera"
  },
  {
   "texto": "pod dubem sličná děva sedí,"
  },
  {
   "texto": "se skály v břehu jezera"
  },
  {
   "texto": "daleko přes jezero hledí."
  },
  {
   "texto": "To se jí modro k nohoum vine,"
  },
  {
   "texto": "dále zeleně zakvítá,"
  },
  {
   "texto": "vždy zeleněji prosvítá,"
  },
  {
   "texto": "až v dálce v bledé jasno splyne."
  },
  {
   "texto": "Po šírošíré hladině"
  },
  {
   "texto": "umdlelý dívka zrak upírá;"
  },
  {
   "texto": "po šírošíré hladině"
  },
  {
   "texto": "nic mimo promyk hvězd nezírá;"
  },
  {
   "texto": "Dívčina krásná, anjel padlý,"
  },
  {
   "texto": "co amarant na jaro svadlý,"
  },
  {
   "texto": "v ubledlých lících krásy spějí."
  },
  {
   "texto": "Hodina jenž jí všecko vzala,"
  },
  {
   "texto": "ta v usta, zraky, čelo její"
  },
  {
   "texto": "půvabný žal i smutek psala. —"
  },
  {
   "texto": "Tak zašel dnes dvacátý den,"
  },
  {
   "texto": "v krajinu tichou kráčí sen."
  },
  {
   "texto": "Poslední požár kvapně hasne,"
  },
  {
   "texto": "i nebe, jenž se růžojasné"
  },
  {
   "texto": "nad modrými horami míhá."
  },
  {
   "texto": "„On nejde — již se nevrátí! —"
  },
  {
   "texto": "Svedenou žel tu zachvátí!“"
  },
  {
   "texto": "Hluboký vzdech jí ňadra zdvíhá,"
  },
  {
   "texto": "bolestný srdcem bije cit,"
  },
  {
   "texto": "a u tajemné vod stonání"
  },
  {
   "texto": "mísí se dívky pláč a lkání."
  },
  {
   "texto": "V slzích se zhlíží hvězdný svit,"
  },
  {
   "texto": "jenž po lících co jiskry plynou."
  },
  {
   "texto": "Vřelé ty jiskry tváře chladné"
  },
  {
   "texto": "co padající hvězdy hynou;"
  },
  {
   "texto": "kam zapadnou, tam květ uvadne."
  },
  {
   "texto": "Viz, mihla se u skály kraje;"
  },
  {
   "texto": "daleko přes ní nahnuté"
  },
  {
   "texto": "větýrek bílým šatem vlaje."
  },
  {
   "texto": "Oko má v dálku napnuté. —"
  },
  {
   "texto": "Teď slzy rychle utírá,"
  },
  {
   "texto": "rukou si zraky zastírá"
  },
  {
   "texto": "upírajíc je v dálné kraje,"
  },
  {
   "texto": "kde jezero se v hory kloní,"
  },
  {
   "texto": "po vlnách jiskra jiskru honí,"
  },
  {
   "texto": "po vodě hvězda s hvězdou hraje."
  },
  {
   "texto": "Jak holoubátko sněhobílé"
  },
  {
   "texto": "pod černým mračnem přelétá,"
  },
  {
   "texto": "lílie vodní zakvétá"
  },
  {
   "texto": "nad temné modro; tak se číle —"
  },
  {
   "texto": "kde jezero se v hory níží —"
  },
  {
   "texto": "po temných vlnách cosi blíží,"
  },
  {
   "texto": "rychle se blíží. Malá chvíle,"
  },
  {
   "texto": "a již co čápa vážný let,"
  },
  {
   "texto": "ne již holoubě či lílie květ,"
  },
  {
   "texto": "bílá se plachta větrem houpá."
  },
  {
   "texto": "Štíhlé se veslo v modru koupá,"
  },
  {
   "texto": "a dlouhé pruhy kolem tvoří."
  },
  {
   "texto": "Těm zlaté růže, jenž při doubí"
  },
  {
   "texto": "tam na horách po nebi hoří,"
  },
  {
   "texto": "růžovým zlatem čela broubí."
  },
  {
   "texto": "„Rychlý to člůnek! blíž a blíže!"
  },
  {
   "texto": "To on, to on! Ty péra, kvítí,"
  },
  {
   "texto": "klobouk, oko, jenž pod ním svítí,"
  },
  {
   "texto": "ten plášť!“ Již člůn pod skalou víže."
  },
  {
   "texto": "Vzhůru po skále lehký krok"
  },
  {
   "texto": "uzounkou stezkou plavce vede."
  },
  {
   "texto": "Dívce se zardí tváře bledé"
  },
  {
   "texto": "za dub je skryta. — Vstříc mu běží,"
  },
  {
   "texto": "zaplesá — běží — dlouhý skok —"
  },
  {
   "texto": "již plavci, již na prsou leží —"
  },
  {
   "texto": "„Ha! Běda mi!“ Vtom lůny zář"
  },
  {
   "texto": "jí známou osvítila tvář;"
  },
  {
   "texto": "hrůzou se krev jí v žilách staví."
  },
  {
   "texto": "„Kde Vilém můj?“"
  },
  {
   "texto": "„Viz,“ plavec k ní"
  },
  {
   "texto": "tichými slovy šepce praví:"
  },
  {
   "texto": "„Tam při jezeru vížka ční"
  },
  {
   "texto": "nad stromů noc; její bílý stín"
  },
  {
   "texto": "hlubokoť stopen v jezera klín;"
  },
  {
   "texto": "však hlouběji ještě u vodu vryt"
  },
  {
   "texto": "je z mala okénka lampy svit;"
  },
  {
   "texto": "tam Vilém myšlenkou se baví,"
  },
  {
   "texto": "že příští den jej žití zbaví."
  },
  {
   "texto": "On hanu svou, on tvoji vinu"
  },
  {
   "texto": "se dozvěděl; on svůdce tvého"
  },
  {
   "texto": "vraždě zavraždil otce svého."
  },
  {
   "texto": "Msta v patách kráčí jeho činu. —"
  },
  {
   "texto": "Hanebně zemře. — Poklid mu dán,"
  },
  {
   "texto": "až tváře, jenž co růže květou,"
  },
  {
   "texto": "zbledlé nad kolem obdrží stán,"
  },
  {
   "texto": "až štíhlé oudy v kolo vpletou."
  },
  {
   "texto": "Tak skoná strašný lesů pán! —"
  },
  {
   "texto": "Za hanbu jeho, za vinu svou"
  },
  {
   "texto": "měj hanu světa, měj kletbu mou!“"
  },
  {
   "texto": "Obrátí se. — Utichl hlas —"
  },
  {
   "texto": "Po skále slezl za krátký čas,"
  },
  {
   "texto": "při skále člůn svůj najde."
  },
  {
   "texto": "Ten rychle letí, co čápa let,"
  },
  {
   "texto": "menší a menší, až co lílie květ"
  },
  {
   "texto": "mezi horami po vodě zajde."
  },
  {
   "texto": "Tiché jsou vlny, temný vod klín,"
  },
  {
   "texto": "vše lazurným se pláštěm krylo;"
  },
  {
   "texto": "nad vodou se bílých skví šatů stín,"
  },
  {
   "texto": "a krajina kolem šepce: „Jarmilo!“"
  },
  {
   "texto": "V hlubinách vody: „Jarmilo! Jarmilo!!“"
  },
  {
   "texto": "Je pozdní večer první máj —"
  },
  {
   "texto": "večerní máj — je lásky čas."
  },
  {
   "texto": "Zve k lásky hrám hrdliččin hlas:"
  },
  {
   "texto": "„Jarmilo! Jarmilo!! Jarmilo!!!“"
  }
 ]
}