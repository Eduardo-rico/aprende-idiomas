 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXXXVI."
  },
  {
   "texto": "Jde jaro a v mysli probírá,"
  },
  {
   "texto": "jakých má barev a zvuků:"
  },
  {
   "texto": "co vidět, to v květ se rozvírá,"
  },
  {
   "texto": "vše hovoří v skřivaním tluku."
  },
  {
   "texto": "Jde jaro a v mysli zpomíná,"
  },
  {
   "texto": "jakých má přátel a dětí:"
  },
  {
   "texto": "kde pole, tam nová rodina,"
  },
  {
   "texto": "a mláďátek na každé sněti."
  },
  {
   "texto": "Jde jaro a v mysli zpomíná,"
  },
  {
   "texto": "jakých má domovů, bytů:"
  },
  {
   "texto": "co srdcí, tam domov počíná"
  },
  {
   "texto": "a pne se až do nebes krytu."
  },
  {
   "texto": "Ty lesních krovů střecho tklivá,"
  },
  {
   "texto": "ty domácnosti sterých bran,"
  },
  {
   "texto": "tvá větev všem nám posud kývá,"
  },
  {
   "texto": "tvé brány všemu do kořán!"
  },
  {
   "texto": "Tys ještě tak po dávném mravu,"
  },
  {
   "texto": "tak do upřímna rodinná,"
  },
  {
   "texto": "nic podle rodů, podle stavů —"
  },
  {
   "texto": "a přec tak krásně hostinná."
  },
  {
   "texto": "Jak zlatý déšť tvé skvosty kanou,"
  },
  {
   "texto": "i mech ti perlou vykropí,"
  },
  {
   "texto": "tam chudý, boháč na vybranou,"
  },
  {
   "texto": "co jen kdo srdcem pochopí."
  },
  {
   "texto": "Tvé šero zlatem vykládané,"
  },
  {
   "texto": "tvých vodopádů zrcadla,"
  },
  {
   "texto": "myšlenky hudbou odchované,"
  },
  {
   "texto": "jich mladost, vůně nevadlá —"
  },
  {
   "texto": "To zvu já hostinností pravou,"
  },
  {
   "texto": "zvlášť je-li vítán velice,"
  },
  {
   "texto": "kdo ještě vejde s myslí zdravou —"
  },
  {
   "texto": "tenť potěší se nejvíce."
  },
  {
   "texto": "Cos v mlhách se k lesům potácí,"
  },
  {
   "texto": "jak duchové z podzemní říše —"
  },
  {
   "texto": "a jste-li vy duchové jací,"
  },
  {
   "texto": "nuž mluvte a postůjte tiše."
  },
  {
   "texto": "Ten jeden jak v klášterním šatě,"
  },
  {
   "texto": "tak bílý jak na kazatelně,"
  },
  {
   "texto": "ten mluví tak skrouceně svatě,"
  },
  {
   "texto": "však malounko srozumitelně."
  },
  {
   "texto": "Ti druzí jak nábožné stádo,"
  },
  {
   "texto": "hned ulehli k poutnické holi —"
  },
  {
   "texto": "„Ach věřte, že stárne, co mládo,"
  },
  {
   "texto": "a v staré že dají se moli.“"
  },
  {
   "texto": "Ti srazili v hromadu hlavy —"
  },
  {
   "texto": "„Kéž možná tak nejvíce vědět,"
  },
  {
   "texto": "pít nejlépe na dobré zdraví,"
  },
  {
   "texto": "mít teplounké hnízdo a sedět!“"
  },
  {
   "texto": "Mnich povídá na všecko: ano,"
  },
  {
   "texto": "a žehná jim z rozpjatých ramen:"
  },
  {
   "texto": "„Jen věřte, a vše bude dáno!“ —"
  },
  {
   "texto": "Mé díky, vy duchové; amen."
  },
  {
   "texto": "Co dnes to mají v lese?"
  },
  {
   "texto": "Strom každý skví se v novém šatě,"
  },
  {
   "texto": "má na něm z rosy perly,"
  },
  {
   "texto": "a hlavu od paprsků v zlatě."
  },
  {
   "texto": "Na stromech zpěvný šukot,"
  },
  {
   "texto": "ti drobní slétají se v rady,"
  },
  {
   "texto": "nad lesem krouží sokol,"
  },
  {
   "texto": "tak pyšně, jako do parády."
  },
  {
   "texto": "Potůček v hravé píli,"
  },
  {
   "texto": "teď kvítí v dvě si staví řady,"
  },
  {
   "texto": "a motýl letí do skal,"
  },
  {
   "texto": "by spouštěly se vodopády."
  },
  {
   "texto": "A u skal jedle, buky"
  },
  {
   "texto": "tak vážně jako starší z obce,"
  },
  {
   "texto": "k nim letmo spěchá jelen"
  },
  {
   "texto": "a druzí za ním táhnou s kopce."
  },
  {
   "texto": "Pak předstoupila bříza,"
  },
  {
   "texto": "jak panna ve bělounkém šatě:"
  },
  {
   "texto": "„Pojď, srdce, plesej také,"
  },
  {
   "texto": "my počnem, čekáme jen na tě.“"
  }
 ]
}