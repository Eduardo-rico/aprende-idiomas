{
 "id": "cech-vaclav-z-michalovic-c02",
 "titulo": "Zpěv první",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V%C3%A1clav_z_Michalovic/Zp%C4%9Bv_prvn%C3%AD",
 "fuente": "cs.wikisource.org, «Václav z Michalovic»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (býti, čísti, viděti: 3 formas frente a 2 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-vaclav-z-michalovic",
  "titulo": "Václav z Michalovic",
  "orden": 2
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Plna vůně, ševelu a třpytu"
  },
  {
   "texto": "jídelna dnes otců jesuitů."
  },
  {
   "texto": "Se stěn vlaje rudých látek vlna"
  },
  {
   "texto": "oblačné jak spousty, jitrem vzňaté,"
  },
  {
   "texto": "a v ní slunka hrají nesčíslná —"
  },
  {
   "texto": "znaky řádu v aureole zlaté."
  },
  {
   "texto": "Podlaha, jež kostky mramorové"
  },
  {
   "texto": "v mosaiku dvojbarvou si skládá,"
  },
  {
   "texto": "září leskem šachovnice nové;"
  },
  {
   "texto": "na ni oken světlý obrys padá,"
  },
  {
   "texto": "v němž tu tam obláček pestrý plove —"
  },
  {
   "texto": "stínů hra, již malba skel tam spřádá."
  },
  {
   "texto": "Na podlouhlých stolů valném šiku"
  },
  {
   "texto": "sněhem leží jemná z Flander plátna,"
  },
  {
   "texto": "po nichž stříbro — proti otců zvyku —"
  },
  {
   "texto": "rozkládá dnes ruka sluhů chvatná;"
  },
  {
   "texto": "uprostřed pak alabastr bílý"
  },
  {
   "texto": "květů zvonce kol do kola chýlí."
  },
  {
   "texto": "Velkolepé malby svěží záře"
  },
  {
   "texto": "vábí oko k hloubi refektáře."
  },
  {
   "texto": "Na stěně tam v jarých barvách pálá"
  },
  {
   "texto": "svatební hod v Galilejské Káně —"
  },
  {
   "texto": "mněl bys: život skutečný tam sálá!"
  },
  {
   "texto": "Zdá se ti, že nevěstiny skráně"
  },
  {
   "texto": "purpurem se nítí, blednou sněhem"
  },
  {
   "texto": "pode zraků snoubencových žehem,"
  },
  {
   "texto": "že ruch zachvacuje hostí řadu"
  },
  {
   "texto": "i dav sluhů, kol se rojící,"
  },
  {
   "texto": "že tam hudec paličkami vzadu"
  },
  {
   "texto": "ze sna budí kotlů dvojici"
  },
  {
   "texto": "a kol něho dlouhé píšťaly"
  },
  {
   "texto": "stříbrné se plesným zvukem plní,"
  },
  {
   "texto": "že ret Ježíšův se šeptem vlní,"
  },
  {
   "texto": "kříse vína pramen ustalý — —"
  },
  {
   "texto": "Takých zázraků dnes třeba není"
  },
  {
   "texto": "otcům velebným. Jim v širých sklepích"
  },
  {
   "texto": "moře vína perlí se a pění"
  },
  {
   "texto": "k zavlažení hodů velkolepých."
  },
  {
   "texto": "Dort aj! obrovský tu právě v dar"
  },
  {
   "texto": "otcům posílá don Baltazar."
  },
  {
   "texto": "Sluhů dvojice dar nese stěží."
  },
  {
   "texto": "Tvrze okrouhlé má divný tvar"
  },
  {
   "texto": "s baštou mnohou, cimbuřím a věží."
  },
  {
   "texto": "Zvláštní posádkou se hemží kolem:"
  },
  {
   "texto": "jak by mravenčí byl ztekl voj"
  },
  {
   "texto": "cukrovou tu pevnost, horem, dolem"
  },
  {
   "texto": "drobných podůbek ji plní roj."
  },
  {
   "texto": "Znenáhla v tom postav lidských mraku"
  },
  {
   "texto": "po figurky mnohé tváři, znaku"
  },
  {
   "texto": "divák rozeznává vojsko černé"
  },
  {
   "texto": "odpadlíků církve pravověrné."
  },
  {
   "texto": "Na bráně, v níž nad příkopu hloubí"
  },
  {
   "texto": "hradu most je zdvižen visutý,"
  },
  {
   "texto": "hlásní Cerynt s Ebionem troubí"
  },
  {
   "texto": "v pergamenů chomáč svinutý"
  },
  {
   "texto": "a kol kolem u praků a střílen"
  },
  {
   "texto": "ohyzdní se tovaryši kupí"
  },
  {
   "texto": "z heresie mrzké dávných dílen —"
  },
  {
   "texto": "gnostiků a manicheů tlupy."
  },
  {
   "texto": "S jiným kacířstvem po sladké tvrzi"
  },
  {
   "texto": "přátelí se Valdensové drzí."
  },
  {
   "texto": "Z okna Vykliff úšklebně rty špulí,"
  },
  {
   "texto": "v římse k Husi Jeroným se tulí,"
  },
  {
   "texto": "kolem věže v divotvárném věnci"
  },
  {
   "texto": "ztřeštění se vinou novokřtěnci,"
  },
  {
   "texto": "nejvýše pak zpupná čela chmuří"
  },
  {
   "texto": "Luther, Kalvin, Zwingli na cimbuří."
  },
  {
   "texto": "Věže báň se končí globusem,"
  },
  {
   "texto": "na samé pak makovici její"
  },
  {
   "texto": "v šíji Koprníku Galilei"
  },
  {
   "texto": "s obrovským si zased’ tubusem."
  },
  {
   "texto": "Divně v středu nápojů a krmí,"
  },
  {
   "texto": "v síni otců, statných Říma branců,"
  },
  {
   "texto": "cukrářské plod fantasie strmí —"
  },
  {
   "texto": "křehká pevnost církve odřezanců."
  },
  {
   "texto": "Překvapil dar zvláštní jesuity,"
  },
  {
   "texto": "vrtí hlavou, druh se dívá k druhu,"
  },
  {
   "texto": "až pak šeptem vyznávají v kruhu,"
  },
  {
   "texto": "že vtip nechápou, v tom daru skrytý."
  },
  {
   "texto": "Však již hosty refektář se plní."
  },
  {
   "texto": "Barvou všelikou a různým tvarem"
  },
  {
   "texto": "míchají se roucha v šustu jarém,"
  },
  {
   "texto": "jako bouř když záhon květů zvlní."
  },
  {
   "texto": "Pyšné hlavy kadeřavých vlasů"
  },
  {
   "texto": "pnou se z límců sněžných, kruhovitých,"
  },
  {
   "texto": "nabíraných v nesčíslnou řasu,"
  },
  {
   "texto": "jako z květů báje obrovitých."
  },
  {
   "texto": "Zlatem prošívaný, v divném třpytu,"
  },
  {
   "texto": "k tělům statným oděv přiléhá,"
  },
  {
   "texto": "v něm pak mnohou spárou aksamítu"
  },
  {
   "texto": "plamenitý šarlat prošlehá."
  },
  {
   "texto": "Lehké pláštíky jim s šíje vlají"
  },
  {
   "texto": "se stříbrným šperkem na pokraji."
  },
  {
   "texto": "Mnohobarvá péra k zemi kanou"
  },
  {
   "texto": "přes klobouků střechu prohýbanou;"
  },
  {
   "texto": "s botou střevíc kordovský se druží,"
  },
  {
   "texto": "ostruha s hedvábnou bílou růží."
  },
  {
   "texto": "A s tím světským pychem zápolí"
  },
  {
   "texto": "vedle jesuitské řízy tmavé"
  },
  {
   "texto": "hávy rozmanitých řeholí"
  },
  {
   "texto": "bílé, černé, hnědé, popelavé."
  },
  {
   "texto": "Právě jako bouř když v sady duje,"
  },
  {
   "texto": "že se květ ku květu nachyluje,"
  },
  {
   "texto": "barvy mísí, rosa ze všad blýská:"
  },
  {
   "texto": "tak se vlní pestrá směs a k hlavě"
  },
  {
   "texto": "hlavu kloní, rukou ruku stiská,"
  },
  {
   "texto": "z davu pak, jenž v tlupách tu a tam"
  },
  {
   "texto": "šustí, hlučí, vítaje se, bavě,"
  },
  {
   "texto": "každou chvilku vzácný drahokam"
  },
  {
   "texto": "v rouchu, prstu svitne mihotavě."
  },
  {
   "texto": "Otcové pak vzácných davy hostí"
  },
  {
   "texto": "vítajíce bloudí tam i sem,"
  },
  {
   "texto": "s pokorou zde, onde s důvěrností,"
  },
  {
   "texto": "s poklonou a sladkým úsměvem."
  },
  {
   "texto": "Ku křeslům již panstvo hbitě vodí —"
  },
  {
   "texto": "pořad mnohé rozpaky jim plodí."
  },
  {
   "texto": "Vždyť ach! tolik moci, slávy víže"
  },
  {
   "texto": "kytice ta pánů bohatá!"
  },
  {
   "texto": "hrdý Valdštýn, z Lichtenštejna kníže,"
  },
  {
   "texto": "Michna, Martinic i Slavata,"
  },
  {
   "texto": "Marradas, Huerta — jiní, jiní"
  },
  {
   "texto": "muži vznešení se kupí síní."
  },
  {
   "texto": "Všechny sloupy mocné, hrdě vzpjaté,"
  },
  {
   "texto": "o jejichžto čela žulová"
  },
  {
   "texto": "vlády císařské a víry svaté"
  },
  {
   "texto": "podpírá se skvoucí budova,"
  },
  {
   "texto": "jež v té zemi po válečných šumech"
  },
  {
   "texto": "vypjala se na kacířství rumech."
  },
  {
   "texto": "Jaký pohled na ty trůnu rady,"
  },
  {
   "texto": "sluhy církve, tlupy válečníků,"
  },
  {
   "texto": "ani kolem dlouhých stolů šiku"
  },
  {
   "texto": "sbírají se v šumné, skvoucí řady!"
  },
  {
   "texto": "Stýká se tu protiv na tisíc:"
  },
  {
   "texto": "Onde ve vyzáblou mnišskou líc"
  },
  {
   "texto": "hluboko své divé znaky vtiská"
  },
  {
   "texto": "fanatismus, jenž jí z oka blýská;"
  },
  {
   "texto": "ale vedle rudým kyprým rtem"
  },
  {
   "texto": "v tučné tváři jiný bosák lysý"
  },
  {
   "texto": "mlčky libuje si hříšnou zem,"
  },
  {
   "texto": "dokud nad ní révy hrozen visí."
  },
  {
   "texto": "Obličej tu dvořenína hladký"
  },
  {
   "texto": "mžourá bystrým okem zchytrale,"
  },
  {
   "texto": "na rty tenké úsměv nutě sladký,"
  },
  {
   "texto": "an mu vojín tváře zvětralé,"
  },
  {
   "texto": "v jejíž drsné hrboly a hrany"
  },
  {
   "texto": "mnohé činy krvavé jsou psány,"
  },
  {
   "texto": "vypravuje, zpurný hladě knír,"
  },
  {
   "texto": "kam jej zanesl kdy boje vír."
  },
  {
   "texto": "S Němcem rozvážným Vlach onde hravý,"
  },
  {
   "texto": "tuto Španěl s Valonem se baví."
  },
  {
   "texto": "V divnou strakatinu pronárodů"
  },
  {
   "texto": "od nedávna panstvo české zkvétá —"
  },
  {
   "texto": "vždyť se slétli k bohatému hodu"
  },
  {
   "texto": "orlové sem ze všech konců světa."
  },
  {
   "texto": "Ležíť kraj zde mrtvý, pošlapaný,"
  },
  {
   "texto": "uštvané jak zvěře zbitá kůže,"
  },
  {
   "texto": "z níž si mečem popluží a lány"
  },
  {
   "texto": "po libosti smělec řezat může."
  },
  {
   "texto": "Všaktě stálo mnohou trudu chvíli,"
  },
  {
   "texto": "nežli kacířskou tu kletou krev"
  },
  {
   "texto": "pod sekyrou, mečem proměnili"
  },
  {
   "texto": "v pyšný šarlat sobě za oděv,"
  },
  {
   "texto": "nežli hořké slzy exulantů"
  },
  {
   "texto": "změnily se v záři diamantů,"
  },
  {
   "texto": "jež tu blýská shromážděním četným"
  },
  {
   "texto": "ze spon, jilců, pošev, prstenů,"
  },
  {
   "texto": "krůpěje jak rosy sadem květným"
  },
  {
   "texto": "na jitřního slunce plamenu."
  },
  {
   "texto": "Stojíce teď nad tabule vnadou,"
  },
  {
   "texto": "ruce spjali pod skloněnou bradou"
  },
  {
   "texto": "a hlas modlitby již sborem vane:"
  },
  {
   "texto": "„Oči všech doufají v tebe, Pane!“"
  },
  {
   "texto": "Na katedru, která v síně rohu,"
  },
  {
   "texto": "kazatelně lehké podobna,"
  },
  {
   "texto": "na stěně se vznáší, v lepém slohu,"
  },
  {
   "texto": "jížto mnohá díla ozdobná"
  },
  {
   "texto": "v obrubu i krytby polokruh"
  },
  {
   "texto": "vyřezal kýs umný řádu druh,"
  },
  {
   "texto": "vystoupil teď novic volným krokem."
  },
  {
   "texto": "Hocha toho jemná, bledá tvář"
  },
  {
   "texto": "pod kadeří černou, s temným okem,"
  },
  {
   "texto": "jehož blouznivou teď tlumí zář"
  },
  {
   "texto": "dlouhá brva, — ještě bledším zdá se"
  },
  {
   "texto": "nad havem, jenž útlou postavu"
  },
  {
   "texto": "poukrývá v černé volné řáse."
  },
  {
   "texto": "Plaše přelétl teď po davu"
  },
  {
   "texto": "jeho zrak a něžná ruka bílá"
  },
  {
   "texto": "pergamenů stůčku rozestýlá."
  },
  {
   "texto": "S rozpačitým rtů se chystá chvěním,"
  },
  {
   "texto": "by dle zvyku, který zbožní otci"
  },
  {
   "texto": "i v den slavný ponechali v moci,"
  },
  {
   "texto": "kvas ten šlechtil bohulibým čtením."
  },
  {
   "texto": "I čte již, jak v lůno české země"
  },
  {
   "texto": "padlo, rostlo navzdor sokům zlostným,"
  },
  {
   "texto": "až pak rozvilo se květem skvostným"
  },
  {
   "texto": "blahodárné Loyolovo sémě."
  },
  {
   "texto": "Pohřížena v tupý bludů spánek"
  },
  {
   "texto": "kacířskými zem ta vřela kvasy,"
  },
  {
   "texto": "až jí přízně panovničí vánek"
  },
  {
   "texto": "na hruď chorou přivál zrno spásy."
  },
  {
   "texto": "Canisius, muž to vzňatý bohem,"
  },
  {
   "texto": "vnořil semo do kacířské půdy"
  },
  {
   "texto": "opatrně první základ chudý,"
  },
  {
   "texto": "na němž časem, po snažení mnohém,"
  },
  {
   "texto": "tato kollej nádherného lesku"
  },
  {
   "texto": "hrdé témě vznesla ku nebesku."
  },
  {
   "texto": "„Procul esto canis!“ blud jej zdravil —"
  },
  {
   "texto": "však hus proklatou ten pes jim zdávil."
  },
  {
   "texto": "Ba sám otec Ignatius svatý"
  },
  {
   "texto": "na své hrudi, k nové spásy vzniku,"
  },
  {
   "texto": "by blud český rozškubali klatý,"
  },
  {
   "texto": "vypěstoval dvanáct sokolíků."
  },
  {
   "texto": "Dvanáct dělníků na spustlou roli"
  },
  {
   "texto": "z Říma vyslal — nové apoštoly."
  },
  {
   "texto": "Na loži svém, těžkém u neduhu,"
  },
  {
   "texto": "libě mluvil v loučících se kruhu"
  },
  {
   "texto": "a v tom, zahlédnuv knih těžké břímě"
  },
  {
   "texto": "vedle poutníků, — „Ó, malé víry!"
  },
  {
   "texto": "k čemu vám knih mrtvých plné míry?“"
  },
  {
   "texto": "zvolal káravě. „Či Bůh jen v Římě?"
  },
  {
   "texto": "Onť vám skytne všude, čeho třeba, —"
  },
  {
   "texto": "tělesného, duševního chleba."
  },
  {
   "texto": "Jediná vám kniha plně stačí:"
  },
  {
   "texto": "zde ten Gerson! Pilně čtěte ji,"
  },
  {
   "texto": "snažte se, ať noha vaše kráčí"
  },
  {
   "texto": "v Ježíšově stále šlepěji,"
  },
  {
   "texto": "nemiňte se nikdy jeho stopy"
  },
  {
   "texto": "a pak ze klopotné české žni"
  },
  {
   "texto": "odnesete mnohé zlaté snopy —"
  },
  {
   "texto": "církve svaté reci vítězní!“"
  },
  {
   "texto": "Při těch slovech s lože k nim se shýbal,"
  },
  {
   "texto": "synáčky své objímal a líbal,"
  },
  {
   "texto": "žehnaje se dotkl jejich skrání. —"
  },
  {
   "texto": "Neslo zdar to svaté požehnání!"
  },
  {
   "texto": "Zkvétal utěšeně v kraji českém"
  },
  {
   "texto": "Canisiův květ, pln vůní nebe,"
  },
  {
   "texto": "a kruh příznivců vždy kolem sebe"
  },
  {
   "texto": "šířil valnější svých ctností leskem."
  },
  {
   "texto": "Jinoch jeden český, vzácných ctností,"
  },
  {
   "texto": "chovanec náš, plný zbožné píle,"
  },
  {
   "texto": "samoten dlel v chrámě před svátostí"
  },
  {
   "texto": "na modlitbách kdysi pozdní chvíle."
  },
  {
   "texto": "Pojednou ach! vidí: blesky zžíhá"
  },
  {
   "texto": "monstrance se věnec, sluncem hoří"
  },
  {
   "texto": "a v tom světla nebeského moři"
  },
  {
   "texto": "andělských se křídel tisíc míhá,"
  },
  {
   "texto": "uprostřed pak na hostii sněžné"
  },
  {
   "texto": "pacholátko spatřil čaroněžné"
  },
  {
   "texto": "a hlas rajský: „Žádám,“ s hůry zněl,"
  },
  {
   "texto": "„abys tam, kde jsi, vždy býti chtěl.“"
  },
  {
   "texto": "Porozuměv jinoch, první z Čechů"
  },
  {
   "texto": "Ježíšův podnikl svatý řád"
  },
  {
   "texto": "a v něm horlil do sledního dechu, —"
  },
  {
   "texto": "jitřenka to jasná pustých lad,"
  },
  {
   "texto": "za níž brzy v jarém vzešly svitu"
  },
  {
   "texto": "hvězdné davy českých jesuitů."
  },
  {
   "texto": "Společnost pak naše v této zemi"
  },
  {
   "texto": "zvítězila nad odpůrci všemi."
  },
  {
   "texto": "Marně zlobným direktoři slovem"
  },
  {
   "texto": "uhnětli ji — zkvetla v lesku novém."
  },
  {
   "texto": "Odpůrců však hlavy zločinné"
  },
  {
   "texto": "klesly v prach — Laus Tibi, Domine!"
  },
  {
   "texto": "Svinul novic pergamén a kráčí"
  },
  {
   "texto": "tiše, skromně refektářem dolů,"
  },
  {
   "texto": "kde kol prostičkého nejzáz’ stolu"
  },
  {
   "texto": "věnec mladých soudruhů se stáčí."
  },
  {
   "texto": "Ale panstvem ševelí to, šumí,"
  },
  {
   "texto": "s šeptem hlava ku hlavě se kloní."
  },
  {
   "texto": "„Švarný hoch! — Jak pěkně čísti umí! —"
  },
  {
   "texto": "Jaký výraz! — Hlas mu stříbrem zvoní!“"
  },
  {
   "texto": "Otázka kol chví se přitlumená:"
  },
  {
   "texto": "„Jakého ten mladík rodu, jména?“"
  },
  {
   "texto": "Páter Sidecius k tlupě hostí"
  },
  {
   "texto": "nejbližších se sklonil v důvěrnosti:"
  },
  {
   "texto": "„V tovaryšstva náruč mojí dlaní"
  },
  {
   "texto": "uvedlo jej boží slitování."
  },
  {
   "texto": "Bylo krátce po krvavém díle,"
  },
  {
   "texto": "v němžto světlá nebes královna"
  },
  {
   "texto": "laurem věnčila na Hoře Bílé"
  },
  {
   "texto": "katolická vojska rekovná,"
  },
  {
   "texto": "kdy jsem jednou, v kollej naši drahou"
  },
  {
   "texto": "z vyhnanství se vrátiv, těkal Prahou."
  },
  {
   "texto": "Ač jsem hrůzu zřel v ní vévodící,"
  },
  {
   "texto": "přec to zjev byl srdci lahodící."
  },
  {
   "texto": "Meškalť duch můj v čase nedalekém,"
  },
  {
   "texto": "kdy tou sítí ulic klikatých"
  },
  {
   "texto": "prchali jsme před buřičů vztekem."
  },
  {
   "texto": "Jak tu kacířský se blyštil pych!"
  },
  {
   "texto": "V davů jásajících pestrém moři"
  },
  {
   "texto": "brodili se v pyšném úboru"
  },
  {
   "texto": "na komoních bujných defensoři"
  },
  {
   "texto": "pod barvitým tlumem praporů,"
  },
  {
   "texto": "znaky, hesly mrzkými se skvoucích,"
  },
  {
   "texto": "jarním vánkem vesele se dmoucích."
  },
  {
   "texto": "Mistři lživí, kněží nepraví,"
  },
  {
   "texto": "s biblí pod pažím, v ten hlahol plesný"
  },
  {
   "texto": "mísili svůj chorál rouhavý."
  },
  {
   "texto": "A ten obraz políbení vesny"
  },
  {
   "texto": "zlatilo — ve výši lazurné"
  },
  {
   "texto": "zjasnily se věže pošmurné,"
  },
  {
   "texto": "zajásaly zvonů sborem slavným."
  },
  {
   "texto": "I těm štítům domů starodávným"
  },
  {
   "texto": "rozhostil se v čela slunný jas,"
  },
  {
   "texto": "pod římsou se budil ptačí hlas."
  },
  {
   "texto": "Pod svěžími věnci dívčí tváře"
  },
  {
   "texto": "klonily se z oken v úsměvu —"
  },
  {
   "texto": "všude bujný ruch a květ a záře!"
  },
  {
   "texto": "Jenom pro nás v tomto výjevu"
  },
  {
   "texto": "úsměv každý v pohrůžku se měnil"
  },
  {
   "texto": "a kam prchajících padl hled,"
  },
  {
   "texto": "pěstě mnohé zdvihaly se hned"
  },
  {
   "texto": "a hněv s potupou jen zuby cenil."
  },
  {
   "texto": "Ale nyní… Jeseň zádumčivá"
  },
  {
   "texto": "nad truchlivým městem, pustým polou,"
  },
  {
   "texto": "rozestýlá mračna těžká, sivá,"
  },
  {
   "texto": "smuteční jak příkrov nad mrtvolou."
  },
  {
   "texto": "Posupně se vetché štíty mračí"
  },
  {
   "texto": "a ty domy němé, uzavřené"
  },
  {
   "texto": "jako v úzkostech se k sobě tlačí."
  },
  {
   "texto": "Žoldnéřů jen tlupy rozjařené"
  },
  {
   "texto": "s písní hlučnou ulicemi hýří,"
  },
  {
   "texto": "zbraní lomoz — bubny zevšad víří."
  },
  {
   "texto": "A kam davy kacířů se děly?"
  },
  {
   "texto": "Kamo direktorů zástup smělý?"
  },
  {
   "texto": "Kamo pýcha, hrabivost a vzdor?"
  },
  {
   "texto": "Hle! Jak stíny postavy se plíží"
  },
  {
   "texto": "schlípené tu onde, hlavy níží,"
  },
  {
   "texto": "a jen časem vyplašený zor"
  },
  {
   "texto": "v malomocném záští, strachu němém"
  },
  {
   "texto": "kmitne pod klobouku svislým lemem."
  },
  {
   "texto": "Hle, jak tisknou se, by jejich zjev"
  },
  {
   "texto": "neupoutal pohled branné chasy,"
  },
  {
   "texto": "jejíž meče samoděk se tasí,"
  },
  {
   "texto": "kacířskou-li jenom zvětří krev."
  },
  {
   "texto": "Jen se k domům přitiskujte blíž,"
  },
  {
   "texto": "hlavy uklánějte níž a níž!"
  },
  {
   "texto": "Jižtě vstává slunce víry pravé"
  },
  {
   "texto": "nad staré ty domy, kaple, týny"
  },
  {
   "texto": "a z těch ulic v záři plápolavé"
  },
  {
   "texto": "vyplaší vás navždy, bludné stíny!"
  },
  {
   "texto": "V takých myšlenkách jsem bloudil městem."
  },
  {
   "texto": "Náhle v pusté místo bezlidné"
  },
  {
   "texto": "smích a váda s kostek hluchým chřestem"
  },
  {
   "texto": "zvábily mne s dráhy poklidné."
  },
  {
   "texto": "Na vrch bubnu kostky metajíce"
  },
  {
   "texto": "tři tam sedí zpilí žoldnéři"
  },
  {
   "texto": "hledů zpurných, osmahlého líce,"
  },
  {
   "texto": "pocuchaných brad a kadeří."
  },
  {
   "texto": "V pozadí pak hmota neurčitá"
  },
  {
   "texto": "pod vojenským pláštěm poukryta"
  },
  {
   "texto": "na zemi se jeví. Vedle stojí"
  },
  {
   "texto": "hošík útlý, šestiletý as,"
  },
  {
   "texto": "v drahocenném patricijském kroji."
  },
  {
   "texto": "Jak obláčky temné černý vlas"
  },
  {
   "texto": "pod karkulkou sinou, řásnou splývá,"
  },
  {
   "texto": "s níž se péro sněhobílé kývá."
  },
  {
   "texto": "Blankytové řásné sukně kraj"
  },
  {
   "texto": "obestýlá sněhem hranostaj."
  },
  {
   "texto": "Ba ni dýka něžná, míšek hravý"
  },
  {
   "texto": "za ozdobným útlých boků pasem"
  },
  {
   "texto": "s hojných drahokamů různým jasem"
  },
  {
   "texto": "neschází mu do panické slávy."
  },
  {
   "texto": "Na prsou pak jemně vyšitý"
  },
  {
   "texto": "v bílé roušce, hustě nabírané,"
  },
  {
   "texto": "okázale bludu symbol plane —"
  },
  {
   "texto": "prostý kalich z rudé dykyty."
  },
  {
   "texto": "Ač pod okem tmavým v líčku bledém"
  },
  {
   "texto": "jako rosa v bílém poupěti"
  },
  {
   "texto": "žal se jeví skvoucím slzy sledem,"
  },
  {
   "texto": "přec i vzdor v tom oku viděti,"
  },
  {
   "texto": "kteréž z pod obrví jemného"
  },
  {
   "texto": "škaredě se na žoldáky vzpírá —"
  },
  {
   "texto": "ho! již z očka toho temného"
  },
  {
   "texto": "malý dravec kališnický zírá!"
  },
  {
   "texto": "Roztomile slušel háv ten panský"
  },
  {
   "texto": "něžné podůbce, že budil ve mně"
  },
  {
   "texto": "zalíbení kacíř filigranský."
  },
  {
   "texto": "Chvíli na robě jsem zíral němě,"
  },
  {
   "texto": "naslouchaje hádce Valónů,"
  },
  {
   "texto": "kteří hry své vděkem opojeni"
  },
  {
   "texto": "přeslechli mých kroků blízké znění"
  },
  {
   "texto": "a los metali teď o sponu,"
  },
  {
   "texto": "poutající hochu k čapce něžné"
  },
  {
   "texto": "stříbrným pazourem péro sněžné."
  },
  {
   "texto": "Posléz puzen tajným vnuknutím"
  },
  {
   "texto": "přistoupil jsem k hráčům. Oči vznesli"
  },
  {
   "texto": "překvapeni. Kostky leknutím"
  },
  {
   "texto": "z chvějících se rukou k zemi klesly."
  },
  {
   "texto": "Patrně tu hrubě překročila"
  },
  {
   "texto": "chasa jará dovolenou mez,"
  },
  {
   "texto": "svědomí jich, trochu zdivočilá,"
  },
  {
   "texto": "rázem probudil svým zjevem kněz."
  },
  {
   "texto": "Ať se Valón zove hlavou vzdornou —"
  },
  {
   "texto": "před knězem ji chýlí s úctou vzornou."
  },
  {
   "texto": "Čí to hošík? — tážu se jich přísně."
  },
  {
   "texto": "Vykoktali odvět ze své tísně,"
  },
  {
   "texto": "že to nevědí, že z loktů chůvy"
  },
  {
   "texto": "kolem jdoucí vyrvali to dítě."
  },
  {
   "texto": "A kde ona chůva?"
  },
  {
   "texto": "Rozpačitě"
  },
  {
   "texto": "zraky sklopili a bez výmluvy"
  },
  {
   "texto": "s úšklebkem pak vrhli pohled stranný"
  },
  {
   "texto": "na plášť vetchý blízko rozestlaný."
  },
  {
   "texto": "Ve zlé předtuše má noha zdvihla"
  },
  {
   "texto": "okraj pláště. Pod ním mrtvá líc"
  },
  {
   "texto": "v temné spoustě rozpoutaných kštic"
  },
  {
   "texto": "nad hrudí se obnaženou mihla"
  },
  {
   "texto": "pěkné děvy — — Pochopil jsem všecko."
  },
  {
   "texto": "Pohledem jsem přísným brance káral"
  },
  {
   "texto": "a jal v náruč vzdorující děcko."
  },
  {
   "texto": "Soucit hluboký se ve mně zháral,"
  },
  {
   "texto": "hlas mi velel v duši rozechvěné,"
  },
  {
   "texto": "bych to ptáče, hnízda pozbavené,"
  },
  {
   "texto": "církvi svaté v náruč teplou vložil"
  },
  {
   "texto": "a jím kdysi boží slávu zmnožil."
  },
  {
   "texto": "Bez překážky odnášel jsem robě"
  },
  {
   "texto": "pod svým pláštěm, vzlykající tiše,"
  },
  {
   "texto": "usnuvší pak v teplu měkké skrýše,"
  },
  {
   "texto": "v naši kollej — k příští její zdobě."
  },
  {
   "texto": "Smazána je zcela v dětské duši"
  },
  {
   "texto": "památka dnů zašlých; jedva tuší,"
  },
  {
   "texto": "že kdys mimo kollej tuto dlelo."
  },
  {
   "texto": "Otec jeho — rektor, církev — matka."
  },
  {
   "texto": "Těšíme se všichni z pacholátka,"
  },
  {
   "texto": "jehož srdéčko se otevřelo"
  },
  {
   "texto": "záhy nadpozemské záři spasné,"
  },
  {
   "texto": "jako slunci poupě čarokrásné."
  },
  {
   "texto": "Jeho ducha, srdce hojný skvost"
  },
  {
   "texto": "utěšenou věští budoucnost!“"
  },
  {
   "texto": "Rektor Beskovius dodal k tomu:"
  },
  {
   "texto": "„Z dětských let mu jenom pozůstalo"
  },
  {
   "texto": "jméno Václav, jímž se samo zvalo,"
  },
  {
   "texto": "když je páter v loktech přines’ domů."
  },
  {
   "texto": "Nikdo k němu nehlásil se posud; —"
  },
  {
   "texto": "však jsme v taji vychovali juna,"
  },
  {
   "texto": "by snad otec kacíř z církve lůna"
  },
  {
   "texto": "zpět jej nestrh’ ve svůj děsný osud."
  },
  {
   "texto": "Však sám nejedno jsem vyrval robě"
  },
  {
   "texto": "z rukou otce, z matky objetí,"
  },
  {
   "texto": "zatvrzelých ve kacířské zlobě,"
  },
  {
   "texto": "a ni prosba mne ni prokletí"
  },
  {
   "texto": "ni slz řeka, jež mi ruce myla,"
  },
  {
   "texto": "nezdržela od spasného díla.“"
  },
  {
   "texto": "Don Huerta na to, máchnuv rukou:"
  },
  {
   "texto": "„Milost s kacíři! Pa! Jděte na ně"
  },
  {
   "texto": "s pobožnosti harfou libozvukou —"
  },
  {
   "texto": "k uším za vděk přitisknou si dlaně."
  },
  {
   "texto": "Kázání jim v srdce jenom vchází,"
  },
  {
   "texto": "když ho rachot bubnu doprovází,"
  },
  {
   "texto": "a zář pravdy nejlíp si je získá,"
  },
  {
   "texto": "když meč nahý do oka ji blýská."
  },
  {
   "texto": "Touto zásadou jsem vždy se řídil"
  },
  {
   "texto": "a žeň za to přebohatou klidil."
  },
  {
   "texto": "Bez chlouby dím, že jsem v této zemi"
  },
  {
   "texto": "více duší ďáblu vydral směle"
  },
  {
   "texto": "za tři léta, než po žití celé"
  },
  {
   "texto": "Kristus Ježíš s apoštoly všemi.“"
  },
  {
   "texto": "„Pravdu svatou don Huerta řek’,“"
  },
  {
   "texto": "přisvědčil mu Přibík Jeníšek."
  },
  {
   "texto": "„Takto nejsnáz dospějeme k cíli —"
  },
  {
   "texto": "dokázal mi skutkem thesi tu:"
  },
  {
   "texto": "Jako křemeny hle! tvrdé byly"
  },
  {
   "texto": "lebky domažlických husitů."
  },
  {
   "texto": "Darmo mnichy k missiím jsem vozil,"
  },
  {
   "texto": "marně žádal, domlouval a hrozil"
  },
  {
   "texto": "a již naděje se málem vzdal."
  },
  {
   "texto": "Tu když jednou, v této síni právě,"
  },
  {
   "texto": "zbožných otců malvaz při zábavě"
  },
  {
   "texto": "přátelské mi jazyk rozvázal,"
  },
  {
   "texto": "donu Martinovi jsem se svěřil."
  },
  {
   "texto": "Ten mě hledem posměšným jen změřil"
  },
  {
   "texto": "a řek’ chladně: „Pět set žlutých v sázku,"
  },
  {
   "texto": "za týden že zbavím bludů všech"
  },
  {
   "texto": "tvrdohlavou domažlickou chásku!“"
  },
  {
   "texto": "Přijal jsem tu sázku na pospěch — —“"
  },
  {
   "texto": "„A já“ — vpadl don ve hlučném smíchu —"
  },
  {
   "texto": "„vzal jsem houfec nizozemských hochů"
  },
  {
   "texto": "a jim uzdu popustil jen trochu —:"
  },
  {
   "texto": "za den svlékli Domažličtí pýchu,"
  },
  {
   "texto": "odpřisáhli blud svůj proklatý"
  },
  {
   "texto": "a pan Přibík klopil dukáty — —“"
  },
  {
   "texto": "„Pravda vše — až na to klopení,“"
  },
  {
   "texto": "praví Přibík, hladě kníry dlaní,"
  },
  {
   "texto": "pod nimiž se v chytrém usmívání"
  },
  {
   "texto": "vlní rtové vínem skropení."
  },
  {
   "texto": "„Jak?“ don Martin zvolal u nevoli,"
  },
  {
   "texto": "„což jich nebyly tři plné stoly?“"
  },
  {
   "texto": "„Ovšem, byly — nikoli však mých!"
  },
  {
   "texto": "Musilyť je platit — s žalem sice —"
  },
  {
   "texto": "obrácené tebou Domažlice.“"
  },
  {
   "texto": "Don Huertou otřás’ hlučný smích."
  },
  {
   "texto": "„Tak tak, hochu! Hoden’s mistra chvály!“"
  },
  {
   "texto": "S ním se všichni k slzám rozesmáli."
  },
  {
   "texto": "„Však co značí,“ Michna zvolal nyní,"
  },
  {
   "texto": "„tento divný dort, ten sladký srub,"
  },
  {
   "texto": "v němž se hemží bludu paladýni?"
  },
  {
   "texto": "Takou lahůdkou ať Belzebub"
  },
  {
   "texto": "zakončuje pekelný svůj kvas!“"
  },
  {
   "texto": "Pousmál se dárce Marradas,"
  },
  {
   "texto": "o číš meče jilcem pozazvonil."
  },
  {
   "texto": "Aj, tu z dortu zazněl trouby hlas,"
  },
  {
   "texto": "vytažený most se rázem sklonil,"
  },
  {
   "texto": "do kořán se brána rozlétla,"
  },
  {
   "texto": "a hle! z nitra cukrového stanu"
  },
  {
   "texto": "postava se drobná vypletla"
  },
  {
   "texto": "před žasnoucí zraky kněží, pánů."
  },
  {
   "texto": "Udivení rozlehl se křik:"
  },
  {
   "texto": "Byl to živý směšný trpaslík,"
  },
  {
   "texto": "v ďábla převlečený bujným vtipem."
  },
  {
   "texto": "Fantastické roucho sterým cípem"
  },
  {
   "texto": "kývalo kol postavičky chudé"
  },
  {
   "texto": "od hlavy až po střevíčky rudé,"
  },
  {
   "texto": "v čele pak se vilo růžků dvé"
  },
  {
   "texto": "z opeřené čapky krvavé."
  },
  {
   "texto": "Tak tu v kole hodovníků stál"
  },
  {
   "texto": "s počerněnou, šklebící se tváří,"
  },
  {
   "texto": "klíče nesa rudém na polštáři,"
  },
  {
   "texto": "až pak, ukloniv se dvorně, prál:"
  },
  {
   "texto": "„Dosti dlouho v této bludu tvrzi"
  },
  {
   "texto": "svaté církvi klad’ jsem odboj drzý."
  },
  {
   "texto": "Dosti dlouho v různém šalby cviku"
  },
  {
   "texto": "s vojskem heretiků, schismatiků"
  },
  {
   "texto": "zbraní lži a klamu, liché vědy,"
  },
  {
   "texto": "šíp svůj noře v pekla steré jedy,"
  },
  {
   "texto": "ba i bibli udělav si štítem,"
  },
  {
   "texto": "vzdoroval jsem pravdě v boji lítém."
  },
  {
   "texto": "Však již vidím, že svou celou zbrojí"
  },
  {
   "texto": "křehká pevnost bludu, rozkolu"
  },
  {
   "texto": "proti církve moci neobstojí,"
  },
  {
   "texto": "po marném že padne zápolu"
  },
  {
   "texto": "v mečů vašich bohatýrském kmitu,"
  },
  {
   "texto": "v bystré palbě otců jesuitů."
  },
  {
   "texto": "Protož její klíč vám k nohám skládám"
  },
  {
   "texto": "v čiré pokoře a slušně žádám:"
  },
  {
   "texto": "Snězte již co zde váš vidí zor,"
  },
  {
   "texto": "tyto husity a luterány,"
  },
  {
   "texto": "tyto kalvinisty, zwingliány,"
  },
  {
   "texto": "novokřtěnce, bratří českých sbor,"
  },
  {
   "texto": "s celou tvrzí bludu vydobytou,"
  },
  {
   "texto": "bez okolků, s chutí náležitou!“"
  },
  {
   "texto": "Smích a tleskot odměnou byl čertu,"
  },
  {
   "texto": "za nímž dort hned kacířský se shroutil,"
  },
  {
   "texto": "a don Baltazar co strůjce žertu"
  },
  {
   "texto": "sivý knír si spokojeně kroutil."
  },
  {
   "texto": "A již víno, v pohárech se rdící,"
  },
  {
   "texto": "poč’lo stoupat do zjařených lící,"
  },
  {
   "texto": "jiskrou hrálo v oku veselém:"
  },
  {
   "texto": "čilejším vždy ruchem, ševelem"
  },
  {
   "texto": "sál se plnil; mnohý knoflík zlatý"
  },
  {
   "texto": "břichu uvolnil háv těsně spjatý;"
  },
  {
   "texto": "mnohý pohár převržený zvonil;"
  },
  {
   "texto": "mnohý leb se povážlivě klonil;"
  },
  {
   "texto": "hlučnější vždy hovor síní šuměl;"
  },
  {
   "texto": "a již vynikal jen rázný hlas,"
  },
  {
   "texto": "jímž don Martin Huerta hřmít uměl"
  },
  {
   "texto": "a don Baltazar de Marradas."
  },
  {
   "texto": "Náhle v plochu ozdobného křesla"
  },
  {
   "texto": "obrovitá postava se vznesla,"
  },
  {
   "texto": "s vlasem havraním a bledou lící,"
  },
  {
   "texto": "s divnou v očích září plamennou."
  },
  {
   "texto": "Jako mráček západem se rdící,"
  },
  {
   "texto": "rudý pláštík vlál jí s ramenou;"
  },
  {
   "texto": "rudý měla kabát, nohavici,"
  },
  {
   "texto": "jejíž četnou spárou prohlédal"
  },
  {
   "texto": "nach jen tmavší; mocné ve pravici"
  },
  {
   "texto": "pohár s mělnickým se pozvedal."
  },
  {
   "texto": "Byl to Verdugo, jenž ze svých statků,"
  },
  {
   "texto": "za seč bělohorskou obdržených,"
  },
  {
   "texto": "k těla božího sem přijel svátku,"
  },
  {
   "texto": "by se bavil v kruhu přátel ctěných."
  },
  {
   "texto": "Stál tu, jak by přioděn byl v krev,"
  },
  {
   "texto": "a hned upoutal vše jeho zjev."
  },
  {
   "texto": "A jak před bouří, kdy mrtvé snění"
  },
  {
   "texto": "nepohnutou, tichou nivu jímá,"
  },
  {
   "texto": "však se zdá, že v tomto utišení"
  },
  {
   "texto": "příští bouř již utajena dřímá:"
  },
  {
   "texto": "tak tu náhle bez pohnutí v sále"
  },
  {
   "texto": "panstvo sedí ve hrobové tíši,"
  },
  {
   "texto": "však již ret se ladí k bouřné chvále"
  },
  {
   "texto": "a dlaň stiská ku přípitku číši."
  },
  {
   "texto": "Oči všech tu bez ševelu tkvějí"
  },
  {
   "texto": "v bledém Verdugově obličeji"
  },
  {
   "texto": "na číši, již ruka jeho třímá,"
  },
  {
   "texto": "na rtu ohnivém, jenž nyní hřímá:"
  },
  {
   "texto": "„Verdugo jsem! — Však mě všichni znáte."
  },
  {
   "texto": "Kata značí španělské mé jméno —"
  },
  {
   "texto": "však chci katem zůstat neproměnno"
  },
  {
   "texto": "nepřátelům vládce, víry svaté!"
  },
  {
   "texto": "Víte všichni, jak jsem kdysi divě"
  },
  {
   "texto": "na Bílé tam hoře mečem mával"
  },
  {
   "texto": "a sám Ferdinand že milostivě"
  },
  {
   "texto": "za korunu českou dík mi vzdával."
  },
  {
   "texto": "Voják vykonal své dílo k chvále;"
  },
  {
   "texto": "nuž, vy kněží, politici — dále!"
  },
  {
   "texto": "Pro mne není brk; jsem přítel meče"
  },
  {
   "texto": "a rád tam, kde krve řeka teče."
  },
  {
   "texto": "Leč v té zemi dosti rukou naší"
  },
  {
   "texto": "cedilo již krve zbujné plémě; —"
  },
  {
   "texto": "teď nech stíny od čela nám plaší"
  },
  {
   "texto": "krev ta rujná samé české země!"
  },
  {
   "texto": "Tato krev, jež v záři rubínové"
  },
  {
   "texto": "perlami nás ku rozkoši zove,"
  },
  {
   "texto": "již tu vznáším v opěněné číši"
  },
  {
   "texto": "na oslavu církvi, králi, říši!"
  },
  {
   "texto": "Nechať nad tou zemí svatá víra"
  },
  {
   "texto": "navždy spasnou náruč rozestírá,"
  },
  {
   "texto": "ať jí nikdy pod vítěznou patou"
  },
  {
   "texto": "nevztyčí už blud svou hlavu klatou,"
  },
  {
   "texto": "ať nám dlouho Ferdinandus žije"
  },
  {
   "texto": "a laur ještě mnohý v kadeř vije!“"
  },
  {
   "texto": "Úžasná teď bouře v sále šírém"
  },
  {
   "texto": "pozdvihla se za těmito slovy:"
  },
  {
   "texto": "postav směsice se pestrým vírem"
  },
  {
   "texto": "odevšady hrne k Verdugovi."
  },
  {
   "texto": "Dupot sterých střevíců a bot,"
  },
  {
   "texto": "překocených nádob třesk a hřmot,"
  },
  {
   "texto": "šustot rouch a rukojetí cinkot"
  },
  {
   "texto": "o kovové pásy, ostruh břinkot,"
  },
  {
   "texto": "lomoz křesla, upadlého kdesi —"
  },
  {
   "texto": "snoubí se tu v pusté zvuků směsi."
  },
  {
   "texto": "Jako příboj vln se valí hlavy"
  },
  {
   "texto": "v sále, rudou látkou obepjatém;"
  },
  {
   "texto": "roucha řeholní a panské hávy"
  },
  {
   "texto": "vlají, trou a míchají se chvatem."
  },
  {
   "texto": "A v té spoustě rozličného kroje"
  },
  {
   "texto": "zrakové zde svítí, hrajou žární,"
  },
  {
   "texto": "jako mušek světlonosných roje"
  },
  {
   "texto": "v lesa větvích jižní nocí jarní."
  },
  {
   "texto": "Uprostřed pak s číší ve pravici"
  },
  {
   "texto": "Verdugův se vznáší rudý zjev"
  },
  {
   "texto": "nad pohárů zlatých blýskavicí,"
  },
  {
   "texto": "v nichžto kypí rudá hroznů krev,"
  },
  {
   "texto": "o sebe ty číše třeskem znějí"
  },
  {
   "texto": "a rty steré ohlušivě hřmějí:"
  },
  {
   "texto": "Vivat Ferdinandus, miles Dei,"
  },
  {
   "texto": "ensis Romae, clypeus fidei!"
  }
 ]
}