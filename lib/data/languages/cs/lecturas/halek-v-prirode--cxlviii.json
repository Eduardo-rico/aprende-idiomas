 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXLVIII."
  },
  {
   "texto": "Stráň pukla v lilie bílé,"
  },
  {
   "texto": "jak když napadne sníh,"
  },
  {
   "texto": "mé duši tak to je milé,"
  },
  {
   "texto": "snad vykvetla mně z nich."
  },
  {
   "texto": "Stráň bílá v lesku se mihá,"
  },
  {
   "texto": "jak nevěsta v svůj den,"
  },
  {
   "texto": "má duše v křídla se zdvihá"
  },
  {
   "texto": "a chce k té stráni ven."
  },
  {
   "texto": "Kol stráně větérek vlaje,"
  },
  {
   "texto": "jak když tam k tanci zvou,"
  },
  {
   "texto": "v mé duši všechno už hraje —"
  },
  {
   "texto": "snad našla družku svou."
  },
  {
   "texto": "My číháme s vražednou zbraní"
  },
  {
   "texto": "blíž mejtiny na lesní lani,"
  },
  {
   "texto": "tu před námi vychází z boru"
  },
  {
   "texto": "tvář za tváří v mladinkém sboru."
  },
  {
   "texto": "Jdou oděni v věnce a kytky,"
  },
  {
   "texto": "v list javorů z nejtenčí nitky,"
  },
  {
   "texto": "jdou vrávorem, od vůně zpití,"
  },
  {
   "texto": "jdou jásotem, do tance, hbití."
  },
  {
   "texto": "Jdou hrajíce, vlajíce pásy,"
  },
  {
   "texto": "jdou, v nápěvu kvetoucí krásy,"
  },
  {
   "texto": "a ten, který v popředí kráčí,"
  },
  {
   "texto": "rty růžové v poháru máčí."
  },
  {
   "texto": "Jdou, kudy jdou, tráva se zvedá,"
  },
  {
   "texto": "pták družku a hnízdo si hledá,"
  },
  {
   "texto": "strom prokoukne v bělounkém květu"
  },
  {
   "texto": "a vůni hned rozdává světu."
  },
  {
   "texto": "Jdou, kudy jdou, všechno se skvěje,"
  },
  {
   "texto": "dech tají se, duše se chvěje —"
  },
  {
   "texto": "nám laňka už zmizela s borem,"
  },
  {
   "texto": "my „Evoe!“ vejskneme sborem."
  },
  {
   "texto": "Tys jak májové to loubí,"
  },
  {
   "texto": "když se v teplé šero skládá,"
  },
  {
   "texto": "a v šum dýchne z nitra, z hloubí —"
  },
  {
   "texto": "duše mladá!"
  },
  {
   "texto": "Každý lístek mluvou jímá,"
  },
  {
   "texto": "plna květů tvá je vnada,"
  },
  {
   "texto": "v tobě zpěv, kdy všecko dřímá —"
  },
  {
   "texto": "duše mladá!"
  },
  {
   "texto": "Vše ti svaté, velikánské,"
  },
  {
   "texto": "a myšlenek skočná řada"
  },
  {
   "texto": "jak ty mušky svatojanské —"
  },
  {
   "texto": "duše mladá!"
  },
  {
   "texto": "Tak jsi divomocná vezdy,"
  },
  {
   "texto": "že tvým touhám nebe střádá"
  },
  {
   "texto": "do klenutí zlaté hvězdy —"
  },
  {
   "texto": "duše mladá!"
  },
  {
   "texto": "Taká jsi, že na tvá slova,"
  },
  {
   "texto": "byť i hasly v poušť a lada,"
  },
  {
   "texto": "světy roznítí se znova —"
  },
  {
   "texto": "duše mladá!"
  },
  {
   "texto": "Les se mračí večerem."
  },
  {
   "texto": "Snědý pasák do ohníčku"
  },
  {
   "texto": "tká si báj o bílém líčku"
  },
  {
   "texto": "s modrým oka zášerem."
  },
  {
   "texto": "Co ten život? K stínům stín,"
  },
  {
   "texto": "těžký, němý v duši sáhne,"
  },
  {
   "texto": "jako z jedlí když se táhne"
  },
  {
   "texto": "neproniklý lesů klín."
  },
  {
   "texto": "Co ten život? Černý háj,"
  },
  {
   "texto": "jenom jedna bříza milá"
  },
  {
   "texto": "z toho temna poskočila —"
  },
  {
   "texto": "pod okno co bílá máj."
  },
  {
   "texto": "Poskočil s ní k nebi blíž."
  },
  {
   "texto": "Srdce v mládí sladkém hřmotu"
  },
  {
   "texto": "za cinkotu, za šumotu"
  },
  {
   "texto": "poskočilo ještě výš."
  },
  {
   "texto": "A teď po všem. Bílá máj"
  },
  {
   "texto": "v ohni praská, v dým se loučí,"
  },
  {
   "texto": "dým se ztrácí ve kotouči —"
  },
  {
   "texto": "co ten život? Dým a báj."
  }
 ]
}