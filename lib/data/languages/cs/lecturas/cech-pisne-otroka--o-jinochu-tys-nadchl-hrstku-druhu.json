 "parrafos": [
  {
   "texto": "Ó jinochu, tys nadchl hrstku druhů…"
  },
  {
   "texto": "Ó jinochu, tys nadchl hrstku druhů,"
  },
  {
   "texto": "by vzepřela se hrdě strážcům svým,"
  },
  {
   "texto": "dlaň povysmekla z železného kruhu"
  },
  {
   "texto": "a trapičovi zahrozila jím;"
  },
  {
   "texto": "leč pán tu zařval: „Kate, měj se k dílu,"
  },
  {
   "texto": "by ohromil vše rabstvo bledý strach!“"
  },
  {
   "texto": "Moc jeho snadno zlomila tvou sílu"
  },
  {
   "texto": "a pod mečem tvá hlava klesla v prach."
  },
  {
   "texto": "Teď na tvém pustém hrobě pod čekanem"
  },
  {
   "texto": "rab šedý káže moudrou rozvahu:"
  },
  {
   "texto": "„Hle, smrtí potupnou ve květu ranném"
  },
  {
   "texto": "zde za šílenou pykal odvahu,"
  },
  {
   "texto": "tam jeho druhů zástup hustou mříží"
  },
  {
   "texto": "rve darmo, v temných slujích vadne chor,"
  },
  {
   "texto": "a všem nám jařma zdvojeného tíži"
  },
  {
   "texto": "vrh’ na šíje ten pošetilý vzdor.“"
  },
  {
   "texto": "Já volám však: Ó mučenníku juný,"
  },
  {
   "texto": "jak hvězda jitřní v naše temno zař!"
  },
  {
   "texto": "Ty mladá otrokyně, v lesku luny"
  },
  {
   "texto": "hrob jeho kvítím nejsličnějším dař;"
  },
  {
   "texto": "však slzami jej nepokrápěj bolu,"
  },
  {
   "texto": "že ztratila jsi těchu jedinou —"
  },
  {
   "texto": "plač hrdostí, ty šťastná v děvic kolu,"
  },
  {
   "texto": "že milována byla’s hrdinou!"
  },
  {
   "texto": "On žití okov střás, host jiných luhů,"
  },
  {
   "texto": "kde slunce věčné volnosti se skví,"
  },
  {
   "texto": "smrt jeho vítězstvím. A sudba druhů"
  },
  {
   "texto": "zda horší jest než naše otroctví?"
  },
  {
   "texto": "My v širším jenom žijem’ ve žaláři,"
  },
  {
   "texto": "a lepší podzemní jich temný kout:"
  },
  {
   "texto": "My pouta nesem’ v plné slunce záři"
  },
  {
   "texto": "a k tomu ještě hanbu, těžší pout."
  },
  {
   "texto": "Vidím snahy roztříštěné,"
  },
  {
   "texto": "slyším hesel pustou směs,"
  },
  {
   "texto": "duchů proud se různo žene,"
  },
  {
   "texto": "smetá dnes, co včera vznes’,"
  },
  {
   "texto": "každý hlásá nové zvěsti,"
  },
  {
   "texto": "každý jiné dráhy klestí,"
  },
  {
   "texto": "každým jitrem nový vůdce"
  },
  {
   "texto": "vstává s rušnou družinou —"
  },
  {
   "texto": "kéž by raděj’ všechny ruce"
  },
  {
   "texto": "v houšť se shlukly družně spjatou"
  },
  {
   "texto": "za velikou, za všem svatou,"
  },
  {
   "texto": "za myšlénku jedinou!"
  },
  {
   "texto": "Slyším rozlícenou vádu"
  },
  {
   "texto": "o svobody podstatě,"
  },
  {
   "texto": "a budoucím lidstva řádu"
  },
  {
   "texto": "po křivd mrzkých rozvratě,"
  },
  {
   "texto": "zatím co nás všechny kruší"
  },
  {
   "texto": "dále jho den ke dni tužší,"
  },
  {
   "texto": "na vše naše práva pline"
  },
  {
   "texto": "a v nás deptá lidskou čest —"
  },
  {
   "texto": "Mlčte, všechny snahy jiné,"
  },
  {
   "texto": "před tou jednou, nejdávnější,"
  },
  {
   "texto": "nejnutnější, nejhlavnější:"
  },
  {
   "texto": "nejprv z jařma šíji vznést!"
  },
  {
   "texto": "Když se probral z omráčení"
  },
  {
   "texto": "ujařmený vrahem děd,"
  },
  {
   "texto": "v prvním hlavy povztyčení"
  },
  {
   "texto": "k této hvězdě upjal hled,"
  },
  {
   "texto": "k ní se našich otců zraky"
  },
  {
   "texto": "stále pjaly skrze mraky,"
  },
  {
   "texto": "z dětství všecko naše snění"
  },
  {
   "texto": "prozařoval její svit —"
  },
  {
   "texto": "má-liž jiných světel chvění,"
  },
  {
   "texto": "bludiček rej kolotavý"
  },
  {
   "texto": "jediný ten maják pravý"
  },
  {
   "texto": "naší spásy zaclonit?"
  },
  {
   "texto": "Nejprv proti škůdců tlaku"
  },
  {
   "texto": "všech se svorně vzepni šij,"
  },
  {
   "texto": "v jednom hustém, burném mraku"
  },
  {
   "texto": "všech nás hněv a vzdor se slij,"
  },
  {
   "texto": "v jeden příboj srazme plece"
  },
  {
   "texto": "zlomit pruty rabské klece,"
  },
  {
   "texto": "a když v odpoutané síle"
  },
  {
   "texto": "v náruč stisknem Svobodu,"
  },
  {
   "texto": "potom pravá bude chvíle"
  },
  {
   "texto": "přemýšlet a řešit, sníti,"
  },
  {
   "texto": "kterak dál ku světu jíti"
  },
  {
   "texto": "v řadě volných národů."
  }
 ]
