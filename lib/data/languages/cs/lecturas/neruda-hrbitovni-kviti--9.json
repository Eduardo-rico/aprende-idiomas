 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "9"
  },
  {
   "texto": "Za mřížemi rovy v stejné řadě,"
  },
  {
   "texto": "perly na šňůře jak nehezké,"
  },
  {
   "texto": "a snad skutečně to uložené"
  },
  {
   "texto": "perly pro království nebeské."
  },
  {
   "texto": "Pak by mříže kolem hrobů byly"
  },
  {
   "texto": "řešato dle mého mínění,"
  },
  {
   "texto": "aby perel dle jich velikosti"
  },
  {
   "texto": "lehčejší kdys bylo dělení."
  },
  {
   "texto": "Tichý růvek leží pozapadlý,"
  },
  {
   "texto": "vůkol země suchá juž se zbořila:"
  },
  {
   "texto": "dávno rakev spadla na trup zvadlý,"
  },
  {
   "texto": "dávno země trup ten v popel změnila."
  },
  {
   "texto": "Oj tu hádě na tré rozdělené -"
  },
  {
   "texto": "zdrhlé věčnosti znak v zem se potácí;"
  },
  {
   "texto": "tu zas dřevo kříže opuchřené"
  },
  {
   "texto": "divže mrtvých juž se dechem neskácí."
  },
  {
   "texto": "Splítej lýkem hebkým kvítí ladné, -"
  },
  {
   "texto": "sotva pouvážeš, kvítka zpráchněla -"
  },
  {
   "texto": "Věčnost! Víra! - Věnec zdaž nezvadne,"
  },
  {
   "texto": "kterýž spletla nám zde ruka umělá?"
  },
  {
   "texto": "Souhvězdí nás vede jedno luzné"
  },
  {
   "texto": "po života různolící planině;"
  },
  {
   "texto": "blahýs, poutče, bludičky co svůzné"
  },
  {
   "texto": "konečně-li s tebou v jámě nezhyne."
  },
  {
   "texto": "Na hřbitově drobné hoše"
  },
  {
   "texto": "za maminkou prozpěvuje,"
  },
  {
   "texto": "bezstarostně po náhrobcích"
  },
  {
   "texto": "lehkou nohou poskakuje."
  },
  {
   "texto": "„Ó zlé dítě, slezeš dolů?!"
  },
  {
   "texto": "Nech ty v pánu dřímající,"
  },
  {
   "texto": "ať nepřijdou v noci k loži"
  },
  {
   "texto": "dusiti tě nebožtíci!“"
  },
  {
   "texto": "Hoše slouchá poděsené,"
  },
  {
   "texto": "bázlivě se vůkol zhlíží,"
  },
  {
   "texto": "po trávníku opatrně"
  },
  {
   "texto": "za maminkou dál se plíží. -"
  },
  {
   "texto": "Pověry ty lidu svaté,"
  },
  {
   "texto": "jsou to myslí pouhé vidy?"
  },
  {
   "texto": "Či snad uctivost to k zašlým? -"
  },
  {
   "texto": "Nebo pocit vlastní bídy?"
  },
  {
   "texto": "Stojí ostrov pustý pokraj moře,"
  },
  {
   "texto": "na něm v hrobech otců dávné mravy,"
  },
  {
   "texto": "bouřná vlna časů každodenně"
  },
  {
   "texto": "hrob z nich jeden v bezdné lůno splaví."
  },
  {
   "texto": "Kolem hrobů pestrá moudrost otců,"
  },
  {
   "texto": "pestří opeřenci polétají,"
  },
  {
   "texto": "a ty runy po náhrobcích lidem"
  },
  {
   "texto": "celý svět a celou dobu tají."
  },
  {
   "texto": "Ve kostnici věkem oplísnělé"
  },
  {
   "texto": "myšlénky se zbledlé ubytují, - -"
  },
  {
   "texto": "ba se schovávají, že jich ztráty -"
  },
  {
   "texto": "a to právem - vnuci nelitují."
  }
 ]
}