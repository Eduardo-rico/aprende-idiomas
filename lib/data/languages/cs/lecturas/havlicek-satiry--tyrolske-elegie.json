 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "1"
  },
  {
   "texto": "Sviť, měsíčku, polehoučku"
  },
  {
   "texto": "skrz ten hustý mrak,"
  },
  {
   "texto": "jakpak se ti Brixen líbí? —"
  },
  {
   "texto": "Neškareď se tak!"
  },
  {
   "texto": "Nepospíchej, pozastav se,"
  },
  {
   "texto": "nechoď ještě spat:"
  },
  {
   "texto": "abych s tebou jen chvilinku mohl"
  },
  {
   "texto": "diškutýrovat."
  },
  {
   "texto": "Nejsem zdejší, můj měsíčku!"
  },
  {
   "texto": "toť znáš podle křiku:"
  },
  {
   "texto": "neutíkej, nejsem treu und bieder,"
  },
  {
   "texto": "jsem zde jen ve cviku."
  },
  {
   "texto": "2"
  },
  {
   "texto": "Jsemť já z kraje muzikantů,"
  },
  {
   "texto": "na pozoun jsem hrál,"
  },
  {
   "texto": "a ten pořád ty vídeňské pány"
  },
  {
   "texto": "ze sna burcoval."
  },
  {
   "texto": "By se po svých těžkých prácech"
  },
  {
   "texto": "hodně vyspali,"
  },
  {
   "texto": "jednou v noci kočár policajtů"
  },
  {
   "texto": "pro mne poslali."
  },
  {
   "texto": "Dvě hodiny po půlnoci —"
  },
  {
   "texto": "když na třetí šlo,"
  },
  {
   "texto": "tu mi dával žandarm u postele"
  },
  {
   "texto": "šťastné dobrýtro."
  },
  {
   "texto": "Se žandarmem slavný ouřad"
  },
  {
   "texto": "celý v parádě,"
  },
  {
   "texto": "pupek kordem pevně obvázaný,"
  },
  {
   "texto": "zlato na krágle."
  },
  {
   "texto": "„Vstávají, pane redaktor!"
  },
  {
   "texto": "nelekají se,"
  },
  {
   "texto": "jdeme v noci, nejsme však zloději,"
  },
  {
   "texto": "jenom komise."
  },
  {
   "texto": "Od všech z Vídně pozdravení,"
  },
  {
   "texto": "pan Bach je líbá,"
  },
  {
   "texto": "jsou-li prej zdráv, a tuhleto psaní"
  },
  {
   "texto": "po nás posílá.“ —"
  },
  {
   "texto": "Já jsem i na lačný život"
  },
  {
   "texto": "vždycky zdvořilý:"
  },
  {
   "texto": "„Odpusť, slavná císařská komise,"
  },
  {
   "texto": "že jsem v košili!“"
  },
  {
   "texto": "Ale Džok, můj černý buldog,"
  },
  {
   "texto": "ten je grobián,"
  },
  {
   "texto": "na habeas corpus tuze zvyklý —"
  },
  {
   "texto": "on je Angličan."
  },
  {
   "texto": "Málem by byl chlap přestoupil"
  },
  {
   "texto": "jeden paragraf,"
  },
  {
   "texto": "již na slavný ouřad zpod postele"
  },
  {
   "texto": "uďál: Vrr! haf! haf!"
  },
  {
   "texto": "Hodil jsem mu tam pod postel"
  },
  {
   "texto": "říšský zákoník,"
  },
  {
   "texto": "dobře že jsem měl ten moudrý nápad,"
  },
  {
   "texto": "již ani nekvík. —"
  },
  {
   "texto": "3"
  },
  {
   "texto": "Občan zvyklý na pořádek —"
  },
  {
   "texto": "bylo to v prosinci —"
  },
  {
   "texto": "především jsem si obul punčochy"
  },
  {
   "texto": "v slavné asistenci."
  },
  {
   "texto": "Pak jsem teprv četl psaní —"
  },
  {
   "texto": "však ho tuhle mám —"
  },
  {
   "texto": "rozumíš-li ouřední němčině,"
  },
  {
   "texto": "přečti si ho sám."
  },
  {
   "texto": "Bach mi píše jako doktor,"
  },
  {
   "texto": "že mi nesvědčí"
  },
  {
   "texto": "v Čechách zdraví, že prej potřebuju"
  },
  {
   "texto": "změnu povětří."
  },
  {
   "texto": "Že je v Čechách tuze dušno,"
  },
  {
   "texto": "horké výpary,"
  },
  {
   "texto": "mnoho smradu po té oktrojírce,"
  },
  {
   "texto": "holé nezdraví!"
  },
  {
   "texto": "Že on tedy schválně pro mne"
  },
  {
   "texto": "kočár sem poslal,"
  },
  {
   "texto": "abych se hned na státní outraty"
  },
  {
   "texto": "na cestu vydal."
  },
  {
   "texto": "A žandarmům že nařídil,"
  },
  {
   "texto": "ať mne hodně nutí,"
  },
  {
   "texto": "kdybych nechtěl ze skromnosti přijmout"
  },
  {
   "texto": "jeho nabídnutí."
  },
  {
   "texto": "4"
  },
  {
   "texto": "Což je dělat? Že pak musím"
  },
  {
   "texto": "hloupý zvyk ten mít:"
  },
  {
   "texto": "že nemohu žandarmům s flintami"
  },
  {
   "texto": "pranic odepřít!"
  },
  {
   "texto": "Dedera mne taky nutil,"
  },
  {
   "texto": "abych jel jen hned,"
  },
  {
   "texto": "že by chtěli Brodští, až se zbudí,"
  },
  {
   "texto": "třeba — s námi jet."
  },
  {
   "texto": "Pravil mi, že nemám s sebou"
  },
  {
   "texto": "zbraně žádné brát,"
  },
  {
   "texto": "neb že oni mají nařízení"
  },
  {
   "texto": "mne ochraňovat."
  },
  {
   "texto": "Že mám též, pokud jsme v Čechách,"
  },
  {
   "texto": "inkognito jet, —"
  },
  {
   "texto": "sic nám dají dotěraví lidé"
  },
  {
   "texto": "hrůzu komis hned."
  },
  {
   "texto": "Ještě mi dal pan Dedera"
  },
  {
   "texto": "více moudrých rad,"
  },
  {
   "texto": "dle nichž se Bachovi pacienti"
  },
  {
   "texto": "mají spravovat."
  },
  {
   "texto": "Tak mne vábil jak Siréna,"
  },
  {
   "texto": "až jsem obul boty,"
  },
  {
   "texto": "oblík vestu, kabát, pak i kožich —"
  },
  {
   "texto": "dříve však kalhoty!"
  },
  {
   "texto": "Koně a žandarmi stáli"
  },
  {
   "texto": "dávno před domem:"
  },
  {
   "texto": "„Milí braši! maličké strpení,"
  },
  {
   "texto": "hned již pojedem!“"
  },
  {
   "texto": "5"
  },
  {
   "texto": "Ó, měsíčku, však ty ženské"
  },
  {
   "texto": "dobře znáš a víš,"
  },
  {
   "texto": "jaký s nimi člověk na tom světě"
  },
  {
   "texto": "často mívá kříž!"
  },
  {
   "texto": "Také’s mnohého loučení"
  },
  {
   "texto": "tajným svědkem byl,"
  },
  {
   "texto": "ty znáš líp než každý novelista"
  },
  {
   "texto": "hořkost těchto chvil."
  },
  {
   "texto": "Matka, žena, sestra, dcerka,"
  },
  {
   "texto": "malá Zdenčinka,"
  },
  {
   "texto": "stály okolo mne v tichém pláči:"
  },
  {
   "texto": "hořká chvilinka!"
  },
  {
   "texto": "Já jsem sice starý kozák,"
  },
  {
   "texto": "v půtkách tužený:"
  },
  {
   "texto": "tenkrát jsem měl trochu těsná prsa"
  },
  {
   "texto": "a zrak zkalený."
  },
  {
   "texto": "Vtisknul jsem však poděbradku"
  },
  {
   "texto": "silně do čela,"
  },
  {
   "texto": "aby se těm policajtům slza"
  },
  {
   "texto": "nezablyštěla."
  },
  {
   "texto": "Neb ti všichni blíže dveří"
  },
  {
   "texto": "posud stáli stráž:"
  },
  {
   "texto": "aby měla tato smutná scéna"
  },
  {
   "texto": "císařskou stafáž!"
  },
  {
   "texto": "6"
  },
  {
   "texto": "Trubka břeští, kola hrčí,"
  },
  {
   "texto": "jedem k Jihlavi,"
  },
  {
   "texto": "vzadu, abysme nic neztratili,"
  },
  {
   "texto": "klušou žandarmi."
  },
  {
   "texto": "Ten borovský kostelíček"
  },
  {
   "texto": "stojí na vršku,"
  },
  {
   "texto": "skrze lesy smutně na mne hleděl:"
  },
  {
   "texto": "„Jsi to, můj hošku?"
  },
  {
   "texto": "Pode mnou jest tvá kolíbka,"
  },
  {
   "texto": "já tě viděl křtít,"
  },
  {
   "texto": "starému vikáři ministrovat,"
  },
  {
   "texto": "pilně se učit."
  },
  {
   "texto": "Táhnout světem na zkušenou,"
  },
  {
   "texto": "pak s pochodní jít,"
  },
  {
   "texto": "naší chase plamenem veselým"
  },
  {
   "texto": "na cestu svítit."
  },
  {
   "texto": "Vidíš, jak ty roky plynou,"
  },
  {
   "texto": "znám tě třicet let:"
  },
  {
   "texto": "ale, chlapče! jaké to obludy"
  },
  {
   "texto": "vidím s tebou jet?“ —"
  },
  {
   "texto": "7"
  },
  {
   "texto": "Když jsme jeli přes Jihlavu,"
  },
  {
   "texto": "měl jsem Špilberk v mysli,"
  },
  {
   "texto": "za Lincem zas myšlenky na Kufstein"
  },
  {
   "texto": "z hlavy mi nevyšly."
  },
  {
   "texto": "Teprva když jsme nechali"
  },
  {
   "texto": "Kufstein vpravo stát,"
  },
  {
   "texto": "začla se mi alpejská krajina"
  },
  {
   "texto": "příjemnější zdát."
  },
  {
   "texto": "Hloupá jízda, milý brachu,"
  },
  {
   "texto": "když se neví kam:"
  },
  {
   "texto": "veselé ty trubky postiljonů"
  },
  {
   "texto": "jsou jen bídný klam."
  },
  {
   "texto": "Všude kolomaz a všude"
  },
  {
   "texto": "přepřahovali:"
  },
  {
   "texto": "kdybyste radš ve Vídni přepřáhli"
  },
  {
   "texto": "a namazali!"
  },
  {
   "texto": "Telegraf je přece jenom"
  },
  {
   "texto": "hezký vynález!"
  },
  {
   "texto": "Ten před námi všude, než jsme přišli,"
  },
  {
   "texto": "ohlášení nes."
  },
  {
   "texto": "By nám mohla policie,"
  },
  {
   "texto": "starostlivá máti,"
  },
  {
   "texto": "všude, dříve než tam přijedeme,"
  },
  {
   "texto": "kamna rozehřáti."
  },
  {
   "texto": "Nesmím ale zapomenout"
  },
  {
   "texto": "Budějovice,"
  },
  {
   "texto": "tam Dedera koupil mělnického"
  },
  {
   "texto": "čtyry lahvice."
  },
  {
   "texto": "Čili se v něm vlastenecké"
  },
  {
   "texto": "hnuly myšlenky?"
  },
  {
   "texto": "Čili doufal, že to pro mne bude"
  },
  {
   "texto": "Lethe na Čechy?"
  },
  {
   "texto": "Mělnické jsem dávno dopil,"
  },
  {
   "texto": "piju vlaské zas;"
  },
  {
   "texto": "ale zdá se, že je v obou stejný"
  },
  {
   "texto": "nepokojný kvas. —"
  },
  {
   "texto": "8"
  },
  {
   "texto": "Teď, měsíčku, nechme elegie"
  },
  {
   "texto": "a přejděme v heroický tón:"
  },
  {
   "texto": "nebo co ti teď chci vypravovat,"
  },
  {
   "texto": "to byl čertův shon."
  },
  {
   "texto": "Cesta z Reichenhallu do Weidringu,"
  },
  {
   "texto": "ty ji musíš taky dobře znát,"
  },
  {
   "texto": "ta se nedá žádnou ordonancí"
  },
  {
   "texto": "přeoktrojovat."
  },
  {
   "texto": "Hory, skály ohromnější ještě,"
  },
  {
   "texto": "než jest hloupost mezi národy,"
  },
  {
   "texto": "vedle cesty propast bezedná jak"
  },
  {
   "texto": "drška armády."
  },
  {
   "texto": "Temná noc jak naše svatá církev"
  },
  {
   "texto": "a my jedem s kopce jako mžik;"
  },
  {
   "texto": "darmo křičí Dedera: „Drž koně!“ —"
  },
  {
   "texto": "prázdný je kozlík."
  },
  {
   "texto": "Kočár praští a koně ve větru,"
  },
  {
   "texto": "již je ďábel horempádem nese,"
  },
  {
   "texto": "a postiljon někde tam za kopcem"
  },
  {
   "texto": "do dýmky si křeše."
  },
  {
   "texto": "Dolů jako s věže cesta plytká,"
  },
  {
   "texto": "vůz jak šipka klouže hý a hat,"
  },
  {
   "texto": "snad má chuť nás někde do propasti"
  },
  {
   "texto": "internýrovat?"
  },
  {
   "texto": "Och! to byla pro mne chutná chvilka!"
  },
  {
   "texto": "neboť neznám žádnou větší slast"
  },
  {
   "texto": "nežli vidět slavnou policii"
  },
  {
   "texto": "ouzkostí se třást!"
  },
  {
   "texto": "Napadnul mi — jsemť já čtenář bible —"
  },
  {
   "texto": "o Jonáši smutný příběh ten,"
  },
  {
   "texto": "jak jej z loďky k utišení bouře"
  },
  {
   "texto": "vyhodili ven."
  },
  {
   "texto": "Metejme los! pravím, mezi námo"
  },
  {
   "texto": "musí někdo velký hříšný být,"
  },
  {
   "texto": "a ten k usmíření nebes musí"
  },
  {
   "texto": "z vozu vyskočit."
  },
  {
   "texto": "Jen to vyřknu, ejhle! policajti"
  },
  {
   "texto": "ani svědomí nezpytovali,"
  },
  {
   "texto": "a kajícně vyrazivše dvířka"
  },
  {
   "texto": "z vozu vyskákali. —"
  },
  {
   "texto": "Ach! ty světe, obrácený světe!"
  },
  {
   "texto": "Vzhůru nohami ve škarpě leží stráž,"
  },
  {
   "texto": "ale s panem delikventem samým"
  },
  {
   "texto": "kluše ekipáž!"
  },
  {
   "texto": "Ach! ty vládo, převrácená vládo!"
  },
  {
   "texto": "národy na šňůrce vodit chceš,"
  },
  {
   "texto": "ale čtyřmi koňmi na opratích"
  },
  {
   "texto": "vládnout nemůžeš! — —"
  },
  {
   "texto": "Bez kočího, bez opratí, potmě,"
  },
  {
   "texto": "u silnice propast místo škarpy:"
  },
  {
   "texto": "tak jsem cválal sám a sám v kočáře"
  },
  {
   "texto": "jako vítr s Alpy."
  },
  {
   "texto": "Svěřiti svůj osud také jednou"
  },
  {
   "texto": "koňům splašeným se já mám bát,"
  },
  {
   "texto": "občan rakouský? Což se mi může"
  },
  {
   "texto": "horšího již stát?"
  },
  {
   "texto": "Tak jsem s chladnou resignací v hlavě,"
  },
  {
   "texto": "v hubě ale vřelou cigáru,"
  },
  {
   "texto": "čerstvěj než cár ruský přijel k poště"
  },
  {
   "texto": "v dobrém rozmaru."
  },
  {
   "texto": "Tam jsem zatím — mustr delikventů! —"
  },
  {
   "texto": "bez ochrany povečeřel hezky,"
  },
  {
   "texto": "než za mnou stráž s odřenými nosy"
  },
  {
   "texto": "přikulhala pěšky."
  },
  {
   "texto": "Já spal dobře, ale policajti"
  },
  {
   "texto": "měli tu noc ve Weidringu zlou,"
  },
  {
   "texto": "mazali si špiritusem záda,"
  },
  {
   "texto": "nosy arnikou."
  },
  {
   "texto": "Tu je konec této epopeje,"
  },
  {
   "texto": "k níž jsem nepřibásnil ani chlup,"
  },
  {
   "texto": "všechno ti dosvědčí ve Weidringu"
  },
  {
   "texto": "postmistr Dahlrupp."
  },
  {
   "texto": "9"
  },
  {
   "texto": "Přijeli jsme do Brixenu"
  },
  {
   "texto": "bez vší turbací,"
  },
  {
   "texto": "krajská vláda dala Dederovi"
  },
  {
   "texto": "na mne kvitancí."
  },
  {
   "texto": "Místo mne ten kus papíru"
  },
  {
   "texto": "vrátili do Čech,"
  },
  {
   "texto": "mne zde černý, dvojhlavý orel"
  },
  {
   "texto": "drží v klepetech."
  },
  {
   "texto": "Krajskou vládu, podkrajského,"
  },
  {
   "texto": "žandarmerii,"
  },
  {
   "texto": "ty mi dali za anděle strážce"
  },
  {
   "texto": "v té Siberii."
  }
 ]
}