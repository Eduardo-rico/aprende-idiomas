 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "II"
  },
  {
   "texto": "Já hnal se pestrým, luzným za motýlem,"
  },
  {
   "texto": "byl samý nach a plný zlaté zdoby -"
  },
  {
   "texto": "však trhám zpět zas zelenou svou sítí:"
  },
  {
   "texto": "kam on mně used, bují tořič - kvítí"
  },
  {
   "texto": "umrlčí hlavy do podoby."
  },
  {
   "texto": "Já vesel hledal sněžnou parnasii,"
  },
  {
   "texto": "má květ tak milý, srdce do obrazu,"
  },
  {
   "texto": "a našel ji - však ruka zpět se veze:"
  },
  {
   "texto": "kol kvítka můra smrtonoška leze,"
  },
  {
   "texto": "s umrlčí lebkou na svém vazu."
  },
  {
   "texto": "Když nad střechou osad se zmítá bouř,"
  },
  {
   "texto": "tu přemnohá svém ve přístěnku"
  },
  {
   "texto": "si zavzdychne dobrácká dušička as:"
  },
  {
   "texto": "„Ta nebohá ptáčata venku!“"
  },
  {
   "texto": "Ach, prosím vás, pražádnou lítost jen!"
  },
  {
   "texto": "Nám, kteří svá nemáme hnízda,"
  },
  {
   "texto": "je nejvolněj, nad námi, pod námi bouř"
  },
  {
   "texto": "když válečnou muziku hvízdá."
  },
  {
   "texto": "Když kolíbá les se jak na vlnách"
  },
  {
   "texto": "a k zemi až shýbá své témě,"
  },
  {
   "texto": "a blesky se třískají o čela skal,"
  },
  {
   "texto": "až třese se kolkolem země."
  },
  {
   "texto": "A urve-li nás to a smete nás"
  },
  {
   "texto": "a rozrazí prsa o kámen -"
  },
  {
   "texto": "bouř zahučí velebný pohřební žalm"
  },
  {
   "texto": "a příroda zavzdychne amen!"
  },
  {
   "texto": "(Motiv dívčí)"
  },
  {
   "texto": "Ty naše hodiny"
  },
  {
   "texto": "jsou jako z rodiny!"
  },
  {
   "texto": "když jsem s hochem bývala,"
  },
  {
   "texto": "koléčka si zpívala,"
  },
  {
   "texto": "repetila cvaky, cvaky -"
  },
  {
   "texto": "když jsme se my políbili,"
  },
  {
   "texto": "koléčka si mlaskla tky."
  },
  {
   "texto": "Ach - hocha odvedli,"
  },
  {
   "texto": "mně tváře pobledly!"
  },
  {
   "texto": "Hodiny teď jdou a jdou"
  },
  {
   "texto": "líně jedna za druhou,"
  },
  {
   "texto": "a koléčka cvaky - cvaky -"
  },
  {
   "texto": "když si vzdychnu na posteli,"
  },
  {
   "texto": "koléčka si vzdychnou taky."
  },
  {
   "texto": "(Motiv italský)"
  },
  {
   "texto": "Kdy láska přilétá?"
  },
  {
   "texto": "Když jaro dýchá pohorách,"
  },
  {
   "texto": "ze země mízu loudí,"
  },
  {
   "texto": "a labuť, jidne zrozená,"
  },
  {
   "texto": "po našich vodách bloudí;"
  },
  {
   "texto": "s břehu když do vln bublavých"
  },
  {
   "texto": "měkounká pomněnka se dívá,"
  },
  {
   "texto": "a lidem vonných za nocí"
  },
  {
   "texto": "v každinké žílce slavík zpívá…"
  },
  {
   "texto": "Kdy láska odlétá?"
  },
  {
   "texto": "Když nad oblaky nahoře"
  },
  {
   "texto": "labuť své mladé volá,"
  },
  {
   "texto": "a dole vítr v strništích"
  },
  {
   "texto": "vzdorná si hvízdá kola;"
  },
  {
   "texto": "v zpáteční vodě pod mlýnem"
  },
  {
   "texto": "když žlutavá se stříže točí,"
  },
  {
   "texto": "a lidem němých za nocí"
  },
  {
   "texto": "i ve snu chladem vlhnou oči…"
  }
 ]
}