{
 "id": "erben-kytice--vestkyne",
 "titulo": "Věštkyně",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/V%C4%9B%C5%A1tkyn%C4%9B",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos).",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 12
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Když oko vaše slzou se zaleje,"
  },
  {
   "texto": "když na vás těžký padne čas,"
  },
  {
   "texto": "tehda přináším větvici naděje,"
  },
  {
   "texto": "tu se můj věští ozve hlas."
  },
  {
   "texto": "Nechtějte vážiti lehce řeči mojí,"
  },
  {
   "texto": "z nebeť přichází věští duch;"
  },
  {
   "texto": "zákon nezbytný ve všem světě stojí"
  },
  {
   "texto": "a vše tu svůj zaplatí dluh."
  },
  {
   "texto": "Řeka si hledá konce svého v moři,"
  },
  {
   "texto": "plamen se k nebi temeni;"
  },
  {
   "texto": "co země stvoří, sama zase zboří:"
  },
  {
   "texto": "avšak nic nejde v zmaření."
  },
  {
   "texto": "Jisté a pevné jsou osudu kroky,"
  },
  {
   "texto": "co má se státi, stane se;"
  },
  {
   "texto": "a co den jeden v své pochová toky,"
  },
  {
   "texto": "druhý zas na svět vynese."
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Viděla jsem muže na Bělině vodě,"
  },
  {
   "texto": "praotce slavných vojvodů,"
  },
  {
   "texto": "an za svým pluhem po dědině chodě,"
  },
  {
   "texto": "vzdělával země úrodu."
  },
  {
   "texto": "Tu přišli poslové od valného sněmu,"
  },
  {
   "texto": "a knížetem jest oráč zván,"
  },
  {
   "texto": "oblekli oděv zlatoskvoucí jemu,"
  },
  {
   "texto": "a nedoorán zůstal lán."
  },
  {
   "texto": "Položil rádlo a propustil voly:"
  },
  {
   "texto": "„Odkud jste vyšli, jděte zpět!“"
  },
  {
   "texto": "a své bodadlo zarazil tu v poli,"
  },
  {
   "texto": "aby pučilo v list i květ."
  },
  {
   "texto": "Pojala voly nedaleká hora —"
  },
  {
   "texto": "podnes ji značí vody rmut;"
  },
  {
   "texto": "a suchá holi lískovice kora"
  },
  {
   "texto": "vydala trojí bujný prut."
  },
  {
   "texto": "A pruty vzkvětly a ovoce nesly:"
  },
  {
   "texto": "leč dospěl jenom jich jeden;"
  },
  {
   "texto": "druhé dva zvadly a ze stromu klesly,"
  },
  {
   "texto": "nevzkřísivše se po ten den."
  },
  {
   "texto": "Slyšte a vězte — nejsouť marné hlasy,"
  },
  {
   "texto": "vložte je pilně na paměť:"
  },
  {
   "texto": "nastane doba, přijdou zase časy,"
  },
  {
   "texto": "kdež obživne i mrtvá sněť."
  },
  {
   "texto": "Obě ty větve v ušlechtilém květu"
  },
  {
   "texto": "vzmohou se šíře, široce"
  },
  {
   "texto": "a nenadále ku podivu světu"
  },
  {
   "texto": "přinesou blahé ovoce."
  },
  {
   "texto": "Tu přijde kníže ve zlatě a nachu,"
  },
  {
   "texto": "aby zaplatil starý dluh,"
  },
  {
   "texto": "a vyndá na svět ze smetí a prachu"
  },
  {
   "texto": "Přemyslův zavržený pluh."
  },
  {
   "texto": "A z duté hory ven povolá voly"
  },
  {
   "texto": "i zase k pluhu přiděje"
  },
  {
   "texto": "a zanedbanou doorá tu roli"
  },
  {
   "texto": "a zlatým zrnem zaseje."
  },
  {
   "texto": "I vzejde setí, jaře bude kvésti,"
  },
  {
   "texto": "bujně se zaskví zlatý klas:"
  },
  {
   "texto": "a s ním i vzejde země této štěstí"
  },
  {
   "texto": "a stará sláva vstane zas."
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Viděla jsem skálu nad řekou se pnoucí,"
  },
  {
   "texto": "na skále Krokův zlatý hrad;"
  },
  {
   "texto": "okolo hradu květnatí palouci —"
  },
  {
   "texto": "kněžny Libuše květný sad."
  },
  {
   "texto": "Pod hradem dole staveníčko milé —"
  },
  {
   "texto": "kněžnina lázeň na řece;"
  },
  {
   "texto": "viděla jsem kněžnu tváři ušlechtilé,"
  },
  {
   "texto": "ve stříbroskvoucím obleče."
  },
  {
   "texto": "Na prahu stála zmilené své lázně,"
  },
  {
   "texto": "patřila v smutný říční proud;"
  },
  {
   "texto": "četla tam slova naděje i bázně:"
  },
  {
   "texto": "své milé země tajný soud."
  },
  {
   "texto": "„Vidím požáry a krvavé boje,"
  },
  {
   "texto": "ostrý meč tebe probode,"
  },
  {
   "texto": "vidím tvou bídu, pohanění tvoje;"
  },
  {
   "texto": "však nezoufej, můj národe!“"
  },
  {
   "texto": "Tu jí dvě panny, stojíce po boku,"
  },
  {
   "texto": "zlatou kolébku podaly;"
  },
  {
   "texto": "políbila ji a v bezedném toku"
  },
  {
   "texto": "ji potopila v podskalí."
  },
  {
   "texto": "Slyšte a vězte slova Libušina —"
  },
  {
   "texto": "já slyšela její věští hlas:"
  },
  {
   "texto": "„Tuto spočívej, lůžko mého syna,"
  },
  {
   "texto": "až povolám tě někdy zas!"
  },
  {
   "texto": "Z temného lůna hlubokého moře"
  },
  {
   "texto": "povstane nový, mladý svět;"
  },
  {
   "texto": "široké lípy v mém otcovském dvoře"
  },
  {
   "texto": "ponesou zase vonný květ."
  },
  {
   "texto": "Smutné osení vzkřísí těžký příval,"
  },
  {
   "texto": "z noci se zrodí jasný den:"
  },
  {
   "texto": "a národ, kterýž prve slavný býval,"
  },
  {
   "texto": "ten bude opět oslaven."
  },
  {
   "texto": "Tehda na světlo ze propasti řeky"
  },
  {
   "texto": "zlatá kolébka vyplyne,"
  },
  {
   "texto": "a země spása, souzená před věky,"
  },
  {
   "texto": "na ní co dítko spočine.“"
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Viděla jsem tebe, lůžko blahosvaté,"
  },
  {
   "texto": "znám tebe již, má hvězdo, znám,"
  },
  {
   "texto": "však to mi ještě klidnou mysl mate,"
  },
  {
   "texto": "kdy tebe opět uhlídám."
  },
  {
   "texto": "Léto za letem bez ustání běží,"
  },
  {
   "texto": "zima za zimou uhání:"
  },
  {
   "texto": "důvěra má však nepohnutě leží"
  },
  {
   "texto": "a co rok roste doufání."
  },
  {
   "texto": "Když pak se létě z hloubi pod skalinou"
  },
  {
   "texto": "nejeden nenavrátí zpět"
  },
  {
   "texto": "a když se zimě s veselou družinou"
  },
  {
   "texto": "prolomí pod saněmi led,"
  },
  {
   "texto": "vzdychávám: Ejhle, k pluku Libušinu"
  },
  {
   "texto": "přibylo nových oudů zas!"
  },
  {
   "texto": "Kdy přijde doba, kdež si odpočinu?"
  },
  {
   "texto": "Ach ještě není, není čas!"
  },
  {
   "texto": "Neb takto v knihách osudu je psáno,"
  },
  {
   "texto": "slyšte a vězte moji zvěst:"
  },
  {
   "texto": "Až bude svítat ono blahé ráno,"
  },
  {
   "texto": "vstanou i mrtví v jeho čest."
  },
  {
   "texto": "Tehda Libuše u velikém pluku"
  },
  {
   "texto": "své vojsko vodní postaví,"
  },
  {
   "texto": "a vzhůru zvednouc mateřskou svou ruku,"
  },
  {
   "texto": "svůj národ český oslaví!“"
  },
  {
   "texto": "Viděla jsem kostel nad Orlicí řekou,"
  },
  {
   "texto": "slyšela jsem jeho zlatý zvon,"
  },
  {
   "texto": "prv než upřímnost českou starověkou"
  },
  {
   "texto": "rozerval lítých vášní shon."
  },
  {
   "texto": "Když pak utuchly v Čechách boží ctnosti:"
  },
  {
   "texto": "víra i láska s nadějí,"
  },
  {
   "texto": "ukryl se kostel v země hlubokosti"
  },
  {
   "texto": "a vody místo stápějí."
  },
  {
   "texto": "Však nezůstane věky věkův v hrobě:"
  },
  {
   "texto": "odtekouť jednou vody zas,"
  },
  {
   "texto": "i vstane kostel v bývalé ozdobě"
  },
  {
   "texto": "a zazní slavně zvonu hlas."
  },
  {
   "texto": "Slyšte a vězte, takto stojí psáno,"
  },
  {
   "texto": "tak uloženo v osudí:"
  },
  {
   "texto": "„Tehdáž uzříte zlatých časů ráno,"
  },
  {
   "texto": "až zlatý zvon je probudí."
  },
  {
   "texto": "Až z oné strany nad Orlici řeku"
  },
  {
   "texto": "nový les vítr zaseje,"
  },
  {
   "texto": "až mlází vzroste, až i svého věku"
  },
  {
   "texto": "boroví toto dospěje"
  },
  {
   "texto": "a toho lesa krajní borovice"
  },
  {
   "texto": "až sama sebou dožije,"
  },
  {
   "texto": "uschne a zetlíc padne do Orlice,"
  },
  {
   "texto": "a již i kořen vyhnije:"
  },
  {
   "texto": "I tehdáž vyryje přijdouc divá svině"
  },
  {
   "texto": "poslední zbytky na průhon,"
  },
  {
   "texto": "a tu pod nimi z rumu v rozvalině"
  },
  {
   "texto": "zjeví se zase zlatý zvon."
  },
  {
   "texto": "Neb tak určeno již od první chvíle:"
  },
  {
   "texto": "by v podzemní se vydal pouť"
  },
  {
   "texto": "a ve svůj čas že vytčeného cíle"
  },
  {
   "texto": "za řekou musí dosáhnouť.“ —"
  },
  {
   "texto": "Vězte, na stráni pod zeleným borem"
  },
  {
   "texto": "kmen souzený již dozrává:"
  },
  {
   "texto": "vysoký, mocný, beze větví skorém,"
  },
  {
   "texto": "jen vršek čerstvý zůstává."
  },
  {
   "texto": "Zdali zvon také již je na své pouti?"
  },
  {
   "texto": "Zdali včas cíle dospěje?"
  },
  {
   "texto": "Kdo zprávy jisté může poskytnouti"
  },
  {
   "texto": "a posíliti naděje?"
  },
  {
   "texto": "Aj, viděla jsem, an tu sedlák oře"
  },
  {
   "texto": "na poli blíže Bystřice,"
  },
  {
   "texto": "svou ranní píseň zpívaje v pokoře:"
  },
  {
   "texto": "„Ó bože, svatá Trojice!“"
  },
  {
   "texto": "Tu divný odpor orání překazil,"
  },
  {
   "texto": "z brázdy se vymklo ruchadlo:"
  },
  {
   "texto": "„Ký ďábel z pekla mi tu co přimrazil?"
  },
  {
   "texto": "Bodejž se i s ním propadlo!“"
  },
  {
   "texto": "Tak oráč zaklel, a do prohlubení"
  },
  {
   "texto": "zapadal pronikavý hlas —"
  },
  {
   "texto": "zlatého zvonu žalostné zaznění:"
  },
  {
   "texto": "„Ach ještě není, není čas!“"
  },
  {
   "texto": "Ach ještě není, ještě čas tu není,"
  },
  {
   "texto": "však přichyl ucho k zemi blíž"
  },
  {
   "texto": "a pod kořeny jedle z dáli znění"
  },
  {
   "texto": "zlatého zvonu uslyšíš."
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Nenaříkejte, neštěstí a osud"
  },
  {
   "texto": "že vás tak tvrdě potkaly,"
  },
  {
   "texto": "však naříkejte, že jste jimi posud"
  },
  {
   "texto": "rozumnější se nestali!"
  },
  {
   "texto": "Aj, vidím hóru nad jiné zvýšenou —"
  },
  {
   "texto": "hora ta dobře známa vám —"
  },
  {
   "texto": "bujnými sady kolem otočenou,"
  },
  {
   "texto": "a na té hoře boží chrám."
  },
  {
   "texto": "Avšak do chrámu branou chodí trojí"
  },
  {
   "texto": "a trojí vycházejí zas;"
  },
  {
   "texto": "slyšte a vězte, toto psáno stojí,"
  },
  {
   "texto": "a v srdci složte věští hlas:"
  },
  {
   "texto": "„Darmo nadějí kojíte se planou,"
  },
  {
   "texto": "nezbudete svých psot a bíd,"
  },
  {
   "texto": "dokavad jednou chodívati branou"
  },
  {
   "texto": "nebude tvrdý český lid!“"
  },
  {
   "texto": "Kdos uši dostal, abyjima slyšel,"
  },
  {
   "texto": "proč si je palcem zacpáváš?"
  },
  {
   "texto": "A komu rozum z vysokosti přišel,"
  },
  {
   "texto": "proč po něm nohou šlapáváš?"
  },
  {
   "texto": "Tisíc let ušlo, co své milé syny"
  },
  {
   "texto": "svornosti učil Svatopluk,"
  },
  {
   "texto": "však neproniknul dotud, do hodiny,"
  },
  {
   "texto": "moudrého slova zlatý zvuk!"
  },
  {
   "texto": "— — —"
  },
  {
   "texto": "Vy, kdo znajíce otcův slavné činy,"
  },
  {
   "texto": "jimi se rádi chlubíte;"
  },
  {
   "texto": "tam na pilíři v Praze půl hrdiny"
  },
  {
   "texto": "u mostu státi spatříte."
  },
  {
   "texto": "Hlava zvětrala i spláchly ji deště"
  },
  {
   "texto": "a prsa rozbil švédský boj;"
  },
  {
   "texto": "než břich a nohy stojí potud ještě,"
  },
  {
   "texto": "i pošetilé pýchy stroj."
  },
  {
   "texto": "Nemluvte marně: „Starobylých věků"
  },
  {
   "texto": "zpukřelé, vetché kamení!“"
  },
  {
   "texto": "Vězte, že toto dnešních vašich reků"
  },
  {
   "texto": "osudné jesti znamení!"
  },
  {
   "texto": "Slyšte a pilně važte moje slova:"
  },
  {
   "texto": "S nadějí nic se nenoste,"
  },
  {
   "texto": "leč nad tím břichem vřelé srdce znova"
  },
  {
   "texto": "a pravá hlava naroste!"
  }
 ]
}