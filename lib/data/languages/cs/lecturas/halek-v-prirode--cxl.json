 "parrafos": [
  {
   "texto": "CXL."
  },
  {
   "texto": "Na nebi mají na pilno:"
  },
  {
   "texto": "tam jakás ruka mráčky stírá,"
  },
  {
   "texto": "oblohu hladí na modro,"
  },
  {
   "texto": "a pak ji v hvězdy otevírá."
  },
  {
   "texto": "Na zemi mají na pilno:"
  },
  {
   "texto": "tu jakás ruka vlnky sbírá,"
  },
  {
   "texto": "ukládá lesům mlčení"
  },
  {
   "texto": "a pak je v písně zotevírá."
  },
  {
   "texto": "A teď tak v světě průhledno,"
  },
  {
   "texto": "že paprsky jak za dne chodí,"
  },
  {
   "texto": "že zlaté hvězdic puntíčky"
  },
  {
   "texto": "v nesmírném modru vojevodí."
  },
  {
   "texto": "Teď tak je v světě průhlasno,"
  },
  {
   "texto": "že slyšet nejjemnější hlásky,"
  },
  {
   "texto": "že vod a hájů myšlénky"
  },
  {
   "texto": "jdou jako svatá mluva lásky."
  },
  {
   "texto": "Dnes tak je, že v hor temena"
  },
  {
   "texto": "se ruka klade měkce milá,"
  },
  {
   "texto": "rty červánkové šeptem dí:"
  },
  {
   "texto": "„Dnes jsem vám večer upravila!“"
  },
  {
   "texto": "By kvítka uměla mluvit,"
  },
  {
   "texto": "což byl by hovorný svět!"
  },
  {
   "texto": "A kvítka mluví tak ráda,"
  },
  {
   "texto": "jen třeba též porozumět."
  },
  {
   "texto": "Ba kvítka jediný hovor:"
  },
  {
   "texto": "jen kývne zelená snět,"
  },
  {
   "texto": "tu hned i ptáčkové počnou,"
  },
  {
   "texto": "pak v hovoru celičký svět."
  },
  {
   "texto": "Toť hovor líbezně sladký,"
  },
  {
   "texto": "k nim tíhne duše mé klid:"
  },
  {
   "texto": "to v kvítka se rozdrobí nebe"
  },
  {
   "texto": "a jde si k nám pohovořit."
  },
  {
   "texto": "Ptačími ústy, okem poupat"
  },
  {
   "texto": "když promluvil a mrkal svět —"
  },
  {
   "texto": "šel větřík jak turecký sultán"
  },
  {
   "texto": "a líbal každou mladou snět."
  },
  {
   "texto": "A snad že podnapil se vůní,"
  },
  {
   "texto": "od polí k lesům vrávorá,"
  },
  {
   "texto": "na polích dupne si jak šuhaj"
  },
  {
   "texto": "a lesům vejskne do dvora."
  },
  {
   "texto": "Tam teplou rozjařený vlahou"
  },
  {
   "texto": "verš kuje v pěkné rozměře —"
  },
  {
   "texto": "jej básnil své na poctu růži,"
  },
  {
   "texto": "teď hvízdá jej tam do keře."
  },
  {
   "texto": "A růže v keři uzardělá"
  },
  {
   "texto": "poslouchá v duši napjata:"
  },
  {
   "texto": "„Ty krásná růže, srdce dej mi,"
  },
  {
   "texto": "já dám ti za ně poupata.“"
  },
  {
   "texto": "A co jak se dálo dále,"
  },
  {
   "texto": "to na vážky my nebéřem;"
  },
  {
   "texto": "však ráno prý ho našly včelky,"
  },
  {
   "texto": "to spal tam ještě pod keřem."
  },
  {
   "texto": "Mezi dva tenké buky"
  },
  {
   "texto": "natáhnul pavouk nit,"
  },
  {
   "texto": "zval mladé, staré mouchy"
  },
  {
   "texto": "a chtěl se pochlubit."
  },
  {
   "texto": "Chodil jak po provaze,"
  },
  {
   "texto": "jak paňác, s kuráží,"
  },
  {
   "texto": "pak zase krokem vážným,"
  },
  {
   "texto": "jak voják na stráži."
  },
  {
   "texto": "A volal: „Tuto nitku"
  },
  {
   "texto": "hle ryze stříbrnu!“"
  },
  {
   "texto": "Hned s ní se pustil dolů"
  },
  {
   "texto": "a chodil po drnu."
  },
  {
   "texto": "To byla podívaná,"
  },
  {
   "texto": "byl tu, byl nahoře,"
  },
  {
   "texto": "a volal: „Panny mouchy,"
  },
  {
   "texto": "tu jsem v své komoře!“"
  },
  {
   "texto": "A byla podívaná,"
  },
  {
   "texto": "jaký to svůdný rek:"
  },
  {
   "texto": "šla každá moucha za ním,"
  },
  {
   "texto": "ni jedna nazpátek."
  }
 ]
}