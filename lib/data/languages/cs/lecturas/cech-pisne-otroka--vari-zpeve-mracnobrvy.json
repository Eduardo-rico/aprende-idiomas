 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Vari, Zpěve mračnobrvý!"
  },
  {
   "texto": "Již se tvá mi hnusí zvěst,"
  },
  {
   "texto": "v nížto s prachem, slzou, krví"
  },
  {
   "texto": "smíšen pouta chřest."
  },
  {
   "texto": "Co je mi vůkol po rmutné vřavě,"
  },
  {
   "texto": "po všedním znoji, okovech mých —"
  },
  {
   "texto": "podoba světlá blíží se smavě,"
  },
  {
   "texto": "pouta skřek mění v hrdliček smích,"
  },
  {
   "texto": "věnčí mne snění makovou řásní,"
  },
  {
   "texto": "skutečna trudy směňuje básní,"
  },
  {
   "texto": "vznáší mne v éther z otrockých lích."
  },
  {
   "texto": "Zde jsem volný v modru šírém,"
  },
  {
   "texto": "hluboko se tratí zem,"
  },
  {
   "texto": "a hluk pustý s vášní vírem"
  },
  {
   "texto": "nedoniká sem."
  },
  {
   "texto": "Vzdušná tu říše vidin a zdání,"
  },
  {
   "texto": "nehmotných zjevů tajemný ruch,"
  },
  {
   "texto": "žádný tu okov nepoutá vlání"
  },
  {
   "texto": "větrných postav, nadzemských tuch,"
  },
  {
   "texto": "v nesmírno dumy peruť se šíří,"
  },
  {
   "texto": "v zoři krás věčných skví se a pýří —"
  },
  {
   "texto": "tělo nechť v poutech, králem je duch!"
  },
  {
   "texto": "Jenom kyne a již vítá"
  },
  {
   "texto": "vábnější mne sad"
  },
  {
   "texto": "nežli ten, kde z růží svítá"
  },
  {
   "texto": "velmogulův hrad."
  },
  {
   "texto": "V rozkošné síně jímá vše valem"
  },
  {
   "texto": "báječných svlačců lehounký vzmach,"
  },
  {
   "texto": "zaplétá v obří vějíře palem"
  },
  {
   "texto": "kalichů skvostných azur a nach,"
  },
  {
   "texto": "vlétajíc k nebi vzduchem se blýští"
  },
  {
   "texto": "stříbrná vláha, pádem se tříští"
  },
  {
   "texto": "o stupňů mramor v duhový prach."
  },
  {
   "texto": "Z vonného pak stínů přítmí"
  },
  {
   "texto": "roucho vlaje pavučí,"
  },
  {
   "texto": "nožky zvoní v ladné rytmy"
  },
  {
   "texto": "zlatou obručí,"
  },
  {
   "texto": "v kadeří noci nad lunou skrání"
  },
  {
   "texto": "kmitá se věncem světlušek plam,"
  },
  {
   "texto": "na ňadrech v roušky průsvitné vlání"
  },
  {
   "texto": "nejdražší hoří Golkondy klam,"
  },
  {
   "texto": "krásněj’ však ještě pod řasou stinnou"
  },
  {
   "texto": "líbezná světla září a kynou"
  },
  {
   "texto": "v úsměvu věčném k milostným hrám."
  },
  {
   "texto": "Zdvihám náruč s blahým vzlykem,"
  },
  {
   "texto": "zdvihám ruce — ký to třesk?"
  },
  {
   "texto": "Zařinklo mé pouto — Mžikem"
  },
  {
   "texto": "prchá vděk i lesk."
  },
  {
   "texto": "Kolem též řinčí okovy druhů,"
  },
  {
   "texto": "pod bičem sténá rodná tu krev,"
  },
  {
   "texto": "trhá mne dolů s oblačných luhů,"
  },
  {
   "texto": "rozkoš se mění v bolest a hněv;"
  },
  {
   "texto": "na místo písní krásy a něhy"
  },
  {
   "texto": "bouří zas nitrem pod katů šlehy"
  },
  {
   "texto": "nářku a pomsty divoký zpěv!"
  }
 ]
}