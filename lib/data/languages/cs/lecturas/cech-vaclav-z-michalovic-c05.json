{
 "id": "cech-vaclav-z-michalovic-c05",
 "titulo": "Zpěv čtvrtý",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V%C3%A1clav_z_Michalovic/Zp%C4%9Bv_%C4%8Dtvrt%C3%BD",
 "fuente": "cs.wikisource.org, «Václav z Michalovic»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-vaclav-z-michalovic",
  "titulo": "Václav z Michalovic",
  "orden": 5
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "V salvatorském chrámě husté chmury"
  },
  {
   "texto": "večer pozdní rozestírá kolem"
  },
  {
   "texto": "v ambitách pod vysokými kůry,"
  },
  {
   "texto": "mezi četných sloupů mocným stvolem"
  },
  {
   "texto": "a jak mračno tajůplné s hůry"
  },
  {
   "texto": "pod závratnou klenbou temno visí,"
  },
  {
   "texto": "v němž jen zvolna odlišuje zrak"
  },
  {
   "texto": "v zadu varhan obrovitých rysy"
  },
  {
   "texto": "jako v temné chmuře tmavší mrak,"
  },
  {
   "texto": "nahoře pak slabě hledí jen"
  },
  {
   "texto": "čtverce nízkých oken ze tmy čiré,"
  },
  {
   "texto": "jejichž řadou těsnou ověnčen"
  },
  {
   "texto": "kupole je základ šíroširé."
  },
  {
   "texto": "Venku bouře. Blesku vzplanutí"
  },
  {
   "texto": "okna v ochozech zažíhá časem"
  },
  {
   "texto": "a svým siným, pronikavým jasem"
  },
  {
   "texto": "hlavy sloupů, žebra klenutí,"
  },
  {
   "texto": "soch a maleb vidma děsivá"
  },
  {
   "texto": "na mžik temnu z loktů vyrývá,"
  },
  {
   "texto": "okna kuple v náhlém nítí plamu"
  },
  {
   "texto": "jak pás žhavých siných drahokamů."
  },
  {
   "texto": "V zápětí ráz hromu… Blíž se valí"
  },
  {
   "texto": "temný hřmot jak obrovského vozu"
  },
  {
   "texto": "kola těžká přes úporné skalí"
  },
  {
   "texto": "ohlušivém, děsném ve hlomozu,"
  },
  {
   "texto": "a teď mníš, že burným kolesem"
  },
  {
   "texto": "již již středem kostela se řítí,"
  },
  {
   "texto": "okna řinčí prudkým otřesem"
  },
  {
   "texto": "a chrám do základů zdá se chvíti;"
  },
  {
   "texto": "však již dále do kraje se valí"
  },
  {
   "texto": "se slábnoucím zvolna rachotem,"
  },
  {
   "texto": "až jak zloba utlumená v dáli"
  },
  {
   "texto": "zmírá temným, hluchým ropotem."
  },
  {
   "texto": "Na klekátko dvojí tamo kles’"
  },
  {
   "texto": "Václav s Konradem v tu tesknou chvíli."
  },
  {
   "texto": "Od rána-tě novicové dnes"
  },
  {
   "texto": "po dvou k tiché adorací pílí"
  },
  {
   "texto": "před oltář, kde v řadách svící plane"
  },
  {
   "texto": "monstrance aj! krásy nevídané."
  },
  {
   "texto": "Plesajíc, že zlomen odboj lítý"
  },
  {
   "texto": "proti víře, císařskému trůnu"
  },
  {
   "texto": "a ten kacířský lid vzdorovitý"
  },
  {
   "texto": "vrácen církve samospasné lůnu, —"
  },
  {
   "texto": "panstvo domácí a cizokrajné,"
  },
  {
   "texto": "dosáhší zde hodností a statků,"
  },
  {
   "texto": "ve chrám jesuitský na památku"
  },
  {
   "texto": "monstranc věnovalo ceny bájné."
  },
  {
   "texto": "V pokladnice ruka pánů štědrá"
  },
  {
   "texto": "do stříbra i zlata hloubně sáhla,"
  },
  {
   "texto": "s šíjí sňala řetěz, pásy s bedra,"
  },
  {
   "texto": "ba i snubní prsten s prstů stáhla;"
  },
  {
   "texto": "paní kamů různobarvých žár"
  },
  {
   "texto": "vysypaly z klenotní své skřínky,"
  },
  {
   "texto": "s čela braly stříbrné své vínky,"
  },
  {
   "texto": "s ňader vábných sponky zlatý spár;"
  },
  {
   "texto": "nevěsty pak svatební své šaty"
  },
  {
   "texto": "přinášely v oběť zbožným citem,"
  },
  {
   "texto": "v jejichž přízi nesčetný květ zlatý"
  },
  {
   "texto": "skvěl se rosy brillantové třpytem;"
  },
  {
   "texto": "dívky podávaly obětavě"
  },
  {
   "texto": "šňůru sněžných perel s temných vlasů,"
  },
  {
   "texto": "s níž se plesně obzíraly právě"
  },
  {
   "texto": "v benátského zrcadélka jasu,"
  },
  {
   "texto": "včera ještě vroucně celované"
  },
  {
   "texto": "skvostné dárky ruky milované;"
  },
  {
   "texto": "ba i dítky nesly v ofěru"
  },
  {
   "texto": "nejmilejší šperky své a hračky,"
  },
  {
   "texto": "loutek drahých třpytnou nádheru,"
  },
  {
   "texto": "nastřádaných grošů něžné sáčky — —"
  },
  {
   "texto": "A z těch darů pobožnosti vroucí"
  },
  {
   "texto": "vykouzlila ruka umělá"
  },
  {
   "texto": "monstrancí tak drahou, čaroskvoucí,"
  },
  {
   "texto": "že jí rovné země nezřela."
  },
  {
   "texto": "Jako luna s jasných nebes luhu,"
  },
  {
   "texto": "čistým leskem jaré lilie,"
  },
  {
   "texto": "z křišťálové schrány v zlatém kruhu"
  },
  {
   "texto": "vyzírala sněžná hostie."
  },
  {
   "texto": "Po obrubě schrány kolkolem"
  },
  {
   "texto": "rubínů a diamantů krásných"
  },
  {
   "texto": "hustý řad plál divným plápolem."
  },
  {
   "texto": "Na vlnivém stříbře oblak řásných"
  },
  {
   "texto": "splétaly kol andělíčků davy"
  },
  {
   "texto": "zlatých křídel věnec třepetavý."
  },
  {
   "texto": "Nad oblaky na vrcholu schrány"
  },
  {
   "texto": "vedle Syna Otec vážně snící"
  },
  {
   "texto": "pod stříbrnou trůnil holubicí."
  },
  {
   "texto": "Z oblaků pak vůkol na vše strany"
  },
  {
   "texto": "vytryskaly hustě různým směrem"
  },
  {
   "texto": "paprsleky dlouhé tvarů zdobných"
  },
  {
   "texto": "z nesčíslných diamantů drobných."
  },
  {
   "texto": "Nelze postihnouti chabým pérem"
  },
  {
   "texto": "zjevu toho nevýslovnou krásu,"
  },
  {
   "texto": "když těch paprsleků skvostný dav"
  },
  {
   "texto": "zablyskotal v mihotavém jasu,"
  },
  {
   "texto": "svící četných plápolem se vzňav:"
  },
  {
   "texto": "jakby utkán z jisker jíní hravých,"
  },
  {
   "texto": "ze krůpějí zářných vodotrysků,"
  },
  {
   "texto": "z divukrásných hvězdic třepetavých;"
  },
  {
   "texto": "když tu v tom, tu v onom jeho prysku"
  },
  {
   "texto": "hvězdka jedna mocněji se vzňala, —"
  },
  {
   "texto": "za ní jiných řad, až monstranc časem"
  },
  {
   "texto": "v jednom blesku všecka vzplápolala,"
  },
  {
   "texto": "že až zraky přecházely jasem."
  },
  {
   "texto": "Dole, k Trojici pnouc jasnou líc,"
  },
  {
   "texto": "s vínkem hvězdic démantových stojí"
  },
  {
   "texto": "svatá panna; pod ní v půlměsíc"
  },
  {
   "texto": "větší, menší démanty se pojí."
  },
  {
   "texto": "Pod obrubou zlatých jejích šatů"
  },
  {
   "texto": "had se svíjí, jemuž klade patu"
  },
  {
   "texto": "na ohyzdnou hlavu; z jeho tlamy"
  },
  {
   "texto": "svítí démantových zubů žeh,"
  },
  {
   "texto": "a trup mocný v hojných prstenech,"
  },
  {
   "texto": "stříbrnými pokryt šupinami,"
  },
  {
   "texto": "ovinuje zlatou zeměkouli"
  },
  {
   "texto": "a kol podstavce svým ocasem"
  },
  {
   "texto": "podivně se stáčí, dme a choulí."
  },
  {
   "texto": "Takto kacířských saň neřestí"
  },
  {
   "texto": "v zemi české chýlíc hlavu klatou"
  },
  {
   "texto": "smrtelnou se svíjí bolestí"
  },
  {
   "texto": "pod vítěznou matky boží patou."
  },
  {
   "texto": "Klečí Václav s pochýlenou lebí,"
  },
  {
   "texto": "ruce spíná, jeho rty se chvějí,"
  },
  {
   "texto": "ale z těchto pro pel rajský k nebi"
  },
  {
   "texto": "včelky modliteb se nevznášejí."
  },
  {
   "texto": "Od chvíle, kdy clona roztržena,"
  },
  {
   "texto": "útrpně mu zašlost skrývající,"
  },
  {
   "texto": "za dnů několik jak mocná změna"
  },
  {
   "texto": "udála se v jeho nitru, líci!"
  },
  {
   "texto": "V temné čelo shrnuly se vrásky,"
  },
  {
   "texto": "noci probděné mu víčka lem"
  },
  {
   "texto": "zbarvily jak okraj sedmikrásky"
  },
  {
   "texto": "palných strastí rudým nádechem;"
  },
  {
   "texto": "tmavý zrak, jenž sladkou dumu nitra"
  },
  {
   "texto": "volným hledem objevoval světu,"
  },
  {
   "texto": "jako hlubinu svou rosnou z jitra"
  },
  {
   "texto": "otevírá černý kalich květu,"
  },
  {
   "texto": "naučil se plaše pod řasu"
  },
  {
   "texto": "prchati před Otců, druhů hledy,"
  },
  {
   "texto": "skrývat s bázní před cizími zvědy"
  },
  {
   "texto": "tajemství těch hrozných zápasů,"
  },
  {
   "texto": "jež mu duši divokými žaly"
  },
  {
   "texto": "do dna bouřily a rozrývaly."
  },
  {
   "texto": "Od chvíle, kdy z vltavského sadu"
  },
  {
   "texto": "navrátiv se v kollej, z chodby stmělé"
  },
  {
   "texto": "spatřil opět lebí sťatých řadu"
  },
  {
   "texto": "na věži, dne skonem zkrvavělé,"
  },
  {
   "texto": "kdy tam klesl na kolena štkaje"
  },
  {
   "texto": "před otcovou potupenou hlavou,"
  },
  {
   "texto": "odkaz chudý k srdci přitiskaje,"
  },
  {
   "texto": "a déšť slzí vláhou skropil žhavou"
  },
  {
   "texto": "křečovitě spjaté jeho ruce,"
  },
  {
   "texto": "kdy tam rtové jeho drahým jménem"
  },
  {
   "texto": "v modlitbách a pláči udušeném"
  },
  {
   "texto": "ševelily v nevýslovné muce;"
  },
  {
   "texto": "od té chvíle pro jinocha dýše"
  },
  {
   "texto": "mrazem žalářním ten širý dům,"
  },
  {
   "texto": "kde jak ptáče v teplu tiché skrýše"
  },
  {
   "texto": "choulíval se k luzným dětství snům,"
  },
  {
   "texto": "nechápaje dálný světa šum;"
  },
  {
   "texto": "kde dřív lahodila jeho duchu"
  },
  {
   "texto": "přízeň Otců, láska druhů věrných —"
  },
  {
   "texto": "teď je cizím v povědomém ruchu"
  },
  {
   "texto": "těchto mnohočetných postav černých."
  },
  {
   "texto": "V chodbách pustých lekavě se chvěje,"
  },
  {
   "texto": "se sklopenou hlavou Otce míjí,"
  },
  {
   "texto": "a co při tom řasy jeho kryjí,"
  },
  {
   "texto": "děs by tisklo v jejich obličeje."
  },
  {
   "texto": "Doplíživ se v koutek chodby jistý,"
  },
  {
   "texto": "chvátá zrakem sežloutlými listy"
  },
  {
   "texto": "knihy vetché. Políbení vtiská"
  },
  {
   "texto": "v písmo bledé, psané rukou drahou"
  },
  {
   "texto": "na okraji blan. Zrak časem blýská,"
  },
  {
   "texto": "časem líce kropí trpkou vláhou."
  },
  {
   "texto": "A když někdy nad knihou se zvedá"
  },
  {
   "texto": "se škubavým rtem tvář jeho bledá,"
  },
  {
   "texto": "pěsť se zatíná, pod čelem chmurným"
  },
  {
   "texto": "vytřeštěný zrak plá svitem zpurným:"
  },
  {
   "texto": "zdává se, že pěstovala marně"
  },
  {
   "texto": "orlíče to pod křídloma svýma"
  },
  {
   "texto": "církev laskavá, že v něm se žárně"
  },
  {
   "texto": "husitská krev první jiskrou znímá,"
  },
  {
   "texto": "že ten jinoch s nevšedními dary,"
  },
  {
   "texto": "jenžto duší měkce povolnou"
  },
  {
   "texto": "v rukou řádu přijal slibné tvary"
  },
  {
   "texto": "a již touhu jevil plápolnou,"
  },
  {
   "texto": "by byl vřaděn k jeho sloupů davu,"
  },
  {
   "texto": "za okrasu církvi, za podporu,"
  },
  {
   "texto": "nyní náhle bujnou vzpíná hlavu"
  },
  {
   "texto": "pode jhem tím svatým v marném vzdoru."
  },
  {
   "texto": "Nyní v modlitbě se neklaní"
  },
  {
   "texto": "posvátnému na oltáři kmitu,"
  },
  {
   "texto": "ale čelo tiskne do dlaní"
  },
  {
   "texto": "v divé směsi myšlének a citů."
  },
  {
   "texto": "Když blesk náhle v ochozu se nítí,"
  },
  {
   "texto": "tu mní v ohni jeho prchavém"
  },
  {
   "texto": "otce svého hrdou postať zříti"
  },
  {
   "texto": "na lešení onom krvavém;"
  },
  {
   "texto": "vidí šíji, obnaženou k ráně,"
  },
  {
   "texto": "ušlechtilou krásu mužné hlavy,"
  },
  {
   "texto": "hrdolepě povypjaté skráně,"
  },
  {
   "texto": "kolem rtů ten úsměv pohrdavý"
  },
  {
   "texto": "a ten čela vzdor, ty zraky smělé — —"
  },
  {
   "texto": "Zdá se mu, že na něm utkvívají"
  },
  {
   "texto": "plny lásky, výčitek a žele,"
  },
  {
   "texto": "že jej slavně k pomstě vyzývají,"
  },
  {
   "texto": "že ho víží svatou závětí,"
  },
  {
   "texto": "aby prapor pošlapaný vznesl,"
  },
  {
   "texto": "za nějž otec v popravišti klesl."
  },
  {
   "texto": "Vidí klekat jej a v zápětí"
  },
  {
   "texto": "meč jak v ruce popravčí se kmitá"
  },
  {
   "texto": "a jak hlavu krásnou rouhavě"
  },
  {
   "texto": "za krvavou kadeř biřic chytá,"
  },
  {
   "texto": "v koš ji metá k děsné výstavě;"
  },
  {
   "texto": "jak se za ním ve vítězné slávě"
  },
  {
   "texto": "pošklebně ret jesuity svíjí…"
  },
  {
   "texto": "Zaťal zuby jun a hněvně ryjí"
  },
  {
   "texto": "nehty jeho v prsou, černém hávě,"
  },
  {
   "texto": "jakby řizu tuto ruce zlobné"
  },
  {
   "texto": "rozškubati chtěly v kusy drobné."
  },
  {
   "texto": "Však již příšerný ten obraz hasne."
  },
  {
   "texto": "Do mládcovy duše rozhárané"
  },
  {
   "texto": "tichý hlahol písně čarokrásné"
  },
  {
   "texto": "jakby ohlas rajských kůrů vane."
  },
  {
   "texto": "Jakby utkán z těchto luzných tónů,"
  },
  {
   "texto": "ze zásvitu nadpozemských září,"
  },
  {
   "texto": "milostný zjev dívčí jasnou tváří"
  },
  {
   "texto": "před ním rozptyluje temna clonu."
  },
  {
   "texto": "Jako violinka dechem jitra"
  },
  {
   "texto": "něžná hlavinka se k němu kloní,"
  },
  {
   "texto": "útěchy mu rosu vlídně roní"
  },
  {
   "texto": "z oček smavých do smutného nitra."
  },
  {
   "texto": "K jejím nožkám klade čelo zprahlé,"
  },
  {
   "texto": "na hlavě dvé jemných ruček cítí"
  },
  {
   "texto": "a jich dotknutím se tiší náhle"
  },
  {
   "texto": "citů trapných prudké vlnobití."
  },
  {
   "texto": "Mizí všechno, co mu srdce hnětlo:"
  },
  {
   "texto": "svět se rozplývá kol parou zlatou,"
  },
  {
   "texto": "nad kterouž dvé mladých duší vzletlo"
  },
  {
   "texto": "čisté lásky pod perutí svatou."
  },
  {
   "texto": "Však již před ním opět v záři siné"
  },
  {
   "texto": "popraviště přízrak bleskem hárá,"
  },
  {
   "texto": "s meče katova krev drahá plyne"
  },
  {
   "texto": "a hlas hromu dunivý jej kárá:"
  },
  {
   "texto": "Hle, tam s věže otce tvého hlava"
  },
  {
   "texto": "v potupě se pomsty dovolává"
  },
  {
   "texto": "a ty můžeš v marné lásky blahu"
  },
  {
   "texto": "vnadou kochat se, jež vykvetá"
  },
  {
   "texto": "v sadě jeho hanobců a vrahů?!"
  },
  {
   "texto": "jejíž každá perla prokletá"
  },
  {
   "texto": "ztopena je v mučenníků krev,"
  },
  {
   "texto": "zmyta slzou zhanobených děv?!"
  },
  {
   "texto": "Takto představ, citů váda lítá"
  },
  {
   "texto": "duší mládce klečícího zmítá."
  },
  {
   "texto": "Ale dnes též Konrad roztržitý"
  },
  {
   "texto": "dbá jen chabě boží oslavy,"
  },
  {
   "texto": "častěji než na monstrance třpyty"
  },
  {
   "texto": "upíraje pohled číhavý"
  },
  {
   "texto": "v soudruhovy rysy rozechvělé."
  },
  {
   "texto": "A tak pozorně a bystře bádá"
  },
  {
   "texto": "v jeho bledém líci, svislém čele,"
  },
  {
   "texto": "jakby chmurou, jež se tamo spřádá,"
  },
  {
   "texto": "postihoval pátrající hled"
  },
  {
   "texto": "dumy jeho nejtajnější sled."
  },
  {
   "texto": "Však co chvilkou v zelenavém oku"
  },
  {
   "texto": "číhavé té postavy se kmitá? —"
  },
  {
   "texto": "Srší-tě to jiskrou ve hluboku"
  },
  {
   "texto": "jeho ňader záští výheň skrytá."
  },
  {
   "texto": "Dávno plamen nenávisti žhavé"
  },
  {
   "texto": "k Václavovi chová v duši tmavé."
  },
  {
   "texto": "Proč? Snad porovnává lepé tvary"
  },
  {
   "texto": "jeho postavy, vděk líce jarý"
  },
  {
   "texto": "s vychrtlým svým tělem, šíjí křivou,"
  },
  {
   "texto": "s tváří vyzáblou a neduživou?"
  },
  {
   "texto": "Jeho krásných očí sladké snění"
  },
  {
   "texto": "se svým zrakem kalným v důlku vpadlém,"
  },
  {
   "texto": "který jen v té zášti rozechvění"
  },
  {
   "texto": "zjařuje se v obličeji zvadlém"
  },
  {
   "texto": "jako gnomů smaragd zanícený"
  },
  {
   "texto": "ohně podzemního děsným žárem,"
  },
  {
   "texto": "jako šelmy pohled rozlícený,"
  },
  {
   "texto": "když se v kořist vrhá dravým spárem?"
  },
  {
   "texto": "Snad mu závidí té vroucí přízně,"
  },
  {
   "texto": "jížto bezděky vše k němu lne,"
  },
  {
   "texto": "vzácných ducha darů, vědy žízně,"
  },
  {
   "texto": "jíž se k světlu čelo jeho pne."
  },
  {
   "texto": "Snad, jsa synem německého kraje,"
  },
  {
   "texto": "z prsou mateřských již záští ssál"
  },
  {
   "texto": "k národu, jenž pomstou plápolaje"
  },
  {
   "texto": "jeho pradědy kdys potepal?"
  },
  {
   "texto": "Či to hněv, že kouzlo poesie"
  },
  {
   "texto": "kolem druha libé záře své"
  },
  {
   "texto": "rozestírá, že mu růže vije"
  },
  {
   "texto": "i v ty důtky trýzně pobožné"
  },
  {
   "texto": "a že chmuru tajemnou té víry"
  },
  {
   "texto": "paprsky mu líbeznými zlatí,"
  },
  {
   "texto": "která pro něho jen ve mrak čirý,"
  },
  {
   "texto": "v smutné stíny hrozivé se šatí? — —"
  },
  {
   "texto": "Teď se okna chrámu, kupole"
  },
  {
   "texto": "zanítila v siném plápole"
  },
  {
   "texto": "a hrom udeřil tak burnou ranou,"
  },
  {
   "texto": "až-tě rázem oba jinoši"
  },
  {
   "texto": "vyskočili s tváří polekanou"
  },
  {
   "texto": "a tak chvíli jako sousoší"
  },
  {
   "texto": "ustrnulí před oltářem stáli;"
  },
  {
   "texto": "na to Konrad na klekátko svoje"
  },
  {
   "texto": "znovu klesl, ale Václav stoje"
  },
  {
   "texto": "dále hřížil pohled rozháralý"
  },
  {
   "texto": "v oken tmu, jíž časem blesky plály."
  },
  {
   "texto": "Zdál se naslouchat, jak hromu hlas"
  },
  {
   "texto": "temně duněl, tišil se a ztrácel,"
  },
  {
   "texto": "na to v novém hněvu zaburácel,"
  },
  {
   "texto": "a pak zvolna uchlácholen zas"
  },
  {
   "texto": "dozníval jak hluché zavíření"
  },
  {
   "texto": "na zastřený smutkem buben země,"
  },
  {
   "texto": "zdánlivě pak mlknul v usmíření"
  },
  {
   "texto": "a jen chvilkou z dáli broukal temně."
  },
  {
   "texto": "„Klekni, Václave! — Kde zrak tvůj těká?“"
  },
  {
   "texto": "Konrad hlasem tlumeným jej káře."
  },
  {
   "texto": "„Či tvůj duch se živlů vády leká?"
  },
  {
   "texto": "Klekni! Pochyl před svátostí tváře!“"
  },
  {
   "texto": "Ale Václav k démantové slávě"
  },
  {
   "texto": "napřáhl své dlaně odmítavě:"
  },
  {
   "texto": "„Nikoli! Ne — před tím bídným zlatem"
  },
  {
   "texto": "více nekleknu! — Ten mrzký třpyt"
  },
  {
   "texto": "božství rouhá se! — Zda v lupu klatém"
  },
  {
   "texto": "Kristus může voliti svůj byt?!"
  },
  {
   "texto": "Zdaž se může dobrotivý Bůh"
  },
  {
   "texto": "uchýliti v těchto poloupených,"
  },
  {
   "texto": "zločinem a hříchem zakoupených,"
  },
  {
   "texto": "zlopověstných drahokamů kruh?!"
  },
  {
   "texto": "Hospodin-li, křivdu trestající,"
  },
  {
   "texto": "za trůn volí prestol rubínů"
  },
  {
   "texto": "valnou krví nevinnou se rdící,"
  },
  {
   "texto": "prolévanou v děsném zločinu?!"
  },
  {
   "texto": "Tuto hvězdu přežalostné záře,"
  },
  {
   "texto": "z nesčíslných trpkých slzí tkanou,"
  },
  {
   "texto": "které tekly přes vyhnanců tváře"
  },
  {
   "texto": "v cizí hroudu pro vlast milovanou;"
  },
  {
   "texto": "které tekly v starců vousy šedé,"
  },
  {
   "texto": "truchlících na rodné chaty rumě,"
  },
  {
   "texto": "zoufajícím dívkám k líci bledé"
  },
  {
   "texto": "ve žoldáků zpustlých ryčném tlumě;"
  },
  {
   "texto": "které tekly v šedých stařen vrásky"
  },
  {
   "texto": "pro biblí, již biřic v oheň vrhal,"
  },
  {
   "texto": "z mroucích očí matky v děcka vlásky,"
  },
  {
   "texto": "ježto mračný mnich jí z loktů trhal;"
  },
  {
   "texto": "které pro poslední haléř tekly"
  },
  {
   "texto": "v oloupené žebrákovy dlaně;"
  },
  {
   "texto": "v jejichž moře ztopil tyran vzteklý"
  },
  {
   "texto": "celý národ v trápení a haně?!"
  },
  {
   "texto": "Taký slavověnec že si volí"
  },
  {
   "texto": "všeslitovný lidstva spasitel?!"
  },
  {
   "texto": "K poctě této hrozné glorioly"
  },
  {
   "texto": "koleno bych ukláněti měl?"
  },
  {
   "texto": "Nikoli — — A nechť se na mne sřítí"
  },
  {
   "texto": "světa celého i nebes hněv…"
  },
  {
   "texto": "Vždyť tam slzy matky mé se třpytí,"
  },
  {
   "texto": "rubínem plá otce mého krev!“"
  },
  {
   "texto": "Povstav maní, Konrad upjatě"
  },
  {
   "texto": "vyslechl ta slova divosmělá."
  },
  {
   "texto": "V úžasu a hněvném záchvatě"
  },
  {
   "texto": "střídavě se líce jeho chvěla"
  },
  {
   "texto": "a zrak jeho vpadlý záštím divým"
  },
  {
   "texto": "zažíhal se, plesem vítězivým."
  },
  {
   "texto": "Nyní volá, vztáhnuv k němu ruku:"
  },
  {
   "texto": "„Ustaň, nešťastníku! Rety tvoje"
  },
  {
   "texto": "strašlivý hřích plodí v každém zvuku!"
  },
  {
   "texto": "Sám to hejtman pekelného voje"
  },
  {
   "texto": "za herolta zloby své tě volí"
  },
  {
   "texto": "před veleby božské stanem skvoucím — —"
  },
  {
   "texto": "Ustaň, rouhači, než tebe skolí"
  },
  {
   "texto": "nebe hněvné mečem blesku žhoucím!“"
  },
  {
   "texto": "Jakby na stvrzení jeho slov"
  },
  {
   "texto": "zaplanul tou chvílí chrámu krov"
  },
  {
   "texto": "ve klikatých blesků záři siné;"
  },
  {
   "texto": "kupole se jeví celá v ní"
  },
  {
   "texto": "od vrcholu k chodbě okružní,"
  },
  {
   "texto": "jež kol její obruby se vine"
  },
  {
   "texto": "se zábradlím sloupců k žasné hloubce,"
  },
  {
   "texto": "odkud hádá divák nesměle,"
  },
  {
   "texto": "zda to vskutku chodba, hmotné sloupce,"
  },
  {
   "texto": "či klam pouhý malby umělé."
  },
  {
   "texto": "Hrom se valil s děsným hlomozem —"
  },
  {
   "texto": "Leč kdy doburácel, ve hluboku"
  },
  {
   "texto": "svatyně se ozval šelest kroků,"
  },
  {
   "texto": "blížících se volně ochozem,"
  },
  {
   "texto": "a dva stíny zachvěly se v krytbě —"
  },
  {
   "texto": "jiných noviců to kráčí dvé,"
  },
  {
   "texto": "aby vystřídali na modlitbě"
  },
  {
   "texto": "před monstrancí skvostnou druhy své."
  },
  {
   "texto": "Mlčky z chrámu do společné cely"
  },
  {
   "texto": "Václav s Konradem se navraceli."
  },
  {
   "texto": "Nad průčelí hrdé, mocná křídla"
  },
  {
   "texto": "obrovského jesuitů sídla"
  },
  {
   "texto": "na hřebenu střechy v žasné výši"
  },
  {
   "texto": "přístavek se lehký vzpíná k nebi,"
  },
  {
   "texto": "na vysokém domu dům to nižší,"
  },
  {
   "texto": "jako trpaslík nad obra lebí."
  },
  {
   "texto": "Mladých noviců tam hojná četa"
  },
  {
   "texto": "v řadě chudých, těsných cel je bytem"
  },
  {
   "texto": "převysoko nad hlomozem světa,"
  },
  {
   "texto": "jako v orlím hnízdě pod blankytem."
  },
  {
   "texto": "Tamo stoupá Václav. Teskná tucha"
  },
  {
   "texto": "obavami plní jeho ducha."
  },
  {
   "texto": "Ó, jak mnoho v odkazu svém bědném"
  },
  {
   "texto": "dal mu otec! Duše jeho celá"
  },
  {
   "texto": "ve blan těchto svazku neúhledném"
  },
  {
   "texto": "jako vůně v listech květu dlela."
  },
  {
   "texto": "V tuto knihu rtové jeho mroucí"
  },
  {
   "texto": "vdechli jistě hrudi plání svaté,"
  },
  {
   "texto": "pro domov a víru zápal vroucí,"
  },
  {
   "texto": "by z ní synu vanul v srdce vzňaté."
  },
  {
   "texto": "Touto knihou s nadpozemské nivy"
  },
  {
   "texto": "strhal rázem přízi mnohých roků,"
  },
  {
   "texto": "jížto zaclonili vrazi lstiví"
  },
  {
   "texto": "pravdu mileného děcka oku."
  },
  {
   "texto": "Jak teď pýchou září synu zraky,"
  },
  {
   "texto": "když mu slunce slávy předků jasné"
  },
  {
   "texto": "svítí klamu strhanými mraky"
  },
  {
   "texto": "a duch nad hromnou jich silou žasne!"
  },
  {
   "texto": "A jak z nich teď jiskry hněvu srší,"
  },
  {
   "texto": "zároveň pak na zaťaté pěsti"
  },
  {
   "texto": "žhavým deštěm slzy žalné prší,"
  },
  {
   "texto": "když pád vlasti žalostný mu věstí,"
  },
  {
   "texto": "hromovou tu ránu Hory Bílé"
  },
  {
   "texto": "a ples roty vrahů zdivočilé"
  },
  {
   "texto": "řádky matné otcem připsané,"
  },
  {
   "texto": "kletbami a vzdechy protkané!"
  },
  {
   "texto": "Kterak vlhnou v dešti tomto palném"
  },
  {
   "texto": "slova tklivá na poslední blance,"
  },
  {
   "texto": "v nichžto Ambrož ve vyhnanství žalném,"
  },
  {
   "texto": "slzou smáčeje chléb hořký psance,"
  },
  {
   "texto": "kalným okem k hornatému lemu"
  },
  {
   "texto": "daleké své mrtvé vlasti spěje,"
  },
  {
   "texto": "třesoucí se rukou lidu svému"
  },
  {
   "texto": "rekviem psal truchlé, bez naděje — —"
  },
  {
   "texto": "Ještě víra, jež tak dlouho juna"
  },
  {
   "texto": "chovala na teplém klíně měkkém,"
  },
  {
   "texto": "zvyku mocí, mystickým svým vděkem"
  },
  {
   "texto": "zpět jej táhne do šerého lůna,"
  },
  {
   "texto": "hrozbou trestu věčného jej děsí,"
  },
  {
   "texto": "slibuje mu nebes věčné plesy…"
  },
  {
   "texto": "Ale otcův zjev, jenž stále vznáší"
  },
  {
   "texto": "před ním v popravišti rysy hněvné,"
  },
  {
   "texto": "vítězně ji od jinocha plaší;"
  },
  {
   "texto": "v tom již zraje odhodlání pevné,"
  },
  {
   "texto": "že dá výhost řádu, cele těsné,"
  },
  {
   "texto": "kde se zmítá v divém citů boji,"
  },
  {
   "texto": "a že zítra v lokty bratru klesne,"
  },
  {
   "texto": "s jeho osudem svůj navždy spojí…"
  },
  {
   "texto": "Leč zda Konrad Otcům nevyjeví"
  },
  {
   "texto": "slova rouhavá na místě svatém,"
  },
  {
   "texto": "zda mu vazby trestem jejich hněvy"
  },
  {
   "texto": "nezamezí tajnou schůzku s bratrem?"
  },
  {
   "texto": "Když je objal cely prostor tmavý,"
  },
  {
   "texto": "váhavě tam k druhu Václav praví:"
  },
  {
   "texto": "„Slib mi, Konrade, že duch tvůj složí"
  },
  {
   "texto": "v nepaměti schráně bezpečné"
  },
  {
   "texto": "slova, vyšlehnuvší před tvář boží"
  },
  {
   "texto": "z choré mysli výhně horečné.“"
  },
  {
   "texto": "„„Neoklameš mne,““ dí Konrad chladně."
  },
  {
   "texto": "„„Nevzniklať ta slova v duchu chorém!"
  },
  {
   "texto": "Dnů již několik čtu, bádám na dně"
  },
  {
   "texto": "nitra tvého nepokojným zorem."
  },
  {
   "texto": "Přiznej se, že do tvé duše vletla"
  },
  {
   "texto": "zhoubná jiskra z pekla žhoucích kvasů,"
  },
  {
   "texto": "v kacířský tam plápol mrzký zkvetla"
  },
  {
   "texto": "a tvé duše ohrožuje spásu."
  },
  {
   "texto": "Zjev mi všechno! Snad má pomoc, rada"
  },
  {
   "texto": "satanské té nástrahy tě zbaví,"
  },
  {
   "texto": "nežli jícen pekelného hada"
  },
  {
   "texto": "dechem morovým tvou duši ztráví.““"
  },
  {
   "texto": "Mlčí chvilku druh; pak vece temně:"
  },
  {
   "texto": "„Zítra všechno zvíš.“"
  },
  {
   "texto": "„„Nač odklad ten?"
  },
  {
   "texto": "Či snad chováš nedůvěru ke mně?““"
  },
  {
   "texto": "„Zítra — Zítra —“"
  },
  {
   "texto": "„„Ne, již ani den"
  },
  {
   "texto": "odložen být nesmí spasný boj"
  },
  {
   "texto": "s duší vrahem, jenž tě v propasť šine!"
  },
  {
   "texto": "Věz to již: znám dobře tajný zdroj,"
  },
  {
   "texto": "z něhož bludu jed ti v nitro plyne."
  },
  {
   "texto": "V mé jsi moci, pokrytče ty vzdorný!"
  },
  {
   "texto": "Zasypu ti šalby pramen morný,"
  },
  {
   "texto": "abys navrátil se k pravdě spasné"
  },
  {
   "texto": "jako bludný jelen k studni jasné!““"
  },
  {
   "texto": "V tom blesk celu v sinou ztopil záři."
  },
  {
   "texto": "Václav zahlédl v tom světla mihu"
  },
  {
   "texto": "krutý záškleb v Konradově tváři,"
  },
  {
   "texto": "v rukou jeho — drahou svoji knihu."
  },
  {
   "texto": "Mněl, že démona to zahled’ tahy,"
  },
  {
   "texto": "jenž mu schvátil v pazoury své dračí"
  },
  {
   "texto": "jediný ten klenot, kvítek drahý,"
  },
  {
   "texto": "zkvetlý krví, porosený v pláči."
  },
  {
   "texto": "„Vrať mi knihu, bídný vyzvědači!“"
  },
  {
   "texto": "S křikem vrh’ se na podlého krádce."
  },
  {
   "texto": "„„Vydám ji teď pouze,““ syčí zrádce,"
  },
  {
   "texto": "„„Otci rektorovi!““"
  },
  {
   "texto": "Zápas lítý"
  },
  {
