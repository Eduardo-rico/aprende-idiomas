 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "17"
  },
  {
   "texto": "Neplač, neplač, brachu, nenaříkej,"
  },
  {
   "texto": "že je záhad v světě k znavení,"
  },
  {
   "texto": "jenom pít a jíst se pilně zvykej,"
  },
  {
   "texto": "v hrobě času dost pak k strávení."
  },
  {
   "texto": "A až umřeš, budeš zbaven všeho,"
  },
  {
   "texto": "tělo v prach se moudře rozpadne,"
  },
  {
   "texto": "a co zde ti bylo záhadného,"
  },
  {
   "texto": "zůstane ti pak i záhadné."
  },
  {
   "texto": "Jakou však tvá mysl píseň hude,"
  },
  {
   "texto": "zpívá s tebou celý tvůj i čas,"
  },
  {
   "texto": "která lež tě hnětla, hněsti bude"
  },
  {
   "texto": "v jiné formě jiné lidi zas."
  },
  {
   "texto": "Mnoho bolů v tomto světě,"
  },
  {
   "texto": "mnohý vzdech se zachvěje,"
  },
  {
   "texto": "mnohý blázen, co ho hněte,"
  },
  {
   "texto": "v dumné písni zapěje."
  },
  {
   "texto": "Mnoho skořep v šírém moři,"
  },
  {
   "texto": "mnohá z nich i v chorobě,"
  },
  {
   "texto": "však jen jedna ze slz tvoří"
  },
  {
   "texto": "perlu v skvoucí údobě."
  },
  {
   "texto": "Jsem-li syn, neb cizím Apollinu,"
  },
  {
   "texto": "to mou mysl lehko nermoutí,"
  },
  {
   "texto": "aniž úsudek snad pohanlivý"
  },
  {
   "texto": "někdy čelo moje posmoutí."
  },
  {
   "texto": "Jesti, myslím, poezie první"
  },
  {
   "texto": "podíl každého už dítěte,"
  },
  {
   "texto": "jeho okem, mysli jeho chůvou,"
  },
  {
   "texto": "první učitelkou ve světě."
  },
  {
   "texto": "A ta milá dáma poezie"
  },
  {
   "texto": "je jak vůbec všechny dívčiny,"
  },
  {
   "texto": "věčné nevěrnosti věčně věrná,"
  },
  {
   "texto": "a když prchne, povždy bez viny."
  },
  {
   "texto": "A kdo dívkám věří - stará píseň! -,"
  },
  {
   "texto": "píše „věřím“ v řeku plynoucí,"
  },
  {
   "texto": "po pavučinách se k nebi souká,"
  },
  {
   "texto": "v sítě chytá stíny hynoucí."
  },
  {
   "texto": "Však znám ten lid, jenž nožem hnusné pitvy"
  },
  {
   "texto": "si chleb a slávu potem dobývá,"
  },
  {
   "texto": "snad zpěv můj klada na své nuzné váhy,"
  },
  {
   "texto": "juž znak mu soudu svého v čelo vyrývá."
  },
  {
   "texto": "On z pýlu motýlů si vápno pálí,"
  },
  {
   "texto": "kdy trámů třeba, les si cizí skotí,"
  },
  {
   "texto": "kdy písem váží, jasný pramen kalí,"
  },
  {
   "texto": "kdy kámen láme, sousedův dům zhrotí."
  },
  {
   "texto": "Zlato chtít snad pozlacovat,"
  },
  {
   "texto": "slunce svící osvěcovat,"
  },
  {
   "texto": "duhu barvou domalovat,"
  },
  {
   "texto": "sopku ohněm podpalovat,"
  },
  {
   "texto": "démantů chtít tvrdost zvýšit,"
  },
  {
   "texto": "oblaků chtít rychlost spíšit,"
  },
  {
   "texto": "toť by bylo rozumnější"
  },
  {
   "texto": "nežli tvoje, pěvče Erbene,"
  },
  {
   "texto": "písně chtít snad písní opěvovat."
  }
 ]
}