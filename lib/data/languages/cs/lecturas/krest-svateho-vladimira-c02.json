{
 "id": "krest-svateho-vladimira-c02",
 "titulo": "Zpěv 2: Zpěv III. — Vojenský soud · Zpěv IV. — Testament Perunův · Zpěv V. — Bezbožnost v Rusích",
 "autor": "Karel Havlíček Borovský",
 "muerteAutor": 1856,
 "fuenteUrl": "https://cs.wikisource.org/wiki/K%C5%99est_svat%C3%A9ho_Vladim%C3%ADra/Zp%C4%9Bv_III.",
