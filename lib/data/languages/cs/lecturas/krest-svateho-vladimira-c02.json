 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Zpěv III. — Vojenský soud"
  },
  {
   "texto": "Bože! kýž jsem policajtem,"
  },
  {
   "texto": "to je vyražení,"
  },
  {
   "texto": "koho chce, toho si chytne"
  },
  {
   "texto": "a dá do vězení."
  },
  {
   "texto": "Každý si ho musí vážit;"
  },
  {
   "texto": "kdo naň zaškaredí,"
  },
  {
   "texto": "pro urážku policajta"
  },
  {
   "texto": "ve štokhauzu sedí."
  },
  {
   "texto": "Ctěte, hoši, policajty!"
  },
  {
   "texto": "Ouvej! jak to bolí!"
  },
  {
   "texto": "Stát vyplácí krejčím metlou,"
  },
  {
   "texto": "ale ševcům holí."
  },
  {
   "texto": "Slyšte, lidé, pro výstrahu"
  },
  {
   "texto": "mé smutné zpívání,"
  },
  {
   "texto": "že se proti policajtům"
  },
  {
   "texto": "sám bůh neubrání."
  },
  {
   "texto": "Už ho vedou svázaného,"
  },
  {
   "texto": "všechno ve mně hrká!"
  },
  {
   "texto": "Dva ho táhnou za ramena,"
  },
  {
   "texto": "jeden vzadu strká."
  },
  {
   "texto": "„Jenom mne po humnech veďte,"
  },
  {
   "texto": "však já s vámi pudu,"
  },
  {
   "texto": "nedělejte mi ve městě"
  },
  {
   "texto": "veřejnou ostudu!“"
  },
  {
   "texto": "Ale na humnech u strouhy"
  },
  {
   "texto": "paní Perunice"
  },
  {
   "texto": "zapírala Peruňátku"
  },
  {
   "texto": "něco na sukničce."
  },
  {
   "texto": "Jak poznala svého pána,"
  },
  {
   "texto": "hned se s hrozným křikem"
  },
  {
   "texto": "na pochopy obořila"
  },
  {
   "texto": "mokrým lavičníkem."
  },
  {
   "texto": "Ale Perun, dobrotisko,"
  },
  {
   "texto": "sám ji napomíná:"
  },
  {
   "texto": "„Schovej, ženo, meč do pochvy,"
  },
  {
   "texto": "přišla má hodina!““"
  },
  {
   "texto": "Policajti s Perunicí"
  },
  {
   "texto": "na humnech se vadí:"
  },
  {
   "texto": "u dvora se zákoníci"
  },
  {
   "texto": "o Peruna radí."
  },
  {
   "texto": "A již Perun upoutaný"
  },
  {
   "texto": "v šatlavě nocuje:"
  },
  {
   "texto": "juristům se z paragrafů"
  },
  {
   "texto": "žádný nešikuje."
  },
  {
   "texto": "Neboť ten, kdo zákony ďál,"
  },
  {
   "texto": "neměl ani zdání,"
  },
  {
   "texto": "že cár vezme někdy boha"
  },
  {
   "texto": "do vyšetřování."
  },
  {
   "texto": "Ráno přišla apelace"
  },
  {
   "texto": "k cáru celá bledá,"
  },
  {
   "texto": "že se proti Perunovi"
  },
  {
   "texto": "zákon najít nedá."
  },
  {
   "texto": "Cár se na ně zle osopil,"
  },
  {
   "texto": "řek jim, že jsou osli,"
  },
  {
   "texto": "poslal hned pro vojenský soud"
  },
  {
   "texto": "do kasáren posly."
  },
  {
   "texto": "Vojenský soud, to je samec,"
  },
  {
   "texto": "soudí, jen se práší;"
  },
  {
   "texto": "on má všechny paragrafy"
  },
  {
   "texto": "v jedné patrontaši."
  },
  {
   "texto": "Vojenský soud na civilní"
  },
  {
   "texto": "dívá se z vysoka,"
  },
  {
   "texto": "nesoudí podle zákonů,"
  },
  {
   "texto": "všechno jen od oka."
  },
  {
   "texto": "Vojenský soud má žaludek"
  },
  {
   "texto": "zdravý jako štika:"
  },
  {
   "texto": "nevinného na komando"
  },
  {
   "texto": "ztráví jak viníka."
  },
  {
   "texto": "Vojenský soud z ničeho nic,"
  },
  {
   "texto": "jako ňáký tvůrce,"
  },
  {
   "texto": "nález právě potvrzený"
  },
  {
   "texto": "měl jako na šňůrce:"
  },
  {
   "texto": "Že dle vyšlé proklamace"
  },
  {
   "texto": "komandujícího"
  },
  {
   "texto": "a dle „ostaních zákonů“"
  },
  {
   "texto": "soudu hrdelního"
  },
  {
   "texto": "pro urážku první třídy"
  },
  {
   "texto": "Jeho Veličenství,"
  },
  {
   "texto": "pro vzpouru, nemravné řeči,"
  },
  {
   "texto": "pro neposlušenství"
  },
  {
   "texto": "Perun bůh jest odsouzený"
  },
  {
   "texto": "k provazu dle práva,"
  },
  {
   "texto": "že však k utopení v Dněpru"
  },
  {
   "texto": "milost se mu dává;"
  },
  {
   "texto": "bude ale pro výstrahu"
  },
  {
   "texto": "neposlušné chase"
  },
  {
   "texto": "vlečen k řece po ulicích"
  },
  {
   "texto": "na koňském ocase. —"
  },
  {
   "texto": "Právě jeden žurnalista"
  },
  {
   "texto": "seděl také v díře,"
  },
  {
   "texto": "protože se bohu rouhal"
  },
  {
   "texto": "a psal proti víře;"
  },
  {
   "texto": "soud jej odsoudil, použiv"
  },
  {
   "texto": "té přiležitosti,"
  },
  {
   "texto": "k stejnému trestu s Perunem"
  },
  {
   "texto": "kvůli nestrannosti. —"
  },
  {
   "texto": "Zpěv IV. — Testament Perunův"
  },
  {
   "texto": "Poslyšte, milí křesťané,"
  },
  {
   "texto": "tu smutnou novinu,"
  },
  {
   "texto": "jak dokonal slovanský bůh"
  },
  {
   "texto": "poslední hodinu."
  },
  {
   "texto": "Kdo máš tuze měkké srdce,"
  },
  {
   "texto": "zacpi sobě uši"
  },
  {
   "texto": "a pomodli se Otčenáš"
  },
  {
   "texto": "za ubohou duši."
  },
  {
   "texto": "Přivázali ho za nohy"
  },
  {
   "texto": "na ocas kobyle,"
  },
  {
   "texto": "blátem, kamením ho vlekli,"
  },
  {
   "texto": "přežalostná chvíle!"
  },
  {
   "texto": "Za ním toho novináře,"
  },
  {
   "texto": "ouvej, ouvej, ach, ach!"
  },
  {
   "texto": "šmejkal po břiše nelidsky"
  },
  {
   "texto": "na ocase valach."
  },
  {
   "texto": "Tak je ti cárští katané"
  },
  {
   "texto": "ukrutně mučili,"
  },
  {
   "texto": "všechny louže po Kyjevě"
  },
  {
   "texto": "s nimi vysmejčili."
  },
  {
   "texto": "Když jsou je přivlekli k řece"
  },
  {
   "texto": "celé plné bláta,"
  },
  {
   "texto": "kati je tam utopili"
  },
  {
   "texto": "jak slepá štěňata."
  },
  {
   "texto": "Umřeli jsou bez zpovědi"
  },
  {
   "texto": "jako lutriáni,"
  },
  {
   "texto": "jenom poslední jim dali"
  },
  {
   "texto": "blátem pomazání."
  },
  {
   "texto": "Já jsem sice při tom nebyl,"
  },
  {
   "texto": "čet jsem to jen v plátku,"
  },
  {
   "texto": "který o tom sepsal Nestor"
  },
  {
   "texto": "vnukům na památku. —"
  },
  {
   "texto": "„Tak to chodí na tom světě,"
  },
  {
   "texto": "každou chvíli jinák:"
  },
  {
   "texto": "dneska ctí tě za svatého,"
  },
  {
   "texto": "zejtra budeš sviňák!"
  },
  {
   "texto": "Dnes vám, bozi, vy ubozí!"
  },
  {
   "texto": "kadidlo lid pálí;"
  },
  {
   "texto": "a zejtra vás jako smetí"
  },
  {
   "texto": "v kalužinách válí."
  },
  {
   "texto": "Dělají si nové bohy"
  },
  {
   "texto": "dle svého pohodlí,"
  },
  {
   "texto": "koho včera oběsili,"
  },
  {
   "texto": "k tomu se dnes modlí."
  },
  {
   "texto": "Všechno jest na světě marné,"
  },
  {
   "texto": "i království boží —"
  },
  {
   "texto": "všechno hyne a pomine"
  },
  {
   "texto": "jako špatné zboží."
  },
  {
   "texto": "Jenom cáři, samovláda"
  },
  {
   "texto": "a takové sloty"
  },
  {
   "texto": "potrvají věčně věkův"
  },
  {
   "texto": "jak juchtové boty!“"
  },
  {
   "texto": "Tak měl Perun, když ho vlekli,"
  },
  {
   "texto": "resonýrovati,"
  },
  {
   "texto": "slyšel jsem to a jak koupím,"
  },
  {
   "texto": "musím prodávati."
  },
  {
   "texto": "Sám bych si to nevymyslil,"
  },
  {
   "texto": "třeba bych to věděl:"
  },
  {
   "texto": "dobře já vím, že bych za to"
  },
  {
   "texto": "na Špimberku seděl."
  },
  {
   "texto": "Na Špimberku, na Kufsteině"
  },
  {
   "texto": "mnoho pokojíků:"
  },
  {
   "texto": "„Bože, zachovej nám krále!“"
  },
  {
   "texto": "to je zpěv slavíků. —"
  },
  {
   "texto": "Važ si všeho, milý synu,"
  },
  {
   "texto": "co na trůnu sedí,"
  },
  {
   "texto": "na ponížené dušinky"
  },
  {
   "texto": "cár milostně hledí."
  },
  {
   "texto": "Kdo ctí cára a je Vávra,"
  },
  {
   "texto": "může něčím býti,"
  },
  {
   "texto": "kdo nechválí, bude věčně"
  },
  {
   "texto": "jenom vodu píti."
  },
  {
   "texto": "Zpěv V. — Bezbožnost v Rusích"
  },
  {
   "texto": "Tak se z maličké příčiny"
  },
  {
   "texto": "stala velká mela:"
  },
  {
   "texto": "ruský národ neměl boha,"
  },
  {
   "texto": "církev ovdověla."
  },
  {
   "texto": "Nám by byla lehká pomoc,"
  },
  {
   "texto": "toť je stará vesta!"
  },
  {
   "texto": "Teď již umí každý kaplan"
  },
  {
   "texto": "dělat bohy z těsta."
  },
  {
   "texto": "Ale Rusi o těch kumštech"
  },
  {
   "texto": "ještě nevěděli,"
  },
  {
   "texto": "když si boha utopili,"
  },
  {
   "texto": "žádného neměli."
  },
  {
   "texto": "Počali se všichni báti"
  },
  {
   "texto": "strašlivých následků,"
  },
  {
   "texto": "neb žádný nic takového"
  },
  {
   "texto": "neslyšel od předků! —"
  },
  {
   "texto": "Ale svět je pořád stejný,"
  },
  {
   "texto": "lidé ho nezmění:"
  },
  {
   "texto": "plivni si stokrát do moře,"
  },
  {
   "texto": "ono se nezpění."
  },
  {
   "texto": "Tak i v Rusku bez Peruna"
  },
  {
   "texto": "ve starém pořádku"
  },
  {
   "texto": "běžela světská mašina"
  },
  {
   "texto": "jak na kolovrátku."
  },
  {
   "texto": "Staří lidé umírali,"
  },
  {
   "texto": "děti se rodily,"
  },
  {
   "texto": "hodní lidé pracovali"
  },
  {
   "texto": "a ochlasti pili."
  },
  {
   "texto": "Hrušky zrály o Jakubě"
  },
  {
   "texto": "a na podzim švestky:"
  },
  {
   "texto": "když se hodně vypršelo,"
  },
  {
   "texto": "bylo zase hezky."
  },
  {
   "texto": "Slunce svítilo jen ve dne,"
  },
  {
   "texto": "měsíc jenom v noci:"
  },
  {
   "texto": "v létě bylo cáru horko"
  },
  {
   "texto": "při vší jeho moci."
  },
  {
   "texto": "Žito se muselo síti,"
  },
  {
   "texto": "tráva rostla sama,"
  },
  {
   "texto": "šlechta pracovala hubou,"
  },
  {
   "texto": "sedláci rukama."
  },
  {
   "texto": "Kdo zaplatil, měl u pánů"
  },
  {
   "texto": "všudy dobrou přízeň,"
  },
  {
   "texto": "hlad si zaháněli jídlem,"
  },
  {
   "texto": "ale pitím žízeň."
  },
  {
   "texto": "Všecky řeky byly mokré"
  },
  {
   "texto": "a kamení tvrdé:"
  },
  {
   "texto": "chalupnice hubovaly,"
  },
  {
   "texto": "že jsou selky hrdé."
  },
  {
   "texto": "Šlechtic neobcoval s mužským"
  },
  {
   "texto": "měšťanského rodu:"
  },
  {
   "texto": "ale šenkýři míchali"
  },
  {
   "texto": "přec do piva vodu."
  },
  {
   "texto": "Mladí lidé pospíchali,"
  },
  {
   "texto": "staří šli pomalu:"
  },
  {
   "texto": "na každou špetku radosti"
  },
  {
   "texto": "přišla špetka žalu."
  },
  {
   "texto": "Kdo měl málo, tomu braly"
  },
  {
   "texto": "velké pijavice:"
  },
  {
   "texto": "moudrých lidí bylo málo,"
  },
  {
   "texto": "ale hloupých více."
  },
  {
   "texto": "Kdo byl taškář za Peruna,"
  },
  {
   "texto": "taškařil zas dále:"
  },
  {
   "texto": "a kdo byl poctivá duše,"
  },
  {
   "texto": "dřen byl neustále."
  },
  {
   "texto": "Neboť svět je pořád stejný,"
  },
  {
   "texto": "lidé ho nezmění,"
  },
  {
   "texto": "plivni si stokrát do moře,"
  },
  {
   "texto": "ono se nezpění."
  },
  {
   "texto": "Tak i v Rusku bez Peruna"
  },
  {
   "texto": "ve starém pořádku"
  },
  {
   "texto": "běžela světská mašina"
  },
  {
   "texto": "jak na kolovrátku."
  },
  {
   "texto": "Ale církevní mašinka,"
  },
  {
   "texto": "ta se zarazila,"
  },
  {
   "texto": "neboť kněžům u pytlíku"
  },
  {
   "texto": "zaťata jest žíla."
  },
  {
   "texto": "Sedlák, ten jest odjakživa"
  },
  {
   "texto": "vychytralý kvítek,"
  },
  {
   "texto": "hned si z toho utopení"
  },
  {
   "texto": "vyhlídl užitek."
  },
  {
   "texto": "Přestali desátky dávat,"
  },
  {
   "texto": "také na modlení,"
  },
  {
   "texto": "ani štolu, ani na mše,"
  },
  {
   "texto": "když prej pánbůh není."
  },
  {
   "texto": "Na ofěry nechodili,"
  },
  {
   "texto": "při funusech ticho:"
  },
  {
   "texto": "kostelníci mřeli hladem,"
  },
  {
   "texto": "kněžům splasklo břicho. —"
  },
  {
   "texto": "Tu hned tekla krev z obrazů,"
  },
  {
   "texto": "děly se zázraky:"
  },
  {
   "texto": "čistá panna porodila"
  },
  {
   "texto": "čtyry mladé draky."
  },
  {
   "texto": "Báby viděly znamení"
  },
  {
   "texto": "na nebi a všude:"
  },
  {
   "texto": "prodávaly staré sukně,"
  },
  {
   "texto": "že soudný den bude."
  },
  {
   "texto": "Báby viděly znamení"
  },
  {
   "texto": "na nebi a v dírách,"
  },
  {
   "texto": "slyšely potopu světa"
  },
  {
   "texto": "hučet ve všech škvírách."
  },
  {
   "texto": "Po svatbě se narodilo"
  },
  {
   "texto": "dítě za čtvrt léta:"
  },
  {
   "texto": "kupujte, lidi, měchejře"
  },
  {
   "texto": "na potopu světa!"
  }
 ]
}