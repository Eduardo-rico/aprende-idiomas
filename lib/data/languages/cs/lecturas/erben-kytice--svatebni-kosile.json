{
 "id": "erben-kytice--svatebni-kosile",
 "titulo": "Svatební košile",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/Svatebn%C3%AD_ko%C5%A1ile",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (viděti, pomoci, státi: 3 formas frente a 0 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso y lo pondría en A2.",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 2
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Již jedenáctá odbila,"
  },
  {
   "texto": "a lampa ještě svítila,"
  },
  {
   "texto": "a lampa ještě hořela,"
  },
  {
   "texto": "co nad klekadlem visela."
  },
  {
   "texto": "Na stěně nízké světničky"
  },
  {
   "texto": "byl obraz boží rodičky,"
  },
  {
   "texto": "rodičky boží s děťátkem,"
  },
  {
   "texto": "tak jako růže s poupátkem."
  },
  {
   "texto": "A před tou mocnou světicí"
  },
  {
   "texto": "viděti pannu klečící:"
  },
  {
   "texto": "klečela, líce skloněné,"
  },
  {
   "texto": "ruce na prsa složené;"
  },
  {
   "texto": "slzy jí z očí padaly,"
  },
  {
   "texto": "želem se ňádra zdvihaly."
  },
  {
   "texto": "A když slzička upadla,"
  },
  {
   "texto": "v ty bílé ňádra zapadla."
  },
  {
   "texto": "„Žel bohu, kde můj tatíček?"
  },
  {
   "texto": "Již na něm roste trávníček!"
  },
  {
   "texto": "Žel bohu, kde má matička?"
  },
  {
   "texto": "Tam leží — podle tatíčka!"
  },
  {
   "texto": "Sestra do roka nežila,"
  },
  {
   "texto": "bratra mi koule zabila."
  },
  {
   "texto": "Měla jsem, smutná, milého,"
  },
  {
   "texto": "život bych dala pro něho!"
  },
  {
   "texto": "Do ciziny se obrátil,"
  },
  {
   "texto": "potud se ještě nevrátil."
  },
  {
   "texto": "Do ciziny se ubíral,"
  },
  {
   "texto": "těšil mě, slzy utíral:"
  },
  {
   "texto": "„Zasej, má milá, zasej len,"
  },
  {
   "texto": "vzpomínej na mne každý den,"
  },
  {
   "texto": "první rok přádla hledívej,"
  },
  {
   "texto": "druhý rok plátno polívej,"
  },
  {
   "texto": "třetí košile vyšívej:"
  },
  {
   "texto": "až ty košile ušiješ,"
  },
  {
   "texto": "věneček z routy poviješ.“"
  },
  {
   "texto": "Již jsem košile ušila,"
  },
  {
   "texto": "již jsem je v truhle složila,"
  },
  {
   "texto": "již moje routa v odkvětě,"
  },
  {
   "texto": "a milý ještě ve světě,"
  },
  {
   "texto": "ve světě šírém, širokém,"
  },
  {
   "texto": "co kámen v moři hlubokém."
  },
  {
   "texto": "Tři léta o něm ani sluch"
  },
  {
   "texto": "živ-li a zdráv — zná milý bůh!"
  },
  {
   "texto": "Maria, panno přemocná,"
  },
  {
   "texto": "ach budiž ty mi pomocna:"
  },
  {
   "texto": "vrať mi milého z ciziny,"
  },
  {
   "texto": "květ blaha mého jediný;"
  },
  {
   "texto": "milého z ciziny mi vrať —"
  },
  {
   "texto": "aneb život můj náhle zkrať:"
  },
  {
   "texto": "u něho život jarý květ —"
  },
  {
   "texto": "bez něho však mě mrzí svět."
  },
  {
   "texto": "Maria, matko milosti,"
  },
  {
   "texto": "buď pomocnicí v žalosti!“"
  },
  {
   "texto": "Pohnul se obraz na stěně —"
  },
  {
   "texto": "i vzkřikla panna zděšeně;"
  },
  {
   "texto": "lampa, co temně hořela,"
  },
  {
   "texto": "prskla a zhasla docela."
  },
  {
   "texto": "Možná, žeť větru tažení,"
  },
  {
   "texto": "možná i — zlé že znamení!"
  },
  {
   "texto": "A slyš, na záspí kroků zvuk"
  },
  {
   "texto": "a na okénko: ťuk, ťuk, ťuk!"
  },
  {
   "texto": "„Spíš, má panenko, nebo bdíš?"
  },
  {
   "texto": "Hoj, má panenko, tu jsem již!"
  },
  {
   "texto": "Hoj, má panenko, co děláš?"
  },
  {
   "texto": "A zdalipak mě ještě znáš,"
  },
  {
   "texto": "aneb jiného v srdci máš?“"
  },
  {
   "texto": "„Ach můj milý, ach pro nebe,"
  },
  {
   "texto": "tu dobu myslím na tebe;"
  },
  {
   "texto": "na tě jsem vždycky myslila,"
  },
  {
   "texto": "za tě se právě modlila!“"
  },
  {
   "texto": "„Ho, nech modlení — skoč a pojď,"
  },
  {
   "texto": "skoč a pojď a mě doprovoď;"
  },
  {
   "texto": "měsíček svítí na cestu:"
  },
  {
   "texto": "já přišel pro svou nevěstu.“"
  },
  {
   "texto": "„Ach proboha, ach co pravíš?"
  },
  {
   "texto": "Kam bychom šli — tak pozdě již!"
  },
  {
   "texto": "Vítr burácí, pustá noc,"
  },
  {
   "texto": "počkej jen do dne — není moc.“"
  },
  {
   "texto": "„Ho, den je noc, a noc je den —"
  },
  {
   "texto": "ve dne mé oči tlačí sen!"
  },
  {
   "texto": "Dřív než se vzbudí kohouti,"
  },
  {
   "texto": "musím tě za svou pojmouti."
  },
  {
   "texto": "Jen neprodlévej, skoč a pojď,"
  },
  {
   "texto": "dnes ještě budeš moje choť!“"
  },
  {
   "texto": "Byla noc, byla hluboká,"
  },
  {
   "texto": "měsíček svítil z vysoka"
  },
  {
   "texto": "a ticho, pusto v dědině,"
  },
  {
   "texto": "vítr burácel jedině."
  },
  {
   "texto": "A on tu napřed — skok a skok,"
  },
  {
   "texto": "a ona za ním, co jí krok."
  },
  {
   "texto": "Psi houfem ve vsi zavyli,"
  },
  {
   "texto": "když ty pocestné zvětřili;"
  },
  {
   "texto": "a vyli, vyli divnou věc:"
  },
  {
   "texto": "že tě nablízku umrlec!"
  },
  {
   "texto": "„Pěkná noc, jasná — v tu dobu"
  },
  {
   "texto": "vstávají mrtví ze hrobů,"
  },
  {
   "texto": "a nežli zvíš, jsou tobě blíž —"
  },
  {
   "texto": "má milá, nic se nebojíš?“"
  },
  {
   "texto": "„Což bych se bála? Tys se mnou,"
  },
  {
   "texto": "a oko boží nade mnou. —"
  },
  {
   "texto": "Pověz, můj milý, řekni přec,"
  },
  {
   "texto": "živ-li a zdráv je tvůj otec?"
  },
  {
   "texto": "Tvůj otec a tvá milá máť,"
  },
  {
   "texto": "a ráda-li mě bude znáť?“"
  },
  {
   "texto": "„Moc, má panenko, moc se ptáš,"
  },
  {
   "texto": "jen honem pojď — však uhlídáš."
  },
  {
   "texto": "Jen honem pojď — čas nečeká,"
  },
  {
   "texto": "a cesta naše daleká."
  },
  {
   "texto": "Co máš, má milá, v pravici?“"
  },
  {
   "texto": "„Nesu si knížky modlicí.“"
  },
  {
   "texto": "„Zahoď je pryč, to modlení"
  },
  {
   "texto": "je těžší nežli kamení!"
  },
  {
   "texto": "Zahoď je pryč, ať lehce jdeš,"
  },
  {
   "texto": "jestli mi postačiti chceš.“"
  },
  {
   "texto": "Knížky jí vzal a zahodil,"
  },
  {
   "texto": "a byli skokem deset mil."
  },
  {
   "texto": "A byla cesta výšinou,"
  },
  {
   "texto": "skalami, lesní pustinou;"
  },
  {
   "texto": "a v rokytí a v úskalí"
  },
  {
   "texto": "divoké feny štěkaly;"
  },
  {
   "texto": "a kulich hlásal pověsti:"
  },
  {
   "texto": "že tě nablízku neštěstí. —"
  },
  {
   "texto": "A on vždy napřed — skok a skok,"
  },
  {
   "texto": "a ona za ním, co jí krok."
  },
  {
   "texto": "Po šípkoví a po skalí"
  },
  {
   "texto": "ty bílé nohy šlapaly;"
  },
  {
   "texto": "a na hloží a křemení"
  },
  {
   "texto": "zůstalo krve znamení."
  },
  {
   "texto": "„Pěkná noc, jasná — v tento čas"
  },
  {
   "texto": "mrtví s živými chodí zas;"
  },
  {
   "texto": "a nežli zvíš, jsou tobě blíž —"
  },
  {
   "texto": "má milá, nic se nebojíš?“"
  },
  {
   "texto": "„Což bych se bála? Tys se mnou,"
  },
  {
   "texto": "a ruka Páně nade mnou. —"
  },
  {
   "texto": "Pověz, můj milý, řekni jen,"
  },
  {
   "texto": "jak je tvůj domek upraven?"
  },
  {
   "texto": "Čistá světnička? Veselá?"
  },
  {
   "texto": "A zdali blízko kostela?“"
  },
  {
   "texto": "„Moc, má panenko, moc se ptáš,"
  },
  {
   "texto": "však ještě dnes to uhlídáš."
  },
  {
   "texto": "Jen honem pojď — čas utíká,"
  },
  {
   "texto": "a dálka ještě veliká."
  },
  {
   "texto": "Co máš, má milá, za pasem?“"
  },
  {
   "texto": "„Růženec s sebou vzala jsem.“"
  },
  {
   "texto": "„Ho, ten růženec z klokočí"
  },
  {
   "texto": "jako had tebe otočí!"
  },
  {
   "texto": "Zúží tě, stáhne tobě dech:"
  },
  {
   "texto": "zahoď jej pryč — neb máme spěch!“"
  },
  {
   "texto": "Růženec popad, zahodil,"
  },
  {
   "texto": "a byli skokem dvacet mil."
  },
  {
   "texto": "A byla cesta nížinou,"
  },
  {
   "texto": "přes vody, luka, bažinou;"
  },
  {
   "texto": "a po bažině, po sluji"
  },
  {
   "texto": "modrá světélka laškují:"
  },
  {
   "texto": "dvě řady, devět za sebou,"
  },
  {
   "texto": "jako když s tělem k hrobu jdou;"
  },
  {
   "texto": "a žabí havěť v potoce"
  },
  {
   "texto": "pohřební píseň skřehoce. —"
  },
  {
   "texto": "A on vždy napřed — skok a skok,"
  },
  {
   "texto": "a jí za ním již slábne krok."
  },
  {
   "texto": "Ostřice dívku ubohou"
  },
  {
   "texto": "břitvami řeže do nohou;"
  },
  {
   "texto": "a to kapradí zelené"
  },
  {
   "texto": "je krví její zbarvené."
  },
  {
   "texto": "„Pěkná noc, jasná — v tu dobu"
  },
  {
   "texto": "spěchají živí ke hrobu;"
  },
  {
   "texto": "a nežli zvíš, jsi hrobu blíž —"
  },
  {
   "texto": "má milá, nic se nebojíš?“"
  },
  {
   "texto": "„Ach nebojím, vždyť tys se mnou,"
  },
  {
   "texto": "a vůle Páně nade mnou!"
  },
  {
   "texto": "Jen ustaň málo v pospěchu,"
  },
  {
   "texto": "jen popřej málo oddechu."
  },
  {
   "texto": "Duch slábne, nohy klesají,"
  },
  {
   "texto": "a k srdci nože bodají!“"
  },
  {
   "texto": "„Jen pojď a pospěš, děvče mé,"
  },
  {
   "texto": "však brzo již tam budeme."
  },
  {
   "texto": "Hosté čekají, čeká kvas,"
  },
  {
   "texto": "a jako střela letí čas. —"
  },
  {
   "texto": "Co to máš na té tkaničce"
  },
  {
   "texto": "na krku na té tkaničce?“"
  },
  {
   "texto": "„To křížek po mé matičce.“"
  },
  {
   "texto": "„Hoho, to zlato proklaté"
  },
  {
   "texto": "má hrany ostře špičaté!"
  },
  {
   "texto": "Bodá tě — a mě nejinak,"
  },
  {
   "texto": "zahoď to, budeš jako pták!"
  },
  {
   "texto": "Křížek utrh a zahodil,"
  },
  {
   "texto": "a byli skokem třicet mil. —"
  },
  {
   "texto": "Tu na planině široké"
  },
  {
   "texto": "stavení stojí vysoké;"
  },
  {
   "texto": "úzká a dlouhá okna jsou,"
  },
  {
   "texto": "a věž se zvonkem nad střechou."
  },
  {
   "texto": "„Hoj, má panenko, tu jsme již!"
  },
  {
   "texto": "Nic, má panenko, nevidíš?“"
  },
  {
   "texto": "„Ach proboha, ten kostel snad?“"
  },
  {
   "texto": "„To není kostel, to můj hrad!“"
  },
  {
   "texto": "„Ten hřbitov — a těch křížů řad?“"
  },
  {
   "texto": "„To nejsou kříže, to můj sad!"
  },
  {
   "texto": "Hoj, má panenko, na mě hleď"
  },
  {
   "texto": "a skoč vesele přes tu zeď!“"
  },
  {
   "texto": "„Ó nech mne již, ó nech mne tak!"
  },
  {
   "texto": "Divý a hrozný je tvůj zrak;"
  },
  {
   "texto": "tvůj dech otravný jako jed,"
  },
  {
   "texto": "a tvoje srdce tvrdý led!“"
  },
  {
   "texto": "„Nic se, má milá, nic neboj!"
  },
  {
   "texto": "Veselo u mne, všeho hoj:"
  },
  {
   "texto": "masa dost — ale bez krve,"
  },
  {
   "texto": "dnes bude jinak poprvé! —"
  },
  {
   "texto": "Co máš v uzlíku, má milá?“"
  },
  {
   "texto": "„Košile, co jsem ušila.“"
  },
  {
   "texto": "„Netřeba jich víc nežli dvě:"
  },
  {
   "texto": "ta jedna tobě, druhá mně.“"
  },
  {
   "texto": "Uzlík jí vzal a s chechtotem"
  },
  {
   "texto": "přehodil na hrob za plotem."
  },
  {
   "texto": "„Nic ty se neboj, na mě hleď"
  },
  {
   "texto": "a skoč za uzlem přes tu zeď.“"
  },
  {
   "texto": "„Však jsi ty vždy byl přede mnou,"
  },
  {
   "texto": "a já za tebou cestou zlou;"
  },
  {
   "texto": "však jsi byl napřed po ten čas:"
  },
  {
   "texto": "skoč a ukaž mi cestu zas!“"
  },
  {
   "texto": "Skokem přeskočil ohradu,"
  },
  {
   "texto": "nic nepomyslil na zradu;"
  },
  {
   "texto": "skočil do výše sáhů pět —"
  },
  {
   "texto": "jí však již venku nevidět:"
  },
  {
   "texto": "jenom po bílém obleku"
  },
  {
   "texto": "zablesklo se jest v útěku,"
  },
  {
   "texto": "a schrána její blízko dost —"
  },
  {
   "texto": "nenadál se zlý její host!"
  },
  {
   "texto": "Stojíť tu, stojí komora:"
  },
  {
   "texto": "nizoučké dvéře — závora;"
  },
  {
   "texto": "zavrzly dvéře za pannou"
  },
  {
   "texto": "a závora jí ochranou."
  },
  {
   "texto": "Stavení skrovné, bez oken,"
  },
  {
   "texto": "měsíc lištami šeřil jen;"
  },
  {
   "texto": "stavení pevné jako klec,"
  },
  {
   "texto": "a v něm na prkně — umrlec."
  },
  {
   "texto": "Hoj, jak se venku vzmáhá hluk,"
  },
  {
   "texto": "hrobových oblud mocný pluk;"
  },
  {
   "texto": "šumí a kolem klapají"
  },
  {
   "texto": "a takto píseň skuhrají:"
  },
  {
   "texto": "„Tělu do hrobu přísluší,"
  },
  {
   "texto": "běda, kdos nedbal o duši!“"
  },
  {
   "texto": "A tu na dvéře: buch, buch, buch!"
  },
  {
   "texto": "burácí zvenčí její druh:"
  },
  {
   "texto": "„Vstávej, umrlče, nahoru,"
  },
  {
   "texto": "odstrč mi tam tu závoru!“"
  },
  {
   "texto": "A mrtvý oči otvírá,"
  },
  {
   "texto": "a mrtvý oči protírá,"
  },
  {
   "texto": "sbírá se, hlavu pozvedá"
  },
  {
   "texto": "a půlkolem se ohlédá."
  },
  {
   "texto": "„Bože svatý, rač pomoci,"
  },
  {
   "texto": "nedej mne ďáblu do moci! —"
  },
  {
   "texto": "Ty mrtvý, lež a nevstávej,"
  },
  {
   "texto": "pánbůh ti pokoj věčný dej!“"
  },
  {
   "texto": "A mrtvý hlavu položiv,"
  },
  {
   "texto": "zamhouřil oči jako dřív. —"
  },
  {
   "texto": "A tu poznovu — buch, buch, buch!"
  },
  {
   "texto": "silněji tluče její druh:"
  },
  {
   "texto": "„Vstávej, umrlče, nahoru,"
  },
  {
   "texto": "otevři mi svou komoru!“"
  },
  {
   "texto": "A na ten hřmot a na ten hlas"
  },
  {
   "texto": "mrtvý se zdvihá z prkna zas"
  },
  {
   "texto": "a rámě ztuhlé naměří"
  },
  {
   "texto": "tam, kde závora u dveří."
  },
  {
   "texto": "„Spas duši, Kriste Ježíši,"
  },
  {
   "texto": "smiluj se v bídě nejvyšší! —"
  },
  {
   "texto": "Ty mrtvý, nevstávej a lež;"
  },
  {
   "texto": "pánbůh tě potěš — a mne též!“"
  },
  {
   "texto": "A mrtvý zas se položiv,"
  },
  {
   "texto": "natáhnul údy jako dřív. —"
  },
  {
   "texto": "A znova venku: buch, buch, buch!"
  },
  {
   "texto": "a panně mizí zrak i sluch!"
  },
  {
   "texto": "„Vstávej, umrlče, hola hou,"
  },
  {
   "texto": "a podej mi sem tu živou!“"
  },
  {
   "texto": "Ach běda, běda děvčeti!"
  },
  {
   "texto": "Umrlý vstává potřetí"
  },
  {
   "texto": "a velké, kalné své oči"
  },
  {
   "texto": "na polomrtvou otočí."
  },
  {
   "texto": "„Maria Panno, při mně stůj,"
  },
  {
   "texto": "u syna svého oroduj!"
  },
  {
   "texto": "Nehodně jsem tě prosila:"
  },
  {
   "texto": "ach odpusť, co jsem zhřešila!"
  },
  {
   "texto": "Maria, matko milosti,"
  },
  {
   "texto": "z té moci zlé mě vyprosti.“"
  },
  {
   "texto": "A slyš, tu právě nablízce"
  },
  {
   "texto": "kokrhá kohout ve vísce;"
  },
  {
   "texto": "a za ním, co ta dědina,"
  },
  {
   "texto": "všecka kohoutí družina."
  },
  {
   "texto": "Tu mrtvý, jak se postavil,"
  },
  {
   "texto": "pádem se na zem povalil,"
  },
  {
   "texto": "a venku ticho — ani ruch:"
  },
  {
   "texto": "zmizel dav, i zlý její druh. —"
  },
  {
   "texto": "Ráno když lidé na mši jdou,"
  },
  {
   "texto": "v úžasu státi zůstanou:"
  },
  {
   "texto": "hrob jeden dutý nahoře,"
  },
  {
   "texto": "panna v umrlčí komoře,"
  },
  {
   "texto": "a na každičké mohyle"
  },
  {
   "texto": "útržek z nové košile. —"
  },
  {
   "texto": "Dobře ses, panno, radila,"
  },
  {
   "texto": "na boha že jsi myslila"
  },
  {
   "texto": "a druha zlého odbyla!"
  },
  {
   "texto": "Bys byla jinak jednala,"
  },
  {
   "texto": "zle bysi byla skonala:"
  },
  {
   "texto": "tvé tělo bílé, spanilé,"
  },
  {
   "texto": "bylo by co ty košile!"
  }
 ]
}