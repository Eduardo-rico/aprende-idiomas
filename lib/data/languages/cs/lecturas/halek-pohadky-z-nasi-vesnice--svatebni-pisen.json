{
 "id": "halek-pohadky-z-nasi-vesnice--svatebni-pisen",
 "titulo": "Svatební píseň · Na číhané · Rouhač",
 "autor": "Vítězslav Hálek",
 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Poh%C3%A1dky_z_na%C5%A1%C3%AD_vesnice_(H%C3%A1lek)/Svatebn%C3%AD_p%C3%ADse%C5%88",
 "fuente": "cs.wikisource.org, «Pohádky z naší vesnice»",
 "licencia": "dominio público (autor muerto en 1874)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-pohadky-z-nasi-vesnice",
  "titulo": "Pohádky z naší vesnice",
  "orden": 13
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Svatební píseň"
  },
  {
   "texto": "Nad řekou skály našedlé,"
  },
  {
   "texto": "jim měsíc stříbrem polil hlavy,"
  },
  {
   "texto": "přišel hoch, tváře nabledlé,"
  },
  {
   "texto": "a v pláč tam vypuk’ usedavý."
  },
  {
   "texto": "„Ráno tě vedou k ženichu,"
  },
  {
   "texto": "já k houslím mám ti krátit cestu —“"
  },
  {
   "texto": "udusil pláč a za smíchu"
  },
  {
   "texto": "v nich hledal píseň pro nevěstu."
  },
  {
   "texto": "Hledal, až píseň vynašel,"
  },
  {
   "texto": "ta byla jeho život celý —"
  },
  {
   "texto": "bolestná jak ten jeho žel,"
  },
  {
   "texto": "jak orla žel, tak osamělý."
  },
  {
   "texto": "A když se mu zpěv ten vyprýštil,"
  },
  {
   "texto": "když uslyšel v něm život celý,"
  },
  {
   "texto": "život i píseň roztříštil,"
  },
  {
   "texto": "jak skalní orel osamělý."
  },
  {
   "texto": "Po skalách kráčí luny svit,"
  },
  {
   "texto": "a když se k ránu rozednilo,"
  },
  {
   "texto": "nevěsta nemůž’ pochopit —"
  },
  {
   "texto": "a přec to všecko pravda bylo."
  },
  {
   "texto": "Číhají dva loupežníci,"
  },
  {
   "texto": "mladý starci přes rámě,"
  },
  {
   "texto": "starce ptá se mladolící:"
  },
  {
   "texto": "„Na koho dnes číháme?“"
  },
  {
   "texto": "„Odloudil mi tvoji matku,"
  },
  {
   "texto": "a já číhal u lesů,"
  },
  {
   "texto": "až jsem uzrál na oprátku —"
  },
  {
   "texto": "tudy půjde od plesu."
  },
  {
   "texto": "Ale čeho při tom žel mi,"
  },
  {
   "texto": "já dřív sebe utratil,"
  },
  {
   "texto": "zvíře jsem, kus líté šelmy,"
  },
  {
   "texto": "aniž jsem mu oplatil."
  },
  {
   "texto": "Vlk mně v duši vyje děsně,"
  },
  {
   "texto": "jsme v něj oba zakletí —"
  },
  {
   "texto": "ouvozem až půjde těsně,"
  },
  {
   "texto": "per, až duše vyletí.“"
  },
  {
   "texto": "Skok, a starci hrdlo změří,"
  },
  {
   "texto": "dýka v ruce zakmitla:"
  },
  {
   "texto": "„Nač i mne zatáh’ jsi k zvěři?“"
  },
  {
   "texto": "Pral, až duše vylítla."
  },
  {
   "texto": "Jen nerad o tom povídám;"
  },
  {
   "texto": "jsem v písmech nesečtený,"
  },
  {
   "texto": "tak sotva k hrobu dohlídám,"
  },
  {
   "texto": "na toť za hrobu stěny."
  },
  {
   "texto": "Však to jsem slyšel na své uši,"
  },
  {
   "texto": "jak posmíval se lidské duši."
  },
  {
   "texto": "Byl v svaté zemi, na moři,"
  },
  {
   "texto": "znal města všeho světa,"
  },
  {
   "texto": "kde jaké z ledu pohoří,"
  },
  {
   "texto": "i v pouštích trávil léta;"
  },
  {
   "texto": "když mluvil, poslouchat až milo,"
  },
  {
   "texto": "a přec prý mu zde přeskočilo. —"
  },
  {
   "texto": "Nu, znáte kříž ten u pole;"
  },
  {
   "texto": "tam v bouři chuďas podlí,"
  },
  {
   "texto": "má sepjaté své mozole"
  },
  {
   "texto": "a ku Kristu se modlí."
  },
  {
   "texto": "On kolem jda, hned slovo zavdá:"
  },
  {
   "texto": "„Co ty se modlíš, není pravda.“"
  },
  {
   "texto": "Pak postavil se u kříže,"
  },
  {
   "texto": "jal rukou Krista nohu:"
  },
  {
   "texto": "„Když bůh je nám zde nejblíže,"
  },
  {
   "texto": "proč nemluvit jak k bohu?"
  },
  {
   "texto": "Já povím ti, jak bez nesnází"
  },
  {
   "texto": "se pravda na modlitbu sází."
  },
  {
   "texto": "Slyš bože, v kněží vnadidlo"
  },
  {
   "texto": "já nezahalím slova,"
  },
  {
   "texto": "ni v zvonění a v kadidlo,"
  },
  {
   "texto": "ni v roucha šarlatová,"
  },
  {
   "texto": "bych poslal ti to v lichém dechu,"
  },
  {
   "texto": "jak bys byl bohem jenom z plechu."
  },
  {
   "texto": "Nemám ni potisknutý list"
  },
  {
   "texto": "nechutných řečí sladem,"
  },
  {
   "texto": "jež my, jak neuměl bys číst,"
  },
  {
   "texto": "ti odříkáme ladem"
  },
  {
   "texto": "co liché modlení a zpěvy —"
  },
  {
   "texto": "když srdce nám o ničem neví."
  },
  {
   "texto": "Slyš bože, když se pomodlím"
  },
  {
   "texto": "zde za bídáka toho,"
  },
  {
   "texto": "neučiním to s pohodlím,"
  },
  {
   "texto": "jak ten, kdo slov dá mnoho,"
  },
  {
   "texto": "ač všichni tvoji zpovědníci"
  },
  {
   "texto": "ti neřeknou, co on chce říci."
  },
  {
   "texto": "Viz, člověk on, k tvé podobě,"
  },
  {
   "texto": "tvých světel, sluncí brachem,"
  },
  {
   "texto": "a zkormoucený, ve mdlobě"
  },
  {
   "texto": "tě líbá tu tvým prachem,"
  },
  {
   "texto": "a druzí z podob tvých, kde mohou,"
  },
  {
   "texto": "jak červa přišlápnou jej nohou."
  },
  {
   "texto": "Jeť zkroušen, sešlý na duchu,"
  },
  {
   "texto": "list nalomený, chřadne,"
  },
  {
   "texto": "a tys tam jako bez sluchu,"
  },
  {
   "texto": "máš blesky, srdce žádné —"
  },
  {
   "texto": "hle, čím ti duše nesmrtelná,"
  },
  {
   "texto": "když v něm již mrtvá, bezúčelná!"
  },
  {
   "texto": "Čím ti ta duše? Z pramenů"
  },
  {
   "texto": "tvých světel má svou pýchu,"
  },
  {
   "texto": "leč stvořiteli samému"
  },
  {
   "texto": "zdaž není jako k smíchu:"
  },
  {
   "texto": "kdo z darů tvých jen bídu měří,"
  },
  {
   "texto": "a přec se modlí, v tebe věří!"
  },
  {
   "texto": "Co ti ta duše! Nad světy"
  },
  {
   "texto": "to hrdé svoje dílo"
  },
  {
   "texto": "když ceníš jen dle žebroty —"
  },
  {
   "texto": "viz, tu se nezdařilo!"
  },
  {
   "texto": "Tu leží v slzách, zlopocené,"
  },
  {
   "texto": "a to že je ti drahocenné?"
  },
  {
   "texto": "Slyš bože! Snad jsi uvyklý"
  },
  {
   "texto": "jen mluvě licoměrné,"
  },
  {
   "texto": "však já jsem blesky proniklý,"
  },
  {
   "texto": "jak to tvé nebe černé;"
  },
  {
   "texto": "a hřích-li mluvit pravým steskem,"
  },
  {
   "texto": "zde stojím, zahlaď mne svým bleskem!“ —"
  },
  {
   "texto": "Tak skončil, já jak z kamene"
  },
  {
   "texto": "jsem stál tu, vše to slyše,"
  },
  {
   "texto": "však chuďas oči znavené"
  },
  {
   "texto": "vznes’ vlhké, teplé výše,"
  },
  {
   "texto": "a co kdy vzdechů slzou odlil,"
  },
  {
   "texto": "prý jakživ tak se nepomodlil."
  },
  {
   "texto": "Nu kdož to ví. Jak povídám,"
  },
  {
   "texto": "on živ byl léta dlouhá,"
  },
  {
   "texto": "a od kněží se dovídám,"
  },
  {
   "texto": "že člověk tím se rouhá;"
  },
  {
   "texto": "byl moudrý, sečtený až milo,"
  },
  {
   "texto": "a přec prý mu zde přeskočilo."
  }
 ]
}