 "parrafos": [
  {
   "texto": "Jde Petr stísněn od fary:"
  },
  {
   "texto": "syn mu se pověsil k trámu,"
  },
  {
   "texto": "on nesmí dát ho na máry,"
  },
  {
   "texto": "má za zdí kopat mu jámu."
  },
  {
   "texto": "Kop’ Petr, hovor zapřede,"
  },
  {
   "texto": "však slzou promočil slova:"
  },
  {
   "texto": "„Já věděl, kam to povede,"
  },
  {
   "texto": "když holkou sfantí se znova.“"
  },
  {
   "texto": "Kop’ Petr, zem jak z plamene,"
  },
  {
   "texto": "ji slzou k dítěti světí:"
  },
  {
   "texto": "„Ach farář — ten je z kamene,"
  },
  {
   "texto": "jak každý, kdo nemá dětí.“"
  },
  {
   "texto": "Již dvacet rokův jediný"
  },
  {
   "texto": "všem hřbitov na rovy brázdí,"
  },
  {
   "texto": "jen zbytkům té své rodiny"
  },
  {
   "texto": "má lože ustlati za zdí."
  },
  {
   "texto": "Již dvacet let má k hrobům klíč"
  },
  {
   "texto": "a farář hroby ty kropí,"
  },
  {
   "texto": "jen syna zahrabat má rýč,"
  },
  {
   "texto": "jak smeť když do díry klopí."
  },
  {
   "texto": "Svým Petr tělem přikryl rov,"
  },
  {
   "texto": "tam z dne se do noci modlí:"
  },
  {
   "texto": "„Vždyť, bože, byl on ryzí kov,"
  },
  {
   "texto": "nebť nebyl v myšlení podlý.“ —"
  },
  {
   "texto": "Cos náhle tak vesel, hrobníku?"
  },
  {
   "texto": "Slyš, zvoní faráři hrany,"
  },
  {
   "texto": "ej, zdvihá hrobník motyku —"
  },
  {
   "texto": "hrob kope na čtyry strany."
  },
  {
   "texto": "Jdou knězi v žalmech ke hrobu —"
  },
  {
   "texto": "ej, máte svěcené vody,"
  },
  {
   "texto": "jak pro dva, pro tři, v zásobu,"
  },
  {
   "texto": "tak jako na velké hody!"
  },
  {
   "texto": "Ej, slaví Petr velký den,"
  },
  {
   "texto": "dnes dlí i na hrobech v noci —"
  },
  {
   "texto": "onť mrtvý dech a mrtvý sen"
  },
  {
   "texto": "jak král má v jediné moci."
  },
  {
   "texto": "Neb on kde dům jim postaví,"
  },
  {
   "texto": "tam v tlení těší se, trudí,"
  },
  {
   "texto": "až je z té noci vybaví"
  },
  {
   "texto": "a na kost hubené zbudí."
  },
  {
   "texto": "Onť svrchovaný hrobů pán —"
  },
  {
   "texto": "dnes moc svou k údechu slaví:"
  },
  {
   "texto": "kdo v zemi pusté pochován,"
  },
  {
   "texto": "dnes v zem jej svěcenou staví."
  },
  {
   "texto": "Tak probděl noc až do rána,"
  },
  {
   "texto": "až mrkla dennice bledá:"
  },
  {
   "texto": "dnes duše z hvězd mu setkána,"
  },
  {
   "texto": "dnes jej to k nebesům zvedá!"
  }
 ]
}