 "parrafos": [
  {
   "texto": "Nadšení"
  },
  {
   "texto": "Svaté ty nadšení,"
  },
  {
   "texto": "nebeský plameni,"
  },
  {
   "texto": "šlehni nám do srdcí,"
  },
  {
   "texto": "otčinou vzplaň!"
  },
  {
   "texto": "Bez tebe nevzniká"
  },
  {
   "texto": "myšlénka veliká,"
  },
  {
   "texto": "v tobě jen kuje se"
  },
  {
   "texto": "vítězná zbraň."
  },
  {
   "texto": "Sloupem tys ohnivým,"
  },
  {
   "texto": "oblakem zářivým,"
  },
  {
   "texto": "vedoucím národy"
  },
  {
   "texto": "v slíbenou zem;"
  },
  {
   "texto": "bez tebe pustinou"
  },
  {
   "texto": "širý svět jedinou,"
  },
  {
   "texto": "lidstvo se potácí"
  },
  {
   "texto": "bez cíle v něm."
  },
  {
   "texto": "Báječné poklady,"
  },
  {
   "texto": "žulové ohrady,"
  },
  {
   "texto": "nesčetných zástupů"
  },
  {
   "texto": "válečný třesk,"
  },
  {
   "texto": "odvaha, vtip a lest -"
  },
  {
   "texto": "bez ceny všecno jest,"
  },
  {
   "texto": "neplá-li na skráních"
  },
  {
   "texto": "svatý tvůj blesk."
  },
  {
   "texto": "Tebou jen do světa"
  },
  {
   "texto": "zasvitla osvěta,"
  },
  {
   "texto": "prapory tyranství"
  },
  {
   "texto": "strhány v cár;"
  },
  {
   "texto": "národů mrákotu"
  },
  {
   "texto": "rozjasnil k životu,"
  },
  {
   "texto": "rozpadlé sjednotil"
  },
  {
   "texto": "božský tvůj žár."
  },
  {
   "texto": "Kdysi též k Vltavě"
  },
  {
   "texto": "v krvavé záplavě"
  },
  {
   "texto": "z kostnické hranice"
  },
  {
   "texto": "plápol tvůj vlet’,"
  },
  {
   "texto": "v tábory dědiny,"
  },
  {
   "texto": "oráče v hrdiny"
  },
  {
   "texto": "proměnil, cepem jich"
  },
  {
   "texto": "pokořil svět."
  },
  {
   "texto": "Svaté ty nadšení,"
  },
  {
   "texto": "nebeský plameni,"
  },
  {
   "texto": "opět k nám prošlehni"
  },
  {
   "texto": "malátnou hruď,"
  },
  {
   "texto": "na místo těkavých"
  },
  {
   "texto": "bludiček, mrkavých,"
  },
  {
   "texto": "Vůdcem nám ohnivým"
  },
  {
   "texto": "ku slávě buď!"
  },
  {
   "texto": "Jsme slabí, malí — Dosti těchto řečí!"
  },
  {
   "texto": "Jen kdo tak zoufá, sláb a malý jest."
  },
  {
   "texto": "Oč byla Hellas, byla Róma větší,"
  },
  {
   "texto": "než skrání nesmrtnou se dotkla hvězd?"
  },
  {
   "texto": "Jak směšné byly našich předků cepy,"
  },
  {
   "texto": "když celý svět se zdvihl proti nim,"
  },
  {
   "texto": "a hle! svět celý zdrtil vůdce slepý"
  },
  {
   "texto": "a Táboru se klonil věčný Řím."
  },
  {
   "texto": "Jen v srdce zápal, chrabrost bohatýrů"
  },
  {
   "texto": "a budem vojsko netušených sil!"
  },
  {
   "texto": "Sláb jenom ten, kdo ztratil v sebe víru,"
  },
  {
   "texto": "a malým ten, kdo zná jen malý cíl."
  },
  {
   "texto": "Nevěřme nikomu na světě širém,"
  },
  {
   "texto": "nemáme jednoho přítele tam,"
  },
  {
   "texto": "starý boj za každým skrývá se mírem,"
  },
  {
   "texto": "soucit a přízeň jsou šalebný klam,"
  },
  {
   "texto": "nevěřme radě, ni chvále ni haně,"
  },
  {
   "texto": "nevěříme pocelu, stisknutí dlaně,"
  },
  {
   "texto": "nevěřme ničemu - všechno je mam."
  },
  {
   "texto": "Všude nám hrozí zášť lítého vraha,"
  },
  {
   "texto": "dýku on skrývá i pod vábný kroj,"
  },
  {
   "texto": "zhubit nás věčná mu, jediná snaha,"
  },
  {
   "texto": "proti nám svata mu všeliká zbroj:"
  },
  {
   "texto": "plápolem válečným, osvěty třpytem,"
  },
  {
   "texto": "v násilí zjevném i v úskoku skrytém"
  },
  {
   "texto": "bez klidu vede ten odvěký boj."
  },
  {
   "texto": "Nevěřte! Baltu k nám peřeje hučí,"
  },
  {
   "texto": "nevěřte! z jihu zní Adrie hlas,"
  },
  {
   "texto": "nevěřte! minulé věky nás učí,"
  },
  {
   "texto": "stále též varuje přítomný čas -"
  },
  {
   "texto": "Na bratří zklamaných ohromném rovu"
  },
  {
   "texto": "každým dnem úskočně klamáni znovu"
  },
  {
   "texto": "či chcete, bláhoví, věřiti zas?"
  },
  {
   "texto": "Jde-li kdo s pozdravem k našemu domu,"
  },
  {
   "texto": "zve-li nás úsměvně pod vlastní krov,"
  },
  {
   "texto": "nevěřme pozdravu, úsměvu tomu,"
  },
  {
   "texto": "nevěřme nástraze lahodných slov,"
  },
  {
   "texto": "nevěřme slibům ni přísahám svatým,"
  },
  {
   "texto": "slavně nechť hlaholí nad stolcem zlatým,"
  },
  {
   "texto": "ruce nechť královské píší je v kov."
  },
  {
   "texto": "Věřme jen sobě, své práci a píli,"
  },
  {
   "texto": "věřme jen svatému nadšení v nás,"
  },
  {
   "texto": "věřme jen vítězství slovanské síly,"
  },
  {
   "texto": "která si podepře krajní tu hráz,"
  },
  {
   "texto": "věřme, že národ náš, veliká Sláva"
  },
  {
   "texto": "s korouhví lidskosti za štítem práva"
  },
  {
   "texto": "dobude korunu velebných krás!"
  }
 ]
