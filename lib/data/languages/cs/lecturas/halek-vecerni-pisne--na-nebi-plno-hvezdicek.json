 "parrafos": [
  {
   "texto": "Na nebi plno hvězdiček"
  },
  {
   "texto": "Na nebi plno hvězdiček"
  },
  {
   "texto": "jak z jara sedmikrásky;"
  },
  {
   "texto": "ba na tom božím světě zde"
  },
  {
   "texto": "má vše svou mluvu lásky."
  },
  {
   "texto": "Fialka plna vůně jest,"
  },
  {
   "texto": "kalíšek rosou máčí,"
  },
  {
   "texto": "a slavík ten se nazpívá,"
  },
  {
   "texto": "div hrdélko mu stačí."
  },
  {
   "texto": "Na nebi plno hvězdiček"
  },
  {
   "texto": "v velebném světle kráčí,"
  },
  {
   "texto": "a lidé tady na zemi"
  },
  {
   "texto": "ti zpívají a pláčí."
  },
  {
   "texto": "Na nebi měsíc s hvězdami,"
  },
  {
   "texto": "a v lese plno hlásků,"
  },
  {
   "texto": "a na ten širošírý svět"
  },
  {
   "texto": "jak Bůh by rozlil lásku."
  },
  {
   "texto": "Těch mladých lístků různý hlas"
  },
  {
   "texto": "se v sladký hovor mění,"
  },
  {
   "texto": "celý svět jak by rozkochán"
  },
  {
   "texto": "rozplývá v políbení."
  },
  {
   "texto": "A přece vím, že v samotě"
  },
  {
   "texto": "se mnohé srdce trápí,"
  },
  {
   "texto": "a mnohá tvář že mladistvá"
  },
  {
   "texto": "se v hořkých slzách stápí."
  },
  {
   "texto": "Sluneční žár o poledni —"
  },
  {
   "texto": "to žhoucí láska moje,"
  },
  {
   "texto": "a noc — dne šerokrásný stín —"
  },
  {
   "texto": "to tichá láska Tvoje."
  },
  {
   "texto": "Tys velký oheň znítila"
  },
  {
   "texto": "jak země centrum žhavý,"
  },
  {
   "texto": "leč oheň Tebou nekojen"
  },
  {
   "texto": "teď sám se v sobě tráví."
  },
  {
   "texto": "Já s láskou Tvou chtěl hodovat,"
  },
  {
   "texto": "však mně jen drobty padly,"
  },
  {
   "texto": "a proto sám se nedivím,"
  },
  {
   "texto": "že tváře moje vadly."
  },
  {
   "texto": "Leč srdce mnoho přetrpí,"
  },
  {
   "texto": "je nemoc krotí mocí,"
  },
  {
   "texto": "a já se věru neznám víc,"
  },
  {
   "texto": "zda jsem víc dnem či nocí."
  },
  {
   "texto": "Tak psáno jest. A den a noc"
  },
  {
   "texto": "se věčně, věčně minou,"
  },
  {
   "texto": "jen jedno jim políbení —"
  },
  {
   "texto": "když večer v jedno splynou."
  },
  {
   "texto": "Čím srdce, čím jsi zhřešilo,"
  },
  {
   "texto": "můj Bože, tolik bolu,"
  },
  {
   "texto": "že věčně jen se loučit má,"
  },
  {
   "texto": "co věčně má být spolu?"
  },
  {
   "texto": "Jak krásný by ten život byl"
  },
  {
   "texto": "u věčném milování!"
  },
  {
   "texto": "Však věčně musit prahnout jen"
  },
  {
   "texto": "jaké v tom požehnání?"
  },
  {
   "texto": "A kdyby vše potěšení"
  },
  {
   "texto": "v tom světě bylo vzato,"
  },
  {
   "texto": "a jenom láska zůstala —"
  },
  {
   "texto": "ten život stál by za to."
  },
  {
   "texto": "A kdyby pravda bylo vše"
  },
  {
   "texto": "a láska jenom snění —"
  },
  {
   "texto": "já bych se k spánku položil"
  },
  {
   "texto": "a nechtěl probuzení."
  },
  {
   "texto": "A jestliže jsem posud snil —"
  },
  {
   "texto": "tož snil jsem sladce, mile,"
  },
  {
   "texto": "a věčně nezapomenu,"
  },
  {
   "texto": "kdo usnil mne v ty chvíle."
  }
 ]
}