 "modo": "texto",
 "parrafos": [
  {
   "texto": "1"
  },
  {
   "texto": "Letní Ty noci zářivá,"
  },
  {
   "texto": "jakž Tebou srdce okřívá —"
  },
  {
   "texto": "ve dne tak sladkobolno,"
  },
  {
   "texto": "a teď tak volno, volno!"
  },
  {
   "texto": "S oblohy bílý měsíček,"
  },
  {
   "texto": "starobný nebes tatíček,"
  },
  {
   "texto": "stříbrné světla pýří"
  },
  {
   "texto": "po celém světě šíří."
  },
  {
   "texto": "Dokola jeho dětičky,"
  },
  {
   "texto": "drobounké, smavé hvězdičky,"
  },
  {
   "texto": "dukátkovými hlasy"
  },
  {
   "texto": "zvoní na krásné časy."
  },
  {
   "texto": "Když k Vám vesel hledím, zlatá Vy kuřátka,"
  },
  {
   "texto": "slyším naše písně, česká zřím děvčátka."
  },
  {
   "texto": "Naše dívky slunce rannější bývají,"
  },
  {
   "texto": "ve potoku chladném oči si mývají."
  },
  {
   "texto": "V noci krásné hvězdy do vody naprší —"
  },
  {
   "texto": "běda hochu, na nějž oči ty zasrší!"
  },
  {
   "texto": "Ach, jaké to blaho: poležet"
  },
  {
   "texto": "zde na drnu poblíž boru"
  },
  {
   "texto": "a s zlatými dát se hvězdami"
  },
  {
   "texto": "do šeptného rozhovoru!"
  },
  {
   "texto": "Ty třepotné, smavé hvězdičky"
  },
  {
   "texto": "tak čiperně na mne hledí —"
  },
  {
   "texto": "ach prosím vás, je to pravda vše,"
  },
  {
   "texto": "co lidé prý o vás vědí?"
  },
  {
   "texto": "Že maličké vy prý hvězdičky"
  },
  {
   "texto": "jste obrovská samá těla —"
  },
  {
   "texto": "a od jedné k druhé prý sto let"
  },
  {
   "texto": "a k některé věčnost celá?"
  },
  {
   "texto": "Což nevidím, jak jste drobounky"
  },
  {
   "texto": "a v jakém jste k sobě skladu? —"
  },
  {
   "texto": "já — nahoře být — bych kamenem"
  },
  {
   "texto": "vás přehodil celou řadu!"
  },
  {
   "texto": "A že prý jste věčném ve reji"
  },
  {
   "texto": "a přes steré skokem míle? —"
  },
  {
   "texto": "Ej musilo by tu hluku být"
  },
  {
   "texto": "a šumu za noční chvíle!"
  },
  {
   "texto": "A zatím tak němě spřádáte"
  },
  {
   "texto": "svou života tichou dumu —"
  },
  {
   "texto": "když vesele prstem zaluskám,"
  },
  {
   "texto": "je věru v tom více šumu!"
  },
  {
   "texto": "Což třepotá se to tu hvězdiček,"
  },
  {
   "texto": "jak včeliček ve vzlétlém roji! —"
  },
  {
   "texto": "Proč asi ta jedna jediná"
  },
  {
   "texto": "tam samotná povzdál stojí?"
  },
  {
   "texto": "Tak dumavě chvílemi v dáli zří"
  },
  {
   "texto": "a bleďoučké její jsou tváře,"
  },
  {
   "texto": "je patrně hvězda mlaďoučká"
  },
  {
   "texto": "dle dětinné v očku záře."
  },
  {
   "texto": "Jen někdy svůj doufavý vyšle hled"
  },
  {
   "texto": "a stoudně zas do nebe mrká —"
  },
  {
   "texto": "ba myslím, že také hvězdička"
  },
  {
   "texto": "jak hrdlička láskou vrká!"
  }
 ]
}