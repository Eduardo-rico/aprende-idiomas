 "modo": "texto",
 "parrafos": [
  {
   "texto": "30"
  },
  {
   "texto": "Děj Země je krátce jen vyprávěn,"
  },
  {
   "texto": "jak píseň se krátce skládá:"
  },
  {
   "texto": "vylétla jiskřička z plamenu,"
  },
  {
   "texto": "a zčernalá zpět zas padá."
  },
  {
   "texto": "A v jediném světem tom mihnutí,"
  },
  {
   "texto": "v tom kratičkém jiskry plání"
  },
  {
   "texto": "všecken si vyžije lidstvo boj,"
  },
  {
   "texto": "ba všechno i milování."
  },
  {
   "texto": "Tak krátká to, kratičká písnička,"
  },
  {
   "texto": "a může být ještě kratší,"
  },
  {
   "texto": "veliký lidské je lásky bol"
  },
  {
   "texto": "a několik slov naň stačí."
  },
  {
   "texto": "Snad stačila sloka by jediná,"
  },
  {
   "texto": "snad jediné slůvko pouze,"
  },
  {
   "texto": "do písně se to tak krátce dá -"
  },
  {
   "texto": "a žije se to tak dlouze."
  },
  {
   "texto": "Zelená hvězdo v zenitu,"
  },
  {
   "texto": "sviť vesele, vesele!"
  },
  {
   "texto": "Když si tak někdy vzpomenu,"
  },
  {
   "texto": "jak staří jsme přátelé!"
  },
  {
   "texto": "Před lety jsi mne slyšela,"
  },
  {
   "texto": "jak jasně jsem zavýsknul,"
  },
  {
   "texto": "když jsem své děvče poprvé"
  },
  {
   "texto": "si na prsa přitisknul."
  },
  {
   "texto": "Před lety jsi mne viděla,"
  },
  {
   "texto": "jak děsně jsem ublednul,"
  },
  {
   "texto": "mrtvou když její ručinku"
  },
  {
   "texto": "jsem k ústům svým pozvednul."
  },
  {
   "texto": "To jsou jen drobty života,"
  },
  {
   "texto": "jen bubliny pramene,"
  },
  {
   "texto": "člověk si na ně během let"
  },
  {
   "texto": "tak náhodou vzpomene."
  },
  {
   "texto": "Radost i žal my přežijem,"
  },
  {
   "texto": "my přežijem cokoli! -"
  },
  {
   "texto": "Nač ale náhlá slza ta -"
  },
  {
   "texto": "vždyť mne to už nebolí?"
  },
  {
   "texto": "Myslím, že malý Měsíček"
  },
  {
   "texto": "poety měl jen malé,"
  },
  {
   "texto": "naše že Země veliká"
  },
  {
   "texto": "poety má již krále."
  },
  {
   "texto": "Až i to Slunce obrovské"
  },
  {
   "texto": "života květ pokryje, -"
  },
  {
   "texto": "jaká tam budou srdce as,"
  },
  {
   "texto": "jaká v nich poezie!"
  },
  {
   "texto": "Jací tam velcí tvorové,"
  },
  {
   "texto": "jaké jich touhy vzdorné,"
  },
  {
   "texto": "jaké v jich očích myšlénky"
  },
  {
   "texto": "nezdolné, světoborné!"
  },
  {
   "texto": "Jaké tam citů záchvěvy,"
  },
  {
   "texto": "jaké tam v prsou běsy,"
  },
  {
   "texto": "jaký zas výblesk radosti,"
  },
  {
   "texto": "výskavé, šlehavé plesy!"
  },
  {
   "texto": "Jaká tam slova hluboká,"
  },
  {
   "texto": "jaká v nich nadšení záře!"
  },
  {
   "texto": "Jaká tam bujnost mladých těl,"
  },
  {
   "texto": "jaké tam oslnivé tváře!"
  },
  {
   "texto": "Jaké tam jasavé naděje,"
  },
  {
   "texto": "jaká tam lásky tíseň -"
  },
  {
   "texto": "chtěl bych za cenu života"
  },
  {
   "texto": "procítit slunečnou píseň!"
  }
 ]
}