 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Stojí hory proti sobě,"
  },
  {
   "texto": "z jedné k druhé mrak přepnutý"
  },
  {
   "texto": "je, co temný strop klenutý,"
  },
  {
   "texto": "jednu k druhé pevně víže."
  },
  {
   "texto": "Ouvalem tím v pozdní době"
  },
  {
   "texto": "ticho, temno jako v hrobě."
  },
  {
   "texto": "Za horami, kde pod mrakem"
  },
  {
   "texto": "ve vzdálí se rozestupují —"
  },
  {
   "texto": "v temné dálce, něco blíže"
  },
  {
   "texto": "než hory se sestupují,"
  },
  {
   "texto": "takže siným pod oblakem"
  },
  {
   "texto": "skály ouzkou bránu tvoří."
  },
  {
   "texto": "Za tou v dálce pode mrakem"
  },
  {
   "texto": "temnorudý požár hoří,"
  },
  {
   "texto": "dlouhý pruh v plamenné záři"
  },
  {
   "texto": "západní rozvinut stranou,"
  },
  {
   "texto": "po jehožto rudé tváři"
  },
  {
   "texto": "noční ptactvo kola vedší,"
  },
  {
   "texto": "jako by plamennou branou"
  },
  {
   "texto": "nyní v dálku zalétalo."
  },
  {
   "texto": "Hasnul požár — bledší — bledší,"
  },
  {
   "texto": "až se šírošíré nebe"
  },
  {
   "texto": "noční rosou rozplakalo,"
  },
  {
   "texto": "rozesmutnivši zem i sebe."
  },
  {
   "texto": "V hlubokém ouvalu klínu,"
  },
  {
   "texto": "ve stověkých dubů stínu,"
  },
  {
   "texto": "sbor u velkém kole sedí."
  },
  {
   "texto": "Zahalení v pláště bílé"
  },
  {
   "texto": "jsou to druzi noční chvíle."
  },
  {
   "texto": "Každý před se v zemi hledí"
  },
  {
   "texto": "beze slova, bez pohnutí,"
  },
  {
   "texto": "jak by kvapnou hrůzou jmutí"
  },
  {
   "texto": "v sochy byli proměnění."
  },
  {
   "texto": "Večerních co krajin pění."
  },
  {
   "texto": "tichý šepot — tiché lkání —"
  },
  {
   "texto": "nepohnutým kolem plynul,"
  },
  {
   "texto": "tichý šepot bez přestání:"
  },
  {
   "texto": "„Vůdce zhynul! — vůdce zhynul!“ —"
  },
  {
   "texto": "V kotouči jak vítr skučí,"
  },
  {
   "texto": "nepohnutým kolem zvučí:"
  },
  {
   "texto": "„Vůdce zhynul! — vůdce zhynul!“ —"
  },
  {
   "texto": "Jako listů šepotání"
  },
  {
   "texto": "pode skálou při ozvěně,"
  },
  {
   "texto": "znělo kolem bez přestání,"
  },
  {
   "texto": "jednozvučně, neproměnně:"
  },
  {
   "texto": "„Vůdce zhynul! — vůdce zhynul!“ —"
  },
  {
   "texto": "Zachvěly se lesy dalné,"
  },
  {
   "texto": "ozvaly se nářky valné:"
  },
  {
   "texto": "„Pán náš zhynul! — zhynul!! — zhynul!!!“"
  }
 ]
}