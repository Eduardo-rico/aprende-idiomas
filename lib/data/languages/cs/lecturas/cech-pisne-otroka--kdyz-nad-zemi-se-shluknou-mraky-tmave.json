  {
   "texto": "Když nad zemí se shluknou mraky tmavé"
  },
  {
   "texto": "jak v rozlíceném šiku satané,"
  },
  {
   "texto": "jich zahřmí štíty, vzplanou meče žhavé,"
  },
  {
   "texto": "tu vzhůru týčím ruce spoutané:"
  },
  {
   "texto": "Vstaň, bouře, v celé hrůze své a moci,"
  },
  {
   "texto": "všech živlů probuď nekonečný vztek,"
  },
  {
   "texto": "ať zem se chvěje v troskách, ohni, noci,"
  },
  {
   "texto": "v luh rozlije se moře, vodstvo řek!"
  },
  {
   "texto": "Co pána našeho, vše zpustoš valem,"
  },
  {
   "texto": "prsť odnes vlnami, v poušť luhy změň,"
  },
  {
   "texto": "sklať s větví květy a plod každý s palem,"
  },
  {
   "texto": "zlom, vyrvi z kořenů jich sličný peň!"
  },
  {
   "texto": "Báň zlatou rozbij s vížek zdobným tlumem,"
  },
  {
   "texto": "dům pánův nádherný svým ohněm strav"
  },
  {
   "texto": "a stropů mramorových dštícím rumem"
  },
  {
   "texto": "zdrť tyrana i drábů jeho dav!"
  },
  {
   "texto": "Kéž nepřítel se s živlů vztekem spojí,"
  },
  {
   "texto": "kol zuří pochodní a ocelem!"
  },
  {
   "texto": "Ať kdokoli — zdar budiž jeho zbroji:"
  },
  {
   "texto": "Kdo pána vrah, tenť naším přítelem."
  },
  {
   "texto": "I boha našeho nám určil pán"
  },
  {
   "texto": "a věřiti nám káže,"
  },
  {
   "texto": "že bohem tím bič v jeho ruku dán,"
  },
  {
   "texto": "nám v pouta spjato páže —"
  },
  {
   "texto": "Ó kořte se, ó klaňte se"
  },
  {
   "texto": "před Pánem hvězdné báně,"
  },
  {
   "texto": "ó kořte se, ó klaňte se"
  },
  {
   "texto": "před pánem v zemském láně;"
  },
  {
   "texto": "jen pokora i poslušnost"
  },
  {
   "texto": "otvírá nebes bránu"
  },
  {
   "texto": "a nekrásnější duše skvost"
  },
  {
   "texto": "je zbožná úcta k pánu."
  },
  {
   "texto": "Tak nejsvětější člověčenstva cit"
  },
  {
   "texto": "je v službách otrokáře,"
  },
  {
   "texto": "v líc samu božství věčného je vryt"
  },
  {
   "texto": "rys jeho zpupné tváře,"
  },
  {
   "texto": "a lichých kněží chórovod"
  },
  {
   "texto": "se shrbenými zády"
  },
  {
   "texto": "mu hymny pěje o závod,"
  },
  {
   "texto": "je sloupem jeho vlády,"
  },
  {
   "texto": "na každou hlavu volá zmar,"
  },
  {
   "texto": "jež volněji se vztyčí,"
  },
  {
   "texto": "a modlí se za jeho zdar"
  },
  {
   "texto": "a žehná jeho biči."
  },
  {
   "texto": "Ret velebného kdysi proroka"
  },
  {
   "texto": "všech lidí rovnost kázal"
  },
  {
   "texto": "a rozrážeje řetěz otroka"
  },
  {
   "texto": "vše lásky poutem vázal;"
  },
  {
   "texto": "leč jeho žáků lstivý sbor"
  },
  {
   "texto": "v rub jeho zákon zvrátil,"
  },
  {
   "texto": "nám bědným chválí svatý vzor,"
  },
  {
   "texto": "sám podíl moci schvátil,"
  },
  {
   "texto": "ve stínu přízně pánovy"
  },
  {
   "texto": "se těší mrzkým plenem"
  },
  {
   "texto": "a za to světí okovy"
  },
  {
   "texto": "jak v posměch mistra jmenem."
  },
  {
   "texto": "Ó bože náš, náš pravý bože, slyš!"
  },
  {
   "texto": "Ty bože chudých rabů,"
  },
  {
   "texto": "jenž do zlata svůj oltář nestrojíš,"
  },
  {
   "texto": "své kněží do hedvábu,"
  },
  {
   "texto": "jenž trůníš v kráse přírody"
  },
  {
   "texto": "a v prostých srdcí tluku:"
  },
  {
   "texto": "ty velký bože svobody,"
  },
  {
   "texto": "svou zdvihni mocnou ruku,"
  },
  {
   "texto": "z pout odvěkých nás vyprosti,"
  },
  {
   "texto": "vztyč z prachu naše hlavy"
  },
  {
   "texto": "a světu v chrámech volnosti"
  },
  {
   "texto": "svůj zvěstuj zákon pravý!"
  }
