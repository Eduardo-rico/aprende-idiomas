 "parrafos": [
  {
   "texto": "Petr usne, sotva lehne;"
  },
  {
   "texto": "sotva usne, sen se zvedne:"
  },
  {
   "texto": "náhlé světlo po krajině"
  },
  {
   "texto": "a tak jasno jako ve dne."
  },
  {
   "texto": "Petr celý vyjevený,"
  },
  {
   "texto": "rodinu zří v prostém stáji,"
  },
  {
   "texto": "dítě zrovna sluncem září –"
  },
  {
   "texto": "v Petrovi až dech se tají."
  },
  {
   "texto": "Vzduch je plný andělíčků,"
  },
  {
   "texto": "třpytí se a křídly šumí,"
  },
  {
   "texto": "každý zpívá haleluja,"
  },
  {
   "texto": "krásně, jak jen anděl umí."
  },
  {
   "texto": "A hle, od vesnice spěchá"
  },
  {
   "texto": "všechen lid s radostnou tváří,"
  },
  {
   "texto": "napřed muži, staří, mladí,"
  },
  {
   "texto": "v čele naši muzikáři."
  },
  {
   "texto": "Vašek velký buben tluče,"
  },
  {
   "texto": "Matěj troubí, Martin hude,"
  },
  {
   "texto": "Vojta na klarynet píská,"
  },
  {
   "texto": "Kuba měchem bas jim dude."
  },
  {
   "texto": "Aj ti hrajou – jako nikdy!"
  },
  {
   "texto": "tváře dmou se, lítá ruka –"
  },
  {
   "texto": "písnička tak mlaskně skočná,"
  },
  {
   "texto": "že až Petru nohou cuká."
  },
  {
   "texto": "Zmlkli. Z řady vystoup’ Brichta,"
  },
  {
   "texto": "vyšnořený, oholený,"
  },
  {
   "texto": "býval kaprál u hulánů,"
  },
  {
   "texto": "dnes je řečník vyvolený."
  },
  {
   "texto": "Postavil se, salutuje,"
  },
  {
   "texto": "hrubě spustil: „Kriste pane, –"
  },
  {
   "texto": "my nevíme, co je psáno,"
  },
  {
   "texto": "ale víme, co se stane."
  },
  {
   "texto": "Ty jsi – já jsem – ba jsme všichni –"
  },
  {
   "texto": "povídáme – k boží chvále –“"
  },
  {
   "texto": "v tom se zajik’ – jazyk ztrnul"
  },
  {
   "texto": "a nemůže o hles dále."
  },
  {
   "texto": "Ruka v úzkostech se svírá,"
  },
  {
   "texto": "ret se jako lupen chvěje –"
  },
  {
   "texto": "„„Ty’s to vyved’!““ Petr nahlas"
  },
  {
   "texto": "ze sna hulánu se směje."
  },
  {
   "texto": "Ježíšek však milostivě:"
  },
  {
   "texto": "„Všichni jste mé hodné děti,"
  },
  {
   "texto": "Vaše duše po skonání"
  },
  {
   "texto": "hupky na nebe si vletí.“"
  },
  {
   "texto": "A teď houfně zpívajíce"
  },
  {
   "texto": "předstupují hospodyně,"
  },
  {
   "texto": "podávají v pytlích, koších,"
  },
  {
   "texto": "dobrého co po dědině."
  },
  {
   "texto": "Máslo, jabka, marcipány,"
  },
  {
   "texto": "plátno, šátky, věci steré,"
  },
  {
   "texto": "Maria jim přikyvuje,"
  },
  {
   "texto": "Josef od nich dary bere."
  },
  {
   "texto": "„„Co je tohle?““ Petr náhle"
  },
  {
   "texto": "poulí svoje oči šedé."
  },
  {
   "texto": "Dvanáct panen třináctou si"
  },
  {
   "texto": "na růžové pentli vede."
  },
  {
   "texto": "Dvanáct panen, dvanáct růží."
  },
  {
   "texto": "„Děťátko ty nejjasnější,"
  },
  {
   "texto": "přivádíme Anduličku,"
  },
  {
   "texto": "že je z nás všech nejkrásnější.“"
  },
  {
   "texto": "„„To si myslím!““ Petr mručí. –"
  },
  {
   "texto": "„Anduličku k Tobě vedem,"
  },
  {
   "texto": "aby za nás všecky dala"
  },
  {
   "texto": "hubičku Ti jako s medem.“"
  },
  {
   "texto": "Andulička přistupuje,"
  },
  {
   "texto": "sotva ale hlavu níží,"
  },
  {
   "texto": "Ježíšek už ručky svoje"
  },
  {
   "texto": "kolem její šíje kříží."
  },
  {
   "texto": "Jak se směje, jak ji hladí,"
  },
  {
   "texto": "jak se k Andulince tulí –"
  },
  {
   "texto": "sotva dostal polibení,"
  },
  {
   "texto": "už zas znovu rtíky špulí."
  },
  {
   "texto": "Petr sebou hází, bručí,"
  },
  {
   "texto": "jako medvěd když se brání:"
  },
  {
   "texto": "„Matka na to mlčky hledí? –"
  },
  {
   "texto": "je to pěkné vychování!“"
  }
 ]
