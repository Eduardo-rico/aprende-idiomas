 "modo": "texto",
 "parrafos": [
  {
   "texto": "Nechť honců Arpádových vnuk"
  },
  {
   "texto": "svou patu v leb vám ryje,"
  },
  {
   "texto": "nechť vašim synům jarmo muk"
  },
  {
   "texto": "na měkké vkládá šíje,"
  },
  {
   "texto": "nechť sladkou řeč jim ze rtů rve"
  },
  {
   "texto": "a vraždí naše bratry:"
  },
  {
   "texto": "přec naše jste,"
  },
  {
   "texto": "vždy naše jstem,"
  },
  {
   "texto": "jste naše jen Ó Tatry!"
  },
  {
   "texto": "Ty čisté záře mořských ok,"
  },
  {
   "texto": "ten Kriváň nebetyčný,"
  },
  {
   "texto": "ten bystrý Váhu, Nitry tok"
  },
  {
   "texto": "ten lid tak dobrý, sličný,"
  },
  {
   "texto": "těch bájí starých věčná zvěst,"
  },
  {
   "texto": "těch písní sladké vděky:"
  },
  {
   "texto": "vše naše jest,"
  },
  {
   "texto": "vše naše jest,"
  },
  {
   "texto": "jest naše věků věky."
  },
  {
   "texto": "Nechť, synu Tater, dějů proud"
  },
  {
   "texto": "nás mutnou vlnou dvojí,"
  },
  {
   "texto": "nic neroztrhá tisíc pout,"
  },
  {
   "texto": "jež od věků nás pojí,"
  },
  {
   "texto": "jsme národ jeden, jedna řeč,"
  },
  {
   "texto": "táž větev slávské lípy,"
  },
  {
   "texto": "ni chytrá leč,"
  },
  {
   "texto": "ni krutý meč"
  },
  {
   "texto": "nás ve dvé nerozštípí."
  },
  {
   "texto": "A kdyby v různo větev tu"
  },
  {
   "texto": "chtěl bratr vlastní rváti,"
  },
  {
   "texto": "hned první hlahol jeho rtu"
  },
  {
   "texto": "zlý blud a rozkol zvrátí -"
  },
  {
   "texto": "řeč jedna zní ve sváru hluk"
  },
  {
   "texto": "a jasným zvonem hlásá:"
  },
  {
   "texto": "Týž retů zvuk,"
  },
  {
   "texto": "týž srdce tluk"
  },
  {
   "texto": "vás věčným svazkem pásá."
  },
  {
   "texto": "Nad Tatrou křídla rozpjal nám"
  },
  {
   "texto": "duch věští orlím vzletem,"
  },
  {
   "texto": "jenž stavěl svorné lásky chrám"
  },
  {
   "texto": "všem velké Slávy dětem."
  },
  {
   "texto": "Nuž za ním předně my a vy,"
  },
  {
   "texto": "jenž od boha jsme svoji:"
  },
  {
   "texto": "syn Vltavy"
  },
  {
   "texto": "i Moravy"
  },
  {
   "texto": "i Váhu v jednom voji!"
  },
  {
   "texto": "Těm klínům vzrůstat nedejme,"
  },
  {
   "texto": "jež násilně nás dělí,"
  },
  {
   "texto": "a svornou myslí hledejme,"
  },
  {
   "texto": "co svíže nás a scelí."
  },
  {
   "texto": "Vděk hojný přijme český luh"
  },
  {
   "texto": "od sladké Tater víly,"
  },
  {
   "texto": "váš měkký duch"
  },
  {
   "texto": "zas v boje ruch"
  },
  {
   "texto": "zde najde křepké síly."
  },
  {
   "texto": "Nuž, páže k páži, k boku bok,"
  },
  {
   "texto": "ať zví to širá země,"
  },
  {
   "texto": "že bratři jsme, že shledá sok"
  },
  {
   "texto": "v nás jedno svorné plémě."
  },
  {
   "texto": "Ó, věřte, lepší vzejde čas"
  },
  {
   "texto": "pro českoslávské bratry,"
  },
  {
   "texto": "až zahřmí zas"
  },
  {
   "texto": "vse v jeden hlas"
  },
  {
   "texto": "od Šumavy až v Tatry!"
  }
 ]
}