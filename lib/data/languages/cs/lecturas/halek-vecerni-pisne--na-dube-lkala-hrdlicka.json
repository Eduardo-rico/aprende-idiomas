 "parrafos": [
  {
   "texto": "Na dubě lkala hrdlička"
  },
  {
   "texto": "Na dubě lkala hrdlička,"
  },
  {
   "texto": "dole potůček hrčel —"
  },
  {
   "texto": "když jsem Ti všecko říci chtěl,"
  },
  {
   "texto": "nediv se, že jsem mlčel!"
  },
  {
   "texto": "Kdo v neznámý zabloudil kraj,"
  },
  {
   "texto": "zdaž z duše vše hned poví?"
  },
  {
   "texto": "A člověk příliš člověkem"
  },
  {
   "texto": "by ráj mu nebyl nový."
  },
  {
   "texto": "Noc byla krásná, průhledná —"
  },
  {
   "texto": "až v nebe vidět bylo;"
  },
  {
   "texto": "ten zpěv, ta vůně a ten šum"
  },
  {
   "texto": "až srdce okouzlilo."
  },
  {
   "texto": "Ó žel, že nejsi přítomná,"
  },
  {
   "texto": "bys uslyšela se mnou,"
  },
  {
   "texto": "jak všechno, všechno kolkolem"
  },
  {
   "texto": "řeč rozpráví tak jemnou."
  },
  {
   "texto": "Jak celý vesmír jeden zpěv,"
  },
  {
   "texto": "jenž z všehoňader řine,"
  },
  {
   "texto": "jak slabounký to ohlas jen,"
  },
  {
   "texto": "co z lidských srdcí plyne."
  },
  {
   "texto": "Ty hvězdičky, tak drobounké"
  },
  {
   "texto": "a nebi ku ozdobě,"
  },
  {
   "texto": "tak sladce dolů shlížejí,"
  },
  {
   "texto": "jakby mne zvaly k sobě."
  },
  {
   "texto": "Ach ne, vy drobné hvězdičky,"
  },
  {
   "texto": "vám sluší v nebes kole;"
  },
  {
   "texto": "mně milo tady na zemi,"
  },
  {
   "texto": "já zůstanu radš dole."
  },
  {
   "texto": "Nevíte, milé hvězdičky,"
  },
  {
   "texto": "ba netušíte ani,"
  },
  {
   "texto": "jak krásné nebe na zemi"
  },
  {
   "texto": "u sladkém objímání."
  },
  {
   "texto": "Již nevím, zda to sen či ne,"
  },
  {
   "texto": "leč v paměti to posud —"
  },
  {
   "texto": "já v soudy boží nahlížel"
  },
  {
   "texto": "a národů čet' osud."
  },
  {
   "texto": "Myšlenky vážné, jak Bůh sám,"
  },
  {
   "texto": "ty hlavou jeho táhly,"
  },
  {
   "texto": "a krásné, jako jarní noc,"
  },
  {
   "texto": "po milém těle prahly."
  },
  {
   "texto": "Mnohá myšlénka — celý svět,"
  },
  {
   "texto": "mnohá jak píseň jemná,"
  },
  {
   "texto": "mnohá — budoucí lidstva děj,"
  },
  {
   "texto": "lidskému oku temná."
  },
  {
   "texto": "Tam též jsem našel lásku svou"
  },
  {
   "texto": "i Tvoje srdce krásné:"
  },
  {
   "texto": "ta naše láska byla tam"
  },
  {
   "texto": "jak obláčky dva jasné."
  },
  {
   "texto": "A na tu naši lásku Bůh"
  },
  {
   "texto": "s zalíbením se díval,"
  },
  {
   "texto": "a zástup mladých andělů"
  },
  {
   "texto": "mu o ní písně zpíval."
  },
  {
   "texto": "Tak temnomodrá nebes báň —"
  },
  {
   "texto": "a hvězdičky jak zlato;"
  },
  {
   "texto": "člověku divno u srdce,"
  },
  {
   "texto": "když tak se dívá na to."
  },
  {
   "texto": "A těch hvězd stále víc a víc,"
  },
  {
   "texto": "že ani konce není —"
  },
  {
   "texto": "a přec tam není každičká"
  },
  {
   "texto": "ta hvězda k nalezení."
  },
  {
   "texto": "Jen když v dvě srdce mladinká"
  },
  {
   "texto": "dech první lásky vchází,"
  },
  {
   "texto": "tu na tom modrém nebi též"
  },
  {
   "texto": "prý nová hvězda vzchází."
  },
  {
   "texto": "A v jednom-li z těch srdcí dvou"
  },
  {
   "texto": "květ lásky schne a vadne,"
  },
  {
   "texto": "tu s toho nebe modrého"
  },
  {
   "texto": "i zlatá hvězda spadne."
  }
 ]
}