 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Jako mladý sokol zajatý"
  },
  {
   "texto": "chvilkou v bezúčinné zlobě třímá"
  },
  {
   "texto": "pruty klece svými pařáty,"
  },
  {
   "texto": "křídloma je šlehá rozpjatýma,"
  },
  {
   "texto": "až kol poletuje peří sivé;"
  },
  {
   "texto": "tu zas peruť pocuchanou níží"
  },
  {
   "texto": "ve mrákotné mdlobě zoufanlivé,"
  },
  {
   "texto": "v mutný o svobodě sen se hříží:"
  },
  {
   "texto": "takto Václav, v těsné zamčen cele,"
  },
  {
   "texto": "jížto soumrak příšerný se stele,"
  },
  {
   "texto": "tu se jitří v marném rozezlení,"
  },
  {
   "texto": "tu zas umdlen v těžké klesá snění."
  },
  {
   "texto": "Třetí den již Otcové v té cele"
  },
  {
   "texto": "vězní jinocha. On první den"
  },
  {
   "texto": "zuřivým jich davem obklopen"
  },
  {
   "texto": "hlavu svěsiv mlčel zatvrzele"
  },
  {
   "texto": "k dotazům, kdo knihu zlou mu dal,"
  },
  {
   "texto": "kacířství mu tajně vštěpoval?"
  },
  {
   "texto": "S temným vzdorem v mrtvě bledých lících"
  },
  {
   "texto": "mlčky snášel bouři jejich hněvů,"
  },
  {
   "texto": "žalob, výčitek, slov kárajících —"
  },
  {
   "texto": "bez hlesu a slzy, bez záchvěvu."
  },
  {
   "texto": "Leč kdy nazejtří ten chmurný dav"
  },
  {
   "texto": "k výslechům a důtkám shluk’ se znova,"
  },
  {
   "texto": "náhle čelo prudce povypjav"
  },
  {
   "texto": "s okem planoucím ta zvolal slova:"
  },
  {
   "texto": "„Nechte mne již! Marny vaše snahy."
  },
  {
   "texto": "Vězte již, kým žárem duše vzňata:"
  },
  {
   "texto": "Kacíř jsem, jak byl můj otec drahý,"
  },
  {
   "texto": "jehož dědictvím ta kniha svatá."
  },
  {
   "texto": "Nevěřím, že Kristus, lásky pramen,"
  },
  {
   "texto": "v zemi tu vás vyslal, kněží zloby,"
  },
  {
   "texto": "by ji proměnil váš meč a plamen"
  },
  {
   "texto": "v poušť a spáleniště, rum a hroby!"
  },
  {
   "texto": "Nevěřím, že sílil ruce dravé,"
  },
  {
   "texto": "které celý národ vyplenily,"
  },
  {
   "texto": "by tu mrzkou loupež v bleskotavé"
  },
  {
   "texto": "těla jeho trůny proměnily!"
  },
  {
   "texto": "Neděsí vás krev, jež kol se kouří"
  },
  {
   "texto": "z popravčího meče, špalku, kola?"
  },
  {
   "texto": "Hoj, ta krev se v žilách mojich bouří,"
  },
  {
   "texto": "o pomstu mým retem k nebi volá!"
  },
  {
   "texto": "Ano, krev ta mučennická vzdýmá"
  },
  {
   "texto": "bouřlivě mé spánky hněvuplné —"
  },
  {
   "texto": "Michalovic mrtvý rtoma mýma,"
  },
  {
   "texto": "rtoma svého sirotka vám klne."
  },
  {
   "texto": "Za otce vám klnu nešťastného,"
  },
  {
   "texto": "za ret mrtvý sťaté jeho hlavy,"
  },
  {
   "texto": "za soudruhy mučennictví jeho,"
  },
  {
   "texto": "jeho smrti, potupy a slávy."
  },
  {
   "texto": "Za vyhnanců davy nesčíslné,"
  },
  {
   "texto": "loučivší se v pláči s rodným domem,"
  },
  {
   "texto": "za národ vám celý ret můj klne —"
  },
  {
   "texto": "ó, že není hlas můj božím hromem!"
  },
  {
   "texto": "To můj dík za věnec trnů v skráni,"
  },
  {
   "texto": "za bídný háv tento — vaše dary — —"
  },
  {
   "texto": "zde jej sápu hněvně, v pohrdání,"
  },
  {
   "texto": "zpět vám do líce ty metám cáry!"
  },
  {
   "texto": "Hle, zde prosta moje hruď se bělá!"
  },
  {
   "texto": "Nuž i tu si ještě rozervete,"
  },
  {
   "texto": "vytrhněte živé srdce z těla —"
  },
  {
   "texto": "svým je nikdy více nenazvete!“"
  },
  {
   "texto": "Naslouchali slovům neslýchaným"
  },
  {
   "texto": "jesuité žasem ustrnulí"
  },
  {
   "texto": "a když skončil, s křikem pomíchaným"
  },
  {
   "texto": "ku smělci se zevšad nahrnuli,"
  },
  {
   "texto": "až pak rektorova slova vzteklá"
  },
  {
   "texto": "přehlušila tento hlahol pustý:"
  },
  {
   "texto": "„Smělče zběsilý, sám vládce pekla"
  },
  {
   "texto": "rouhá se a zuří tvými ústy!"
  },
  {
   "texto": "Ano, hnízda kacířského’s mládě,"
  },
  {
   "texto": "bídníku! Dle skřeku již to znáti —"
  },
  {
   "texto": "Tak se odměňuješ řádu, hádě,"
  },
  {
   "texto": "který hřál tě v loktech, církvi máti?!"
  },
  {
   "texto": "Však ti podlomíme, dá-li bůh,"
  },
  {
   "texto": "zpupnou šíj a jedovaté zuby,"
  },
  {
   "texto": "duši spasíme pro rajský luh,"
  },
  {
   "texto": "jižto vleče Satan do záhuby.“"
  },
  {
   "texto": "— — — — — — — — — — —"
  },
  {
   "texto": "Teď je sám. Chléb před ním, vody žbán,"
  },
  {
   "texto": "veliká též kniha rozepjatá,"
  },
  {
   "texto": "s těžkou záponkou. Do jejích blan"
  },
  {
   "texto": "fantasie chorým žárem vzňatá"
  },
  {
   "texto": "vdechla pekla hrůzy vysněné:"
  },
  {
   "texto": "jako v mořské hloubi rybek davy,"
  },
  {
   "texto": "hemží se zde v tůni plamenné"
  },
  {
   "texto": "beznadějných zatracenců hlavy;"
  },
  {
   "texto": "co lze vystihnout jen děsných muk,"
  },
  {
   "texto": "až krev stydne, vázne srdce tluk,"
  },
  {
   "texto": "škubá tuto rysy tváří zvadlých,"
  },
  {
   "texto": "do nichž nehty zoufale se ryjí,"
  },
  {
   "texto": "horečně tu kmitá z očí vpadlých,"
  },
  {
   "texto": "zuby skřípá, těla v klubko svíjí,"
  },
  {
   "texto": "v tisícerém hrozném výjevu"
  },
  {
   "texto": "krouží sírným, klokotavým varem — —"
  },
  {
   "texto": "Ale jinoch v trpkém úsměvu"
  },
  {
   "texto": "zatkl sponu — pazour ďáblí tvarem —"
  },
  {
   "texto": "a zřel snivě v desky zasmušilé,"
  },
  {
   "texto": "z jejichž kůže v povypuklém díle"
  },
  {
   "texto": "rozpínaje křídla netopýra"
  },
  {
   "texto": "Satan okem rubínovým zírá."
  },
  {
   "texto": "Nad klekátkem hrubým s temné stěny,"
  },
  {
   "texto": "přibit na dubovém velkém kříži,"
  },
  {
   "texto": "mroucím okem Kristus umučený"
  },
  {
   "texto": "z mutné tváře k jinochovi shlíží."
  },
  {
   "texto": "S věncem trnů, jenž mu skráně jímá,"
  },
  {
   "texto": "zvadlé růže kynou s jeho lebi,"
  },
  {
   "texto": "pod nohama hřebem probitýma"
  },
  {
   "texto": "bílá lebka umrlčí se šklebí."
  },
  {
   "texto": "Václav přemítá: Co asi nyní"
  },
  {
   "texto": "bratr Smil, co šedý Ambrož činí?"
  },
  {
   "texto": "Zdali v sadu nenašedše jej"
  },
  {
   "texto": "kolem sídla jesuitů v taji"
  },
  {
   "texto": "po nešťastném vězni vyhlédají?"
  },
  {
   "texto": "Dumaje tak jinoch obličej"
  },
  {
   "texto": "utrápený v jemné dlaně skládá"
  },
  {
   "texto": "a sen měnivý se v čelo vkrádá:"
  },
  {
   "texto": "Vidí kol do kola lesy valné"
  },
  {
   "texto": "zelenými vršky kývající,"
  },
  {
   "texto": "s modrým věncem hornatiny dálné"
  },
  {
   "texto": "na obzoru jemně splývající."
  },
  {
   "texto": "V širé mýtině kol ohňů žárných,"
  },
  {
   "texto": "šlehajících z kypré řasné chvoje,"
  },
  {
   "texto": "sedí tlupy mužů hrubotvárných"
  },
  {
   "texto": "chudobného vesnického kroje;"
  },
  {
   "texto": "po jich bocích v kapradině svěží"
  },
  {
   "texto": "hřeby cepů, palcátů se ježí."
  },
  {
   "texto": "Z větví jedle sestrojený stan"
  },
  {
   "texto": "zelená se v kole branných sborů,"
  },
  {
   "texto": "nad ním kalich rudý na praporu"
  },
  {
   "texto": "zachvívá se, vánkem kolébán."
  },
  {
   "texto": "Vůdce Smil tam hrdobujně zdvihá"
  },
  {
   "texto": "pod přílbicí skvoucí jarou skráň,"
  },
  {
   "texto": "o mlat opíraje křepkou dlaň,"
  },
  {
   "texto": "a blesk nadšení mu zraky zžíhá."
  },
  {
   "texto": "Ambrož vedle v šeré, volné říze"
  },
  {
   "texto": "hlavu chýlí, s níž jak peřej mléka"
  },
  {
   "texto": "s vousem bělostným vlas bílý stéká"
  },
  {
   "texto": "k otevřené na kolenou knize,"
  },
  {
   "texto": "bílé řasy zbožná vláha plní,"
  },
  {
   "texto": "zvadlí rtové modlitbou se vlní."
  },
  {
   "texto": "Náhle pod vířivým palic tlukem"
  },
  {
   "texto": "buben zazněl, Žižkův buben hněvný,"
  },
  {
   "texto": "a hned hromovitým jeho zvukem"
  },
  {
   "texto": "pobouřen se zdvihl tábor řevný."
  },
  {
   "texto": "V branné šiky zástupy se tísní,"
  },
  {
   "texto": "prapor s kalichem jim v čele vlaje,"
  },
  {
   "texto": "za hlaholu starodávných písní"
  },
  {
   "texto": "voj se valí do širého kraje."
  },
  {
   "texto": "V předu na supavém koni vraném"
  },
  {
   "texto": "bratr jeho vzpíná bujnou hlavu,"
  },
  {
   "texto": "s prsou jeho blýská v slunci ranném"
  },
  {
   "texto": "kalich zlatý na železném hávu."
  },
  {
   "texto": "S biblí v klíně vedle Ambrož jede;"
  },
  {
   "texto": "z líce zápal prorocký mu dýchá"
  },
  {
   "texto": "a sníh vlasů, stříbro brady šedé"
  },
  {
   "texto": "s bílou hřívou komoně se míchá."
  },
  {
   "texto": "Tak voj táhne jako mračno děsné"
  },
  {
   "texto": "a v něm křižují se blesky zbraní,"
  },
  {
   "texto": "Žižkův buben v zuřivosti běsné"
  },
  {
   "texto": "z něho rachotí jak hromu řvaní."
  },
  {
   "texto": "Otřásá se půda jeho vírem,"
  },
  {
   "texto": "je ho slyšet v lůně vlasti šírém."
  },
  {
   "texto": "Jako řeka jarním rozvodněním"
  },
  {
   "texto": "roste šumný voj na svojí dráze,"
  },
  {
   "texto": "celý národ, zbuzen bubnu hřměním,"
  },
  {
   "texto": "proudem nezdolným se valí k Praze."
  },
  {
   "texto": "V Bílé Hoře zas se meče kříží"
  },
  {
   "texto": "a když svítá na východě zora,"
  },
  {
   "texto": "prapor s madonnou se v krvi hříží —"
  },
  {
   "texto": "pomstěna je slavně Bílá Hora!"
  },
  {
   "texto": "Ze žaláře svého ve snu zírá,"
  },
  {
   "texto": "kterak přes vodu jak srnci štvaní"
  },
  {
   "texto": "prchá panstvo cizácké, jak za ní"
  },
  {
   "texto": "kollej v náruč ochrannou je svírá —"
  },
  {
   "texto": "na krátko jen! — Slyší odevšad"
  },
  {
   "texto": "k pevným stěnám lidu příboj hřmíti, —"
  },
  {
   "texto": "pod ranami sekyr, mocných klad"
  },
  {
   "texto": "těžká vrata s rachotem se řítí."
  },
  {
   "texto": "Výš a výš se nese z patra k patru"
  },
  {
   "texto": "boje hluk. Teď vstup si v celu tesá"
  },
  {
   "texto": "pádný kov a ztepilému bratru"
  },
  {
   "texto": "v náruč vězeň uvolněný klesá."
  },
  {
   "texto": "S ním dál stíhá zbytky cizích vrahů,"
  },
  {
   "texto": "kryjících se v chodeb tajných šeři,"
  },
  {
   "texto": "až pak stanul na krvavém prahu"
  },
  {
   "texto": "roztříštěných modlitebny dveří."
  },
  {
   "texto": "Jako na poslední výspy lemu"
  },
  {
   "texto": "před potopy smrtonosnou vlnou,"
  },
  {
   "texto": "k oltáři se tulí zářivému"
  },
  {
   "texto": "kněží, děvy tlupou bázně plnou."
  },
  {
   "texto": "Stupně jeho krví teplou smáčí"
  },
  {
   "texto": "don Huerta, skolen lidu soudem;"
  },
  {
   "texto": "Marje nachýlena v němém pláči"
  },
  {
   "texto": "tvář mu halí vlasů zlatým proudem."
  },
  {
   "texto": "Jako za štít smutné skupině,"
  },
  {
   "texto": "jako strážný anděl svatyně"
  },
  {
   "texto": "Ignácie něžné postať štíhlá"
  },
  {
   "texto": "v ústrety se nepřátelům zdvihla."
  },
  {
   "texto": "Jak roj havranů ku sněžné pláni,"
  },
  {
   "texto": "temno kadeří se k hrdlu sklání,"
  },
  {
   "texto": "a jak svatozář se míhá v nich"
  },
  {
   "texto": "plachý odlesk světel oltářních."
  },
  {
   "texto": "Nadšením jí plane zrak i líc,"
  },
  {
   "texto": "náruč milostná se volně šíří"
  },
  {
   "texto": "lesklým čepelům a hrotům vstříc,"
  },
  {
   "texto": "jež jí zevšad v ňadra cudná míří, —"
  },
  {
   "texto": "smrť tak na hruď toužebně se dmoucí"
  },
  {
   "texto": "zove s mučennictví palmou skvoucí."
  },
  {
   "texto": "Skokem jinoch v rozjitřeném davě"
  },
  {
   "texto": "před milku se staví ku ochraně;"
  },
  {
   "texto": "avšak ona přísně, odmítavě"
  },
  {
   "texto": "k němu pohled obrací a dlaně:"
  },
  {
   "texto": "„Vari, odpadlíku víry svaté,"
  },
  {
   "texto": "vari, mého rodu nepříteli!"
  },
  {
   "texto": "Nech, ať mučennickým věncem spjaté"
  },
  {
   "texto": "skráně složím k nohám Spasiteli!"
  },
  {
   "texto": "Nech, ať umru za tu církev pravou,"
  },
  {
   "texto": "zbudovanou na věčité skále,"
  },
  {
   "texto": "nad jejížto svatou římskou hlavou"
  },
  {
   "texto": "holubice Duch se vznáší stále!"
  },
  {
   "texto": "Za dech rajský patery té růže,"
  },
  {
   "texto": "vykvetší pod ostnem hřebů, kopí,"
  },
  {
   "texto": "za tajemství, jichž um nepochopí,"
  },
  {
   "texto": "v nichž jen víra kochati se může!"
  },
  {
   "texto": "Nech, ať duše z vazby zemské vzletne"
  },
  {
   "texto": "v pravdy věčné sídla bezmezná"
  },
  {
   "texto": "mezi věrných davy nespočetné,"
  },
  {
   "texto": "jež tam církev řadí vítězná"
  },
  {
   "texto": "v božích odeblesků rouchu slunném"
  },
  {
   "texto": "pod královny nebes hvězdným trůnem…“"
  },
  {
   "texto": "Zalkal jinoch — ze snů těch jej budí"
  },
  {
   "texto": "jiná skutečnost pochmurných tahů:"
  },
  {
   "texto": "on tu v bídném vězení se trudí,"
  },
  {
   "texto": "dívka tone v nádheře a blahu —"
  },
  {
   "texto": "s výše své zda v plachém vzpomínání"
  },
  {
   "texto": "k novici se nebohému sklání?!"
  },
  {
   "texto": "Lebkou umrlčí teď mysl jata"
  },
  {
   "texto": "pod Kristovou nohou probodenou"
  },
  {
   "texto": "a hned rodičova hlava sťatá"
  },
  {
   "texto": "místo ní naň zírá děsnou změnou."
  },
  {
   "texto": "Na kolena s temným zalkáním"
  },
  {
   "texto": "uvrhl se jinoch k nohám kříži,"
  },
  {
   "texto": "polo modlitbou, půl rouháním"
  },
  {
   "texto": "žaluje mu srdce krutou tíži:"
  },
  {
   "texto": "„Kriste! Ty, jenž sám jsi klonil hlavu"
  },
  {
   "texto": "pod trnitým věncem lidských muk,"
  },
  {
   "texto": "z jehož prsou v divém strastí davu"
  },
  {
   "texto": "též se vydral zoufalosti zvuk:"
  },
  {
   "texto": "obrať ke mně milostivé zraky,"
  },
  {
   "texto": "vyslyš, vyslyš žalobný můj ston,"
  },
  {
   "texto": "rozplaš v duši pochybností mraky,"
  },
  {
   "texto": "utiš v srdci dravých bolů shon!"
  },
  {
   "texto": "Zjev mi sám, ó Kriste, lásky moře,"
  },
  {
   "texto": "Tvou-li vůlí klesl národ ten"
  },
  {
   "texto": "pode křížem potupy a hoře,"
  },
  {
   "texto": "jenž Tvým jménem v šij’ mu položen?"
  },
  {
   "texto": "Ty-lis půjčil věnec čela svého,"
  },
  {
   "texto": "by jej vtiskly vrahů zástupy"
  },
  {
   "texto": "na skráň mého lidu nebohého,"
  },
  {
   "texto": "ztepaného třtinou potupy?"
  },
  {
   "texto": "Ty, jenž’s ve smrtelném ještě boji"
  },
  {
   "texto": "k matce pohled láskyplný slal,"
  },
  {
   "texto": "zjev mi sám, zda jesti vůlí Tvojí,"
  },
  {
   "texto": "bych tu svatou pásku rozerval,"
  },
  {
   "texto": "která, tkána samou boží dlaní,"
  },
  {
   "texto": "sdružuje i šelem dravé plémě,"
  },
  {
   "texto": "i tu haluz k matce půdě sklání —"
  },
  {
   "texto": "svaté pouto krve, rodné země?"
  },
  {
   "texto": "V slzách k Tobě volám: Zjev mi, Kriste,"
  },
  {
   "texto": "zda-li žádáš, abych v službě Tvé"
  },
  {
   "texto": "uhasil to sladké plání čisté,"
  },
  {
   "texto": "jímž se vzňalo srdce mladistvé,"
  },
  {
   "texto": "abych pohřbil v nepaměti klíně"
  },
  {
   "texto": "navždy skvoucí andělský ten vděk,"
  },
  {
   "texto": "jenž mi zjevil v zemské skořepině"
  },
  {
   "texto": "jasnou perlu Tvůrčích myšlenek?!"
  },
  {
   "texto": "Chceš-li, bych Tvou nohu podnik’ hlavou"
  },
  {
   "texto": "vyprahlou jak umrlčí ta leb,"
  },
  {
   "texto": "prázdnou lidských dum a hrobně tmavou,"
  },
  {
   "texto": "ku stvořenstva vděkům hluch a slep,"
  },
  {
   "texto": "abych zapřel vše, co srdce cítí,"
  },
  {
   "texto": "abych za živa se žití vzdal,"
  },
  {
   "texto": "abych člověkem zde přestal býti,"
  },
  {
   "texto": "jímž’s Ty z lásky k člověku se stal?!"
  },
  {
   "texto": "Promluv, Kriste, úpím k Tobě vzhůru —"
  },
  {
   "texto": "Sešli jeden spasný paprsek"
  },
  {
   "texto": "v pochybností těchto dusnou chmuru,"
  },
  {
   "texto": "v zatmělý mé duše okrsek!"
  },
  {
   "texto": "Promluv! — Ticho. — Mlčí zem i nebe —"
  },
  {
   "texto": "slyším jen to srdce v ňadru bít —"
  },
  {
   "texto": "nuž, mé srdce, vůdcem volím tebe,"
  },
  {
   "texto": "za tvým hlasem jediným chci jít."
  },
  {
   "texto": "Jestli do záhuby věčné spěli"
  },
  {
   "texto": "otec můj a matka, národ celý,"
  },
  {
   "texto": "nechť ten žár, jenž mukám jejich svítí,"
  },
  {
   "texto": "i kol padlé duše mojí šlehne"
  },
  {
   "texto": "a ty v nitru lásky rajské kvítí,"
  },
  {
   "texto": "tebe mně ni peklo nesežehne!“"
  },
  {
   "texto": "Klíče zachřestily, vrzly dvéře."
  },
  {
   "texto": "Na prahu se před jinochem černá"
  },
  {
   "texto": "otce Sidecia postať směrná,"
  },
  {
   "texto": "jak stín tmavší v chodby jemném šeře."
  },
  {
   "texto": "Vklouz’ a zavřel. Přízeň shovívavá"
  },
  {
   "texto": "dýše z líce výrazné a hladké;"
  },
  {
   "texto": "k Václavu, jenž od klekátka vstává,"
  },
  {
   "texto": "hledí laskavě za řeči sladké:"
  },
  {
   "texto": "„Ó, jen dále shýbej kolena"
  },
  {
   "texto": "před milostným bokem Jesu Krista,"
  },
  {
   "texto": "jenž tě k sobě zve, jak jelena"
  },
  {
   "texto": "zbloudilého vody tůně čistá!"
  },
  {
   "texto": "Ó, jen dál se k němu viň a tul,"
  },
  {
   "texto": "on tě uvede na stezku pravou —"
  },
  {
   "texto": "tím již vykonal jsi cesty půl"
  },
  {
   "texto": "nazpět v církve náruč shovívavou!"
  },
  {
   "texto": "Dík buď za to vroucí Hospodinu!"
  },
  {
   "texto": "Vrať se docela — ó, vrať se, synu!"
  },
  {
   "texto": "Pohleď, Václave! Kdys děcko siré"
  },
  {
   "texto": "v náruč jsem tě zdvihl… V každé době"
  },
  {
   "texto": "s okamžiku toho v lásce čiré"
  },
  {
   "texto": "jako rodný otec lnul jsem k tobě."
  },
  {
   "texto": "Jako muž, jenž našed sémě chudé"
  },
  {
   "texto": "v prsť je hříží, zalévá i pěstí,"
  },
  {
   "texto": "nevěda, zda péče hodno bude,"
  },
  {
   "texto": "a pak jásá v netušeném štěstí,"
  },
  {
   "texto": "vida, jak se stonek hrdě zdvihá,"
  },
  {
   "texto": "a jak z puků slibných odevšad"
  },
  {
   "texto": "nejvzácnějších květů šperk se zžíhá:"
  },
  {
   "texto": "tak jsem uvedl tě v Kristův řád,"
  },
  {
   "texto": "vštěpoval ti velké, krásné snahy,"
  },
  {
   "texto": "a pak jásal vzácným nad pokladem,"
  },
  {
   "texto": "jenž mi vzcházel ve tvém duchu mladém."
  },
  {
   "texto": "Pojď již v náruč mou! Pojď hochu drahý!"
  },
  {
   "texto": "V lůno řádu vrať se s pokáním!"
  },
  {
   "texto": "Nedej, ať se trpkým zklamáním"
  },
  {
   "texto": "naděje mé shroutí, tužby vroucí!"
  },
  {
   "texto": "Vídal jsem tě často v hrdých snech"
  },
  {
   "texto": "povznešena v církve zástupech,"
  },
  {
   "texto": "Tovaryšstva světlo čaroskvoucí,"
  },
  {
   "texto": "vycházeti jasnou hvězdou novou"
  },
  {
   "texto": "nad nezměrnou říší Loyolovou…“"
  },
  {
   "texto": "„„Mýlíš se! Věz, neklonil jsem čela"
  },
  {
   "texto": "před tím Ježíšem, jak vy ho znáte,"
  },
  {
   "texto": "jehož korouhev se krví rděla"
  },
  {
   "texto": "v katanů mé vlasti ruce klaté!"
  },
  {
   "texto": "Tomu by má šíj’ se klanět měla?"
  },
  {
   "texto": "Nikdy! Nikdy! volám tisíckráte!““"
  },
  {
   "texto": "Chvilku Sidec čelo skaboněné"
  },
  {
   "texto": "mlče chýlí, lehce škubá rtem,"
  },
  {
   "texto": "přísně obočí svá tenká klene;"
  },
  {
   "texto": "pak zas vlídně praví s povzdechem:"
  },
  {
   "texto": "„Nuže, vidím, že již nespatřím"
  },
  {
   "texto": "rytířem tě Ježíšova voje,"
  },
  {
   "texto": "že již odumřelo srdce tvoje"
  },
  {
   "texto": "řádu našemu. Však smiř se s ním,"
  },
  {
   "texto": "smiř se s církví, věrným buď jí synem,"
  },
  {
   "texto": "bez trpkosti odlož tento hav,"
  },
  {
   "texto": "a když nevábí tě kněžský stav,"
  },
  {
   "texto": "služ nám vděčně v povolání jiném!"
  },
  {
   "texto": "Rokem vazby, horlivého kání"
  },
  {
   "texto": "v našem domě skvrnu duše smaž,"
  },
  {
   "texto": "a pak východ řád ti nezabrání."
  },
  {
   "texto": "Trhej si pak světa marné květy,"
  },
  {
   "texto": "z číše štěstí pozemského vlaž"
  },
  {
   "texto": "ve střídmosti svoje chtivé rety."
  },
  {
   "texto": "Příznivců tam jistě najdeš dosti."
  },
  {
   "texto": "Huerta sám, ondy při hodu"
  },
  {
   "texto": "poznav tebe, slyše o tvé ctnosti"
  },
  {
   "texto": "jat byl k tobě vřelou náklonností."
  },
  {
   "texto": "A když včera o tvém původu"
  },
  {
   "texto": "z úst mých zvěděl, zjevil za hovoru:"
  },
  {
   "texto": "kdybys kráčeti chtěl světskou drahou,"
  },
  {
   "texto": "že by jeden ze ztracených dvorů"
  },
  {
   "texto": "vymohl ti nazpět pilnou snahou;"
  },
  {
   "texto": "žertovným pak způsobem svým prál"
  },
  {
   "texto": "— ale chceš-li, ve slovu ti stojí —"
  },
  {
   "texto": "že by nádavkem ti za choť dal"
  },
  {
   "texto": "ne-li dceru, aspoň neteř svoji.“"
  },
  {
   "texto": "„„Jak že? Huerta že mluvil tak?““"
  },
  {
   "texto": "jinoch vykřikl a prudce chopil"
  },
  {
   "texto": "rámě jeho, jiskřící se zrak"
  },
  {
   "texto": "upřel naň, že Sidec oči sklopil."
  },
  {
   "texto": "Na to složil jinoch do dlaní"
  },
  {
   "texto": "obličej a mnohou, mnohou chvíli"
  },
  {
   "texto": "ve hlubokém trval dumání."
  },
  {
   "texto": "Znovu spřádá obraz prostomilý,"
  },
  {
   "texto": "jejž byl Ambrož vykouzlil mu v sadě."
  },
  {
   "texto": "Mešká na Rvenickém bílém hradě;"
  },
  {
   "texto": "v pestrý luh a modrý věnec hor"
  },
  {
   "texto": "oknem nízkým, v listí vína jarém,"
  },
  {
   "texto": "pod vlaštovčím štěbetavým párem"
  },
  {
   "texto": "rozesílá volně snivý zor;"
  },
  {
   "texto": "dvěma smavým černým očím vstříc"
  },
  {
   "texto": "choti milostné jej zdvihá časem,"
  },
  {
   "texto": "jež se za ním schyluje a líc"
  },
  {
   "texto": "ovívá mu hebkým, temným vlasem."
  },
  {
   "texto": "Pak s ní bloudí sladce zadumán"
  },
  {
   "texto": "sadů záhonky ve květů duze,"
  },
  {
   "texto": "sklánět musí hlavy pod haluze,"
  },
  {
   "texto": "nad stezkou se stroucí s obou stran,"
  },
  {
   "texto": "a jich květem obsypaní cele"
  },
  {
   "texto": "k besídce se chvějí osamělé."
  },
  {
   "texto": "Tu jí při obžinkách věnčí spánky"
  },
  {
   "texto": "koukolem a chrpou vesničanky;"
  },
  {
   "texto": "tu s ní jede na bělostném oři"
  },
  {
   "texto": "stínem doubravy; tu v lehkém člunu"
  },
  {
   "texto": "do vln jezerních on veslo noří,"
  },
  {
   "texto": "ona mandoliny budí strunu."
  },
  {
   "texto": "Sidecius hledem zpytavým"
  },
  {
   "texto": "v jinochově bledé tváři badá;"
  },
  {
   "texto": "jak sen svůdný v ní se luzně spřádá,"
  },
  {
   "texto": "jak teď řasy stínem kmitavým"
  },
  {
   "texto": "probleskuje oko v chorém znoji"
  },
  {
   "texto": "a hruď chví se v divém citů boji."
  },
  {
   "texto": "Pojednou však jinoch prudce vstává,"
  },
  {
   "texto": "zrak mu blýská z odhodlané líce,"
  },
  {
   "texto": "hněvně výhost páterovi dává"
  },
  {
   "texto": "s lehkou pěnou na třesavých rtech:"
  },
  {
   "texto": "„„Vari — vari! Slibuješ mi více"
  },
  {
   "texto": "nežli Satan Kristu… Nech mě, nech!““"
  },
  {
   "texto": "Hoj! což teď se mocně vypjalo"
  },
  {
   "texto": "kněze hněvivého tělo statné"
  },
  {
   "texto": "v celé svojí výši majestátné,"
  },
  {
   "texto": "jak mu děsně oko zaplálo"
  },
  {
   "texto": "pod brvou, jak supí křídlo vzpjatou,"
  },
  {
   "texto": "nade tváří plápolavě vzňatou"
  },
  {
   "texto": "a jak ústa opěněná hřměla:"
  },
  {
   "texto": "„Zahyň tedy, duše zatvrzelá,"
  },
  {
   "texto": "klesni v propast, kam tě satan žene!"
  },
  {
   "texto": "Haha! S církví chceš se dáti v boj?!"
  },
  {
   "texto": "S církví, jejíž rámě napřažené"
  },
  {
   "texto": "rozdrtilo sterý valný voj,"
  },
  {
   "texto": "která zdeptala v té zemi šíré"
  },
  {
   "texto": "navždy lidu kacířského vzdor, —"
  },
  {
   "texto": "té ty sám, ty hoše slabé, siré,"
  },
  {
   "texto": "bláhově se stavíš na odpor?!"
  },
  {
   "texto": "Či je nadějí tvou bratr Smil?"
  },
  {
   "texto": "Marně doufáš. Řád má bystrý zor:"
  },
  {
   "texto": "Konradovým okem vyslídil"
  },
  {
   "texto": "v sadě s kacířem tvou besedu;"
  },
  {
   "texto": "i co mluvili jste k posledu,"
  },
  {
   "texto": "zaslechl. A v umluvenou chvíli"
  },
  {
   "texto": "za tebe se stráže dostavily…"
  },
  {
   "texto": "Nyní hluboko tam v Bílé věži"
  },
  {
   "texto": "v okovech tvůj zpupný bratr leží"
  },
  {
   "texto": "a snad zítra šedý kacíř s ním"
  },
  {
   "texto": "seznámí se s mečem katovým — —“"
  },
  {
   "texto": "Vzkřikl Václav zděšeně a v ruce"
  },
  {
   "texto": "ukryl obličej… Tak chvíli dlel"
  },
  {
   "texto": "těžce vzdychaje. Pak v divé muce,"
  },
  {
   "texto": "v zuřivosti líté zařičel:"
  },
  {
   "texto": "„„Nuže, dravci, zde též moje šíj’,"
  },
  {
   "texto": "kata přivolejte, mojí krve"
  },
  {
   "texto": "napijte se též! Ha, trhej, pij,"
  },
  {
   "texto": "tygře žíznivý! Však nech mě prve,"
  },
  {
   "texto": "abych zardousil tu zrádnou zmij’,"
  },
  {
   "texto": "důstojné to žáče vaší školy —"
  },
  {
   "texto": "pusť, ať padoucha má ruka skolí!““"
  },
  {
   "texto": "Pádí ke dveřím. Však silný kněz"
  },
  {
   "texto": "zpět jej odrazil, že k zemi kles’,"
  },
  {
   "texto": "a pak vyšel rychlým krokem z cely —"
  },
  {
   "texto": "bouchly dveře, klíče zaskřípěly."
  },
  {
   "texto": "Po chvilce však četných kroků znění"
  },
  {
   "texto": "ozvalo se v chodbě; znovu dvéře"
  },
  {
   "texto": "otevírá klíč a do vězení"
  },
  {
   "texto": "podob černorouchých dav se déře;"
  },
  {
   "texto": "z kolísavé kaditelny dým"
  },
  {
   "texto": "hustým oblakem se kobkou šíří,"
  },
  {
   "texto": "kropáč skvoucí do všech koutů míří,"
  },
  {
   "texto": "stěny vlaže mokem svěceným."
  },
  {
   "texto": "Jak tlum chrtů na zvěř uštvanou"
  },
  {
   "texto": "Konrad s tlupou druhů vybranou"
  },
  {
   "texto": "na vězně se vrhá kol do kola,"
  },
  {
   "texto": "rve jej, váže — a kněz rektor volá:"
  },
  {
   "texto": "„Spoutejte ho pevně! Hle, jak zmítá"
  },
  {
   "texto": "ďábel posedlého těla svaly!"
  },
  {
   "texto": "Hle, jak okem koulí zloba lítá,"
  },
  {
   "texto": "zuby skřípe, pěnou rety halí!"
  },
  {
   "texto": "Hoj! ty duchu pekelný, jenž v těle"
  },
  {
   "texto": "toho jinocha mi čelíš směle,"
  },
  {
   "texto": "na mne blýskáš ztrhaným tím zrakem —"
  },
  {
   "texto": "mocným slovem zkrotneš dojista!"
  },
  {
   "texto": "Zaklínám tě svatým kříže znakem:"
  },
  {
   "texto": "Ustup, vyjdi, moci nečistá!“"
  }
 ]
}