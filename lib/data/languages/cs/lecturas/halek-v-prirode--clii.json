 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CLII."
  },
  {
   "texto": "Až k vám se dopnout orlím letem,"
  },
  {
   "texto": "být občanem té říše jasné,"
  },
  {
   "texto": "být poutníkem tím světů světem —"
  },
  {
   "texto": "kdož by to nechtěl, hvězdy krásné?"
  },
  {
   "texto": "Dlít na každé a snít a bloudit,"
  },
  {
   "texto": "na místo dnů mít léta věků,"
  },
  {
   "texto": "co vidím v člověčenstvu proudit,"
  },
  {
   "texto": "mít obsaženo ve člověku —"
  },
  {
   "texto": "A hledat, kde se rozevírá"
  },
  {
   "texto": "to zřídlo světů nepojaté,"
  },
  {
   "texto": "snad najít srdce všehomíra —"
  },
  {
   "texto": "kdož by to nechtěl, hvězdy zlaté?"
  },
  {
   "texto": "To velké srdce slyšet bušit,"
  },
  {
   "texto": "v něm věků táhlé vlnobití,"
  },
  {
   "texto": "být srdcem s ním a v jaru tušit"
  },
  {
   "texto": "slast proudícího tvorům žití —"
  },
  {
   "texto": "Pak učit včelku medobzučnou,"
  },
  {
   "texto": "a v háji jaro započaté"
  },
  {
   "texto": "v květ rozdýchat a píseň zvučnou —"
  },
  {
   "texto": "ach, proč to není, hvězdy zlaté?"
  },
  {
   "texto": "Noční scéna. Rybník hladký,"
  },
  {
   "texto": "stromy v klenbu pojí se,"
  },
  {
   "texto": "měsíček se po něm rozlil,"
  },
  {
   "texto": "jako víno po míse."
  },
  {
   "texto": "Bylo hned jak za dne živo,"
  },
  {
   "texto": "voda v stříbro omladla,"
  },
  {
   "texto": "paprsky jdou, usednou si"
  },
  {
   "texto": "v leknínová sedadla."
  },
  {
   "texto": "S jedné větve slavík hude,"
  },
  {
   "texto": "jeť to v jeho povaze,"
  },
  {
   "texto": "dva paprsky tančí čardáš"
  },
  {
   "texto": "na stříbrné podlaze."
  },
  {
   "texto": "Lekníny se v člunky mění,"
  },
  {
   "texto": "tanečníky obklopí,"
  },
  {
   "texto": "a teď všecko v jednom tanci,"
  },
  {
   "texto": "kde kdo koho uchopí."
  },
  {
   "texto": "Hladká voda prohýbá se,"
  },
  {
   "texto": "měsíc sám se rozhoupá,"
  },
  {
   "texto": "i mé srdce z těla skáče,"
  },
  {
   "texto": "div se s nimi neskoupá."
  },
  {
   "texto": "Z hor luna pluje, labuť snící,"
  },
  {
   "texto": "a nebes moře kapkami se třese;"
  },
  {
   "texto": "svět každá kapka putující,"
  },
  {
   "texto": "a labuť světům: „Líbejte se!“"
  },
  {
   "texto": "To stará píseň starých světů;"
  },
  {
   "texto": "a podnes při mladosti plese"
  },
  {
   "texto": "vzduch, lesy, vody v jarním znětu —"
  },
  {
   "texto": "vše zpívat slyším: „Líbejte se!“"
  },
  {
   "texto": "Jaká to píseň! Stokrát znovu"
  },
  {
   "texto": "duch lidstva v báseň zachvěje se —"
  },
  {
   "texto": "ta jedna věta s nebes krovu"
  },
  {
   "texto": "ta všecky přečká: „Líbejte se!“"
  },
  {
   "texto": "Nehledám to lidské štěstí"
  },
  {
   "texto": "v dálkách myslí chorou vysněných:"
  },
  {
   "texto": "v rájích nade světy místěných,"
  },
  {
   "texto": "ani v nebích s nadpozemskou trestí."
  },
  {
   "texto": "Nehledám je v liché tužbě,"
  },
  {
   "texto": "v bájích na nerozum dospělých,"
  },
  {
   "texto": "v lícoměrnu nauk zbabělých —"
  },
  {
   "texto": "v lidí ani bohův modloslužbě."
  },
  {
   "texto": "Ale vím: Cos v kráse sdílné"
  },
  {
   "texto": "z nedozírna vniká v světlou říš,"
  },
  {
   "texto": "to co den k nám tíhne blíž a blíž,"
  },
  {
   "texto": "až k nám sladkým dechem matky přilne."
  },
  {
   "texto": "Až nám květohledným jarem"
  },
  {
   "texto": "v duše pološero doniká,"
  },
  {
   "texto": "všecky brány její zodmyká,"
  },
  {
   "texto": "svět i nebe štědrým dá nám darem."
  },
  {
   "texto": "V tom je hledám: člověk celý"
  },
  {
   "texto": "v jaru svém by vstříc mu vycházel,"
  },
  {
   "texto": "poznával, synovsky provázel,"
  },
  {
   "texto": "a pak dožil láskou srozumělý."
  }
 ]
}