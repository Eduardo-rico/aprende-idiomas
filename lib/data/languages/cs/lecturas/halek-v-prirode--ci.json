 "parrafos": [
  {
   "texto": "CI."
  },
  {
   "texto": "Čas s rolničkami, s bičem šaška,"
  },
  {
   "texto": "sed’ na hrob a tři vyndal lebky,"
  },
  {
   "texto": "ta jedna měla dýkou ránu,"
  },
  {
   "texto": "ty druhé povrch hladce hebký."
  },
  {
   "texto": "Pak živé zavolal a kázal:"
  },
  {
   "texto": "„Přes tři sta let, to byl v nich rozum;"
  },
  {
   "texto": "ta jedna jezdila co kníže,"
  },
  {
   "texto": "druhá mu koně pjala k vozům."
  },
  {
   "texto": "A kníže kázal: ‚Dolů s hlavou,"
  },
  {
   "texto": "jež do vozu se stále točí!‘"
  },
  {
   "texto": "A když ji srubli, křikla kněžna,"
  },
  {
   "texto": "neb nad knížete byl jí kočí."
  },
  {
   "texto": "Ta knížeti nakápla jedu,"
  },
  {
   "texto": "pak plačíc ustlala jim k sobě,"
  },
  {
   "texto": "však dál jí též nestačil rozum —"
  },
  {
   "texto": "teď tři sta let jsou v jednom hrobě.“ —"
  },
  {
   "texto": "Živí se scházejí, však běda!"
  },
  {
   "texto": "každému dýka číhá z roucha,"
  },
  {
   "texto": "kdo má ji, na druha ji brousí,"
  },
  {
   "texto": "čas káže — nikdo neposlouchá."
  },
  {
   "texto": "Prohlížely se v rybníce"
  },
  {
   "texto": "tři vrby babky, babice,"
  },
  {
   "texto": "zda ještě, jak za svobodna,"
  },
  {
   "texto": "je která k světu podobna."
  },
  {
   "texto": "Ta jedna zrovna bez huby,"
  },
  {
   "texto": "ty druhé s ústy bezzuby,"
  },
  {
   "texto": "bez těla kosti, beze měr,"
  },
  {
   "texto": "šat na hadr a plný děr."
  },
  {
   "texto": "Ta jedna chromá na ruku,"
  },
  {
   "texto": "ta druhá z mechu paruku,"
  },
  {
   "texto": "a v prsou všem, by střehl mír,"
  },
  {
   "texto": "vyspává za dne netopýr."
  },
  {
   "texto": "Ta jedna s chůzí v nevoli,"
  },
  {
   "texto": "ta druhá sotva o holi,"
  },
  {
   "texto": "a dechu časy nastaly"
  },
  {
   "texto": "jak z polámané píšťaly."
  },
  {
   "texto": "A k tomu ze dne do noci"
  },
  {
   "texto": "jak po padoucí nemoci,"
  },
  {
   "texto": "a při všem tuze ozdobny —"
  },
  {
   "texto": "jsou přec jen k světu podobny."
  },
  {
   "texto": "Duch dějin ved’ mne k pidimužům;"
  },
  {
   "texto": "z těch každý v erbu korunu"
  },
  {
   "texto": "a zlatý šat a všecko zlaté,"
  },
  {
   "texto": "a sedal jenom na trůnu."
  },
  {
   "texto": "A každý jako střízlík velký,"
  },
  {
   "texto": "leč v chůzi lvem a v hovoru,"
  },
  {
   "texto": "ten jeden z nich byl jako hlava,"
  },
  {
   "texto": "ti druzí jen jak od dvorů."
  },
  {
   "texto": "Ten mluvil: „Rod náš z krve ryzé,"
  },
  {
   "texto": "ten s velkými se nemíchal,"
  },
  {
   "texto": "máť každý z nás jen pidipředky,"
  },
  {
   "texto": "a králík náš jen pidikrál."
  },
  {
   "texto": "Tu stojí naši pidiotci,"
  },
  {
   "texto": "tu pidirek náš vítězný,"
  },
  {
   "texto": "my ostatní jsme pidiprinci,"
  },
  {
   "texto": "a dámy pidiprincezny.“"
  },
  {
   "texto": "A prál duch dějin: „Pro zasmání"
  },
  {
   "texto": "též takové mám hrdiny;"
  },
  {
   "texto": "ti mní, že kol nich svět se točí"
  },
  {
   "texto": "a oni že tvoří dějiny."
  }
 ]
}