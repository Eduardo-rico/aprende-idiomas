  {
   "texto": "přítelkyně, děvče svěží."
  },
  {
   "texto": "Do lampičky olej vlila"
  },
  {
   "texto": "modlitby své rozložila."
  },
  {
   "texto": "Modlí se a modlí tiše,"
  },
  {
   "texto": "ale divného cos tíží,"
  },
