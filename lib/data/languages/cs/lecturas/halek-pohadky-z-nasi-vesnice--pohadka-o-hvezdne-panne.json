{
 "id": "halek-pohadky-z-nasi-vesnice--pohadka-o-hvezdne-panne",
 "titulo": "Pohádka o hvězdné panně",
 "autor": "Vítězslav Hálek",
 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Poh%C3%A1dky_z_na%C5%A1%C3%AD_vesnice_(H%C3%A1lek)/Poh%C3%A1dka_o_hv%C4%9Bzdn%C3%A9_pann%C4%9B",
 "fuente": "cs.wikisource.org, «Pohádky z naší vesnice»",
 "licencia": "dominio público (autor muerto en 1874)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-pohadky-z-nasi-vesnice",
  "titulo": "Pohádky z naší vesnice",
  "orden": 3
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "V plň krásy panna rozvita,"
  },
  {
   "texto": "ta měla půl světa v moci,"
  },
  {
   "texto": "jak ptáček za dne ukryta,"
  },
  {
   "texto": "v noc byla královnou noci."
  },
  {
   "texto": "Tvář světlou měla z měsíce"
  },
  {
   "texto": "a z jeho paprsků šaty,"
  },
  {
   "texto": "z hvězd stužky v hlavě, jehlice,"
  },
  {
   "texto": "a závoj z oblaků sňatý."
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  },
  {
   "texto": "I sedla v lese pod skálu,"
  },
  {
   "texto": "tu smrt šla okolo s kosou —"
  },
  {
   "texto": "na těle masa pomálu"
  },
  {
   "texto": "a nohu do kosti bosou."
  },
  {
   "texto": "Cos v důlkách divě zasvitne,"
  },
  {
   "texto": "jak z píly vycení zuby,"
  },
  {
   "texto": "prst do žeber se zachytne:"
  },
  {
   "texto": "„Mé dítě, srdce mám v ruby!“"
  },
  {
   "texto": "My dítky zleknuty, plachy,"
  },
  {
   "texto": "jak v hnízdo tíhneme strachy."
  },
  {
   "texto": "Co dívka na to odpoví?"
  },
  {
   "texto": "Smrt k slovu kloní se uchem"
  },
  {
   "texto": "a slyší vánek májový,"
  },
  {
   "texto": "jak píseň zahrávat vzduchem,"
  },
  {
   "texto": "a slyší klokot slavíků,"
  },
  {
   "texto": "sen lesů v dřímotu sladkém,"
  },
  {
   "texto": "hru vody v stínech trávníků,"
  },
  {
   "texto": "když hne se v zvučení hladkém."
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  },
  {
   "texto": "„Ach, mou ty buď jen nevěstou"
  },
  {
   "texto": "a slyš, co vystrojím hodů:"
  },
  {
   "texto": "mláď hrobů pozvu peřestou"
  },
  {
   "texto": "a družby zpráchnilých rodů."
  },
  {
   "texto": "Nám hudci drnknou v tenkou kost,"
  },
  {
   "texto": "v hnát písknou za malé platy,"
  },
  {
   "texto": "a nevěsta i ženich, host —"
  },
  {
   "texto": "jak měl by mydlené paty!“"
  },
  {
   "texto": "My dítky zleknuty, plachy,"
  },
  {
   "texto": "jak v hnízdo tíhneme strachy."
  },
  {
   "texto": "Co ona? V úsměv prokvitne —"
  },
  {
   "texto": "jak sňal by nebeské hvězdy:"
  },
  {
   "texto": "sto krásných hlav se zakmitne,"
  },
  {
   "texto": "sto vil k ní zatáčí v sjezdy,"
  },
  {
   "texto": "sto dítek jak motýlí let,"
  },
  {
   "texto": "jak včelky v píseň si bzučí,"
  },
  {
   "texto": "v rej pne se ruka, šeptá ret —"
  },
  {
   "texto": "„Tak nás to královna učí!“"
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  },
  {
   "texto": "„Ach, k svatbě-li tě povedu,"
  },
  {
   "texto": "všech mrtvol tobě dám skvosty,"
  },
  {
   "texto": "já v hrobky králů zajedu,"
  },
  {
   "texto": "přes bohů zvětralých mosty."
  },
  {
   "texto": "Tam otevřem si komoru"
  },
  {
   "texto": "až po strop dlážděnou z lebky,"
  },
  {
   "texto": "ji na klíč zamknem, závoru,"
  },
  {
   "texto": "tam v sen se stulíme hebký.“"
  },
  {
   "texto": "My dítky zleknuty, plachy,"
  },
  {
   "texto": "jak v hnízdo tíhneme strachy."
  },
  {
   "texto": "Co ona? Koukne do šeřin:"
  },
  {
   "texto": "slyš! pastýř píšťalu ladí,"
  },
  {
   "texto": "sny ptákův táhnou od keřin,"
  },
  {
   "texto": "hnízd lůžka nápěvem sladí."
  },
  {
   "texto": "Jak nevěsta se usmívá,"
  },
  {
   "texto": "tká růže na nebes blánu,"
  },
  {
   "texto": "tvář červánkem se zardívá:"
  },
  {
   "texto": "„Nuž buď si, počkej jen k ránu.“"
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  },
  {
   "texto": "„A osladit ti líbánky,"
  },
  {
   "texto": "hej, bude svatební cesta:"
  },
  {
   "texto": "všech bojišť sjedem dýchánky,"
  },
  {
   "texto": "vše mrtvá, propadlá města."
  },
  {
   "texto": "A dávných říší svadlá líc,"
  },
  {
   "texto": "a shaslé národy v troudu"
  },
  {
   "texto": "nám od hřbitovů vyjdou vstříc"
  },
  {
   "texto": "jak předzpěv věčného soudu.“"
  },
  {
   "texto": "My dítky zleknuty, plachy,"
  },
  {
   "texto": "jak v hnízdo tíhneme strachy."
  },
  {
   "texto": "Co ona? Ruce prostírá:"
  },
  {
   "texto": "kam sáhne, hvězdička zmladne,"
  },
  {
   "texto": "ta, kde se poupě otvírá,"
  },
  {
   "texto": "co rosa na poupě padne;"
  },
  {
   "texto": "už hvězdami zem poseta,"
  },
  {
   "texto": "den klepe v nebeskou bránu,"
  },
  {
   "texto": "svět širý jitrem prokvetá —"
  },
  {
   "texto": "„Nuž buď si, počkej jen k ránu.“"
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  },
  {
   "texto": "„Ach, jen co kosu nabrousím,"
  },
  {
   "texto": "hned v dar ti požnu, co mladé,"
  },
  {
   "texto": "já poupě dítě zardousím,"
  },
  {
   "texto": "jež matka na prsy klade."
  },
  {
   "texto": "V dar dívčích tváří strhám květ,"
  },
  {
   "texto": "v dar zem ti zaplavím nachem,"
  },
  {
   "texto": "že vítaje tě zleklý svět"
  },
  {
   "texto": "k nám v hroby uteče strachem.“"
  },
  {
   "texto": "My dítky zleknuty, plachy,"
  },
  {
   "texto": "jak v hnízdo tíhneme strachy."
  },
  {
   "texto": "Smrt čeká, a když nabrousí,"
  },
  {
   "texto": "oj, mrkne dennice ranní, —"
  },
  {
   "texto": "hned světla, jak když natrousí,"
  },
  {
   "texto": "a svět je obrácen dlaní."
  },
  {
   "texto": "Smrt kouká — kde je nevěsta?"
  },
  {
   "texto": "Ta mizí neznámou mocí,"
  },
  {
   "texto": "jak ptáček malá, peřestá —"
  },
  {
   "texto": "„Chceš mít mne? Počkej jen k noci!“"
  },
  {
   "texto": "My dítky tichounko hravy,"
  },
  {
   "texto": "jak z hnízda vypneme hlavy."
  }
 ]
}