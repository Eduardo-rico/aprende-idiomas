  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "I"
  },
  {
   "texto": "Byla to zima překrásná!"
  },
  {
   "texto": "Kolkolem všude božský klid -"
  },
  {
   "texto": "ta příroda v kámen spoutána,"
  },
  {
   "texto": "zněmělý všechen, všechen lid."
  },
  {
   "texto": "Ach zas je po všem! Pojednou"
  },
  {
   "texto": "vejslky si větry, zvlhnul vzduch,"
  },
  {
   "texto": "a po kraji dříve tichounkém"
  },
  {
   "texto": "šílený víří jarní ruch."
  },
  {
   "texto": "Nevrle hledím oknem ven -"
  },
  {
   "texto": "nechte mně led můj, nechte shníh -"
  },
  {
   "texto": "vždyť nechápu více, nač ten rej,"
  },
  {
   "texto": "k čemu ta vřava, spěch a smích!"
  },
  {
   "texto": "Do větrů, dešťů šlehavých"
  },
  {
   "texto": "obrací člověk smavou líc,"
  },
  {
   "texto": "i vrána té bouři stříkavé"
  },
  {
   "texto": "s jásáním křídly bije víc!"
  },
  {
   "texto": "Binokl na očích, v ruce hůl"
  },
  {
   "texto": "kráčím si květnatým dolem,"
  },
  {
   "texto": "vážně jdu, jako bych neviděl,"
  },
  {
   "texto": "jaro co tropí zde kolem."
  },
  {
   "texto": "Vždyť je to všechno zas navlas tak"
  },
  {
   "texto": "jako před čtyřceti lety -"
  },
  {
   "texto": "po nebi známý ten ptákův zpěv,"
  },
  {
   "texto": "po stromech známé ty květy!"
  },
  {
   "texto": "Zase kol děvčátek skotačí"
  },
  {
   "texto": "hošíci nezralých boků,"
  },
  {
   "texto": "děvčátka písničky zpívají"
  },
  {
   "texto": "tištěné tohoto roku."
  },
  {
   "texto": "Není, ach není v tom postupu,"
  },
  {
   "texto": "všechno jde dávným svým krokem -"
  },
  {
   "texto": "bojím se, jenom my starší že"
  },
  {
   "texto": "moudříme každičkým rokem!"
  },
  {
   "texto": "Bojím se,tak že to bude už"
  },
  {
   "texto": "do světa skonání všude,"
  },
  {
   "texto": "jaro že povždy ty květy své,"
  },
  {
   "texto": "mládí své písně mít bude!"
  },
  {
   "texto": "Kráčím kol hochů a děvčátek,"
  },
  {
   "texto": "šveholem, zpěvem až zmámen,"
  },
  {
   "texto": "binokl na očích, v ruce hůl,"
  },
  {
   "texto": "s nehybnou tváří co kámen."
  },
  {
   "texto": "Teď v zrcadlo hledím a sobě v zrak,"
  },
  {
   "texto": "a studuju vlastní své rysy:"
  },
  {
   "texto": "ach vidím, že vskutku jsem ještě živ -"
  },
  {
   "texto": "já zapomněl umřít kdysi."
  },
  {
   "texto": "Však vypadám! Na sklo ať nedýchám"
  },
  {
   "texto": "a jak chci je hedvábem stírám -"
  },
  {
   "texto": "pleť zvětralá, zmodralý, suchý ret,"
  },
  {
   "texto": "a v zkalené oko jen zírám."
  },
  {
   "texto": "Ach vypadám! Jak bych byl v almaře,"
  },
  {
   "texto": "to po jara, to po léta zpátky,"
  },
  {
   "texto": "kdes visel, a ve vzduchu trouchnivém"
  },
  {
   "texto": "tak vyšel již z módy i látky."
  },
  {
   "texto": "Mé vlasy a vousy jsou chvějná chmýř,"
  },
  {
   "texto": "jak moly bych kolem byl splašil,"
  },
  {
   "texto": "a kdybych se potkal - já vyhnu se,"
  },
  {
   "texto": "jen abych se nepoprášil."
  }
 ]
}