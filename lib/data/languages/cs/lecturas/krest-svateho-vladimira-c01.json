{
 "id": "krest-svateho-vladimira-c01",
 "titulo": "Zpěv 1: Zpěv I. — Perun a Vladimír · Zpěv II. — Hospodářství",
 "autor": "Karel Havlíček Borovský",
 "muerteAutor": 1856,
 "fuenteUrl": "https://cs.wikisource.org/wiki/K%C5%99est_svat%C3%A9ho_Vladim%C3%ADra/Zp%C4%9Bv_I.",
 "fuente": "cs.wikisource.org, «Křest svatého Vladimíra»",
 "licencia": "dominio público (autor muerto en 1856)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (píti, jísti, býti: 3 formas frente a 2 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso y lo pondría en A2.",
 "serie": {
  "id": "krest-svateho-vladimira",
  "titulo": "Křest svatého Vladimíra",
  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Zpěv I. — Perun a Vladimír"
  },
  {
   "texto": "Vladimír cár na svůj svátek,"
  },
  {
   "texto": "když seděl na trůnu,"
  },
  {
   "texto": "poslal drába s vyřízením"
  },
  {
   "texto": "k bohovi Perunu."
  },
  {
   "texto": "„Hřmi, Perune! na můj svátek"
  },
  {
   "texto": "místo kanonády,"
  },
  {
   "texto": "škoda prachu, dost ho padne"
  },
  {
   "texto": "v bitvách u armády."
  },
  {
   "texto": "Hřmi, Perune! na můj svátek"
  },
  {
   "texto": "místo kanonády,"
  },
  {
   "texto": "pak si přijdi se mnou vypít"
  },
  {
   "texto": "šálek čokolády.“ —"
  },
  {
   "texto": "Pan dráb přišel k Perunovic,"
  },
  {
   "texto": "zatloukl na vrata,"
  },
  {
   "texto": "děvečky se hnedle zeptal:"
  },
  {
   "texto": "„Doma-li pantáta?“"
  },
  {
   "texto": "„Doma, doma, pane drábe,"
  },
  {
   "texto": "ve veliké chatě,"
  },
  {
   "texto": "sedí s jehlou na pekýlku,"
  },
  {
   "texto": "zašívá si katě.“"
  },
  {
   "texto": "„Vzkazuje vás, pantatínku,"
  },
  {
   "texto": "cár náš pozdravovat,"
  },
  {
   "texto": "máte prej mu k tomu svátku"
  },
  {
   "texto": "drobet zabubnovat.“"
  },
  {
   "texto": "Jak to přeslech tatík Perun,"
  },
  {
   "texto": "hnedle čelo zvraštil,"
  },
  {
   "texto": "skočil s kamen na lavici,"
  },
  {
   "texto": "kaťmi o zem praštil:"
  },
  {
   "texto": "„Raděj pásat husy ve vsi,"
  },
  {
   "texto": "po bahnách se ploužit,"
  },
  {
   "texto": "než u toho Vladimíra"
  },
  {
   "texto": "zde za boha sloužit."
  },
  {
   "texto": "Málo platu, služba těžká,"
  },
  {
   "texto": "nikdy konec práce,"
  },
  {
   "texto": "ještě bych mu měl vyvádět"
  },
  {
   "texto": "ve svátek regrace?"
  },
  {
   "texto": "Tuhle při poslední bouřce,"
  },
  {
   "texto": "při té blýskavici,"
  },
  {
   "texto": "bez toho jsem si propálil"
  },
  {
   "texto": "celou nohavici!"
  },
  {
   "texto": "Málo platu, málo športlí,"
  },
  {
   "texto": "málo deputátu!"
  },
  {
   "texto": "Nemohu si špendýrovat"
  },
  {
   "texto": "oleje k salátu!"
  },
  {
   "texto": "Pečínku jenom ve svátek,"
  },
  {
   "texto": "vodu musím píti,"
  },
  {
   "texto": "sotva jsem se na tu službu"
  },
  {
   "texto": "mohl oženiti."
  },
  {
   "texto": "Bez toho mne větším dílem"
  },
  {
   "texto": "živí jen kondice,"
  },
  {
   "texto": "študentům hodiny dávat"
  },
  {
   "texto": "musím ve fysice."
  },
  {
   "texto": "Kdyby od selek nekáplo"
  },
  {
   "texto": "trochu akcidence,"
  },
  {
   "texto": "ani v neděli bych nemoh"
  },
  {
   "texto": "přičuchnout k pálence!"
  },
  {
   "texto": "Pro nic za nic robotovat —"
  },
  {
   "texto": "nevěděl bych věru,"
  },
  {
   "texto": "na tu jeho čokoládu,"
  },
  {
   "texto": "že mu na ni seru!"
  },
  {
   "texto": "Cár necár, svátek nesvátek,"
  },
  {
   "texto": "že mi všechno rovno,"
  },
  {
   "texto": "ne a ne a nebudu hřmít,"
  },
  {
   "texto": "co z toho mám? Hovno!“ —"
  },
  {
   "texto": "Dráb stál celý zkoprnělý"
  },
  {
   "texto": "jako kapr v žitě:"
  },
  {
   "texto": "„Pamatujte se, pantáto,"
  },
  {
   "texto": "copak to mluvíte?"
  },
  {
   "texto": "Já jsem taky jen služebník,"
  },
  {
   "texto": "každý zná své meze,"
  },
  {
   "texto": "kdybych to vyřídil cáru,"
  },
  {
   "texto": "co se na vás sveze? —“"
  },
  {
   "texto": "Ale Perun, jak byl v ráži,"
  },
  {
   "texto": "sáhnul pod lavici"
  },
  {
   "texto": "a vytáh na pana drába"
  },
  {
   "texto": "tu svou hromovnici."
  },
  {
   "texto": "Dráb se dlouho nezdržoval,"
  },
  {
   "texto": "hledal honem díru"
  },
  {
   "texto": "a hned běžel jak s keserem"
  },
  {
   "texto": "k cáru Vladimíru:"
  },
  {
   "texto": "„Jdu Vašemu Veličenstvu"
  },
  {
   "texto": "slušně vomeldovat,"
  },
  {
   "texto": "že se to, co mluvil Perun,"
  },
  {
   "texto": "stydím opakovat."
  },
  {
   "texto": "Nechce hřmít a osopil se"
  },
  {
   "texto": "na mne jak na čubu,"
  },
  {
   "texto": "nectně s Vaším Veličenstvem"
  },
  {
   "texto": "vypláchnul si hubu."
  },
  {
   "texto": "Ať si tu svou čokoládu"
  },
  {
   "texto": "cár prej sám sežere,"
  },
  {
   "texto": "a že on na celou službu,"
  },
  {
   "texto": "s odpuštěním sere;"
  },
  {
   "texto": "že je cárův svátek a prd"
  },
  {
   "texto": "s odpuštěním rovno,"
  },
  {
   "texto": "že mu je po celém cáru"
  },
  {
   "texto": "s odpuštěním hovno! — —“"
  },
  {
   "texto": "Jak uslyšel Vladimír cár"
  },
  {
   "texto": "tohle grobiánstvo,"
  },
  {
   "texto": "plivnul na zem, zasakroval,"
  },
  {
   "texto": "a s ním všechno panstvo."
  },
  {
   "texto": "Poslal čtyry policajty"
  },
  {
   "texto": "k bohovi Perunu:"
  },
  {
   "texto": "„Přiveďte ho, grobiána,"
  },
  {
   "texto": "ku cárskému trůnu!“"
  },
  {
   "texto": "A když vyšli policajti,"
  },
  {
   "texto": "pískl na ně oknem:"
  },
  {
   "texto": "„Hej! nechte to až do zejtřka,"
  },
  {
   "texto": "my v suchu nezmoknem."
  },
  {
   "texto": "Nebudu si s grobiánem"
  },
  {
   "texto": "dneska kazit svátek,"
  },
  {
   "texto": "však mu zejtra uši natřem,"
  },
  {
   "texto": "vraťte se nazpátek."
  },
  {
   "texto": "Však my se ho o ty jeho"
  },
  {
   "texto": "hromy neprosíme,"
  },
  {
   "texto": "pokud máme své kanony,"
  },
  {
   "texto": "sami si zahřmíme!“"
  },
  {
   "texto": "Poslal flügel-adjutanta"
  },
  {
   "texto": "pro dvě baterie,"
  },
  {
   "texto": "ať bouchají při tabuli,"
  },
  {
   "texto": "když se zdraví pije."
  },
  {
   "texto": "Jedli, pili, hodovali,"
  },
  {
   "texto": "hráli jim muziky,"
  },
  {
   "texto": "ministři si popouštěli"
  },
  {
   "texto": "u kalhot knoflíky."
  },
  {
   "texto": "Pili pivo, pili víno,"
  },
  {
   "texto": "jedli z masa, z těsta,"
  },
  {
   "texto": "nejednomu oficíru"
  },
  {
   "texto": "pukla z toho vesta."
  },
  {
   "texto": "Vejskali a tancovali"
  },
  {
   "texto": "okolo pilířů,"
  },
  {
   "texto": "bim! bam! bum! špunty lítaly"
  },
  {
   "texto": "z flašek a moždířů."
  },
  {
   "texto": "Kdo při tom byl, ten se opil,"
  },
  {
   "texto": "blaze, braši! tomu!"
  },
  {
   "texto": "V noci je pak s výslužkami"
  },
  {
   "texto": "roznášeli domů."
  },
  {
   "texto": "Zpěv II. — Hospodářství"
  },
  {
   "texto": "Jedna hora vysoká je"
  },
  {
   "texto": "a druhá je nízká,"
  },
  {
   "texto": "kdo nemá své muzikanty,"
  },
  {
   "texto": "na hubu si píská."
  },
  {
   "texto": "Když hýřili, stolovali"
  },
  {
   "texto": "u cárského dvoru,"
  },
  {
   "texto": "ten celý den byl bůh Perun"
  },
  {
   "texto": "v mrzutém humoru."
  },
  {
   "texto": "„Kdo jaktěživ bohem nebyl,"
  },
  {
   "texto": "zkusil ještě málo,"
  },
  {
   "texto": "není to tak lehký život,"
  },
  {
   "texto": "jako by se zdálo."
  },
  {
   "texto": "Ráno vstane, do snídaně"
  },
  {
   "texto": "musí rosou kropit,"
  },
  {
   "texto": "měsíčka zavřít do chlívka,"
  },
  {
   "texto": "potom v slunci topit."
  },
  {
   "texto": "Dříve čerty, noční duchy"
  },
  {
   "texto": "strčit do pytlíka"
  },
  {
   "texto": "a hvězdičky puť-ťu-ťu-ťu"
  },
  {
   "texto": "svolat do kurníka."
  },
  {
   "texto": "Každý ptáček, každý brouček,"
  },
  {
   "texto": "slon až do komára"
  },
  {
   "texto": "má hned ráno nasypáno"
  },
  {
   "texto": "z božího špejchara."
  },
  {
   "texto": "A když potom lidi vstanou,"
  },
  {
   "texto": "to je teprv správa!"
  },
  {
   "texto": "Někdy nevím samým křikem,"
  },
  {
   "texto": "kde mně stojí hlava."
  },
  {
   "texto": "Ten, kdo nikdy neměl v uchu"
  },
  {
   "texto": "vosy a brabence,"
  },
  {
   "texto": "neví, co je Perunova"
  },
  {
   "texto": "ranní audience."
  },
  {
   "texto": "To je křiku a modlení,"
  },
  {
   "texto": "až mne uši brní,"
  },
  {
   "texto": "ten zpívá, ten šepce, vzdychá,"
  },
  {
   "texto": "ten zas žalmy frní."
  },
  {
   "texto": "A co všechno na mně chtějí,"
  },
  {
   "texto": "nelze vyjmenovat,"
  },
  {
   "texto": "zbláznil bych se, kdybych si to"
  },
  {
   "texto": "měl jen pamatovat."
  },
  {
   "texto": "Ten chce zdraví, ta chce děti,"
  },
  {
   "texto": "ten nemá co jísti,"
  },
  {
   "texto": "ti zas, abych nedovolil"
  },
  {
   "texto": "ve fabrikách přísti."
  },
  {
   "texto": "Ten mne prosí, bych mu hlídal"
  },
  {
   "texto": "louky a osení,"
  },
  {
   "texto": "ten zas chce, abych pomáhal"
  },
  {
   "texto": "krávě při telení."
  },
  {
   "texto": "Ten chce zimu, ten chce teplo,"
  },
  {
   "texto": "ten zas časy jiné,"
  },
  {
   "texto": "jeden chce mít žito drahé"
  },
  {
   "texto": "a druhý laciné."
  },
  {
   "texto": "Jeden sedlák prosí o déšť,"
  },
  {
   "texto": "zasil kousek lenu;"
  },
  {
   "texto": "druhý prosí hezké časy,"
  },
  {
   "texto": "by měl sucho k senu."
  },
  {
   "texto": "Že jsem stvořil staré báby,"
  },
  {
   "texto": "to mne nejvíc mrzí,"
  },
  {
   "texto": "nepřestanou-li mne soužit,"
  },
  {
   "texto": "zahladím je brzy."
  },
  {
   "texto": "Hrom ať do nich! abych neklel,"
  },
  {
   "texto": "zdržet se nemohu!"
  },
  {
   "texto": "Když jí koza málo dojí,"
  },
  {
   "texto": "běží k pánu zbohu."
  },
  {
   "texto": "Sám se žádný starat nechce,"
  },
  {
   "texto": "o všechno se modlí,"
  },
  {
   "texto": "jako by měl každý boha"
  },
  {
   "texto": "jen pro své pohodlí."
  },
  {
   "texto": "Tomu sušit, tomu močit,"
  },
  {
   "texto": "tomu pole hnojit,"
  },
  {
   "texto": "dřív si, prase, zdraví zkazil,"
  },
  {
   "texto": "potom ho mám zhojit!"
  },
  {
   "texto": "Ta mne moří ve dne, v noci,"
  },
  {
   "texto": "ráda by se vdala,"
  },
  {
   "texto": "ten se modlí, by Morena"
  },
  {
   "texto": "jeho ženu vzala."
  },
  {
   "texto": "Ten chce výhru z loterie,"
  },
  {
   "texto": "špendáže mi nosí"
  },
  {
   "texto": "a co jsou asekurace,"
  },
  {
   "texto": "též o oheň prosí!"
  },
  {
   "texto": "Ó, vy šelmy! kdybych nebyl"
  },
  {
   "texto": "příliš dobrotivý,"
  },
  {
   "texto": "zmačkal bych vás na povidla"
  },
  {
   "texto": "jako shnilé slívy! — — —“"
  },
  {
   "texto": "Šňup si zlostí haličského,"
  },
  {
   "texto": "jak z moždíře kýchnul:"
  },
  {
   "texto": "to zahřmělo, zablejsklo se,"
  },
  {
   "texto": "déšť na zem vyšplíchnul."
  },
  {
   "texto": "Věru, Vašku! bohem býti,"
  },
  {
   "texto": "to žádný špás není:"
  },
  {
   "texto": "Brixen, ten je proti tomu"
  },
  {
   "texto": "ještě vyražení! —"
  },
  {
   "texto": "Pozdě v noci, když utich svět"
  },
  {
   "texto": "a lid přestal bouřit,"
  },
  {
   "texto": "chtěl si Perun usoužený"
  },
  {
   "texto": "dýmčičku vykouřit."
  },
  {
   "texto": "Když si Širas tümbekia"
  },
  {
   "texto": "cpal do nargilie,"
  },
  {
   "texto": "tu mu začla Perunice"
  },
  {
   "texto": "držet litanie."
  },
  {
   "texto": "—Však jsem já dobře slyšela"
  },
  {
   "texto": "za dveřmi skrz škvíru,"
  },
  {
   "texto": "co jsi vzkázal po drábovi"
  },
  {
   "texto": "cáru Vladimíru."
  },
  {
   "texto": "Nezačínej si jen s cárem,"
  },
  {
   "texto": "to já pořád říkám,"
  },
  {
   "texto": "že to se svou oposicí"
  },
  {
   "texto": "nepřivedeš nikam."
  },
  {
   "texto": "Každému do očí řekneš,"
  },
  {
   "texto": "co máš na jazyku,"
  },
  {
   "texto": "a děláš si nepřátele,"
  },
  {
   "texto": "nemáš politiku."
  },
  {
   "texto": "A když žena po celý den"
  },
  {
   "texto": "bručí jen a štěká,"
  },
  {
   "texto": "och! to musí z kůže vyhnat"
  },
  {
   "texto": "boha i člověka!"
  },
  {
   "texto": "Ach! Perune, Perunečku!"
  },
  {
   "texto": "lituje tě tuze:"
  },
  {
   "texto": "zejtra na tě teprv čeká"
  },
  {
   "texto": "přežalostná chůze!"
  },
  {
   "texto": "Oj, Perune přenešťastný,"
  },
  {
   "texto": "kam jsi myslil, brachu?"
  },
  {
   "texto": "hanět cára, svého pána,"
  },
  {
   "texto": "a to beze strachu?"
  },
  {
   "texto": "Oj, Perune! kam jsi myslil,"
  },
  {
   "texto": "přenešťastné bůže?"
  },
  {
   "texto": "Utec, utec, jak tě chytnou,"
  },
  {
   "texto": "nic ti nepomůže!"
  }
 ]
}