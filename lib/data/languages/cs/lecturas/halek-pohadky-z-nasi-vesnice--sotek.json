 "modo": "texto",
 "parrafos": [
  {
   "texto": "Šotek"
  },
  {
   "texto": "Přišel k nám šotek nezbedný,"
  },
  {
   "texto": "ten dával z konvice pít —"
  },
  {
   "texto": "„Žertu mám pramen bezedný,"
  },
  {
   "texto": "jen račte na ochuť vzít!“"
  },
  {
   "texto": "Byla to vína taková,"
  },
  {
   "texto": "kdo pil, vše na sebe řek’,"
  },
  {
   "texto": "řekla hned paní sládková:"
  },
  {
   "texto": "„Náš tambor velký je rek.“"
  },
  {
   "texto": "Rychtářka řekla: „V sobotu"
  },
  {
   "texto": "měl farář tuze mne rád,“"
  },
  {
   "texto": "pan kaplan mlask’ si v dobrotu,"
  },
  {
   "texto": "že dojde na celibát."
  },
  {
   "texto": "Ponocný říkal na sebe:"
  },
  {
   "texto": "když troubí u dvora rád,"
  },
  {
   "texto": "šafářka kouká do nebe,"
  },
  {
   "texto": "má rty jak medový slad."
  },
  {
   "texto": "Řekla hned každá děvice,"
  },
  {
   "texto": "kdo sen jí oslazuje,"
  },
  {
   "texto": "mládenci vzdychli velice"
  },
  {
   "texto": "a mnohý lamentuje."
  },
  {
   "texto": "Řekla též naše paňmáma:"
  },
  {
   "texto": "„Mám sladkou na polici,“"
  },
  {
   "texto": "pan farář lomil rukama:"
  },
  {
   "texto": "„To patří v zpovědnici!“"
  },
  {
   "texto": "Byla to ve vsi upřímnost,"
  },
  {
   "texto": "kdo nepil, tuze se smál,"
  },
  {
   "texto": "rychtář jen jde co vážný host:"
  },
  {
   "texto": "„To nesmím trpěti dál!“"
  },
  {
   "texto": "Nad šotkem soud se sestavil,"
  },
  {
   "texto": "však dříve ochutnal též:"
  },
  {
   "texto": "„Lidičky, to je kratochvil,"
  },
  {
   "texto": "mám rohy jako ta věž!“"
  },
  {
   "texto": "Po návsi běhal celý den"
  },
  {
   "texto": "to k dveřím ode dveří:"
  },
  {
   "texto": "„Lidičky dobří, pojďte ven,"
  },
  {
   "texto": "sic žena neuvěří!“ —"
  },
  {
   "texto": "Zašel k nám šotek nezbeda,"
  },
  {
   "texto": "už mnohý uplynul čas,"
  },
  {
   "texto": "a dnes-li k nám zajde — přeběda!"
  },
  {
   "texto": "vše na vlas najde to zas."
  },
  {
   "texto": "Náš pan sládek, slavný doktor,"
  },
  {
   "texto": "ječmen upraží,"
  },
  {
   "texto": "ale slavnější je Vávra,"
  },
  {
   "texto": "ten to rozváží,"
  },
  {
   "texto": "divy dělá všem všudy,"
  },
  {
   "texto": "na korbele, na sudy:"
  },
  {
   "texto": "„Nate, lidé,"
  },
  {
   "texto": "zapomeňte na trudy!“"
  },
  {
   "texto": "Vědra samé moudré hlavy,"
  },
  {
   "texto": "jaké rozumy!"
  },
  {
   "texto": "Náves plna pacientů —"
  },
  {
   "texto": "co on neumí?"
  },
  {
   "texto": "„Juchej!“ vejskne, zastaví,"
  },
  {
   "texto": "načepí: „Všem na zdraví!“"
  },
  {
   "texto": "a kdo lízne —"
  },
  {
   "texto": "už se také pozdraví."
  },
  {
   "texto": "Ale kdo tam nejdýl prodlí,"
  },
  {
   "texto": "zmladne na srdci,"
  },
  {
   "texto": "od sudů pak táhnou domů"
  },
  {
   "texto": "velcí mudrci."
  },
  {
   "texto": "Náves hlavám nestačí,"
  },
  {
   "texto": "svět je celý jinačí,"
  },
  {
   "texto": "každý věří,"
  },
  {
   "texto": "že se země otáčí."
  },
  {
   "texto": "Náš pan sládek, slavný doktor,"
  },
  {
   "texto": "dlouho buď nám živ,"
  },
  {
   "texto": "až ten jeho Vávra zkusí"
  },
  {
   "texto": "tento divů div:"
  },
  {
   "texto": "němým ústa rozváže,"
  },
  {
   "texto": "chromým tančit rozkáže,"
  },
  {
   "texto": "pak těm druhým"
  },
  {
   "texto": "dodá k žízni kuráže!"
  }
 ]
}