   "texto": "Poduškou byl mně zármutek"
  },
  {
   "texto": "a slzy místo spaní;"
  },
  {
   "texto": "mé srdce, ne tak hlasitě:"
  },
  {
   "texto": "již dám se na pokání."
  },
  {
   "texto": "Měsíček oknem vchází k nám,"
  },
  {
   "texto": "má rubášové šaty,"
  },
  {
   "texto": "a v srdci mém cos doznělo,"
  },
  {
   "texto": "jak ptáček kropenatý."
  },
  {
   "texto": "Měsíčku, zapal hvězdy tam;"
  },
  {
   "texto": "rosou nechť květ se šatí,"
  },
  {
   "texto": "slavíka probuď ze spaní,"
  },
  {
   "texto": "jen lidi - ty nech spáti!"
  },
  {
   "texto": "A neste lásku nádhernou —"
  },
  {
   "texto": "však mrtvolu tu znáte;"
  },
  {
   "texto": "jsem teď jen člověk nebohý —"
  },
  {
   "texto": "ach, škoda nastokráte!"
  },
  {
   "texto": "»Nedobře lidem bez zpěvu,« —"
  },
  {
   "texto": "tak Bůh v svých soudech mluvil —"
  },
  {
   "texto": "a stvořil lidem básníka"
  },
  {
   "texto": "a to mu věno uvil:"
  },
  {
   "texto": "»Co živ jsi, neměj pokoje,"
  },
  {
   "texto": "jen o bolestech zvídej,"
  },
  {
   "texto": "a v naději vždy oklamán,"
  },
  {
   "texto": "svůj chléb jen v pláči jídej!"
  },
  {
   "texto": "Nech srdce na krev zderou ti —"
  },
  {
   "texto": "ty na tu krev se dívej,"
  },
  {
   "texto": "nech štvou tě po všech končinách —"
  },
  {
   "texto": "ty miluj je a — zpívej!«"
  },
  {
   "texto": "Ten los nám pěvcům obecný,"
  },
  {
   "texto": "svět zná jen naše zpěvy,"
  },
  {
   "texto": "však co nás k zpěvu pohnulo —"
  },
  {
   "texto": "to žádný v světě neví."
  },
  {
   "texto": "Já na dlouhý čas oněměl,"
  },
  {
   "texto": "tak jako skála pustá;"
  },
  {
   "texto": "však jedno Tvé políbení"
  },
  {
   "texto": "mi rozvázalo ústa."
  },
  {
   "texto": "To bylo jak dešť májový"
  },
  {
   "texto": "na půdu deště lačnou;"
  },
  {
   "texto": "teď sladké písně v duši mé"
  },
  {
   "texto": "zas hojně rašit začnou."
  },
  {
   "texto": "Až tělo zemi odevzdám"
  },
  {
   "texto": "a Bohu svoji duši,"
  },
  {
   "texto": "pak žádám, abych pohřben byl,"
  },
  {
   "texto": "jak na pěvce se sluší."
  },
  {
   "texto": "Na hlavu věnec bobkový"
  },
  {
   "texto": "a do rukou chci lyru:"
  },
  {
   "texto": "ať vědí noví sousedé"
  },
  {
   "texto": "kdo vchází v přístav míru."
  },
  {
   "texto": "Mne lyra byla svatá vždy"
  },
  {
   "texto": "a nikdy hračka pouhá:"
  },
  {
   "texto": "ať jest mi ještě ozdobou,"
  },
  {
   "texto": "když noc mne skryje dlouhá."
  },
  {
   "texto": "Však pakli by zde životem snem"
  },
  {
   "texto": "neustanete trudit:"
  },
  {
   "texto": "pak mrtvé na vás probudím,"
  },
  {
   "texto": "a ti vás přijdou zbudit."
  },
  {
   "texto": "Až v hrobě nám se zasteskne,"
  },
  {
   "texto": "já zpěvem k nim se vmísím"
  },
  {
   "texto": "a já jim písně zazpívám,"
  },
  {
   "texto": "že k životu je vzkřísím."
  }
 ]
