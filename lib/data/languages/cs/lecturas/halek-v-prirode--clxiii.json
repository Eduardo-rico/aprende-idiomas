 "modo": "texto",
 "parrafos": [
  {
   "texto": "CLXIII."
  },
  {
   "texto": "Tyrana vedli na popravu,"
  },
  {
   "texto": "lid jásal: „Sláva svobodě!“"
  },
  {
   "texto": "Duch času šedivou zved’ hlavu"
  },
  {
   "texto": "a smál se lidské přírodě."
  },
  {
   "texto": "„Co nám se posmíváš tím mrazem,"
  },
  {
   "texto": "kdy hlavní zlo jsme vyvrhli?“ —"
  },
  {
   "texto": "„Aj, vy umíte tnouti rázem,"
  },
  {
   "texto": "a sotva chlup jste vytrhli."
  },
  {
   "texto": "Tam pohleď na ty tvoje davy,"
  },
  {
   "texto": "a slyš ten prázdný hrdel jas:"
  },
  {
   "texto": "tam tyran hlava vedle hlavy,"
  },
  {
   "texto": "než nadáš se, má hlavu zas.“"
  },
  {
   "texto": "A v skutku. Steré tváře bledly,"
  },
  {
   "texto": "jen hlesnout, každá přivolí —"
  },
  {
   "texto": "už jednoho tam v slávě zvedli,"
  },
  {
   "texto": "a ještě dnes ho nastolí."
  },
  {
   "texto": "„Nuž, brachu, měj se také k jasu,"
  },
  {
   "texto": "a neb si zaplač v útěchu!“ —"
  },
  {
   "texto": "Ba, půjdu s tebou, duchu času,"
  },
  {
   "texto": "jeť smysl jen v tvém posměchu."
  },
  {
   "texto": "Proud věků zastavil se náhle,"
  },
  {
   "texto": "mžik přítomný ve skálu zved’,"
  },
  {
   "texto": "smrt sedla na ni, neobsáhle"
  },
  {
   "texto": "zpět napjala i k předu hled."
  },
  {
   "texto": "Co za ní, v pachuť s labužníky"
  },
  {
   "texto": "čte v nedosytné paměti:"
  },
  {
   "texto": "co králů smetla v poběhlíky,"
  },
  {
   "texto": "co bohů zvrhla na smetí."
  },
  {
   "texto": "Co před ní, s hledem bez pohnutí"
  },
  {
   "texto": "a z lačné zkoumá zlovůle,"
  },
  {
   "texto": "co ještě lidských nedochutí"
  },
  {
   "texto": "na příští zbývá tabule:"
  },
  {
   "texto": "Tu rodná domýšlivost jmena,"
  },
  {
   "texto": "jmen nesmrtelnost zvětralá,"
  },
  {
   "texto": "tu nízkost zbožně nalíčená,"
  },
  {
   "texto": "by na božství si zahrála —"
  },
  {
   "texto": "A radost plá jí v důlků prázdni,"
  },
  {
   "texto": "tvář démona to v prodlení,"
  },
  {
   "texto": "smích její do všech věků zazní:"
  },
  {
   "texto": "kdos nesmrtelný podle ní?"
  },
  {
   "texto": "Hra ošklivá, kdy s maskou boží"
  },
  {
   "texto": "na scéně vidím zlosyny,"
  },
  {
   "texto": "jimž zločinem je, že jsme lidmi,"
  },
  {
   "texto": "jich činy zlé však bez viny."
  },
  {
   "texto": "Tak s čelem smělým na soud volat"
  },
  {
   "texto": "ty svaté jiskry velkých snah,"
  },
  {
   "texto": "a odsouzet a kletbou šlehat"
  },
  {
   "texto": "ten trochu světla v našich tmách —"
  },
  {
   "texto": "Tak beze studu hlásat světu"
  },
  {
   "texto": "svých kejklí božský rodokmen,"
  },
  {
   "texto": "a přírodu, to dítě boží"
  },
  {
   "texto": "z otcovských síní týrat ven —"
  },
  {
   "texto": "Tak s myslí nízkou povyšovat"
  },
  {
   "texto": "svůj chtíč na božské vůle znět,"
  },
  {
   "texto": "a svatou mluvu země, nebes"
  },
  {
   "texto": "chtít přehlušit a neslyšet —"
  },
  {
   "texto": "Ó jděte mi! Tak umělými"
  },
  {
   "texto": "přec nejste mistry, na mou čest,"
  },
  {
   "texto": "bych neviděl skrz vaši masku"
  },
  {
   "texto": "až do duše, jak bídna jest!"
  }
 ]
}