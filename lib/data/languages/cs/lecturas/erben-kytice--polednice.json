 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "U lavice dítě stálo,"
  },
  {
   "texto": "z plna hrdla křičelo."
  },
  {
   "texto": "„Bodejž jsi jen trochu málo,"
  },
  {
   "texto": "ty cikáně, mlčelo."
  },
  {
   "texto": "Poledne v tom okamžení,"
  },
  {
   "texto": "táta přijde z roboty:"
  },
  {
   "texto": "a mně hasne u vaření"
  },
  {
   "texto": "pro tebe, ty zlobo, ty!"
  },
  {
   "texto": "Mlč, hle husar a kočárek —"
  },
  {
   "texto": "hrej si — tu máš kohouta!“ —"
  },
  {
   "texto": "Než kohout, vůz i husárek"
  },
  {
   "texto": "bouch, bác! letí do kouta."
  },
  {
   "texto": "A zas do hrozného křiku —"
  },
  {
   "texto": "„I bodejž tě sršeň sám — !"
  },
  {
   "texto": "Že na tebe, nezvedníku,"
  },
  {
   "texto": "polednici zavolám!"
  },
  {
   "texto": "Pojď si proň, ty polednice,"
  },
  {
   "texto": "pojď, vem si ho, zlostníka!“"
  },
  {
   "texto": "A hle, tu kdos u světnice"
  },
  {
   "texto": "dvéře zlehka odmyká."
  },
  {
   "texto": "Malá, hnědá, tváři divé"
  },
  {
   "texto": "pod plachetkou osoba;"
  },
  {
   "texto": "o berličce, hnáty křivé,"
  },
  {
   "texto": "hlas — vichřice podoba!"
  },
  {
   "texto": "„Dej sem dítě!“ — „Kriste Pane,"
  },
  {
   "texto": "odpusť hříchy hříšníci!“"
  },
  {
   "texto": "Div že smrt ji neovane,"
  },
  {
   "texto": "ejhle tuť — polednici!"
  },
  {
   "texto": "Ke stolu se plíží tiše"
  },
  {
   "texto": "polednice jako stín:"
  },
  {
   "texto": "matka hrůzou sotva dýše,"
  },
  {
   "texto": "dítě chopíc na svůj klín."
  },
  {
   "texto": "A vinouc je, zpět pohlíží —"
  },
  {
   "texto": "běda, běda dítěti!"
  },
  {
   "texto": "Polednice blíž se plíží,"
  },
  {
   "texto": "blíž — a již je v zápětí."
  },
  {
   "texto": "Již vztahuje po něm ruku —"
  },
  {
   "texto": "matka tisknouc ramena:"
  },
  {
   "texto": "„Pro Kristovu drahou muku!“ —"
  },
  {
   "texto": "klesá smyslů zbavena."
  },
  {
   "texto": "Tu slyš: jedna — druhá — třetí —"
  },
  {
   "texto": "poledne zvon udeří;"
  },
  {
   "texto": "klika cvakla, dvéře letí —"
  },
  {
   "texto": "táta vchází do dveří."
  },
  {
   "texto": "Ve mdlobách tu matka leží,"
  },
  {
   "texto": "k ňadrám dítě přimknuté;"
  },
  {
   "texto": "matku vzkřísil ještě stěží,"
  },
  {
   "texto": "avšak dítě — zalknuté."
  }
 ]
}