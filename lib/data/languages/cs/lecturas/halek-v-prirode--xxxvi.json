 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XXXVI."
  },
  {
   "texto": "V mé říši slunce nezachází"
  },
  {
   "texto": "a nezajde leč koncem světů,"
  },
  {
   "texto": "jáť zakládal ji s věčnou krásou,"
  },
  {
   "texto": "tož s přírodou, když byla v květu."
  },
  {
   "texto": "A my ji zakládali takto:"
  },
  {
   "texto": "za oblohu se volnost kleni,"
  },
  {
   "texto": "na zemi teplem dýchej láska,"
  },
  {
   "texto": "a smutek dojdi vysušení."
  },
  {
   "texto": "A my ji zakládali dále:"
  },
  {
   "texto": "co poupětem, nech v kvítko roste,"
  },
  {
   "texto": "květ ducha nejkrašším buď květem"
  },
  {
   "texto": "a nejbídnějším bejlí sprosté."
  },
  {
   "texto": "A my ji založili takto:"
  },
  {
   "texto": "co v srdci jara, tím se hřejte,"
  },
  {
   "texto": "co ve vás lidského, tím buďte,"
  },
  {
   "texto": "pak přijďte k nám a obývejte."
  },
  {
   "texto": "Dnes do skoku a do písničky!"
  },
  {
   "texto": "Dnes pravá veselka je boží,"
  },
  {
   "texto": "dnes celý svět a všecko v párku"
  },
  {
   "texto": "se vedou k svatebnímu loži."
  },
  {
   "texto": "Ve zvonku květném mušky tančí,"
  },
  {
   "texto": "pod travou brouček křídla zvedá,"
  },
  {
   "texto": "a vody šumí, lesy voní,"
  },
  {
   "texto": "a kdo je nemá, srdce hledá."
  },
  {
   "texto": "Na nebi zapalují svíce."
  },
  {
   "texto": "na západě panenské rdění,"
  },
  {
   "texto": "a slavík již to ohlašuje,"
  },
  {
   "texto": "ten velkněz, u velebném znění."
  },
  {
   "texto": "Dnes velká kniha poesie"
  },
  {
   "texto": "až do kořán je otevřena,"
  },
  {
   "texto": "dnes každá struna všehomíru"
  },
  {
   "texto": "na žert i pravdu natažena."
  },
  {
   "texto": "A nebe skví se, vzduch se chvěje,"
  },
  {
   "texto": "dnes jedna píseň světem letí,"
  },
  {
   "texto": "dnes zem a nebe jeden pohár,"
  },
  {
   "texto": "a tvorstvo při něm ve objetí."
  },
  {
   "texto": "Večerní les rozvázal zvonky,"
  },
  {
   "texto": "to ptáci zvoní k tiché skrejši:"
  },
  {
   "texto": "kukačka zvoní na ty větší"
  },
  {
   "texto": "a slavík na ty líbeznější."
  },
  {
   "texto": "Les každou větev písní kropí"
  },
  {
   "texto": "a každý lístek jeho dítě,"
  },
  {
   "texto": "na nebes strop jim lampu věsí,"
  },
  {
   "texto": "a stříbrné z ní táhne nitě."
  },
  {
   "texto": "A každá nit na konci spánek,"
  },
  {
   "texto": "sny jako jiskry v stromech skáčí,"
  },
  {
   "texto": "jen laňka se sebe je střásá"
  },
  {
   "texto": "a před lesem se v rose máčí."
  },
  {
   "texto": "Teď usnuli i zvoníkové,"
  },
  {
   "texto": "les dýchá v prvním zadřímnutí,"
  },
  {
   "texto": "a jest-li slavík zaklokotá,"
  },
  {
   "texto": "to ze spánku je prokouknutí."
  },
  {
   "texto": "Teď všecko spí, i laňka dřímá,"
  },
  {
   "texto": "i zvonky visí dovybdělé,"
  },
  {
   "texto": "noc kráčí jako všeho dozvuk —"
  },
  {
   "texto": "tak příroda si k spánku stele."
  },
  {
   "texto": "Jak spanilé to sourozenky,"
  },
  {
   "texto": "jež jaro zvábí z poupěte!"
  },
  {
   "texto": "A přece není nad myšlénky,"
  },
  {
   "texto": "v něž krásná mysl rozkvete."
  },
  {
   "texto": "Tyť křídlem zem obejmou celou"
  },
  {
   "texto": "jak duha, v oblouk napjatá,"
  },
  {
   "texto": "a bratrský všem domov stelou"
  },
  {
   "texto": "jak háj, kdy hostí ptáčata."
  },
  {
   "texto": "V nich svět i nebe s krásou mnohou"
  },
  {
   "texto": "jak v démantu se zaleskne,"
  },
  {
   "texto": "a co je smutku pod oblohou,"
  },
  {
   "texto": "ten v slze jich si zasteskne."
  }
 ]
}