 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "30"
  },
  {
   "texto": "Po mém pohřbu křepčili,"
  },
  {
   "texto": "hudba skočnou hrála,"
  },
  {
   "texto": "matka jídlem, nápojem"
  },
  {
   "texto": "hosti častovala."
  },
  {
   "texto": "Druhý den se dělili"
  },
  {
   "texto": "o mých zámků devět,"
  },
  {
   "texto": "že jsem málo zůstavil,"
  },
  {
   "texto": "nadělali klevet."
  },
  {
   "texto": "„Komuže mou bývalou"
  },
  {
   "texto": "milenku dá máma?“ -"
  },
  {
   "texto": "„O tu já se nestarám,"
  },
  {
   "texto": "postará se sama.“"
  },
  {
   "texto": "Krásný obraz manželů dvou svorných!"
  },
  {
   "texto": "Jak dvě vrby v jedné vlně obraz svorně koupají,"
  },
  {
   "texto": "stejnou rosu pijí, v stejném slunci žijí,"
  },
  {
   "texto": "v stejném vánku lístky lehké houpají."
  },
  {
   "texto": "Jsou jak lilje dvě na jednom keři:"
  },
  {
   "texto": "stejně pučí, stejně květou, stejně stářím klesají,"
  },
  {
   "texto": "ve své sněhobílé barvě lesky"
  },
  {
   "texto": "barev duhových všech chovají."
  },
  {
   "texto": "Teskno však, kde dvojspřež divá táhne,"
  },
  {
   "texto": "jeden líně jde a druhý skáče,"
  },
  {
   "texto": "jeden vpravo, druhý vlevo tíhne,"
  },
  {
   "texto": "jeden zpívá si, kdy druhý pláče."
  },
  {
   "texto": "V krásném vodojemu vlnky"
  },
  {
   "texto": "obraz hvězdný houpají,"
  },
  {
   "texto": "po trávníčku lehké nožky"
  },
  {
   "texto": "každé noci stoupají."
  },
  {
   "texto": "„Doňo Anno, doňo krásná,"
  },
  {
   "texto": "což ty vlny šeptají?"
  },
  {
   "texto": "Zdaž se po manželi starém,"
  },
  {
   "texto": "krásná doňo, neptají?“"
  },
  {
   "texto": "„Kmetovi již třeba spánku,"
  },
  {
   "texto": "aby mnohý dožil den, -"
  },
  {
   "texto": "mladá jsem a nepokojný"
  },
  {
   "texto": "mám já ještě v noci sen."
  },
  {
   "texto": "Bych mu nerušila spánek,"
  },
  {
   "texto": "pudí mne to z lože ven,"
  },
  {
   "texto": "a don Fernan, krásný, mladý,"
  },
  {
   "texto": "ten má se mnou stejný sen.“"
  },
  {
   "texto": "Černý vůz se padlým sněhem"
  },
  {
   "texto": "kolotavě plouží,"
  },
  {
   "texto": "kolo vrzá, v stálém pláči"
  },
  {
   "texto": "dál a dál se krouží."
  },
  {
   "texto": "Na pokryvce ovetšelé"
  },
  {
   "texto": "věnec z myrty leží,"
  },
  {
   "texto": "od věnce pak bílá stuha"
  },
  {
   "texto": "letmo s vozem běží."
  },
  {
   "texto": "„Koho vezeš? Děvče? Hocha?"
  },
  {
   "texto": "Dej mu pánbůh nebe.“"
  },
  {
   "texto": "„Starou pannu!“ - „Ach to jiná!"
  },
  {
   "texto": "Nechť ji v zemi zebe!“"
  },
  {
   "texto": "Černý vůz se padlým sněhem"
  },
  {
   "texto": "kolotavě plouží, -"
  },
  {
   "texto": "ještě hana těsnou rakev"
  },
  {
   "texto": "staré panně ouží."
  },
  {
   "texto": "Mnohé srdce milovalo,"
  },
  {
   "texto": "láskou blaze květlo, -"
  },
  {
   "texto": "jenže zjara dchnutí mrazu"
  },
  {
   "texto": "bílý zvonek zhnětlo."
  },
  {
   "texto": "Hrůzné nemilosrdenství"
  },
  {
   "texto": "srdce v poušť vyvrhlo,"
  },
  {
   "texto": "a když v bolu churavělo,"
  },
  {
   "texto": "smích si z něho strhlo."
  }
 ]
}