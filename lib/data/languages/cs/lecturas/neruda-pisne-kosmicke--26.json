 "parrafos": [
  {
   "texto": "26"
  },
  {
   "texto": "Vzhůru již hlavu, národe,"
  },
  {
   "texto": "k nebi své zdvihni oči!"
  },
  {
   "texto": "Viz: jsou tam i malé hvězdičky,"
  },
  {
   "texto": "kol nichž se velké točí!"
  },
  {
   "texto": "Toť prostě tím: ty maličké"
  },
  {
   "texto": "z jadrného jsou fládru,"
  },
  {
   "texto": "ale ty velké a poslušné"
  },
  {
   "texto": "jen z plynových jsou hadrů."
  },
  {
   "texto": "Troufám, že při té myšlénce"
  },
  {
   "texto": "srdce ti povyskočí -"
  },
  {
   "texto": "nuž - buďme tou malou hvězdičkou,"
  },
  {
   "texto": "kol níž se velké točí!"
  },
  {
   "texto": "Jde to, ach jde! Jen každý hleď"
  },
  {
   "texto": "k vlastnímu dobře jádru:"
  },
  {
   "texto": "bude-li každý z nás z křemene,"
  },
  {
   "texto": "je celý národ z kvádrů!"
  },
  {
   "texto": "Kdo měkkým je, ten bídně mře!"
  },
  {
   "texto": "Aj, lide, vzhůru k nebi zrak:"
  },
  {
   "texto": "velká ta světla - samý drak -"
  },
  {
   "texto": "had hada-li nepozře,"
  },
  {
   "texto": "drakem se nestane!"
  },
  {
   "texto": "Boj, všude boj, kam oko zře!"
  },
  {
   "texto": "I věčné slunce, chce-li žít,"
  },
  {
   "texto": "musí se kolem s slunci bít -"
  },
  {
   "texto": "had hada-li nepozře,"
  },
  {
   "texto": "drakem se nestane!"
  },
  {
   "texto": "Klam, v národech že láska vře!"
  },
  {
   "texto": "Ach neposlouchej hravých vnad,"
  },
  {
   "texto": "živ-li chceš být, buď lačný had -"
  },
  {
   "texto": "had hada-li nepozře,"
  },
  {
   "texto": "drakem se nestane!"
  },
  {
   "texto": "Slunce je hvězda proměnná"
  },
  {
   "texto": "a člověk jeho tvorem —"
  },
  {
   "texto": "jak krásný je ten člověk přec"
  },
  {
   "texto": "s svým ideálním vzorem!"
  },
  {
   "texto": "Vždyť i to Slunce oslnné"
  },
  {
   "texto": "je samá, samá skvrna —"
  },
  {
   "texto": "a člověk sám chce v světě být"
  },
  {
   "texto": "jak z křišťálného zrna!"
  },
  {
   "texto": "V jistém vždy Slunce období"
  },
  {
   "texto": "se širším cloní kalem —"
  },
  {
   "texto": "a člověk zas čím dál tím víc"
  },
  {
   "texto": "chce stát se ideálem!"
  },
  {
   "texto": "Měsíček mrtvý - budoucnost,"
  },
  {
   "texto": "a Slunko - minulost naše,"
  },
  {
   "texto": "mezi oběma polétá"
  },
  {
   "texto": "myšlénka života plaše."
  },
  {
   "texto": "Vířivě časy se valí,"
  },
  {
   "texto": "minulost, přítomnost, budoucnost -"
  },
  {
   "texto": "ach jedna se ve druhou halí."
  },
  {
   "texto": "Někdy se mezi Měsíček"
  },
  {
   "texto": "a Slunko stavíme směle,"
  },
  {
   "texto": "rouškou zastřem si budoucnost,"
  },
  {
   "texto": "žijem až převesele;"
  },
  {
   "texto": "někdy zas vráží se klínem"
  },
  {
   "texto": "Měsíček před Slunko života,"
  },
  {
   "texto": "a mysl je zastřena stínem."
  }
 ]
}