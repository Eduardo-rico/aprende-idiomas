 "parrafos": [
  {
   "texto": "XII."
  },
  {
   "texto": "Jsmeť lidé my jen jak ten strom,"
  },
  {
   "texto": "kdy v zem zapustil kořen:"
  },
  {
   "texto": "oklesťte jej, přesaďte jej,"
  },
  {
   "texto": "a život jeho zmořen."
  },
  {
   "texto": "A mysl naše v místě tkví,"
  },
  {
   "texto": "kde nám kolébku stlali,"
  },
  {
   "texto": "kde přítelky a přátelé"
  },
  {
   "texto": "nás v dětskou souhru zvali."
  },
  {
   "texto": "A mysl naše v době tkví,"
  },
  {
   "texto": "kdy srdce v sladké leči"
  },
  {
   "texto": "si našlo družku a tu řeč,"
  },
  {
   "texto": "již lásky zveme řečí."
  },
  {
   "texto": "A vazbu milých obvyků,"
  },
  {
   "texto": "i sny, v nichž ráj nám stvořen —"
  },
  {
   "texto": "oklesťte jej, přesaďte jej,"
  },
  {
   "texto": "a život náš je zbořen."
  },
  {
   "texto": "Žitné pole, žitné pole,"
  },
  {
   "texto": "jak to hraje vesele!"
  },
  {
   "texto": "Každý klásek muzikantem,"
  },
  {
   "texto": "klasů jak když nastele."
  },
  {
   "texto": "Hedbávným to šatem šustí,"
  },
  {
   "texto": "větřík v skočnou zadupe,"
  },
  {
   "texto": "slunce objímá a líbá,"
  },
  {
   "texto": "jen to v stéblu zalupe."
  },
  {
   "texto": "Za motýlkem včelka šeptem,"
  },
  {
   "texto": "zda kdo v chrpě nevězí,"
  },
  {
   "texto": "a ten cvrček posměváček"
  },
  {
   "texto": "s křepeličkou pod mezí."
  },
  {
   "texto": "Žitné pole, žitné pole,"
  },
  {
   "texto": "jak to hraje vesele!"
  },
  {
   "texto": "A má mysl jako v tanci,"
  },
  {
   "texto": "jak když písní nastele."
  },
  {
   "texto": "Potůček s snivou olšinou,"
  },
  {
   "texto": "to jak ten klouček s dívčinou:"
  },
  {
   "texto": "on sladce šeptne sladký děj,"
  },
  {
   "texto": "a ona kývne líbezněj."
  },
  {
   "texto": "A on co najde po cestě,"
  },
  {
   "texto": "co své to prostře nevěstě,"
  },
  {
   "texto": "ji v květ a perle usadí"
  },
  {
   "texto": "a v snubnou zeleň kapradí."
  },
  {
   "texto": "A ona s myslí dětinnou"
  },
  {
   "texto": "za jeho stře se hladinou,"
  },
  {
   "texto": "a všecky sny a myšlénky"
  },
  {
   "texto": "s ním tká na písně praménky."
  },
  {
   "texto": "Však není láska štěstí jen,"
  },
  {
   "texto": "jeť někdy jak přetěžký sen,"
  },
  {
   "texto": "jak vrby svislé zvětvení,"
  },
  {
   "texto": "jež v zlé tam stojí znamení."
  },
  {
   "texto": "A jak se lásky mladý děj"
  },
  {
   "texto": "pod olší tká nejlíbezněj:"
  },
  {
   "texto": "tak bol mi, dívko, nad tebou,"
  },
  {
   "texto": "jež úkoj hledáš pod vrbou."
  },
  {
   "texto": "Matička příroda mi spala,"
  },
  {
   "texto": "já u ní bděl a moc se trudil;"
  },
  {
   "texto": "„Matičko, vstávej, už je jaro,"
  },
  {
   "texto": "pojď mezi nás“ — a já ji zbudil."
  },
  {
   "texto": "Matička promnula si oči,"
  },
  {
   "texto": "a s ní prohlédli v mladém háji,"
  },
  {
   "texto": "pak vstala, rozhlédla se v úsměv,"
  },
  {
   "texto": "a na zemi hned jako v ráji."
  },
  {
   "texto": "A vše se hnulo, pospíchalo,"
  },
  {
   "texto": "tu bylo řeči, doptávání,"
  },
  {
   "texto": "vše bylo čisté tak a hladké,"
  },
  {
   "texto": "jak na slavnost a k uvítání."
  },
  {
   "texto": "Matička chodí, opravuje,"
  },
  {
   "texto": "tu chce mít květ, tu stráň si zdobí,"
  },
  {
   "texto": "tu volá ptáky v list a křoví,"
  },
  {
   "texto": "tu do potůčku písně drobí."
  },
  {
   "texto": "Pak seje modro hor i nebes,"
  },
  {
   "texto": "pak šumnou zeleň do všech dolů,"
  },
  {
   "texto": "pak béře ruku mou a praví:"
  },
  {
   "texto": "„Pojď, hochu, užijme to spolu.“"
  }
 ]
}