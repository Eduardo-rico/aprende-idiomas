{
 "id": "cech-vaclav-z-michalovic-c04",
 "titulo": "Zpěv třetí",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V%C3%A1clav_z_Michalovic/Zp%C4%9Bv_t%C5%99et%C3%AD",
 "fuente": "cs.wikisource.org, «Václav z Michalovic»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (míti, jíti, býti: 3 formas frente a 2 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-vaclav-z-michalovic",
  "titulo": "Václav z Michalovic",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Člunů řada kolébá se hravě"
  },
  {
   "texto": "jako hejno kačic po Vltavě."
  },
  {
   "texto": "Nyní klidně podle sebe plují,"
  },
  {
   "texto": "teď se opozďují, předstihují,"
  },
  {
   "texto": "rozptýleně brázdí vody jas"
  },
  {
   "texto": "a v šik těsný sbírají se zas."
  },
  {
   "texto": "Ale v hemživém těch člunů roji"
  },
  {
   "texto": "noviců se veze klidný sněm,"
  },
  {
   "texto": "bledých lící, v temném řádu kroji"
  },
  {
   "texto": "pod páterů vážným dozorem."
  },
  {
   "texto": "S vody šplíchotem a ševelem"
  },
  {
   "texto": "snoubí se jen tajné šepotání,"
  },
  {
   "texto": "chvílemi pak přes lodice lem"
  },
  {
   "texto": "do vody se ruka lehce sklání."
  },
  {
   "texto": "A tu z proudu, v němž se juná dlaň"
  },
  {
   "texto": "lichotivě probírá a houpá,"
  },
  {
   "texto": "blahý pocit osvěžení vstoupá"
  },
  {
   "texto": "v údy malátné a žhavou skráň."
  },
  {
   "texto": "Pohled tiše vnímá vody vděk,"
  },
  {
   "texto": "jak tu jiskrou nesčíslnou plane,"
  },
  {
   "texto": "ryzím zlatem s dlouhých vesel kane;"
  },
  {
   "texto": "zelený jej těší ostrůvek"
  },
  {
   "texto": "a roj bílých obláčků, jenž plove"
  },
  {
   "texto": "po blankytném nebes klenutí,"
  },
  {
   "texto": "jako v jasné tůni azurové"
  },
  {
   "texto": "rozptýlená pírka labutí."
  },
  {
   "texto": "Blahé city, mocně rozvlněné"
  },
  {
   "texto": "kouzlem těchto zjevů, teplou vesnou,"
  },
  {
   "texto": "povytryskly z hrudi přeplněné"
  },
  {
   "texto": "marianské písně notou plesnou."
  },
  {
   "texto": "A jak by ten zpěvák v duše hloubi"
  },
  {
   "texto": "soudruhům byl vzbudil pravou strunu,"
  },
  {
   "texto": "teď hlas druhý, třetí s ním se snoubí,"
  },
  {
   "texto": "jiný vpadá z vedlejšího člunu"
  },
  {
   "texto": "a již s pozdviženým k nebi zorem"
  },
  {
   "texto": "zajásal tu píseň zástup celý;"
  },
  {
   "texto": "nad vlnami slavným, plesným sborem"
  },
  {
   "texto": "„Salve,“ zaznívá, „regina coeli!“"
  },
  {
   "texto": "V písek břehu zobáky své vryla"
  },
  {
   "texto": "člunů družina, kde tlupa stromů"
  },
  {
   "texto": "tmavé krovy dřímavého domu"
  },
  {
   "texto": "zelení svou jemnou lehce kryla."
  },
  {
   "texto": "Za ním širý, utěšený sad"
  },
  {
   "texto": "vábí v rozložitých větví chlad"
  },
  {
   "texto": "ku záhonů pestré nádheře;"
  },
  {
   "texto": "nejzáze pak vrchu slunná šíje"
  },
  {
   "texto": "hrboly své kamenité kryje"
  },
  {
   "texto": "pod zelené vína kadeře."
  },
  {
   "texto": "Kdysi vládla v rozkošném tom sadě"
  },
  {
   "texto": "Mar’je z Pernštýna, kráska jará,"
  },
  {
   "texto": "rodem byvši Manriquez de Lara."
  },
  {
   "texto": "Což by mohly v šepotavé zradě"
  },
  {
   "texto": "vyprávěti tyto stromy stinné"
  },
  {
   "texto": "o výjevech vábných doby jiné!"
  },
  {
   "texto": "Jak tu často v pěšin jemném písku,"
  },
  {
   "texto": "vinoucích se v trávník sametový"
  },
  {
   "texto": "kol ostrůvků kvetoucího křoví,"
  },
  {
   "texto": "při šelestu hravých vodotrysků,"
  },
  {
   "texto": "při slavičím hlase mandoliny"
  },
  {
   "texto": "k bokům paní, krytých zlatohlavem,"
  },
  {
   "texto": "páni ve španělském kroji tmavém"
  },
  {
   "texto": "tulili se jako k zářím stíny."
  },
  {
   "texto": "Kterak časem za soumraku léta"
  },
  {
   "texto": "tento vodojem, kam žluté listy"
  },
  {
   "texto": "nyní podzimní jen vítr metá,"
  },
  {
   "texto": "vítal druhdy ve svůj křišťál čistý"
  },
  {
   "texto": "jemnou vlnou, toužebně se chvící,"
  },
  {
   "texto": "nožky plaché opojivých vnad,"
  },
  {
   "texto": "váhavě hloub’, hloub’ se sklánějící"
  },
  {
   "texto": "po mramoru stupňů v libý chlad,"
  },
  {
   "texto": "bělejší, než labuť jeho snivá,"
  },
  {
   "texto": "než květ leknínu, jenž po něm splývá."
  },
  {
   "texto": "Jak ten brod se věsil perlou hojnou"
  },
  {
   "texto": "na kadeří světlý, temný vděk,"
  },
  {
   "texto": "vymršťován dlaní nepokojnou"
  },
  {
   "texto": "zápolících v žertu rusalek,"
  },
  {
   "texto": "kterak růže, vonné jejich střely,"
  },
  {
   "texto": "pokryly klín jeho rozechvělý…"
  },
  {
   "texto": "Nyní zbožnost otců dechem vřelým,"
  },
  {
   "texto": "čistým provívá těch sadů krásu,"
  },
  {
   "texto": "kteréž kněžna prstem zkostnatělým"
  },
  {
   "texto": "v dar jim připsala pro duše spásu."
  },
  {
   "texto": "Satyr s flétnou, Amor s lukem svým"
  },
  {
   "texto": "omšeni se kryjí v listů směsi,"
  },
  {
   "texto": "před níž socha světce hlavu věsí,"
  },
  {
   "texto": "líbajíc kříž retem kamenným."
  },
  {
   "texto": "Do skalisek v houští zbožná dlaň"
  },
  {
   "texto": "jeskyni si zasmušilou vryla"
  },
  {
   "texto": "oltářík tam vytesavši, naň"
  },
  {
   "texto": "šklebící se lebku postavila,"
  },
  {
   "texto": "kde teď, klekna do vlhkého mechu,"
  },
  {
   "texto": "v nerušené novic samotě"
  },
  {
   "texto": "rozjímati může v žalném vzdechu"
  },
  {
   "texto": "o pozemských věcí nicotě."
  },
  {
   "texto": "Po těch sadech rozptýlil se nyní"
  },
  {
   "texto": "zástup noviců, by po svém užil"
  },
  {
   "texto": "sporého chvil volných dobrodiní."
  },
  {
   "texto": "Tu se hlouček temných postav sdružil,"
  },
  {
   "texto": "tamo samotář jak stín se hříží"
  },
  {
   "texto": "do pestrého kvítí, v zeleň svíží."
  },
  {
   "texto": "Podél stezek revízové houští"
  },
  {
   "texto": "mnohý nedozrálý hrozníček"
  },
  {
   "texto": "jako růženec již k zemi spouští"
  },
  {
   "texto": "smaragdových drobných perliček."
  },
  {
   "texto": "Každému kol kolem stromu, keři"
  },
  {
   "texto": "plod již mladý ukryt pod kadeří,"
  },
  {
   "texto": "však jej barvou od listnatých skrýší"
  },
  {
   "texto": "pohled zběžný dosud nerozliší."
  },
  {
   "texto": "Růže spanilá již mocí jarou"
  },
  {
   "texto": "z těsných poupátek se dobývá;"
  },
  {
   "texto": "zeleného krovu hojnou spárou"
  },
  {
   "texto": "v milostném se vděku zardívá."
  },
  {
   "texto": "Václav uchýlil se v sadu kout"
  },
  {
   "texto": "nejzazší, kde houští zdivočilé"
  },
  {
   "texto": "z větví směsi, břečtanových pout"
  },
  {
   "texto": "v úkrytu mu splétá loubí milé."
  },
  {
   "texto": "Balvan, pláštěm postlán mechovým,"
  },
  {
   "texto": "s kapradiny jemným krajkovím"
  },
  {
   "texto": "sedadlo mu v šeru stinném skýtá;"
  },
  {
   "texto": "před ním za zbortěnou sadu zdí,"
  },
  {
   "texto": "na níž růžemi se šípek rdí,"
  },
  {
   "texto": "svatovítská věž tam v dáli svítá."
  },
  {
   "texto": "Zde klid vábný. Kdys jen z medných zřídel"
  },
  {
   "texto": "včelka bzučíc v oul se navrací"
  },
  {
   "texto": "a jen motýl z rozestřených křídel"
  },
  {
   "texto": "oko pestré k němu obrací."
  },
  {
   "texto": "Tuto Václav, vzdálen jarých druhů,"
  },
  {
   "texto": "pochmurného otců dohledu,"
  },
  {
   "texto": "v milostného snění čarokruhu"
  },
  {
   "texto": "zpomínky zve v tichou besedu."
  },
  {
   "texto": "K Loretě zas v duchu volně kráčí."
  },
  {
   "texto": "S obou stran tu domů vetchých řad"
  },
  {
   "texto": "do ulice pošmourné se mračí,"
  },
  {
   "texto": "příčních oblouků v ně stele chlad."
  },
  {
   "texto": "Shůry vstříc mu stoupá váhavě"
  },
  {
   "texto": "čtvero sluhů v pyšné úpravě"
  },
  {
   "texto": "s nosítky, jež báječně se třpytí."
  },
  {
   "texto": "V jejich stěnách zlatých dokola"
  },
  {
   "texto": "vykládané mnohobarvé kvítí"
  },
  {
   "texto": "ze skla benátského plápolá."
  },
  {
   "texto": "A roj úbělových amorů"
  },
  {
   "texto": "drobných, zlatokřídlých v jarém spěchu"
  },
  {
   "texto": "po stěnách se hemží nahoru"
  },
  {
   "texto": "na baňatou pozlacenou střechu."
  },
  {
   "texto": "Na temeni jejím oblém pak"
  },
  {
   "texto": "se všech stran ty postavičky něžné"
  },
  {
   "texto": "v hemživý se tlumí bílý mrak,"
  },
  {
   "texto": "z něhož jako z mořské pěny sněžné"
  },
  {
   "texto": "lásky bohyně se vznáší nahá."
  },
  {
   "texto": "Však po lýtkách k bokům opojným"
  },
  {
   "texto": "rozptýlen jí předvoj bůžků sahá,"
  },
  {
   "texto": "tak že hemžením tím výbojným"
  },
  {
   "texto": "částečně jen divný půvab svítá;"
  },
  {
   "texto": "jednotliví smělci dospěli"
  },
  {
   "texto": "až po bílá ňadra nepokrytá,"
  },
  {
   "texto": "ba z nich jeden nejvíc protřelý"
  },
  {
   "texto": "na ramenu oblém s lukem vzpjatým"
  },
  {
   "texto": "do daleka míří šípem zlatým."
  },
  {
   "texto": "Nosítka se zvolna k němu blíží."
  },
  {
   "texto": "Oko jeho v hedbáv růžový"
  },
  {
   "texto": "nitra jejich nesměle se hříží — —"
  },
  {
   "texto": "Kdo směs citů jeho vypoví,"
  },
  {
   "texto": "když z nich oknem, ježto zpola kryje"
  },
  {
   "texto": "lehká záclona, mu vzhledla vstříc"
  },
  {
   "texto": "z nenadání známá dvojí líc:"
  },
  {
   "texto": "Mar’je hrdé, něžné Ignácie?!"
  },
  {
   "texto": "Poznaly ho. Mar’je v úsměvu"
  },
  {
   "texto": "rtoma hnula; vějíř její letem"
  },
  {
   "texto": "pozdravil jej drahokamů vznětem,"
  },
  {
   "texto": "mihnuvších se v lehkém záchvěvu."
  },
  {
   "texto": "Stoudně pochýlila Ignácie"
  },
  {
   "texto": "obličej svůj nachem rozžatý,"
  },
  {
   "texto": "jejžto modrý baret cípatý,"
  },
  {
   "texto": "perlou poset, v záhyby své kryje, —"
  },
  {
   "texto": "něžná hlavinka v té zdobné řáse"
  },
  {
   "texto": "fialince rosné podobá se."
  },
  {
   "texto": "Minuly ho. Za nosítky zíral,"
  },
  {
   "texto": "z jejichž okna vějíř laškovný"
  },
  {
   "texto": "vykloněn se ještě rozestíral, —"
  },
  {
   "texto": "až zjev dole zmizel čarovný."
  },
  {
   "texto": "Ale dále ulicí se bera,"
  },
  {
   "texto": "stále viděl obraz vděků milých,"
  },
  {
   "texto": "kynoucí mu z posupného šera"
  },
  {
   "texto": "oblouků a domů zasmušilých;"
  },
  {
   "texto": "hlavu, klonící se rozpačitě"
  },
  {
   "texto": "pod baretem modrým, v perel kmitě,"
  },
  {
   "texto": "líbeznou tu živou violu"
  },
  {
   "texto": "a tvář její v cudném plápolu…"
  },
  {
   "texto": "Božího pak Těla obřad slavný"
  },
  {
   "texto": "po třetí mu zjevil obraz její."
  },
  {
   "texto": "Řád, ve službě boží neunavný,"
  },
  {
   "texto": "oltář vzácný zřídil před kollejí."
  },
  {
   "texto": "Obestlán jsa drahých látek šatem,"
  },
  {
   "texto": "zaskvívá se celý stříbrem, zlatem."
  },
  {
   "texto": "Sterých květů milokrásným tvarem,"
  },
  {
   "texto": "stobarevnou pýchou záhonů"
  },
  {
   "texto": "příroda tu jarní vonným darem"
  },
  {
   "texto": "tvůrci svému vzdává poklonu."
  },
  {
   "texto": "By pak ještě více mysli davu"
  },
  {
   "texto": "okouzlili, dovršili slávu,"
  },
  {
   "texto": "jinochové z žáků vybraní"
  },
  {
   "texto": "místo andělů se kolem staví."
  },
  {
   "texto": "Za rameny jejich třepetavý"
  },
  {
   "texto": "zlatých křídel pár se uklání,"
  },
  {
   "texto": "pod obroučkem zlatým volně kane"
  },
  {
   "texto": "k šíji hebký kadeřavý vlas,"
  },
  {
   "texto": "splývající roucho zlatotkané"
  },
  {
   "texto": "propouští jen lýtko ze svých řas,"
  },
  {
   "texto": "pod nímž pozlaceným řemením"
  },
  {
   "texto": "připoután je sandál k holením."
  },
  {
   "texto": "Kolem oltáře tak s obou stran"
  },
  {
   "texto": "skupeni jsou krásně, výš a výše,"
  },
  {
   "texto": "každý pak, než obřad dokonán,"
  },
  {
   "texto": "stojí nepohnut a sotva dýše."
  },
  {
   "texto": "Mezi nimi Václav stojí bledý."
  },
  {
   "texto": "Kaditelnic chmurou libovonnou"
  },
  {
   "texto": "vysílá jak bílých mráčků clonou"
  },
  {
   "texto": "z řasy svislé zrak svůj na výzvědy."
  },
  {
   "texto": "Svátosti tu září zlato ryzí"
  },
  {
   "texto": "jako slunce — svící hvězdná pýcha —"
  },
  {
   "texto": "dole s čaroleskem kněžské řízy"
  },
  {
   "texto": "žáčků komže bělostná se míchá."
  },
  {
   "texto": "Kolem pak se valný zástup tlačí"
  },
  {
   "texto": "jak hlav, šatů příboj barvitý;"
  },
  {
   "texto": "v lících obdiv, pobožnost se zračí."
  },
  {
   "texto": "Však též tajný kacíř zarytý"
  },
  {
   "texto": "tu a tam škleb tají límcem pláště,"
  },
  {
   "texto": "nebo blesky málomocné záště"
  },
  {
   "texto": "z pod obočí svislých kradmo metá."
  },
  {
   "texto": "Ba, tam u pozadí zbrojná četa"
  },
  {
   "texto": "celý zástup zjevných husitů"
  },
  {
   "texto": "divých brad a zarputilých tváří"
  },
  {
   "texto": "přihánět sem musí z úkrytů"
  },
  {
   "texto": "halapartnou k nebes blahé záři."
  },
  {
   "texto": "Náhle ve skupině panstva skvělé"
  },
  {
   "texto": "Ignácii spatřil. Panoš lepý"
  },
  {
   "texto": "v klekátko jí rudý polštář stele,"
  },
  {
   "texto": "jehož obruba se zlatem třepí."
  },
  {
   "texto": "Dívka pokleká. Hled její spěje"
  },
  {
   "texto": "na modliteb zlatých bílou blánku"
  },
  {
   "texto": "a rtík zbožným šepotem se chvěje"
  },
  {
   "texto": "jako růžný kvítek v jarním vánku."
  },
  {
   "texto": "Časem zarosený zrak se šine"
  },
  {
   "texto": "z temné, mihotavé brvy k výši —"
  },
  {
   "texto": "pohled zbožný nad ty řasy stinné"
  },
  {
   "texto": "nemůž míti půvabnější skrýši."
  },
  {
   "texto": "K němu nyní zrak ten pozalétl —"
  },
  {
   "texto": "střelhbitě se sklopil, vzhledl zas"
  },
  {
   "texto": "a teď s jeho pohledem se střetl,"
  },
  {
   "texto": "zaplál, zhasl pod obrubou řas."
  },
  {
   "texto": "A když v jeho tvář se znovu zdvihl,"
  },
  {
   "texto": "přes obličej děvin zardělý"
  },
  {
   "texto": "úsměv zvláštní zářivý se mihl;"
  },
  {
   "texto": "však to nebyl záblesk veselí,"
  },
  {
   "texto": "bylo-tě to, jak by mlhu ranní"
  },
  {
   "texto": "rozptýlily jarní slunka jasy"
  },
  {
   "texto": "a kraj ozářily z nenadání,"
  },
  {
   "texto": "plný květů, rosy, blaha, krásy."
  },
  {
   "texto": "Pozachvěl se jinoch v opojení,"
  },
  {
   "texto": "zakývala za ním zlatá křídla —"
  },
  {
   "texto": "Ó, že není pravdou přestrojení,"
  },
  {
   "texto": "by k ní slétl, nad pozemská sídla"
  },
  {
   "texto": "perutí ji vznesl vířivou"
  },
  {
   "texto": "v lásky věčné oblast zářivou!"
  },
  {
   "texto": "Zpomínky tak vlají jeho duší."
  },
  {
   "texto": "Náhlý šustot snění blahé ruší."
  },
  {
   "texto": "Před ním, jak by vzlétla z nitra země,"
  },
  {
   "texto": "jako stvůra snění prchavá,"
  },
  {
   "texto": "rozhrnujíc šípků houští jemně,"
  },
  {
   "texto": "chví se vážná starce postava."
  },
  {
   "texto": "S hlavy jeho sněhobílé vlasy,"
  },
  {
   "texto": "s brady kane vousů zdoba bílá"
  },
  {
   "texto": "na prostého roucha šedé řasy,"
  },
  {
   "texto": "jež ho k samé zemi obestýlá."
  },
  {
   "texto": "Jak dvě hvězdy pod obláčků bělem,"
  },
  {
   "texto": "pod obrvím šedým v jemném třpytě"
  },
  {
   "texto": "oči dlí na mládci uzardělém,"
  },
  {
   "texto": "jenž se z mechu zdvihá rozpačitě."
  },
  {
   "texto": "S nesčíslnou stopou bídy, žele"
  },
  {
   "texto": "kmetova líc vyšla z žití víru;"
  },
  {
   "texto": "však teď jasný klid se po ní stele"
  },
  {
   "texto": "jako předsvit nebeského míru,"
  },
  {
   "texto": "a dech lásky vane každým rysem —"
  },
  {
   "texto": "Zjev to patriarchy svatých písem!"
  },
  {
   "texto": "„Jaká tvoje žádost, děde milý?“"
  },
  {
   "texto": "Ptá se Václav."
  },
  {
   "texto": "Stařec v jeho tahy"
  },
  {
   "texto": "snivý pohled hrouží ještě chvíli;"
  },
  {
   "texto": "jak by z loktů sen ho pouštěl blahý,"
  },
  {
   "texto": "v hlubokém pak vece povzdechu:"
  },
  {
   "texto": "„Odpočinuv za zdí v keřů stínu,"
  },
  {
   "texto": "zahledl jsem listím tebe, synu,"
  },
  {
   "texto": "a tvůj zjev tak sladkou potěchu"
  },
  {
   "texto": "do srdce mi vypráhlého linul,"
  },
  {
   "texto": "že jsem ssutou zdí sem nohu šinul,"
  },
  {
   "texto": "abych z blízka pohled’ ve tvou líc."
  },
  {
   "texto": "Ó, můj hochu drahý, rysy tvoje,"
  },
  {
   "texto": "čím je zkoumám dél, tím budí víc"
  },
  {
   "texto": "v šedé hlavě upomínek roje"
  },
  {
   "texto": "na čas krásný, dávno pominulý,"
  },
  {
   "texto": "krve mořem na vždy uplynulý. —"
  },
  {
   "texto": "Jak se zoveš?“"
  },
  {
   "texto": "„Václav!“"
  },
  {
   "texto": "„Divná shoda!"
  },
  {
   "texto": "Totéž jméno s památkou se pojí,"
  },
  {
   "texto": "jež mne blaží, leč i v srdce bodá."
  },
  {
   "texto": "A kdo, synu, rodičové tvoji?“"
  },
  {
   "texto": "„Nevím. V bouřné za povstáním době"
  },
  {
   "texto": "Tovaryšstvo z loktů chůvy mroucí"
  },
  {
   "texto": "na ulici, opuštěné robě,"
  },
  {
   "texto": "pozdvihlo mne v náruč lásky vroucí.“"
  },
  {
   "texto": "„A moc upomínky z mladých let"
  },
  {
   "texto": "nic — nic nekouzlí ti v duši zpět?“"
  },
  {
   "texto": "„Řád nás učí srdce vytrhnouti"
  },
  {
   "texto": "ze všech svazků lásky rodinné"
  },
  {
   "texto": "a jím celým k církvi matce lnouti,"
  },
  {
   "texto": "k papeži pak otci jediné."
  },
  {
   "texto": "Však tvé líce důvěru mou budí,"
  },
  {
   "texto": "kmete ctihodný. Nuž svěřím tobě,"
  },
  {
   "texto": "co tak často vanulo mou hrudí"
  },
  {
   "texto": "o samotě, v podvečerní době,"
  },
  {
   "texto": "když se navracelo hnědým vzduchem"
  },
  {
   "texto": "ptactvo v rodná hnízda s plesným ruchem,"
  },
  {
   "texto": "jak se duše divně roztoužila,"
  },
  {
   "texto": "v sladkobolné sny se pohroužila,"
  },
  {
   "texto": "jak tu často do schýlených skrání"
  },
  {
   "texto": "plížilo se matné vzpomínání."
  },
  {
   "texto": "Tajemnou zří mlhou duše zor"
  },
  {
   "texto": "nevídaných žírných krajin vnadu,"
  },
  {
   "texto": "spjatých v dálce modrým věncem hor,"
  },
  {
   "texto": "na skalinách štíhlé věže hradů."
  },
  {
   "texto": "Pak se v duchu mém zas míhá sterý"
  },
  {
   "texto": "neznámých zjev lidí v pestrých hávech,"
  },
  {
   "texto": "sokolů, již honcům na rukávech"
  },
  {
   "texto": "třepetají drobných přílbic péry,"
  },
  {
   "texto": "vidím sady, plné květné zdoby,"
  },
  {
   "texto": "schody točité a krásné koby — —"
  },
  {
   "texto": "Leč to všechno z hloubi duše mojí"
  },
  {
   "texto": "v obrysech tak nejistých se rojí,"
  },
  {
   "texto": "že mi nelze soudit s bezpečností,"
  },
  {
   "texto": "odlesk-li to snu či skutečnosti."
  },
  {
   "texto": "Ale časem, starče, se mi zdává,"
  },
  {
   "texto": "že ten závoj minulosti dálné"
  },
  {
   "texto": "trhlinami příze neodhalné"
  },
  {
   "texto": "ve skutečnost nahlédnout mi dává."
  },
  {
   "texto": "Vzdušnou komnatu pak vidím jasně,"
  },
  {
   "texto": "malby na stěnách a trámů řadu,"
  },
  {
   "texto": "mohutný krb učazený v zadu,"
  },
  {
   "texto": "řezby křesla, zlaté jeho třásně."
  },
  {
   "texto": "Mne pak rukou silnou obepíná"
  },
  {
   "texto": "statný muž — můj otec — vážných lící"
  },
  {
   "texto": "a já vzhlédám časem z jeho klína"
  },
  {
   "texto": "na zrak plamenný, ret hlaholící"
  },
  {
   "texto": "zvučným slovem jakés knihy svaté."
  },
  {
   "texto": "Vidím posud mocný její hřbet,"
  },
  {
   "texto": "pazoury lví — spony odepjaté —,"
  },
  {
   "texto": "začátečních písmen pestrý květ."
  },
  {
   "texto": "Jako tehdáž z měkké skrýše, stinné,"
  },
  {
   "texto": "již mi upřádal vous jeho tmavý,"
  },
  {
   "texto": "vidím stranou kolovrátek hravý,"
  },
  {
   "texto": "za nímž paní vlídné zrak mi kyne."
  },
  {
   "texto": "Jemné přádlo chytá v usmívání,"
  },
  {
   "texto": "na kuželi zdobném navité,"
  },
  {
   "texto": "a zář pestrou na přízi tu sklání"
  },
  {
   "texto": "oken špičatých sklo barvité,"
  },
  {
   "texto": "v kolísavém, mnohobarvém pruhu,"
  },
  {
   "texto": "že se zdá mi, jakby předla duhu."
  },
  {
   "texto": "Za ní štíhloboký jinoch kloní"
  },
  {
   "texto": "snivou hlavu, která vlasů tmou"
  },
  {
   "texto": "oči planoucí mu zpola cloní,"
  },
  {
   "texto": "k útlým prsům, jež se mocně dmou."
  },
  {
   "texto": "A zas duch můj kobu jinou vidí,"
  },
  {
   "texto": "nádhernější. Hlomozící tlum"
  },
  {
   "texto": "zamračených, ozbrojených lidí"
  },
  {
   "texto": "otce mého vleče ke schodům."
  },
  {
   "texto": "Matka za ním náruč rozestírá,"
  },
  {
   "texto": "na práh, mdlobou zachvácena, padá;"
  },
  {
   "texto": "on mě vroucně líbá, v náruč svírá,"
  },
  {
   "texto": "ruce s šeptem na hlavu mi vkládá — —“"
  },
  {
   "texto": "Zatím stařec ruku jeho jemně"
  },
  {
   "texto": "ve své tiskl. Náhle před ním klesá"
  },
  {
   "texto": "na kolena, kloní k zemi témě,"
  },
  {
   "texto": "k nebi zří zas, pomateně plesá,"
  },
  {
   "texto": "ruce jeho svírá, ke rtům vine,"
  },
  {
   "texto": "slzou rosí, na srdce své šine,"
  },
  {
   "texto": "vzdychá z hluboka a štká i vzlyká:"
  },
  {
   "texto": "„Svatá krvi — synu mučenníka!“"
  },
  {
   "texto": "Vstává zase, vznáší hledy, ruce:"
  },
  {
   "texto": "„Veleben buď, Pane, v plesném díku,"
  },
  {
   "texto": "že jsi seslal svému služebníku"
  },
  {
   "texto": "blaha zábřesk po tak dlouhé muce,"
  },
  {
   "texto": "že jsi popřál na věčnosti prahu"
  },
  {
   "texto": "ještě jednou mojim očím kalným"
  },
  {
   "texto": "pohlédnouti v kouzlo drahých tahů,"
  },
  {
   "texto": "nesoucích mne k rájům žití dálným!“"
  },
  {
   "texto": "„Ty znáš rod můj, otce, domovinu —?“"
  },
  {
   "texto": "z chvějících se prsou vzkřikl novic."
  },
  {
   "texto": "„„Známo-li ti, pověz, drahý synu,"
  },
  {
   "texto": "jméno Bohuslava z Michalovic?““"
  },
  {
   "texto": "„Buřiče, jenž mečem popravným"
  },
  {
   "texto": "skončil žití, nepravostí plné,"
  },
  {
   "texto": "s věrolomství znakem ohavným,"
  },
  {
   "texto": "jemuž církev naše svatá klne,"
  },
  {
   "texto": "jenž byl Tovaryšstva škůdcem krutým,"
  },
  {
   "texto": "strůjcem svatokrádežného lupu,"
  },
  {
   "texto": "jehož hlava, strašíc okem dutým,"
  },
  {
   "texto": "na věži tam visí pro potupu,"
  },
  {
   "texto": "jehož duše bez lítosti chvění"
  },
  {
   "texto": "do věčného klesla zatracení —?!“"
  },
  {
   "texto": "„„Vznešeného pravdy hrdinu,"
  },
  {
   "texto": "který za víru svou, otčinu,"
  },
  {
   "texto": "napojil svou krví vrahů zlost,"
  },
  {
   "texto": "jehož památku jak drahý skvost"
  },
  {
   "texto": "na tisíce věrných srdcí chrání,"
  },
  {
   "texto": "rozptýlených širou světa plání,"
  },
  {
   "texto": "s jehož hlavy v jiném krasším žití"
  },
  {
   "texto": "koruna se mučennická třpytí"
  },
  {
   "texto": "boží slávy bleskem věčitým — —"
  },
  {
   "texto": "Ten — ten, jinochu, jest otcem tvým!““"
  },
  {
   "texto": "Vzúpěl Václav, v obě dlaně skryl"
  },
  {
   "texto": "zbledlý obličej. Tak drahně chvil"
  },
  {
   "texto": "stoje vzdychal. Ze skrýše svých dlaní"
  },
  {
   "texto": "zdvih’ pak oko v horečnatém vzplání:"
  },
  {
   "texto": "„Snad tě, starče, domnění tvé klame?“"
  },
  {
   "texto": "„„Nikoli! Ty tahy dobře známé, —"
  },
  {
   "texto": "shoda jména, okolností všech —"
  },
  {
   "texto": "zde ta dlouhá jizva na prstech,"
  },
  {
   "texto": "kam tě kdysi v půtce dětské ťal"
  },
  {
   "texto": "mečíkem svým soudruh horkokrevný —"
  },
  {
   "texto": "nevěříš-li ještě, poodhal"
  },
  {
   "texto": "s ramen šat a důkaz viz tu zjevný:"
  },
  {
   "texto": "Zde to divné, malé znamení,"
  },
  {
   "texto": "kalich zjevující, přesně tak,"
  },
  {
   "texto": "jakby Hospodin sám víry znak"
  },
  {
   "texto": "byl ti vtiskl v živém plameni —"
  },
  {
   "texto": "Ty’s to, Václave! Tvé vidím líce,"
  },
  {
   "texto": "podobu tvou vidím přemilenou —"
  },
  {
   "texto": "Ty však Ambrože již neznáš více,"
  },
  {
   "texto": "jenž tě hladil, houpal na kolenou,"
  },
  {
   "texto": "jenž, sám děckem stav se, s tebou hrával,"
  },
  {
   "texto": "z kůry lodice ti vyřezával,"
  },
  {
   "texto": "v káď je kladl, do plachet jim dýchal,"
  },
  {
   "texto": "jehož pohádky tak rád jsi slýchal — —?““"
  },
  {
   "texto": "Takto mluvě náruč rozestíral"
  },
  {
   "texto": "k jinochovi kmet. Leč Václav ještě"
  },
  {
   "texto": "v odhalené rámě zděšen zíral,"
  },
  {
   "texto": "kde jak krůpěj krvavého deště"
  },
  {
   "texto": "nad bělostné růže květným listem"
  },
  {
   "texto": "drobný kalich rděl se v bělu čistém."
  },
  {
   "texto": "Přeslechnuv, co v posled stařec děl,"
  },
  {
   "texto": "dvojici pak zdvihl očí tmavou"
  },
  {
   "texto": "a ret jeho v otázce se chvěl:"
  },
  {
   "texto": "„A kdo’s ty, jenž tou mne děsíš zprávou?“"
  },
  {
   "texto": "„„Já kdo jsem? Jsem harfa Israele"
  },
  {
   "texto": "v babylónských vrbách zavěšená,"
  },
  {
   "texto": "němá, mrtvá; jenom k jeku žele"
  },
  {
   "texto": "zlobným vichrem časem vyděšená."
  },
  {
   "texto": "Stín jsem člověka, jenž dávno k Bohu"
  },
  {
   "texto": "duši vrátil z labyrintu světa"
  },
  {
   "texto": "a jak přízrak bludnou šine nohu"
  },
  {
   "texto": "po trosce, jež vlastí rozeseta."
  },
  {
   "texto": "A květ marný pozemského štěstí,"
  },
  {
   "texto": "dávno zvadlý, vzpomínka jen pěstí."
  },
  {
   "texto": "Ducha zrakem vídám častokrát"
  },
  {
   "texto": "na jezera modrojasném ladu"
  },
  {
   "texto": "štíhlých věží bílým stínem hrát"
  },
  {
   "texto": "obraz luzný Rvenického hradu."
  },
  {
   "texto": "Tam tvůj otec žil, ráj kolem tvořil:"
  },
  {
   "texto": "klasů zlatem pyšníval se lán"
  },
  {
   "texto": "a strom do nich větve husté nořil"
  },
  {
   "texto": "ovocem jsa hojným obtěžkán,"
  },
  {
   "texto": "chmel se bujně kolem tyčí vinul"
  },
  {
   "texto": "a kmen révy plným hroznem kynul."
  },
  {
   "texto": "Tamo šťasten, spokojen jsem žil"
  },
  {
   "texto": "otce tvého sluhou jsa — víc druhem."
  },
  {
   "texto": "On ves dozor nad hradem a luhem"
  },
  {
   "texto": "horlivé mé péči uložil"
  },
  {
   "texto": "a mne rozmanitý úkol ten"
  },
  {
   "texto": "více těchou plníval, než trudil."
  },
  {
   "texto": "Sotva zabělal se v polích den,"
  },
  {
   "texto": "opouštěl jsem lože, čeleď budil,"
  },
  {
   "texto": "chlévy ohlédl, kde řadou stál"
  },
  {
   "texto": "zástup krásných volků, čistých plemen,"
  },
  {
   "texto": "těšil se, když kravkám pestrým z vemen"
  },
  {
   "texto": "mléka hojný zdroj se prýštíval,"
  },
  {
   "texto": "a pak za blýskavých pluhů řadou"
  },
  {
   "texto": "vycházel jsem v pole. Ves ten ruch"
  },
  {
   "texto": "hospodářství svou mne jímal vnadou:"
  },
  {
   "texto": "těšilo mne, když se hloubný pluh"
  },
  {
   "texto": "skvoucím rádlem v kyprou zemi bořil,"
  },
  {
   "texto": "když se prvním oseníčkem lán"
  },
  {
   "texto": "zeleným jak lehkým kmentem šňořil,"
  },
  {
   "texto": "když klas hojný, chrpou promíchán,"
  },
  {
   "texto": "vynášel se z půdy, žloutnul, sílil,"
  },
  {
   "texto": "šeptal tichou, blahoplodnou zvěst,"
  },
  {
   "texto": "zrnek tíží hlavinku svou chýlil,"
  },
  {
   "texto": "jakby vzdával pěstiteli čest."
  },
  {
   "texto": "Těšilo mne, když se v růžný květ"
  },
  {
   "texto": "jabloň sadu skvostně odívala,"
  },
  {
   "texto": "a pak, zevšad opřena jak děd,"
  },
  {
   "texto": "plodem zardělým se usmívala."
  },
  {
   "texto": "Těšilo mne, když ryb loďka plná"
  },
  {
   "texto": "blýskala se stříbrem sítě oky,"
  },
  {
   "texto": "neb když pod nůžkami jehňat vlna"
  },
  {
   "texto": "k zemi padala, jak sněhu vloky."
  },
  {
   "texto": "Těšilo mne též, kdy pilné včely"
  },
  {
   "texto": "v malovaný oul svůj sladký plen"
  },
  {
   "texto": "z libovonných květů přinášely"
  },
  {
   "texto": "a když pozděj z oulu vykrojen"
  },
  {
   "texto": "v míse usmíval se zlatý med"
  },
  {
   "texto": "chuti božské, rozkoš na pohled."
  },
  {
   "texto": "Jaký ples hrál o dožinkách nivou,"
  },
  {
   "texto": "když tam v choti sličné průvodu"
  },
  {
   "texto": "otec tvůj šel s lící přívětivou"
  },
  {
   "texto": "pohledět na zlatou úrodu;"
  },
  {
   "texto": "když je jali do slaměných pout"
  },
  {
   "texto": "a máť tvoje do rusého vlasu"
  },
  {
   "texto": "s úsměvem si dala zavinout"
  },
  {
   "texto": "věnec chrpy, koukole a klasů!"
  },
  {
   "texto": "Nebylť otec tvůj z těch zpupných pánů,"
  },
  {
   "texto": "kteří mučí tvrdým jařmem šíje"
  },
  {
   "texto": "lidu chudého, jenž pro ně v lánu"
  },
  {
   "texto": "potu ručeje do brázdy lije."
  },
  {
   "texto": "Nekalil jim radost v temné pýše."
  },
  {
   "texto": "Na dožinkách jeho rok co rok"
  },
  {
   "texto": "z ohromných dvou sudů proudil v číše"
  },
  {
   "texto": "chmeloviny, vína jarý tok."
  },
  {
   "texto": "Ba sám k rozhovoru srdečnému"
  },
  {
   "texto": "k mužům přisedal pán laskavý;"
  },
  {
   "texto": "za to s láskou vzhlížejíce k němu"
  },
  {
   "texto": "ze srdce mu pili na zdraví."
  },
  {
   "texto": "K tanci zvaly pod věnečkem chrpy"
  },
  {
   "texto": "žneček švarných oči rozžaté"
  },
  {
   "texto": "kolem lípy, jíž své lesklé srpy"
  },
  {
   "texto": "zavěsily v loubí košaté;"
  },
  {
   "texto": "pod ní seděl dudák šedých vlasů,"
  },
  {
   "texto": "paží přitiskaje zvučný měch"
  },
  {
   "texto": "s hlavou kozlí, s nížto za okrasu"
  },
  {
   "texto": "stuhy vlály v barvách duhy všech."
  },
  {
   "texto": "Tak lán šuměl plesem neztenčeným,"
  },
  {
   "texto": "až pak večer ženci nezbední"
  },
  {
   "texto": "pod vztyčeným snopem, ověnčeným"
  },
  {
   "texto": "usadili na vůz poslední"
  },
  {
   "texto": "dudáka, jenž s rudou vínem lící"
  },
  {
   "texto": "hlavou klesal na kvičící měch"
  },
  {
   "texto": "a kol vozu zástup hlaholící"
  },
  {
   "texto": "srpy zvoně lesklých na pasech,"
  },
  {
   "texto": "v tanci, výskotu a hovoru"
  },
  {
   "texto": "navracel se šerem ke dvoru."
  },
  {
   "texto": "Když stín večera se v pole klad’,"
  },
  {
   "texto": "ve svůj příbytek jsem spěchal rád."
  },
  {
   "texto": "K zubaté zdi hradní přichýlen"
  },
  {
   "texto": "v koutě nádvoří můj domek milý"
  },
  {
   "texto": "usmíval se, čistě obílen;"
  },
  {
   "texto": "před ním ruce moje vykouzlily"
  },
  {
   "texto": "z půdy skalní trpasličí sad"
  },
  {
   "texto": "pestrých květů na vysokém stonku;"
  },
  {
   "texto": "a keř vinný, v lávku roně chlad,"
  },
  {
   "texto": "okno zpola halil do úponků."
  },
  {
   "texto": "Uvnitř pod pečlivou žínky dlaní"
  },
  {
   "texto": "čistotou se třpytil každý kout —"
  },
  {
   "texto": "po laskavém jejím uvítání"
  },
  {
   "texto": "jak tu milo bylo zasednout"
  },
  {
   "texto": "nad večeři chutnou za stůl prostý,"
  },
  {
   "texto": "před lipovým vína pohárem"
  },
  {
   "texto": "se stálými vítanými hosty:"
  },
  {
   "texto": "s jasnou myslí, dobrým rozmarem!"
  },
  {
   "texto": "Kterak záříval zrak dobré ženy,"
  },
  {
   "texto": "když jsem milené své knihy sňal"
  },
  {
   "texto": "z výklenku, kde byly uzamčeny,"
  },
  {
   "texto": "a jí z bible příběh předčítal,"
  },
  {
   "texto": "bratra Chelčického slova zlatá,"
  },
  {
   "texto": "kroniky o dávných slavných bojích —"
  },
  {
   "texto": "a když tvář se zdvihla knihou vzňatá,"
  },
  {
   "texto": "stejný zápal čet’ jsem v očích jejích…"
  },
  {
   "texto": "Leč tu bolestně se dotknul mne"
  },
  {
   "texto": "Hospodinův prst. Má drahá žena"
  },
  {
   "texto": "ku věčnému spánku položena"
  },
  {
   "texto": "v chladné země lůno tajemné."
  },
  {
   "texto": "Zdálo se mi, že ves půvab smavý,"
  },
  {
   "texto": "jímž mne těšila dřív tato zem,"
  },
  {
   "texto": "s lesů, sadů, zlatých klasů, trávy"
  },
  {
   "texto": "ulét’ na vždy s jejím úsměvem."
  },
  {
   "texto": "A když zpět mi bylo večer jíti"
  },
  {
   "texto": "v domek prázdný, před nímž svadlo kvítí,"
  },
  {
   "texto": "na němž usychal již vinný kmen,"
  },
  {
   "texto": "v jizbičce tu prázdné jako v hrobě"
  },
  {
   "texto": "na stůl čelo klad’ jsem v těžké mdlobě,"
  },
  {
   "texto": "vzdychal, úpěl, bolem přemožen."
  },
  {
   "texto": "A tu v strastiplné srdce moje"
  },
  {
   "texto": "jediná se těcha řinula"
  },
  {
   "texto": "z písem zbožných posvátného zdroje:"
  },
  {
   "texto": "blíže, blíž se duše vinula"
  },
  {
   "texto": "ku knihám těm, nad nimiž mne časem"
  },
  {
   "texto": "zábřesk jitra pozdravil svým jasem."
  },
  {
   "texto": "Když se snivá hvězda večerní"
  },
  {
   "texto": "zakmitla nad vlnou jezerní,"
  },
  {
   "texto": "tu jsem časem sedal v rozjímání"
  },
  {
   "texto": "na zdi hradu, hledě v širý kraj."
  },
  {
   "texto": "Zvolna po horách a borech, pláni"
  },
  {
   "texto": "prostíral se noci divný taj:"
  },
  {
   "texto": "dvorce, chaty unikaly zraku,"
  },
  {
   "texto": "stromů obrys mizel v temném mraku,"
  },
  {
   "texto": "až kraj celý podobal se jen"
  },
  {
   "texto": "smutečnímu šatu obrovskému,"
  },
  {
   "texto": "jenž nad mrtvou zemí rozestřen"
  },
  {
   "texto": "cípy hor se vlní k nebes lemu."
  },
  {
   "texto": "Zmíralo blíž koles, podkov znění,"
  },
  {
   "texto": "v dáli zvonů tklivé hlaholení"
  },
  {
   "texto": "a vše kolem objal čirý klid."
  },
  {
   "texto": "Tu jsem k sobě hovoříval v duchu:"
  },
  {
   "texto": "Tak zem jednou navždy zmizí sluchu,"
  },
  {
   "texto": "tak ji navždy pohřeší tvůj vid."
  },
  {
   "texto": "Všechna její rozmanitá tvárnost,"
  },
  {
   "texto": "ves ten zvuk je pouhý sen a dým,"
  },
  {
   "texto": "vše to lidské hemžení je marnost,"
  },
  {
   "texto": "trudný hon za cílem přeludným."
  },
  {
   "texto": "Odvrať oči od těch lichých cet,"
  },
  {
   "texto": "zamkni světa blábolení sluch,"
  },
  {
   "texto": "v nitro své jen ponoř sluch a hled,"
  },
  {
   "texto": "kde ti sídlí nesmrtelný duch."
  },
  {
   "texto": "Tam-li nenajdeš, proč hodno býti, —"
  },
  {
   "texto": "marno po tom celým světem zříti."
  },
  {
   "texto": "A tak obrátil jsem v sebe vid;"
  },
  {
   "texto": "leč tam pustá prázdnota se tměla,"
  },
  {
   "texto": "až tu náhlý pronikl ji svit,"
  },
  {
   "texto": "jako jiskra nadpozemsky skvělá,"
  },
  {
   "texto": "jako hvězda nad jitřenku krasší,"
  },
  {
   "texto": "a já vnímal, jak se šíř a výš"
  },
  {
   "texto": "rozněcuje, všechny stíny plaší,"
  },
  {
   "texto": "vniká v nejtajnější duše skrýš,"
  },
  {
   "texto": "jak ji celou plní slunným třpytem,"
  },
  {
   "texto": "teplem lahodným a blaha citem,"
  },
  {
   "texto": "jak i zrak mi nítí, plane s tváře"
  },
  {
   "texto": "boží milosti ta svatá záře."
  },
  {
   "texto": "Tak jsem k domácímu kráčel prahu,"
  },
  {
   "texto": "a když tělo ukládal jsem k spaní,"
  },
  {
   "texto": "zdálo se mé duši v tichém blahu,"
  },
  {
   "texto": "jak bych v boží odpočíval dlani."
  },
  {
   "texto": "V tuto dobu tichou Rvenici"
  },
  {
   "texto": "opustil jsem s otcem tvým. Jej zvaly"
  },
  {
   "texto": "víra, vlast za tiché hradu valy"
  },
  {
   "texto": "v život bouřlivě se měnící."
  },
  {
   "texto": "Oné dvojici on v pomoc nesl"
  },
  {
   "texto": "pádné rámě, věhlas bystré hlavy —"
  },
  {
   "texto": "národ pak jej brzy povynesl"
  },
  {
   "texto": "na vrch důstojenství, moci, slávy."
  },
  {
   "texto": "A jak mladý strom, jenž u kořenů"
  },
  {
   "texto": "staršího se ujav, štíhlý vděk"
  },
  {
   "texto": "jarou mízou rašícího kmenu"
  },
  {
   "texto": "k němu vine, krásný vrcholek"
  },
  {
   "texto": "svěže zelený pne vzhůru směle,"
  },
  {
   "texto": "jakby převýšiti hodlal záhy"
  },
  {
   "texto": "omšeného svého zploditele:"
  },
  {
   "texto": "tak mu po boku, pln velké snahy,"
  },
  {
   "texto": "starší bratr tvůj, náš jarý Smil,"
  },
  {
   "texto": "s otcem svým již málem zápolil."
  },
  {
   "texto": "Pak jsi přibyl ty, květ opozdilý,"
  },
  {
   "texto": "kdy již sprchla první vločka sněhu"
  },
  {
   "texto": "v kadeř otcovu — Ach, june milý,"
  },
  {
   "texto": "jak ti líčit všechnu radost, něhu,"
  },
  {
   "texto": "s jakou ve tvou kolébku se díval,"
  },
  {
   "texto": "všechnu péči, skvělé naděje,"
  },
  {
   "texto": "hrdé sny, jež nad tvým čílkem sníval"
  },
  {
   "texto": "o slávě, v níž kdys se zaskvěje!"
  },
  {
   "texto": "Kdyby viděl, jak ti supi draví,"
  },
  {
   "texto": "k nimžto planul plným hněvu žárem,"
  },
  {
   "texto": "jeho holoubka svým drží spárem,"
  },
  {
   "texto": "v peří svého mrak jej šatí tmavý — —!"
  },
  {
   "texto": "Ó, tvůj otec Husita byl pravý,"
  },
  {
   "texto": "plný zanícení pro vlast, víru,"
  },
  {
   "texto": "jejich škůdců bijce nedočkavý —"
  },
  {
   "texto": "skvoucí perla českých bohatýrů!"
  },
  {
   "texto": "A tu hlavu krásnou s čelem smělým,"
  },
  {
   "texto": "na němž trůnil věhlas, mužný vzdor,"
  },
  {
   "texto": "musil spatřit mečem zkrvavělým"
  },
  {
   "texto": "katu k nohám sraženu můj zor!"
  },
  {
   "texto": "Ha, ten den — to jitro, plné děsu —!"
  },
  {
   "texto": "Ó, že moh’ zrak nebe zářivý"
  },
  {
   "texto": "tehdáž vynořit se z klína lesů"
  },
  {
   "texto": "popatřit na zločin strašlivý,"
  },
  {
   "texto": "spáchaný v čest bohu rouhavě,"
  },
  {
   "texto": "nad nímž čas náš němou hrůzou trne"
  },
  {
   "texto": "a jenž původům svým na hlavě"
  },
  {
   "texto": "věčnou kletbu příštích věků shrne!"
  },
  {
   "texto": "Strašné divadlo! Jak děsný sen"
  },
  {
   "texto": "v paměť vrací se, hruď žalem plní:"
  },
  {
   "texto": "Stojím, jezerem hlav obklopen,"
  },
  {
   "texto": "jež se šumně po náměstí vlní,"
  },
  {
   "texto": "z každé ulice proud vtéká nový,"
  },
  {
   "texto": "plna hlav jsou domů okna, krovy."
  },
  {
   "texto": "V jitřním šeru, velebný jak stín,"
  },
  {
   "texto": "chmurně shlíží z bledých nebes lemu"
  },
  {
   "texto": "dvojicí svých věží slavný Týn:"
  },
  {
   "texto": "jaké divadlo — žel! — chystá jemu"
  },
  {
   "texto": "věrná družka, radnice ta šerá,"
  },
  {
   "texto": "s níž ach! vídal s výše podnebeské"
  },
  {
   "texto": "velkých dějů pásma tolikerá,"
  },
  {
   "texto": "tolik pýchy, jasné slávy české!"
  },
  {
   "texto": "Nyní před ní cizích žoldáků"
  },
  {
   "texto": "divé davy posupně se tlačí"
  },
  {
   "texto": "k lešení, jež v temném povlaku"
  },
  {
   "texto": "katafalk jak ohromný se mračí."
  },
  {
   "texto": "S lavic povýšených soudci řadou"
  },
  {
   "texto": "— navždy souzení svým soudem křivým —"
  },
  {
   "texto": "zpupná čela chmuří za ohradou."
  },
  {
   "texto": "Mniši různobarví s okem lstivým,"
  },
  {
   "texto": "s leskem vítězným na kruté líci,"
  },
  {
   "texto": "krouží kol jak supi čekající"
  },
  {
   "texto": "na kvas hrozný. Po straně kat mračný"
  },
  {
   "texto": "opírá se o meč krvelačný."
  },
  {
   "texto": "Pacholci již stelou sukno rudé —"
  },
  {
   "texto": "Slyš! teď velikého děla hřmění"
  },
  {
   "texto": "úvod k děsné tragedii bude."
  },
  {
   "texto": "Z radnice již stoupá na lešení"
  },
  {
   "texto": "vážný Šlik. Dech zatajil se mžikem"
  },
  {
   "texto": "v prsou všech. A když tak stoupal k předu"
  },
  {
   "texto": "a tvář bledou zasmušilých hledů"
  },
  {
   "texto": "jitřní zlíbal svit, tu pláčem, vzlykem"
  },
  {
   "texto": "dav se ozval ve prostranství širém;"
  },
  {
   "texto": "však hned vpadly bubny vzteklým vírem"
  },
  {
   "texto": "a trub divý vřesk. I spatřil jsem"
  },
  {
   "texto": "toliko, jak kolenem se níží"
  },
  {
   "texto": "v sukno rudé, k nebi s šeptem vzhlíží, —"
  },
  {
   "texto": "jak meč blýská — z šíje, ruky stříká"
  },
  {
   "texto": "prvního krev pravdy mučenníka."
  },
  {
   "texto": "Budovec pak vyšel s hlavou šedou,"
  },
  {
   "texto": "stříbrnou si hladě bradu dlouhou,"
  },
  {
   "texto": "jeho zrak se skvěl, jak nedočkavou"
  },
  {
   "texto": "po koruně mučennické touhou."
  },
  {
   "texto": "Za ním v meče běsném blýskotání"
  },
  {
   "texto": "Harant statný, Kaplíř věkem schřadlý,"
  },
  {
   "texto": "Dvořecký a z Bílé, z Losu páni,"
  },
  {
   "texto": "Černín, Konecchlumský řadou padli."
  },
  {
   "texto": "Zatím zarděly se jitrem vzňaté"
  },
  {
   "texto": "domů štíty, mocné věže Týnu,"
  },
  {
   "texto": "jak by odleskem té krve svaté, —"
  },
  {
   "texto": "jak by studem, že tu v jejich stínu"
  },
  {
   "texto": "v srdci země, slávou vždy se skvoucím,"
  },
  {
   "texto": "všechny její nejvzácnější květy"
  },
  {
   "texto": "zpupný vrah můž’ kosit bez odvety, —"
  },
  {
   "texto": "jakby ve plamenu zloby žhoucím."
  },
  {
   "texto": "Teď tvůj otec vyšel v popravu"
  },
  {
   "texto": "z radnice. — Ne, nešel; jarým skokem"
  },
  {
   "texto": "po stupních se snesl, s jasným okem,"
  },
  {
   "texto": "jak by spěchal v milou zábavu;"
  },
  {
   "texto": "výše hrdou vzpřímiv postavu,"
  },
  {
   "texto": "soudce přelet’ hledem pohrdlivým."
  },
  {
   "texto": "Rachotily bubny vírem divým,"
