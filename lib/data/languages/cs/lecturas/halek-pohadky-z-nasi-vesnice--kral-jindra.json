 "modo": "texto",
 "parrafos": [
  {
   "texto": "Král Jindra"
  },
  {
   "texto": "Král Jindra ztratil korunu"
  },
  {
   "texto": "a zavolal si blázna:"
  },
  {
   "texto": "„Pojď, šašku, musím se trůnu,"
  },
  {
   "texto": "má hlava je tak prázdna.“"
  },
  {
   "texto": "Vzal šašek housle do ruky,"
  },
  {
   "texto": "měl v nich tak divné noty —"
  },
  {
   "texto": "„Když chceš jim vládnout bez muky,"
  },
  {
   "texto": "pojď ke mně do roboty.“"
  },
  {
   "texto": "A tu, jak dříve s bláznem král,"
  },
  {
   "texto": "teď s králem chodí blázen,"
  },
  {
   "texto": "a kde si sed’ a k houslím hrál,"
  },
  {
   "texto": "byl Jindra trudu prázen."
  },
  {
   "texto": "A usedli si v hospodě,"
  },
  {
   "texto": "tam zpívali až k ránu:"
  },
  {
   "texto": "že lidé žijou ve shodě,"
  },
  {
   "texto": "když mají víno v džbánu."
  },
  {
   "texto": "A usedli si na trhu,"
  },
  {
   "texto": "tam zpívali až k šeři:"
  },
  {
   "texto": "jak trudno dívkám v noclehu,"
  },
  {
   "texto": "když hoch se zpronevěří."
  },
  {
   "texto": "A usedli si pod hradem,"
  },
  {
   "texto": "král zpívá tam až k noci:"
  },
  {
   "texto": "jak nádherný z hvězd diadem"
  },
  {
   "texto": "noc královna má v moci."
  },
  {
   "texto": "Tu paní k oknům přisedly,"
  },
  {
   "texto": "zpěv k srdci jim se loudí:"
  },
  {
   "texto": "„Já jsem ten měsíc vybledlý,"
  },
  {
   "texto": "když pustou nocí bloudí!“"
  },
  {
   "texto": "Pak sedli už jen na mechu,"
  },
  {
   "texto": "král zaplakal si v dlaně,"
  },
  {
   "texto": "a blázen pravil v útěchu:"
  },
  {
   "texto": "„Tak poslouchají maně.“"
  },
  {
   "texto": "Namíchal paní pro spaní —"
  },
  {
   "texto": "„Tys, švakrová, jak z růže květ!“"
  },
  {
   "texto": "V tom mrtvá víčka odclání —"
  },
  {
   "texto": "„Co chceš tu ještě uvidět?“"
  },
  {
   "texto": "A skokem k lůžku přikvačil"
  },
  {
   "texto": "a palcem víčka zatlačil."
  },
  {
   "texto": "Hned líbal ňadra okrouhlá,"
  },
  {
   "texto": "šíj bílou, z růže tkaný ret,"
  },
  {
   "texto": "zas mrtvá z lůžka prokoukla —"
  },
  {
   "texto": "„Co chceš tu ještě uvidět?“"
  },
  {
   "texto": "A skokem mrtvou uchopil"
  },
  {
   "texto": "a v rakvi víkem poklopil."
  },
  {
   "texto": "Když byla v hrobě pohřbena —"
  },
  {
   "texto": "„Teďs, švakrová, můj celý svět!“"
  },
  {
   "texto": "A v měkká klad’ se ramena,"
  },
  {
   "texto": "jak do hedbáví, na samet;"
  },
  {
   "texto": "až v půlnoc hlavu pozvedne:"
  },
  {
   "texto": "„Co chceš, ty mrtvá, vedle mne?“"
  },
  {
   "texto": "A mrtvá tak, jak o ní snil:"
  },
  {
   "texto": "„Bez tebe nechci v hrobě spát,"
  },
  {
   "texto": "tys špatně oči zaklížil,"
  },
  {
   "texto": "já kdy chci mohu k tobě vstát,"
  },
  {
   "texto": "a já chci sestru uvidět,"
  },
  {
   "texto": "jak od tebe jí sladne svět.“"
  },
  {
   "texto": "A mrtvá kouká v duše skryt."
  },
  {
   "texto": "ba v nejtajnější srdce kout,"
  },
  {
   "texto": "chce manžel z lože vyskočit,"
  },
  {
   "texto": "však nemůže ni rukou hnout,"
  },
  {
   "texto": "jen mrtvé hledí pod rubáš:"
  },
  {
   "texto": "„Ach, ty mně duši vykoukáš!“"
  },
  {
   "texto": "A z mrtvé bílý plane svit,"
  },
  {
   "texto": "má ruku zvednutou jak v soud,"
  },
  {
   "texto": "chce manžel sestru probudit,"
  },
  {
   "texto": "a nemůže ni hlasem hnout,"
  },
  {
   "texto": "jen mrtvé hledí pod rubáš:"
  },
  {
   "texto": "„Ach, ty mne k hrobu vykoukáš!“"
  },
  {
   "texto": "Když bylo ještě s půlnoci,"
  },
  {
   "texto": "vylítla sestra ze spaní:"
  },
  {
   "texto": "„Ach, spějte, lidé, k pomoci,"
  },
  {
   "texto": "mně pán můj stydne ve dlani!“"
  },
  {
   "texto": "Však pomoc marná dočista,"
  },
  {
   "texto": "kdo dobděl, vstát se nechystá."
  }
 ]
}