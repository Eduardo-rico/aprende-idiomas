 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Klesla hvězda s nebes výše,"
  },
  {
   "texto": "mrtvá hvězda sinný svit;"
  },
  {
   "texto": "padá v neskončené říše"
  },
  {
   "texto": "padá věčně v věčný byt."
  },
  {
   "texto": "Její pláč zní z hrobu všeho,"
  },
  {
   "texto": "strašný jekot, hrůzný kvíl."
  },
  {
   "texto": "„Kdy dopadne konce svého?“"
  },
  {
   "texto": "Nikdy — nikde — žádný cíl."
  },
  {
   "texto": "Kol bílé věže větry hrají,"
  },
  {
   "texto": "při níž si vlnky šepotají."
  },
  {
   "texto": "Na bílé zdě stříbrnou zář"
  },
  {
   "texto": "rozlila bledá lůny tvář;"
  },
  {
   "texto": "však hluboko u věži je temno pouhé;"
  },
  {
   "texto": "neb jasna měsíce světlá moc"
  },
  {
   "texto": "uzounkým oknem u sklepení dlouhé"
  },
  {
   "texto": "proletši se změní v pološerou noc."
  },
  {
   "texto": "Sloup sloupu kolem rameno si podává"
  },
  {
   "texto": "temnotou noční. Z venku větru vání"
  },
  {
   "texto": "přelétá zvražděných vězňů co lkání,"
  },
  {
   "texto": "vlasami vězně pohrává."
  },
  {
   "texto": "Ten na kamenný složen stůl"
  },
  {
   "texto": "hlavu o ruce opírá;"
  },
  {
   "texto": "polou sedě a kleče půl"
  },
  {
   "texto": "v hloub myšlenek se zabírá."
  },
  {
   "texto": "Po měsíce tváři jak mračna jdou,"
  },
  {
   "texto": "zahalil vězeň v ně duši svou;"
  },
  {
   "texto": "myšlenka myšlenkou umírá."
  },
  {
   "texto": "„Hluboká noc! ty rouškou svou"
  },
  {
   "texto": "teď přikrýváš dědinu mou,"
  },
  {
   "texto": "a ona truchlí pro mě! —"
  },
  {
   "texto": "Že truchlí? — pro mě? pouhý sen!"
  },
  {
   "texto": "Ta dávno neví o mně."
  },
  {
   "texto": "Sotvaže zítra jasný den"
  },
  {
   "texto": "nad její lesy vstane,"
  },
  {
   "texto": "já hanebně jsem odpraven,"
  },
  {
   "texto": "a ona — jak v můj první den —"
  },
  {
   "texto": "vesele, jasně vzplane.“"
  },
  {
   "texto": "Umlknul; po sklepení jen,"
  },
  {
   "texto": "jenž nad sloupy se zdvíhá,"
  },
  {
   "texto": "dál, dál se hlas rozlíhá;"
  },
  {
   "texto": "až — jakby hrůzou přimrazen —"
  },
  {
   "texto": "na konci síně dlouhé"
  },
  {
   "texto": "usne v temnotě pouhé."
  },
  {
   "texto": "Hluboké ticho té temnosti"
  },
  {
   "texto": "zpět vábí časy pominulé,"
  },
  {
   "texto": "a vězeň ve svých snách dny mladosti"
  },
  {
   "texto": "zas žije dávno uplynulé."
  },
  {
   "texto": "To vzpomnění mladistvých let"
  },
  {
   "texto": "mladistvé sny vábilo zpět;"
  },
  {
   "texto": "a vězně oko slzy lilo,"
  },
  {
   "texto": "srdce se v citech potopilo; —"
  },
  {
   "texto": "marná to touha v zašlý svět."
  },
  {
   "texto": "Kde za jezerem hora horu"
  },
  {
   "texto": "v západní stíhá kraje,"
  },
  {
   "texto": "tam — zdá se mu — si v temném boru"
  },
  {
   "texto": "posledně dnes co dítko hraje."
  },
  {
   "texto": "Od svého otce v svět vyhnán,"
  },
  {
   "texto": "v loupežnickém tam roste sboru."
  },
  {
   "texto": "Později vůdcem spolku zván,"
  },
  {
   "texto": "dovede činy neslýchané,"
  },
  {
   "texto": "všude jest jméno jeho znané,"
  },
  {
   "texto": "každémuť: „Strašný lesů pán!“"
  },
  {
   "texto": "Až poslez láska k růži svadlé"
  },
  {
   "texto": "nejvejš roznítí pomstu jeho,"
  },
  {
   "texto": "a poznav svůdce dívky padlé"
  },
  {
   "texto": "zavraždí otce neznaného."
  },
  {
   "texto": "Protož jest u vězení dán;"
  },
  {
   "texto": "a kolem má být odpraven"
  },
  {
   "texto": "již zítra strašný lesů pán,"
  },
  {
   "texto": "jak první z hor vyvstane den."
  },
  {
   "texto": "Teď na kamenný složen stůl"
  },
  {
   "texto": "hlavu o ruce opírá,"
  },
  {
   "texto": "polou sedě a kleče půl"
  },
  {
   "texto": "v hloub myšlenek se zabírá;"
  },
  {
   "texto": "po měsíce tváři jak mračna jdou,"
  },
  {
   "texto": "zahalil vězeň v ně duši svou,"
  },
  {
   "texto": "myšlenka myšlenkou umírá."
  },
  {
   "texto": "„Sok — otec můj! Vrah — jeho syn,"
  },
  {
   "texto": "on svůdce dívky mojí! —"
  },
  {
   "texto": "Neznámý mně. — Strašný můj čin"
  },
  {
   "texto": "pronesl pomstu dvojí."
  },
  {
   "texto": "Proč rukou jeho vyvržen"
  },
  {
   "texto": "stal jsem se hrůzou lesů?"
  },
  {
   "texto": "Čí vinu příští pomstí den?"
  },
  {
   "texto": "Čí vinou kletbu nesu?"
  },
  {
   "texto": "Ne vinou svou! — V života sen"
  },
  {
   "texto": "byl jsem já snad jen vyváben,"
  },
  {
   "texto": "bych ztrestal jeho vinu?"
  },
  {
   "texto": "A jestliže jsem vůli svou"
  },
  {
   "texto": "nejednal tak, proč smrtí zlou"
  },
  {
   "texto": "časně i věčně hynu? —"
  },
  {
   "texto": "Časně i věčně? — věčně — čas —“"
  },
  {
   "texto": "Hrůzou umírá vězně hlas"
  },
  {
   "texto": "obražený od temných stěn;"
  },
  {
   "texto": "hluboké noci němý stín"
  },
  {
   "texto": "daleké kobky zajme klín,"
  },
  {
   "texto": "a paměť vězně nový sen."
  },
  {
   "texto": "„Ach — ona, ona! Anjel můj!"
  },
  {
   "texto": "Proč klesla dřív, než jsem ji znal?"
  },
  {
   "texto": "Proč otec můj? — Proč svůdce tvůj?"
  },
  {
   "texto": "Má kletba —“ Léč hluboký žal"
  },
  {
   "texto": "umoří slova. Kvapně vstal;"
  },
  {
   "texto": "nocí řinčí řetězů hřmot"
  },
  {
   "texto": "a z mala okna vězně zrak"
  },
  {
   "texto": "zalétá ven za hluky vod. —"
  },
  {
   "texto": "Ouplný měsíc přikryl mrak,"
  },
  {
   "texto": "než nade temný horní stín"
  },
  {
   "texto": "vychází hvězdy v noci klín;"
  },
  {
   "texto": "i po jezeru hvězdný svit,"
  },
  {
   "texto": "co ztracené světlo se míhá."
  },
  {
   "texto": "Zrak vězně tyto jiskry stíhá,"
  },
  {
   "texto": "a v srdce bolný vodí cit."
  },
  {
   "texto": "„Jak krásnáť noc! Jak krásný svět!"
  },
  {
   "texto": "Jak světlo — stín se střídá!"
  },
  {
   "texto": "Ach — zítra již můj mrtvý hled"
  },
  {
   "texto": "nic více neuhlídá!"
  },
  {
   "texto": "A jako venku šedý mrak"
  },
  {
   "texto": "dál — dál se rozestírá:"
  },
  {
   "texto": "tak — “ Sklesl vězeň, sklesl zrak,"
  },
  {
   "texto": "řetězů řinčí hřmot, a pak"
  },
  {
   "texto": "u tichu vše umírá."
  },
  {
   "texto": "Již od hor k horám mraku stín —"
  },
  {
   "texto": "ohromna ptáka peruť dlouhá —"
  },
  {
   "texto": "daleké noci přikryl klín,"
  },
  {
   "texto": "a šírou dálkou tma je pouhá."
  },
  {
   "texto": "Slyš! za horami sladký hlas"
  },
  {
   "texto": "pronikl nocí temnou,"
  },
  {
   "texto": "lesní to trouba v noční čas"
  },
  {
   "texto": "uvádí hudbu jemnou."
  },
  {
   "texto": "Vše uspal tento sladký zvuk,"
  },
  {
   "texto": "i noční dálka dřímá."
  },
  {
   "texto": "Vězeň zapomněl vlastních muk,"
  },
  {
   "texto": "tak hudba ucho jímá."
  },
  {
   "texto": "„Jak milý život sladký hlas"
  },
  {
   "texto": "v krajinu noční vdechne;"
  },
  {
   "texto": "než zítřejší — ach — mine čas,"
  },
  {
   "texto": "tu ucho mé ach nikdy zas"
  },
  {
   "texto": "těch zvuků nedoslechne!“"
  },
  {
   "texto": "Zpět sklesne vězeň — řetěz hluk"
  },
  {
   "texto": "kobkou se rozestírá; — —"
  },
  {
   "texto": "hluboké ticho. — V hloubi muk"
  },
  {
   "texto": "se opět srdce svírá,"
  },
  {
   "texto": "a dálné trouby sladký zvuk"
  },
  {
   "texto": "co jemný pláč umírá. — — —"
  },
  {
   "texto": "„Budoucí čas?! — Zítřejší den?! —"
  },
  {
   "texto": "Co přes něj dál, pouhý to sen,"
  },
  {
   "texto": "či spaní je bez snění?"
  },
  {
   "texto": "Snad spaní je i život ten,"
  },
  {
   "texto": "jenž žiji teď; a příští den"
  },
  {
   "texto": "jen v jiný sen je změní?"
  },
  {
   "texto": "Či po čem tady toužil jsem,"
  },
  {
   "texto": "a co neměla šírá zem,"
  },
  {
   "texto": "zítřejší den mi zjeví?"
  },
  {
   "texto": "Kdo ví? — Ach žádný neví.“ —"
  },
  {
   "texto": "A opět mlčí. Tichá noc"
  },
  {
   "texto": "kol kolem vše přikrývá."
  },
  {
   "texto": "Zhasla měsíce světlá moc,"
  },
  {
   "texto": "i hvězdný svit, a kol a kol"
  },
  {
   "texto": "je pouhé temno, šírý dol"
  },
  {
   "texto": "co hrob daleký zívá."
  },
  {
   "texto": "Umlkl vítr, vody hluk,"
  },
  {
   "texto": "usnul i líbý trouby zvuk,"
  },
  {
   "texto": "a u vězení síni dlouhé"
  },
  {
   "texto": "je mrtvé ticho, temno pouhé."
  },
  {
   "texto": "„Hluboká noc — temná je noc! —"
  },
  {
   "texto": "Temnější mně nastává — — —"
  },
  {
   "texto": "Pryč, myšlenko!!“ — A citu moc"
  },
  {
   "texto": "myšlenku překonává."
  },
  {
   "texto": "Hluboké ticho. — Z mokrých stěn"
  },
  {
   "texto": "kapka za kapkou splyne,"
  },
  {
   "texto": "a jejich pádu dutý hlas"
  },
  {
   "texto": "dalekou kobkou rozložen,"
  },
  {
   "texto": "jako by noční měřil čas,"
  },
  {
   "texto": "zní — hyne — zní a hyne —"
  },
  {
   "texto": "zní — hyne — zní a hyne zas."
  },
  {
   "texto": "„Jak dlouhá noc — jak dlouhá noc —"
  },
  {
   "texto": "však delší mně nastává. — — —"
  },
  {
   "texto": "Pryč, myšlenko!“ — A hrůzy moc"
  },
  {
   "texto": "myšlenku překonává. —"
  },
  {
   "texto": "Hluboké ticho. — Kapky hlas"
  },
  {
   "texto": "svým pádem opět měří čas."
  },
  {
   "texto": "„Temnější noc! — — — Zde v noční klín"
  },
  {
   "texto": "ba lůny zář, ba hvězdný kmit"
  },
  {
   "texto": "se vloudí — — tam — jen pustý stín,"
  },
  {
   "texto": "tam žádný — žádný — žádný svit,"
  },
  {
   "texto": "pouhá jen tma přebývá."
  },
  {
   "texto": "Tam všecko jedno, žádný díl —"
  },
  {
   "texto": "vše bez konce — tam není chvíl,"
  },
  {
   "texto": "nemine noc, nevstane den,"
  },
  {
   "texto": "tam času neubývá. —"
  },
  {
   "texto": "Tam žádný — žádný — žádný cíl —"
  },
  {
   "texto": "bez konce dál — bez konce jen"
  },
  {
   "texto": "se na mne věčnost dívá."
  },
  {
   "texto": "Tam prázdno pouhé — nade mnou,"
  },
  {
   "texto": "a kolem mne i pode mnou"
  },
  {
   "texto": "pouhé tam prázdno zívá. —"
  },
  {
   "texto": "Bez konce ticho — žádný hlas —"
  },
  {
   "texto": "bez konce místo — noc — i čas — — —"
  },
  {
   "texto": "to smrtelný je mysle sen,"
  },
  {
   "texto": "toť, co se ‚nic‘ nazývá."
  },
  {
   "texto": "A než se příští skončí den,"
  },
  {
   "texto": "v to pusté nic jsem uveden. — — —“"
  },
  {
   "texto": "Vězeň i hlas omdlívá."
  },
  {
   "texto": "A lehounce si vlnky hrají"
  },
  {
   "texto": "jezerní dálkou pode věží,"
  },
  {
   "texto": "s nimi si vlnky šepotají,"
  },
  {
   "texto": "vězně uspávati se zdají,"
  },
  {
   "texto": "jenž v hlubokých mrákotách leží."
  },
  {
   "texto": "Strážného vzbudil strašný hřmot,"
  },
  {
   "texto": "jejž řetězů činí padání;"
  },
  {
   "texto": "se světlem vstoupil. — Lehký chod"
  },
  {
   "texto": "nevzbudil vězně z strašných zdání."
  },
  {
   "texto": "Od sloupu k sloupu lampy svit"
  },
  {
   "texto": "dlouhou zalétá síní,"
  },
  {
   "texto": "vzdy bledší — bledší její kmit,"
  },
  {
   "texto": "až vzadu zmizí její moc,"
  },
  {
   "texto": "a pustopustá temná noc"
  },
  {
   "texto": "ostatní díl zastíní."
  },
  {
   "texto": "Leč nepohnutý vězně zrak —"
  },
  {
   "texto": "jak by jej ještě halil mrak —"
  },
  {
   "texto": "zdá se, že nic nezírá;"
  },
  {
   "texto": "ač strážce lampy rudá zář"
  },
  {
   "texto": "ubledlou mu polila tvář,"
  },
  {
   "texto": "a tma již prchla čírá."
  },
  {
   "texto": "On za kamenný složen stůl"
  },
  {
   "texto": "hlavu o ruce opírá,"
  },
  {
   "texto": "polou sedě a kleče půl"
  },
  {
   "texto": "znovu v mdlobách umírá;"
  },
  {
   "texto": "a jeví hlasu šepot mdlý,"
  },
  {
   "texto": "že trapnýť jeho sen i zlý."
  },
  {
   "texto": "„Duch můj — duch můj — a duše má!“"
  },
  {
   "texto": "Tak slova mu jednotlivá"
  },
  {
   "texto": "ze sevřených ust plynou."
  },
  {
   "texto": "Než však dostihne ucho hlas,"
  },
  {
   "texto": "tu slova strašná ničím zas —"
  },
  {
   "texto": "jakž byla vyšla — hynou."
  },
  {
   "texto": "Přistoupí strážce, a lampy zář"
  },
  {
   "texto": "před samou vězně vstoupí tvář."
  },
  {
   "texto": "Obličej vězně — strašný zjev —"
  },
  {
   "texto": "oko spočívá nehnuté"
  },
  {
   "texto": "jak v neskončenost napnuté, —"
  },
  {
   "texto": "po tváři slzy — pot a krev;"
  },
  {
   "texto": "v ustech spí šepot — tichý zpěv."
  },
  {
   "texto": "Tu k ustům vězně ucho své"
  },
  {
   "texto": "přiklonil strážce bázlivé;"
  },
  {
   "texto": "a jak by lehký větřík vál,"
  },
  {
   "texto": "vězeň svou pověst šepce dál."
  },
  {
   "texto": "A strážný vzdy se níž a níž"
  },
  {
   "texto": "ku vězni kloní — blíž a blíž,"
  },
  {
   "texto": "až ucho s usty vězně spojí."
  },
  {
   "texto": "ten šepce tíše — tíš a tíš,"
  },
  {
   "texto": "až zmlkne — jak by pevně spal."
  },
  {
   "texto": "Leč strážný nepohnutě stojí,"
  },
  {
   "texto": "po tváři se mu slzy rojí,"
  },
  {
   "texto": "ve srdci jeho strašný žal. —"
  },
  {
   "texto": "Dlouho tak stojí přimrazen,"
  },
  {
   "texto": "až sebrav sílu kvapně vstal,"
  },
  {
   "texto": "a rychlým krokem spěchá ven."
  },
  {
   "texto": "On sice — dokud ještě žil —"
  },
  {
   "texto": "co slyšel, nikdy nezjevil,"
  },
  {
   "texto": "než navzdy bledé jeho líce"
  },
  {
   "texto": "neusmály se nikdy více."
  },
  {
   "texto": "Za strážným opět temný stín"
  },
  {
   "texto": "zahalil dlouhé síně klín;"
  },
  {
   "texto": "hlubokou nocí kapky hlas"
  },
  {
   "texto": "svým pádem opět měřil čas."
  },
  {
   "texto": "A vězeň na kamenný stůl"
  },
  {
   "texto": "složený — klečí — sedí půl."
  },
  {
   "texto": "Obličej jeho — strašný zjev —"
  },
  {
   "texto": "oko spočívá nehnuté,"
  },
  {
   "texto": "jak v neskončenost napnuté,"
  },
  {
   "texto": "po tváři slzy — pot — a krev."
  },
  {
   "texto": "A ustavičně kapky hlas"
  },
  {
   "texto": "svým pádem dále měří čas."
  },
  {
   "texto": "A kapky — vod i větrů zpěv"
  },
  {
   "texto": "vězňovi blízký hlásá skon,"
  },
  {
   "texto": "jenž myšlenkami omdlívá. —"
  },
  {
   "texto": "Z dálky se sova ozývá,"
  },
  {
   "texto": "a nad ním půlnoc bije zvon."
  }
 ]
}