{
 "id": "cech-vaclav-z-michalovic-c07",
 "titulo": "Zpěv šestý",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V%C3%A1clav_z_Michalovic/Zp%C4%9Bv_%C5%A1est%C3%BD",
 "fuente": "cs.wikisource.org, «Václav z Michalovic»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-vaclav-z-michalovic",
  "titulo": "Václav z Michalovic",
  "orden": 7
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "V salvatorském chrámě lidu dav"
  },
  {
   "texto": "lodi velkolepé délkou, šíří"
  },
  {
   "texto": "jako vlnící se řeka hlav"
  },
  {
   "texto": "šumně proudí, rozlévá se, víří,"
  },
  {
   "texto": "pustou tísní sloupy obkličuje,"
  },
  {
   "texto": "v každý záhyb ochozů se tlačí,"
  },
  {
   "texto": "hlava nad hlavu se vytyčuje,"
  },
  {
   "texto": "v před se napíná, kam hrdlo stačí,"
  },
  {
   "texto": "ba i sloupů mocné podstavce"
  },
  {
   "texto": "všetečnější nesou zvědavce."
  },
  {
   "texto": "Dnes-tě pyšný don Huerta strojí"
  },
  {
   "texto": "s nebývalou slávou svatbu dvojí."
  },
  {
   "texto": "Mostem celým valný průvod sahá"
  },
  {
   "texto": "vozů skvostných, urozených lidí —"
  },
  {
   "texto": "také divadlo as dávno Praha"
  },
  {
   "texto": "neviděla, dlouho neuvidí."
  },
  {
   "texto": "Jako zaduje-li v mlází hustém"
  },
  {
   "texto": "vichr náhlý, peň se ke pni chýlí,"
  },
  {
   "texto": "vrchol vrcholku ruch šumný sdílí,"
  },
  {
   "texto": "až háj celý chví se v hluku pustém:"
  },
  {
   "texto": "takto nyní dav ten zvědavý"
  },
  {
   "texto": "bouřlivě se po svatyni čeří,"
  },
  {
   "texto": "hlavy vzpínají se nad hlavy,"
  },
  {
   "texto": "přitlumeně hučí rtové steří — —"
  },
  {
   "texto": "Panoši aj! krásní v lepém kroji,"
  },
  {
   "texto": "s erbem v prsou, v jasné kamizole,"
  },
  {
   "texto": "se stran obou v lehké hráze pojí"
  },
  {
   "texto": "chrámu středem pozlacené hole"
  },
  {
   "texto": "a již dráha, utvořená jimi,"
  },
  {
   "texto": "zástupy se plní svatebními."
  },
  {
   "texto": "V předu s juným švarným ženichem"
  },
  {
   "texto": "hrdé Marie zjev divukrásný"
  },
  {
   "texto": "nevídaným skvostů přepychem"
  },
  {
   "texto": "budí po zástupech obdiv hlasný."
  },
  {
   "texto": "Zlatohlav po vábném jejím těle"
  },
  {
   "texto": "hojnou vlnou zářivou se stele,"
  },
  {
   "texto": "od šíje až k zemi kol do kola"
  },
  {
   "texto": "jakby zrosen deštěm drahokamů,"
  },
  {
   "texto": "jichžto mžikem každým zaplápolá"
  },
  {
   "texto": "nová řada v různobarvém plamu."
  },
  {
   "texto": "Svislé rukávy jí s ramen vlají"
  },
  {
   "texto": "jako zlatá křídla; tiché znění"
  },
  {
   "texto": "zlatých zvonků jejich na okraji"
  },
  {
   "texto": "v hudbu kouzelnou chod její mění."
  },
  {
   "texto": "Pod svatebním vínkem na temeni"
  },
  {
   "texto": "splývá nad půvabem hrdé tváře"
  },
  {
   "texto": "závoj přejemný, že zlaté kvítí,"
  },
  {
   "texto": "na něm utkané, jen v pouhé páře"
  },
  {
   "texto": "prosvitavé vzduchem zdá se chvíti."
  },
  {
   "texto": "Odhrnutý zlatý jeho lem"
  },
  {
   "texto": "jeví z perel vzácných diadem"
  },
  {
   "texto": "v bohatého vlasu vlnách zlatých;"
  },
  {
   "texto": "pod nimi se pyšně vzpíná šíje"
  },
  {
   "texto": "z bělolesklých límců cípovatých,"
  },
  {
   "texto": "jako z květu bájné kamelie;"
  },
  {
   "texto": "na bělostném hrdle, objatém"
  },
  {
   "texto": "nesčíslným českým granátem,"
  },
  {
   "texto": "tisíc jisker žhavorudých skáče;"
  },
  {
   "texto": "ouška tíží tenké zlaté kruhy,"
  },
  {
   "texto": "v nichž se houpá démantové ptáče — —"
  },
  {
   "texto": "Tak ji vidíš, jako řízou duhy"
  },
  {
   "texto": "obestlanou slunce kněžku samu,"
  },
  {
   "texto": "smějící se deštěm drahokamů."
  },
  {
   "texto": "Celé jedno panství zabavené,"
  },
  {
   "texto": "Huertovi za vděk zůstavené,"
  },
  {
   "texto": "jistě ztrávil těchto skvostů žár;"
  },
  {
   "texto": "ba jen onen drahokamů pár"
  },
  {
   "texto": "do střevíčků zlatých zasazený"
  },
  {
   "texto": "nad poplužní dvůr je větší ceny."
  },
  {
   "texto": "Však ta světská zář, ten marný pych,"
  },
  {
   "texto": "který dnes kol nevěsty se blyští,"
  },
  {
   "texto": "bude k nebi vznášet dobou příští"
  },
  {
   "texto": "milióny srdcí pobožných;"
  },
  {
   "texto": "nevěsta-tě šťastná věnovala"
  },
  {
   "texto": "šat svůj snubní s hojným nadáním"
  },
  {
   "texto": "soše svaté patrónky, již dala"
  },
  {
   "texto": "nad oltářem vztyčit postranním"
  },
  {
   "texto": "a jíž sochař v úbělové líce"
  },
  {
   "texto": "vkouzlil rysy zbožné krasavice."
  },
  {
   "texto": "Nyní vedle zasnoubence svého"
  },
  {
   "texto": "pyšných lící, vzrůstu mohutného,"
  },
  {
   "texto": "za Marií něžný obraz děví"
  },
  {
   "texto": "jako luna za sluncem se jeví."
  },
  {
   "texto": "Oděnoť je tílko její celé"
  },
  {
   "texto": "s hrdla po střevíčky běloskvělé"
  },
  {
   "texto": "stříbrohlavem jemným; v jeho třpytu"
  },
  {
   "texto": "libý obrys útlé postavy"
  },
  {
   "texto": "zdá se utkán ze stříbrných svitů"
  },
  {
   "texto": "jarní noci. Zástup zvědavý"
  },
  {
   "texto": "tichne kolem, jako z obavy,"
  },
  {
   "texto": "že by mohl všední zvuk a ruch"
  },
  {
   "texto": "zaplašiti vděk ten divuněžný,"
  },
  {
   "texto": "jakým pouze báje divný luh"
  },
  {
   "texto": "odívá své hvězdorouché kněžny."
  },
  {
   "texto": "Krásná hlavinka, jíž perel šňůry"
  },
  {
   "texto": "probleskují z temné vlasů chmury,"
  },
  {
   "texto": "jako jarní květ pod tíží rosy"
  },
  {
   "texto": "uklání se ve průsvitné mlze"
  },
  {
   "texto": "šláře tenkého — v něm blýská cosi — —"
  },
  {
   "texto": "zda to perličky jsou nebo slze?"
  },
  {
   "texto": "Proč tak smuten hledí ze závoje"
  },
  {
   "texto": "vábný obličej, tak mrtvě bled,"
  },
  {
   "texto": "jak se míhá jasnou vlnou zdroje"
  },
  {
   "texto": "sněhobílý leknínový květ?"
  },
  {
   "texto": "Proč jí vázne krok? Proč chví se časem"
  },
  {
   "texto": "jak peň osykový jemným třasem?"
  },
  {
   "texto": "Proč se tisknou ručky její sněžné"
  },
  {
   "texto": "v luzné hrudi perlotkané kvítí,"
  },
  {
   "texto": "v ty dvě vlny stříbrohlavu něžné,"
  },
  {
   "texto": "jež se těžkým vzdechem zdají chvíti?"
  },
  {
   "texto": "Za snoubenci do kostela vplývá"
  },
  {
   "texto": "průvod urozených svatebčanů,"
  },
  {
   "texto": "jako drahých látek řeka živá,"
  },
  {
   "texto": "čeřící se v jitra svěžím vanu,"
  },
  {
   "texto": "jejíž vlny pestré v toku hbitém"
  },
  {
   "texto": "šperků nesčetných se jiskří kmitem."
  },
  {
   "texto": "Jako vítr, když si s klasy hrá,"
  },
  {
   "texto": "různé květy v jejich zlatě jeví,"
  },
  {
   "texto": "tu se chrpa skrytá zamodrá,"
  },
  {
   "texto": "mák se zardí tam jak líčko děví:"
  },
  {
   "texto": "takto zde v nádherném paní davu"
  },
  {
   "texto": "vlnící se spoustou zlatohlavu"
  },
  {
   "texto": "tuto safír z šatů řasy svitne,"
  },
  {
   "texto": "onde rubín prstenu se kmitne,"
  },
  {
   "texto": "nové skvosty vždy se jeví vidu"
  },
  {
   "texto": "v nových hostí šumném přílivu —"
  },
  {
   "texto": "neumlká po zástupech lidu"
  },
  {
   "texto": "přitlumený šepot obdivu."
  },
  {
   "texto": "Presbytář již nádheru těch sborů"
  },
  {
   "texto": "objímá svou pozlacenou mříží;"
  },
  {
   "texto": "nyní fanfára zní hlučná z chóru —"
  },
  {
   "texto": "chvilka svatých obřadů se blíží."
  },
  {
   "texto": "Však co to? Proč náhle tu a tam"
  },
  {
   "texto": "obličej se zdvihá, oko pílí"
  },
  {
   "texto": "ku chrámové klenby výsotám?"
  },
  {
   "texto": "Stiskem, šepotem druh druhu sdílí"
  },
  {
   "texto": "nové zvědavosti ruch. Již steré"
  },
  {
   "texto": "prsty pnou se vzhůru, tisíc očí"
  },
  {
   "texto": "ku závratné výši pološeré"
  },
  {
   "texto": "odevšady s úžasem se točí."
  },
  {
   "texto": "Hle, tam pod kupolí nádhernou"
  },
  {
   "texto": "v úzké chodbě, jež lem její vroubí,"
  },
  {
   "texto": "oddělena od závratné hloubi"
  },
  {
   "texto": "sloupcovou jen mříží titěrnou,"
  },
  {
   "texto": "v chodbě té, jež k ozdobě jen slohu"
  },
  {
   "texto": "zřízena, ne pro člověčí nohu,"
  },
  {
   "texto": "podoba se chvěje jako stín,"
  },
  {
   "texto": "černorouchá. — Čemu pouť ta platí?"
  },
  {
   "texto": "Kdo ten chodec — Blázen? — Podivín,"
  },
  {
   "texto": "jenž si směle hraje se závratí?"
  },
  {
   "texto": "Václav to. Dnů mnoho v těsné cele"
  },
  {
   "texto": "zamčen trávil. Dumu jeho chmurnou"
  },
  {
   "texto": "rušívali časem věznitelé,"
  },
  {
   "texto": "snažící se marně šíji zpurnou"
  },
  {
   "texto": "sklonit pod bývalé jho. Jak němý"
  },
  {
   "texto": "sedal před nimi, zrak chýle k zemi,"
  },
  {
   "texto": "a kdy s hněvem vyšli, dále spřádal"
  },
  {
   "texto": "temnou dumu, bledé líce skládal"
  },
  {
   "texto": "na spoutané ruce v žalné mdlobě."
  },
  {
   "texto": "Však dnes uchvátil jej náhlý hněv,"
  },
  {
   "texto": "vskočil, zařval jako spjatý lev,"
  },
  {
   "texto": "pouta rozerval a v divé zlobě"
  },
  {
   "texto": "zalomcoval dveřmi. — A hle! dvéře"
  },
  {
   "texto": "povolily. Prázdné chodby šerem"
  },
  {
   "texto": "k brance u schodů se kvapně béře —"
  },
  {
   "texto": "Zamčena je! — Opačným teď směrem"
  },
  {
   "texto": "ubírá se ve klopotném spěchu"
  },
  {
   "texto": "a tam stoupá temnem schůdků krytých"
  },
  {
   "texto": "pod krov domu, pod mohutnou střechu."
  },
  {
   "texto": "Mocné krytí cihel žlábkovitých"
  },
  {
   "texto": "nese, rozpíná jak dlouhý stan,"
  },
  {
   "texto": "úžasný, směs trámů obrovitých,"
  },
  {
   "texto": "břeven, kráčat, latí umně sbitých,"
  },
  {
   "texto": "křížící se hustě s obou stran."
  },
  {
   "texto": "Po kládovém roštu spěchá ruče"
  },
  {
   "texto": "jinoch vzdušnou dřevěnou zde kostrou"
  },
  {
   "texto": "nedbaje, že tu jej krokev tluče,"
  },
  {
   "texto": "tamo trámec bodá hranou ostrou;"
  },
  {
   "texto": "prolézá pak, nahrbené šíje,"
  },
  {
   "texto": "pode stříškou, která chodbu kryje"
  },
  {
   "texto": "pojící dům jesuitů k chrámu,"
  },
  {
   "texto": "a dál v nové síti přeumělé"
  },
  {
   "texto": "rozmanitých rozpon, sloupců, trámů"
  },
  {
   "texto": "leze, skáče, proplétá se směle,"
  },
  {
   "texto": "až pak zdvihnuv dvéře padací"
  },
  {
   "texto": "temnem schodů točitých se níží"
  },
  {
   "texto": "v těsnou kobu. K lepotkané mříži"
  },
  {
   "texto": "dvířek železných se obrací."
  },
  {
   "texto": "Nejsou uzamčena. Kvapným krokem"
  },
  {
   "texto": "vystoup’ jimi. Zraky udivené"
  },
  {
   "texto": "bloudí plaše v kole přeširokém,"
  },
  {
   "texto": "nad nímž k výši závratné se klene"
  },
  {
   "texto": "obrovitá lepá kupole."
  },
  {
   "texto": "Titanští tam zevšad andělé"
  },
  {
   "texto": "v ladných barvách malby umělé"
  },
  {
   "texto": "velebně se nesou k vrcholu,"
  },
  {
   "texto": "tam, kde Otec s koulí světa v lůně"
  },
  {
   "texto": "vedle Krista na oblačném trůně"
  },
  {
   "texto": "sedí velebně a křídla bílá"
  },
  {
   "texto": "nad nimi Duch svatý rozestýlá."
  },
  {
   "texto": "Přes zábradlí jinoch kloní oko:"
  },
  {
   "texto": "lidu spousta peřestá se chvěje"
  },
  {
   "texto": "pod nohama jeho přehluboko."
  },
  {
   "texto": "Nepoznává, co se v chrámu děje."
  },
  {
   "texto": "Zmaten kráčí chodbou, přes zábradlí"
  },
  {
   "texto": "do závratné hloubi chýle zrak,"
  },
  {
   "texto": "kde se hemží dav, jak pestrý mrak,"
  },
  {
   "texto": "jak včel obrovský roj, k zemi spadlý."
  },
  {
   "texto": "Náhle stanul. Z plné prsou síly"
  },
  {
   "texto": "zahřměl dolů řečí plamennou,"
  },
  {
   "texto": "kupole pak svahy opáčily"
  },
  {
   "texto": "slova jeho hromnou ozvěnou:"
  },
  {
   "texto": "„Vzhůru, lide uhnětený, vzhůru!"
  },
  {
   "texto": "Z potupného jarma vypni šíje!"
  },
  {
   "texto": "Povstaň! Umačkej tu černou můru,"
  },
  {
   "texto": "jež tak dlouho krev tvých ňader pije!"
  },
  {
   "texto": "Bij tu cizí sběř, jež zpupně hýří"
  },
  {
   "texto": "na urvaném v této zemi lupu,"
  },
  {
   "texto": "jež ti vetkla na věž za potupu"
  },
  {
   "texto": "nejkrasší tvé hlavy bohatýří!"
  },
  {
   "texto": "Bij tu zvěř, jež ve tvé vlasti klínu"
  },
  {
   "texto": "pod zlatem a hedvábem se hřeje,"
  },
  {
   "texto": "kdežto bez počtu tvých zdárných synů"
  },
  {
   "texto": "s holí žebráckou v kraj cizí spěje!"
  },
  {
   "texto": "Bij ty vrahy, lupiče a zrádce,"
  },
  {
   "texto": "daviče tvých děv, tvých dětí krádce,"
  },
  {
   "texto": "paliče tvých příbytků a knih,"
  },
  {
   "texto": "bij ty hrobaře tvé zašlé slávy,"
  },
  {
   "texto": "již jak míčem hrají tvými právy"
  },
  {
   "texto": "a z tvých bolestí si tropí smích,"
  },
  {
   "texto": "kteří vyrvali ti zem a jmění,"
  },
  {
   "texto": "víry potěchu a duše klid,"
  },
  {
   "texto": "ba též rodné mluvy hlaholení"
  },
  {
   "texto": "z těchto luhů chtějí zaplašit,"
  },
  {
   "texto": "nechali ti jenom břímě žití,"
  },
  {
   "texto": "aby na bídu tvou, na tvůj žal"
  },
  {
   "texto": "s potěšením krutým mohli zříti,"
  },
  {
   "texto": "aby noha jich — — —"
  },
  {
   "texto": "Ha, studu pal,"
  },
  {
   "texto": "lide bědný, nestoupá ti v líce?!"
  },
  {
   "texto": "Což ni jiskra v tobě nezbyla"
  },
  {
   "texto": "z chrabrosti, jež vrahů statisíce"
  },
  {
   "texto": "na bojištích sterých pobila?!"
  },
  {
   "texto": "Ani krůpěj z krve mužů těch,"
  },
  {
   "texto": "jejichž cepů třesk a vozů hřmění"
  },
  {
   "texto": "postrach nesly do národů všech"
  },
  {
   "texto": "a jichž dálné vítězilo pění?!"
  },
  {
   "texto": "Lide, vstaň! Však ucítíš ji zase,"
  },
  {
   "texto": "bývalou tu sílu v jaré pleci —"
  },
  {
   "texto": "vzplaneš opět ve vítězném jase"
  },
  {
   "texto": "jako Žižkovi ti dávní reci."
  },
  {
   "texto": "Povypni jen šíji s žárným vztekem,"
  },
  {
   "texto": "povstaň, z tupé mrákoty se zbuď —"
  },
  {
   "texto": "rozprchnou se supi s bědným skřekem,"
  },
  {
   "texto": "sletnuvší se k hodům na tvou hruď!“"
  },
  {
   "texto": "Dole zmítá bouře poplachu"
  },
  {
   "texto": "spoustou lidu. Svatebčané s davy"
  },
  {
   "texto": "v úžasu a hněvu, ve strachu"
  },
  {
   "texto": "míchají se v chaos kolotavý."
  },
  {
   "texto": "Lidu proud se pod kupoli tlačí"
  },
  {
   "texto": "a proud jiný k východu se dere,"
  },
  {
   "texto": "na sta očí blýská, čel se mračí,"
  },
  {
   "texto": "k jilcům sklánějí se dlaně steré;"
  },
  {
   "texto": "tu a tam se žehná třesavý"
  },
  {
   "texto": "zástup žen a děvic vyplašených"
  },
  {
   "texto": "a jich tlumem Otců postrašených"
  },
  {
   "texto": "míhají se černé postavy."
  },
  {
   "texto": "Ozývá se dupot, šum a křik —"
  },
  {
   "texto": "avšak junův hlas tu zvuků směs"
  },
  {
   "texto": "proniká — až páter varhaník"
  },
  {
   "texto": "s myslí vtipnou zajel do klaves"
  },
  {
   "texto": "a svou hudbou jako bouří slavnou"
  },
  {
   "texto": "utlumil řeč jeho přeohavnou."
  },
  {
   "texto": "Branců přivolaných pestrý kroj"
  },
  {
   "texto": "teď se mísí v dav; jak mrakem blesky"
  },
  {
   "texto": "prošlehuje lidem jejich zbroj."
  },
  {
   "texto": "A jak divem před těmito lesky"
  },
  {
   "texto": "mnohá tvář, jež zpupně již se vznesla,"
  },
  {
   "texto": "chabě na malátná prsa klesla."
  },
  {
   "texto": "Avšak jesuité v rozpacích"
  },
  {
   "texto": "posud hledí do závratné výše,"
  },
  {
   "texto": "tam kde smělec s blesky ve zracích"
  },
  {
   "texto": "jako vidmo z nadpozemské říše,"
  },
  {
   "texto": "s vlasem pustým, s napřaženou rukou"
  },
  {
   "texto": "hrdě vztyčen stojí v kupoli"
  },
  {
   "texto": "a s tou varhan hudbou šumnozvukou"
  },
  {
   "texto": "zlobným hlasem darmo zápolí."
  },
  {
   "texto": "Než tu náhle druhá, míhavá"
  },
  {
   "texto": "v kupoli se jeví postava"
  },
  {
   "texto": "na závratné chodbě, s vlasem plavým,"
  },
  {
   "texto": "s řásným černým rouchem poletavým."
  },
  {
   "texto": "Jako dravec před smrtícím skokem,"
  },
  {
   "texto": "kolem zábradlí se chvatně plíží"
  },
  {
   "texto": "nahrbena, s jiskřícím se okem"
  },
  {
   "texto": "tam, kde Václav do zástupů shlíží."
  },
  {
   "texto": "Leč ten ohlednuv se v pravý čas"
  },
  {
   "texto": "úhlavního nepřítele zočil"
  },
  {
   "texto": "a hned v ústrety mu hbitě skočil"
  },
  {
   "texto": "rozpínaje náruč u zápas."
  },
  {
   "texto": "Jako tišina když nenadálá"
  },
  {
   "texto": "spoutá vlny bouřlivého moře:"
  },
  {
   "texto": "zmlká vřava svaté ve prostoře,"
  },
  {
   "texto": "utichla i hudba varhan v chóře"
  },
  {
   "texto": "a směs lidstva bez pohnutí stála"
  },
  {
   "texto": "pozorujíc v němém napjetí"
  },
  {
   "texto": "žasný zápol na obrubě těsné"
  },
  {
   "texto": "hrozné propasti a smrti děsné,"
  },
  {
   "texto": "dvou těl juných líté objetí,"
  },
  {
   "texto": "dvou těch černých postav souboj divý,"
  },
  {
   "texto": "sem tam klonících se v půtce žhavé"
  },
  {
   "texto": "kmitavými nad propastí kyvy,"
  },
  {
   "texto": "balících se časem v klubko tmavé;"
  },
  {
   "texto": "zdola mněl bys, že to na pokraji"
  },
  {
   "texto": "kupole, kde sloupců kruh ji věnčí,"
  },
  {
   "texto": "— jež se malbou spíš, než hmotou zdají —"
  },
  {
   "texto": "rozmanitě v polosvitu hrají,"
  },
  {
   "texto": "každou chvilku jeví obraz jiný"
  },
  {
   "texto": "míhavé dva fantastické stíny."
  },
  {
   "texto": "Posléz Václav nad Konrada vzpjal se,"
  },
  {
   "texto": "který pod ním s tělem opřeným"
  },
  {
   "texto": "o zábradlí, přes ně přehýbal se"
  },
  {
   "texto": "svislou hlavou, hrdlem sevřeným"
  },
  {
   "texto": "prsty jeho, polovicí zad."
  },
  {
   "texto": "A v tom na vítěze třpytným zlatem"
  },
  {
   "texto": "oknem kupole svit jasný pad’:"
  },
  {
   "texto": "spočal zářivě na dříku vzpjatém,"
  },
  {
   "texto": "jehož hruď se bělala jak sníh"
  },
  {
   "texto": "zpola rozervaným temným šatem;"
  },
  {
   "texto": "v bujném vlase skrání vztyčených,"
  },
  {
   "texto": "pod nímž jemný obličej se skvěl"
  },
  {
   "texto": "jarým leskem bohatýrské vnady;"
  },
  {
   "texto": "i byl krásným Michalovic mladý"
  },
  {
   "texto": "v tuto chvíli, jako archanděl,"
  },
  {
   "texto": "když se vypjal, září nebes plana,"
  },
  {
   "texto": "ve vítězné slávě nad Satana."
  },
  {
   "texto": "Však proč hrdě plápolavý zrak,"
  },
  {
   "texto": "slétající do hlubiny chrámu,"
  },
  {
   "texto": "náhle v jiném zažehá se plamu?"
  },
  {
   "texto": "Proč se smeká prstů mocný tlak"
  },
  {
   "texto": "s hrdla zrádného? Proč náruč jeho"
  },
  {
   "texto": "s jásotem se rozestírá dolů? —"
  },
  {
   "texto": "Hle, tam v roji lidu zvědavého,"
  },
  {
   "texto": "v poucouvlých svatebníků kolu"
  },
  {
   "texto": "zočil půvab něžné postavy"
  },
  {
   "texto": "v šatů stříbrotkaných libém jasu…"
  },
  {
   "texto": "Ona rve si závoj se hlavy,"
  },
  {
   "texto": "svatební též vínek s temných vlasů;"
  },
  {
   "texto": "krásný obličej své rysy milé"
  },
  {
   "texto": "k němu vzpíná, čisté lásky pln,"
  },
  {
   "texto": "a dvě rozepjaté ruce bílé"
  },
  {
   "texto": "z řízy stříbrotkané jasných vln"
  },
  {
   "texto": "jak dvě lil’je pnou se k němu vzhůru,"
  },
  {
   "texto": "nesouce mu blaho rajských kůrů."
  },
  {
   "texto": "V tom se Konrad pouvolněn vzpjal"
  },
  {
   "texto": "pod vítězem, klonícím se v blahu,"
  },
  {
   "texto": "rukama jej těsně obestlal;"
  },
  {
   "texto": "avšak náhle, ztrativ rovnováhu,"
  },
  {
   "texto": "přes zábradlí nazad klesl tělem —"
  },
  {
   "texto": "slét’ jak balvan v propasť vržený —"
  },
  {
   "texto": "hoj! a za letícím nepřítelem"
  },
  {
   "texto": "Václav, pádem jeho stržený,"
  },
  {
   "texto": "rozpínaje náruč v žasném letu"
  },
  {
   "texto": "seřítil se v bezdno jiných světů."
  },
  {
   "texto": "Výkřik tisíců se vznesl k báni,"
  },
  {
   "texto": "hromným echem rozlehl se v ní"
  },
  {
   "texto": "a v něm zanikl, jak v bouře řvání"
  },
  {
   "texto": "raněného ptáčka zatikání,"
  },
  {
   "texto": "Ignáciin výkřik poslední."
  }
 ]
}