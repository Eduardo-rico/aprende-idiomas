 "parrafos": [
  {
   "texto": "CLXVI."
  },
  {
   "texto": "Pěl slavík z nejhlubší své hloubky,"
  },
  {
   "texto": "zpěv, perla s perlou, prýštěl do noci,"
  },
  {
   "texto": "na nebi rozechvíval hvězdy,"
  },
  {
   "texto": "a na zem chorým dones’ pomoci."
  },
  {
   "texto": "A lítlo tudy estheticky"
  },
  {
   "texto": "pár špačků s kritickými mozečky:"
  },
  {
   "texto": "„Konečně musíme mu říci,"
  },
  {
   "texto": "že jsou to přec jen liché zvonečky!"
  },
  {
   "texto": "Ké umění v té táhlé písni,"
  },
  {
   "texto": "jež každý tón tak vaří na měkko?"
  },
  {
   "texto": "kdo nestuduje ptáky jiné —"
  },
  {
   "texto": "zda může dospět v písni daleko?"
  },
  {
   "texto": "Jeť chválou zkažen nerozumných,"
  },
  {
   "texto": "nám jeho píseň slavičí je šplech —"
  },
  {
   "texto": "a teď to slyšel; uvidíme,"
  },
  {
   "texto": "zda naší rady také uposlech’.“"
  },
  {
   "texto": "Pěl slavík z nejhlubší své hloubky,"
  },
  {
   "texto": "zpěv, perla s perlou, prýštěl do noci —"
  },
  {
   "texto": "a špačkové jsou jako špačci,"
  },
  {
   "texto": "a slavíkům již není pomoci."
  },
  {
   "texto": "A zavrou-li ti duše mělké"
  },
  {
   "texto": "své prahy k síním zlaceným,"
  },
  {
   "texto": "jdi dál a hledej jen ty velké,"
  },
  {
   "texto": "a nebudeš jim bezcenným."
  },
  {
   "texto": "Věz, žili ducha velikáni"
  },
  {
   "texto": "v všech rodech, v každém století,"
  },
  {
   "texto": "k jich hodům vejdeš bez pozvání"
  },
  {
   "texto": "a hned tě v skvosty zasvětí."
  },
  {
   "texto": "Ba žili ducha velmožové"
  },
  {
   "texto": "co mudrcové, poeti,"
  },
  {
   "texto": "že z jejich hostin žití nové"
  },
  {
   "texto": "na všechna došlo století."
  },
  {
   "texto": "Nuž co mně přízeň těch a oněch,"
  },
  {
   "texto": "byť vedla k prvním do síní;"
  },
  {
   "texto": "má pýcha nezrá po salonech,"
  },
  {
   "texto": "leč v lidstva velké svatyni."
  },
  {
   "texto": "Tať víra má: až bude čtena"
  },
  {
   "texto": "ta suma lidské hodnoty,"
  },
  {
   "texto": "dle tamtěch bude vypočtena,"
  },
  {
   "texto": "ne dle hlav zpýchlé holoty."
  },
  {
   "texto": "Na hrobech lidstva, zvadlá v líci"
  },
  {
   "texto": "smrt potkala se s životem,"
  },
  {
   "texto": "dva unavení vandrovníci,"
  },
  {
   "texto": "teď oba jdou tak plihotem."
  },
  {
   "texto": "A život zpomínal si v žalu,"
  },
  {
   "texto": "co krásných poupat nasil v svět,"
  },
  {
   "texto": "snah, myšlenek a ideálů,"
  },
  {
   "texto": "až pučel k nebi lidstva květ."
  },
  {
   "texto": "Smrt zpomíná si v tiché slasti,"
  },
  {
   "texto": "jak s umíráčkem, zvukem hran"
  },
  {
   "texto": "všem hrála marše do propastí"
  },
  {
   "texto": "a na klíč zamkla do svých bran."
  },
  {
   "texto": "Šel život, okem vyčítavým"
  },
  {
   "texto": "jí v ledovou pohlednul líc:"
  },
  {
   "texto": "„Tam dovedlas to chtíčem dravým"
  },
  {
   "texto": "teď není smrt ni život víc.“"
  },
  {
   "texto": "Smrt stojí v hrobů klidné zbroji"
  },
  {
   "texto": "a povídá k té obvině:"
  },
  {
   "texto": "„Zde vezmi ruku, dej mi svoji,"
  },
  {
   "texto": "takť spravedlivo jedině.“"
  }
 ]
}