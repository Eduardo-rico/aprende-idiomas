 "parrafos": [
  {
   "texto": "Když hluboká se kloní"
  },
  {
   "texto": "noc v Katalaunskou pláň,"
  },
  {
   "texto": "tu mračen dav se honí"
  },
  {
   "texto": "přes bledou nebes báň"
  },
  {
   "texto": "a v obrysech té mrakavy"
  },
  {
   "texto": "zříš mihotavé postavy,"
  },
  {
   "texto": "zříš mečů, kopí matný lesk"
  },
  {
   "texto": "a slyšíš hluchý šum a třesk."
  },
  {
   "texto": "Ze spousty hrobů valné"
  },
  {
   "texto": "to ještě v pozdní věk"
  },
  {
   "texto": "jak ohlas bouře dalné"
  },
  {
   "texto": "zní dávné bitvy jek,"
  },
  {
   "texto": "to válčí v říši vzduchové"
  },
  {
   "texto": "nesčetných hrdin duchové,"
  },
  {
   "texto": "jež hrozná seč tu sklátila,"
  },
  {
   "texto": "když s římem střet’ se Attila."
  },
  {
   "texto": "Mrak zacloňuje lunu"
  },
  {
   "texto": "a v přízi pochmurné"
  },
  {
   "texto": "zříš divné zbraně Hunů"
  },
  {
   "texto": "a hlavy nestvůrné;"
  },
  {
   "texto": "zde orel křídla rozvíjí"
  },
  {
   "texto": "nad mrtvou římskou legií;"
  },
  {
   "texto": "tam bouří vzduchem Franků voj"
  },
  {
   "texto": "a mračno Gotů letí v boj."
  },
  {
   "texto": "Zbraň vzdušnou stíny páží,"
  },
  {
   "texto": "štít nesou z oblaků"
  },
  {
   "texto": "a zuřivě se sráží"
  },
  {
   "texto": "roj mlžných přízraků -"
  },
  {
   "texto": "Tak nad bojištěm dávných dob"
  },
  {
   "texto": "plá z mohyl dosud plamen zlob"
  },
  {
   "texto": "a v širém nebes obvodu"
  },
  {
   "texto": "vře divá bitva národů."
  },
  {
   "texto": "Však podál kruté seče"
  },
  {
   "texto": "ve vzdušném prostranství"
  },
  {
   "texto": "bez boje, v pochvách meče,"
  },
  {
   "texto": "dvé zástupů se chví."
  },
  {
   "texto": "Jich ruce nebes pomstu zvou"
  },
  {
   "texto": "a bolem roucha, vlasy rvou,"
  },
  {
   "texto": "z úst vichřicí jim sténá zpěv,"
  },
  {
   "texto": "v němž víří žal i stud i hněv:"
  },
  {
   "texto": "„Nás nepoudil v ty lány"
  },
  {
   "texto": "žár pomsty, slávy chtíč,"
  },
  {
   "texto": "než jedny Gotů rány"
  },
  {
   "texto": "a druhé Hunů bič."
  },
  {
   "texto": "My nevedli boj hrdinný"
  },
  {
   "texto": "ve vlastní při, štít otčiny -"
  },
  {
   "texto": "než za věc krutých vrahů svých"
  },
  {
   "texto": "kles’ dav tu rabů slovanských."
  },
  {
   "texto": "Sem, nástroj cizí zloby,"
  },
  {
   "texto": "nás hnala cizí pěst"
  },
  {
   "texto": "a v bezejmenné hroby"
  },
  {
   "texto": "nám nezní slávy zvěst:"
  },
  {
   "texto": "jen bol a hanba volá z nich,"
  },
  {
   "texto": "že pro svých škůdců zisk a pych"
  },
  {
   "texto": "jsme do nečestné mohyly"
  },
  {
   "texto": "zde bratři bratry sklátili!“"
  },
  {
   "texto": "Za noci tmavé, burné"
  },
  {
   "texto": "mě nesl teskný duch"
  },
  {
   "texto": "na křídlech dumy chmurné"
  },
  {
   "texto": "na Katalaunský luh."
  },
  {
   "texto": "Já viděl onen děsný zjev"
  },
  {
   "texto": "a slyšel onen strastný zpěv,"
  },
  {
   "texto": "hruď pronikl mi duchů žal"
  },
  {
   "texto": "a ze rtů těžký vzdech se dral:"
  },
  {
   "texto": "Již, nebe, moje plémě"
  },
  {
   "texto": "dost zakusilo běd -"
  },
  {
   "texto": "ó nedej, by zrak země"
  },
  {
   "texto": "zas obraz děsný shléd:"
  },
  {
   "texto": "by lid můj cizím bičem štván"
  },
  {
   "texto": "zas kráčel na krvavý lán"
  },
  {
   "texto": "své bratry sklátit do hrobu"
  },
  {
   "texto": "a sebe v tužší porobu!"
  }
 ]
}