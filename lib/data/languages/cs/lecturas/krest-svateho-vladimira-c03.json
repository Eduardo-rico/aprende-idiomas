 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Zpěv VI. — Audience"
  },
  {
   "texto": "Seděl Vladimír na trůnu"
  },
  {
   "texto": "ve své rezidencí,"
  },
  {
   "texto": "dával podle obyčeje"
  },
  {
   "texto": "velkou audiencí."
  },
  {
   "texto": "Houf ministrů, tajných radů,"
  },
  {
   "texto": "dvorních kavalírů,"
  },
  {
   "texto": "stáli „Richt euch!“ okolo něj"
  },
  {
   "texto": "jak hrušky v špalíru."
  },
  {
   "texto": "Před nimi s ohnutým hřbetem,"
  },
  {
   "texto": "s poníženou tváří"
  },
  {
   "texto": "klečeli v slušném respektu"
  },
  {
   "texto": "páni sekretáři."
  },
  {
   "texto": "Pero v ruce, na knoflíku"
  },
  {
   "texto": "ingoust ve flaštičce"
  },
  {
   "texto": "a na zádech přivázaný"
  },
  {
   "texto": "pytel na petice."
  },
  {
   "texto": "A vzadu si žandarmové,"
  },
  {
   "texto": "cárští výplatníci,"
  },
  {
   "texto": "přistrojili pro příhodu"
  },
  {
   "texto": "dubovou lavici."
  },
  {
   "texto": "A na rovině před trůnem"
  },
  {
   "texto": "skroušeně a tiše"
  },
  {
   "texto": "petenti, věrní poddaní,"
  },
  {
   "texto": "leželi na břiše."
  },
  {
   "texto": "Tenkrát byla audience"
  },
  {
   "texto": "nad obyčej hlučná,"
  },
  {
   "texto": "neb se z celé ruské říše"
  },
  {
   "texto": "sešla církev tučná."
  },
  {
   "texto": "Totiž popi, diakoni,"
  },
  {
   "texto": "kantoři, zvoníci,"
  },
  {
   "texto": "biskupi, svíčkové báby,"
  },
  {
   "texto": "také kostelníci."
  },
  {
   "texto": "S nimi ostatní drabanti,"
  },
  {
   "texto": "hrobaři, kalkanti,"
  },
  {
   "texto": "zpěváci a muzikanti,"
  },
  {
   "texto": "kluci ministranti. —"
  },
  {
   "texto": "Sotva dal tambor znamení,"
  },
  {
   "texto": "tak jak se to sluší,"
  },
  {
   "texto": "že cár ráčil otevříti"
  },
  {
   "texto": "Své Vysoké uši:"
  },
  {
   "texto": "všichni boží služebníci"
  },
  {
   "texto": "spustili moldánky,"
  },
  {
   "texto": "vzdychali a naříkali"
  },
  {
   "texto": "jak staré cikánky."
  },
  {
   "texto": "Totiž popi, diakoni,"
  },
  {
   "texto": "kantoři, zvoníci,"
  },
  {
   "texto": "biskupi, svíčkové báby,"
  },
  {
   "texto": "také kostelníci;"
  },
  {
   "texto": "s nimi ostatní drabanti,"
  },
  {
   "texto": "hrobaři, kalkanti,"
  },
  {
   "texto": "zpěváci a muzikanti,"
  },
  {
   "texto": "kluci ministranti."
  },
  {
   "texto": "„Co vám chybí?“ táže se cár"
  },
  {
   "texto": "pod svým baldachýnem,"
  },
  {
   "texto": "oni všichni jedním hrdlem:"
  },
  {
   "texto": "„Hynem, pane, hynem!“"
  },
  {
   "texto": "Celé popstvo předstoupilo"
  },
  {
   "texto": "k cáru s deputací,"
  },
  {
   "texto": "jeden držel ve jménu všech"
  },
  {
   "texto": "takovou orací:"
  },
  {
   "texto": "„Veliký jest Vladimír cár!"
  },
  {
   "texto": "svatá vůle jeho;"
  },
  {
   "texto": "když’s nám zabil pána boha,"
  },
  {
   "texto": "opatř nám jiného!"
  },
  {
   "texto": "Nám je pánbůh jako pánbůh,"
  },
  {
   "texto": "jenom když je ňáký,"
  },
  {
   "texto": "abychom s ním udrželi"
  },
  {
   "texto": "v respektu sedláky."
  },
  {
   "texto": "U těch bude všechna kázeň"
  },
  {
   "texto": "brzy dým a pára,"
  },
  {
   "texto": "nebudou se mít u koho"
  },
  {
   "texto": "modliti za cára."
  },
  {
   "texto": "Někdo musí nad sedláky"
  },
  {
   "texto": "rachotiti hromem:"
  },
  {
   "texto": "bez boha neobstojíme,"
  },
  {
   "texto": "jen jiného honem!“"
  },
  {
   "texto": "Toť se ví, že způsobila"
  },
  {
   "texto": "ta argumentace"
  },
  {
   "texto": "v Jeho cárském Veličenstvu"
  },
  {
   "texto": "velké alterace."
  },
  {
   "texto": "Mělť jak všichni potentáti"
  },
  {
   "texto": "srdce měkké tuze,"
  },
  {
   "texto": "nebyl by mohl, chudinka,"
  },
  {
   "texto": "zabít ani kuře:"
  },
  {
   "texto": "„Milostivé vám, mí věrní!"
  },
  {
   "texto": "dávám propuštění:"
  },
  {
   "texto": "vaši žádost hodlám vzíti"
  },
  {
   "texto": "v zralé uvážení!“"
  },
  {
   "texto": "Zpěv VII. — Ministerská rada"
  },
  {
   "texto": "Večír ministři seděli"
  },
  {
   "texto": "v tajném kabinetě,"
  },
  {
   "texto": "tenkrát byl bůh proti zvyku"
  },
  {
   "texto": "první na tapetě."
  },
  {
   "texto": "V hlavní věci byli všichni"
  },
  {
   "texto": "stejného mínění:"
  },
  {
   "texto": "bez boha se sprostým lidem"
  },
  {
   "texto": "není k vydržení."
  },
  {
   "texto": "Ale v dalších podrobnostech"
  },
  {
   "texto": "tu mezi dvořany"
  },
  {
   "texto": "byly jako skoro všude"
  },
  {
   "texto": "dvě rozličné strany."
  },
  {
   "texto": "Nová škola chce jen vždycky"
  },
  {
   "texto": "licitace s pachtem;"
  },
  {
   "texto": "stará škola zase chválí"
  },
  {
   "texto": "služby s deputátem."
  },
  {
   "texto": "Pan ministr vnitřních věcí"
  },
  {
   "texto": "pravil: „Páni bratři!"
  },
  {
   "texto": "Ohlašme konkurs v novinách,"
  },
  {
   "texto": "tak jak se to patří."
  },
  {
   "texto": "Ať se náležitou cestou"
  },
  {
   "texto": "hlásí kandidáti,"
  },
  {
   "texto": "pak si dle kvalifikace"
  },
  {
   "texto": "může cár vybrati.“"
  },
  {
   "texto": "Zahraniční ministr prál:"
  },
  {
   "texto": "že by dobře bylo,"
  },
  {
   "texto": "kdyby se to v cizích listech"
  },
  {
   "texto": "taky ohlásilo."
  },
  {
   "texto": "Neboť beztoho že není"
  },
  {
   "texto": "při tom obsazení"
  },
  {
   "texto": "na žádného domácího"
  },
  {
   "texto": "ani pomyšlení."
  },
  {
   "texto": "„Jenom žádného nováčka!"
  },
  {
   "texto": "Vždyť jest starších dosti,"
  },
  {
   "texto": "dobře renomírovaných,"
  },
  {
   "texto": "zvláště v praktičnosti."
  },
  {
   "texto": "Též se nesmí pro čest země"
  },
  {
   "texto": "na pár rublů hledět,"
  },
  {
   "texto": "když již jednou o tom budou"
  },
  {
   "texto": "cizozemci vědět.“"
  },
  {
   "texto": "Ale finanční ministři"
  },
  {
   "texto": "špinavá jsou nace,"
  },
  {
   "texto": "ten chtěl, aby se veřejná"
  },
  {
   "texto": "svedla licitace."
  },
  {
   "texto": "A kdo bude ze všech nejmíň"
  },
  {
   "texto": "za svou práci žádat,"
  },
  {
   "texto": "tomu se má bez ohledu"
  },
  {
   "texto": "tato služba zadat."
  },
  {
   "texto": "Vymínit si však, že z chrámů"
  },
  {
   "texto": "všechno stříbro, zlato"
  },
  {
   "texto": "bude vždy v pádu potřeby"
  },
  {
   "texto": "do mincovny vzato."
  },
  {
   "texto": "Pak ať drží kurs papírů"
  },
  {
   "texto": "vždy aspoň al’ pari —"
  },
  {
   "texto": "to je hlavní a ostatek"
  },
  {
   "texto": "všechno láry fáry. —"
  },
  {
   "texto": "Staveb ministr připomněl,"
  },
  {
   "texto": "by si pospíšili"
  },
  {
   "texto": "a zatím něco klášterů"
  },
  {
   "texto": "v kasárny změnili,"
  },
  {
   "texto": "než se místo zas obsadí;"
  },
  {
   "texto": "aby takto cáru"
  },
  {
   "texto": "aspoň něco zas přirostlo"
  },
  {
   "texto": "v tom interkaláru."
  },
  {
   "texto": "Pan ministr práv přisadil:"
  },
  {
   "texto": "„Moje jest výminka,"
  },
  {
   "texto": "by se veřejně v novinách"
  },
  {
   "texto": "o tom stala zmínka,"
  },
  {
   "texto": "že se nový bůh kontraktně"
  },
  {
   "texto": "zavazuje k tomu,"
  },
  {
   "texto": "každou falešnou přísahu"
  },
  {
   "texto": "trestat porcí hromu."
  },
  {
   "texto": "Neb se teď již každý všivák"
  },
  {
   "texto": "řídit chce dle cára,"
  },
  {
   "texto": "lhát, přísahat a dělat si"
  },
  {
   "texto": "ze soudů kašpara!“"
  },
  {
   "texto": "Ministr osvěty divný"
  },
  {
   "texto": "plán měl pohotově,"
  },
  {
   "texto": "aby se ta božská živnost"
  },
  {
   "texto": "ponechala vdově."
  },
  {
   "texto": "Že si může na svou ruku"
  },
  {
   "texto": "přibrat tovaryše,"
  },
  {
   "texto": "šikovného jezovitu"
  },
  {
   "texto": "anebo derviše."
  },
  {
   "texto": "Že to bude lacinější"
  },
  {
   "texto": "a v dobrém pořádku,"
  },
  {
   "texto": "neb on sám že jim přispěje"
  },
  {
   "texto": "radou na počátku. —"
  },
  {
   "texto": "Přitom však byl potutelné"
  },
  {
   "texto": "církevní plemeno,"
  },
  {
   "texto": "myslil, že to sám povede"
  },
  {
   "texto": "na vdovino jméno."
  },
  {
   "texto": "Ministr vojenský pravil:"
  },
  {
   "texto": "„Co dovede bůže,"
  },
  {
   "texto": "každý starý generál to"
  },
  {
   "texto": "taky zastat může."
  },
  {
   "texto": "Zvyklý na subordinací"
  },
  {
   "texto": "bude cára ctíti,"
  },
  {
   "texto": "eráru se může přitom"
  },
  {
   "texto": "pense ušetřiti."
  },
  {
   "texto": "Ze všech nejlíp by to trefil"
  },
  {
   "texto": "maršál Komispetr,"
  },
  {
   "texto": "pouštět hrůzu na sedláky,"
  },
  {
   "texto": "na to on je metr."
  },
  {
   "texto": "Pro jistotu se mu může"
  },
  {
   "texto": "ňáký literatus,"
  },
  {
   "texto": "chlapík v peře vycvičený,"
  },
  {
   "texto": "přidati ad latus."
  },
  {
   "texto": "Tak přivedem kněžstvo s vojskem"
  },
  {
   "texto": "k jednomu komandu,"
  },
  {
   "texto": "zorganisujeme přísněj"
  },
  {
   "texto": "tu církevní bandu.“ —"
  },
  {
   "texto": "Pan ministr policejní"
  },
  {
   "texto": "beze všeho křiku"
  },
  {
   "texto": "podal písemně své votum"
  },
  {
   "texto": "v zavřeném paklíku."
  },
  {
   "texto": "Policie jako kočky"
  },
  {
   "texto": "ráda potmě chodí,"
  },
  {
   "texto": "v jasném světle veřejnosti"
  },
  {
   "texto": "nerada se brodí."
  },
  {
   "texto": "Ač své votum zapečetil,"
  },
  {
   "texto": "přece bych se vsadil,"
  },
  {
   "texto": "že uhodnu, co on asi"
  },
  {
   "texto": "tajně cáru radil."
  },
  {
   "texto": "Jistě zpověď, jezovity,"
  },
  {
   "texto": "očistec, latinu,"
  },
  {
   "texto": "pokoru a trpělivost"
  },
  {
   "texto": "při chlebě a vínu;"
  },
  {
   "texto": "kousek nebe na udici,"
  },
  {
   "texto": "pár volavých svatých,"
  },
  {
   "texto": "všechna moc pochází s hůry,"
  },
  {
   "texto": "pluk čertů rohatých."
  }
 ]
}