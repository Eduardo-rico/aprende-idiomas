{
 "id": "cech-lesetinsky-kovar-c06",
 "titulo": "Zpěv XII.-XVI.",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Le%C5%A1et%C3%ADnsk%C3%BD_kov%C3%A1%C5%99/XII.",
 "fuente": "cs.wikisource.org, «Lešetínský kovář»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (viděti, slyšeti, žíti: 3 formas frente a 3 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-lesetinsky-kovar",
  "titulo": "Lešetínský kovář",
  "orden": 6
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XII."
  },
  {
   "texto": "Div divoucí! V rudém jase"
  },
  {
   "texto": "kovárna se svítí zase,"
  },
  {
   "texto": "kladiv buch"
  },
  {
   "texto": "probouzí tam dávný ruch."
  },
  {
   "texto": "Jarý plamen vyšlehává"
  },
  {
   "texto": "na ohništi čadivém,"
  },
  {
   "texto": "v jeho svitu kovář mává"
  },
  {
   "texto": "vysoko svým kladivem;"
  },
  {
   "texto": "perlík buší,"
  },
  {
   "texto": "padá bleskem,"
  },
  {
   "texto": "rádlo kruší"
  },
  {
   "texto": "temným třeskem"
  },
  {
   "texto": "v dešti jisker ohnivém."
  },
  {
   "texto": "Padá perlík ranou hromu,"
  },
  {
   "texto": "kovář notuje si k tomu:"
  },
  {
   "texto": "Jasně zvuč,"
  },
  {
   "texto": "perlíku můj, buš a tluč!"
  },
  {
   "texto": "Překovej mi toto rádlo,"
  },
  {
   "texto": "překovej mi tento hřeb,"
  },
  {
   "texto": "aby rámě ostřím vládlo,"
  },
  {
   "texto": "aby svištěl smrtný tep;"
  },
  {
   "texto": "v záři rudé"
  },
  {
   "texto": "lítej bleskem"
  },
  {
   "texto": "zle až bude,"
  },
  {
   "texto": "padni třeskem"
  },
  {
   "texto": "v nepřítele kletou leb!"
  },
  {
   "texto": "Na mém právu, půdě mojí"
  },
  {
   "texto": "žulou noha moje stojí,"
  },
  {
   "texto": "od těch dvou"
  },
  {
   "texto": "mrtvého jen odervou!"
  },
  {
   "texto": "Nech svět celý: Vzdej se! volá,"
  },
  {
   "texto": "kovář hlavou zavrtí,"
  },
  {
   "texto": "ďábel sám jej neudolá —"
  },
  {
   "texto": "Zde jsem, budu do smrti!"
  },
  {
   "texto": "Kdyby mdlelo"
  },
  {
   "texto": "chabým steskem,"
  },
  {
   "texto": "spíš to čelo"
  },
  {
   "texto": "rázným třeskem"
  },
  {
   "texto": "kladivo mé rozdrtí!"
  },
  {
   "texto": "Užil’s dosti dlouho klidu"
  },
  {
   "texto": "v posměch cizáckému lidu —"
  },
  {
   "texto": "chutě zas,"
  },
  {
   "texto": "perlíku můj, ráz na ráz!"
  },
  {
   "texto": "Jiného-li nemáš, zbraně"
  },
  {
   "texto": "na odvetu aspoň kuj!"
  },
  {
   "texto": "Snad se najdou k nim též dlaně —"
  },
  {
   "texto": "Ne-li, ty jen při mně stůj!"
  },
  {
   "texto": "Bij v tu rotu"
  },
  {
   "texto": "božím bleskem,"
  },
  {
   "texto": "pomsty notu"
  },
  {
   "texto": "smrtným třeskem"
  },
  {
   "texto": "naposled mi zahromuj!"
  },
  {
   "texto": "XIII."
  },
  {
   "texto": "„Vzdoru konec, mistře! Vari ztad!"
  },
  {
   "texto": "Hle! tu listina, jež mocí práva"
  },
  {
   "texto": "pánu mému všechno odevzdává:"
  },
  {
   "texto": "kovárnu i chatu, role, sad;"
  },
  {
   "texto": "jeho již ten práh i tyto stěny."
  },
  {
   "texto": "Soudu vyslance po boku mám,"
  },
  {
   "texto": "k ochraně i průvod ozbrojený —"
  },
  {
   "texto": "Zmoudřete a dejte průchod nám!“"
  },
  {
   "texto": "Mistr, stoje před kovárny prahem,"
  },
  {
   "texto": "vyslal na správce dva blesky zlobné"
  },
  {
   "texto": "z temných řas a náhlým ruky vzpřahem"
  },
  {
   "texto": "list mu vyškub’, trhal v kousky drobné,"
  },
  {
   "texto": "že kol něho útržky té běli"
  },
  {
   "texto": "jak roj bělásků se větrem chvěly."
  },
  {
   "texto": "A hlas jeho duněl: „Hle! tu dává"
  },
  {
   "texto": "ruka moje větrům vaše práva,"
  },
  {
   "texto": "mrzce zakoupená lesklým kovem,"
  },
  {
   "texto": "spečetěná křivých svědků slovem."
  },
  {
   "texto": "Mou jest tato půda! pravím vám."
  },
  {
   "texto": "Mějte si těch cárů na tisíce,"
  },
  {
   "texto": "bodáků než jehel v boru více,"
  },
  {
   "texto": "já své právo čisté, svaté mám,"
  },
  {
   "texto": "zapsané v tu půdu péčí hrotem,"
  },
  {
   "texto": "rukou mozolnou a čela potem,"
  },
  {
   "texto": "mám ta prsa, pevné srdce v nich,"
  },
  {
   "texto": "touhou tuto leb, tu ruku zdravou,"
  },
  {
   "texto": "mám ten perlík svůj a nade hlavou"
  },
  {
   "texto": "nejvyššího soudce v nebesích!“"
  },
  {
   "texto": "„Jménem zákona!“"
  },
  {
   "texto": "„Co po zákonu!“"
  },
  {
   "texto": "zvolal Prokop, vyšed odhodlaně"
  },
  {
   "texto": "z postav bědných hlučivého shonu."
  },
  {
   "texto": "„Právo na mistrově stojí straně."
  },
  {
   "texto": "Kovárny té zachtělo se pánu —"
  },
  {
   "texto": "to váš zákon. Má-li jediný"
  },
  {
   "texto": "hltoun všechno mít?! Je vládcem lánů,"
  },
  {
   "texto": "luk a lesů, celé dědiny,"
  },
  {
   "texto": "jemu všecka dolina již patří,"
  },
  {
   "texto": "jemu slouží bídně za podnoží"
  },
  {
   "texto": "na sta otroků nás — Blesky boží!“"
  },
  {
   "texto": "„Vari, chlape!“"
  },
  {
   "texto": "„Zůstanu! Hej, bratři!“"
  },
  {
   "texto": "A v mih příští viděti jen kupu"
  },
  {
   "texto": "lidí zmotanou, kde všechno s jekem"
  },
  {
   "texto": "strká se a sráží, sálá vztekem —"
  },
  {
   "texto": "Tu: „Jsem raněn!“ výkřik ze zástupu —"
  },
  {
   "texto": "„Krev!“ hřmí Prokop, „naše krev již teče!"
  },
  {
   "texto": "Krev tu pomstíme! Ať zahynou!“"
  },
  {
   "texto": "Zděšen prchá správce s družinou,"
  },
  {
   "texto": "za nimi dav pádí, zlobou ječe."
  },
  {
   "texto": "S lící mrtvoly a s okem běsa"
  },
  {
   "texto": "Józa z kovárny se řítí, nesa"
  },
  {
   "texto": "plnou náruč zbraní rozmanitých"
  },
  {
   "texto": "podivného nestvůrného zjevu,"
  },
  {
   "texto": "z okovaných dřev a hřebů vbitých,"
  },
  {
   "texto": "jež kul mistr v šíleném svém hněvu."
  },
  {
   "texto": "Józa v dav je metá na vše strany"
  },
  {
   "texto": "a hlas jeho řičí: „Bijme, palme!"
  },
  {
   "texto": "Vzhůru do továrny! na tyrany!"
  },
  {
   "texto": "Všechno do prachu a trosek svalme!“"
  },
  {
   "texto": "Takto někdy přichází bouř’ náhlá;"
  },
  {
   "texto": "niva teskně dřímá, vedrem zprahlá,"
  },
  {
   "texto": "když tu vítr na vzduchovém oři"
  },
  {
   "texto": "rázem přicválá a po všem kraji"
  },
  {
   "texto": "vztekle burácí, že pod ním hrají"
  },
  {
   "texto": "klasy zmítané jak vlny v moři,"
  },
  {
   "texto": "šumně tetelí se vršky stromů,"
  },
  {
   "texto": "prach a lístí prohání se vírem"
  },
  {
   "texto": "v mocných kotoučích, tma v luhu šírém,"
  },
  {
   "texto": "kmitne blesk a třeskne rachot hromu:"
  },
  {
   "texto": "Tak zde vášeň ztýraného lidu, —"
  },
  {
   "texto": "lidu s otčinou a řečí různou,"
  },
  {
   "texto": "spjatého běd stejných páskou hrůznou —"
  },
  {
   "texto": "šlehla rázem z ponurého klidu,"
  },
  {
   "texto": "vyvřela tu v děsném pomsty jeku"
  },
  {
   "texto": "výheň dlouho utlumených vzteků"
  },
  {
   "texto": "a vše naplnila kolkolem"
  },
  {
   "texto": "třeskem, rykem, kletbami a stony,"
  },
  {
   "texto": "vřavou pustou, do níž chrámu zvony"
  },
  {
   "texto": "v poplach bily kvilným hlaholem."
  },
  {
   "texto": "Na práh kovárny zář divná padá:"
  },
  {
   "texto": "zlatem řeřavým a nachem spolu"
  },
  {
   "texto": "barví jej a růžnou aureolu"
  },
  {
   "texto": "Lidunce kol jasných vlasů spřádá,"
  },
  {
   "texto": "kteráž k otci úskostně se tulí"
  },
  {
   "texto": "noříc pohled, hrůzou ustrnulý,"
  },
  {
   "texto": "v oněch svitů děsný zdroj. To svítí"
  },
  {
   "texto": "stavba ohromná, v luh září dálný,"
  },
  {
   "texto": "z lítých žárů, jakby koráb valný"
  },
  {
   "texto": "ve plamenném tonul vlnobití,"
  },
  {
   "texto": "jisker déšť jak prašná pěna žhavá"
  },
  {
   "texto": "srší v dýmu mračna červenavá"
  },
  {
   "texto": "a z té spousty divě trčí vzhůru,"
  },
  {
   "texto": "všecek záře nachovými svity,"
  },
  {
   "texto": "komín titán v oblak zrudlou chmuru"
  },
  {
   "texto": "jako zářný maják obrovitý."
  },
  {
   "texto": "Kovář zašeptal: „To jejich dílo!"
  },
  {
   "texto": "Já jen ubránil, co moje bylo!“"
  },
  {
   "texto": "XIV."
  },
  {
   "texto": "Buben duní, bodáky se blyští,"
  },
  {
   "texto": "pušky rachotí, vzdor slabý tříští, —"
  },
  {
   "texto": "padli, prchli, ostatek se vzdává —"
  },
  {
   "texto": "soudci kyne čas a hrobaři —"
  },
  {
   "texto": "Zdeptala vše vítězná moc práva —"
  },
  {
   "texto": "pouta řinčí — — Vzdej se, kováři!"
  },
  {
   "texto": "Kovář sedí na své kovadlině,"
  },
  {
   "texto": "čelo v ruce, perlík chová v klíně,"
  },
  {
   "texto": "bez pohnutí jakby tesán z žuly."
  },
  {
   "texto": "Marně Liduška se k němu tulí"
  },
  {
   "texto": "s úpěnlivou prosbou, soused kárá,"
  },
  {
   "texto": "že čas příhodný se promaří —"
  },
  {
   "texto": "tudy oknem! — hustá jitřní pára"
  },
  {
   "texto": "ukryje tě — Prchni, kováři!"
  },
  {
   "texto": "Mistr vstává, ku práhu se bere:"
  },
  {
   "texto": "bodáky již svítí v mlze šeré,"
  },
  {
   "texto": "slyšeti již povel, řinkot zbraně…"
  },
  {
   "texto": "Kovář jímá perlík v obě dlaně,"
  },
  {
   "texto": "povznáší jej s jiskřícím se okem,"
  },
  {
   "texto": "smrtí pohrdu má na tváři — —"
  },
  {
   "texto": "Vojska řad již odměřeným krokem"
  },
  {
   "texto": "míří k němu: „Vzdej se, kováři!“"
  },
  {
   "texto": "Střásl dívku, jež kol něho vila"
  },
  {
   "texto": "s nářkem ruce, odstrčil ji mocí."
  },
  {
   "texto": "Postat obrovská se vytýčila,"
  },
  {
   "texto": "bleskly oči svislých vlasů nocí —"
  },
  {
   "texto": "„Nepoddám se!“ křik’… „to půda moje!"
  },
  {
   "texto": "Nikdo tu mé právo nezmaří!“"
  },
  {
   "texto": "Napřáhl jak děsný démon boje"
  },
  {
   "texto": "kladivo své — — Běda, kováři!"
  },
  {
   "texto": "Rozlehl se náhle výstřel hromný,"
  },
  {
   "texto": "pád a dívčí výkřik srdcelomný;"
  },
  {
   "texto": "dýmu oblak modravý se vznesl —"
  },
  {
   "texto": "perlík padl, kovář k němu klesl,"
  },
  {
   "texto": "krev mu z prsou valem vyřinula,"
  },
  {
   "texto": "nazad obličej se sklonil siný"
  },
  {
   "texto": "a jak na podušce spočinula"
  },
  {
   "texto": "mroucí hlava v lemu kovadliny."
  },
  {
   "texto": "XV."
  },
  {
   "texto": "Lešetínské zvony slyšet valné hony,"
  },
  {
   "texto": "přes pole a háje zní ten svatý hlas,"
  },
  {
   "texto": "hlaholí tak jasně, hlaholí tak krásně —"
  },
  {
   "texto": "Brzy uslyším vás, milé zvony, zas!"
  },
  {
   "texto": "Když jsem v cizí straně do ztýrané dlaně"
  },
  {
   "texto": "skládal čelo, péčí těžkou schýlené,"
  },
  {
   "texto": "často k duši zprahlé zavanul mi náhle"
  },
  {
   "texto": "stříbrný váš hlahol, zvony milené!"
  },
  {
   "texto": "A ten vanot sladký zanesl mne zpátky"
  },
  {
   "texto": "mezi rodné hory, v tiché údolí,"
  },
  {
   "texto": "kde mi věží rudou nad vesnicí chudou"
  },
  {
   "texto": "kynul známý kostel mezi topoly."
  },
  {
   "texto": "Zjevila se letem pod jabloně květem"
  },
  {
   "texto": "kovárna ta stará, chaty okénka, —"
  },
  {
   "texto": "křišťálem se třpytí, v nich se směje kvítí,"
  },
  {
   "texto": "vyhlédá jak růže krásná dívenka…"
  },
  {
   "texto": "Tu vždy nová síla do paží se vlila,"
  },
  {
   "texto": "vzchopily se opět, ráz tu stíhal ráz,"
  },
  {
   "texto": "a v tom kladiv hřmotu jako rajskou notu"
  },
  {
   "texto": "s nadějí jsem sladkou, zvony, slýchal vás!"
  },
  {
   "texto": "Konec krušné píle, dosáhl jsem cíle,"
  },
  {
   "texto": "brzy rodnou vísku opět pozdravím."
  },
  {
   "texto": "Bystře noha kráčí — kéž mám křídla ptačí,"
  },
  {
   "texto": "abych doletěl k těm horám modravým!"
  },
  {
   "texto": "Zda jsi pro mne lkala, věrnost zachovala,"
  },
  {
   "texto": "kterous pod jabloní tenkrát slíbila?"
  },
  {
   "texto": "V radosti a plesu prstýnek ti nesu,"
  },
  {
   "texto": "choval jsem ho věrně, dívko rozmilá."
  },
  {
   "texto": "Na ruku prstýnek, z rozmariny vínek"
  },
  {
   "texto": "přináším ti, drahá, na heboučký vlas;"
  },
  {
   "texto": "šťastnou ruku dvojí na čas věčný spojí"
  },
  {
   "texto": "Lešetínských zvonů jasný, krásný hlas!"
  },
  {
   "texto": "XVI."
  },
  {
   "texto": "Leží kovář, zůstaven již skonu,"
  },
  {
   "texto": "v kovárně pod výhní plápolavou,"
  },
  {
   "texto": "o kovadla podnož opřen hlavou"
  },
  {
   "texto": "jako král o pelesť svého trónu."
  },
  {
   "texto": "V dílně své, kde dlíval nejraději,"
  },
  {
   "texto": "v záři veselé z dob slávy její"
  },
  {
   "texto": "přál si zemřít — vůli jemu dali;"
  },
  {
   "texto": "měkké mu jen lože podestlali."
  },
  {
   "texto": "Kolem prsou mohutných se vine"
  },
  {
   "texto": "šírý obvazek; jej slza smáčí,"
  },
  {
   "texto": "která z oček Lidunčiných řine"
  },
  {
   "texto": "k němu bez ustání v hořkém pláči."
  },
  {
   "texto": "Časem dívka usedavě štkajíc,"
  },
  {
   "texto": "k šíjí mroucího svou tulí ruku"
  },
  {
   "texto": "a líc k jeho prsům, naslouchajíc"
  },
  {
   "texto": "v posled srdce laskavého tluku."
  },
  {
   "texto": "Stranou Brázda s pochýlenou hlavou"
  },
  {
   "texto": "mžiká oček řasou třepetavou,"
  },
  {
   "texto": "z nížto chvilkou krůpěj vláhy třpytné"
  },
  {
   "texto": "sprchne na kožich a tam se kmitne"
  },
  {
   "texto": "lemu kosmatinou řídkou, plavou"
  },
  {
   "texto": "jako perla rosy suchou travou."
  },
  {
   "texto": "Slyš! tu kroky — zaskřípnuly dvéře — —"
  },
  {
   "texto": "„Václav!“"
