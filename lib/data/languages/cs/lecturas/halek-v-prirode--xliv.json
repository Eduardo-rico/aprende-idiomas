 "modo": "texto",
 "parrafos": [
  {
   "texto": "XLIV."
  },
  {
   "texto": "Já přišel po stech letech k hrobu,"
  },
  {
   "texto": "jenž býval někdy hrobem mým,"
  },
  {
   "texto": "a hrobník zpívaje mou píseň,"
  },
  {
   "texto": "mé kosti házel k ostatním."
  },
  {
   "texto": "„Hrobníku, najdi mi to srdce,"
  },
  {
   "texto": "z něhož jsi tuto píseň vzal!“"
  },
  {
   "texto": "A hrobník divil se a hledal,"
  },
  {
   "texto": "krom kostí však nic neshledal."
  },
  {
   "texto": "Pak z hrobu vztýčil se a mluvil:"
  },
  {
   "texto": "„To u nás, pane, neplatí;"
  },
  {
   "texto": "mějte si srdcí třeba deset,"
  },
  {
   "texto": "hrob hejřil je, vše utratí!“"
  },
  {
   "texto": "A dokopal a já si vzdychnul:"
  },
  {
   "texto": "„Tam, srdce mé, jsi dospělo!“"
  },
  {
   "texto": "A hrobník jako na útěchu:"
  },
  {
   "texto": "„To se vším tak, co vyznělo!“"
  },
  {
   "texto": "Přec zdá se mi, až hrob můj zvrácen"
  },
  {
   "texto": "i v lidské spustne paměti,"
  },
  {
   "texto": "že poznají ho jarní ptáci"
  },
  {
   "texto": "a zpěvem svým ho posvětí."
  },
  {
   "texto": "Že poznají ho zlaté hvězdy,"
  },
  {
   "texto": "a luna s nebes postropí"
  },
  {
   "texto": "že jej v své lásce snivotklivé"
  },
  {
   "texto": "rosou i leskem pokropí."
  },
  {
   "texto": "Ba zdá se mi, že duše hájů"
  },
  {
   "texto": "nepustí ptáky z náruče,"
  },
  {
   "texto": "až slavíček, to srdce lesa,"
  },
  {
   "texto": "si při mém srdci zatluče."
  },
  {
   "texto": "Vždyť nemůž být, by zapomněly"
  },
  {
   "texto": "znát přítele a skládače,"
  },
  {
   "texto": "jenž žití své a vše z nich čerpal,"
  },
  {
   "texto": "čím v slast se píseň rozpláče."
  },
  {
   "texto": "Vždy slýchám: lidé básně skládají,"
  },
  {
   "texto": "a jiní čtou je nábožně;"
  },
  {
   "texto": "já časem také kamsi zajdu,"
  },
  {
   "texto": "však tam si vedou zámožně."
  },
  {
   "texto": "Jen zasednu a již tu počne háj,"
  },
  {
   "texto": "šumí jen nápěv úvodní —"
  },
  {
   "texto": "ej jaká řeč, jaká to skladba,"
  },
  {
   "texto": "tak ryzí a tak původní!"
  },
  {
   "texto": "Jaké to myšlénky a jaký vzlet —"
  },
  {
   "texto": "tak mocný a tak pravdivý,"
  },
  {
   "texto": "až rozkoší se srdce chvěje,"
  },
  {
   "texto": "a každou žilku oživí."
  },
  {
   "texto": "Jak zvučný rytmus a jaký to rým,"
  },
  {
   "texto": "jak mistrné to obraty,"
  },
  {
   "texto": "jak zdravé názory to světa,"
  },
  {
   "texto": "tak procítěny, prohřáty!"
  },
  {
   "texto": "A forma, libozvuk a jemný vkus"
  },
  {
   "texto": "a soulad — věta od věty —"
  },
  {
   "texto": "ó, kde jest která větší báseň,"
  },
  {
   "texto": "a většího kde poety!"
  },
  {
   "texto": "Nechť věci vážím jakkoliv,"
  },
  {
   "texto": "jichž soud nám zraje v mysli chvatné,"
  },
  {
   "texto": "ten zdá se soudů býti soud:"
  },
  {
   "texto": "co proti přírodě, že špatné."
  },
  {
   "texto": "A špatné, byť i marnivost"
  },
  {
   "texto": "to na cnost světila i víru,"
  },
  {
   "texto": "a byť i sluh ochotný dav"
  },
  {
   "texto": "to spásou hlásal všehomíru."
  },
  {
   "texto": "A špatné, byť i knížat sbor"
  },
  {
   "texto": "co své se tomu kořil modle,"
  },
  {
   "texto": "a jmeno z ní a slávu bral,"
  },
  {
   "texto": "kdy lidství své zašlápnul podle."
  },
  {
   "texto": "Ba špatné, byť se věkové"
  },
  {
   "texto": "tím táceli jak vínem zvratným:"
  },
  {
   "texto": "jeť víc než matkou příroda —"
  },
  {
   "texto": "a není syn, kdo synem špatným."
  }
 ]
}