 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Otrokem jsem zplozen…"
  },
  {
   "texto": "Otrokem jsem zplozen,"
  },
  {
   "texto": "otrokyní zrozen,"
  },
  {
   "texto": "kolébavkou býval"
  },
  {
   "texto": "děcku pouta chřest,"
  },
  {
   "texto": "po můj život celý"
  },
  {
   "texto": "okov zrezavělý"
  },
  {
   "texto": "z jitra k noci zníval"
  },
  {
   "texto": "pustinou mých cest."
  },
  {
   "texto": "Sotva junou sílu"
  },
  {
   "texto": "ucítil jsem v týlu,"
  },
  {
   "texto": "už mi šíje spjata"
  },
  {
   "texto": "ocelovým jhem,"
  },
  {
   "texto": "učil jsem se shýbat"
  },
  {
   "texto": "nízko vaz a líbat"
  },
  {
   "texto": "důtky svého kata,"
  },
  {
   "texto": "čelem bíti zem."
  },
  {
   "texto": "Rost’ jsem, otrok chabý,"
  },
  {
   "texto": "mezi bratry raby,"
  },
  {
   "texto": "za šperk okov zvonil"
  },
  {
   "texto": "sestrám u boků,"
  },
  {
   "texto": "a kam zřel jsem kolem"
  },
  {
   "texto": "s hanbou, hněvem, bolem,"
  },
  {
   "texto": "do prachu leb klonil"
  },
  {
   "texto": "národ otroků."
  },
  {
   "texto": "Zlé jsem zvykal sudbě,"
  },
  {
   "texto": "drsné pouta hudbě,"
  },
  {
   "texto": "plašící z mé chaty"
  },
  {
   "texto": "všechen žití vděk;"
  },
  {
   "texto": "i když v bouřném citu"
  },
  {
   "texto": "sáh’ jsem po varitu,"
  },
  {
   "texto": "v moji píseň klatý"
  },
  {
   "texto": "zazněl pouta skřek."
  },
  {
   "texto": "A přec oko časem"
  },
  {
   "texto": "plachým svitlo jasem,"
  },
  {
   "texto": "napínal jsem ucho"
  },
  {
   "texto": "za les, za vody;"
  },
  {
   "texto": "mnil jsem, že tam kdesi"
  },
  {
   "texto": "jásá pod nebesy,"
  },
  {
   "texto": "letí v naše hlucho"
  },
  {
   "texto": "píseň svobody."
  },
  {
   "texto": "Ale jak se vznesla,"
  },
  {
   "texto": "hlava zase klesla,"
  },
  {
   "texto": "znova v hanbě, hoři"
  },
  {
   "texto": "rok šel za rokem —"
  },
  {
   "texto": "V šíji dosud jarmo"
  },
  {
   "texto": "a zrak čeká darmo"
  },
  {
   "texto": "vykoupení zoři —"
  },
  {
   "texto": "zemru otrokem!"
  },
  {
   "texto": "Již se vaz můj chýlí,"
  },
  {
   "texto": "na skráni vlas bílý,"
  },
  {
   "texto": "naděje už v temnou"
  },
  {
   "texto": "jeseň nekynou;"
  },
  {
   "texto": "vím, že ruce spjaté"
  },
  {
   "texto": "nestřesou jho klaté,"
  },
  {
   "texto": "že má pouta se mnou"
  },
  {
   "texto": "v hrobě spočinou."
  },
  {
   "texto": "Z moře večera dech vane,"
  },
  {
   "texto": "ochlazuje žhoucí vzduch,"
  },
  {
   "texto": "vršky palem rozhoupané"
  },
  {
   "texto": "oživuje divný ruch:"
  },
  {
   "texto": "smaragdové listů řasy"
  },
  {
   "texto": "šepotají tichou zvěst —"
  },
  {
   "texto": "Sbor otroků:"
  },
  {
   "texto": "Večerních to stínů hlasy,"
  },
  {
   "texto": "duchů tajný zpěv to jest."
  },
  {
   "texto": "Rozumím já listů šumu,"
  },
  {
   "texto": "ztlumočím vám duchů vzkaz,"
  },
  {
   "texto": "podvečerní palem dumu,"
  },
  {
   "texto": "pohroužených v zašlý čas,"
  },
  {
   "texto": "kdy háj tento ve svém stínu"
  },
  {
   "texto": "viděl volný národ kvést —"
  },
  {
   "texto": "Sbor otroků:"
  },
  {
   "texto": "Ach, to v šerém věků klínu,"
  },
  {
   "texto": "ach, to dávno, dávno jest."
  },
  {
   "texto": "Volnými jsme lidmi byli,"
  },
  {
   "texto": "patřila nám tato zem,"
  },
  {
   "texto": "pro sebe jsme ryli, sili,"
  },
  {
   "texto": "lán svůj střehli proti všem,"
  },
  {
   "texto": "vítězné jsme vedli války"
  },
  {
   "texto": "za svůj krb a za svou čest —"
  },
  {
   "texto": "Sbor otroků:"
  },
  {
   "texto": "Jako z nedozírné dálky"
  },
  {
   "texto": "matně ševelí ta zvěst."
  },
  {
   "texto": "Svoji vůli, svoje statky"
  },
  {
   "texto": "měli jsme i svoji čest,"
  },
  {
   "texto": "nežli našich myslí zmatky,"
  },
  {
   "texto": "naše viny stihl trest,"
  },
  {
   "texto": "nežli ve prach slávu naši"
  },
  {
   "texto": "strhla cizí pěst a lest — —"
  },
  {
   "texto": "Sbor otroků:"
  },
  {
   "texto": "Palem zkazku nyní plaší"
  },
  {
   "texto": "biče svist a pouta chřest."
  }
 ]
}