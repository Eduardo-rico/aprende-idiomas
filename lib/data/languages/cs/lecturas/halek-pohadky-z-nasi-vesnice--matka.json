 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Matka"
  },
  {
   "texto": "Jaký to k návsi hluk a sběh?"
  },
  {
   "texto": "Dráb, v hrsti dukáty, hlásí:"
  },
  {
   "texto": "„Náš Martin vojenský je zběh,"
  },
  {
   "texto": "to pány nelidsky kvasí."
  },
  {
   "texto": "Kdo z vás nám vydá ho chvatem,"
  },
  {
   "texto": "zde dlaň mu posázím zlatem.“"
  },
  {
   "texto": "Sto mužů náves obstoupí"
  },
  {
   "texto": "a tambor na buben tluče:"
  },
  {
   "texto": "„Než stanné právo nastoupí,"
  },
  {
   "texto": "kdo skryl jej, vydej ho ruče!“"
  },
  {
   "texto": "A voják patrony váží,"
  },
  {
   "texto": "dům k domu obsadí stráží."
  },
  {
   "texto": "Sto jezdců ves kol ohradí"
  },
  {
   "texto": "a trubač na troubu troubí:"
  },
  {
   "texto": "„Kde skryt je, kdo jej vyzradí,"
  },
  {
   "texto": "ves velké uchrání zhouby.“"
  },
  {
   "texto": "Sto jezdců s třemenů skokem,"
  },
  {
   "texto": "ves projdou pátravým krokem."
  },
  {
   "texto": "Vše marné; bubny udeří,"
  },
  {
   "texto": "v tom setník rozkaz dal nový:"
  },
  {
   "texto": "„Sem s jeho rodnou mateří,"
  },
  {
   "texto": "ta ví, ta nám o něm poví! —"
  },
  {
   "texto": "Tu vizte, ruce jak spíná —"
  },
  {
   "texto": "rci nám: kdes ukryla syna!“"
  },
  {
   "texto": "„Váš hněv mne stihne nevinnou,"
  },
  {
   "texto": "Což já vám ubohá zjevím!"
  },
  {
   "texto": "Mne mučte touto hodinou,"
  },
  {
   "texto": "já vím: že o synu nevím."
  },
  {
   "texto": "Však vědět, kde se vám schová,"
  },
  {
   "texto": "pak teprv nepovím slova."
  },
  {
   "texto": "Nač ruce vázat provazy,"
  },
  {
   "texto": "nač mne též ukrutně šlehat?"
  },
  {
   "texto": "Což platí matce rozkazy —"
  },
  {
   "texto": "když syn má ulicí běhat:"
  },
  {
   "texto": "jej matka do srdce schová,"
  },
  {
   "texto": "tam jest — dál nepovím slova!“"
  },
  {
   "texto": "Nic naplat, troubí k odchodu,"
  },
  {
   "texto": "jich bubny zavíří vztekem,"
  },
  {
   "texto": "dnes vytáhli sem v nehodu,"
  },
  {
   "texto": "teď v klení plýtvají vděkem."
  },
  {
   "texto": "Jen matka, trýzněná všemi,"
  },
  {
   "texto": "dnes ráj zří po celé zemi."
  },
  {
   "texto": "Koně spotil Matěj cestou,"
  },
  {
   "texto": "nese novinu —"
  },
  {
   "texto": "„Jedu světem za nevěstou,"
  },
  {
   "texto": "přes vrch, rovinu:"
  },
  {
   "texto": "král nám vadne, lékař radí"
  },
  {
   "texto": "paní rekovnou,"
  },
  {
   "texto": "ta, která se nejlíp vadí,"
  },
  {
   "texto": "bude královnou.“"
  },
  {
   "texto": "Každá hned se staví v líčku"
  },
  {
   "texto": "jako od medu:"
  },
  {
   "texto": "„Matějíčku, Matějíčku,"
  },
  {
   "texto": "já to dovedu.“"
  },
  {
   "texto": "Řeči pustí jako v strži,"
  },
  {
   "texto": "jedna přes druhou,"
  },
  {
   "texto": "večer už si Matěj drží"
  },
  {
   "texto": "hlavu nebohou."
  },
  {
   "texto": "Jak když vytáhnou se stavy,"
  },
  {
   "texto": "mlýn se rozmele,"
  },
  {
   "texto": "pan mlynář ho nezastaví"
  },
  {
   "texto": "po tři neděle:"
  },
  {
   "texto": "řeči tekou, spousty hrozí"
  },
  {
   "texto": "v okna, do stropu,"
  },
  {
   "texto": "zvony hučí — bohpomozi,"
  },
  {
   "texto": "máme potopu!"
  },
  {
   "texto": "Řeči rostou jako z kvasu,"
  },
  {
   "texto": "běda člověku!"
  },
  {
   "texto": "kdo má uši, nezná spásu"
  },
  {
   "texto": "leda v útěku."
  },
  {
   "texto": "Sám pan Matěj k hradu v dáli,"
  },
  {
   "texto": "přes vrch, roviny:"
  },
  {
   "texto": "„Pane králi, pane králi,"
  },
  {
   "texto": "zlé to noviny!“"
  },
  {
   "texto": "A tak každé zbyla po něm"
  },
  {
   "texto": "blahá naděje,"
  },
  {
   "texto": "uvidí-li krále s koněm,"
  },
  {
   "texto": "aneb Matěje:"
  },
  {
   "texto": "že rozhodne v snadném cviku"
  },
  {
   "texto": "volbu nerovnou —"
  },
  {
   "texto": "vždyť se cítí po jazyku"
  },
  {
   "texto": "každá královnou."
  }
 ]
}