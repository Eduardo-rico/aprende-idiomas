 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXI."
  },
  {
   "texto": "Babí léto, babí léto!"
  },
  {
   "texto": "Mládež zvrhla partesy,"
  },
  {
   "texto": "a tam kráčí na oddavky"
  },
  {
   "texto": "dýchavičné procesí."
  },
  {
   "texto": "Jeseň hrá si na nevěstu,"
  },
  {
   "texto": "hlavu samé strniště,"
  },
  {
   "texto": "ženich z lesa statný pavouk,"
  },
  {
   "texto": "nohy jako bičiště."
  },
  {
   "texto": "Jedou, jedou, z lesa jedou,"
  },
  {
   "texto": "bodlák zatáh’ u lučin,"
  },
  {
   "texto": "ženich platí samou pentlí"
  },
  {
   "texto": "z nastřádaných pavučin."
  },
  {
   "texto": "Jedou, jedou, z polí jedou,"
  },
  {
   "texto": "za kloboukem zvadlá nať,"
  },
  {
   "texto": "a družičky v cestu sypou"
  },
  {
   "texto": "žluté listí na souvrať."
  },
  {
   "texto": "Jedou, jedou, ke vsi jedou,"
  },
  {
   "texto": "parádní vůz převrhli:"
  },
  {
   "texto": "babí léto, babí léto —"
  },
  {
   "texto": "do vsi táhnou o berli."
  },
  {
   "texto": "V duši mé vždy jako v lese,"
  },
  {
   "texto": "a ten les též němý, bez řeči."
  },
  {
   "texto": "Zdaž i duše má v svou jeseň"
  },
  {
   "texto": "s písněmi se jednou odmlčí?"
  },
  {
   "texto": "Zdaž i listí moje blednouc"
  },
  {
   "texto": "počne padat sobě v úlevu,"
  },
  {
   "texto": "že i ptáčku, jenž to vidí,"
  },
  {
   "texto": "smutno, v odlet, jen ne do zpěvu?"
  },
  {
   "texto": "Zdaž mých sadů větev každá"
  },
  {
   "texto": "zapomene dávný jara dech,"
  },
  {
   "texto": "že jen zbude drsná, holá,"
  },
  {
   "texto": "větru v pláč a kavkám na posměch?"
  },
  {
   "texto": "Zdaž má píseň, jak ty stromy,"
  },
  {
   "texto": "chladnouc přikrčí se do mechu,"
  },
  {
   "texto": "že i tomu broučku zima,"
  },
  {
   "texto": "jenž v něm darmo hledal oddechu?"
  },
  {
   "texto": "Marné ptaní; vše to přijde,"
  },
  {
   "texto": "toť jen konec v samém počátku."
  },
  {
   "texto": "Přijdou i ty sněhy bílé"
  },
  {
   "texto": "zasypat mou lidem památku."
  },
  {
   "texto": "Kraj beze zvuku, sněhem kvete,"
  },
  {
   "texto": "svět velká sněhu lučina,"
  },
  {
   "texto": "v sněhu se černá nahé proutí,"
  },
  {
   "texto": "jím táhne sýkor družina."
  },
  {
   "texto": "To bludných sýkor sykotání"
  },
  {
   "texto": "mou duši smutkem proletí:"
  },
  {
   "texto": "to tedy vše, co na nás došlo"
  },
  {
   "texto": "z dob nejkraššího podletí!"
  },
  {
   "texto": "To tedy vše, co zbylo roku"
  },
  {
   "texto": "po nesmírné té radosti,"
  },
  {
   "texto": "po květech, tisíceré písni,"
  },
  {
   "texto": "po nadšení a mladosti!"
  },
  {
   "texto": "To vše, čím jaro dosud žije,"
  },
  {
   "texto": "ten nejslavnější poeta:"
  },
  {
   "texto": "že jeho píseň sýkorkami"
  },
  {
   "texto": "nad sirým proutím oblétá!"
  },
  {
   "texto": "Ba je to vše, a jedva hlásek"
  },
  {
   "texto": "vychladlým vzduchem proniká —"
  },
  {
   "texto": "tu chceš-li, duše moje, zkoumej,"
  },
  {
   "texto": "co nesmrtelnost básníka."
  },
  {
   "texto": "Vy zpěvní druzi jarních poupat,"
  },
  {
   "texto": "mám k vám též něco povzdechu:"
  },
  {
   "texto": "jsou srdce za zdmi uvězněna —"
  },
  {
   "texto": "zda máte pro ně útěchu?"
  },
  {
   "texto": "Jak, víte, soustrastný ten ptáček:"
  },
  {
   "texto": "ten Daliboru do věže"
  },
  {
   "texto": "donášel v písních božskou mluvu"
  },
  {
   "texto": "kvetoucí jara mládeže."
  },
  {
   "texto": "A mezi vámi tolik slasti,"
  },
  {
   "texto": "že až to nebem otřásá:"
  },
  {
   "texto": "zaleťte s něčím na okénko,"
  },
  {
   "texto": "tam okřeje a zajásá."
  },
  {
   "texto": "Což ubude tím jaru krásy,"
  },
  {
   "texto": "když jedna píseň odpadne?"
  },
  {
   "texto": "Nám často stačí pouhé slovo,"
  },
  {
   "texto": "a lidské srdce nevadne."
  }
 ]
}