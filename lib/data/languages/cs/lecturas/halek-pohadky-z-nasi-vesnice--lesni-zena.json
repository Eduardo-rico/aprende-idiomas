 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Poh%C3%A1dky_z_na%C5%A1%C3%AD_vesnice_(H%C3%A1lek)/Lesn%C3%AD_%C5%BEena",
 "fuente": "cs.wikisource.org, «Pohádky z naší vesnice»",
 "licencia": "dominio público (autor muerto en 1874)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-pohadky-z-nasi-vesnice",
  "titulo": "Pohádky z naší vesnice",
  "orden": 4
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Tak častují pasáci hosta:"
  },
  {
   "texto": "u ohně k ránu posedí,"
  },
  {
   "texto": "a jako hvězd na nebi do sta,"
  },
  {
   "texto": "pohádek jemu povědí."
  },
  {
   "texto": "To jako ty jiskřičky z dýmu:"
  },
  {
   "texto": "pohádek letné postavy"
  },
  {
   "texto": "jim šlehají z pravdy a šprýmu,"
  },
  {
   "texto": "do jedné k nim se dostaví."
  },
  {
   "texto": "Ta jedna ta přišla jak živá,"
  },
  {
   "texto": "sedla si těsně ku hosti:"
  },
  {
   "texto": "„A o čem tvá duše jen snivá,"
  },
  {
   "texto": "do syta dám ti, k radosti.“"
  },
  {
   "texto": "Hned ruku mu do měkka zdvihne,"
  },
  {
   "texto": "hledem mu kývá v znamení,"
  },
  {
   "texto": "hned srdce a duše mu jihne"
  },
  {
   "texto": "v neznámém smyslů zmatení."
  },
  {
   "texto": "Hned odchází po jejím boku,"
  },
  {
   "texto": "na loket hlavu složenou,"
  },
  {
   "texto": "a vše, co má pěkného v oku,"
  },
  {
   "texto": "hřeje mu v duši blaženou."
  },
  {
   "texto": "Že nedbá, ni nevidí cesty,"
  },
  {
   "texto": "že jdou až v lesů houštiny,"
  },
  {
   "texto": "a pod tenké, šumivé klesty,"
  },
  {
   "texto": "na vonné, měkké loučiny."
  },
  {
   "texto": "A jak jí tu zář v oku střehne,"
  },
  {
   "texto": "jako by v měkkých růžích stál,"
  },
  {
   "texto": "rtem ona se na rty mu sehne,"
  },
  {
   "texto": "zašeptá, dýchne: „Pojď jen dál!“"
  },
  {
   "texto": "Hned každý strom rozvázal ústa,"
  },
  {
   "texto": "rozpráví divně tkanou řeč,"
  },
  {
   "texto": "ta na hudbu z šumotu vzrůstá,"
  },
  {
   "texto": "táhne kol srdce tenkou leč."
  },
  {
   "texto": "Hned rozpráví lísteček tenký,"
  },
  {
   "texto": "slovům lze milo rozumět:"
  },
  {
   "texto": "byl pupencem za prvosenky,"
  },
  {
   "texto": "nyní je z plna zlatý květ."
  },
  {
   "texto": "Hned rozpráví našedlé ptáče,"
  },
  {
   "texto": "zahraje vzletnou do skoku,"
  },
  {
   "texto": "pak zavejskne, po větvi skáče,"
  },
  {
   "texto": "vede si družku po boku."
  },
  {
   "texto": "Hned rozpráví zurčivý pramen,"
  },
  {
   "texto": "žblunká si v cestu květnatou,"
  },
  {
   "texto": "až omšelý probudí kámen"
  },
  {
   "texto": "s ozvěnou v píseň napjatou."
  },
  {
   "texto": "Hned pryská a rodí se písní,"
  },
  {
   "texto": "libějších nikdo neslyšel,"
  },
  {
   "texto": "ba krásnější sotva kdo vysní,"
  },
  {
   "texto": "byť ani ze snů nevyšel."
  },
  {
   "texto": "Vše vidí tu jakoby ve dne,"
  },
  {
   "texto": "a jak by v samém kvítí stál,"
  },
  {
   "texto": "výš ona ho ramenem zvedne,"
  },
  {
   "texto": "rozpráví, šeptá: „Pojď jen dál!“"
  },
  {
   "texto": "Hned vykoukly za každou chvojí"
  },
  {
   "texto": "tvářičky mladé, růže květ,"
  },
  {
   "texto": "strou náruč a v náruč se pojí,"
  },
  {
   "texto": "v líbání měkký tisknou ret."
  },
  {
   "texto": "Jich lokte jak lilie sněžné,"
  },
  {
   "texto": "očka jak hvězdosetá noc,"
  },
  {
   "texto": "a v zvonečků poháry něžné"
  },
  {
   "texto": "sbírají rosy chvělou moc."
  },
  {
   "texto": "Hned postavy pitvorným spěchem"
  },
  {
   "texto": "z tmavého rostou kořene,"
  },
  {
   "texto": "v šat pokryty korou a mechem,"
  },
  {
   "texto": "na smích a na žert stvořené."
  },
  {
   "texto": "Tu, jako by svolal je z lesů,"
  },
  {
   "texto": "s jeleny laňky přilétly,"
  },
  {
   "texto": "a na každé přijíždí v plesu"
  },
  {
   "texto": "mládencův půvab vykvetlý."
  },
  {
   "texto": "Ti táhnou se v průvodu táhlém,"
  },
  {
   "texto": "každý svou vede nevěstu,"
  },
  {
   "texto": "a mužíci v poskoku náhlém"
  },
  {
   "texto": "na pochod hrajou, na cestu."
  },
  {
   "texto": "A komu se po skrytu steskne —"
  },
  {
   "texto": "luna bdí víc jen pro snění,"
  },
  {
   "texto": "a hvězdy se spouštějí leskné"
  },
  {
   "texto": "co noci zlaté třepení."
  },
  {
   "texto": "Je kolem tak luzno a krásně,"
  },
  {
   "texto": "řečí a zpěvů, bílých těl,"
  },
  {
   "texto": "to jako by na křídlech básně"
  },
  {
   "texto": "na pokraj ráje zaletěl."
  },
  {
   "texto": "Je všecko tak luzné a krásné,"
  },
  {
   "texto": "ale když zřel jí do oka,"
  },
  {
   "texto": "přes vše to jen bledne a hasne,"
  },
  {
   "texto": "a on si vzdychá z hluboka."
  },
  {
   "texto": "Tu z jejího oka to šlehne,"
  },
  {
   "texto": "jako by mezi blesky stál,"
  },
  {
   "texto": "rty palčivé na rty mu sehne,"
  },
  {
   "texto": "rozpráví, šeptá: „Pojď jen dál!“"
  },
  {
   "texto": "Když objati kráčejí k sluji,"
  },
  {
   "texto": "šlépěji v hedbáv měkne mech,"
  },
  {
   "texto": "kde postojí, kapradí bují"
  },
  {
   "texto": "a rosou páchnouc chladí dech."
  },
  {
   "texto": "Tu ve sluji sedátek stero —"
  },
  {
   "texto": "„Odpočiň zrakům znaveným,"
  },
  {
   "texto": "tu sedneme v průhledné šero,"
  },
  {
   "texto": "zdřímnem si spánkem blaženým.“"
  },
  {
   "texto": "Pak doznívá hudba a hraní,"
  },
  {
   "texto": "myšlenka vyznívá tu v sen,"
  },
  {
   "texto": "a zdřímne-li na její dlani,"
  },
  {
   "texto": "nespatří více příští den."
  },
  {
   "texto": "Ba zdřímnul, a dříve než tuší,"
  },
  {
   "texto": "spjala ho v sladké beztrudí,"
  },
  {
   "texto": "pak vypila mladou mu duši,"
  },
  {
   "texto": "sotva ho v den kdo probudí."
  },
  {
   "texto": "* * *"
  },
  {
   "texto": "V den čekají pasáci hosta,"
  },
  {
   "texto": "u ohně s ním že posedí,"
  },
  {
   "texto": "sic umějí pohádek do sta —"
  },
  {
   "texto": "dnes ani jednu nevědí."
  },
  {
   "texto": "A večer, kdy došlo to k řeči,"
  },
  {
   "texto": "zasedli v starém pořádku,"
  },
  {
   "texto": "ach, měli dnes zásobu větší"
  },
  {
   "texto": "o jednu novou pohádku."
  }
 ]
}