{
 "id": "cech-lesetinsky-kovar-c05",
 "titulo": "Zpěv XI.",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Le%C5%A1et%C3%ADnsk%C3%BD_kov%C3%A1%C5%99/XI.",
 "fuente": "cs.wikisource.org, «Lešetínský kovář»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-lesetinsky-kovar",
  "titulo": "Lešetínský kovář",
  "orden": 5
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Léta přeletěla nad kovárnou,"
  },
  {
   "texto": "naplnila chladem výheň žárnou,"
  },
  {
   "texto": "utišila kladiv zvučný ruch;"
  },
  {
   "texto": "kol do kola pavouk sítě husté"
  },
  {
   "texto": "upřádá; na kovadlině pusté"
  },
  {
   "texto": "kovář sedá samoten jak duch."
  },
  {
   "texto": "Truchlivo tu, mrtvé ticho všude."
  },
  {
   "texto": "Jenom vítr do komína hude"
  },
  {
   "texto": "pronikavě žalné noty své,"
  },
  {
   "texto": "oknem lomcuje, krov sešlý rve."
  },
  {
   "texto": "Sama píseň Liduščina juž"
  },
  {
   "texto": "zřídka jen se perlí v tesknou hluš,"
  },
  {
   "texto": "jako mlkne skřivánek, an sviští"
  },
  {
   "texto": "podzimku dech ostrý po strništi."
  },
  {
   "texto": "Skřípnou časem vetché stěžeje"
  },
  {
   "texto": "dveří děravých a vítr kvíle"
  },
  {
   "texto": "sněhu přehršli sem navěje."
  },
  {
   "texto": "Zdává se tu, jak by hvězdy bílé"
  },
  {
   "texto": "byly zalétly též na vous tmavý,"
  },
  {
   "texto": "v černou kadeř kovářovy hlavy."
  },
  {
   "texto": "Však bouř’ jiná na bradu a kštice"
  },
  {
   "texto": "navála ty první vločky sněhu,"
  },
  {
   "texto": "jiná bouř’, jež také v ostrém šlehu"
  },
  {
   "texto": "zbrázdila mu čelo, skráň i líce."
  },
  {
   "texto": "Spoustou črt se zapsal kováři"
  },
  {
   "texto": "hluboko boj vnitra do tváři,"
  },
  {
   "texto": "mnohý nezdar, mnohá naděj’ marná,"
  },
  {
   "texto": "mnohá péče těžká, vášeň žárná."
  },
  {
   "texto": "Zpustla dílna. Skrovných rolí plody"
  },
  {
   "texto": "chřadly žhavým dechem neúrody."
  },
  {
   "texto": "Poznal drápy dluhů, bídy zub;"
  },
  {
   "texto": "poznal, že je mocný soused chtivý"
  },
  {
   "texto": "chuďasovi jako šírý dub,"
  },
  {
   "texto": "strmící na mezi žitné nivy:"
  },
  {
   "texto": "kamo padá hustých větví chlad,"
  },
  {
   "texto": "útlé stéblo marně čelo šine"
  },
  {
   "texto": "k živným paprskům a chřadne, hyne."
  },
  {
   "texto": "Bylo brániti se odevšad"
  },
  {
   "texto": "soka velmocného svévoli:"
  },
  {
   "texto": "zde mu zpustošili setby líchu,"
  },
  {
   "texto": "tam zas jabloň, sadu skromnou pýchu,"
  },
  {
   "texto": "zde mu svedli vodu do rolí,"
  },
  {
   "texto": "porušili meze lánu jeho — —"
  },
  {
   "texto": "Mistr hájil práva zkráceného, —"
  },
  {
   "texto": "rostly spory jak po dešti hřiby,"
  },
  {
   "texto": "rozvlékly se v dálky nedohledné —"
  },
  {
   "texto": "křiví svědci — úskoky a chyby —"
  },
  {
   "texto": "útrat moře — soudů honce bědné."
  },
  {
   "texto": "Ale kovář vypínal vždy znova"
  },
  {
   "texto": "tuhou lebku nad nezdary všemi;"
  },
  {
   "texto": "zuby skřípaje jen šeptal slova:"
  },
  {
   "texto": "„Zvím, zda spravedlnost na té zemi!“"
  },
  {
   "texto": "A kol kolem nenávist dech"
  },
  {
   "texto": "ovíval jej žhavě; „kovář český“"
  },
  {
   "texto": "davu cizinců byl pro posměch;"
  },
  {
   "texto": "potupné jich posuňky a vřesky"
  },
  {
   "texto": "v duši bodaly ho sterým ostnem."
  },
  {
   "texto": "Leckdy nové panstvo v pyšné zdobě,"
  },
  {
   "texto": "jedouc kolem na povoze skvostném,"
  },
  {
   "texto": "na dům jeho ukázalo sobě,"
  },
  {
   "texto": "na kovárnu pustou, nízkou chatu,"
  },
  {
   "texto": "na střechu, kde bujel netřesk, mech,"
  },
  {
   "texto": "na Lidušku v starosvětském šatu,"
  },
  {
   "texto": "s rudou třásní šátku na vlasech;"
  },
  {
   "texto": "vídal tu, jak panstvo pohrdavě"
  },
  {
   "texto": "k úsměvu ret pyšný stahuje,"
  },
  {
   "texto": "slýchal posměch, jenž ho bodal žhavě:"
  },
  {
   "texto": "„Hle, tu kovář, který nekuje!“"
  },
  {
   "texto": "Jako divous v temnu jeskyně"
  },
  {
   "texto": "sedal v pusté kovárně a zíral"
  },
  {
   "texto": "do mohutné knihy na klíně."
  },
  {
   "texto": "Desky tlusté hrubou rukou svíral"
  },
  {
   "texto": "a když obracel jí vetchý list,"
  },
  {
   "texto": "oko zamlžené časem zdvihal"
  },
  {
   "texto": "k oknu kalnému, jímž sníh se mihal,"
  },
  {
   "texto": "za nímž ozýval se vichrů svist."
  },
  {
   "texto": "Ale někdy také prostřed čtení"
  },
  {
   "texto": "pozdvihl se v prudkém rozčilení,"
  },
  {
   "texto": "pádným krokem po kovárně vztáh’"
  },
  {
   "texto": "pěstě zaťaté, jak by tam vrah"
  },
  {
   "texto": "neviditelný se temnem plížil."
  },
  {
   "texto": "Jeho duch byl jako horská řeka,"
  },
  {
   "texto": "k nížto z jara z tajícího sněhu"
  },
  {
   "texto": "na sta potůčků a bystřin stéká;"
  },
  {
   "texto": "proud se čeří, zdýmá v prudkém běhu,"
  },
  {
   "texto": "vzrůstá, bujně řečištěm se šíří,"
  },
  {
   "texto": "s hukotem se pění, kypí, víří,"
  },
  {
   "texto": "avšak sepjat ještě poutem břehů,"
  },
  {
   "texto": "ač snad zítra všechno strhne, zkácí"
  },
  {
   "texto": "a jak orkán krajem zaburácí:"
  },
  {
   "texto": "tak ty steré strasti, svízele,"
  },
  {
   "texto": "ústrky a rozepře a hany"
  },
  {
   "texto": "v duši jeho mračně ztemnělé"
  },
  {
   "texto": "zdýmaly proud vášní rozháraný,"
  },
  {
   "texto": "hněv mu bouřně útrobami zmítal,"
  },
  {
   "texto": "bušil v skráň a bleskem z očí svítal,"
  },
  {
   "texto": "že tím stálým vnitřním rozruchem"
  },
  {
   "texto": "přeplněna byla ňader schrána —"
  },
  {
   "texto": "ještě mžik — ta bouře upoutaná"
  },
  {
   "texto": "prolomí se strašným výbuchem…"
  },
  {
   "texto": "Jako v temné přízi pavouk šerý"
  },
  {
   "texto": "sám tak mistr ve svých dumách dlel."
  },
  {
   "texto": "Ale po čase host ledakterý"
  },
  {
   "texto": "do kovárny pusté přicházel."
  },
  {
   "texto": "Soused Brázda nejednou tu sedal."
  },
  {
   "texto": "Statek prodalť on a v kraji kdes"
  },
  {
   "texto": "poblízku si nové bydlo hledal."
  },
  {
   "texto": "Ale za nedlouho v rodnou ves"
  },
  {
   "texto": "navrátil se v neodbytné touze."
  },
  {
   "texto": "Doma byl, však mezi cizím lidem,"
  },
  {
   "texto": "doma byl, však s ním tu byla nouze."
  },
  {
   "texto": "Jako vlaštovice s nepoklidem"
  },
  {
   "texto": "při návratu obletuje štít,"
  },
  {
   "texto": "kde pněl teplý, něžný její byt,"
  },
  {
   "texto": "však teď očím teskným trámec hnědý"
  },
  {
   "texto": "nejeví leč matné jeho sledy:"
  },
  {
   "texto": "takto zamyšlen se ubírával"
  },
  {
   "texto": "vůkol míst, kde barák jeho stával,"
  },
  {
   "texto": "obcházel jak druhdy v lepší časy"
  },
  {
   "texto": "známý lán, kde cizím zrály klasy."
  },
  {
   "texto": "Jinak Brázda nezměnil se hrubě:"
  },
  {
   "texto": "Beranici měl, jen s řidší srstí,"
  },
  {
   "texto": "kožich svůj, ač s chudou jenom hrstí"
  },
  {
   "texto": "rozptýlených čupřin po obrubě,"
  },
  {
   "texto": "s odkvetlými tulipány vzadu."
  },
  {
   "texto": "Ledabylo oholenou bradu"
  },
  {
   "texto": "měl jak prve; v širé líci stejný"
  },
  {
   "texto": "prostoduchý výraz blahopřejný"
  },
  {
   "texto": "a kol přimhouřených oček sivých"
  },
  {
   "texto": "stejné shluky vrásek přívětivých."
  },
  {
   "texto": "Mluvil také jako před lety"
  },
  {
   "texto": "o setí a sklizni, o počasí,"
  },
  {
   "texto": "o významu loňské komety"
  },
  {
   "texto": "a co potentáti kujou asi"
  },
  {
   "texto": "a že časy podivné jsou teď."
  },
  {
   "texto": "A rád vpletl milou průpověď"
  },
  {
   "texto": "šoupnuv beranici s ucha k uchu:"
  },
  {
   "texto": "„Jsou to věci, na mou milou duchu!“"
  },
  {
   "texto": "Také z Ameriky v rodné strany"
  },
  {
   "texto": "navrátil se hlouček obervaný,"
  },
  {
   "texto": "Józa vůdcem byl té chudiny."
  },
  {
   "texto": "Neveselý příběh jeho byl:"
  },
  {
   "texto": "Když se s otcem starým z dědiny"
  },
  {
   "texto": "za „veliký rybník“ vypravil,"
  },
  {
   "texto": "zůstavil tu děvče, duší celou"
  },
  {
   "texto": "tulící se k miláčkovi svému;"
  },
  {
   "texto": "avšak otčím s myslí zatvrzelou"
  },
  {
   "texto": "odpíral ji mládci chudobnému."
  },
  {
   "texto": "Byla Baruška jak štíhlá srnka,"
  },
  {
   "texto": "bílá, ruměnná jak máku květ"
  },
  {
   "texto": "a z řas černých oko jako trnka"
  },
  {
   "texto": "radostně se smálo v boží svět."
  },
  {
   "texto": "Naposled si věrnost přísahali,"
  },
  {
   "texto": "a hoch těšil se, že skrovné jmění"
  },
  {
   "texto": "snadno získá tam, že za čas malý"
  },
  {
   "texto": "vrátí se a s dívkou prsten smění."
  },
  {
   "texto": "Ale zámky, které štěstí lačná"
  },
  {
   "texto": "duše viděla v par mořských lesku,"
  },
  {
   "texto": "rozprchly se jak ta jitřní mračna."
  },
  {
   "texto": "Čas mu plynul v bídě jen a stesku,"
  },
  {
   "texto": "a když otce pohřbil v cizí půdu,"
  },
  {
   "texto": "v tlupě rodáků, s ním stejně štvaných"
  },
  {
   "texto": "bídou všady, trpce oklamaných,"
  },
  {
   "texto": "do vlasti se vrátil v těžkém trudu."
  },
  {
   "texto": "Chud se vracel. V myšlence však jedné"
  },
  {
   "texto": "sladce okříval: že opětně shledne"
  },
  {
   "texto": "krásnou růžičku, již po čas celý"
  },
  {
   "texto": "v duši nosil na své bludné dráze,"
  },
  {
   "texto": "že snad přece rozvalí ty hráze,"
  },
  {
   "texto": "jimiž osud srdce jejich dělí."
  },
  {
   "texto": "Ale našel v bolném zděšení"
  },
  {
   "texto": "hrob jen pustý v nesvěcené prsti,"
  },
  {
   "texto": "na němž chladný vítr jeseni"
  },
  {
   "texto": "pohrával si s rudých lístků hrstí,"
  },
  {
   "texto": "šeptaje tu starou, smutnou zvěst"
  },
  {
   "texto": "o dívčici zchudlé, která v píli"
  },
  {
   "texto": "boháči své věnovala síly"
  },
  {
   "texto": "a jíž boháč za to urval čest."
  },
  {
   "texto": "Šeptal o strašlivé noci jedné,"
  },
  {
   "texto": "kdy se rozleh’ stonem vichřice"
  },
  {
   "texto": "naposledy výkřik dívky bědné,"
  },
  {
   "texto": "až pak v tůni shledla dennice"
  },
  {
   "texto": "jako leknínu květ s poupětem —"
  },
  {
   "texto": "mrtvou matku s mrtvým dítětem."
  },
  {
   "texto": "Józa na tom hrobě dlouho lkal;"
  },
  {
   "texto": "pěstí zaťatou pak zamáv’ směrem,"
  },
  {
   "texto": "kde jak stožár obrovský se pjal"
  },
  {
   "texto": "k nebi komín temný nočním šerem."
  },
  {
   "texto": "Jako zvěř pak těkal hvozdem, nivou,"
  },
  {
   "texto": "kol továrny jak vlk se plížil;"
  },
  {
   "texto": "kadeř pustá clonila tvář divou,"
  },
  {
   "texto": "děsný blesk se vpadným okem křížil."
  },
  {
   "texto": "Časem zašel v kovárnu a tupě"
  },
  {
   "texto": "hleděl k zemi, sedě mlčky stranou."
  },
  {
   "texto": "Také dělník Prokop v malé tlupě"
  },
  {
   "texto": "soudruhů svých s lící utýranou"
  },
  {
   "texto": "někdy sedal zde, když věčně čilý"
  },
  {
   "texto": "továrny ruch přál jim klidu chvíli."
  },
  {
   "texto": "Toužili na život, horší smrti,"
  },
  {
   "texto": "kde jen břímě lopoty je drtí,"
  },
  {
   "texto": "líčili svou bídu, děsné byty,"
  },
  {
   "texto": "kam slunéčka nezabloudí svity,"
  },
  {
   "texto": "kam jen zima fičí sterou skoulí"
  },
  {
   "texto": "a kde pokryt cárů pavučinou"
  },
  {
   "texto": "s očkem zapadlým a tváří sinou"
  },
  {
   "texto": "chomáč dětí hladových se choulí…"
  },
  {
   "texto": "Takto vše, co s nenávistí zřelo"
  },
  {
   "texto": "k panstvu cizímu a hněvem vřelo,"
  },
  {
   "texto": "všechen vzdor, jenž proti nim se zdvihal,"
  },
  {
   "texto": "ponenáhlu v kovárně se sbíhal."
  },
  {
   "texto": "Kovář rozmluv účastnil se málo."
  },
  {
   "texto": "Za to leckdy ze své kroniky"
  },
  {
   "texto": "přečítal jim příběh všeliký."
  },
  {
   "texto": "Mocně hlas tu zníval, oko plálo,"
  },
  {
   "texto": "čet’-li nejmilejší kapitoly,"
  },
  {
   "texto": "kterak lid náš vznícen dechem Páně"
  },
  {
   "texto": "zanechal svých příbytků a rolí,"
  },
  {
   "texto": "proměnil své cepy v děsné zbraně,"
  },
  {
   "texto": "proměnil své vozy v pevné valy"
  },
  {
   "texto": "a vše drtil hněvů záplavou,"
  },
  {
   "texto": "že se národové zachvívali"
  },
  {
   "texto": "před kalicha září krvavou. —"
  },
  {
   "texto": "Dleli tu zas jednou neveselo."
  },
  {
   "texto": "Kovář víc, než jindy, vraštil čelo"
  },
  {
   "texto": "pod kadeří svislých pustou změtí."
  },
  {
   "texto": "U kovadliny stál zasmušile,"
  },
  {
   "texto": "ruce nad kladiva rukojetí"
  },
  {
   "texto": "maje složeny, zrak v půdu chýle."
  },
  {
   "texto": "Vešel Brázda, husté sněhu vločky"
  },
  {
   "texto": "vytřás’ z kožichové třásně chudé,"
  },
  {
   "texto": "mžoural dlouho zavlhlými očky"
  },
  {
   "texto": "a pak pravil, mna si dlaně rudé:"
  },
  {
   "texto": "„Hu! dnes člověk sotva oči protře —"
  },
  {
   "texto": "sníh a déšť — a vítr k tomu sviští —"
  },
  {
   "texto": "věru neškodil by u vás, kmotře,"
  },
  {
   "texto": "pěkný plamínek zde na ohništi! —"
  },
  {
   "texto": "Avšak — víte-li, že správec klatý"
  },
  {
   "texto": "vychloubá se, že jste procesy"
  },
  {
   "texto": "všechny prohrál, že vám pro útraty"
  },
  {
   "texto": "exekuci na krk zavěsí —"
  },
  {
   "texto": "že je konec s vámi — že prý také"
  },
  {
   "texto": "jiné dloužky hrozí všelijaké —"
  },
  {
   "texto": "zkrátka, že prý na blízku již den,"
  },
  {
   "texto": "kdy vám všechno dají na buben?"
  },
  {
   "texto": "Vaši chalupu prý továrna"
  },
  {
