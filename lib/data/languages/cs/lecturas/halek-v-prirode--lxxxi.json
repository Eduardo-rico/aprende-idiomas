 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LXXXI."
  },
  {
   "texto": "Na drnu kyprém, v kořání"
  },
  {
   "texto": "sedla si krása bez zvaní,"
  },
  {
   "texto": "sedla si měkce vedle mne,"
  },
  {
   "texto": "s mladostí v tváři dojemné."
  },
  {
   "texto": "U nohou tenké praménky,"
  },
  {
   "texto": "sedla si v kapraď, v pomněnky,"
  },
  {
   "texto": "nad sebou větvic vlažný stín,"
  },
  {
   "texto": "hleděla lesům do hlubin."
  },
  {
   "texto": "„Hledals mě v mořích, výšinách,"
  },
  {
   "texto": "v světů a nebes končinách,"
  },
  {
   "texto": "hledals mě v štěstí, v žalu svém,"
  },
  {
   "texto": "a já tak blízko doma jsem.“"
  },
  {
   "texto": "Seděla, hlas jak do zpěvu,"
  },
  {
   "texto": "na tváři důlek úsměvu,"
  },
  {
   "texto": "oko jak duše prohřátá,"
  },
  {
   "texto": "rty jako k růžím poupata."
  },
  {
   "texto": "„Však tys mne hledal nejradši,"
  },
  {
   "texto": "kde jsou mi květy nejsladší,"
  },
  {
   "texto": "proto jmu v plnou lásku tě —"
  },
  {
   "texto": "našels mne v pravdě, v prostotě.“"
  },
  {
   "texto": "Včera ty stromy tak vážny,"
  },
  {
   "texto": "a přes noc v bílém, žluťounkém šatě,"
  },
  {
   "texto": "táhnou se jako ta mlha,"
  },
  {
   "texto": "po stráni vzdušné, v stříbře a zlatě."
  },
  {
   "texto": "Táhnou se u velké slávě,"
  },
  {
   "texto": "a jakby prstem blíže mne zvaly:"
  },
  {
   "texto": "„Zrodilo nám se tu dítek"
  },
  {
   "texto": "na velkou radost za drobné žaly.“"
  },
  {
   "texto": "Jdu tam a blíže se dívám —"
  },
  {
   "texto": "radosti plno na každé sněti,"
  },
  {
   "texto": "a co já dosud měl květem,"
  },
  {
   "texto": "větvička každá tolik má dětí."
  },
  {
   "texto": "Dětičky drobounké, sladké,"
  },
  {
   "texto": "matička větev v loktech je houpá,"
  },
  {
   "texto": "včelky jim bzučejí písně,"
  },
  {
   "texto": "rosa je meje, deštíček koupá."
  },
  {
   "texto": "Dnes slunce se v háji prochází"
  },
  {
   "texto": "a z větvičky na větev bloudí,"
  },
  {
   "texto": "to jako ten chlapec na holkách,"
  },
  {
   "texto": "to na větvi hubičky loudí."
  },
  {
   "texto": "A líbá a cosi šeptem dí"
  },
  {
   "texto": "a hladí a tiskne jim ruku —"
  },
  {
   "texto": "až hájem to slastí zachvělo,"
  },
  {
   "texto": "a srdce mé pospíchá v tluku."
  },
  {
   "texto": "A jestli mne všecko nemýlí,"
  },
  {
   "texto": "to sluníčko také jde ke mně,"
  },
  {
   "texto": "mně zahřívá v květy poupata,"
  },
  {
   "texto": "ba sáhá až do duše jemně."
  },
  {
   "texto": "A jestli mne všecko nemýlí,"
  },
  {
   "texto": "ví, kterak se o srdce prosí:"
  },
  {
   "texto": "v mé duši jak v háji písniček"
  },
  {
   "texto": "a radostí měl bych i rosy."
  },
  {
   "texto": "Skřivánci táhnou od jihu"
  },
  {
   "texto": "s paprsky teple slunečními,"
  },
  {
   "texto": "a jestliže k nim hledím déle,"
  },
  {
   "texto": "jsou myšlénky mé mezi nimi."
  },
  {
   "texto": "Tak tedy přece tomu tak,"
  },
  {
   "texto": "co stará moudrost věřit učí:"
  },
  {
   "texto": "na podzim nejen o ty ptáčky,"
  },
  {
   "texto": "i o své myšlénky jsme chudší."
  },
  {
   "texto": "A tedy tomu přece tak,"
  },
  {
   "texto": "co milo mně nad všecka slova:"
  },
  {
   "texto": "má duše s ptáčky odmlčí se"
  },
  {
   "texto": "a s jarem rozzpívá se znova."
  },
  {
   "texto": "Skřivánci táhnou od jihu,"
  },
  {
   "texto": "mé myšlénky jsou mezi nimi,"
  },
  {
   "texto": "a v duši mé již jako v polích,"
  },
  {
   "texto": "kdy zahrajou si oseními."
  }
 ]
}