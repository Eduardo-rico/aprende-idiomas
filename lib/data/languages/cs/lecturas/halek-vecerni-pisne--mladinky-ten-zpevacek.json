 "parrafos": [
  {
   "texto": "Mladinký ten zpěváček"
  },
  {
   "texto": "Mladinký ten zpěváček —"
  },
  {
   "texto": "což tak umlk' z nenadání?"
  },
  {
   "texto": "Oči se mu zalily"
  },
  {
   "texto": "jak u vřelém s Bohem! dání."
  },
  {
   "texto": "Mnohý snad si pomyslí:"
  },
  {
   "texto": "bože, co ho asi rmoutí?"
  },
  {
   "texto": "Tvář má hezkou, mladinkou"
  },
  {
   "texto": "a zpěv milo poslechnouti."
  },
  {
   "texto": "Ach mladinká, hezká tvář"
  },
  {
   "texto": "nedá srdci úlevu;"
  },
  {
   "texto": "a byť se i líbil zpěv —"
  },
  {
   "texto": "není vždycky do zpěvu."
  },
  {
   "texto": "Tak jak ten měsíc v nebes báň"
  },
  {
   "texto": "tak láska v srdce vchází,"
  },
  {
   "texto": "a tajný bol a tichý žal"
  },
  {
   "texto": "ji v chůzi doprovází."
  },
  {
   "texto": "A co dřív člověk netušil,"
  },
  {
   "texto": "v tom šerém světle spatří,"
  },
  {
   "texto": "a tajný bol a tichý žal"
  },
  {
   "texto": "se divně v písni sbratří."
  },
  {
   "texto": "Leč mnohá též se bouře zlá"
  },
  {
   "texto": "v ubohém srdci shlukne,"
  },
  {
   "texto": "a než ji v písni vysloví —"
  },
  {
   "texto": "jak mnohé srdce pukne!"
  },
  {
   "texto": "Vy všichni, kdo jste stísnění,"
  },
  {
   "texto": "již pojďte, pojďte ke mně,"
  },
  {
   "texto": "zde složte s beder útrap tíž"
  },
  {
   "texto": "a zapomeňte jemně."
  },
  {
   "texto": "Já lásky říš zde založil,"
  },
  {
   "texto": "kde druh se k druhu vine,"
  },
  {
   "texto": "a vše co má kdo na srdci,"
  },
  {
   "texto": "to v pěkných písních plyne."
  },
  {
   "texto": "Zde nezná soka závistník,"
  },
  {
   "texto": "zde řeč jak píseň sladká,"
  },
  {
   "texto": "zde lev je krotký beránek"
  },
  {
   "texto": "a dravci holoubátka."
  },
  {
   "texto": "Zde léky všechněm útrapám,"
  },
  {
   "texto": "zde srdce věčně mladne,"
  },
  {
   "texto": "zde neovádá růže květ"
  },
  {
   "texto": "a nepřátelství žádné."
  },
  {
   "texto": "S dnem noc se navždy rozešla."
  },
  {
   "texto": "Den jako Jidáš zrádný,"
  },
  {
   "texto": "a večer plný krásy jest"
  },
  {
   "texto": "a neodolá žádný."
  },
  {
   "texto": "Tu přijdou jasné hvězdičky"
  },
  {
   "texto": "a tou lunou stále bledou,"
  },
  {
   "texto": "a v háji něžné hrdličky"
  },
  {
   "texto": "přesladký hovor vedou."
  },
  {
   "texto": "Srdce se srdci zpovídá,"
  },
  {
   "texto": "myšlénky v dálku táhnou,"
  },
  {
   "texto": "a ústa touhou žíznivá"
  },
  {
   "texto": "po políbení práhnou."
  },
  {
   "texto": "Tys ruku svou položila"
  },
  {
   "texto": "na moji pyšnou skráni,"
  },
  {
   "texto": "Tys ústy něco šeptala"
  },
  {
   "texto": "tak jako požehnání."
  },
  {
   "texto": "Tys rozevřela duši svou,"
  },
  {
   "texto": "ve sladké lásky době,"
  },
  {
   "texto": "a co jsem snít si netroufal —"
  },
  {
   "texto": "Tys vinula mne k sobě."
  },
  {
   "texto": "Tys posvětila harfu mou"
  },
  {
   "texto": "i celé srdce moje,"
  },
  {
   "texto": "Tys požehnala písni mé"
  },
  {
   "texto": "do posvátného boje."
  },
  {
   "texto": "Z mých očí slzy zmizely"
  },
  {
   "texto": "a s čela mého vrásky,"
  },
  {
   "texto": "v mé duši vyjasnilo se"
  },
  {
   "texto": "a já jsem věštec lásky."
  }
 ]
}