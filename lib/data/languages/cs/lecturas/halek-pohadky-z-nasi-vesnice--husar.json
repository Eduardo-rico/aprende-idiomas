{
 "id": "halek-pohadky-z-nasi-vesnice--husar",
 "titulo": "Husar · Plukovní tambor",
 "autor": "Vítězslav Hálek",
 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Poh%C3%A1dky_z_na%C5%A1%C3%AD_vesnice_(H%C3%A1lek)/Husar",
 "fuente": "cs.wikisource.org, «Pohádky z naší vesnice»",
 "licencia": "dominio público (autor muerto en 1874)",
 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-pohadky-z-nasi-vesnice",
  "titulo": "Pohádky z naší vesnice",
  "orden": 17
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Husar"
  },
  {
   "texto": "Skočil husar do třemenů,"
  },
  {
   "texto": "břinknul v ostruhu:"
  },
  {
   "texto": "„Na noc dej mi koně k senu,"
  },
  {
   "texto": "ženu v obsluhu.“"
  },
  {
   "texto": "Sedlák o ženu je v strachu,"
  },
  {
   "texto": "sám jde v špižírny —"
  },
  {
   "texto": "„Račte, víno jako z nachu,"
  },
  {
   "texto": "maso z udírny.“"
  },
  {
   "texto": "Husar vzhůru kníry kroutí,"
  },
  {
   "texto": "mlaská blažený:"
  },
  {
   "texto": "„Slyš, sedláku, co mne rmoutí —"
  },
  {
   "texto": "že jsi bez ženy!“"
  },
  {
   "texto": "Sedlák kouká do sklenice,"
  },
  {
   "texto": "hlas mu v pláč se chvěl:"
  },
  {
   "texto": "„Mne to rmoutí ještě více,"
  },
  {
   "texto": "že jsem ovdověl.“"
  },
  {
   "texto": "„Sedláku, kdo dobře přijat,"
  },
  {
   "texto": "hned to v domě znát:"
  },
  {
   "texto": "ženská jako karafiát"
  },
  {
   "texto": "šla mi otvírat.“"
  },
  {
   "texto": "Sedlák k nebi ruce spíná:"
  },
  {
   "texto": "„To dnes nespěte,"
  },
  {
   "texto": "chval každý duch hospodina,"
  },
  {
   "texto": "vy zde umřete.“"
  },
  {
   "texto": "Husar na stůl zatlouk’ pěstí,"
  },
  {
   "texto": "chlap to od síly:"
  },
  {
   "texto": "„Slyš, sedláku, tvoje štěstí,"
  },
  {
   "texto": "jsem-li napilý.“"
  },
  {
   "texto": "Ale sedlák svoji vede:"
  },
  {
   "texto": "„Má to nebožka,"
  },
  {
   "texto": "komu ta k nám na noc vjede,"
  },
  {
   "texto": "rána nedočká.“"
  },
  {
   "texto": "Slyšte jen, co takou měrou"
  },
  {
   "texto": "bylo nezdarů:"
  },
  {
   "texto": "padlo tu jak pod sekerou"
  },
  {
   "texto": "pánů, husarů —"
  },
  {
   "texto": "Ale při vás je snad jiná;"
  },
  {
   "texto": "kdo se nebojí,"
  },
  {
   "texto": "za dobrý ho doušek vína"
  },
  {
   "texto": "nechá v pokoji.“"
  },
  {
   "texto": "Vína nosí jako vody —"
  },
  {
   "texto": "ké to šlehnutí?"
  },
  {
   "texto": "„Nedej, bože, v samé hody"
  },
  {
   "texto": "tohle leknutí!“"
  },
  {
   "texto": "Husar skočí jako střela —"
  },
  {
   "texto": "„Při mém spasení,"
  },
  {
   "texto": "já to viděl, že teď jela"
  },
  {
   "texto": "kolem stavení!“"
  },
  {
   "texto": "Co to dupe divým honem,"
  },
  {
   "texto": "přes dvůr potřetí?"
  },
  {
   "texto": "Skok, a husar už i s koněm"
  },
  {
   "texto": "ze vrat vyletí."
  },
  {
   "texto": "Sedlák ženu k srdci vina"
  },
  {
   "texto": "hladí po líčku —"
  },
  {
   "texto": "„Chvalme, ženo, hospodina,"
  },
  {
   "texto": "strouhej mrkvičku!“"
  },
  {
   "texto": "K nám vojsko táhne za hluku"
  },
  {
   "texto": "a před ním tambor od pluku,"
  },
  {
   "texto": "tvář jako z mračen vousatá,"
  },
  {
   "texto": "hůl samá záře od zlata."
  },
  {
   "texto": "A když ta hůl se zakmitne,"
  },
  {
   "texto": "jak z mraků blesk kdy vylítne:"
  },
  {
   "texto": "hned rána v buben udeří"
  },
  {
   "texto": "a hudba z plna naměří."
  },
  {
   "texto": "Hned hudba hřímá stohlasá,"
  },
  {
   "texto": "že až to srdcem otřásá,"
  },
  {
   "texto": "že v okna děvčat přispěje,"
  },
  {
   "texto": "jak když tam kvítí naseje."
  },
  {
   "texto": "A jedna ze všech zářivá"
  },
  {
   "texto": "jak sluníčko se usmívá:"
  },
  {
   "texto": "to tambor táhne kolem ní"
  },
  {
   "texto": "a teď dal holí znamení."
  },
  {
   "texto": "„Ba věz, můj drahý obrázku,"
  },
  {
   "texto": "ten cimbál v mém je závazku,"
  },
  {
   "texto": "s ním flétny tebe pozdraví,"
  },
  {
   "texto": "že já jdu kolem ve zdraví."
  },
  {
   "texto": "„Ten buben hřmí ti na počest,"
  },
  {
   "texto": "že srdce mé tak věrno jest,"
  },
  {
   "texto": "a hůl má trouby nestaví,"
  },
  {
   "texto": "až slavně tebe oslaví.“"
  },
  {
   "texto": "Dál hřímá hudba v ulice,"
  },
  {
   "texto": "jak velká zvuků vichřice,"
  },
  {
   "texto": "ta okna, dvéře otáčí,"
  },
  {
   "texto": "ta srdce z těla vypáčí."
  },
  {
   "texto": "Dál táhne vojsko za zvuku"
  },
  {
   "texto": "a před ním tambor od pluku,"
  },
  {
   "texto": "tvář jako z mračen vousatá,"
  },
  {
   "texto": "hůl samá záře od zlata."
  }
 ]
}