 "parrafos": [
  {
   "texto": "35"
  },
  {
   "texto": "Pláče hošík otrhaný:"
  },
  {
   "texto": "„Přec se jednou seberu,"
  },
  {
   "texto": "tatínkovi, kde ho najdu,"
  },
  {
   "texto": "notně holí vyperu.“"
  },
  {
   "texto": "„Kdož tvůj otec?“ - „Nač se ptáte -"
  },
  {
   "texto": "tatínek je velký pán;"
  },
  {
   "texto": "odejel nám - dávno tomu,"
  },
  {
   "texto": "když mi dával marcipán.“"
  },
  {
   "texto": "„A kam odjel?“ - „Ach, což já vím! -"
  },
  {
   "texto": "Odejel mil na tisíc,"
  },
  {
   "texto": "o maminku nedbá juž,"
  },
  {
   "texto": "má prý mam těch ještě víc.“"
  },
  {
   "texto": "Nad rovečkem malým živá kostra sedí,"
  },
  {
   "texto": "krásná to kdys žena, ve želu:"
  },
  {
   "texto": "ležíť radovánek bez otce zde dítě, -"
  },
  {
   "texto": "mělať matka mnoho manželů."
  },
  {
   "texto": "Manželů, již z lící porozkvětlých"
  },
  {
   "texto": "růže nevinnosti slíbali,"
  },
  {
   "texto": "a když lístky seschlé v bláto opadaly,"
  },
  {
   "texto": "ještě v smíchu po nich šlapali."
  },
  {
   "texto": "Nesuď nebohé té, dokud neslouchal jsi,"
  },
  {
   "texto": "jakou osud zpíval píseň jí,"
  },
  {
   "texto": "jinde bajadér snad zas by v svatých chrámích"
  },
  {
   "texto": "hanba její došla zšlechtění."
  },
  {
   "texto": "Nevinnost jest bylina jak vodní,"
  },
  {
   "texto": "s větrem po vlnách jenž bludných plove,"
  },
  {
   "texto": "jejíž kořen s vlnou narozený"
  },
  {
   "texto": "samovraždně rybku k hodům zove."
  },
  {
   "texto": "Lehko vězni nevinnost zachovat,"
  },
  {
   "texto": "lehko hlupci býti bez hříchu,"
  },
  {
   "texto": "lehko tomu být i beze hříchu,"
  },
  {
   "texto": "kdo nepoznal hříchů mocnou pýchu."
  },
  {
   "texto": "Nad rovečkem svírá prkno šedé"
  },
  {
   "texto": "malou bytost časně zchřadnulou,"
  },
  {
   "texto": "vůkol věncem zdobí lilje bledé"
  },
  {
   "texto": "posestřenou lilji zvadnulou."
  },
  {
   "texto": "Pozdravení vane matce truhla; -"
  },
  {
   "texto": "neplač, bouř že květ tvůj sklátila:"
  },
  {
   "texto": "dechl mráz a jasná vlna ztuhla,"
  },
  {
   "texto": "než se v řece lidstva zkalila."
  },
  {
   "texto": "Anděl nevinnosti krystaly ty sbírá,"
  },
  {
   "texto": "zahřeje je vlastních prsou v hlubinách,"
  },
  {
   "texto": "skvějí se, kde sama smrt jen zmírá,"
  },
  {
   "texto": "perly rosní po nebeských květinách."
  },
  {
   "texto": "„Co jest Země? - Mocná báně"
  },
  {
   "texto": "z kostí vetchých, z popele,"
  },
  {
   "texto": "velký hřbitov, tvor kde všaký"
  },
  {
   "texto": "druhu tělem ustele."
  },
  {
   "texto": "Báně povrch zlatoskvělá"
  },
  {
   "texto": "hvězdy bílé podoba,"
  },
  {
   "texto": "uvnitř dech a světlou mroucí,"
  },
  {
   "texto": "teskná smrti poroba."
  },
  {
   "texto": "Bytost jakás klamná příkrov"
  },
  {
   "texto": "skvostný na báň prostřela,"
  },
  {
   "texto": "jaký as se děvě dává,"
  },
  {
   "texto": "kdy co poupě zemřela."
  }
 ]
}