 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXLIV."
  },
  {
   "texto": "Starý javor, básník starý,"
  },
  {
   "texto": "v písních dřímá na mechu,"
  },
  {
   "texto": "přišlo dítě osiřelé:"
  },
  {
   "texto": "„Dej, javore, útěchu.“"
  },
  {
   "texto": "„Bloudím unavené lidmi,"
  },
  {
   "texto": "duše hladem umírá,"
  },
  {
   "texto": "každý má jen pro mne kámen,"
  },
  {
   "texto": "srdce své mi zavírá.“"
  },
  {
   "texto": "Starý javor zamyslil se,"
  },
  {
   "texto": "vlastní ňadra rozevře —"
  },
  {
   "texto": "„Půjdem, hochu, uvidíme,"
  },
  {
   "texto": "zda-li které otevře.“"
  },
  {
   "texto": "Spolu chodí — div divoucí!"
  },
  {
   "texto": "Co je písní po lese,"
  },
  {
   "texto": "na housličky v smích je pláčou,"
  },
  {
   "texto": "a to srdcem otřese."
  },
  {
   "texto": "Spolu chodí — div divoucí!"
  },
  {
   "texto": "Starý javor — srdcí pán,"
  },
  {
   "texto": "a kde srdce jenom kousek,"
  },
  {
   "texto": "zotvíráno do kořán."
  },
  {
   "texto": "Po větru starý bodlák"
  },
  {
   "texto": "se klátí v kratochvíl:"
  },
  {
   "texto": "„Má úcta, sedmikrásy,"
  },
  {
   "texto": "rád bych se oženil.“"
  },
  {
   "texto": "A sedmikrása smíchem"
  },
  {
   "texto": "až k zemi dopadá,"
  },
  {
   "texto": "hlavou a rukou kývá"
  },
  {
   "texto": "a družkám rozkládá."
  },
  {
   "texto": "Pan bodlák chutě prázdní"
  },
  {
   "texto": "svých mravů raneček:"
  },
  {
   "texto": "„Nuž prosím, krásné dámy,"
  },
  {
   "texto": "tak malý taneček.“"
  },
  {
   "texto": "A po větru se chlubí:"
  },
  {
   "texto": "„Čest pro vás nelichá;"
  },
  {
   "texto": "mám tělo jako ježek,"
  },
  {
   "texto": "jen hlava pelichá.“"
  },
  {
   "texto": "Tu sedmikrásky smíchem"
  },
  {
   "texto": "až slzy vyroní —"
  },
  {
   "texto": "pan ženich dělal dojem"
  },
  {
   "texto": "a byl jak na koni."
  },
  {
   "texto": "Mně cesta lesem náhle klesá,"
  },
  {
   "texto": "les řidne na průhlednou stromů zeď,"
  },
  {
   "texto": "a zevšad vidím němou odpověď:"
  },
  {
   "texto": "tu stojím na hřbitově lesa."
  },
  {
   "texto": "Hle velký hrob, porostlý mechem;"
  },
  {
   "texto": "jen povězte, kdo v lůno jeho kles’,"
  },
  {
   "texto": "kdo sázel rudý kolem něho vřes,"
  },
  {
   "texto": "kdo rosou lkal tu, kvílel dechem?"
  },
  {
   "texto": "Tam stojí nalomená bříza,"
  },
  {
   "texto": "půl jako kříž a jako kazatel,"
  },
  {
   "texto": "kol strou se kosti práchnivělých těl,"
  },
  {
   "texto": "list, větev, kmen, jimž uschla míza."
  },
  {
   "texto": "Keř jalovec v žebrákův pychu"
  },
  {
   "texto": "pne na pomník se táhlé cypřiše,"
  },
  {
   "texto": "tam skála čeká, kdo-li napíše"
  },
  {
   "texto": "verš o spáčích a jejich tichu."
  },
  {
   "texto": "A němo kol. Tu z blízkých strání"
  },
  {
   "texto": "křik’ sokol, vylít’, náhle k bříze kles’ —"
  },
  {
   "texto": "už vím: co tvorů chová šumný les,"
  },
  {
   "texto": "sem sletují se v umírání."
  },
  {
   "texto": "V hor zelenošerém úbočí"
  },
  {
   "texto": "jdu s nocí v čarovném kruhu,"
  },
  {
   "texto": "tu měsíček bílý vyskočí:"
  },
  {
   "texto": "„Kam jdeš, ty toulavý druhu?“"
  },
  {
   "texto": "A měsíc se na mne podívá,"
  },
  {
   "texto": "tak velkým, pátravým okem,"
  },
  {
   "texto": "jde po stromech, spaní rozlívá,"
  },
  {
   "texto": "jde přes vrch velebným krokem."
  },
  {
   "texto": "Jde na kopců pyšné vroubení,"
  },
  {
   "texto": "s nich k hloubkám jezera kráčí,"
  },
  {
   "texto": "šat průhledný, samé třepení,"
  },
  {
   "texto": "lem zlatý ve vlnách máčí."
  },
  {
   "texto": "Zas v temena hor jde, dosnívá,"
  },
  {
   "texto": "tam v lůžko klade se jemně,"
  },
  {
   "texto": "pak ještě se přes ně podívá —"
  },
  {
   "texto": "„Pojď, hochu toulavý, ke mně.“"
  }
 ]
}