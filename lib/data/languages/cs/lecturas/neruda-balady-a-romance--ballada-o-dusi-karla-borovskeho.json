 "parrafos": [
  {
   "texto": "Po lučině slz a vzdechů"
  },
  {
   "texto": "šly dvě duše v pilném spěchu."
  },
  {
   "texto": "Za nima pak třetí duše,"
  },
  {
   "texto": "hříšná duše těžce kluše."
  },
  {
   "texto": "Když až k ráji dostupaly,"
  },
  {
   "texto": "na dveře tam zaklepaly."
  },
  {
   "texto": "„Vstaňte, Petře, s klíčem jděte,"
  },
  {
   "texto": "kdo to tluče, pohledněte. –“"
  },
  {
   "texto": "„Pane, jdou dvě dobré duše,"
  },
  {
   "texto": "za nima však hříšná kluše. –“"
  },
  {
   "texto": "„Dvěma dobrým přístup dejte,"
  },
  {
   "texto": "však té hříšné nic nedbejte."
  },
  {
   "texto": "Ukažte jí širou cestu,"
  },
  {
   "texto": "kudy k pekelnému městu.“"
  },
  {
   "texto": "Sotva všichni svatí spolu"
  },
  {
   "texto": "k zlatému zas sedli stolu,"
  },
  {
   "texto": "už zas znějí pádné rány"
  },
  {
   "texto": "buch, buch! od nebeské brány."
  },
  {
   "texto": "„Vstaňte, Petře, s klíčem jděte,"
  },
  {
   "texto": "kdo to tluče, pohledněte. –“"
  },
  {
   "texto": "„Je tu zas ta duše hříšná,"
  },
  {
   "texto": "zarputilá, tuze pyšná,"
  },
  {
   "texto": "opírá se celým tělem,"
  },
  {
   "texto": "do vrat našich buší čelem. –“"
  },
  {
   "texto": "„Hned ji odtud vyprovoďte,"
  },
  {
   "texto": "do propasti mně ji shoďte."
  },
  {
   "texto": "Hoďte ji tam vlastní rukou,"
  },
  {
   "texto": "ať se setká s pekel mukou.“ –"
  },
  {
   "texto": "„Ne tak, ne tak, milý synu,"
  },
  {
   "texto": "odpusť hříšné duši vinu!“ –"
  },
  {
   "texto": "„Zeptej se jí, matko milá,"
  },
  {
   "texto": "dobrého co učinila!"
  },
  {
   "texto": "Kolik svátků posvětila,"
  },
  {
   "texto": "kolik pátků postem ctila,"
  },
  {
   "texto": "zda-li také modlitbičku"
  },
  {
   "texto": "posílala ku nebíčku?“ –"
  },
  {
   "texto": "„Já jsem svátků nesvětila,"
  },
  {
   "texto": "ani pátků nepoctila,"
  },
  {
   "texto": "jenom jednu modlitbičku"
  },
  {
   "texto": "poslala jsem ku nebíčku. –“"
  },
  {
   "texto": "„Tedy duše, pěkně klekni,"
  },
  {
   "texto": "modlitbičku svou nám řekni! –“"
  },
  {
   "texto": "„Svatý Jene z Nepomuku,"
  },
  {
   "texto": "drž nad námi Čechy ruku,"
  },
  {
   "texto": "by nám Bůh dal, co dal Tobě,"
  },
  {
   "texto": "náš by jazyk neshnil v hrobě!“"
  },
  {
   "texto": "Usmál se pán Ježíš trochu:"
  },
  {
   "texto": "„Inu – je to divné, hochu!"
  },
  {
   "texto": "Ale předc ta modlitbička"
  },
  {
   "texto": "pomáhá ti do nebíčka."
  },
  {
   "texto": "Sedni vedlé tam té vdovy,"
  },
  {
   "texto": "ať Ti, zač sem přišla, poví. –“"
  },
  {
   "texto": "„Almužny jsem grešli dala,"
  },
  {
   "texto": "nebešťankou jsem se stala."
  },
  {
   "texto": "Grešlička, almužna malá,"
  },
  {
   "texto": "do ráje mně pomáhala.“"
  }
 ]
}