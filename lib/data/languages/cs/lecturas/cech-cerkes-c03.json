 "parrafos": [
  {
   "texto": "od pobřeží známé postavy,"
  },
  {
   "texto": "malebnou směs domácího kroje;"
  },
  {
   "texto": "jak se po lanových žebřících"
  },
  {
   "texto": "vydrápali na paluby pusté"
  },
  {
   "texto": "mužů ozbrojených davy husté,"
  },
  {
   "texto": "vetchých starců, dětí plačících,"
  },
  {
   "texto": "jak se stísnily tam v chomáč pestrý"
  },
  {
   "texto": "postavy děv útlých, bujných žen,"
  },
  {
   "texto": "otec můj a matka, bratří, sestry, -"
  },
  {
   "texto": "celý aúl náš, náš celý kmen!"
  },
  {
   "texto": "Ještě slední bílou podobu"
  },
  {
   "texto": "na břehu jsem spatřil. Zdálo se mi,"
  },
  {
   "texto": "jak bych viděl černé víček lemy"
  },
  {
   "texto": "haliti se v perel ozdobu"
  },
  {
   "texto": "nad závojem bílým, jak by malá"
  },
  {
   "texto": "ručka k horám políbení slala …"
  },
  {
   "texto": "Však i ona vstoupá - zpustly břehy."
  },
  {
   "texto": "Plachty rozpjaly se, vítr čily,"
  },
  {
   "texto": "nad vodou se kotvy zatřpytily"
  },
  {
   "texto": "a vln pobouřených stříkly sněhy"
  },
  {
   "texto": "za kormidlem. Lodi vypluly."
  },
  {
   "texto": "Sedě na temeni skály mračné"
  },
  {
   "texto": "nad mořem, ve výši nedozračné,"
  },
  {
   "texto": "naposled jsem, v sochu ztrnulý,"
  },
  {
   "texto": "uviděl svých bratří pestré davy,"
  },
  {
   "texto": "vše, co z mladosti jsem v lásce měl,"
  },
  {
   "texto": "a zpěv rodný z hrdel tisícerých"
  },
  {
   "texto": "hromem dunící po vlnách šerých"
  },
  {
   "texto": "naposled mi k uchu zaletěl!"
  },
  {
   "texto": "Volně pluly lodi zátokou."
  },
  {
   "texto": "Večer byl. Tu moře znenadání"
  },
  {
   "texto": "pokrylo se vlnou vysokou"
  },
  {
   "texto": "a mrak vyvstal na nebeské báni."
  },
  {
   "texto": "Bouře hrozná vody rozeštvala:"
  },
  {
   "texto": "zatmělo se nad ní - hromu řev -"
  },
  {
   "texto": "časem nebesa se ohněm vzňala,"
  },
  {
   "texto": "posvítila strašný na výjev."
  },
  {
   "texto": "Při blesku, jenž klikatě se míhal,"
  },
  {
   "texto": "pohledem jsem úzkostlivým stíhal"
  },
  {
   "texto": "jednu loď, - v ní bílou podobu."
  },
  {
   "texto": "Viděl jsem, jak na sta bílých ramen"
  },
  {
   "texto": "trčelo z ní k nebi, jak jí plamen"
  },
  {
   "texto": "stěžeň schvátil, jak jí v útrobu"
  },
  {
   "texto": "otevřenou skály ostrým bokem,"
  },
  {
   "texto": "moře vedralo se zlobným tokem"
  },
  {
   "texto": "a jak poklesla a všechno skryl"
  },
  {
   "texto": "příšerným svým křídlem Asrail."
  },
  {
   "texto": "Tehdáž na skále, k níž vlny hřměly,"
  },
  {
   "texto": "za rodiče, bratry, aúl celý,"
  },
  {
   "texto": "za bílou tu podobu, ty davy"
  },
  {
   "texto": "druhů dětství, zápasů a slávy,"
  },
  {
   "texto": "za vše, co jsem z mládí v lásce měl,"
  },
  {
   "texto": "hlasem velikým jsem v bouři pěl"
  },
  {
   "texto": "slova tajemná té velké sury,"
  },
  {
   "texto": "jejíž každá svatá písmena"
  },
  {
   "texto": "deset andělů přivítá shůry,"
  },
  {
   "texto": "aby vzali v jasná ramena"
  },
  {
   "texto": "duši nesmrtnou a v rajská sídla"
  },
  {
   "texto": "bílým davem rozestřeli křídla."
  },
  {
   "texto": "Domodliv se, kinžal vytasený"
  },
  {
   "texto": "přitiskl jsem k rozžhaveným rtům"
  },
  {
   "texto": "a pak opakoval beze změny"
  },
  {
   "texto": "přísahu jsem pomsty k nebesům."
  },
  {
   "texto": "Dlouho skrýval jsem se na útesu."
  },
  {
   "texto": "Teprve, když kouř se poslední"
  },
  {
   "texto": "v dálce ztratil nad vrcholky lesů"
  },
  {
   "texto": "a v hor spoustě nezbylo ni hlesu"
  },
  {
   "texto": "po Rusích, - klid mrtvý ležel v ní -,"
  },
  {
   "texto": "sestoupil jsem s výše. Neobměrnou"
  },
  {
   "texto": "prostorou, kde v bezdna, do oblak"
  },
  {
   "texto": "les jen stoupal, - ba, kam orla zrak"
  },
  {
   "texto": "sáhal bystrého, jenž tečkou černou"
  },
  {
   "texto": "pod modrými kroužil pod výsostmi, -"
  },
  {
   "texto": "sám jsem zůstal s pradědů svých kostmi."
  },
  {
   "texto": "Drahný čas jsem takto sám a sám"
  },
  {
   "texto": "těkal po horách. Tam u studánek"
  },
  {
   "texto": "zarostlých, kde závoj dívčinám"
  },
  {
   "texto": "nezdvíhal již rozpustilý vánek,"
  },
  {
   "texto": "na stezkách, jež zanikaly travou,"
  },
  {
   "texto": "na hrobech, jichž turban dřevěný"
  },
  {
   "texto": "svlačec ověsil svých zvonků slávou,"
  },
  {
   "texto": "v aúlech, jež polozbořeny"
  },
  {
   "texto": "dřímaly sen mrtvý v lesa stínu"
  },
  {
   "texto": "v zeleném rubáši chmelu, révy,"
  },
  {
   "texto": "na ploských kde střechách místo děvy,"
  },
  {
   "texto": "tlukoucí na pestrou tamburinu,"
  },
  {
   "texto": "těkavý jen motýl poletoval,"
  },
  {
   "texto": "rozstíraje křídel azur, nach -"
  },
  {
   "texto": "přísahu jsem svatou opětoval"
  },
  {
   "texto": "a nůž brousil o zapadlý práh."
  },
  {
   "texto": "Po čase mé dýky krutou žízeň"
  },
  {
   "texto": "uhasila Allahova přízeň."
  },
  {
   "texto": "Sjížděli se hosté v lůno skal -"
  },
  {
   "texto": "důstojně jsem ďaury uvítal!"
  },
  {
   "texto": "Zaskřípala kdesi od lesa"
  },
  {
   "texto": "arby nemotorná kolesa."
  },
  {
   "texto": "Řeci dva si hoví v jejím dně,"
  },
  {
   "texto": "posunují líně, bezpečně"
  },
  {
   "texto": "třásní pestrou ovinuté fesy"
  },
  {
   "texto": "a jak supi vyzírají v lesy"
  },
  {
   "texto": "němé, mrtvé. Dvě to první káně"
  },
  {
   "texto": "spustily se na kraj zemřelý -"
  },
  {
   "texto": "jeden z nich se nahodil mi k ráně"
  },
  {
   "texto": "a druh klesl břitkou ocelí."
  },
  {
   "texto": "Koní klus mne v jinou zvábil stranu."
  },
  {
   "texto": "Hle, tam Armén v čapce baňaté"
  },
  {
   "texto": "z jemně vlnitého astrachanu,"
  },
  {
   "texto": "v čoše temné, stříbrem sepjaté,"
  },
  {
   "texto": "jejíž dlouhé, černé rukávy"
  },
  {
   "texto": "od loktů mu visí po třemeny,"
  },
  {
   "texto": "volně jede vedle krásné ženy,"
  },
  {
   "texto": "laškuje s ní, družně rozpráví."
  },
  {
   "texto": "Nevěstu si k Nov´rossijsku vede."
  },
  {
   "texto": "Věru krásná jest! Hle z nyvě bledé,"
  },
  {
   "texto": "lásky kouzlem ovanuté tváře"
  },
  {
   "texto": "jak se blýská očí velikých"
  },
  {
   "texto": "dlouhou řasou přitlumená záře!"
  },
  {
   "texto": "A co perlí, tretek všelikých"
  },
  {
   "texto": "zavěšeno v zlaté čelence"
  },
  {
   "texto": "kolébá se! Jako mlha bílá"
  },
  {
   "texto": "tenký, řásný závoj obestýlá"
  },
  {
   "texto": "havraní jí vlasů prstence."
  },
  {
   "texto": "Jak se vábně na sedélku houpá"
  },
  {
   "texto": "a jak ve třemenech s obou stran"
  },
  {
   "texto": "okazují roucha světlá, skoupá,"
  },
  {
   "texto": "svůdně kradmo růžný safián,"
  },
  {
   "texto": "útlých nožek vyzdobené skrýše,"
  },
  {
   "texto": "jako trepky z trpasličí říše!"
  },
  {
   "texto": "Nespasil ji půvab přeskvělý,"
  },
  {
   "texto": "šťastné lásky sladké cukrování:"
  },
  {
   "texto": "oddal jsem je pod lesnatou strání"
  },
  {
   "texto": "zkrvácenou šavle ocelí,"
  },
  {
   "texto": "v jezeře pak horském rozespalá"
  },
  {
   "texto": "vlna lůžko svatební jim stlala."
  },
  {
   "texto": "Oj, což uvrhl jsem ztuhlých těl"
  },
  {
   "texto": "v pusté sluje! Marně Hebrej starý"
  },
  {
   "texto": "třesavou mi rukou nabízel"
  },
  {
   "texto": "z tlumoků svých nejvzácnější dary:"
  },
  {
   "texto": "čepele, v jichž divném zákalu"
  },
  {
   "texto": "míhaly se jako v siné mlze"
  },
  {
   "texto": "verše zlaté, perlí mléčné slze,"
  },
  {
   "texto": "skříně drahokamů, korálů,"
  },
  {
   "texto": "Persie a Hindustanu divy"
  },
  {
   "texto": "za svůj život bídný, plahočivý!"
  },
  {
   "texto": "Kolikrát jsem k ruským srdcím razil"
  },
  {
   "texto": "krvavou si cestu kinžalem,"
  },
  {
   "texto": "a co lichých modliteb jsem zmrazil"
  },
  {
   "texto": "popům vašim na rtu zsinalém."
  },
  {
   "texto": "A kde čapka kozácká se mihla -"
  },
  {
   "texto": "kule má ji dozajista stihla!"
  },
  {
   "texto": "Nikoli! Přec jednou kolem čela"
  },
  {
   "texto": "na plano kozáku zafičela."
  },
  {
   "texto": "Na to boj jsme svedli zoufalý"
  },
  {
   "texto": "na výšině srázné, lící v líce,"
  },
  {
   "texto": "šavlemi jak blesky mávajíce"
  },
  {
   "texto": "na se doráželi, couvali,"
  },
  {
   "texto": "až pak na lem bezdny nedohledné"
  },
  {
   "texto": "v strašlivém jsme klesli objetí,"
  },
  {
   "texto": "dvojité jak tělo šelmy jedné,"
  },
  {
   "texto": "v oku plamen, na rtu prokletí,"
  },
  {
   "texto": "krví vlastní, odpůrcovou rudé."
  },
  {
   "texto": "Přál mi Allah! Do mohutné hrudi"
  },
  {
   "texto": "koleno své soupeři jsem vtiskl,"
  },
  {
   "texto": "břitký kinžal v levici mé blýskl,"
  },
  {
   "texto": "- pravicí již nemohl jsem vlásti, -"
  },
  {
   "texto": "navždy zrak mu zlobný zavřela"
  },
  {
   "texto": "ocel má - trup sletl do propasti -"
  },
  {
   "texto": "však mé smysly mdloba zavřela."
  },
  {
   "texto": "Když jsem procitl, mír svatý kol."
  },
  {
   "texto": "Bez hnutí, jak ve snách jsem se díval"
  },
  {
   "texto": "jak mi nad hlavou svým zvoncem kýval"
  },
  {
   "texto": "azurovým zelenavý stvol,"
  },
  {
   "texto": "jak tam blankyt zářil převysoko,"
  },
  {
   "texto": "jak tu kolem krunýř těžký, velký"
  },
  {
   "texto": "želva vlekla, travin za stebélky"
  },
  {
   "texto": "vyhlíželo květů rudé oko,"
  },
  {
   "texto": "a jak had se svíjel v lepé kruhy"
  },
  {
   "texto": "a hrál šíjí ve všech barvách duhy."
  },
  {
   "texto": "Zřel jsem na vše, jak bych volným duchem"
  },
  {
   "texto": "již se vznášel nad tím zemským ruchem."
  },
  {
   "texto": "Náhle opodál se z květné řásy"
  },
  {
   "texto": "vynořila děva zvláštní krásy"
  },
  {
   "texto": "v cizím kroji. Na milostném čele"
  },
  {
   "texto": "slunce zlatý paprsek se chvěl,"
  },
  {
   "texto": "v líci, na rtu, po celičkém těle"
  },
  {
   "texto": "panenství jí zářil čistý pel."
  },
  {
   "texto": "Myslil jsem, že Risvan, strážce ráje,"
  },
  {
   "texto": "vstříc mi poslal jednu z rajských děv,"
  },
  {
   "texto": "by mi vyměnila zemské kraje"
  },
  {
   "texto": "za mech vonný nebeského háje"
  },
  {
   "texto": "a rtů sladkých věčný za úsměv."
  },
  {
   "texto": "Spatřila mne - couvla v leknutí -"
  },
  {
   "texto": "oči zavřel jsem. Pak cosi ke mně"
  },
  {
   "texto": "sklonilo se, jak by anděl jemně"
  },
  {
   "texto": "nade mnou povíval perutí."
  },
  {
   "texto": "A když opět pohlédl jsem vzhůru,"
  },
  {
   "texto": "ponořil se zrak můj do azuru"
  },
  {
   "texto": "očí dvou, jež slitování plny"
  },
  {
   "texto": "na mne hledí, bloudí kolkolem"
  },
  {
   "texto": "a rtů drobné, rubínové vlny"
  },
  {
   "texto": "neznámým se chvějí hlaholem."
  },
  {
   "texto": "„Čerkes,“ šeptám a prst na rty kladu -"
  },
  {
   "texto": "jak my anděl spáchati moh´ zradu!!"
  },
  {
   "texto": "Povstala, mou přílbu z trávy zdvihla,"
  },
  {
   "texto": "jako motýl křovisky se mihla."
  },
  {
   "texto": "Vrátila se s vodou - krev mi smyla,"
  },
  {
   "texto": "uhasila žízeň plamennou,"
  },
  {
   "texto": "vlastní rouškou jemně obtočila"
  },
  {
   "texto": "pravici mou tuhou, zchromenou."
  },
  {
   "texto": "Pak můj těžký podpírala krok"
  },
  {
   "texto": "k jeskyni, již před mnohými lety"
  },
  {
   "texto": "samotář si vyryl v hory bok,"
  },
  {
   "texto": "vystlala ji travou, mechem, květy,"
  },
  {
   "texto": "pečlivě pak burku rozestřela -"
  },
  {
   "texto": "a čas drahný nad mým ložem dlela."
  },
  {
   "texto": "A když vstala, z oka třpytné vláhy"
  },
  {
   "texto": "vyčetl jsem, že se vrátí záhy."
  },
  {
   "texto": "Vrátila se. Z jitra každý den"
  },
  {
   "texto": "keř se zachvěl, clonící mou skrýši,"
  },
  {
   "texto": "hebounkými prsty rozestřen"
  },
  {
   "texto": "a jak obraz nadoblačnou říší"
  },
  {
   "texto": "v rámci jeho větví, květem bílých,"
  },
  {
   "texto": "obličej se jevil rysů milých."
  },
  {
   "texto": "Nosila mi pokrm; vedla řeči"
  },
  {
   "texto": "neznámé, přec plné útěchy"
  },
  {
   "texto": "a zrak modrojasný v sladké péči"
  },
  {
   "texto": "upírala na mne s povzdechy."
  },
  {
   "texto": "Záhy jsem těm vzdechům rusovlásky,"
  },
  {
   "texto": "blankytným těm očím rozuměl"
  },
  {
   "texto": "a sen zašlý o rozkoších lásky"
  },
  {
   "texto": "nad hlavou mi křídlem zašuměl."
  },
  {
   "texto": "Allah ví, co bouřilo mé nitro,"
  },
  {
   "texto": "když se z rána přívětivá líc"
  },
  {
   "texto": "nade mnou, jak samo krásné jitro,"
  },
  {
   "texto": "ukláněla, pozdrav šeptajíc,"
  },
  {
   "texto": "a v tom líci něžném, když jsem vídal,"
  },
  {
   "texto": "jak se purpur s padlým sněhem střídal."
  },
  {
   "texto": "Allah ví, že nepohnul jsem ani"
  },
  {
   "texto": "rukou poraněnou - z bázně pouhé,"
  },
  {
   "texto": "abych v zdravé neucítil dlani,"
  },
  {
   "texto": "že je syta nečinnosti dlouhé."
  },
  {
   "texto": "Ale jednou nepokojné spaní"
  },
  {
   "texto": "sprostilo ji vazby. A když ruku"
  },
  {
   "texto": "napřáhl jsem v bouřné srdce tluku,"
  },
  {
   "texto": "napjaly se pevně svaly, žíly"
  },
  {
   "texto": "a v nich staré ucítil jsem síly."
  },
  {
   "texto": "Zdráv jsem povstal. Opásav se zbrojí"
  },
  {
   "texto": "do hor jsem se vydal. Den byl mračný."
  },
  {
   "texto": "Kolem skály zasmušile stojí"
  },
  {
   "texto": "a jich čela oblak neprůzračný"
  },
  {
   "texto": "smuteční jak závoj řásně halí."
  },
  {
   "texto": "Nebe zakaleno; hřímá v dáli."
  },
  {
   "texto": "Bloudím, hledám aúl povědomý."
  },
  {
   "texto": "Stezky již jsem nenašel, ni stopy"
  },
  {
   "texto": "nohou čerkeských. Jen chedbí klopí"
  },
  {
   "texto": "široký tu list. Jak pusté lomy"
  },
  {
   "texto": "zbořený tam aúl v divé houšti"
  },
  {
   "texto": "ani srnu k sobě nepropouští."
  },
  {
   "texto": "Na mohyle turban dřevěný"
  },
  {
   "texto": "zvrácen hnije. Kolem bílé kosti"
  },
  {
   "texto": "rozvlékaly zuby nočních hostí."
  },
  {
   "texto": "Ba, již mech a svlačců prsteny"
  },
  {
   "texto": "obalily mnohou lebku dědů,"
  },
  {
   "texto": "že je sotva značna tvému hledu."
  },
  {
   "texto": "Hoj, tak ničí krutá příroda"
  },
  {
   "texto": "velkého tu stopy národa,"
  },
  {
   "texto": "až se ztratí navždy, beze sledu,"
  },
  {
   "texto": "až kraj ten, jak pustá mohyla,"
  },
  {
   "texto": "bez popsané desky, bez znamení"
  },
  {
   "texto": "pod trninu, vývrať, pod kamení"
  },
  {
   "texto": "pohřbí vše, co tuto robila"
  },
  {
   "texto": "naše ruka, naše boly, štěstí,"
  },
  {
   "texto": "naše jména vrhne do nezvěsti,"
  },
  {
   "texto": "o Čerkesích stoleté ni duby"
  },
  {
   "texto": "nezašeptnou. - Zaskřípal jsem zuby."
  },
  {
   "texto": "Noc mi skryla smutné divadlo."
  },
  {
   "texto": "Bouř se přivalila, krajem duní,"
  },
  {
   "texto": "jako tehdáž, kdy mi v mořské tůni"
  },
  {
   "texto": "vše, co měl jsem, navždy zapadlo."
  },
  {
   "texto": "A zas velikou jsem zpíval suru,"
  },
  {
   "texto": "ale nyní shůry nade mnou"
  },
  {
   "texto": "jejích veršů mocí tajemnou"
  },
  {
   "texto": "nesechvěl se roj andělských kůrů."
  },
  {
   "texto": "Zdálo se mi, jak by každým slovem"
  },
  {
   "texto": "stín se zdvíhal nad zapadlým rovem,"
  },
  {
   "texto": "jak by duchové mých předků všech"
  },
  {
   "texto": "z hrobů svých tam v horách, úvalech"
  },
  {
   "texto": "ke mně nocí bouřlivou se chvěli,"
  },
  {
   "texto": "za mnou houšť a šíř a výš se střeli -"
  },
  {
   "texto": "nepřehledný, nesčíslný sbor -"
  },
  {
   "texto": "jak by letící ta spousta duchů,"
  },
  {
   "texto": "jak by vodopády, vršky hor,"
  },
  {
   "texto": "celá příroda v úžasném ruchu"
  },
  {
   "texto": "hřímala mi v ucho strašný zpěv,"
  },
  {
   "texto": "volající: krev a krev a krev!"
  },
  {
   "texto": "Letěl jsem, jak démon, nocí temnou,"
  },
  {
   "texto": "bystrým letem smrtonosných střel"
  },
  {
   "texto": "a ten krvelačný přízrak se mnou"
  },
  {
   "texto": "přes rokle a srázy burácel."
  },
  {
   "texto": "Svit mne spatřil na jeskyně prahu."
  },
  {
   "texto": "Sedím klidně. Ruky na dosahu"
  },
  {
   "texto": "okazuje pochva zedraná"
  },
  {
   "texto": "lesklý ocel, zpola vydobytý;"
  },
  {
   "texto": "z rukojeti metá rudé svity"
  },
  {
   "texto": "drahokam jak oko satana."
  },
  {
   "texto": "Přišla děva. Nesla chléb a vodu;"
  },
  {
   "texto": "těšila se náhlé proměně,"
  },
  {
   "texto": "uzdravení mému. Na odchodu"
  },
  {
   "texto": "stanula přede mnou zmateně"
  },
  {
   "texto": "a co hádal, tušíval jsem vezdy,"
  },
  {
   "texto": "věstily mi očí krásné hvězdy."
  },
  {
   "texto": "Poprvé jsem ovinul jí ruku"
  },
  {
   "texto": "kolem šíje; první srdce děví"
  },
  {
   "texto": "zabušilo na mém v libém tluku."
  },
  {
   "texto": "Přivila se ke mně něhou révy."
  },
  {
   "texto": "V bílé čelo polibek jsem vtiskl,"
  },
  {
   "texto": "tajně kinžal v pravici mé blýskl,"
  },
  {
   "texto": "jednou ranou bezpečně a jistě"
  },
  {
   "texto": "zahýřil si v nejkrásnějším místě -"
  },
  {
   "texto": "v ňadru jejím - klesla mrtva k zemi -"
  },
  {
   "texto": "a já o vlas jasný - -„"
  },
  {
   "texto": "V půli řeči"
  },
  {
   "texto": "Čerkes zaúpěl. Blíž něho klečí"
  },
  {
   "texto": "mladý kozák, děsně bledý, němý,"
  },
  {
   "texto": "patře divoce, jak úzká rýha"
  },
  {
   "texto": "čepele, jejž nad zajatcem zdvíhá,"
  },
  {
   "texto": "rudými se plní krůpějemi."
  },
  {
   "texto": "Starší kozák, nad Čerkesem skloniv"
  },
  {
   "texto": "šedou hlavu, čelo zakaboniv,"
  },
  {
   "texto": "hlasem, plným trpké pohany,"
  },
  {
   "texto": "druhu zašeptal: „Byl bezbranný!“"
  },
  {
   "texto": "Ale Čerkes mroucí zahovořil:"
  },
  {
   "texto": "„Díky za ránu, jíž jsem si přál!"
  },
  {
   "texto": "V hruď mou kinžal poctivý se vnořil -"
  },
  {
   "texto": "Rus mne v šerou nepovleče dál"
  },
  {
   "texto": "spoutaného, dětem na posměch -"
  },
  {
   "texto": "hory přijmou poslední můj vzdech!"
  },
  {
   "texto": "Slyšte prosbu: V mnohé čestné seči"
  },
  {
   "texto": "proti vám jsem stával tváří v tvář,"
  },
  {
   "texto": "za sled mnohý po kuli a meči"
  },
  {
   "texto": "zakoupil svým skráním slávy zář."
  },
  {
   "texto": "Pohřeb čestný bojovníku přejte:"
  },
  {
   "texto": "v rodné půdě hrob mi vykopejte,"
  },
  {
   "texto": "ruce rozvažte, ať ležím v něm"
  },
  {
   "texto": "hrdina jak volný; stranou k Mece"
  },
  {
   "texto": "obraťte tvář moji, na mé plece"
  },
  {
   "texto": "složte štít i pušku s kinžalem,"
  },
  {
   "texto": "budiž účastna též mého lůžka"
  },
  {
   "texto": "šavle obnažená, věrná družka,"
  },
  {
   "texto": "zlatého ať bleskem nápisu, -"
  },
  {
   "texto": "svatým veršem hrozí Eblisu."
  },
  {
   "texto": "Pak hrob nízký vyrovnejte zemí, -"
  },
  {
   "texto": "ať tu zaroste, ať navždy němý"
  },
  {
   "texto": "v noci ďaura zvěstí nepoleká,"
  },
  {
   "texto": "že tu Čerkes na den soudu čeká!“"
  },
  {
   "texto": "Růžemi když jitra hory vzplály,"
  },
  {
   "texto": "kozáci mu pod vysokou strání"
  },
  {
   "texto": "šavlemi hrob chladný vykopali,"
  },
  {
   "texto": "pohřbili jej čestně - podle přání -"
  },
  {
   "texto": "a dál k Nov´rossijsku klusali"
  },
  {
   "texto": "lesnatými svahy, úvaly."
  }
 ]
}