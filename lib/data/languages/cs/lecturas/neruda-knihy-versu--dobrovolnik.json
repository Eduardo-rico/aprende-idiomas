 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Dobrovolník"
  },
  {
   "texto": "„Hudbu novou, pivo nové,"
  },
  {
   "texto": "ať se hoši veselí,"
  },
  {
   "texto": "zpijou-li se, vyspějí se"
  },
  {
   "texto": "ve vojenské posteli!“"
  },
  {
   "texto": "Divně, divě zveselení"
  },
  {
   "texto": "sedí hoši pospolu,"
  },
  {
   "texto": "hulákají, proklínají,"
  },
  {
   "texto": "perou džbánkem do stolu."
  },
  {
   "texto": "Divná, zběsilá to radosť,"
  },
  {
   "texto": "strojena jak pro lháře,"
  },
  {
   "texto": "jenom chvilkou leckde skane"
  },
  {
   "texto": "pravdy slza přes tváře."
  },
  {
   "texto": "Nebylo by věru divu,"
  },
  {
   "texto": "kdyby více tropili,"
  },
  {
   "texto": "vždyť dnes sobě na ztracenou"
  },
  {
   "texto": "volnosť bujně připili!"
  },
  {
   "texto": "„Hudbu novou, pivo nové —"
  },
  {
   "texto": "nemáš chuti ku vojně?"
  },
  {
   "texto": "hochu bledý, hledíš jako"
  },
  {
   "texto": "ve zoufalství pokojně."
  },
  {
   "texto": "Ztýraný a otrhaný,"
  },
  {
   "texto": "prací vyschlý, znavený —"
  },
  {
   "texto": "připij sobě, budeš mdlob svých"
  },
  {
   "texto": "jedním douškem zbavený!"
  },
  {
   "texto": "Miluješ snad? —jakžpak může"
  },
  {
   "texto": "chudý myslet na lásku —"
  },
  {
   "texto": "vyrazíš se — vykonáme"
  },
  {
   "texto": "světem malou procházku!“"
  },
  {
   "texto": "Mlčky bledý hoch se zase"
  },
  {
   "texto": "k němé zemi zahledí,"
  },
  {
   "texto": "jakby kámen měl mu říci,"
  },
  {
   "texto": "o čem lidé nevědí."
  },
  {
   "texto": "„„Matičko má, nemohu už"
  },
  {
   "texto": "práce více zastati,"
  },
  {
   "texto": "matičko má drahá — drahá —"
  },
  {
   "texto": "musíš sama zůstati!"
  },
  {
   "texto": "Hladová jsi, matičko má,"
  },
  {
   "texto": "a tvůj syn je v chorobě —"
  },
  {
   "texto": "snad se ujmou žebravé mé"
  },
  {
   "texto": "matičky pak v sirobě."
  },
  {
   "texto": "Dokud syn tě starou živí,"
  },
  {
   "texto": "žádný chleba nepodá —"
  },
  {
   "texto": "syn už churav, tobě ale"
  },
  {
   "texto": "ještě krev svou zaprodá!““"
  },
  {
   "texto": "Verbíř hocha pozoruje,"
  },
  {
   "texto": "vidí slzu kanoucí,"
  },
  {
   "texto": "vidí tvář se znovu rdící,"
  },
  {
   "texto": "oko znovu planoucí."
  },
  {
   "texto": "„Novou píseň hrajte, hoši,"
  },
  {
   "texto": "ať mu hlavu napraví!"
  },
  {
   "texto": "zde je zlato — nuže, připij! —“"
  },
  {
   "texto": "„„Nuže, bratře, na zdraví!\"“"
  },
  {
   "texto": "Před mrzutým soudcem děvče stojí,"
  },
  {
   "texto": "studem, strachem oči k zemi klopí,"
  },
  {
   "texto": "vyhaslé má oči, bledé tváře,"
  },
  {
   "texto": "na rtech hřích a v tvářích hříchu stopy."
  },
  {
   "texto": "Soudce pokračuje: „Pověz nyní,"
  },
  {
   "texto": "co ta stébla asi znamenají;"
  },
  {
   "texto": "skrývala's je na prsou svých — jisto,"
  },
  {
   "texto": "že cos zvláštního ta stébla tají“ —"
  },
  {
   "texto": "Děvčeti se náhle oči zrosí —"
  },
  {
   "texto": "„„Ovšem, že cos tají — ty můj bože,"
  },
  {
   "texto": "dalo mně tři stébla na památku"
  },
  {
   "texto": "troje slzami provlhlé lože."
  },
  {
   "texto": "První stéblo, zde to žluté dlouhé,"
  },
  {
   "texto": "líhávalo se mnou na otepi,"
  },
  {
   "texto": "když umíral v náruči mé slabé"
  },
  {
   "texto": "hladem nebohý můj otec slepý."
  },
  {
   "texto": "Druhé rudší, kratší vzato z lože,"
  },
  {
   "texto": "na němž bratr u vězení zchřadl;"
  },
  {
   "texto": "drahý bratr živil mne i sebe,"
  },
  {
   "texto": "měli hlad jsme — a — můj bratr kradl."
  },
  {
   "texto": "Třetí nejkratší a nejbělejší,"
  },
  {
   "texto": "jediná to památka mně zbyla"
  },
  {
   "texto": "z lože, na němž matka beznadějná"
  },
  {
   "texto": "mrtvé jsem své dítě porodila.““ —"
  }
 ]
