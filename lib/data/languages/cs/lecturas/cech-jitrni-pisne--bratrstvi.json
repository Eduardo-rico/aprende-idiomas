 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Bratrství"
  },
  {
   "texto": "Odhoďme ten kalich žluči,"
  },
  {
   "texto": "z něhož moru dech se chví,"
  },
  {
   "texto": "nechať kolem jasně zvučí"
  },
  {
   "texto": "svatý pohár bratrství."
  },
  {
   "texto": "Nechtěj nikdo po své hlavě"
  },
  {
   "texto": "všechny v jeden útvar skout;"
  },
  {
   "texto": "dokud národ bují zdravě,"
  },
  {
   "texto": "různo kypí žití proud."
  },
  {
   "texto": "Jdeme-li jen k témuž cíli,"
  },
  {
   "texto": "vznět-li stejný srdcem chví,"
  },
  {
   "texto": "však se najdem’ v pravou chvíli"
  },
  {
   "texto": "pod jedinou korouhví."
  },
  {
   "texto": "Cit a rozum dejte zbraně,"
  },
  {
   "texto": "jimiž druhu čelí druh,"
  },
  {
   "texto": "dravé zášti, vzteklé haně"
  },
  {
   "texto": "hraďme cestu v český kruh."
  },
  {
   "texto": "Kdo chceš hasit bratrů sváry,"
  },
  {
   "texto": "očisť láskou vlastní hruď,"
  },
  {
   "texto": "utlum v sobě zlobné žáry,"
  },
  {
   "texto": "sám vždy snášenlivým buď,"
  },
  {
   "texto": "odhoď trpký kalich žluči,"
  },
  {
   "texto": "z něhož moru dech se chví,"
  },
  {
   "texto": "nechať jasně kolem zvučí"
  },
  {
   "texto": "svatý pohár bratrství!"
  },
  {
   "texto": "Výše ten prapor červenobílý,"
  },
  {
   "texto": "hrdě ať zase k nebesům vlá,"
  },
  {
   "texto": "v pažích ať nové procitnou síly,"
  },
  {
   "texto": "k činům se vypne pravice mdlá,"
  },
  {
   "texto": "znovu se vzpruží kročej náš vratký,"
  },
  {
   "texto": "naděje smělá rozjiskří hled -"
  },
  {
   "texto": "za čest a právo, za drahé statky"
  },
  {
   "texto": "veselo v před!"
  },
  {
   "texto": "Slyšte, jak šumí prapor ten starý"
  },
  {
   "texto": "o mrtvých recích, na nimiž vlál,"
  },
  {
   "texto": "kolikrát nesl odpůrci zmary,"
  },
  {
   "texto": "kolikrát v záři vítězně plál -"
  },
  {
   "texto": "V krvavých cárech, do prachu kleslý"
  },
  {
   "texto": "stlíval pak žalně po mnohý čas,"
  },
  {
   "texto": "ale zas ruce věrného vznesly"
  },
  {
   "texto": "v nebeský jas."
  },
  {
   "texto": "Splýval nám, bratři, na mladé spánky,"
  },
  {
   "texto": "budil v nich roje vznešených dum,"
  },
  {
   "texto": "zdouval se pyšně jarními vánky,"
  },
  {
   "texto": "zněl nám jak orlích perutí šum -"
  },
  {
   "texto": "Ale pak čela klesala, stydla,"
  },
  {
   "texto": "mdloba nám ruce spoutala všem,"
  },
  {
   "texto": "prapor náš svěsil mohutná křídla,"
  },
  {
   "texto": "schýlil se v zem."
  },
  {
   "texto": "Pohleď, ó lide, záští jak šlape"
  },
  {
   "texto": "drahé ty třásně v nepřátel smích,"
  },
  {
   "texto": "lecjaká noha po žerdi tlape,"
  },
  {
   "texto": "ruměné krví praotců tvých."
  },
  {
   "texto": "Prapor, jejž slzy nadšené světí,"
  },
  {
   "texto": "má-li jim směšným strašákem slout,"
  },
  {
   "texto": "má-li zde tlíti hříčka jak dětí,"
  },
  {
   "texto": "hozená v kout?!"
  },
  {
   "texto": "Druhdy jsme pod ním v lopotném boji"
  },
  {
   "texto": "snášeli hojně strastí a běd,"
  },
  {
   "texto": "mnohdy se chvěli v tísni a znoji,"
  },
  {
   "texto": "ale přec chutě kráčeli v před."
  },
  {
   "texto": "Skloněn je teď, a škůdce si praví,"
  },
  {
   "texto": "navždy že vypad’ ramenům mdlým,"
  },
  {
   "texto": "korouhev klesá v posměch mu žhavý,"
  },
  {
   "texto": "v potupný šprým."
  },
  {
   "texto": "Bratři, zda plápol hněvu a studu"
  },
  {
   "texto": "mdloby vám chmůru neproudí s čel?"
  },
  {
   "texto": "Raději nazpět do těžkých trudů,"
  },
  {
   "texto": "v zápasy, strasti, do deště střel!"
  },
  {
   "texto": "Svěží zas v pažích najdeme síly,"
  },
  {
   "texto": "vytryskne znovu nadšení zdroj, -"
  },
  {
   "texto": "vzhůru zas prapor červenobílý"
  },
  {
   "texto": "vytyčme v boj!"
  }
 ]
}