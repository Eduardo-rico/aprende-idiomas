  "titulo": "Pohádky z naší vesnice",
  "orden": 7
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Choděra"
  },
  {
   "texto": "Prostovlasý, rozcuchaný"
  },
  {
   "texto": "na návsi se rozhání:"
  },
  {
   "texto": "„Slyšte, lidé, na vše strany,"
  },
  {
   "texto": "budu míti kázání!“"
  },
  {
   "texto": "Po kněžsku vydychnul z hrudi,"
  },
  {
   "texto": "dělal křížů znamení:"
  },
  {
   "texto": "„Praví kněz: my, co jsme chudí,"
  },
  {
   "texto": "že jsme blahoslavení."
  },
  {
   "texto": "Tobě snadno v to se míchat,"
  },
  {
   "texto": "kdyžs tak svatě natylý,"
  },
  {
   "texto": "a vám snadno o tom slýchat,"
  },
  {
   "texto": "když jste tělo spravili."
  },
  {
   "texto": "Ale jak to chudým snadné,"
  },
  {
   "texto": "slyšte slova proroků:"
  },
  {
   "texto": "hle, nám tělo tuze chřadne"
  },
  {
   "texto": "bez střechy a obroku!"
  },
  {
   "texto": "Chudý — svatý! V tom-li vězí"
  },
  {
   "texto": "svátostí všech prameny,"
  },
  {
   "texto": "co pak vadí vám i knězi,"
  },
  {
   "texto": "by byl blahoslavený?"
  },
  {
   "texto": "Na rok jen se do mne vtělit —"
  },
  {
   "texto": "vsadím, že z té výměny"
  },
  {
   "texto": "za půl léta bude pelit"
  },
  {
   "texto": "jako komoň splašený!"
  },
  {
   "texto": "Vítr, déšť ne zhruba lidsky"
  },
  {
   "texto": "vous mi češou, šediny,"
  },
  {
   "texto": "a váš pes tak uličnicky"
  },
  {
   "texto": "v šat mi dělá štěrbiny,"
  },
  {
   "texto": "a vy, přijdu-li k vám s prosbou,"
  },
  {
   "texto": "nejste lepší o mnoho,"
  },
  {
   "texto": "sám váš kněz mne vítal s hrozbou —"
  },
  {
   "texto": "tisíc láter do toho!“"
  },
  {
   "texto": "K zemi klesá, pozvednou ho —"
  },
  {
   "texto": "„Slyšte konec kázání,"
  },
  {
   "texto": "já jsem svatým tuze dlouho,"
  },
  {
   "texto": "a mám špatné zastání,"
  },
  {
   "texto": "srdce puklé, zvadlé síly,"
  },
  {
   "texto": "v duši vše tak zmatené —“"
  },
  {
   "texto": "kles’ a už ho nevzkřísili"
  },
  {
   "texto": "mezi blahoslavené."
  },
  {
   "texto": "Jde měsíček vejpůl nakrojen,"
  },
  {
   "texto": "v běl řeka leskne se, hučí,"
  },
  {
   "texto": "les ze sna tak dýchá spokojen"
  },
  {
   "texto": "a v ptáků nápěvy pučí."
  },
  {
   "texto": "Dva stíny si sedly u řeky,"
  },
  {
   "texto": "cos s rukou smývají, šatů —"
  },
  {
   "texto": "„Ač prokleti snad jsme na věky,"
  },
  {
   "texto": "já nechci dozráti katu.“"
  },
  {
   "texto": "Tu povídá druhý: „V duše tmách"
  },
  {
   "texto": "už zhasla hvězda mi každá,"
  },
  {
   "texto": "kam duše jen pne se v myšlenkách,"
  },
  {
   "texto": "na každé sedí jí vražda.“"
  },
  {
   "texto": "A první: „Toť naše řemeslo,"
  },
  {
   "texto": "stín časem počíná lekat,"
  },
  {
   "texto": "a chceš-li, by katu vyneslo,"
  },
  {
   "texto": "jen počni k pokání hekat.“"
  },
  {
   "texto": "A povídá druhý: „V duši mé"
  },
  {
   "texto": "noc lká, sejc houká si hlasně,"
  },
  {
   "texto": "hlad vyje, a nežli tušíme,"
  },
  {
   "texto": "vlk o dlaň otře si dásně.“"
  },
  {
   "texto": "A první: „Mít duši takovou,"
  },
  {
   "texto": "jež lup by chtěla mi kazit,"
  },
  {
   "texto": "hle, zbraň na ni mám již hotovou"
  },
  {
   "texto": "a v hrdlo umím ji vrazit.“"
  },
  {
   "texto": "Dva poskočí stíny na břehu,"
  },
  {
   "texto": "jak vlk se za vlkem honí —"
  },
  {
   "texto": "skví voda se jako do sněhu,"
  },
  {
   "texto": "dva stíny strhly se do ní."
  }
 ]
}