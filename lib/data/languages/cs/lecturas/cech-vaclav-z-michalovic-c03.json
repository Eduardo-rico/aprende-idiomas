{
 "id": "cech-vaclav-z-michalovic-c03",
 "titulo": "Zpěv druhý",
 "autor": "Svatopluk Čech",
 "muerteAutor": 1908,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V%C3%A1clav_z_Michalovic/Zp%C4%9Bv_druh%C3%BD",
 "fuente": "cs.wikisource.org, «Václav z Michalovic»",
 "licencia": "dominio público (autor muerto en 1908)",
 "nivel": "C1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "cech-vaclav-z-michalovic",
  "titulo": "Václav z Michalovic",
  "orden": 3
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Nežli hod se zjařil révy mokem,"
  },
  {
   "texto": "novicové, po tichounku vstavše"
  },
  {
   "texto": "a dík všehodárci zašeptavše,"
  },
  {
   "texto": "z refektáře vyšli vážným krokem."
  },
  {
   "texto": "Volný čtverec ve svých budov lůně"
  },
  {
   "texto": "ponechala kollej pochmurná,"
  },
  {
   "texto": "plný listů šeptavých a vůně,"
  },
  {
   "texto": "kamo klenba nebes azurná"
  },
  {
   "texto": "volně můž’ svou září pronikati,"
  },
  {
   "texto": "rozsévati kvítím zlatý pel,"
  },
  {
   "texto": "se stíny se hravě potýkati"
  },
  {
   "texto": "vážných budov, asketických čel."
  },
  {
   "texto": "Tritona tu mramorový ret"
  },
  {
   "texto": "k nebi chrlí jasný vodomet;"
  },
  {
   "texto": "na každém pak rohu toho zřídla"
  },
  {
   "texto": "andílek rozpíná bílá křídla"
  },
  {
   "texto": "a tu vláhu rozprášenou s hůry"
  },
  {
   "texto": "s úsměvem si chytá do lastury."
  },
  {
   "texto": "Milo dlít na stupních vodojemu"
  },
  {
   "texto": "v stínu kaštanů, jež kloní k němu"
  },
  {
   "texto": "lupenů svých jasné vějíře,"
  },
  {
   "texto": "když z těch listů smaragdové skrýše"
  },
  {
   "texto": "bělorůžné pýří klesá tiše"
  },
  {
   "texto": "v zanedbané listy brevíře."
  },
  {
   "texto": "Jak tu často snivý novic bledý,"
  },
  {
   "texto": "v zadumání sponkou knihu spíná,"
  },
  {
   "texto": "modliteb a žalmů, svaté vědy,"
  },
  {
   "texto": "důtek sebetrýzně zapomíná,"
  },
  {
   "texto": "a tvář pochýliv do jemných dlaní,"
  },
  {
   "texto": "v luzném snění, jež ho náhle jímá,"
  },
  {
   "texto": "vody jen a listů šepotání"
  },
  {
   "texto": "a včel bzukot nad záhonem vnímá"
  },
  {
   "texto": "a sní o širokých, volných ladech,"
  },
  {
   "texto": "o hvozdech a čarokrásných sadech,"
  },
  {
   "texto": "až pak s povzdechem se budí, vstává, —"
  },
  {
   "texto": "s čela uprchá mu snění vděk —"
  },
  {
   "texto": "blízký trávník, jímž se promodrává"
  },
  {
   "texto": "Ježíšovo jméno z pomněnek,"
  },
  {
   "texto": "připomněl mu řád, jenž slávu boží"
  },
  {
   "texto": "i tou něžnou nezabudkou množí."
  },
  {
   "texto": "Tamo noviců se temné tlupy,"
  },
  {
   "texto": "odebraly z šumu refektáře;"
  },
  {
   "texto": "v párech bloudí, v zástupy se kupí —"
  },
  {
   "texto": "se rtů klesá pouto, chmura s tváře."
  },
  {
   "texto": "Divno mezi záhony je zříti"
  },
  {
   "texto": "podoby jich útlounké a směrné,"
  },
  {
   "texto": "jež se chvějí pestrým davem kvítí"
  },
  {
   "texto": "v temných řízách jako stíny černé."
  },
  {
   "texto": "Líce však tou září jasně tají"
  },
  {
   "texto": "a smích na rty sedá ku posledu —"
  },
  {
   "texto": "srdce douškem plným užívají"
  },
  {
   "texto": "krátké, sladké chvíle bez dohledu."
  },
  {
   "texto": "Jenom Václav s nyvým sněním v oku"
  },
  {
   "texto": "hlavu klopí po soudruha boku."
  },
  {
   "texto": "Marně druh ten, líce pouchřadlé,"
  },
  {
   "texto": "s kadeřavě svislým plavým vlasem,"
  },
  {
   "texto": "s rýhou v čele, pod nímž oko vpadlé"
  },
  {
   "texto": "v divný blesk se zažehuje časem,"
  },
  {
   "texto": "marně sem i tamo hovor vede,"
  },
  {
   "texto": "ba rty svoje k žertu nutí bledé, —"
  },
  {
   "texto": "Václav nenaslouchá, nepohlíží"
  },
  {
   "texto": "ve tvář jeho, hloub jen hlavu níží,"
  },
  {
   "texto": "až pak soudruh starostliv se táže,"
  },
  {
   "texto": "co mu chmuří zrak, co jazyk váže?"
  },
  {
   "texto": "„Nuže, buďsi, Konrade! Hruď svoji"
  },
  {
   "texto": "tobě odhalím.“"
  },
  {
   "texto": "A Václav druhu"
  },
  {
   "texto": "rámě stiskl v divném nepokoji,"
  },
  {
   "texto": "z junů ostatních jej táhna kruhu,"
  },
  {
   "texto": "ze slunného kvadratury sadu"
  },
  {
   "texto": "do sloupové chodby, plné chladu,"
  },
  {
   "texto": "a pak schodů bludištěm se bral"
  },
  {
   "texto": "vzhůru s ním ve vyšší patra domu,"
  },
  {
   "texto": "kam hluk refektáře dozníval"
  },
  {
   "texto": "jen jak ropot dalekého hromu."
  },
  {
   "texto": "Tamo chodba podél stavby celé"
  },
  {
   "texto": "chodník tvoří nevídaně dlouhý,"
  },
  {
   "texto": "v jehož dlažbu mramorovou stele"
  },
  {
   "texto": "četné okno hravé světla prouhy."
  },
  {
   "texto": "Klenutím se táhne za ozdobu"
  },
  {
   "texto": "maleb hojných řetěz, umně spjatý —:"
  },
  {
   "texto": "postupem ti od kolébky k hrobu"
  },
  {
   "texto": "Ignáciův jeví život svatý."
  },
  {
   "texto": "Chodby klid, posvátnou náladu,"
  },
  {
   "texto": "teď krok spěšný obou přátel ruší,"
  },
  {
   "texto": "a již Václav šeptem Konradu"
  },
  {
   "texto": "odhaluje celou svoji duši."
  },
  {
   "texto": "„Ondy jsem za otcem rektorem"
  },
  {
   "texto": "v dar nes’ Huertovi obraz svatý"
  },
  {
   "texto": "na Hradčany. Když pak do komnaty"
  },
  {
   "texto": "s důvěrným se brali hovorem,"
  },
  {
   "texto": "za palác jsem zašel v pyšný sad,"
  },
  {
   "texto": "kterýž tamo sterým nad záhonem"
  },
  {
   "texto": "stromů vzácných rozestírá chlad"
  },
  {
   "texto": "po úbočí stupňovitým sklonem."
  },
  {
   "texto": "V tato místa vnady opojné"
  },
  {
   "texto": "ode branky paláce se níží"
  },
  {
   "texto": "mramorové schody podvojné"
  },
  {
   "texto": "s nízkou, zdobně prolámanou mříží;"
  },
  {
   "texto": "dvojité ty schody po stráni"
  },
  {
   "texto": "podivně se splétají a kříží,"
  },
  {
   "texto": "v stálém rozchodu a setkání"
  },
  {
   "texto": "tu se vzdalují, tu k sobě blíží,"
  },
  {
   "texto": "až pak dole v jedno splývají"
  },
  {
   "texto": "k tůně zastíněné pokraji,"
  },
  {
   "texto": "jejíž hladinou, kde labuť plove,"
  },
  {
   "texto": "leknín stele terče smaragdové."
  },
  {
   "texto": "Po těch stupních zamyšlen jsem bloudil."
  },
  {
   "texto": "V objetí pak jarní přírody"
  },
  {
   "texto": "vůní květů v duši mou se loudil"
  },
  {
   "texto": "pocit nevýslovné lahody."
  },
  {
   "texto": "Kamo pohled padá — ze záhonků"
  },
  {
   "texto": "stébla zelená mi šinou vstříc"
  },
  {
   "texto": "růžných, bílých, modrých na tisíc"
  },
  {
   "texto": "kalichů a rolniček a zvonků,"
  },
  {
   "texto": "v nichž se rosa skví a křídla bílá"
  },
  {
   "texto": "motýl hravý lehce rozestýlá."
  },
  {
   "texto": "Schodů mřežovím se svlačec krade"
  },
  {
   "texto": "lichotně až k lemu šatů mých"
  },
  {
   "texto": "a kol sošek mladý břečtan klade"
  },
  {
   "texto": "krunýř šupin jasně zelených."
  },
  {
   "texto": "Trpasličí stromky u zábradlí"
  },
  {
   "texto": "oděly se ve sníh květů padlý."
  },
  {
   "texto": "Ba i vzadu v pyšné domu stěně,"
  },
  {
   "texto": "po níž černé kresby rozesety,"
  },
  {
   "texto": "hustý špalír broskví utěšeně"
  },
  {
   "texto": "červenými hojně protkán květy."
  },
  {
   "texto": "A když přes okraj zdí zubatých"
  },
  {
   "texto": "zrak se svezl, z nenadání kles’"
  },
  {
   "texto": "ve vikýřů vzdušných, špičatých"
  },
  {
   "texto": "a střech žlábkovaných divnou směs."
  },
  {
   "texto": "Pavlačí zřel rozmanité zjevy,"
  },
  {
   "texto": "v oknech květiny a hlavy děví,"
  },
  {
   "texto": "a když dále těkal v dumání,"
  },
  {
   "texto": "slévala se krovů spousta v dáli"
  },
  {
   "texto": "ve střech moře, z něhož vyvstávaly"
  },
  {
   "texto": "věž tam za věží, báň za bání"
  },
  {
   "texto": "a již v slunném vzduchu přede mnou"
  },
  {
   "texto": "jakby rouškou průhledného zlata"
  },
  {
   "texto": "s plnou velebností tajemnou"
  },
  {
   "texto": "zjevila se Praha stověžatá."
  },
  {
   "texto": "Na pravo pak Petřín za údolem"
  },
  {
   "texto": "stromů vrchol vznášel nad vrcholem,"
  },
  {
   "texto": "ustrojený v jara květnou něhu,"
  },
  {
   "texto": "jako vlny smaragdu a sněhu."
  },
  {
   "texto": "Obraz ten mě takým kouzlem jal,"
  },
  {
   "texto": "že jsem po stupních spěl bystrým krokem"
  },
  {
   "texto": "k pavilónu, jenž se výše pjal,"
  },
  {
   "texto": "bych tu krásu plně objal okem."
  },
  {
   "texto": "Budovka to byla okrouhlá"
  },
  {
   "texto": "s divnou střechou cihel žlábkovitých,"
  },
  {
   "texto": "pod níž ze stěn, révou polo skrytých,"
  },
  {
   "texto": "vyhlédala okna podlouhlá"
  },
  {
   "texto": "pestrou září různobarvých skel."
  },
  {
   "texto": "V myšlenkách jsem k pavilónu spěl,"
  },
  {
   "texto": "až tu náhle, přiblíživ se k němu"
  },
  {
   "texto": "a zrak pohrouživ mu v nitro maní,"
  },
  {
   "texto": "stanul jsem a na zábradlí lemu"
  },
  {
   "texto": "opřel tělo chvějící se dlaní."
  },
  {
   "texto": "Stojím nehnutě — rty jedva dýší —"
  },
  {
   "texto": "hledě v otevřenou tuto skrýši."
  },
  {
   "texto": "Mnohobarvých oken pestrý svit"
  },
  {
   "texto": "nitro kouzlem báječným jí strojí"
  },
  {
   "texto": "jako kněžen pohádkových byt —"
  },
  {
   "texto": "a jest princezna tam věru dvojí."
  },
  {
   "texto": "Jedna sedíc v křesle zlaceném"
  },
  {
   "texto": "na lenochu hedbáv nazpět kloní"
  },
  {
   "texto": "pyšně hlavu, kolem níž se roní"
  },
  {
   "texto": "rusá kadeř hojným prstenem"
  },
  {
   "texto": "v objemného límce cípy bílé;"
  },
  {
   "texto": "zlatohlav, jenž po údech té víle"
  },
  {
   "texto": "v četnou řáseň ozdobnou se třepí,"
  },
  {
   "texto": "útvar těla jeví hrdolepý."
  },
  {
   "texto": "Viz tam na stěně tu madonnu"
  },
  {
   "texto": "v rouše zlatém, s lící směrně plnou,"
  },
  {
   "texto": "kol níž sklání nesčíslnou vlnou"
  },
  {
   "texto": "kadeř zlatá skvoucí záclonu,"
  },
  {
   "texto": "k ní tu děvu přirovnat bych směl,"
  },
  {
   "texto": "kdybych nebyl v stínu řasy dlouhé"
  },
  {
   "texto": "jarý záblesk světské tužby pouhé"
  },
  {
   "texto": "místo hvězdných třpytů uviděl."
  },
  {
   "texto": "U nohou jí na stoličce zdobné"
  },
  {
   "texto": "druhá dívka sedí. Levá dlaň"
  },
  {
   "texto": "ztápí prsty růžně bílé, drobné,"
  },
  {
   "texto": "do kadeří temných, — útlou skráň"
  },
  {
   "texto": "o koleno družky opírajíc."
  },
  {
   "texto": "Druhá ruka lehounce se sklání,"
  },
  {
   "texto": "na plano se snivě probírajíc"
  },
  {
   "texto": "ve stříbrné, mohočetné struně"
  },
  {
   "texto": "jakés loutny, složené jí v lůně."
  },
  {
   "texto": "Zpět ji věrně kouzlí vzpomínání!"
  },
  {
   "texto": "Štíhlejší je družky, mladší věkem,"
  },
  {
   "texto": "skromnější ji kryje ozdoba;"
  },
  {
   "texto": "avšak lahodnějším dýše vděkem"
  },
  {
   "texto": "zjev ten něžný — jara podoba."
  },
  {
   "texto": "Zelený šat jemný, s růžným nitrem"
  },
  {
   "texto": "rozstřižených, svislých rukávů,"
  },
  {
   "texto": "puklých poupat budí představu,"
  },
  {
   "texto": "z nichž se růže derou vesny jitrem."
  },
  {
   "texto": "A jak růže právě rozvilá,"
  },
  {
   "texto": "ovanutá dechem nachu jemným,"
  },
  {
   "texto": "usmívá se líce spanilá,"
  },
  {
   "texto": "objatá snem blaha přetajemným."
  },
  {
   "texto": "Jako hvězda z jarní noci klínu"
  },
  {
   "texto": "vyhlédá zrak temný z řasy stínu."
  },
  {
   "texto": "Však ne půvab severního máje,"
  },
  {
   "texto": "jiné jaro v ní se vtěluje;"
  },
  {
   "texto": "vesna-tě to dalekého kraje,"
  },
  {
   "texto": "kde zem slunce žhavěj’ celuje:"
  },
  {
   "texto": "oči takové jen slunný jih"
  },
  {
   "texto": "umí zažíhat ve stínu víčka,"
  },
  {
   "texto": "s takovýmto žárem snoubit sníh"
  },
  {
   "texto": "cudných skrání, nevinného líčka."
  },
  {
   "texto": "Chtivě hledím na prstíky její,"
  },
  {
   "texto": "jak se na stříbrných strunách chvějí"
  },
  {
   "texto": "a mním věru, že ten celý svět"
  },
  {
   "texto": "sladkých bájí, tajných blažeností,"
  },
  {
   "texto": "jež zem jarní ve svých prsou hostí,"
  },
  {
   "texto": "o nichž snívá porosený květ,"
  },
  {
   "texto": "o nichž břízy šepotají mladé,"
  },
  {
   "texto": "když se Zefýr lupením jich krade,"
  },
  {
   "texto": "jimiž září mladé srny zrak"
  },
  {
   "texto": "z bujné houště zjařeného lesa,"
  },
  {
   "texto": "bzukotem co hmyzu tiše plesá,"
  },
  {
   "texto": "skřivánkem co jásá do oblak,"
  },
  {
   "texto": "že ten země dithyramb, jejž něm"
  },
  {
   "texto": "člověk duší rozechvělou vnímá, —"
  },
  {
   "texto": "v této loutny ňadru vzedmutém"
  },
  {
   "texto": "a v těch strunách mihotavých dřímá"
  },
  {
   "texto": "a že čeká zakletá tam píseň,"
  },
  {
   "texto": "až těch prstů spasné dotknutí"
  },
  {
   "texto": "vzbudí ji, až tonů perutí"
  },
  {
   "texto": "vyprostí tu sladkou citů tíseň."
  },
  {
   "texto": "A hle! ponořila prstů běl"
  },
  {
   "texto": "do těch strun a rojem libých zvuků"
  },
  {
   "texto": "třepetavý kov se rozechvěl."
  },
  {
   "texto": "Naslouchal jsem v rychlém srdce tluku,"
  },
  {
   "texto": "jak ty struny, pod hebkou se dlaní"
  },
  {
   "texto": "proměnivše ve slavíků sbor,"
  },
  {
   "texto": "hlaholily v luzném rokotání."
  },
  {
   "texto": "Sám té družky hrdopyšné zor"
  },
  {
   "texto": "pozastřel se nyvě řasou dlouhou"
  },
  {
   "texto": "při strun oněch vábném souznění,"
  },
  {
   "texto": "provanutém divnou lásky touhou,"
  },
  {
   "texto": "milostného dechem blouznění."
  },
  {
   "texto": "A k nim přidružil se krásný hlas,"
  },
  {
   "texto": "jaký neslyšel jsem po ten čas."
  },
  {
   "texto": "Španělskou jsem píseň podle znění"
  },
  {
   "texto": "řeči poznal: přec ta slova cizí"
  },
  {
   "texto": "mněl jsem chápat v mocném srdce chvění"
  },
  {
   "texto": "a jich kouzlo z duše nevymizí."
  },
  {
   "texto": "Když pak dopěla, když jemně, zvolna"
  },
  {
   "texto": "struny zvuk se utajil a ztich’,"
  },
  {
   "texto": "hlasný povzdech něha sladkobolná"
  },
  {
   "texto": "v odvět vynořila z prsou mých."
  },
  {
   "texto": "Vzdech ten spáchal na vetřelci zradu."
  },
  {
   "texto": "Leknutí mrak stele v oči moje,"
  },
  {
   "texto": "ale slyším vykřiknutí dvoje,"
  },
  {
   "texto": "křesla šramot, loutny znění v pádu."
  },
  {
   "texto": "A když v pavilón se vracím zrakem,"
  },
  {
   "texto": "vidím hrdou postať na prahu,"
  },
  {
   "texto": "blesky pyšných hledů, čela mrakem"
  },
  {
   "texto": "kárající moji odvahu."
  },
  {
   "texto": "Zřím, jak přes rameno její skrytě"
  },
  {
   "texto": "něžné hlavinky zrak velký, tmavý"
  },
  {
   "texto": "na mne pohled metá ostražitě,"
  },
  {
   "texto": "zvědavý půl, z pola ostýchavý."
  },
  {
   "texto": "Stojím v rozpacích jak hříšník bídný,"
  },
  {
   "texto": "couvaje jim koktám vysvětlení —"
  },
  {
   "texto": "tu se zloba zlatovlásky mění"
  },
  {
   "texto": "v úsměv laškovný a pokyn vlídný."
  },
  {
   "texto": "Musím vejíti do vábné skrýše;"
  },
  {
   "texto": "okno rozemkly tam dokořán,"
  },
  {
   "texto": "abych rozhledem se kochal s výše,"
  },
  {
   "texto": "jenž mě vábil v dívčí tento stan."
  },
  {
   "texto": "Ba, i haluz, osněženou květy,"
  },
  {
   "texto": "úslužně mi mladší stranou šine,"
  },
  {
   "texto": "čtveračivě sešpulujíc rety."
  },
  {
   "texto": "Ale darmo z blízka, dáli kyne"
  },
  {
   "texto": "velkolepé město věží sterou;"
  },
  {
   "texto": "nádherný ten obraz rozplývá se"
  },
  {
   "texto": "před mým okem v mlhu pustošedou,"
  },
  {
   "texto": "z níž tvář vděků jarních usmívá se."
  },
  {
   "texto": "Starší děvy hled mi v křeslo kynul,"
  },
  {
   "texto": "bych si po procházce odpočinul."
  },
  {
   "texto": "Naproti mně blahosklonně sedíc,"
  },
  {
   "texto": "ve škádlivém na mne úsměvu"
  },
  {
   "texto": "z brvy lehce přimhouřené hledíc,"
  },
  {
   "texto": "pohrávajíc s třásní oděvu,"
  },
  {
   "texto": "z něhož bílé střevíčky se kradou,"
  },
  {
   "texto": "s růží zlatou, přes sebe se kladou,"
  },
  {
   "texto": "bavila mne volně věcí sterou;"
  },
  {
   "texto": "však mnou málo bylo uslyšeno;"
  },
  {
   "texto": "zvěděl jsem, že Marie má jméno,"
  },
  {
   "texto": "don-Huerty nevlastní je dcerou,"
  },
  {
   "texto": "z hrabat Multánských že vzešla kmene;"
  },
  {
   "texto": "že don Pedro, don Huerty brat,"
  },
  {
   "texto": "v plném květu bohatýrství zvad’"
  },
  {
   "texto": "a že siroty jím zůstavené"
  },
  {
   "texto": "náš don přijal ve svou záštitu;"
  },
  {
   "texto": "z těchto pak že svorně s ní tu žije,"
  },
  {
   "texto": "jako rodná sestra, Ignácie."
  },
  {
   "texto": "Pod žhavějším leskem blankytu,"
  },
  {
   "texto": "kde květ granátový nachem hoří,"
  },
  {
   "texto": "na skalině mezi kaštany"
  },
  {
   "texto": "bílým stínem obráží se v moři"
  },
  {
   "texto": "pyšný klášter, hojně nadaný."
  },
  {
   "texto": "Tamo v posvátném prožila míru"
  },
  {
   "texto": "Ignácie svoje dětská léta,"
  },
  {
   "texto": "mezi tím, co Pedro Řím a víru"
  },
  {
   "texto": "mečem slavil po všech koncích světa."
  },
  {
   "texto": "Umí odtud španělsky a vlasky,"
  },
  {
   "texto": "hudbě rozumí, je moudrost sama"
  },
  {
   "texto": "a zná latinsky též hovor lásky"
  },
  {
   "texto": "zapřádati: Amo, amas — ama!"
  },
  {
   "texto": "Dál tak štěbetala v bujném smíchu:"
  },
  {
   "texto": "„Nedáváš-li víry mojí chvále,"
  },
  {
   "texto": "sám ji zkoušce podrob: Ala, alae —"
  },
  {
   "texto": "amo, amas — Či se bojíš hříchu?"
  },
  {
   "texto": "Či snad latiny tvé kalný pramen"
  },
  {
   "texto": "učí jenom: Amen, amen, amen?!“"
  },
  {
   "texto": "Byl jsem v rozpacích. Vždyť po tu dobu"
  },
  {
   "texto": "ni můj stín se nevkrad’ v dívčí kobu,"
  },
  {
   "texto": "nikdy s děvou neprodlel jsem déle."
  },
  {
   "texto": "Nesměle jen k Ignácii vzhlížím;"
  },
  {
   "texto": "vidím, jak se červánek jí stele"
  },
  {
   "texto": "čarokrásný obličejem svížím,"
  },
  {
   "texto": "a jak líce rozpačitě sklání"
  },
  {
   "texto": "nad urvané snítky květný pel,"
  },
  {
   "texto": "jevíc při tom v stoudném pousmání"
  },
  {
   "texto": "pod růžovým rtíkem zoubků běl."
  },
  {
   "texto": "Otce rektora v tom z dálky hlas"
  },
  {
   "texto": "zaslechl jsem, opustil je chvatem."
  },
  {
   "texto": "Odtud dívky nespatřil jsem zas,"
  },
  {
   "texto": "avšak stále v srdci, touhou jatém,"
  },
  {
   "texto": "jedné chovám obraz lahodny."
  },
  {
   "texto": "Její podobu duch stále přede"
  },
  {
   "texto": "ve vzduch kolem, v tyto stěny šedé,"
  },
  {
   "texto": "v listy knihy, v myšlenky a sny."
  },
  {
   "texto": "Cítím, Konrade, v tom srdce tluku:"
  },
  {
   "texto": "že tam lásky tajím slasť i muku.“"
  },
  {
   "texto": "Jinoch domluvil. Druh jeho mračně"
  },
  {
   "texto": "pokáral jej, v zem se zahleděv:"
  },
  {
   "texto": "„„Ďábel obchází jak řvoucí lev,"
  },
  {
   "texto": "po záhubě lidských duší lačně."
  },
  {
   "texto": "Tobě v roucho vábnější se zavil:"
  },
  {
   "texto": "v dívčí půvab, krásných očí dvé —"
  },
  {
   "texto": "nedej, aby hříšný plamen ztrávil"
  },
  {
   "texto": "bohu zasvěcené srdce tvé!"
  },
  {
   "texto": "Zašlap hmyz, jenž v poupě to se plouží,"
  },
  {
   "texto": "jež má rozvíti se v růži ctností;"
  },
  {
   "texto": "v pobožnosti tůň je celé vhrouži: —"
  },
  {
   "texto": "navrátí se s rosou nevinnosti."
  },
  {
   "texto": "Modlitby se zacloň svatým štítem"
  },
  {
   "texto": "před vidiny této svůdným třpytem!““"
  },
  {
   "texto": "„Ó, ni modlitba jí nezaplaší!"
  },
  {
   "texto": "Pravda, že jak myrrhy vonný mrak"
  },
  {
   "texto": "na perutích modlitby se vznáší"
  },
  {
   "texto": "myšlenka má často nad oblak,"
  },
  {
   "texto": "že tam zraky ztápím oslněné"
  },
  {
   "texto": "v neskonalou slávu božích sídel,"
  },
  {
   "texto": "andělské zřím kůry rozvlněné"
  },
  {
   "texto": "mořem nekonečným sněžných křídel,"
  },
  {
   "texto": "k trůnu božímu tam skláním hlavu,"
  },
  {
   "texto": "v mučenníků nespočetném davu,"
  },
  {
   "texto": "světců, světic, božích vyvolenců,"
  },
  {
   "texto": "hrdin jasných církve vítězné —"
  },
  {
   "texto": "však tu náhle z andělských těch věnců"
  },
  {
   "texto": "jeden kvítek krásy líbezné,"
  },
  {
   "texto": "jeden anděl, jitřním na oblaku,"
  },
  {
   "texto": "na ostrůvku růžném světla moře,"
  },
  {
   "texto": "do strun zlatoskvoucích prsty noře,"
  },
  {
   "texto": "ke mně vznáší něhu temných zraků"
  },
  {
   "texto": "z noci kadeří, jež zdobí vděk"
  },
  {
   "texto": "porozvitých růže poupátek."
  },
  {
   "texto": "Děvice mi drahé jeví líc,"
  },
  {
   "texto": "náruč hebkou rozpíná mi vstříc"
  },
  {
   "texto": "a já v náruči té blahodyšné"
  },
  {
   "texto": "nazpět klesám — nazpět k zemi hříšné!“"
  },
  {
   "texto": "„„Blasfemie hrozná! K nebes kůru"
  },
  {
   "texto": "přidružovat smrtnou postavu,"
  },
  {
   "texto": "bídnou bláta pozemského stvůru"
  },
  {
   "texto": "a snad zítra červů zábavu."
  },
  {
   "texto": "Rozpadne se v popel zlaté bůže,"
  },
  {
   "texto": "než mu láska věnec douvije;"
  },
  {
   "texto": "na umrlčí lebce zvadlé růže —"
  },
  {
   "texto": "totě všechna zemská poesie."
  },
  {
   "texto": "Láska — pravíš? Bídným těla chtíčem"
  },
  {
   "texto": "zvu ji lépe, v liché básní zdobě;"
  },
  {
   "texto": "umrtvuj to tělo postem, bičem —"
  },
  {
   "texto": "hříšná touha svěsí křídla obě.““"
  },
  {
   "texto": "„Marno všechno. Večer v pusté cele"
  },
  {
   "texto": "bičuju se krutě důtek ostny,"
  },
  {
   "texto": "až krev splývá po trýzněném těle;"
  },
  {
   "texto": "ale v duchu nápěv přemilostný"
  },
  {
   "texto": "stále zvučí, jak jej prsty drobné"
  },
  {
   "texto": "vyloudily tehdy z loutny zdobné,"
  },
  {
   "texto": "když pak v lože kladu čelo vzňaté,"
  },
  {
   "texto": "andílků tu roje nad ním hrají"
  },
  {
   "texto": "tento nápěv na housličky zlaté"
  },
  {
   "texto": "a jím ve spánek mě kolébají.“"
  },
  {
   "texto": "Stanuli teď v okně. Dlouho zřeli"
  },
  {
   "texto": "v město velkolepé dumavě,"
  },
  {
   "texto": "jehož věže nesčetné se rděly"
  },
  {
   "texto": "v nachu večerního záplavě."
  },
  {
   "texto": "Václav okem roztouženým stíhal"
  },
  {
   "texto": "Hradčan zubovatý zlatý stín,"
  },
  {
   "texto": "jenž se v zadu na obloze míhal."
  },
  {
   "texto": "Konrad zahleděl se v řeky klín,"
  },
  {
   "texto": "v kamenný pak most, jenž přes ni pjal"
  },
  {
   "texto": "mnohé oblouky, soch řady stmělé,"
  },
  {
   "texto": "až se na věž hrdou zadíval,"
  },
  {
   "texto": "strmící tu chmurně v mostu čele,"
  },
  {
   "texto": "ana poslední teď slunce zář"
  },
  {
   "texto": "zlatem kreslí v tento kolos tmavý"
  },
  {
   "texto": "nakupených tamo sošek hlavy, —"
  },
  {
   "texto": "znaky divné, — matnou králů tvář"
  },
  {
   "texto": "na výstupku pod korunou skvoucí, —"
  },
  {
   "texto": "divné krabuše s železnou mřeží,"
  },
  {
   "texto": "na rožních tam připevněné k věži — —"
  },
  {
   "texto": "Náhle s bleskem nenávisti žhoucí"
  },
  {
   "texto": "Konradův se zor s těch košů smek’"
  },
  {
   "texto": "a ret zlý mu skřivil úšklebek."
  },
  {
   "texto": "„„Pohleď,““ zvolal, „„jaké vzácné hosti"
  },
  {
   "texto": "má tam z Michalovic Bohuslav —"
  },
  {
   "texto": "na koš jeho v něžné příchylnosti"
  },
  {
   "texto": "ptáků černých usadil se dav."
  },
  {
   "texto": "„Černé ptáky“ kdysi štvali zlostí —"
  },
  {
   "texto": "nyní u samých je mají hlav! — —"
  },
  {
   "texto": "Ba, toť on. — Znám každičkou klec:"
  },
  {
   "texto": "Jesenius tam, zde Budovec —““"
  },
  {
   "texto": "„Pojďme již! Zvon ku modlitbě zove!“"
  },
  {
   "texto": "vzdechnuv soudruh do řeči mu vpadl."
  },
  {
   "texto": "Krok jich zazněl v dlažbě mramorové"
  },
  {
   "texto": "a stín klenbou obrovský se kradl."
  }
 ]
}