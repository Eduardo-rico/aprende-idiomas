{
 "id": "halek-pohadky-z-nasi-vesnice--v-pustych-ladech",
 "titulo": "V pustých ladech · Na stráži · Bludný jezdec · Náš písničkář",
 "autor": "Vítězslav Hálek",
 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Poh%C3%A1dky_z_na%C5%A1%C3%AD_vesnice_(H%C3%A1lek)/V_pust%C3%BDch_ladech",
 "fuente": "cs.wikisource.org, «Pohádky z naší vesnice»",
