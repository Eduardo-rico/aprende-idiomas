 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-pohadky-z-nasi-vesnice",
  "titulo": "Pohádky z naší vesnice",
  "orden": 14
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "V pustých ladech"
  },
  {
   "texto": "V lada pustá, k ulomené hruši"
  },
  {
   "texto": "bez mízy a listí, bez snětí,"
  },
  {
   "texto": "jsem až dojel, u ní pustil duši,"
  },
  {
   "texto": "bez druhů a přátel, bez dětí,"
  },
  {
   "texto": "A kůň zaržál jako zlomen ve dví,"
  },
  {
   "texto": "kůň, tak sotva potažená kost,"
  },
  {
   "texto": "pes mu zaštěk’ z tísněného ledví —"
  },
  {
   "texto": "pes, víc kostra; není toho dost?"
  },
  {
   "texto": "Přemítal k ránu s klopotem,"
  },
  {
   "texto": "zač noci té stál životem —"
  },
  {
   "texto": "klid občanů, jich zlatý sen,"
  },
  {
   "texto": "a nikdo nebyl vyrušen."
  },
  {
   "texto": "Pak naproti tam v okénku"
  },
  {
   "texto": "též hlídal svoji milenku,"
  },
  {
   "texto": "a když tam hled svůj obrátil,"
  },
  {
   "texto": "div stesk mu duši nechvátil."
  },
  {
   "texto": "A když noc v den se probírá,"
  },
  {
   "texto": "kdos její dvéře otvírá,"
  },
  {
   "texto": "a než ji ještě políbí —"
  },
  {
   "texto": "ej, namíří-li, nechybí."
  },
  {
   "texto": "Vojáčku, cos to učinil,"
  },
  {
   "texto": "žes na vůdci se provinil?"
  },
  {
   "texto": "Teď bratří tebe proslaví —"
  },
  {
   "texto": "tři do srdce, tři do hlavy."
  },
  {
   "texto": "Pan jezdec večer zabloudil"
  },
  {
   "texto": "ve velkém, velkém lese;"
  },
  {
   "texto": "i potká děvče hezounké,"
  },
  {
   "texto": "to jako pták se nese."
  },
  {
   "texto": "„Ty hezké dítě, pověz mi,"
  },
  {
   "texto": "zda jedu tady k městu?“ —"
  },
  {
   "texto": "„Ne, pane, právě naopak,"
  },
  {
   "texto": "já ukáži vám cestu.“"
  },
  {
   "texto": "On vzal ji k sobě na koně"
  },
  {
   "texto": "a jedou spolu v lese,"
  },
  {
   "texto": "a jak ji drží za ruku,"
  },
  {
   "texto": "ta v ruce mu se třese."
  },
  {
   "texto": "Tu cesta srázná, skalnatá,"
  },
  {
   "texto": "on blíž ji k sobě vine,"
  },
  {
   "texto": "a než ji s koně sesadil,"
  },
  {
   "texto": "měl v prsou srdce jiné."
  },
  {
   "texto": "Od času toho noc jak noc"
  },
  {
   "texto": "tam jezdec bloudí k městu:"
  },
  {
   "texto": "dej, bože, všechněm zbloudilým,"
  },
  {
   "texto": "jak jemu, najít cestu."
  },
  {
   "texto": "Nad našeho písničkáře"
  },
  {
   "texto": "neznám reka se zbraní."
  },
  {
   "texto": "Bez vojáka, bez císaře"
  },
  {
   "texto": "lid i zem si podmaní,"
  },
  {
   "texto": "a co v něm uzrává,"
  },
  {
   "texto": "v dar co píseň rozdává."
  },
  {
   "texto": "Sotva vyjde, starý, mladý"
  },
  {
   "texto": "už jak pták se pozvedá,"
  },
  {
   "texto": "svět hned pučí z plna vnady,"
  },
  {
   "texto": "až nám srdce usedá —"
  },
  {
   "texto": "bože náš, bože náš,"
  },
  {
   "texto": "jak když v jaro zavoláš!"
  },
  {
   "texto": "Jako deštík v prvním máji"
  },
  {
   "texto": "slovo v duši dopadá,"
  },
  {
   "texto": "stojíme s ním jako v báji,"
  },
  {
   "texto": "z duší vonná zahrada —"
  },
  {
   "texto": "a ten hlas, a ten hlas,"
  },
  {
   "texto": "ten by z hrobů vzkřísil nás."
  },
  {
   "texto": "Květným dechem pravda šumí:"
  },
  {
   "texto": "sotva srdce poslechne,"
  },
  {
   "texto": "srdcem každý porozumí,"
  },
  {
   "texto": "zavejskne si, povzdechne,"
  },
  {
   "texto": "ve shodě, v neshodě,"
  },
  {
   "texto": "jak ten pták na svobodě."
  },
  {
   "texto": "A co zpívá, v duše skrejši"
  },
  {
   "texto": "dochová se dlouhých let,"
  },
  {
   "texto": "to je zákon nejsvětější,"
  },
  {
   "texto": "každý zná hned nazpamět —"
  },
  {
   "texto": "který král, který král"
  },
  {
   "texto": "tak se v paměť lidu jal."
  },
  {
   "texto": "Slovem dobyl všecky brány,"
  },
  {
   "texto": "bez zrady a bez sporů,"
  },
  {
   "texto": "že nám duše zotvírány"
  },
  {
   "texto": "do posledních závorů —"
  },
  {
   "texto": "který král, který král"
  },
  {
   "texto": "tak o naše srdce stál?"
  },
  {
   "texto": "Srdce plné, duše sytá,"
  },
  {
   "texto": "tu v nás všecko zajásá,"
  },
  {
   "texto": "jako krále lid ho vítá,"
  },
  {
   "texto": "zem se v radost otřásá —"
  },
  {
   "texto": "na zdraví, na zdraví,"
  },
  {
   "texto": "ať se všude proslaví!"
  }
 ]
}