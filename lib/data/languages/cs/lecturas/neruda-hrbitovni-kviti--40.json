 "parrafos": [
  {
   "texto": "40"
  },
  {
   "texto": "Humor jesti kvítko stobarevné,"
  },
  {
   "texto": "vzejde v krušných dobách lidstva žití,"
  },
  {
   "texto": "tak jak podle krásné báje vzešlo"
  },
  {
   "texto": "z krve, ze slz páně pestré kvítí."
  },
  {
   "texto": "Krásná doba, dokud humor nebyl!"
  },
  {
   "texto": "Nestávalo touhy ani smutku,"
  },
  {
   "texto": "neb kde smích se hledá, výsměch líhne,"
  },
  {
   "texto": "musel žal dřív být a chyba v skutku."
  },
  {
   "texto": "Humor jesti rosou lidstva žízni, -"
  },
  {
   "texto": "nesmějíť se jenom šílení!"
  },
  {
   "texto": "Často výsměch chybu ponapravil,"
  },
  {
   "texto": "často udusil vtip kvílení."
  },
  {
   "texto": "Smutným náhle oko nevěstino,"
  },
  {
   "texto": "smutným celé družstvo svatební,"
  },
  {
   "texto": "potkají-li lidé zveselení"
  },
  {
   "texto": "průvod černý - průvod pohřební."
  },
  {
   "texto": "Malý žal ti oko dříve jasné,"
  },
  {
   "texto": "dobu blaha náhle zakalí,"
  },
  {
   "texto": "tak jak kapka jedu čistou studni,"
  },
  {
   "texto": "celé město morem zahalí."
  },
  {
   "texto": "Voníš k růži, avšak v okamžení"
  },
  {
   "texto": "nepomníš už růže příznivé,"
  },
  {
   "texto": "na bolest však, trn-li tebe píchl,"
  },
  {
   "texto": "vzpomínají jízvy ošklivé."
  },
  {
   "texto": "Co jest slza? - Skvostná karbunkule"
  },
  {
   "texto": "v noci světlem divným zářící"
  },
  {
   "texto": "a svou září charé noční stíny"
  },
  {
   "texto": "a jich dusné strachy mařící."
  },
  {
   "texto": "Co jest slza? - Kapka rosy chladné,"
  },
  {
   "texto": "jakou palčivý blín nasází,"
  },
  {
   "texto": "kapka ta jak vlna v okeánu"
  },
  {
   "texto": "celé nebe sama obrazí."
  },
  {
   "texto": "Co jest slza? - Mlíčná nebes střída,"
  },
  {
   "texto": "stříbra zář to modrem stopená,"
  },
  {
   "texto": "tisícerých chová v sobě světel,"
  },
  {
   "texto": "tisícerých světel bez jmena."
  },
  {
   "texto": "Smutek promění nám v sněžné lady"
  },
  {
   "texto": "náhle myšlénkové krásné světy,"
  },
  {
   "texto": "a dá za to - leckdy ovšem vhod nám -"
  },
  {
   "texto": "bezovocné, chudé, ledné květy."
  },
  {
   "texto": "Slza v smutku - dešť to vlažný, jarní,"
  },
  {
   "texto": "holou zemi mění v živé sady,"
  },
  {
   "texto": "a z té půdy poslzené vzrostou"
  },
  {
   "texto": "květů myšlénkových jarní vnady."
  },
  {
   "texto": "Na vršíku dům stál bláznů -"
  },
  {
   "texto": "panna tudy chodila,"
  },
  {
   "texto": "chytili ji, aby bláznům"
  },
  {
   "texto": "k vůli leccos rodila."
  },
  {
   "texto": "Na stůl si ji posadili,"
  },
  {
   "texto": "pod sklenici vklopili,"
  },
  {
   "texto": "aby pěkně přibývala,"
  },
  {
   "texto": "notně pod ní topili."
  },
  {
   "texto": "Panna arci churavěla,"
  },
  {
   "texto": "panna arci skonala;"
  },
  {
   "texto": "radost tu však blázni měli,"
  },
  {
   "texto": "pannou že jim zůstala."
  },
  {
   "texto": "Bravo, páni literáti!"
  },
  {
   "texto": "dejte pozor na ženské,"
  },
  {
   "texto": "byť i písemnictví pošlo, -"
  },
  {
   "texto": "jen když bude panenské!"
  }
 ]
}