 "modo": "texto",
 "parrafos": [
  {
   "texto": "Naše zbraně"
  },
  {
   "texto": "Nechať osud přilby k čelům,"
  },
  {
   "texto": "v pěsti meče nedal nám,"
  },
  {
   "texto": "přece nejsme nepřátelům"
  },
  {
   "texto": "za míč dánik mrzkým hrám:"
  },
  {
   "texto": "máme na ně"
  },
  {
   "texto": "mnohé zbraně,"
  },
  {
   "texto": "jež nám ukul Tvůrce sám."
  },
  {
   "texto": "Za přilby nám skráně dány,"
  },
  {
   "texto": "tvrdé jako žuly hor,"
  },
  {
   "texto": "které snesly věků rány,"
  },
  {
   "texto": "věky stačí na odpor,"
  },
  {
   "texto": "dokud k nebi"
  },
  {
   "texto": "české lebi"
  },
  {
   "texto": "bude týčit mužný vzdor."
  },
  {
   "texto": "Marně budou kopím vrazi"
  },
  {
   "texto": "v pancíř našich prsou rýt,"
  },
  {
   "texto": "neprolomí, nerozrazí"
  },
  {
   "texto": "ocelový ňader štít,"
  },
  {
   "texto": "dokud vřelá,"
  },
  {
   "texto": "srdce, smělá,"
  },
  {
   "texto": "za ním budou věrně bít."
  },
  {
   "texto": "Máme také na obranu"
  },
  {
   "texto": "v ústech jazyk, živý meč;"
  },
  {
   "texto": "on má břitkou, skvoucí hranu,"
  },
  {
   "texto": "jasně zvoní v ducha seč,"
  },
  {
   "texto": "on se práva"
  },
  {
   "texto": "dovolává"
  },
  {
   "texto": "pro mateřskou sladkou řeč."
  },
  {
   "texto": "Máme ruce, ať ty tvoří"
  },
  {
   "texto": "divy v píli horečné,"
  },
  {
   "texto": "proti hltavému moři"
  },
  {
   "texto": "staví hráze bezpečné -"
  },
  {
   "texto": "dělné dlaně"
  },
  {
   "texto": "naše zbraně,"
  },
  {
   "texto": "práce heslo válečné."
  },
  {
   "texto": "Jen ať každý v řad se staví,"
  },
  {
   "texto": "kam ho volá bratří hlas,"
  },
  {
   "texto": "žádná zbroj ať nerezaví,"
  },
  {
   "texto": "z pochvy skočí v pravý čas -"
  },
  {
   "texto": "potom z boje"
  },
  {
   "texto": "české voje"
  },
  {
   "texto": "odnesou si vavřín zas."
  },
  {
   "texto": "Když Čecha tvořil světa Pán,"
  },
  {
   "texto": "tu přišel škůdce starý,"
  },
  {
   "texto": "duch tmy a hříchu, obtěžkán"
  },
  {
   "texto": "jsa pekelnými dary"
  },
  {
   "texto": "a na hromadu štědře klad"
  },
  {
   "texto": "směs vášní neřestí a vad -"
  },
  {
   "texto": "Leč tvůrce zvolal: „Vari!"
  },
  {
   "texto": "Hle, tomu tvoru podá svět"
  },
  {
   "texto": "jen bodláčí a hloží,"
  },
  {
   "texto": "jen svízel pozná, bídy hnět,"
  },
  {
   "texto": "všem bude za podnoží."
  },
  {
   "texto": "Los černý vzal si z osudí!"
  },
  {
   "texto": "Než, za to dlaň má na hrudi"
  },
  {
   "texto": "jen dobra skvost mu vloží.“"
  },
  {
   "texto": "Však Satan zpurně čelem hnul:"
  },
  {
   "texto": "„To proti smlouvě čelí:"
  },
  {
   "texto": "Ty’s ponechal mi země půl,"
  },
  {
   "texto": "bych kul tam svoje střely."
  },
  {
   "texto": "Vždy záře sousedem je stín,"
  },
  {
   "texto": "vždy s jasem cnosti chmůra vin"
  },
  {
   "texto": "o lidskou hruď se dělí.“"
  },
  {
   "texto": "„Smluv nemám s tebou, Satane,“"
  },
  {
   "texto": "Bůh řekl přísné líce;"
  },
  {
   "texto": "„mou vůlí se ti dostane"
  },
  {
   "texto": "přec dílku z polovice."
  },
  {
   "texto": "Mé lásce moudrosť klade mez -"
  },
  {
   "texto": "Smíš dar mu nechat - ale věz:"
  },
  {
   "texto": "dar jediný - nic více.“"
  },
  {
   "texto": "Tu Satan přemítaje skryl"
  },
  {
   "texto": "tvář děsnou v tlapy obě"
  },
  {
   "texto": "a náhle zdvihl, rozjiskřil"
  },
  {
   "texto": "zrak v ukojené zlobě,"
  },
  {
   "texto": "pak mezi dary spěšně hráb’"
  },
  {
   "texto": "a v jeden zaryl křivý dráp,"
  },
  {
   "texto": "v dar záští k samu sobě."
  },
  {
   "texto": "Báj tupíte as dětinnou -"
  },
  {
   "texto": "neb kdože pravdou nechá,"
  },
  {
   "texto": "že vadu máme jedinou?!"
  },
  {
   "texto": "Však hubená v tom těcha -"
  },
  {
   "texto": "neb jisto jest, co ztropil ďas:"
  },
  {
   "texto": "že z lidí nejvíc po ten čas"
  },
  {
   "texto": "Čech nenávidí Čecha."
  },
  {
   "texto": "Tak lítě nikdy nežehá"
  },
  {
   "texto": "žár jiný srdci českém,"
  },
  {
   "texto": "jak proti Čechu vyšlehá"
  },
  {
   "texto": "zášť ona zhoubným bleskem,"
  },
  {
   "texto": "ta v dýku mění každý hled,"
  },
  {
   "texto": "vše kalem třísní, chrlí jed"
  },
  {
   "texto": "a buší kyje třeskem."
  },
  {
   "texto": "Jen hleďte vůkol: Záště zmij"
  },
  {
   "texto": "co zdatných sil nám ničí,"
  },
  {
   "texto": "jak z líchy každé hustou šij"
  },
  {
   "texto": "a z každý chýše tyčí,"
  },
  {
   "texto": "nám v žití sype tisíc běd,"
  },
  {
   "texto": "i z růží uměn, knihy věd"
  },
  {
   "texto": "a s práhu svatyň syčí."
  },
  {
   "texto": "Až hnus tě časem zachvátí"
  },
  {
   "texto": "v té věčné kolem zlobě,"
  },
  {
   "texto": "tvář s bolestí se odvrátí"
  },
  {
   "texto": "a trpce vzdychneš sobě:"
  },
  {
   "texto": "Kéž zloduch nám chyb kopu dal"
  },
  {
   "texto": "a špetku jenom zpět si vzal"
  },
  {
   "texto": "té naší zášti k sobě!"
  }
 ]
}