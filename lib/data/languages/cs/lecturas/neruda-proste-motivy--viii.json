 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "VIII"
  },
  {
   "texto": "Jak dobře, že z ráje vyhnal nás"
  },
  {
   "texto": "kdys všechny ten pánbůh milý,"
  },
  {
   "texto": "i žehnáme otcům, praotcům,"
  },
  {
   "texto": "že hříchem nás podědili!"
  },
  {
   "texto": "Tak vesele se to vandruje,"
  },
  {
   "texto": "ve uzlíčku hřích dědičný -"
  },
  {
   "texto": "ach bez hříchu by ten květný svět"
  },
  {
   "texto": "již zpola tak nebyl sličný!"
  },
  {
   "texto": "Ba nebýti jeho, zda zněly by"
  },
  {
   "texto": "kdy pk stráních jarně zpěvy?"
  },
  {
   "texto": "Zda těšil by kdy nás růží květ"
  },
  {
   "texto": "a kyproučké panen zjevy?"
  },
  {
   "texto": "Zda bychom si někdy výskli tak,"
  },
  {
   "texto": "když „ku tanci!“ hudbě kynem,"
  },
  {
   "texto": "zda bychom se štěstím chvěli tak,"
  },
  {
   "texto": "když děvu si k prsoum vinem?"
  },
  {
   "texto": "A ptejme se pánů nebo sluh,"
  },
  {
   "texto": "z měst slečinky, dívky veské,"
  },
  {
   "texto": "a každý nám chvějně přišeptne,"
  },
  {
   "texto": "že hřešit je ach tak hezké!"
  },
  {
   "texto": "(Motiv cizí)"
  },
  {
   "texto": "Já umírám láskou. Loučím se"
  },
  {
   "texto": "již se vším tím světa pychem -"
  },
  {
   "texto": "ach zazvoň mi, děvče, k hodince"
  },
  {
   "texto": "svým nejstříbrnějším smíchem!"
  },
  {
   "texto": "Hrob vykopej na své postýlce,"
  },
  {
   "texto": "šest střevíců dlouhý asi,"
  },
  {
   "texto": "a místo těch tříštěk borových"
  },
  {
   "texto": "v něj nastlej své zlaté vlasy."
  },
  {
   "texto": "Tak měkký to hrob, tak milounký -:"
  },
  {
   "texto": "dvě nad hrobem očka svítí,"
  },
  {
   "texto": "dva rty kvetou jako růží keř,"
  },
  {
   "texto": "dvě líce jak z ráje kvítí."
  },
  {
   "texto": "Však vdova ty žíti nemůžeš,"
  },
  {
   "texto": "nuž ulehni ve hrob ke mně,"
  },
  {
   "texto": "a bůh nám dej sladce spočinout"
  },
  {
   "texto": "a lehká nám budiž země."
  },
  {
   "texto": "Má poesie - dívčina"
  },
  {
   "texto": "a mžikem láskou plápolá:"
  },
  {
   "texto": "jak spatří oči mladé,"
  },
  {
   "texto": "již ruku k srdci klade"
  },
  {
   "texto": "a hlava jde jí dokola."
  },
  {
   "texto": "Hned chystá roucho svatební"
  },
  {
   "texto": "jak padlým sněhem vroubené,"
  },
  {
   "texto": "a chystá závoj řásný"
  },
  {
   "texto": "a bleskný šperk so krásný,"
  },
  {
   "texto": "i vozy, věnci zdobené."
  },
  {
   "texto": "Již svatba v plném rozletu -"
  },
  {
   "texto": "vtom rozum v cestu vyrazí:"
  },
  {
   "texto": "tři stará slova vrhne"
  },
  {
   "texto": "a šátek v uzel zdrhne"
  },
  {
   "texto": "a rázem svatbu přimrazí."
  }
 ]
}