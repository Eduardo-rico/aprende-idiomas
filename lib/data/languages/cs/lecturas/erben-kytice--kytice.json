{
 "id": "erben-kytice--kytice",
 "titulo": "Kytice · Poklad",
 "autor": "Karel Jaromír Erben",
 "muerteAutor": 1870,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Kytice_z_pov%C4%9Bst%C3%AD_n%C3%A1rodn%C3%ADch/Kytice",
 "fuente": "cs.wikisource.org, «Kytice z pověstí národních»",
 "licencia": "dominio público (autor muerto en 1870)",
 "nivel": "A2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la norma anterior a 1957: infinitivo en «-ti» (slyšeti, býti, jíti, vzíti: 16 formas frente a 3 en «-t»). Se conserva tal cual: es la grafía de la edición, no un error.",
 "serie": {
  "id": "erben-kytice",
  "titulo": "Kytice z pověstí národních",
  "orden": 1
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Kytice"
  },
  {
   "texto": "Zemřela matka a do hrobu dána,"
  },
  {
   "texto": "siroty po ní zůstaly;"
  },
  {
   "texto": "i přicházely každičkého rána"
  },
  {
   "texto": "a matičku svou hledaly."
  },
  {
   "texto": "I zželelo se matce milých dítek;"
  },
  {
   "texto": "duše její se vrátila"
  },
  {
   "texto": "a vtělila se v drobnolistý kvítek,"
  },
  {
   "texto": "jímž mohylu svou pokryla."
  },
  {
   "texto": "Poznaly dítky matičku po dechu,"
  },
  {
   "texto": "poznaly ji a plesaly;"
  },
  {
   "texto": "a prostý kvítek, v něm majíc útěchu,"
  },
  {
   "texto": "mateřídouškou nazvaly."
  },
  {
   "texto": "Mateřídouško vlasti naší milé,"
  },
  {
   "texto": "vy prosté naše pověsti,"
  },
  {
   "texto": "natrhal jsem tě na dávné mohyle -"
  },
  {
   "texto": "komu mám tebe přinésti?"
  },
  {
   "texto": "Ve skrovnou já tě kytici zavážu,"
  },
  {
   "texto": "ozdobně stužkou ovinu;"
  },
  {
   "texto": "do širých zemí cestu ti ukážu,"
  },
  {
   "texto": "kde příbuznou máš rodinu."
  },
  {
   "texto": "Snad že se najde dcera mateřina,"
  },
  {
   "texto": "jíž mile dech tvůj zavoní;"
  },
  {
   "texto": "snad že i najdeš některého syna,"
  },
  {
   "texto": "jenž k tobě srdce nakloní!"
  },
  {
   "texto": "I"
  },
  {
   "texto": "Na pahorku mezi buky"
  },
  {
   "texto": "kostelíček s věží nízkou;"
  },
  {
   "texto": "z věže pak slyšeti zvuky"
  },
  {
   "texto": "hájem a sousední vískou."
  },
  {
   "texto": "Není zvuk to zvonka jemný,"
  },
  {
   "texto": "tratící se v blízké stráně:"
  },
  {
   "texto": "dřevatě to rachot temný,"
  },
  {
   "texto": "zvoucí lid do chrámu Páně."
  },
  {
   "texto": "A tu z vísky k boží slávě"
  },
  {
   "texto": "vzhůru běží zástup hojný:"
  },
  {
   "texto": "veský lid to bohabojný,"
  },
  {
   "texto": "a dnes Velký pátek právě."
  },
  {
   "texto": "V chrámě truchlo: holé stěny;"
  },
  {
   "texto": "oltář černá rouška kryje,"
  },
  {
   "texto": "na roušce kříž upevněný;"
  },
  {
   "texto": "v kůru zpívají pašije."
  },
  {
   "texto": "A hle, co se bělá v lese,"
  },
  {
   "texto": "v černém lese za potokem"
  },
  {
   "texto": "Nějaká to veská žena,"
  },
  {
   "texto": "ana v náručí cos nese."
  },
  {
   "texto": "I jde rychlým žena krokem,"
  },
  {
   "texto": "svátečně jsouc oblečena,"
  },
  {
   "texto": "tam tou strání za potokem —"
  },
  {
   "texto": "pacholátko malé nese."
  },
  {
   "texto": "Běží žena, dolů běží,"
  },
  {
   "texto": "pospíchá do chrámu Páně:"
  },
  {
   "texto": "tu nablízku lesní stráně"
  },
  {
   "texto": "kostel na pahorku leží."
  },
  {
   "texto": "A v úvale ku potoku"
  },
  {
   "texto": "náhle ubystřuje kroků;"
  },
  {
   "texto": "neb jak větřík volně věje,"
  },
  {
   "texto": "z kostela slyšeti pění:"
  },
  {
   "texto": "v kůru tam se právě pěje"
  },
  {
   "texto": "Krista Pána umučení."
  },
  {
   "texto": "Běží, běží podle skály:"
  },
  {
   "texto": "„Co to? Mám-li věřit oku?"
  },
  {
   "texto": "Což mě moje smysly šálí?“"
  },
  {
   "texto": "Stane, ohlíží se kolem —"
  },
  {
   "texto": "rychle kroky zpět obrací,"
  },
  {
   "texto": "stane zase, zas se vrací —"
  },
  {
   "texto": "„Tam ten les, a zde ty klesty,"
  },
  {
   "texto": "tamto vede cesta polem —"
  },
  {
   "texto": "vždyť jsem nezbloudila z cesty!"
  },
  {
   "texto": "Bože, co se se mnou děje!"
  },
  {
   "texto": "Což zde nejsem u kamena?"
  },
  {
   "texto": "Jaká se tu stala změna!“"
  },
  {
   "texto": "Zase stojí, zase spěje,"
  },
  {
   "texto": "celá jsouci udivena,"
  },
  {
   "texto": "oči rukou si protírá,"
  },
  {
   "texto": "o krok blíže se ubírá:"
  },
  {
   "texto": "„Bože, jaká to tu změna!“"
  },
  {
   "texto": "Tu, kde z divokého klestu,"
  },
  {
   "texto": "od kostela tři sta kroků,"
  },
  {
   "texto": "veliký čněl kámen v cestu,"
  },
  {
   "texto": "co se nyní jeví oku?"
  },
  {
   "texto": "Jeví se tu ženě, jeví"
  },
  {
   "texto": "vchodem vršek otevřený —"
  },
  {
   "texto": "vysvětliti sobě neví —"
  },
  {
   "texto": "kámen v cestu postavený,"
  },
  {
   "texto": "postavena celá skála"
  },
  {
   "texto": "jak by od věků zde stála."
  },
  {
   "texto": "Jeví se tu, jeví ženě"
  },
  {
   "texto": "chodba pod zemí, co síně"
  },
  {
   "texto": "vyklenutá ve křemeně;"
  },
  {
   "texto": "a tam, klenba kde se tratí,"
  },
  {
   "texto": "ve tmavém pahorku klíně,"
  },
  {
   "texto": "jakýs plamen znamenati."
  },
  {
   "texto": "I hoří to jasnoběle,"
  },
  {
   "texto": "jako v noci svit měsíčka;"
  },
  {
   "texto": "i zaplává rudoskvěle,"
  },
  {
   "texto": "jak by západ to sluníčka."
  },
  {
   "texto": "I vidouc to žena žasne"
  },
  {
   "texto": "a ke vchodu až pokročí,"
  },
  {
   "texto": "a zastíníc dlaní oči,"
  },
  {
   "texto": "hledí v ono místo jasné."
  },
  {
   "texto": "„Bože, jak se to tam svítí!“"
  },
  {
   "texto": "Oči rukou si protírá,"
  },
  {
   "texto": "o krok blíže se ubírá:"
  },
  {
   "texto": "„Jak se to tam divně svítí!"
  },
  {
   "texto": "Co to asi může býti?“"
  },
  {
   "texto": "Dále jíti však se bojí,"
  },
  {
   "texto": "hledíc tam, a venku stojí."
  },
  {
   "texto": "A co váhá a co stojí,"
  },
  {
   "texto": "v klenbu patříc neustále,"
  },
  {
   "texto": "mizí bázeň za pohledem,"
  },
  {
   "texto": "zvědavost ji pudí předem,"
  },
  {
   "texto": "a žena se béře dále."
  },
  {
   "texto": "Krok za krokem — a vždy dále"
  },
  {
   "texto": "mocně ji to jíti pudí;"
  },
  {
   "texto": "krok za krokem — a ve skále"
  },
  {
   "texto": "jen se spící ohlas budí."
  },
  {
   "texto": "A čím dál přichází žena,"
  },
  {
   "texto": "stále divná roste záře."
  },
  {
   "texto": "Již již končí se sklepení;"
  },
  {
   "texto": "avšak žena omráčena"
  },
  {
   "texto": "rukou zakrývá si tváře,"
  },
  {
   "texto": "přímo patřit možné není."
  },
  {
   "texto": "Vidí, vidí — co zde vidí,"
  },
  {
   "texto": "kdy to viděl který z lidí?"
  },
  {
   "texto": "Tolik krásy, tolik blesku"
  },
  {
   "texto": "mní uzříti jen v nebesku!"
  },
  {
   "texto": "Dvéře tu jsou otevřeny"
  },
  {
   "texto": "do nejskvělejšího sálu;"
  },
  {
   "texto": "zlatem jen se svítí stěny,"
  },
  {
   "texto": "strop rubíny vyložený,"
  },
  {
   "texto": "pod ním sloupy ze křišťálu."
  },
  {
   "texto": "Z obojí pak strany dveří"
  },
  {
   "texto": "na podlaze mramorové —"
  },
  {
   "texto": "kdo neviděl, neuvěří —"
  },
  {
   "texto": "hoří, hoří dva ohňové;"
  },
  {
   "texto": "dva ohňové tuto hoří,"
  },
  {
   "texto": "nic jich blesku neumoří:"
  },
  {
   "texto": "nade stříbrem po levici"
  },
  {
   "texto": "lunou oheň vzhůru plane,"
  },
  {
   "texto": "nade zlatem po pravici"
  },
  {
   "texto": "sluncem pláti neustane."
  },
  {
   "texto": "Planou ohně, jizba plane,"
  },
  {
   "texto": "obalena září jasnou;"
  },
  {
   "texto": "a dokud tu poklad stane,"
  },
  {
   "texto": "plamenové nevyhasnou,"
  },
  {
   "texto": "nic jich blesku neumoří."
  },
  {
   "texto": "Na prahu tu žena stojí,"
  },
  {
   "texto": "celá stojí oslepena;"
  },
  {
   "texto": "očí pozdvihnout se bojí,"
  },
  {
   "texto": "nemůž zříti do plamena."
  },
  {
   "texto": "Na levici dítě nese,"
  },
  {
   "texto": "pravou levé mne si oko;"
  },
  {
   "texto": "a když trochu ohlídne se,"
  },
  {
   "texto": "osmělí a vzpamatuje,"
  },
  {
   "texto": "vzdychne sobě přehluboko"
  },
  {
   "texto": "a tak v duši své rokuje:"
  },
  {
   "texto": "„Milý bože, co já zkusím"
  },
  {
   "texto": "na tom světě nouze, hladu!"
  },
  {
   "texto": "Bídně život chránit musím —"
  },
  {
   "texto": "a zde tolik těch pokladů!"
  },
  {
   "texto": "Tolik stříbra, tolik zlata"
  },
  {
   "texto": "v podzemní tu leží skrejši!"
  },
  {
   "texto": "Jenom hrstku z té hromady —"
  },
  {
   "texto": "a já byla bych bohata,"
  },
  {
   "texto": "a byla bych nejšťastnější,"
  },
  {
   "texto": "já i moje dítě tady!“"
  },
  {
   "texto": "A co myslí a co stojí,"
  },
  {
   "texto": "ohroženější se stane;"
  },
  {
   "texto": "svatým křížem se ozbrojí"
  },
  {
   "texto": "a jde, kde to běle plane."
  },
  {
   "texto": "Jde a stříbra kousek zdvihne,"
  },
  {
   "texto": "avšak zase tam položí;"
  },
  {
   "texto": "zdvihne zas a je prohlíží,"
  },
  {
   "texto": "jeho blesk a jeho tíži —"
  },
  {
   "texto": "a zdali je zas položí?"
  },
  {
   "texto": "Ne, již v klíně jí se mihne."
  },
  {
   "texto": "A zdařením tím smělejší:"
  },
  {
   "texto": "„Jistě toto prst je boží,"
  },
  {
   "texto": "poklad ukázal mi v skrejši,"
  },
  {
   "texto": "chce, bych byla oblažena:"
  },
  {
   "texto": "i zhřešiti bych musela,"
  },
  {
   "texto": "bych jím pohrdnouti měla!“"
  },
  {
   "texto": "Takto k sobě mluvíc žena,"
  },
  {
   "texto": "chlapce na zem z ruky složí,"
  },
  {
   "texto": "klekne a klín rozestírá,"
  },
  {
   "texto": "chutě z hromady nabírá"
  },
  {
   "texto": "a do klína stříbro skládá:"
  },
  {
   "texto": "„Jistě toto prst je boží,"
  },
  {
   "texto": "jenž nás obohatit žádá!“"
  },
  {
   "texto": "Béře, béře ze hromady —"
  },
  {
   "texto": "klín již plný, sotva vstává,"
  },
  {
   "texto": "ještě v šátek sobě dává,"
  },
  {
   "texto": "tak ji mámí stříbra vnady!"
  },
  {
   "texto": "A když již chce odtud jíti:"
  },
  {
   "texto": "ach, zde ještě pacholete!"
  },
  {
   "texto": "Jak je ke vší tíži vzíti?"
  },
  {
   "texto": "Pacholátko již dvouleté;"
  },
  {
   "texto": "vysypati zase štěstí"
  },
  {
   "texto": "nezdá se jí dobré býti;"
  },
  {
   "texto": "obého pak nemůž nésti."
  },
  {
   "texto": "A hle, stříbro matka nese!"
  },
  {
   "texto": "Dítě se tu na ni třese:"
  },
  {
   "texto": "„Mama!“ volá, „mama, mama!“"
  },
  {
   "texto": "chytajíc ji ručinkama."
  },
  {
   "texto": "„Mlč, synáčku, mlč, mlč, hochu,"
  },
  {
   "texto": "počkej tuto jenom trochu,"
  },
  {
   "texto": "hned tu bude zase mama!“"
  },
  {
   "texto": "A již běží, síní běží,"
  },
  {
   "texto": "již i síně za ní leží;"
  },
  {
   "texto": "přes potok, po stráni k lesu"
  },
  {
   "texto": "spěchá žena ve svém plesu."
  },
  {
   "texto": "A než malá ušla chvíle,"
  },
  {
   "texto": "prázdná zpátky zas pospíchá;"
  },
  {
   "texto": "a ve potu, sotva dýchá,"
  },
  {
   "texto": "stane zase již u cíle."
  },
  {
   "texto": "A jak vítr zlehka věje,"
  },
  {
   "texto": "z kostela slyšeti pění:"
  },
  {
   "texto": "v kůru tam se právě pěje"
  },
  {
   "texto": "Krista Pána umučení."
  },
  {
   "texto": "A jak síní v jizbu spěje:"
  },
  {
   "texto": "„Haha, mama, haha, mama!“"
  },
  {
   "texto": "radostně se dítě směje,"
  },
  {
   "texto": "potleskujíc ručinkama."
  },
  {
   "texto": "Nedbátě však matka na to,"
  },
  {
   "texto": "běžíc ve stranu protější:"
  },
  {
   "texto": "kovu blesk je jí milejší,"
  },
  {
   "texto": "z kovů nejmilejší zlato."
  },
  {
   "texto": "Klekne a klín rozestírá,"
  },
  {
   "texto": "chutě z hromady nabírá"
  },
  {
   "texto": "a do klína zlato skládá."
  },
  {
   "texto": "Klín již plný, sotva vstává —"
  },
  {
   "texto": "ještě v šátek sobě dává!"
  },
  {
   "texto": "Ó jak jí tu srdce skáče,"
  },
  {
   "texto": "jak je štěstí svému ráda!"
  },
  {
   "texto": "A když zlato matka nese,"
  },
  {
   "texto": "dítě se tu na ni třese,"
  },
  {
   "texto": "třese a žalostně pláče:"
  },
  {
   "texto": "„Mama, mama, ach, ach, mama!“"
  },
  {
   "texto": "chytajíc ji ručinkama."
  },
  {
   "texto": "„Mlč, synáčku, mlč, mlč, hochu,"
  },
  {
   "texto": "počkej jenom ještě trochu.“"
  },
  {
   "texto": "A k dítěti se nakloní"
  },
  {
   "texto": "a do klína rukou sáhne,"
  },
  {
   "texto": "dva peníze ven vytáhne,"
  },
  {
   "texto": "o peníz penízem zvoní:"
  },
  {
   "texto": "„Hle hleď, co to má maminka!"
  },
  {
   "texto": "Cincin! slyšíš, jak to cinká?“"
  },
  {
   "texto": "Avšak dítě stále pláče —"
  },
  {
   "texto": "jí radostí srdce skáče."
  },
  {
   "texto": "A do klína opět sáhne,"
  },
  {
   "texto": "plnou zlata hrst vytáhne,"
  },
  {
   "texto": "vloží dítěti do klínka:"
  },
  {
   "texto": "„Hle hleď, co ti dá maminka!"
  },
  {
   "texto": "Mlč, synáčku, mlč, mlč, hochu:"
  },
  {
   "texto": "cincin! poslyš, jak to cinká!"
  },
  {
   "texto": "Počkej jenom ještě trochu,"
  },
  {
   "texto": "hned se vrátí zas maminka."
  },
  {
   "texto": "Hrej si pěkně, hrej, děťátko,"
  },
  {
   "texto": "počkej ještě jen drobátko.“"
  },
  {
   "texto": "A již běží, síní běží,"
  },
  {
   "texto": "na dítě se neohlíží;"
  },
  {
   "texto": "a již síně za ní leží,"
  },
  {
   "texto": "již se ku potoku blíží;"
  },
  {
   "texto": "přes potok, po stráni v plesu"
  },
  {
   "texto": "drahý poklad nese k lesu,"
  },
  {
   "texto": "a již stojí s ním před chýží."
  },
  {
   "texto": "„Hoj, ty chýže, sprostá chýže,"
  },
  {
   "texto": "brzy měj se dobře tady!"
  },
  {
   "texto": "Co mě k tobě nyní víže?"
  },
  {
   "texto": "Nenalézám v tobě vnady!"
  },
  {
   "texto": "Půjdu pryč z těch tmavých lesů,"
  },
  {
   "texto": "z té otcovské střechy chudé;"
  },
  {
   "texto": "jinde štěstí své ponesu,"
  },
  {
   "texto": "jinde moje bydlo bude!"
  },
  {
   "texto": "Půjdu, půjdu z toho kraje,"
  },
  {
   "texto": "radostná mi odtud cesta,"
  },
  {
   "texto": "půjdu, když mi štěstí zraje,"
  },
  {
   "texto": "do velkého půjdu města;"
  },
  {
   "texto": "koupím sobě země, hrady,"
  },
  {
   "texto": "co paní mě budou ctíti:"
  },
  {
   "texto": "měj se dobře, chýžko, tady,"
  },
  {
   "texto": "nebudu já v tobě žíti!"
  },
  {
   "texto": "Nejsem již ta chudá vdova,"
  },
  {
   "texto": "péči nesouc v noci ve dne:"
  },
  {
   "texto": "ejhle v klínu“ — na ta slova"
  },
  {
   "texto": "s potěšením tam pohledne. —"
  },
  {
   "texto": "Ó kéž byla nepohledla!"
  },
  {
   "texto": "Leknutím tu celá zbledla,"
  },
  {
   "texto": "leknutím se třese celá,"
  },
  {
   "texto": "div na místě neomdlela."
  },
  {
   "texto": "Vidí, vidí — ha, co vidí,"
  },
  {
   "texto": "sama tomu sotva věří!"
  },
  {
   "texto": "Do zpukřelých vrazí dveří,"
  },
  {
   "texto": "vrazí, kde truhlice byla,"
  },
  {
   "texto": "v kterou stříbro uložila."
  },
  {
   "texto": "Strhne víko — ha, co vidí!"
  },
  {
   "texto": "Pro vši víru dobrých lidí,"
  },
  {
   "texto": "jaká opět nová rána!"
  },
  {
   "texto": "Místo stříbra jen — kamení,"
  },
  {
   "texto": "v šátku pak a ve svém klínu,"
  },
  {
   "texto": "ó přehrozné to mámení,"
  },
  {
   "texto": "místo zlata — samou hlínu!"
  },
  {
   "texto": "Čáka všecka rozšlapána! — —"
  },
  {
   "texto": "Nehodnatě štěstí byla,"
  },
  {
   "texto": "požehnání neužila."
  },
  {
   "texto": "II"
  },
  {
   "texto": "A když takto rozdrceně"
  },
  {
   "texto": "s bolestí tu ztrátu nese,"
  },
  {
   "texto": "probodne to srdce ženě,"
  },
  {
   "texto": "vzkřikne s hrůzou vyděšeně,"
  },
  {
   "texto": "vzkřikne, a se chýže třese:"
  },
  {
   "texto": "„Ach dítě, mé dítě drahé!"
  },
  {
   "texto": "Dítě drahé — drahé — drahé!“"
  },
  {
   "texto": "zahučelo v hustém lese."
  },
  {
   "texto": "A ve hrozném předtušení"
  },
  {
   "texto": "běží žena — ach neběží,"
  },
  {
   "texto": "letí, letem ptáka letí,"
  },
  {
   "texto": "lesem, strání ji viděti,"
  },
  {
   "texto": "tam, kde klamné našla jmění,"
  },
  {
   "texto": "k vršku, na něm kostel leží."
  },
  {
   "texto": "Od kostela větřík věje,"
  },
  {
   "texto": "copak neslyšeti pění? —"
  },
  {
   "texto": "Krista Pána umučení"
  },
  {
   "texto": "v kůru tam se již nepěje."
  },
  {
   "texto": "A když přišla ke sklepení,"
  },
  {
   "texto": "haha, jaké pohledění!"
  },
  {
   "texto": "Haha, z divokého klestu"
  },
  {
   "texto": "tři sta kroků od kostela"
  },
  {
   "texto": "veliký ční kámen v cestu!"
  },
  {
   "texto": "A kde síně? — Ta zmizela!"
  },
  {
   "texto": "Zmizela, i v cestě skála,"
  },
  {
   "texto": "jak by nikdy zde nestála."
  },
  {
   "texto": "Ha, jak se tu žena leká,"
  },
  {
   "texto": "jak se děsí, volá,"
  },
  {
   "texto": "hledá, jak po tom pahorku těká,"
  },
  {
   "texto": "těmi klesty, na smrt bledá!"
  },
  {
   "texto": "Ha, ty zraky zoufanlivé,"
  },
  {
   "texto": "ústa siná nad mrtvolu!"
  },
  {
   "texto": "Hle, jak přes to křoví divé"
  },
  {
   "texto": "běží — pádí tamto k dolu!"
  },
  {
   "texto": "Běda, běda! Zde to není!"
  },
  {
   "texto": "Tělo klestím rozervané,"
  },
  {
   "texto": "nohy trním probodané —"
  },
  {
   "texto": "darmo všecko klopotění,"
  },
  {
   "texto": "vchodu již nalézti není!"
  },
  {
   "texto": "A znovu se žena děsí,"
  },
  {
   "texto": "úzkost hrozná ji uchvátí:"
  },
  {
   "texto": "„Ach, kdo mně mé dítě vrátí!"
  },
  {
   "texto": "Ach mé dítě, kde jsi, kde jsi?!“ —"
  },
  {
   "texto": "„Tu pod zemí jsem, hluboko!“"
  },
  {
   "texto": "hlas tichounký větrem šumí,"
  },
  {
   "texto": "nespatří mne žádné oko,"
  },
  {
   "texto": "ucho mi neporozumí."
  },
  {
   "texto": "Blaze tu pod zemí, blaze,"
  },
  {
   "texto": "beze jídla, beze pití,"
  },
  {
   "texto": "na mramorové podlaze,"
  },
  {
   "texto": "ryzí zlato v klínku míti!"
  },
  {
   "texto": "Noc a den se nestřídají"
  },
  {
   "texto": "nikdy nejdou spát očinka:"
  },
  {
   "texto": "hraji si tu pěkně, hraji —"
  },
  {
   "texto": "cincin! slyšíš, jak to cinká?"
  },
  {
   "texto": "Avšak žena znovu hledá —"
  },
  {
   "texto": "darmo, a znovu se děsí,"
  },
  {
   "texto": "zoufale se na zem vrhá,"
  },
  {
   "texto": "vlasy sobě z hlavy trhá,"
  },
  {
   "texto": "zkrvavena, na smrt bledá:"
  },
  {
   "texto": "„Ach běda mi! Běda, běda!"
  },
  {
   "texto": "Ach mé dítě, kde jsi, kde jsi?"
  },
  {
   "texto": "Kde tě najdu, dítě drahé?!"
  },
  {
   "texto": "Dítě drahé — drahé — drahé!“"
  },
  {
   "texto": "blízkými to hučí lesy."
  },
  {
   "texto": "III"
  },
  {
   "texto": "Mine den, i druhý mine,"
  },
  {
   "texto": "dnové v týden se obrátí,"
  },
  {
   "texto": "z týdnů měsíc se vyvine,"
  },
  {
   "texto": "a i léto počne pláti."
  },
  {
   "texto": "Na pahorku mezi buky"
  },
  {
   "texto": "kostelíček s věží nízkou;"
  },
  {
   "texto": "co den znějí zvonka zvuky"
  },
  {
   "texto": "hájem a sousední vískou."
  },
  {
   "texto": "Tu nahoře, když se zrána"
  },
  {
   "texto": "ke mši zvonečkem pozvoní,"
  },
  {
   "texto": "přede stánkem nebes pána"
  },
  {
   "texto": "zbožný rolník čelo kloní."
  },
  {
   "texto": "Aj, kdo zná ji, tu osobu"
  },
  {
   "texto": "se sklopenou k zemi tváří?"
  },
  {
   "texto": "Svíce zhasly na oltáři,"
  },
  {
   "texto": "ona klečí po tu dobu."
  },
  {
   "texto": "Zdáť se, ani že nedýše —"
  },
  {
   "texto": "líce a rty zesinalé —"
  },
  {
   "texto": "ach, to se tak modlí tiše!"
  },
  {
   "texto": "Kdo to? — Nevím, tuším ale."
  },
  {
   "texto": "Když po svaté však oběti"
  },
  {
   "texto": "chrámové se zamknou dvéře,"
  },
  {
   "texto": "těmi buky ji viděti,"
  },
  {
   "texto": "ana se z pahorku béře."
  },
  {
   "texto": "Béře, béře se pomálu"
  },
  {
   "texto": "stezkou vinoucí se v klestu"
  },
  {
   "texto": "po šedivou tamo skálu,"
  },
  {
   "texto": "kde ční kámen velký v cestu."
  },
  {
   "texto": "Tu si vzdychne přehluboko"
  },
  {
   "texto": "a do dlaně čelo sklopí:"
  },
  {
   "texto": "„Ach mé dítě!“ — a již oko"
  },
  {
   "texto": "v slzách kanoucích se topí."
  },
  {
   "texto": "Nešťastná to z chýže žena,"
  },
  {
   "texto": "vždycky smutná, vždycky bledá,"
  },
  {
   "texto": "vždycky těžce zamyšlena;"
  },
  {
   "texto": "od rána a do soumraku"
  },
  {
   "texto": "nikdy jasno v jejím zraku,"
  },
  {
   "texto": "v noci pak žel spáti nedá."
  },
  {
   "texto": "A když opět na úsvitě"
  },
  {
   "texto": "traplivé opouští lože:"
  },
  {
   "texto": "„Ach mé dítě, drahé dítě,"
  },
  {
   "texto": "ach běda mi, běda, běda!"
  },
  {
   "texto": "Odpusť milostivý Bože!“"
  },
  {
   "texto": "Uplynulo léto celé,"
  },
  {
   "texto": "jeseň, zima uplynula —"
  },
  {
   "texto": "nezmírněno v srdci žele,"
  },
  {
   "texto": "slza v oku nezhynula."
  },
  {
   "texto": "I když výše slunce stálo,"
  },
  {
   "texto": "rozehřávši zemi znova,"
  },
  {
   "texto": "úst k úsměchu nerozhřálo,"
  },
  {
   "texto": "stáleť ještě pláče vdova."
  },
  {
   "texto": "IV"
  },
  {
   "texto": "A slyš, shůry mezi buky,"
  },
  {
   "texto": "z kostelíčka s věží nízkou,"
  },
  {
   "texto": "rachotící slyšet zvuky"
  },
  {
   "texto": "hájem a sousední vískou."
  },
  {
   "texto": "A hle, vzhůru k boží slávě"
  },
  {
   "texto": "běží z vísky zástup hojný,"
  },
  {
   "texto": "veský lid to bohabojný —"
  },
  {
   "texto": "a dnes Velký pátek právě."
  },
  {
   "texto": "Jemně jarní větřík věje,"
  },
  {
   "texto": "větrem pak slyšeti pění:"
  },
  {
   "texto": "v kostele se zase pěje"
  },
  {
   "texto": "Krista Pána umučení."
  },
  {
   "texto": "A tou strání ku potoku"
  },
  {
   "texto": "žena od lesa se blíží."
  },
  {
   "texto": "Co zdržuje dnes ji v kroku? —"
  },
  {
   "texto": "Ach, památka dne a roku"
  },
  {
   "texto": "hořem kroky její tíží!"
  },
  {
   "texto": "Blíží, blíží se znenáhla,"
  },
  {
   "texto": "a již skály té dosáhla."
  },
  {
   "texto": "A hle, co se jeví oku?"
  },
  {
   "texto": "Tu, kde z divokého klestu,"
  },
  {
   "texto": "od kostela tři sta kroků,"
  },
  {
   "texto": "veliký čněl kámen v cestu,"
  },
  {
   "texto": "vchodem vršek otevřený,"
  },
  {
   "texto": "kámen v cestu postavený,"
  },
  {
   "texto": "kámen i ta celá skála,"
  },
  {
   "texto": "jak by tak od věků stála."
  },
  {
   "texto": "A žena se toho leká,"
  },
  {
   "texto": "hrůzou se jí vlasy ježí:"
  },
  {
   "texto": "celou tíží na ní leží"
  },
  {
   "texto": "zármutek a vina její."
  },
  {
   "texto": "I děsí se — však nečeká,"
  },
  {
   "texto": "a ve strachu a v naději"
  },
  {
   "texto": "skokem síní známou běží,"
  },
  {
   "texto": "síní jdoucí pode skálu."
  },
  {
   "texto": "A hle, dvéře otevřeny"
  },
  {
   "texto": "do nejskvělejšího sálu;"
  },
  {
   "texto": "zlatem jen se svítí stěny,"
  },
  {
   "texto": "strop rubíny vyložený,"
  },
  {
   "texto": "pod ním sloupy ze křišťálu."
  },
  {
   "texto": "A z obojí strany dveří"
  },
  {
   "texto": "na podlaze mramorové"
  },
  {
   "texto": "plápolají dva ohňové:"
  },
  {
   "texto": "nade stříbrem po levici"
  },
  {
   "texto": "lunou oheň vzhůru plane,"
  },
  {
   "texto": "nade zlatem po pravici"
  },
  {
   "texto": "sluncem pláti nepřestane."
  },
  {
   "texto": "A žena se s hrůzou blíží"
  },
  {
   "texto": "a ve strachu a v naději"
  },
  {
   "texto": "tu po jizbě se ohlíží."
  },
  {
   "texto": "Snad ji vábí stříbro, zlato? —"
  },
  {
   "texto": "Ach, již ona nedbá na to!"
  },
  {
   "texto": "„Haha, mama, haha, mama!“"
  },
  {
   "texto": "Ejhle dítě, dítě její,"
  },
  {
   "texto": "po celý rok oplakané,"
  },
  {
   "texto": "potleskuje ručinkama!"
  },
  {
   "texto": "Ale v ženě není dechu,"
  },
  {
   "texto": "a hrůzou se celá třese,"
  },
  {
   "texto": "a ve zoufanlivém spěchu"
  },
  {
   "texto": "chopíc dítě do náručí,"
  },
  {
   "texto": "dlouhou síní odtud nese."
  },
  {
   "texto": "A třesk, třesk! huhu! to hučí"
  },
  {
   "texto": "jí v patách ve vrchu klíně;"
  },
  {
   "texto": "praskot hrozný, vichr skučí,"
  },
  {
   "texto": "zem se třese, hluk a lomoz —"
  },
  {
   "texto": "jí v patách se boří síně!"
  },
  {
   "texto": "„Ach, rodičko boží, pomoz!“"
  },
  {
   "texto": "v úzkosti tu volá žena,"
  },
  {
   "texto": "zpět pohlédnouc poděšena."
  },
  {
   "texto": "A hle! jaká zase změna!"
  },
  {
   "texto": "Ticho všecko, a tu z klestu"
  },
  {
   "texto": "veliký ční kámen v cestu;"
  },
  {
   "texto": "vše jak jindy spořádáno,"
  },
  {
   "texto": "po vchodu památky není:"
  },
  {
   "texto": "právě nyní dozpíváno"
  },
  {
   "texto": "Krista Pána umučení."
  },
  {
   "texto": "Ale v ženě není dechu,"
  },
  {
   "texto": "a hrůzou se celá třese,"
  },
  {
   "texto": "a ve zoufanlivém spěchu"
  },
  {
   "texto": "dítě svoje odtud nese,"
  },
  {
   "texto": "nese a na ňadra tlačí,"
  },
  {
   "texto": "jako by se o ně bála;"
  },
  {
   "texto": "běží, sotva dech jí stačí,"
  },
  {
   "texto": "ač daleko za ní skála;"
  },
  {
   "texto": "běží, aniž se ohlíží,"
  },
  {
   "texto": "tam tou strání blíže lesu,"
  },
  {
   "texto": "a ve strachu a ve plesu"
  },
  {
   "texto": "stane v chudé lesní chýži."
  },
  {
   "texto": "Ó jaké tu vzdává vroucí"
  },
  {
   "texto": "bohu svému žena díky!"
  },
  {
   "texto": "Vizte slzy ty kanoucí!"
  },
  {
   "texto": "Jak to dítě k sobě vine,"
  },
  {
   "texto": "líbá čelo, ručky, rtíky,"
  },
  {
   "texto": "a zas k ňadrám je přitiská,"
  },
  {
   "texto": "jak celá v rozkoši plyne!"
  },
  {
   "texto": "A hle, co se v klínku blýská?"
  },
  {
   "texto": "Co to znělo? — Ryzí zlato!"
  },
  {
   "texto": "To zlato, jež loni byla,"
  },
  {
   "texto": "aby dítě si pohrálo,"
  },
  {
   "texto": "jemu v klínek položila."
  },
  {
   "texto": "Avšak ženu vábí málo,"
  },
  {
   "texto": "co ji tolik hoře stálo!"
  },
  {
   "texto": "Stáloť ji, ach, slzí mnoho;"
  },
  {
   "texto": "leč děkujíc bohu za to,"
  },
  {
   "texto": "touže drahé tiskne děcko."
  },
  {
   "texto": "Hořceť zakusila toho:"
  },
  {
   "texto": "žetě velmi málo zlato,"
  },
  {
   "texto": "avšak dítě nade všecko!"
  },
  {
   "texto": "V"
  },
  {
   "texto": "Dávno kostelíček zbořen;"
  },
  {
   "texto": "umlkly již zvonka zvuky;"
  },
  {
   "texto": "a kde někdy stály buky,"
  },
  {
   "texto": "sotva jaký hnije kořen."
  },
  {
   "texto": "Stařec mnoho pamatuje,"
  },
  {
   "texto": "mnohoť i dozrálo hrobu,"
  },
  {
   "texto": "avšak lid si ukazuje"
  },
  {
   "texto": "ještě místa po tu dobu."
  },
  {
   "texto": "A když večer pohromadě"
  },
  {
   "texto": "mládež za mrazu sedává,"
  },
  {
   "texto": "rád stařeček povídává"
  },
  {
   "texto": "o vdově a o pokladě."
  }
 ]
}