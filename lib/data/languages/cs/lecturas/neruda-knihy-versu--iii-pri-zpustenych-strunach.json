{
 "id": "neruda-knihy-versu--iii-pri-zpustenych-strunach",
 "titulo": "III. Při zpuštěných strunách",
 "autor": "Jan Neruda",
 "muerteAutor": 1891,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Knihy_ver%C5%A1%C5%AF/III._P%C5%99i_zpu%C5%A1t%C4%9Bn%C3%BDch_strun%C3%A1ch",
 "fuente": "cs.wikisource.org, «Knihy veršů»",
 "licencia": "dominio público (autor muerto en 1891)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "neruda-knihy-versu",
  "titulo": "Knihy veršů",
  "orden": 31
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Znám vás prsa pěvná, tužná,"
  },
  {
   "texto": "a v těch prsou, srdce, tebe,"
  },
  {
   "texto": "vycházejíť písně z tebe,"
  },
  {
   "texto": "jako andělové z nebe."
  },
  {
   "texto": "Vycházejí buď v své nahé,"
  },
  {
   "texto": "buď ve zahalené kráse,"
  },
  {
   "texto": "jedny k mému zatracení,"
  },
  {
   "texto": "a ty druhé zas k mé spáse."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Vy děti lásky, chudé písně moje,"
  },
  {
   "texto": "zdaž za otce se svého nestydíte,"
  },
  {
   "texto": "že odmrštěny — sotva narozeny —"
  },
  {
   "texto": "se za žebrotou k cizím odklidíte?"
  },
  {
   "texto": "Australská žena, když jí dítě zemře,"
  },
  {
   "texto": "ty drahé zbytky všije do koží,"
  },
  {
   "texto": "a ve dne mrtvolu na bedrách nosí,"
  },
  {
   "texto": "svou hlavu večer na ni uloží."
  },
  {
   "texto": "A když jak lístek uschlo, pohrobí je,"
  },
  {
   "texto": "nad hrobem hrudou prsa rozerve,"
  },
  {
   "texto": "vždyť je to svadlé kvítko její lásky,"
  },
  {
   "texto": "a píseň mrtvá živé ze krve!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Jsemli syn neb cizím Apollinu,"
  },
  {
   "texto": "to mou mysl lehkou nermoutí,"
  },
  {
   "texto": "aniž úsudek snad pohanlivý"
  },
  {
   "texto": "někdy čelo moje posmoutí."
  },
  {
   "texto": "Jesti, myslím, poesie první"
  },
  {
   "texto": "podíl každého už dítěte,"
  },
  {
   "texto": "jeho okem, mysli jeho chůvou,"
  },
  {
   "texto": "první učitelkou ve světě."
  },
  {
   "texto": "A ta milá dáma poesie"
  },
  {
   "texto": "je jak vůbec všechny dívčiny,"
  },
  {
   "texto": "věčné nevěrnosti věčně věrná,"
  },
  {
   "texto": "a když prchne, povždy bez viny."
  },
  {
   "texto": "A kdo dívkám věří — stará píseň! –"
  },
  {
   "texto": "píše „věřím“ v řeku plynoucí,"
  },
  {
   "texto": "po pavučinách se k nebi souká,"
  },
  {
   "texto": "v sítě chytá stíny hynoucí."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Však znám ten lid, jenž nožem pytvy hnusné"
  },
  {
   "texto": "si chleb a slávu potem dobývá,"
  },
  {
   "texto": "snad zpěv můj klada na své váhy nuzné,"
  },
  {
   "texto": "juž znak mu svého soudu v čelo vyrývá."
  },
  {
   "texto": "On z pýlu motýlův si vápno pálí,"
  },
  {
   "texto": "kdy trámů třeba, les si cizí skotí,"
  },
  {
   "texto": "kdy písek váží, jasný pramen kalí,"
  },
  {
   "texto": "kdy kámen láme, sousedův dům shrotí."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Mnoho bolů v tomto světě,"
  },
  {
   "texto": "mnohý vzdech se zachvěje,"
  },
  {
   "texto": "mnohý blázen, co ho hněte,"
  },
  {
   "texto": "v dumné písni zapěje."
  },
  {
   "texto": "Mnoho skořep v širém moři,"
  },
  {
   "texto": "mnohá z nich i v chorobě,"
  },
  {
   "texto": "však jen jedna ze slz tvoří"
  },
  {
   "texto": "perlu v stkvoucí údobě."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Lehko nyní zamilovanému,"
  },
  {
   "texto": "co se chuďas dříve navzdychal,"
  },
  {
   "texto": "a než rýmy svedl předce k čemu,"
  },
  {
   "texto": "jako kovář ohně nadmychal!"
  },
  {
   "texto": "Otcové nám dávno přezpívali"
  },
  {
   "texto": "lásku všelikým už způsobem,"
  },
  {
   "texto": "a ty písně pěkně napísali,"
  },
  {
   "texto": "než se seznámili se hrobem."
  },
  {
   "texto": "Synu, kdy pocítíš lásky tísně,"
  },
  {
   "texto": "nepotřebně ohně nedmychej,"
  },
  {
   "texto": "čti jen otcův přecitlivé písně,"
  },
  {
   "texto": "a k těm písním sobě zavzdychej!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Nalykav se prachu z lidské hlíny,"
  },
  {
   "texto": "pojav hrobův živou myšlénku,"
  },
  {
   "texto": "darmo sháním s oka charé stíny,"
  },
  {
   "texto": "klesám zemdlen v krypty výklenku."
  },
  {
   "texto": "Spánek na oko se zmdlené sklání,"
  },
  {
   "texto": "jako mlha pláni zaplaví —"
  },
  {
   "texto": "mlhu slunce v rosu rozehání —"
  },
  {
   "texto": "mysl tvoří ve snu postavy."
  },
  {
   "texto": "Přede mnou se zastkví obraz jasný,"
  },
  {
   "texto": "z démantův jak záře setkaný,"
  },
  {
   "texto": "vystupuje z něho jinoch krásný,"
  },
  {
   "texto": "duševním kýms kouzlem nadaný."
  },
  {
   "texto": "V řasách volných přeskvostného rouna"
  },
  {
   "texto": "hraje sterá barva měňavá,"
  },
  {
   "texto": "tak jak v rouše prý chameleona"
  },
  {
   "texto": "s barvou svou květ každý zahrává."
  },
  {
   "texto": "„Kdož jsi? — Pravda? — Či tě sen můj bájí?“"
  },
  {
   "texto": "„Mne co mocnosť věčné proměny,"
  },
  {
   "texto": "bratří tvoji smrtí nazývají. —"
  },
  {
   "texto": "Sleduj mne jen, spáči zmámený.\""
  },
  {
   "texto": "Mimovolně noha moje vstane,"
  },
  {
   "texto": "spěchám divy uzřít žádaje,"
  },
  {
   "texto": "až duch před náhrobkem jakýms stane,"
  },
  {
   "texto": "bych si nápis četl, kývaje."
  },
  {
   "texto": ",Aj, zde odpočívá poezije,"
  },
  {
   "texto": "byla, květla, svadla, setlela!' —"
  },
  {
   "texto": "„V tom se, brachu, leda žert kýs kryje,"
  },
  {
   "texto": "poezije že by zemřela? —"
  },
  {
   "texto": "A což lyry zvuk by přeznít mělo?“"
  },
  {
   "texto": "Pokleknout mně dal bůh znamení: —"
  },
  {
   "texto": "z nitra země v ucho mocně znělo"
  },
  {
   "texto": "kyklopických kladiv bušení."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Poezie žila, dokud každý"
  },
  {
   "texto": "snům svým víc než pravdě uvěřil,"
  },
  {
   "texto": "dokud věci nám teď malicherné"
  },
  {
   "texto": "obrovským měřítkem vyměřil."
  },
  {
   "texto": "Dokud bájím věřil zastaralým,"
  },
  {
   "texto": "ježto zrodil zpráchnivělý věk,"
  },
  {
   "texto": "dokud v palmách dryádky se kryly,"
  },
  {
   "texto": "a ne sago z našich polívek."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Na vršíku dům stál bláznů."
  },
  {
   "texto": "Panna tudy chodila,"
  },
  {
   "texto": "chytili ji, aby bláznům"
  },
  {
   "texto": "leccos k vůli rodila."
  },
  {
   "texto": "Na stůl si ji posadili,"
  },
  {
   "texto": "pod sklenici vklopili,"
  },
  {
   "texto": "aby pěkně přibývala,"
  },
  {
   "texto": "notně pod ní topili."
  },
  {
   "texto": "Panna arci churavěla,"
  },
  {
   "texto": "panna arci skonala;"
  },
  {
   "texto": "radosť tu však blázni měli,"
  },
  {
   "texto": "pannou že jim zůstala."
  },
  {
   "texto": "Bravo, páni literáti,"
  },
  {
   "texto": "dejte pozor na ženské,"
  },
  {
   "texto": "byť i písemnictví pošlo —"
  },
  {
   "texto": "jen když bude panenské!"
  }
 ]
}