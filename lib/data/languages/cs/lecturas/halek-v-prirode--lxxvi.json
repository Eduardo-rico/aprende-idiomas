 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "LXXVI."
  },
  {
   "texto": "Cestička jak můstek bílý,"
  },
  {
   "texto": "z polí klenut do lesů,"
  },
  {
   "texto": "koho vidím chodit po ní,"
  },
  {
   "texto": "jako když jde do plesu."
  },
  {
   "texto": "Chodí po ní velcí páni:"
  },
  {
   "texto": "jelen s laňkou po boku,"
  },
  {
   "texto": "a ty srnky baletnice"
  },
  {
   "texto": "s kůzlaty vždy do skoku."
  },
  {
   "texto": "Chodí zajíc, uchem, tváří,"
  },
  {
   "texto": "v komika se přitvoří,"
  },
  {
   "texto": "a veverka neposeda"
  },
  {
   "texto": "ta se po něm pitvoří."
  },
  {
   "texto": "Chodí větřík, zahvízdá si,"
  },
  {
   "texto": "na patách se otočí,"
  },
  {
   "texto": "a když tam jde srdce moje,"
  },
  {
   "texto": "jako pták si poskočí."
  },
  {
   "texto": "Od ranní hory slunce vstává,"
  },
  {
   "texto": "paprsky letí do kraje,"
  },
  {
   "texto": "a na stromech se rosa třese,"
  },
  {
   "texto": "a všecky barvy zahraje."
  },
  {
   "texto": "A rosa jako z diamantů,"
  },
  {
   "texto": "ty lesy v zlatém oděvu,"
  },
  {
   "texto": "a každý strom a každý lístek"
  },
  {
   "texto": "pln blaha a pln úsměvu."
  },
  {
   "texto": "A každá krůpěj jako oko,"
  },
  {
   "texto": "a les pln teplých pohledů,"
  },
  {
   "texto": "ba zdá se mi, že jimi lesu"
  },
  {
   "texto": "až v duši patřit dovedu."
  },
  {
   "texto": "Ba zdá se mi, že slzy vidím,"
  },
  {
   "texto": "v nichž les má píseň počatou —"
  },
  {
   "texto": "mněť každá slza kusem básně"
  },
  {
   "texto": "a s slzou každý poetou."
  },
  {
   "texto": "Jabloň v květu! Po větvičkách"
  },
  {
   "texto": "pěnkava se prochází,"
  },
  {
   "texto": "v drobném hnízdě čtyry krčky,"
  },
  {
   "texto": "každý matku provází."
  },
  {
   "texto": "Vrcholkem se větřík houpá,"
  },
  {
   "texto": "větve v teplém oddechu,"
  },
  {
   "texto": "a dva kvítky pozvedly se"
  },
  {
   "texto": "v třepotu a pospěchu."
  },
  {
   "texto": "Světlo po listech se krade,"
  },
  {
   "texto": "kam si sedne, pozlatí,"
  },
  {
   "texto": "čtyry krčky vypnuly se —"
  },
  {
   "texto": "„Hleďme, my jsme bohatí!“"
  },
  {
   "texto": "Sousedního stromu čermák"
  },
  {
   "texto": "přines’ velkou novinu:"
  },
  {
   "texto": "stará sedla na vajíčka,"
  },
  {
   "texto": "bude míti rodinu."
  },
  {
   "texto": "Čtyry krčky poslouchají,"
  },
  {
   "texto": "větřík ani nedutá —"
  },
  {
   "texto": "květy prší na mou hlavu,"
  },
  {
   "texto": "a má duše pohnutá."
  },
  {
   "texto": "Lesní hody, velké hody!"
  },
  {
   "texto": "Pokraj vlajou prapory —"
  },
  {
   "texto": "břízy jako křída bílé"
  },
  {
   "texto": "s zelenými fábory."
  },
  {
   "texto": "Pod stromy sedátek plno,"
  },
  {
   "texto": "mech je vystlal do měkka,"
  },
  {
   "texto": "křoví kolem samá kytka,"
  },
  {
   "texto": "hudebníci z daleka."
  },
  {
   "texto": "Studánky jak jedna perla,"
  },
  {
   "texto": "v stínu jako ve sklepu,"
  },
  {
   "texto": "stromy vlídní hospodáři"
  },
  {
   "texto": "dají zrovna od čepu."
  },
  {
   "texto": "Lesní panny strojí na stůl,"
  },
  {
   "texto": "větřík povznes’ přípitek,"
  },
  {
   "texto": "ptáci vpadli plným sborem —"
  },
  {
   "texto": "já mám u nich příbytek."
  },
  {
   "texto": "Dennice mrká nad strání:"
  },
  {
   "texto": "Zbuďte se, kvítka, ze spaní,"
  },
  {
   "texto": "rosička padla, mejte se,"
  },
  {
   "texto": "den je už tady, strojte se!"
  },
  {
   "texto": "Kvítka už jako z povděku"
  },
  {
   "texto": "v lesku a plném obleku,"
  },
  {
   "texto": "které si hlídá poupátko,"
  },
  {
   "texto": "to ještě zdřímne na krátko."
  },
  {
   "texto": "Jako když v buben udeří,"
  },
  {
   "texto": "skřivánek v modro zaměří,"
  },
  {
   "texto": "volá a zpívá v roznětu:"
  },
  {
   "texto": "mějte se, děti, ku světu!"
  },
  {
   "texto": "Ten to vzal teprv od noty:"
  },
  {
   "texto": "tváře už tkány z lepoty,"
  },
  {
   "texto": "vlas samá vůně, fábory,"
  },
  {
   "texto": "a na rtech sladké hovory."
  },
  {
   "texto": "To dnes ti páni motýli"
  },
  {
   "texto": "budou jak krásou opilí:"
  },
  {
   "texto": "slova i srdce utratí,"
  },
  {
   "texto": "domů se bez nich navrátí."
  }
 ]
}