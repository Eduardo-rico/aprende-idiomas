 "parrafos": [
  {
   "texto": "Divoucí div to — Bože můj"
  },
  {
   "texto": "Divoucí div to — Bože můj,"
  },
  {
   "texto": "co v lásce k nám se skloní!"
  },
  {
   "texto": "Celý svět v ní by roztál se"
  },
  {
   "texto": "a vše jen žije pro ni."
  },
  {
   "texto": "Obláček tam se po nebi"
  },
  {
   "texto": "co lásky posel honí,"
  },
  {
   "texto": "a pták, co dřímá na větvi —"
  },
  {
   "texto": "ten sní a jen sní o ní."
  },
  {
   "texto": "A člověk tady na zemi,"
  },
  {
   "texto": "než smrt mu hlavu skloní,"
  },
  {
   "texto": "on pláče, plesá, touží, lká,"
  },
  {
   "texto": "on žije a umírá pro ni."
  },
  {
   "texto": "Ba andělé tam na nebi,"
  },
  {
   "texto": "když zpěv jim z harf se roní —"
  },
  {
   "texto": "o čem by mohli zpívat jen,"
  },
  {
   "texto": "nesmíce zpívat o ní!"
  },
  {
   "texto": "Bůh povolal mne do ráje,"
  },
  {
   "texto": "bych tam učil zpěvu."
  },
  {
   "texto": "»Ne dobře být mi samotnu!«"
  },
  {
   "texto": "A Bůh mi stvořil Evu."
  },
  {
   "texto": "Ne žebro vyňal z ňader mi,"
  },
  {
   "texto": "leč srdce mého půli,"
  },
  {
   "texto": "a proto se tak rádo teď,"
  },
  {
   "texto": "to srdce k Tvému tulí."
  },
  {
   "texto": "A proto tak se divná teď"
  },
  {
   "texto": "mi touha v srdci hostí,"
  },
  {
   "texto": "a jest mi, jak by srdce nám"
  },
  {
   "texto": "zas měla v jedno srosti."
  },
  {
   "texto": "A proto, když jsem daleko,"
  },
  {
   "texto": "zpět noha marně kráčí"
  },
  {
   "texto": "a u srdce mi bolno tak,"
  },
  {
   "texto": "že jest mi — ba až k pláči."
  },
  {
   "texto": "Kdyby ten slavíček"
  },
  {
   "texto": "s svou družkou přebýval,"
  },
  {
   "texto": "on by tak žalostně"
  },
  {
   "texto": "o lásce nezpíval."
  },
  {
   "texto": "Kdyby to srdéčko"
  },
  {
   "texto": "s Tebou noc probdělo"
  },
  {
   "texto": "však by tak bolestně"
  },
  {
   "texto": "v těch ňadrech neznělo."
  },
  {
   "texto": "Mám Ti to sladké tajemství"
  },
  {
   "texto": "jak slavík vyklokotal v doubí —"
  },
  {
   "texto": "či mám to v slzách vyplakat,"
  },
  {
   "texto": "co zmítá srdce mého hloubí?"
  },
  {
   "texto": "Či kleče zbožnou modlitbou"
  },
  {
   "texto": "mám z lásky vymodlit se Tobě —"
  },
  {
   "texto": "či pěkným snem to pošeptat"
  },
  {
   "texto": "Ti v tiché, vlídné noční době?"
  },
  {
   "texto": "Či má ten ráj utajený"
  },
  {
   "texto": "jen v srdci dřímat, jako v hrobě,"
  },
  {
   "texto": "a beze slov a bez Tebe"
  },
  {
   "texto": "mám věčně jen to šeptat sobě?"
  },
  {
   "texto": "Ó anděle můj, vyznávám"
  },
  {
   "texto": "se z lásky k lidstvu nehynoucí;"
  },
  {
   "texto": "však Tobě — — ó nekárej mne"
  },
  {
   "texto": "snad z mysli slabé, málo vroucí!"
  }
 ]
}