 "modo": "texto",
 "parrafos": [
  {
   "texto": "Dobře dnes tu pod palmami hověti ve svitu luny…"
  },
  {
   "texto": "Otroci:"
  },
  {
   "texto": "Dobře dnes tu pod palmami hověti ve svitu luny"
  },
  {
   "texto": "tělu prací zmořenému — po hodech spí strážce náš —"
  },
  {
   "texto": "k nám si sedni, zpěvný druhu, sladkozvuké nalaď struny,"
  },
  {
   "texto": "vyjev písní zlaté dumy, které v čele snivém tkáš!"
  },
  {
   "texto": "Mladá otrokyně:"
  },
  {
   "texto": "Zpívej o květech a hvězdách!"
  },
  {
   "texto": "Mladý otrok:"
  },
  {
   "texto": "Chválu dívčích zraků pěj!"
  },
  {
   "texto": "Jiný:"
  },
  {
   "texto": "Zazvoň žertu rolničkami!"
  },
  {
   "texto": "Stařec:"
  },
  {
   "texto": "Zvěstuj dávných věků děj!"
  },
  {
   "texto": "Pěvec:"
  },
  {
   "texto": "Jinaké dnes písně táhnou duší mojí nebohou,"
  },
  {
   "texto": "jako bouře jek a rachot mračící se oblohou;"
  },
  {
   "texto": "daleka jich zdoba květů, krása děv a reků pych,"
  },
  {
   "texto": "zubů skřipot, ston a vzdechy, řinkot pout je slyšet v nich."
  },
  {
   "texto": "Otroci:"
  },
  {
   "texto": "Pouta zvuk nám hudba všední, ale přece pěj a huď;"
  },
  {
   "texto": "jen hlas přitlum, panstvo spící, strážce s bičem neprobuď!"
  },
  {
   "texto": "Nuže, prolom hrázi retů,"
  },
  {
   "texto": "bouře, jíž se prsa dmou,"
  },
  {
   "texto": "myšlénky jak blesky v letu"
  },
  {
   "texto": "křižující duše tmou,"
  },
  {
   "texto": "ohni studu, vichře zloby,"
  },
  {
   "texto": "z líných snů a těžké mdloby"
  },
  {
   "texto": "vyburcujte strunu mou!"
  },
  {
   "texto": "Nezlíhly se moje zpěvy"
  },
  {
   "texto": "v měkkém hnízdě vonných kštic,"
  },
  {
   "texto": "nehřálo je srdce děvy,"
  },
  {
   "texto": "na mém srdci sladce sníc,"
  },
  {
   "texto": "kmitly hlavou utýranou,"
  },
  {
   "texto": "když pod zpupné pěsti ranou"
  },
  {
   "texto": "v krvi zarděla se líc."
  },
  {
   "texto": "Ano, z krve, slz a žluči"
  },
  {
   "texto": "zrodily se v dobách zlých,"
  },
  {
   "texto": "když jsem patřil, kterak mučí"
  },
  {
   "texto": "násilník dav bratrů mých,"
  },
  {
   "texto": "když jsem marně skřípal zuby,"
  },
  {
   "texto": "vida, kterak biřic hrubý"
  },
  {
   "texto": "z našich muk si tropí smích."
  },
  {
   "texto": "Vím, že nebude tu vděku,"
  },
  {
   "texto": "vím, že řekne mnohý z vás:"
  },
  {
   "texto": "V týraného drsném skřeku"
  },
  {
   "texto": "není umění a krás,"
  },
  {
   "texto": "nade rmutnou doby vřavu"
  },
  {
   "texto": "povznášet má pěvec hlavu"
  },
  {
   "texto": "v slunných výsot čistý jas."
  },
  {
   "texto": "Snad to pravda. Ale volně"
  },
  {
   "texto": "kterak vzlétat v oblohu,"
  },
  {
   "texto": "na prsou když cítíš bolně"
  },
  {
   "texto": "těžkou noční mátohu?"
  },
  {
   "texto": "Nemohu cit jiný pěti,"
  },
  {
   "texto": "než mi bouří v ňader změti —"
  },
  {
   "texto": "nemohu a nemohu!"
  }
 ]
}