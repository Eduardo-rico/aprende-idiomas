 "parrafos": [
  {
   "texto": "Utichni teď, struno lkavá…"
  },
  {
   "texto": "Utichni teď, struno lkavá,"
  },
  {
   "texto": "ticho, bratři! — ztajte dech!"
  },
  {
   "texto": "V ruku schyl se dumná hlava,"
  },
  {
   "texto": "zbystřete svůj vnitřní slech."
  },
  {
   "texto": "Slyšíte-li? Slyšíte-li?"
  },
  {
   "texto": "Z blízka, dáli temný zvuk,"
  },
  {
   "texto": "jak by poutem zařinčely"
  },
  {
   "texto": "miliony rabských ruk."
  },
  {
   "texto": "Celý svět širý"
  },
  {
   "texto": "v nejzazší kout"
  },
  {
   "texto": "temnou zní hudbou"
  },
  {
   "texto": "železných pout."
  },
  {
   "texto": "Nespočísti, nedozříti,"
  },
  {
   "texto": "co nás rabů chová svět,"
  },
  {
   "texto": "myriády druhů cítí"
  },
  {
   "texto": "stejnou bídu, stejný hnět —"
  },
  {
   "texto": "berou nám i slova těchu,"
  },
  {
   "texto": "trpět musí otrok něm:"
  },
  {
   "texto": "Ticho dole! Ani vzdechu!"
  },
  {
   "texto": "Kdo jen špetne — roubík sem!"
  },
  {
   "texto": "Ale je rukou"
  },
  {
   "texto": "potřebí hnout,"
  },
  {
   "texto": "ozve se v tichu"
  },
  {
   "texto": "řinčení pout."
  },
  {
   "texto": "Zvuk ten mluví zvláštní řečí,"
  },
  {
   "texto": "jíž moc žádná neztlumí,"
  },
  {
   "texto": "jíž rab rabu tajně svědčí,"
  },
  {
   "texto": "jíž pán bledna rozumí;"
  },
  {
   "texto": "řeč ta nejednou mu plaší"
  },
  {
   "texto": "s hedvábného lože sen,"
  },
  {
   "texto": "děsnou vidinou ho straší,"
  },
  {
   "texto": "že již blízek pomsty den."
  },
  {
   "texto": "Tekel ufarsin"
  },
  {
   "texto": "v hodovny kout"
  },
  {
   "texto": "píše mu ruka"
  },
  {
   "texto": "v řinčení pout."
  },
  {
   "texto": "Darmo šepce: „Liché zvěsti!"
  },
  {
   "texto": "Bez meče je rabská dlaň,"
  },
  {
   "texto": "proti bouři holých pěstí"
  },
  {
   "texto": "ochrání mne strážců zbraň“ — —"
  },
  {
   "texto": "Až hněv miliónů vzplane,"
  },
  {
   "texto": "stráž tvá hrůzou oněmí,"
  },
  {
   "texto": "okov ruky upoutané"
  },
  {
   "texto": "v děsnou zbraň se promění."
  },
  {
   "texto": "Na lebky katů"
  },
  {
   "texto": "v strašlivý soud"
  },
  {
   "texto": "stotisíc třeskne"
  },
  {
   "texto": "železných pout."
  },
  {
   "texto": "Zas naděje mi v prsou klíčí, —"
  },
  {
   "texto": "lesk hvězdný hustou chmurou kmit’;"
  },
  {
   "texto": "zas pevněji se hlava tyčí —"
  },
  {
   "texto": "v noc padl svěží jitra svit:"
  },
  {
   "texto": "To slibné jitřní vzplání,"
  },
  {
   "texto": "té hvězdy těšný jas"
  },
  {
   "texto": "jsem zočil znenadání"
  },
  {
   "texto": "ve stínu juných řas."
  },
  {
   "texto": "Když nad skrání mu kadeřavou"
  },
  {
   "texto": "pěst zaťal strážce surový,"
  },
  {
   "texto": "hoch nezbled’ se skloněnou hlavou"
  },
  {
   "texto": "a nespjal ruce s okovy,"
  },
  {
   "texto": "leč hrdě vznesl skráni"
  },
  {
   "texto": "a vzdorně oči zved’"
  },
  {
   "texto": "a v těch jsem z nenadání"
  },
  {
   "texto": "svit nové doby shléd’."
  },
  {
   "texto": "To nebyl rabský pohled chabý,"
  },
  {
   "texto": "jenž zbaběle se chýlí v prach,"
  },
  {
   "texto": "kdy stačí dutek zámih slabý"
  },
  {
   "texto": "v ráz ubít krátký činu vzmach."
  },
  {
   "texto": "Ve stínu mladé brvy"
  },
  {
   "texto": "ten zrak se divě lesk’,"
  },
  {
   "texto": "jak blízké bouře prvý"
  },
  {
   "texto": "by z něho sršel blesk."
  },
  {
   "texto": "Mně vzešla útěcha z té záře,"
  },
  {
   "texto": "že předků stín v nás přece zbyl,"
  },
  {
   "texto": "že nevyssál hnět otrokáře"
  },
  {
   "texto": "krev jejich všecku z našich žil,"
  },
  {
   "texto": "že jiskry, jež jsme střehli"
  },
  {
   "texto": "vždy v duchu zjařmeném,"
  },
  {
   "texto": "se v srdci synů zžehly"
  },
  {
   "texto": "tím jarým plamenem."
  },
  {
   "texto": "Nechť palčivá i výtka srší"
  },
  {
   "texto": "z těch zraků mladých v naši hruď,"
  },
  {
   "texto": "nechť na čas jejich zápal zvrší"
  },
  {
   "texto": "jen bídu naši — vítán buď!"
  },
  {
   "texto": "Buď zdráv, ty jarní blesku,"
  },
  {
   "texto": "jenž svítáš z juných řas"
  },
  {
   "texto": "a věstíš v noci stesku"
  },
  {
   "texto": "nám brzké spásy jas!"
  }
 ]
