 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XLVIII."
  },
  {
   "texto": "Mne ani mnoho nebolí,"
  },
  {
   "texto": "když vadnout vidím krásu v květech,"
  },
  {
   "texto": "vždyť se mi z jara vrátí zas"
  },
  {
   "texto": "a krásnější snad v nových dětech."
  },
  {
   "texto": "Však bolí mne, když druhy zřím"
  },
  {
   "texto": "květ za květem si z ducha pleti,"
  },
  {
   "texto": "vyvlékat duši ze všech krás"
  },
  {
   "texto": "a žíti dál a sevšedněti."
  },
  {
   "texto": "A smát se poupat mrtvolám,"
  },
  {
   "texto": "svých snů se chlubit pronevěrou,"
  },
  {
   "texto": "kdy nelze již co oškubat —"
  },
  {
   "texto": "to štěstím zvát a kariérou."
  },
  {
   "texto": "Ach, přátelé, tak stlát si poušť,"
  },
  {
   "texto": "žít vidět vás v tak mladé smrti,"
  },
  {
   "texto": "dnem každým být pak více sám —"
  },
  {
   "texto": "to div mi srdce nerozdrtí."
  },
  {
   "texto": "Ó, jděte mi s tou vaší pravdou,"
  },
  {
   "texto": "jak vaše tvář tak zkroucenou,"
  },
  {
   "texto": "tak úlisnou po záletnicku,"
  },
  {
   "texto": "tak dušnou a tak zblácenou."
  },
  {
   "texto": "Ta pravda, u níž já se učil,"
  },
  {
   "texto": "ta přímo podívá se v tvář,"
  },
  {
   "texto": "co promluví, to také cítí,"
  },
  {
   "texto": "a hřeje tím, jak slunce zář."
  },
  {
   "texto": "Ta když pocítí v srdci lásku,"
  },
  {
   "texto": "ta v tváři jarem zaplane,"
  },
  {
   "texto": "a zem a nebe jsou jí svědky,"
  },
  {
   "texto": "že ani kvítkem neklame."
  },
  {
   "texto": "Tať čistá jako noční nebe,"
  },
  {
   "texto": "tak jemná jako květu pel,"
  },
  {
   "texto": "tak pravdivá jak srdce matky,"
  },
  {
   "texto": "a vroucí jak slavíka žel."
  },
  {
   "texto": "Tak průhledná jak dětská mysl,"
  },
  {
   "texto": "nech pláče aneb zaplesá —"
  },
  {
   "texto": "tak já jsem v přírodě ji poznal,"
  },
  {
   "texto": "a tak ji mluví nebesa."
  },
  {
   "texto": "Jsme lidé my syn marnotratný,"
  },
  {
   "texto": "jenž statek vzal a v kalu zbrodil:"
  },
  {
   "texto": "my z domu přírody prcháme"
  },
  {
   "texto": "a člověcký jdem zvrátit podíl."
  },
  {
   "texto": "A mrháme, až zpromrháme"
  },
  {
   "texto": "ten skvoucí zlatohlav své duše,"
  },
  {
   "texto": "až srdce skřehlé, ochuzené"
  },
  {
   "texto": "jak žebráček za námi kluše."
  },
  {
   "texto": "Až tupý zrak již ani neví,"
  },
  {
   "texto": "že necti natřeni jsme blátem,"
  },
  {
   "texto": "nám stydno jest již poesie,"
  },
  {
   "texto": "a ducha radš krmíme mlátem."
  },
  {
   "texto": "Až skoro nejsme ani lidmi —"
  },
  {
   "texto": "jen v smích se ještě zmůžem rtoma,"
  },
  {
   "texto": "že v domě nejkrásnější matky"
  },
  {
   "texto": "jsme cizinou a nikde doma."
  },
  {
   "texto": "A syn ten přec se ještě poznal,"
  },
  {
   "texto": "šel k otci s srdcem rozželeným;"
  },
  {
   "texto": "ach, kolik z nás má ještě srdce,"
  },
  {
   "texto": "by mohlo být zas přirozeným!"
  }
 ]
}