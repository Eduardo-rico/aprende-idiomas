  {
   "texto": "Při balletu"
  },
  {
   "texto": "Divadlem zašlehla"
  },
  {
   "texto": "mocná, skvostná záře,"
  },
  {
   "texto": "veselá v něm hudba,"
  },
  {
   "texto": "veselé v něm tváře."
  },
  {
   "texto": "Lidé radujou se"
  },
  {
   "texto": "hlučně jásajíce,"
  },
  {
   "texto": "že tak krásně tančí"
  },
  {
   "texto": "mladá tanečnice."
  },
  {
   "texto": "Rychle jako vichr"
  },
  {
   "texto": "tančí tanečnice,"
  },
  {
   "texto": "že už sotva stačí"
  },
  {
   "texto": "mladé její plíce."
  },
  {
   "texto": "Směle jako kamzík"
  },
  {
   "texto": "skáče tanečnice"
  },
  {
   "texto": "věčný, věčný úsměch"
  },
  {
   "texto": "vtištěn v její líce."
  },
  {
   "texto": "Takové usmání"
  },
  {
   "texto": "v lících rozpučilo,"
  },
  {
   "texto": "že by bolestí se"
  },
  {
   "texto": "srdce rozskočilo."
  },
  {
   "texto": "Tak se zvykly tváře"
  },
  {
   "texto": "zřejmé na radosti,"
  },
  {
   "texto": "že by člověk rád v ně"
  },
  {
   "texto": "veklel trochu zlosti."
  },
  {
   "texto": "Lidé radujou se"
  },
  {
   "texto": "hlučně jásajíce —"
  },
  {
   "texto": "náhlý vzkřek a v prachu"
  },
  {
   "texto": "leží tanečnice."
  },
  {
   "texto": "Nemůž' vstát a bolesť"
  },
  {
   "texto": "slabé tělo svírá,"
  },
  {
   "texto": "ale úsměch ještě"
  },
  {
   "texto": "tváře obestírá."
  },
  {
   "texto": "Odnášejí lidé"
  },
  {
   "texto": "mladou tanečnici,"
  },
  {
   "texto": "ale za plat úsměch"
  },
  {
   "texto": "ještě v její líci!"
  },
  {
   "texto": "V krásném vodojemu vlnky"
  },
  {
   "texto": "obraz hvězdný houpají,"
  },
  {
   "texto": "po trávníčku lehké nožky"
  },
  {
   "texto": "každé noci stoupají."
  },
  {
   "texto": "— Doňo Anno, doňo krásná,"
  },
  {
   "texto": "což ty vlny šeptají?"
  },
  {
   "texto": "Zdaž se po manželi starém,"
  },
  {
   "texto": "krásná doňo, neptají? —"
  },
  {
   "texto": "„Kmetovi již třeba spánku,"
  },
  {
   "texto": "aby mnohý dožil den, —"
  },
  {
   "texto": "mlada jsem a nepokojný"
  },
  {
   "texto": "mám já ještě v noci sen."
  },
  {
   "texto": "Bych mu nerušila spánek,"
  },
  {
   "texto": "pudí mne to z lože ven,"
  },
  {
   "texto": "a don Fernan, krásný, mladý,"
  },
  {
   "texto": "ten má se mnou stejný sen!“"
  },
  {
   "texto": "Zaluskal si prstem,"
  },
  {
   "texto": "zatočil si džbánem,"
  },
  {
   "texto": "zavejsknul a myslí,"
  },
  {
   "texto": "že je světa pánem."
  },
  {
   "texto": "Klobouk na stranu a ruku do boku,"
  },
  {
   "texto": "je mu lehko, lehko — jako do skoku!"
  },
  {
   "texto": "„Jdi už domů, nemámť"
  },
  {
   "texto": "více piva, hochu!“"
  },
  {
   "texto": "„„Však ho bude, nahni"
  },
  {
   "texto": "jenom soudek trochu,"
  },
  {
   "texto": "trochu na stranu a klínek do boku,"
  },
  {
   "texto": "vždyť mi lehko, lehko — jako do skoku!\"\""
  },
  {
   "texto": "„A čím splatíš dluhy?“"
  },
  {
   "texto": "„„Vždyť mám chatrč svoji;"
  },
  {
   "texto": "chatrčka ta malá"
  },
  {
   "texto": "jako já se strojí:"
  },
  {
   "texto": "střechu na stranu a kládu do boku,"
  },
  {
   "texto": "je nám lehko, lehko — jako do skoku!\"\""
  },
  {
   "texto": "Propil vše, co přines',"
  },
  {
   "texto": "propil chatrč k tomu,"
  },
  {
   "texto": "vracel se co žebrák"
  },
  {
   "texto": "kolem mlýna domů —"
  },
  {
   "texto": "klobouk na stranu a ruku do boku,"
  },
  {
   "texto": "bylo mu tak lehko — jako do skoku!"
  }
