 "modo": "texto",
 "parrafos": [
  {
   "texto": "Bouře"
  },
  {
   "texto": "Ve vsi ticho. Tu se hluku"
  },
  {
   "texto": "jednou za rok natropí,"
  },
  {
   "texto": "když hoch dívce podá ruku,"
  },
  {
   "texto": "neb jí rakev přiklopí."
  },
  {
   "texto": "Ve vsi klidno. V šeru tenkém"
  },
  {
   "texto": "klidu ještě přibude,"
  },
  {
   "texto": "leda že hoch pod okénkem"
  },
  {
   "texto": "dívce píseň zahude."
  },
  {
   "texto": "A tak mírno, jako k svátku,"
  },
  {
   "texto": "zvonek spouští klekání — — —"
  },
  {
   "texto": "v tom jak vichr kolem statků"
  },
  {
   "texto": "letí čtyři huláni."
  },
  {
   "texto": "Zastaví se u hospody:"
  },
  {
   "texto": "„Hejda, pivo, šenkýři!“"
  },
  {
   "texto": "Šenkýř smeká v dobré hody —"
  },
  {
   "texto": "nesa piva pro čtyři."
  },
  {
   "texto": "Pán bůh s vámi, co ten čtvrtý?"
  },
  {
   "texto": "Na kůň svázán provazy,"
  },
  {
   "texto": "ran má, jak kdy uštván chrty"
  },
  {
   "texto": "jelen k hrobu dorazí."
  },
  {
   "texto": "Hlava k prsům jako svadlá,"
  },
  {
   "texto": "ruce v provaz zavity,"
  },
  {
   "texto": "prsa jako bez dychadla"
  },
  {
   "texto": "a rty rudě podlity."
  },
  {
   "texto": "„Jenom krůpěj podejte mi!“ —"
  },
  {
   "texto": "Šenkýř znova načepí,"
  },
  {
   "texto": "hulán džbánek srazí k zemi,"
  },
  {
   "texto": "až se rozlít’ na střepy."
  },
  {
   "texto": "Sousedé se tlačí mnozí —"
  },
  {
   "texto": "„Co to, probůh, znamená?“"
  },
  {
   "texto": "„Ani slova!“ hulán hrozí,"
  },
  {
   "texto": "a sňal píku s ramena."
  },
  {
   "texto": "Jeden soused šedovlasý:"
  },
  {
   "texto": "„Račte, páni, dovolit —“"
  },
  {
   "texto": "„Koním chceš-li na ocasy,"
  },
  {
   "texto": "dám tě ve dví rozpolit!“"
  },
  {
   "texto": "Hurá! Zas už větrem letí —"
  },
  {
   "texto": "„Co as čeká vinníka!"
  },
  {
   "texto": "Zachraň, bože, našich dětí,"
  },
  {
   "texto": "až to kosti proniká!“"
  },
  {
   "texto": "A zas ve vsi ticho, k svátku,"
  },
  {
   "texto": "zvonek skončí klekání,"
  },
  {
   "texto": "a tam hoch jde přes zahrádku"
  },
  {
   "texto": "na nejsladší číhání."
  },
  {
   "texto": "Cikáni k ohni táboří."
  },
  {
   "texto": "Hráb’ starý do popele,"
  },
  {
   "texto": "a radou mladý hovoří:"
  },
  {
   "texto": "„Já ukrad’ len a sele.“"
  },
  {
   "texto": "Tvář starou úsměv přeletěl:"
  },
  {
   "texto": "„Kdes nechal sestru Thekli?“"
  },
  {
   "texto": "Hoch zarazil se bled a děl:"
  },
  {
   "texto": "„Tu za mne v pouta vlekli.“"
  },
  {
   "texto": "Tvář stará v klid se namahá,"
  },
  {
   "texto": "zrak jako z jámy hledí —"
  },
  {
   "texto": "„Za len ji svlékli do naha,"
  },
  {
   "texto": "teď u rychtáře sedí.“"
  },
  {
   "texto": "Žár praská, starý přikládá,"
  },
  {
   "texto": "len rukou v délku měří,"
  },
  {
   "texto": "len rychle v šňůru dopřádá:"
  },
  {
   "texto": "„Teď jez; až po večeři.“"
  },
  {
   "texto": "Žár voní, jiskry vyletí"
  },
  {
   "texto": "a starý v očích pátrá —"
  },
  {
   "texto": "„Vám sestru nechal v zajetí,"
  },
  {
   "texto": "kdo chce mít z něho bratra?“"
  },
  {
   "texto": "Kol ticho; k jídlu zasedli,"
  },
  {
   "texto": "dým voní, k vrbám stoupá —"
  },
  {
   "texto": "cikáni k spaní ulehli,"
  },
  {
   "texto": "hoch na vrbě se houpá."
  }
 ]
}