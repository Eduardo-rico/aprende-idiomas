 "parrafos": [
  {
   "texto": "Pohanský král"
  },
  {
   "texto": "Byl jednou v Čechách pohanský král,"
  },
  {
   "texto": "ten válčil s dalekým světem,"
  },
  {
   "texto": "lid mladý jen mu na jatky zrál,"
  },
  {
   "texto": "i otce utrácel dětem."
  },
  {
   "texto": "Měl poupě dceru pohanský král,"
  },
  {
   "texto": "ta v jeseň jaro mu předla,"
  },
  {
   "texto": "však jednou z rána vzdychal a lkal,"
  },
  {
   "texto": "dceř růže vadla a bledla."
  },
  {
   "texto": "K všem bohům zalkal pohanský král:"
  },
  {
   "texto": "„Kdo z vás tím dovýší pýchu,"
  },
  {
   "texto": "by mně, co mám to jediné, bral,"
  },
  {
   "texto": "mně také božství je k smíchu!“"
  },
  {
   "texto": "A rval si vlasy pohanský král,"
  },
  {
   "texto": "jeť dceř tak tuhá a chladná,"
  },
  {
   "texto": "a z slz, jež horký cedí mu žal,"
  },
  {
   "texto": "ji teplem nedojme žádná."
  },
  {
   "texto": "A když tak stená pohanský král,"
  },
  {
   "texto": "duch padlých zašumí kolem:"
  },
  {
   "texto": "„Hle, slzám matek tvrdě se smál,"
  },
  {
   "texto": "teď srdce pukne mu bolem!“"
  },
  {
   "texto": "Tak přestal stenat pohanský král,"
  },
  {
   "texto": "neb v srdce blesků se shluklo,"
  },
  {
   "texto": "že bůh ni člověk neslyšel dál —"
  },
  {
   "texto": "a přec jen pro dceru puklo."
  },
  {
   "texto": "Jde Jíra, šaty rozedrané,"
  },
  {
   "texto": "jak když to v mlejně semele,"
  },
  {
   "texto": "a vítr hrá mu s hebkým cárem:"
  },
  {
   "texto": "Tu krásnou mašli dej mi darem —"
  },
  {
   "texto": "toť veselé, hoj veselé!"
  },
  {
   "texto": "Jde Jíra ku mlejnu, tam dají,"
  },
  {
   "texto": "tam žita v korce, věrtele;"
  },
  {
   "texto": "a psi naň lítnou jako vzteklí,"
  },
  {
   "texto": "tu z poslední ho mašle svlékli —"
  },
  {
   "texto": "toť veselé, hoj veselé!"
  },
  {
   "texto": "Jde Jíra za mlejn, střechu měří —"
  },
  {
   "texto": "už kohouta má na čele."
  },
  {
   "texto": "A kohout zpívá, až to srší,"
  },
  {
   "texto": "na půl hodiny noty prší —"
  },
  {
   "texto": "toť veselé, hoj veselé!"
  },
  {
   "texto": "Tu chasa mlejnská Jíru chopí —"
  },
  {
   "texto": "„Jen tam s ním, tam si namele!“"
  },
  {
   "texto": "A jiskry letí, jak kdy buší,"
  },
  {
   "texto": "z nich Jíra poroučí svou duši:"
  },
  {
   "texto": "„Hoj vesele, jen vesele!“"
  },
  {
   "texto": "Jdou rekruti, hudba spustila,"
  },
  {
   "texto": "hejsa! šmytcem a plechem —"
  },
  {
   "texto": "„Už nejsme, děvčata rozmilá,"
  },
  {
   "texto": "vaši ni jediným dechem!“"
  },
  {
   "texto": "A matky na prahu, starosti plaší:"
  },
  {
   "texto": "„Zda jsou to synové naši?“"
  },
  {
   "texto": "Jdou rekruti z města napilí,"
  },
  {
   "texto": "hejsa! házejí čapkou —"
  },
  {
   "texto": "„Už nejsme, rodiče rozmilí,"
  },
  {
   "texto": "vaši ni jedinou kapkou!“"
  },
  {
   "texto": "A matky na prahu, starosti plaší:"
  },
  {
   "texto": "„Zda jsou to synové naši?“"
  },
  {
   "texto": "Jdou rekruti bystro, v kuráži,"
  },
  {
   "texto": "hejsa! veselým chodem —"
  },
  {
   "texto": "„A kdo se kde na nás odváží,"
  },
  {
   "texto": "palme, a do srdce bodem!“"
  },
  {
   "texto": "A matky na prahu, starosti plaší:"
  },
  {
   "texto": "„Zda jsou to synové naši?“"
  },
  {
   "texto": "Jdou rekruti, vejsknou do všech sil,"
  },
  {
   "texto": "hejsa! na stranu čapku —"
  },
  {
   "texto": "„A kdyby to vlastní otec byl,"
  },
  {
   "texto": "načepím poslední kapku!“"
  },
  {
   "texto": "A matky na prahu, starosti plaší:"
  },
  {
   "texto": "„To nejsou synové naši!“"
  }
 ]
}