 "modo": "texto",
 "parrafos": [
  {
   "texto": "Lesnatými svahy, úvaly"
  },
  {
   "texto": "kozáci dva volně klusali."
  },
  {
   "texto": "Jeden, stařík vrásčitý a sivý,"
  },
  {
   "texto": "seděl vzpřímen jako horská jedle,"
  },
  {
   "texto": "druhý skloněn, mladík zádumčivý,"
  },
  {
   "texto": "jako ve snách kolébal se v sedle."
  },
  {
   "texto": "V bohaté se skvěli úpravě."
  },
  {
   "texto": "Na paprsku hrály kmitavě"
  },
  {
   "texto": "tenounké jich šavle zahnuté,"
  },
  {
   "texto": "karabiny stříbrem okuté,"
  },
  {
   "texto": "nábojů též pouzdra, v těsnou řadu"
  },
  {
   "texto": "s obou stran na hrudi svalnaté"
  },
  {
   "texto": "upevněná. Štíhlá puška vzadu"
  },
  {
   "texto": "houpala se v torbě huňaté."
  },
  {
   "texto": "Jeli bez hovoru, bez ruchu."
  },
  {
   "texto": "Nahajka jen časem ve vzduchu"
  },
  {
   "texto": "zahvizdla neb čapku sešinutou"
  },
  {
   "texto": "popravil si jezdec, burku vzdutou."
  },
  {
   "texto": "Posléz starší zahovořil k druhu:"
  },
  {
   "texto": "„Bože veliký, jak pusto kol!"
  },
  {
   "texto": "Lesnatý ten vrchol nad vrchol"
  },
  {
   "texto": "vypíná se v široširém kruhu,"
  },
  {
   "texto": "slavném, divokém, kam sahá zor,"
  },
  {
   "texto": "v dálku nejzazší, kde prouha bílá"
  },
  {
   "texto": "vlnivě se nebem rozestýlá -"
  },
  {
   "texto": "zdaž to oblak, sněhy dálných hor?"
  },
  {
   "texto": "Zevšad jakby vyhoštěn byl zvuk,"
  },
  {
   "texto": "božího jen srdce tušíš tluk."
  },
  {
   "texto": "Nad těla tu stromů zpráchnivělá,"
  },
  {
   "texto": "skupená jak trupy po boji,"
  },
  {
   "texto": "štíhlí vnuci vznášejí svá čela"
  },
  {
   "texto": "vlajícími mlhy závoji,"
  },
  {
   "texto": "a chmel planý, réva divoká"
  },
  {
   "texto": "vzhůru vine smaragdové spony,"
  },
  {
   "texto": "až pak volně malebnými sklony"
  },
  {
   "texto": "do vzduchu se spouští s vysoka,"
  },
  {
   "texto": "a tak tiše drobné lupení"
  },
  {
   "texto": "kolem kmenů obemšených dřímá"
  },
  {
   "texto": "a tak libě na lodyze klímá"
  },
  {
   "texto": "purpurových květů skupení,"
  },
  {
   "texto": "pestrá zmij´ se na balvanu zhřívá,"
  },
  {
   "texto": "ze soumraku haluzí se dívá"
  },
  {
   "texto": "tichá laň tak klidně, bezpečně, -"
  },
  {
   "texto": "jak by kraj ten nikdy lidské ruce"
  },
  {
   "texto": "nebyly vzbudily k plesu, muce,"
  },
  {
   "texto": "jak by snil tak dávno, pověčně."
  },
  {
   "texto": "A přec málo uplynulo roků"
  },
  {
   "texto": "z oněch dob, kdy mráčkem bělavým"
  },
  {
   "texto": "z lesů těch a roklí, skalních boků"
  },
  {
   "texto": "četných aúlů se vznášel dým."
  },
  {
   "texto": "V mýti lesní, na zeleném honě"
  },
  {
   "texto": "ovcí stáda, dlouhohřívé koně"
  },
  {
   "texto": "pastýř hlídal s kopím blýskavým;"
  },
  {
   "texto": "ke studánkám jasným dívky švarné"
  },
  {
   "texto": "scházely se v bílý, šumný sbor,"
  },
  {
   "texto": "nad závojem pestrým oči žárné"
  },
  {
   "texto": "hrávaly jak blýskavice hor,"
  },
  {
   "texto": "a když vánek svěží, laškující"
  },
  {
   "texto": "závoj zdvihl s usmívavých lící,"
  },
  {
   "texto": "viděl´s ústa, granátový květ,"
  },
  {
   "texto": "sněžné hrdlo, zlatý amulet -"
  },
  {
   "texto": "ó, což rád jsem zdvíhal závoj tenký"
  },
  {
   "texto": "s bílých lící mladé Čerkesenky!"
  },
  {
   "texto": "V mýtinách té zdřimlé doubravy"
  },
  {
   "texto": "míhaly se hrdé postavy,"
  },
  {
   "texto": "na slunci jich přílby, štíty plály,"
  },
  {
   "texto": "šavle zvonily a burky plály,"
  },
  {
   "texto": "na komoni s větrem o závod -"
  },
  {
   "texto": "Šapsuchů a Natuchajců rod!"
  },
  {
   "texto": "Kolikrát as Čerkes chytrý, smělý"
  },
  {
   "texto": "v soumraku těch větví ochranném"
  },
  {
   "texto": "smrtnou ránu chystal nepříteli"
  },
  {
   "texto": "za vývratí, šedým balvanem,"
  },
  {
   "texto": "kolena ve kyprý skloniv mech"
  },
  {
   "texto": "jiskřil očima a tajil dech."
  },
  {
   "texto": "Kolikrát se divý bitky hluk"
  },
  {
   "texto": "odrážel od němých těchto strání,"
  },
  {
   "texto": "bubnů rachocení, koňů ržání,"
  },
  {
   "texto": "křik a střelba, polní trubky zvuk;"
  },
  {
   "texto": "kolikrát se nad ruskou tu skrání"
  },
  {
   "texto": "čerkeský mih´ čepel modrojasný"
  },
  {
   "texto": "s vyzlaceným písmem koranu -"
  },
  {
   "texto": "Chvála bohu! nebyl koran spasný,"
  },
  {
   "texto": "zlomili jsme vzdory pohanů! - -"
  },
  {
   "texto": "A přec stýská, stýská se mi časem"
  },
  {
   "texto": "po dnech minulých. Což hory teď?!"
  },
  {
   "texto": "Pobavíš se leda s vlastním hlasem,"
  },
  {
   "texto": "jímž ti skály dají odpověď."
  },
  {
   "texto": "Volně jedeš. Puška v čechle dřímá,"
  },
  {
   "texto": "věrný palaš v pochvě rezaví,"
  },
  {
   "texto": "kozák sivobradý v sedle klímá"
  },
  {
   "texto": "a jen ze sna o tom vypráví,"
  },
  {
   "texto": "jak zní šavlice a puška hřímá"
  },
  {
   "texto": "a kozáče s mlékem na bradě"
  },
  {
   "texto": "sotva naslouchá - - Ba, na mou věru,"
  },
  {
   "texto": "což ti, brachu, vletlo pod kučeru,"
  },
  {
   "texto": "že se kloníš, jako v úpadě?"
  },
  {
   "texto": "Pověz, jaký bol tvá duše hostí?"
  },
  {
   "texto": "Mně ho žaluj, ne tam do hřívy."
  },
  {
   "texto": "Snad že najdu v torbě zkušeností"
  },
  {
   "texto": "na ránu tvou balšám hojivý.“"
  },
  {
   "texto": "Odpověděl mladší v povzdechu:"
  },
  {
   "texto": "„Vše ti svěřím; nech si útěchu. -"
  },
  {
   "texto": "Zabloudil jsem jednou při Cemesu"
  },
  {
   "texto": "v hlubině novorossijských lesů."
  },
  {
   "texto": "Překrásný byl, sváteční to den;"
  },
  {
   "texto": "svit jen kradmo sklouzal pod koruny"
  },
  {
   "texto": "a jen kopyto mé věrné brůny"
  },
  {
   "texto": "rušilo hluboký stromů sen."
  },
  {
   "texto": "Náhle štěkot psa a lidské hlasy"
  },
  {
   "texto": "uslyšel jsem. Koně popohnav"
  },
  {
   "texto": "v mýtině jsem spatřil zlaté klasy,"
  },
  {
   "texto": "pasoucí se v trávě skot i brav,"
  },
  {
   "texto": "za nimi pak podél horské paty"
  },
  {
   "texto": "řadou roztroušené nízké chaty."
  },
  {
   "texto": "Nad nimi kouř bělavý se chvěl."
  },
  {
   "texto": "Po tyčích a plotech v sivé krovy"
  },
  {
   "texto": "réva s břečťanem a lesní chmel"
  },
  {
   "texto": "připínaly věnec smaragdový."
  },
  {
   "texto": "V oknech míhaly se dívky smavé,"
  },
  {
   "texto": "a kmet vážný kouřil před chatou,"
  },
  {
   "texto": "hoši rvali kudrny si plavé"
  },
  {
   "texto": "pod kvetoucí hruškou košatou."
  },
  {
   "texto": "Metodějovkou ta sluje ves."
  },
  {
   "texto": "Znal jsem z doslechu ji. Tyto chýše"
  },
  {
   "texto": "zrobili si lidé z cizí říše,"
  },
  {
   "texto": "z dálných Čech, tam na západě kdes."
  },
  {
   "texto": "Minul jsem je. Dále do lesů"
  },
  {
   "texto": "klusal jsem až na břeh Cemesu."
  },
  {
   "texto": "Uvázav tam koně v olší stínu,"
  },
  {
   "texto": "burku složiv naň i karabinu,"
  },
  {
   "texto": "do trávy jsem klesl. Žhavou skráň"
  },
  {
   "texto": "dlaní podpíraje, hledím z hloubi,"
  },
  {
   "texto": "jak tam v šeru, ve skulinách loubí,"
  },
  {
   "texto": "zvědavě se míhá nebes báň,"
  },
  {
   "texto": "a jak slunce ukládá tu spoře"
  },
  {
   "texto": "zlaté pruhy po bělavé koře"
  },
  {
   "texto": "snících kmenů. Však tu větví mrakem"
  },
  {
   "texto": "netušený zjev jsem stihl zrakem."
  },
  {
   "texto": "Ach, ten obraz divný, osudný"
  },
  {
   "texto": "dosud přede mnou, tak přeludný!"
  },
  {
   "texto": "Vidím je, ty stromy hrdé, mračné,"
  },
  {
   "texto": "jak se větví hustým pletivem"
  },
  {
   "texto": "propínají v klenby neprůzračné;"
  },
  {
   "texto": "vidím je, jak ve snu žárlivém"
  },
  {
   "texto": "střeží před plamenným nebes okem"
  },
  {
   "texto": "tichou říčku v stínu přehlubokém."
  },
  {
   "texto": "Vidím révu, jak tu skrýši šerou"
  },
  {
   "texto": "ověšuje zdobou tisícerou,"
  },
  {
   "texto": "jak své úponky kol kolem metá,"
  },
  {
   "texto": "od větve ku větvi řetěz spletá,"
  },
  {
   "texto": "jako zmij´ se točí ve vrchol"
  },
  {
   "texto": "a malebným věncem klesá vdol."
  },
  {
   "texto": "Vidím květiny, jak ve vodě"
  },
  {
   "texto": "vztyčují své vlahé, štíhlé stonky"
  },
  {
   "texto": "s modrými a bělavými zvonky"
  },
  {
   "texto": "v něžné kráse, tiché lahodě,"
  },
  {
   "texto": "i ten mocný kmen, jenž času zlobou"
  },
  {
   "texto": "přes potok byl kdysi povalen,"
  },
  {
   "texto": "a teď celý břečtanovou zdobou,"
  },
  {
   "texto": "lupeny a květy zahalen. -"
  },
  {
   "texto": "A hle! na něm lepá, zádumčivá"
  },
  {
   "texto": "dívka sedí; libé zášeří"
  },
  {
   "texto": "odívá jí skráně, líčka snivá"
  },
  {
   "texto": "i květ vodní v prosté kadeři"
  },
  {
   "texto": "přísvitem tak pohádkovým zcela,"
  },
  {
   "texto": "víčka skloněna tak vábným snem"
  },
  {
   "texto": "a rtů květem perlička se bělá"
  },
  {
   "texto": "v úsměvu tak libě kouzelném,"
  },
  {
   "texto": "že zjev její v této divné kráse"
  },
  {
   "texto": "rusalkám jen z báje podobá se."
  },
  {
   "texto": "Ležel jsem tam, bratře, bez pohnutí"
  },
  {
   "texto": "jako v bázni, abych nevzrušil"
  },
  {
   "texto": "dechem člověckým tu kněžku vil,"
  },
  {
   "texto": "aby neprchla snů na peruti."
  },
  {
   "texto": "A když zmizela, v ten prázdný kmen"
  },
  {
   "texto": "dlouho jsem se díval okouzlen;"
  },
  {
   "texto": "v sedélku pak cestou při měsíci"
  },
  {
   "texto": "provázel mne obraz dívky snící."
  },
  {
   "texto": "Od té doby v českou dědinu"
  },
  {
   "texto": "vydupal můj koník pěšinu;"
  },
  {
   "texto": "po stínu znal chatu Javorovu"
  },
  {
   "texto": "a dceř jeho po laskavém slovu."
  },
  {
   "texto": "Když jsem poprvé na nízkém prahu"
  },
  {
   "texto": "před ní stanul žebraje, by vláhu"
  },
  {
   "texto": "poskytla mi na rty vyprahlé,"
  },
  {
   "texto": "zarděla se, přiklonila víčka -"
  },
  {
   "texto": "snad se ulekla má holubička"
  },
  {
   "texto": "černé burky, líce osmahlé."
  },
  {
   "texto": "Ale starý Javor vlídným slovem"
  },
  {
   "texto": "přivítal mne, snažně poradil,"
  },
  {
   "texto": "abych vyčkal pod hostiným krovem,"
  },
  {
   "texto": "až by večer hory ochladil,"
  },
  {
   "texto": "a již sedím za dubovým stolem,"
  },
  {
   "texto": "knír si kroutím, rozhlížím se kolem,"
  },
  {
   "texto": "jak tu všechno v ladu, na svém místě,"
  },
  {
   "texto": "jak se vše tu blyští, třpytí čistě,"
  },
  {
   "texto": "jak tam s hodin větrného sídla"
  },
  {
   "texto": "kukačka uklání pestrá křídla,"
  },
  {
   "texto": "jak tam za knihami v pozadí"
  },
  {
   "texto": "soška jakás přílbou do vysoka"
  },
  {
   "texto": "pyšně trčí, hrozná, jednooká …"
  },
  {
   "texto": "a to prosté, chudé nářadí,"
  },
  {
   "texto": "ba to vše, co kolem stojí, leží,"
  },
  {
   "texto": "jak má vzezření tak milé, svěží,"
  },
  {
   "texto": "půvabem se leskne přetajemným -"
  },
  {
   "texto": "spanilé jak ruky sledem jemným!"
  },
  {
   "texto": "Hledím před sebe, jak ruce malé"
  },
  {
   "texto": "kladou na ubrusu sněžnou běl"
  },
  {
   "texto": "arbuzy a hrozny zamodralé,"
  },
  {
   "texto": "pěkné jahody, med lesních včel,"
  },
  {
   "texto": "burďuk nese, pyšně nabobtnalý"
  },
  {
   "texto": "kachetinskou proslavenou šťávou,"
  },
  {
   "texto": "m´hou jak růžovou se číše kalí,"
  },
  {
   "texto": "a jak usmívá se rajský mok"
  },
  {
   "texto": "z křišťálu stem rubínových ok;"
  },
  {
   "texto": "naslouchám, jak stařík přívětivý"
  },
  {
   "texto": "vypráví mi o své rodině,"
  },
  {
   "texto": "o svém žití, dálné otčině,"
  },
  {
   "texto": "kterak chválí její žírné nivy,"
  },
  {
   "texto": "a sám povídám o zašlé době,"
  },
  {
   "texto": "žití kozáckém, čerkeské zlobě,"
  },
  {
   "texto": "o příběhu v horách všelikém."
  },
  {
   "texto": "Každý svým hovořil jazykem,"
  },
  {
   "texto": "a přec dobře jsme si rozuměli -"
  },
  {
   "texto": "srdce tála - hlavy zašuměly!"
  },
  {
   "texto": "Zazvonily pěnivé tři číše"
  },
  {
   "texto": "hostitelům, hostu na zdraví;"
  },
  {
   "texto": "a když vyjížděl jsem, s nebes výše"
  },
  {
   "texto": "obzíral již měsíc doubravy."
  },
  {
   "texto": "Mnohé potom chvíle s Javorem"
  },
  {
   "texto": "přátelským jsem trávil hovorem."
  },
  {
   "texto": "On mi svěřoval své tužby, stesky."
  },
  {
   "texto": "Často vetché, starožitné desky"
  },
  {
   "texto": "velké jakés knihy otvírával,"
  },
  {
   "texto": "žlutými se listy probírával"
  },
  {
   "texto": "a mně vyprávěl, že v této knize"
  },
  {
   "texto": "napsáno, jak před mnohými lety"
  },
  {
   "texto": "česká zem´ se nad krajiny cizé"
  },
  {
   "texto": "pyšnila jak růže nade květy;"
  },
  {
   "texto": "svým jak leskem svět plnila celý,"
  },
  {
   "texto": "synům štědrá, hrozná nepříteli,"
  },
  {
   "texto": "slavná bohatstvím a silou, umem,"
  },
  {
   "texto": "v míru vlídná, děsná ve vzdoru,"
  },
  {
   "texto": "vrahy zaháněla dálným šumem"
  },
  {
   "texto": "rozbalených k bitvě praporů -"
  },
  {
   "texto": "Tak tu v knize - říkal, zavíraje"
  },
  {
   "texto": "s trpkým vzdechem sponku rezavou -"
  },
  {
   "texto": "předci žili; vnuk jen listů kraje"
  },
  {
   "texto": "palcem třepí, vláhou slzavou"
  },
  {
   "texto": "kazí to, co nebylo mu vzato -"
  },
  {
   "texto": "hle! to jediné jest kniha tato."
  },
  {
   "texto": "Dosud čeří vánek zlaté klasy"
  },
  {
   "texto": "na praotců roli bohaté,"
  },
  {
   "texto": "ale vnuku neodvírá s řasy"
  },
  {
   "texto": "slzy žalu, bídy proklaté,"
  },
  {
   "texto": "a Čech nyní žebrák cizí nivou"
  },
  {
   "texto": "za krovem se toulá, chleba skyvou …"
  },
  {
   "texto": "Ba, slov jeho žal byl trpčí, větší -"
  },
  {
   "texto": "dopola jen chápal jsem ty řeči."
  },
  {
   "texto": "Vždyť můj sluch i vid, ba duše celá"
  },
  {
   "texto": "s jeho dcerou ve přístěnku dlela."
  },
  {
   "texto": "Vidíš onen strom? Hle, réva krásná"
  },
  {
   "texto": "z počátku jej lehce ovila"
  },
  {
   "texto": "zelenými lokty, volná, jasná;"
  },
  {
   "texto": "při kmenu se skromně živila."
  },
  {
   "texto": "Ale záhy zmohutnělým pněm"
  },
  {
   "texto": "těsněji ho, těsněj´ obvíjela,"
  },
  {
   "texto": "až s ním srostla, spojila se zcela,"
  },
  {
   "texto": "přehluboko zaryla se v něm."
  },
  {
   "texto": "Teď on s révou jeden život žije,"
  },
  {
   "texto": "k její zdobě vesnou zakvétá,"
  },
  {
   "texto": "jejími se hrozny v podzim kryje,"
  },
  {
   "texto": "lupení své s jejím proplétá,"
  },
  {
   "texto": "a kdy zruší ostří svazek ten,"
  },
  {
   "texto": "s révou sejde, na smrt poraněn."
  },
  {
   "texto": "Hleď, tak láska jemně, znenáhla"
  },
  {
   "texto": "unylou mi duši obsáhla,"
  },
  {
   "texto": "těsněji vždy kolem ní se pjala,"
  },
  {
   "texto": "až se družkou nezbytnou jí stala."
  },
  {
   "texto": "Což jsem v duši roztouženou vnímal"
  },
  {
   "texto": "něžný půvab štíhlé podoby,"
  },
  {
   "texto": "divný sen, jenž na čele jí dřímal,"
  },
  {
   "texto": "nezvyklé, přec milé způsoby!"
  },
  {
   "texto": "Jiná jest, než kozácké ty děvy -"
  },
  {
   "texto": "štědrá na slze i na úsměvy,"
  },
  {
   "texto": "hovoří tak pěkně, rusky z části,"
  },
  {
   "texto": "píše, čítá z knih, jak umné ďáče,"
  }
 ]
}