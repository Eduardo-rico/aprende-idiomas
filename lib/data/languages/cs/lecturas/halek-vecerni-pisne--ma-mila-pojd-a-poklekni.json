 "parrafos": [
  {
   "texto": "Má milá, pojď a poklekni"
  },
  {
   "texto": "Má milá, pojď a poklekni,"
  },
  {
   "texto": "teď právě čas je k modlení —"
  },
  {
   "texto": "měsíček vyšel nad lesy,"
  },
  {
   "texto": "a čas můj minul k prodlení."
  },
  {
   "texto": "Však ruce, drahá, nespínej!"
  },
  {
   "texto": "Já Tebe, mne obemkni Ty —"
  },
  {
   "texto": "a místo rukou srdce dvě"
  },
  {
   "texto": "k modlitbě budou sepnuty."
  },
  {
   "texto": "A ústa k ústům tiskni mým,"
  },
  {
   "texto": "z úst jedněch nás modlit nech —"
  },
  {
   "texto": "já v ústa vložím slova Ti,"
  },
  {
   "texto": "a k nebi Tvůj je pošle dech."
  },
  {
   "texto": "A bude naše modlitba"
  },
  {
   "texto": "tou nejčistčí, věř, obětí —"
  },
  {
   "texto": "neb když se modlí andělé —"
  },
  {
   "texto": "jen v tom se modlí objetí."
  },
  {
   "texto": "Jsem jako lípa košatá,"
  },
  {
   "texto": "když oděje se k svátku:"
  },
  {
   "texto": "ty krásná růže májová,"
  },
  {
   "texto": "pojď sem do mého chládku."
  },
  {
   "texto": "Zde vůní dýchá každý list,"
  },
  {
   "texto": "zde bzučí včelek roje,"
  },
  {
   "texto": "večer sem letí ptáčkové —"
  },
  {
   "texto": "to myšlenky jsou moje."
  },
  {
   "texto": "Ty odletují daleko,"
  },
  {
   "texto": "jak od domova děti"
  },
  {
   "texto": "však Ty-li ke mně zasedneš,"
  },
  {
   "texto": "již více neodletí."
  },
  {
   "texto": "Tak často mně to připadá,"
  },
  {
   "texto": "když přivinu Tě k sobě,"
  },
  {
   "texto": "žes k vůli mně zde na světě"
  },
  {
   "texto": "a já že k vůli Tobě."
  },
  {
   "texto": "Není to snadné světem jít"
  },
  {
   "texto": "a nezabloudit v scestí;"
  },
  {
   "texto": "však štěstí v světě největší,"
  },
  {
   "texto": "být druhu svému k štěstí."
  },
  {
   "texto": "A má-li král svou korunu,"
  },
  {
   "texto": "Bůh má-li svoje nebe"
  },
  {
   "texto": "a má-li ptáček jarní háj:"
  },
  {
   "texto": "mám já, panenko, Tebe."
  },
  {
   "texto": "Tys jenom ještě poupátko,"
  },
  {
   "texto": "jež sotva vzešlo do světa,"
  },
  {
   "texto": "a přece na Tvé tváři už"
  },
  {
   "texto": "překrásná růže vykvétá."
  },
  {
   "texto": "A růže ta tak spanilá"
  },
  {
   "texto": "a tak milounké vůně,"
  },
  {
   "texto": "že duše k ní zahořela"
  },
  {
   "texto": "a srdce po ní stůně."
  },
  {
   "texto": "Ten slavík ani neuleh’"
  },
  {
   "texto": "a v zpěvu celý rozplývá;"
  },
  {
   "texto": "tu dlouhou píseň o lásce —"
  },
  {
   "texto": "můj Bože, kdy ji vyzpívá."
  },
  {
   "texto": "A z větvičky zas na větev"
  },
  {
   "texto": "a odtamtud zas dolů —"
  },
  {
   "texto": "a zdá se mi, že stejný stesk"
  },
  {
   "texto": "nosíme v srdci spolu."
  },
  {
   "texto": "A kolkolem se ohlíží"
  },
  {
   "texto": "a jasné oko zvedá —"
  },
  {
   "texto": "a zdá se mi, že uhod’ bych,"
  },
  {
   "texto": "co tím svým okem hledá."
  }
 ]
}