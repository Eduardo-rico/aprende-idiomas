 "parrafos": [
  {
   "texto": "Čaroděj šel po silnici"
  },
  {
   "texto": "v mrazné zimní chumelici,"
  },
  {
   "texto": "došel k šeré šibenici."
  },
  {
   "texto": "Šibenice trojram lysý,"
  },
  {
   "texto": "na ní tři zloději visí."
  },
  {
   "texto": "Usednul. „Zde dobré bydlo."
  },
  {
   "texto": "Máte, hoši, pěkné sídlo! –"
  },
  {
   "texto": "ale teď už honem dolů,"
  },
  {
   "texto": "ponoclehujem tu spolu!“"
  },
  {
   "texto": "Zaklel, máchnul rukou v kole"
  },
  {
   "texto": "hup! a již jsou všichni dole."
  },
  {
   "texto": "Zasedli kruh ve příšerný."
  },
  {
   "texto": "Hlavy sobě napravují,"
  },
  {
   "texto": "mistra chvalně pozdravují."
  },
  {
   "texto": "První jako pes je černý,"
  },
  {
   "texto": "kde ramena tu kolena,"
  },
  {
   "texto": "brada věky neholena;"
  },
  {
   "texto": "druhý s hlavou rozsochatou,"
  },
  {
   "texto": "s nohou dřevem podepjatou;"
  },
  {
   "texto": "třetí – pánbůh budiž s námi! –"
  },
  {
   "texto": "celý nahý – v očích ledy,"
  },
  {
   "texto": "po tváři je jíním šedý"
  },
  {
   "texto": "a po těle střechýl samý."
  },
  {
   "texto": "„Vzkřísil jsem Vás, dále žijte,"
  },
  {
   "texto": "tropte dál svou lotrovinu,"
  },
  {
   "texto": "za to mně dnes posloužíte."
  },
  {
   "texto": "V šibenice nočním stínu"
  },
  {
   "texto": "pospolu se pobavíme,"
  },
  {
   "texto": "vínem spijem, povyspíme."
  },
  {
   "texto": "Vzhůru, sneste, čeho třeba,"
  },
  {
   "texto": "jeden peřin, druhý chleba,"
  },
  {
   "texto": "třetí vína – kapka stačí! –"
  },
  {
   "texto": "vzhůru, leťte, plémě stračí!“"
  },
  {
   "texto": "Vzlétli jako hejno ptačí."
  },
  {
   "texto": "Vzduch jen hvizdnul divým letem"
  },
  {
   "texto": "a již první snes’ se zpátky."
  },
  {
   "texto": "„„Nesu polštáříček malý,"
  },
  {
   "texto": "uzmul jsem jej vdově chudé"
  },
  {
   "texto": "churavícím pod dítětem;"
  },
  {
   "texto": "trochu na nás bude krátký –““"
  },
  {
   "texto": "„Však ho na nás dosti bude!“"
  },
  {
   "texto": "mistr tovaryše chválí;"
  },
  {
   "texto": "říká slova, statek množe:"
  },
  {
   "texto": "už tu čtvero měkké lože."
  },
  {
   "texto": "Nad hlavami teskné vání,"
  },
  {
   "texto": "jako dálné žalování."
  },
  {
   "texto": "A již je tu nazpět druhý."
  },
  {
   "texto": "„„Nesu víno, šel jsem zchytra"
  },
  {
   "texto": "na skříň kostelního sluhy,"
  },
  {
   "texto": "mělo ku mši sloužit zítra;"
  },
  {
   "texto": "jen že je ho málo trochu –““"
  },
  {
   "texto": "„Stačí nám, můj dobrý hochu!“"
  },
  {
   "texto": "Mistr říká svoje bludy,"
  },
  {
   "texto": "a již vína kolem sudy."
  },
  {
   "texto": "Ve vzduchu to lačně hučí,"
  },
  {
   "texto": "jak když šedí vlci skučí."
  },
  {
   "texto": "Třetí tu a volá v plesu:"
  },
  {
   "texto": "„„Svěcenou Ti hostyj nesu!"
  },
  {
   "texto": "Vyrval jsem ji knězi ctnému,"
  },
  {
   "texto": "nes’ ji k smrti nemocnému"
  },
  {
   "texto": "na poslední posilnění!““"
  },
  {
   "texto": "„Dobrý chléb, když jiný není –“"
  },
  {
   "texto": "Hrom v tom bouchnul. – Co se děje?"
  },
  {
   "texto": "zem se pod nohama chvěje,"
  },
  {
   "texto": "vzduch jak hlína, plný chmýru,"
  },
  {
   "texto": "vše se točí v náhlém víru,"
  },
  {
   "texto": "co kde leží, co kde stojí,"
  },
  {
   "texto": "vzhůru dolů lítá v roji,"
  },
  {
   "texto": "a ti čtyři v divém kůru"
  },
  {
   "texto": "letí jako plevy vzhůru."
  },
  {
   "texto": "Ještě zavzdechnutí táhlé,"
  },
  {
   "texto": "a zas ticho, ticho náhlé."
  },
  {
   "texto": "Zimní ticho. Přišlo ráno,"
  },
  {
   "texto": "s nocí den se plavě mísí,"
  },
  {
   "texto": "nad silnicí trojram lysý,"
  },
  {
   "texto": "na něm čtyři chlapi visí."
  }
 ]
