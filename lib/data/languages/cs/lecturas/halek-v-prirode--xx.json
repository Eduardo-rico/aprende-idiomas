 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-v-prirode",
  "titulo": "V přírodě",
  "orden": 6
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XX."
  },
  {
   "texto": "Má duše včelky předhoní,"
  },
  {
   "texto": "když louka v zvonky zazvoní,"
  },
  {
   "texto": "a sedmikrásek, jetele"
  },
  {
   "texto": "si v mladou zeleň nastele."
  },
  {
   "texto": "Přiběhne dívka od lesa,"
  },
  {
   "texto": "a jako kůzle zaplesá,"
  },
  {
   "texto": "jako když slunce vyskočí,"
  },
  {
   "texto": "a s čtverlístkem se zatočí."
  },
  {
   "texto": "Pak bludný chlapec ode vsi,"
  },
  {
   "texto": "ten v soumrak zabrán steskne si,"
  },
  {
   "texto": "a jakby zemdlen celičký,"
  },
  {
   "texto": "kropí a hledá slzičky."
  },
  {
   "texto": "Pak najdou se a dovtípí,"
  },
  {
   "texto": "pak duše v duši překypí,"
  },
  {
   "texto": "a louka v květ se zaskvěje,"
  },
  {
   "texto": "jak když se dítko usměje."
  },
  {
   "texto": "Mně zdá se, že jsem jarem byl:"
  },
  {
   "texto": "s přibledlou hošík kadeří,"
  },
  {
   "texto": "a růže jsem a světlo sil,"
  },
  {
   "texto": "v svět láskou dýchal mateří."
  },
  {
   "texto": "A bylo poupat, hudby v něm,"
  },
  {
   "texto": "co pták, to v modro vyletí,"
  },
  {
   "texto": "nebe se lesklo, mládla zem"
  },
  {
   "texto": "a radost táhla v zápětí."
  },
  {
   "texto": "I myslím: „Jaká krása to;"
  },
  {
   "texto": "oseju srdce prohlubeň —"
  },
  {
   "texto": "když bude k činům rozhřáto,"
  },
  {
   "texto": "jaká to ducha bude žeň!"
  },
  {
   "texto": "To bude nad vše líbezné,"
  },
  {
   "texto": "co jen kdy vidět na světě:"
  },
  {
   "texto": "duch v slávě krásy vítězné"
  },
  {
   "texto": "a srdce v plném rozkvětě!“"
  },
  {
   "texto": "A chodím, kde jen člověk bděl:"
  },
  {
   "texto": "„Jaro ti v srdce přináším!“"
  },
  {
   "texto": "Však málokdo z nich srdce měl,"
  },
  {
   "texto": "a kdo měl — byl radš chladnějším."
  },
  {
   "texto": "Vyběhly s matkou před tu chýž,"
  },
  {
   "texto": "tak chudou, a tak všeho prosty,"
  },
  {
   "texto": "však je-li nebe zemi blíž,"
  },
  {
   "texto": "ty dítky kladly k němu mosty."
  },
  {
   "texto": "Vyběhly sluncem rumělé,"
  },
  {
   "texto": "tak jak je pán bůh právě stvořil,"
  },
  {
   "texto": "však jsou-li dětmi andělé,"
  },
  {
   "texto": "těm dětem bych se z duše kořil."
  },
  {
   "texto": "Zatřeply v ručky, z očí zář,"
  },
  {
   "texto": "smích řehtal z malinových dásní,"
  },
  {
   "texto": "a má-li krása jakou tvář —"
  },
  {
   "texto": "ó patřte, zda-li nejsou krásní!"
  },
  {
   "texto": "Však čím mně jsou nad anděle,"
  },
  {
   "texto": "nad krásu nebes, všehomíru:"
  },
  {
   "texto": "z té zoře v tvářích utkvělé"
  },
  {
   "texto": "čtu novou v člověčenstvo víru."
  },
  {
   "texto": "Já s milenkou — dvě dětičky,"
  },
  {
   "texto": "jdem v lesy na den celičký,"
  },
  {
   "texto": "v stín javorů a do chládku,"
  },
  {
   "texto": "poslouchat lesní pohádku."
  },
  {
   "texto": "Les starý hned nám rozuměl,"
  },
  {
   "texto": "hned pokynul, hned zašuměl:"
  },
  {
   "texto": "již ptáci nesou pozvání,"
  },
  {
   "texto": "jako když na mši sezvání."
  },
  {
   "texto": "Tu motýli, šat ze zlata,"
  },
  {
   "texto": "pak laňky a jich kůzlata,"
  },
  {
   "texto": "na větve ptáci zpěvaví,"
  },
  {
   "texto": "a vše se u nás zastaví."
  },
  {
   "texto": "A stromů staré kořeny"
  },
  {
   "texto": "jsou v divné tváře změněny,"
  },
  {
   "texto": "a z květlých šípků potají"
  },
  {
   "texto": "se lesní panny koukají."
  },
  {
   "texto": "Pak jeden javor stařičký"
  },
  {
   "texto": "zpod paždí vyndá housličky:"
  },
  {
   "texto": "„Tak slyšte, děti, na krátce“ —"
  },
  {
   "texto": "a my chodíme v pohádce."
  }
 ]
}