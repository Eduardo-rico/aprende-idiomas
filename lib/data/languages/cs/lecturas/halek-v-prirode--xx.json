{
 "id": "halek-v-prirode--xx",
 "titulo": "XX. · XXI. · XXII. · XXIII.",
 "autor": "Vítězslav Hálek",
 "muerteAutor": 1874,
 "fuenteUrl": "https://cs.wikisource.org/wiki/V_p%C5%99%C3%ADrod%C4%9B/XX.",
