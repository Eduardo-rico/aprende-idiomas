 "parrafos": [
  {
   "texto": "Dědova mísa"
  },
  {
   "texto": "V kamnech praská, dědek každou chvíli"
  },
  {
   "texto": "svadlé ruce sobě zahřívá,"
  },
  {
   "texto": "kolo vrčí, syn si s prací pílí,"
  },
  {
   "texto": "nádobu si z dřeva vyrývá."
  },
  {
   "texto": "Kolečko si divnou píseň šumí,"
  },
  {
   "texto": "vnoučeti se očka kmitají —"
  },
  {
   "texto": "„Hlele, co náš táta všecko umí,"
  },
  {
   "texto": "jak mu tříšťky z rukou lítají!"
  },
  {
   "texto": "Dřevo ukradl jsi v panském lese —"
  },
  {
   "texto": "komu děláš z něho koryto?“"
  },
  {
   "texto": "„„Dědovi; — již se mu ruka třese,"
  },
  {
   "texto": "nádobí už všechno rozbito.\"\""
  },
  {
   "texto": "„Nauč mne to!“ — „ „Vida toho kluka,"
  },
  {
   "texto": "nač by tvá to ruka uměla?!““"
  },
  {
   "texto": "„Až se tobě třásti bude ruka,"
  },
  {
   "texto": "koryto ti synek udělá!“"
  },
  {
   "texto": "V kamnech praská, dědek shrben pláče,"
  },
  {
   "texto": "zvadlé ruce syn mu zulíbá,"
  },
  {
   "texto": "kolo mlčí, vnouče kolem skáče —"
  },
  {
   "texto": "„Táto, proč se kolo nehýbá?“"
  },
  {
   "texto": "Pláče hošík otrhaný:"
  },
  {
   "texto": ",Přec se jednou seberu,"
  },
  {
   "texto": "tatínkovi, kde ho najdu,"
  },
  {
   "texto": "notně holí vyperu.'"
  },
  {
   "texto": "„Kdož tvůj otec?“ ,Nač se ptáte —"
  },
  {
   "texto": "otec můj je velký pán,"
  },
  {
   "texto": "odejel nám, dávno tomu,"
  },
  {
   "texto": "když mi dával marcipán.'"
  },
  {
   "texto": "„A kam odjel?“ ,Ach což já vím —"
  },
  {
   "texto": "odejel mil na tisíc,"
  },
  {
   "texto": "o maminku nedbá více,"
  },
  {
   "texto": "má prý mam těch ještě víc.'"
  },
  {
   "texto": "Po mém pohřbu křepčili,"
  },
  {
   "texto": "hudba skočnou hrála,"
  },
  {
   "texto": "matka jídlem, nápojem"
  },
  {
   "texto": "hosti častovala."
  },
  {
   "texto": "Druhý den se dělili"
  },
  {
   "texto": "o mých zámkův devět,"
  },
  {
   "texto": "že jsem málo zůstavil,"
  },
  {
   "texto": "nadělali klevet."
  },
  {
   "texto": "„Komu že mou bývalou"
  },
  {
   "texto": "milenku dá máma?“ —"
  },
  {
   "texto": "„O tu já se nestarám,"
  },
  {
   "texto": "postará se sama.“"
  },
  {
   "texto": "Z šedých mračen déšť se hustý lije,"
  },
  {
   "texto": "po dláždění voda proudem teče,"
  },
  {
   "texto": "ulicemi prázdnými tu města"
  },
  {
   "texto": "vojenský se pohřeb truchle vleče."
  },
  {
   "texto": "Černý vůz s tím bílým křížem táhne"
  },
  {
   "texto": "s hlavami svislými čtvero koní, —"
  },
  {
   "texto": "mrtvý v suchu — vozka však promoklý"
  },
  {
   "texto": "rozmrzele spřež svou k spěchu honí."
  },
  {
   "texto": "Na vozíku kříž a lesklá lebka,"
  },
  {
   "texto": "v jejíž oční důlky had se vrývá,"
  },
  {
   "texto": "a za lebkou lesklou, dutou, prázdnou,"
  },
  {
   "texto": "prázdné čáko lidem „s bohem“ kývá."
  },
  {
   "texto": "Buben potažený černým suknem"
  },
  {
   "texto": "trudně odměřeným taktem zvučí,"
  },
  {
   "texto": "k tomu z bratrů, již ho sprovázejí,"
  },
  {
   "texto": "každý mrzutě si kletbu bručí."
  },
  {
   "texto": "„Arci stejně se nám zvede, až nám"
  },
  {
   "texto": "místo rakve dají otep slámy, —"
  },
  {
   "texto": "však by bez nás také cíle dojel,"
  },
  {
   "texto": "také chuďas bez nás došel jámy!“"
  }
 ]
}