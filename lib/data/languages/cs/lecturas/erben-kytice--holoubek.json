 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Okolo hřbitova"
  },
  {
   "texto": "cesta úvozová;"
  },
  {
   "texto": "šla tudy, plakala"
  },
  {
   "texto": "mladá, hezká vdova."
  },
  {
   "texto": "Plakala, želela"
  },
  {
   "texto": "pro svého manžela:"
  },
  {
   "texto": "neb tudy naposled"
  },
  {
   "texto": "jej doprovázela. —"
  },
  {
   "texto": "Od bílého dvora"
  },
  {
   "texto": "po zelené louce"
  },
  {
   "texto": "jede pěkný panic,"
  },
  {
   "texto": "péro na klobouce."
  },
  {
   "texto": "„Neplač, nenaříkej,"
  },
  {
   "texto": "mladá, hezká vdovo,"
  },
  {
   "texto": "škoda by tvých očí,"
  },
  {
   "texto": "slyš rozumné slovo."
  },
  {
   "texto": "Neplač, nenaříkej,"
  },
  {
   "texto": "vdovo, pěkná růže,"
  },
  {
   "texto": "a když muž ti umřel,"
  },
  {
   "texto": "vezmi mne za muže.“ —"
  },
  {
   "texto": "Jeden den plakala,"
  },
  {
   "texto": "druhý ticho minul,"
  },
  {
   "texto": "třetího žel její"
  },
  {
   "texto": "pomalu zahynul."
  },
  {
   "texto": "V témž dni umrlého"
  },
  {
   "texto": "z mysli vypustila:"
  },
  {
   "texto": "než měsíc uplynul,"
  },
  {
   "texto": "k svatbě šaty šila."
  },
  {
   "texto": "Okolo hřbitova"
  },
  {
   "texto": "veselejší cesta:"
  },
  {
   "texto": "jedou tudy, jedou"
  },
  {
   "texto": "ženich a nevěsta."
  },
  {
   "texto": "Byla svatba, byla"
  },
  {
   "texto": "hlučná a veselá:"
  },
  {
   "texto": "nevěsta v objetí"
  },
  {
   "texto": "nového manžela."
  },
  {
   "texto": "Byla svatba, byla,"
  },
  {
   "texto": "hudba pěkně hrála:"
  },
  {
   "texto": "on ji k sobě vinul,"
  },
  {
   "texto": "ona jen se smála."
  },
  {
   "texto": "Směj se, směj, nevěsto,"
  },
  {
   "texto": "pěkně ti to sluší:"
  },
  {
   "texto": "nebožtík pod zemí,"
  },
  {
   "texto": "ten má hluché uši!"
  },
  {
   "texto": "Objímej milého,"
  },
  {
   "texto": "netřeba se báti:"
  },
  {
   "texto": "rakev dosti těsná —"
  },
  {
   "texto": "ten se neobrátí!"
  },
  {
   "texto": "Líbej si je, líbej,"
  },
  {
   "texto": "ty žádané líce:"
  },
  {
   "texto": "komus namíchala,"
  },
  {
   "texto": "neobživne více! —"
  },
  {
   "texto": "Běží časy, běží,"
  },
  {
   "texto": "všecko s sebou mění:"
  },
  {
   "texto": "co nebylo, přijde"
  },
  {
   "texto": "co bývalo, není."
  },
  {
   "texto": "Běží časy, běží,"
  },
  {
   "texto": "rok jako hodina:"
  },
  {
   "texto": "jedno však nemizí:"
  },
  {
   "texto": "pevně stojí vina."
  },
  {
   "texto": "Tři roky minuly,"
  },
  {
   "texto": "co nebožtík leží;"
  },
  {
   "texto": "na jeho pahorku"
  },
  {
   "texto": "tráva roste svěží."
  },
  {
   "texto": "Na pahorku tráva,"
  },
  {
   "texto": "u hlavy mu doubek,"
  },
  {
   "texto": "na doubku sedává"
  },
  {
   "texto": "běloučký holoubek."
  },
  {
   "texto": "Sedává, sedává,"
  },
  {
   "texto": "přežalostně vrká:"
  },
  {
   "texto": "každý, kdo uslyší,"
  },
  {
   "texto": "srdce jemu puká."
  },
  {
   "texto": "Nepuká tak jiným"
  },
  {
   "texto": "jako jedné ženě:"
  },
  {
   "texto": "z hlavy si rve vlasy,"
  },
  {
   "texto": "volá uděšeně:"
  },
  {
   "texto": "„Nehoukej, nevolej,"
  },
  {
   "texto": "nehuč mi tak v uši:"
  },
  {
   "texto": "tvá píseň ukrutná"
  },
  {
   "texto": "probodá mi duši!"
  },
  {
   "texto": "Nehoukej, nežaluj,"
  },
  {
   "texto": "hlava se mi točí;"
  },
  {
   "texto": "aneb mi zahoukej,"
  },
  {
   "texto": "a se mi rozskočí!“ —"
  },
  {
   "texto": "Teče voda, teče,"
  },
  {
   "texto": "vlna vlnu stíhá"
  },
  {
   "texto": "a mezi vlnami"
  },
  {
   "texto": "bílý šat se míhá."
  },
  {
   "texto": "Tu vyplývá noha,"
  },
  {
   "texto": "tam zas ruka bledá:"
  },
  {
   "texto": "žena nešťastnice"
  },
  {
   "texto": "hrobu sobě hledá!"
  },
  {
   "texto": "Vytáhli ji na břeh,"
  },
  {
   "texto": "zahrabali skrytě,"
  },
  {
   "texto": "kde cesty pěšiny"
  },
  {
   "texto": "křižují se v žitě."
  },
  {
   "texto": "Nižádného hrobu"
  },
  {
   "texto": "jí býti nemělo:"
  },
  {
   "texto": "jen kámen veliký"
  },
  {
   "texto": "tlačí její tělo."
  },
  {
   "texto": "Však nelze kamenu"
  },
  {
   "texto": "tak těžko ležeti,"
  },
  {
   "texto": "jako jí na jménu"
  },
  {
   "texto": "spočívá prokletí!"
  }
 ]
}