 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Ráno sedá ke snídani,"
  },
  {
   "texto": "táže se své mladé paní:"
  },
  {
   "texto": "„Paní moje, paní milá,"
  },
  {
   "texto": "vždycky upřímná jsi byla,"
  },
  {
   "texto": "vždycky upřímná jsi byla —"
  },
  {
   "texto": "jednohos mi nesvěřila."
  },
  {
   "texto": "Dvě léta jsme spolu nyní —"
  },
  {
   "texto": "jedno nepokoj mi činí."
  },
  {
   "texto": "Paní moje, milá paní,"
  },
  {
   "texto": "jaké je to tvoje spaní?"
  },
  {
   "texto": "Večer lehneš zdráva, svěží,"
  },
  {
   "texto": "v noci tělo mrtvo leží."
  },
  {
   "texto": "Ani ruchu, ani sluchu,"
  },
  {
   "texto": "ani zdání o tvém duchu."
  },
  {
   "texto": "Studené jest to tvé tělo,"
  },
  {
   "texto": "jak by zpráchnivěti chtělo."
  },
  {
   "texto": "Aniž to maličké dítě,"
  },
  {
   "texto": "hořce plačíc, probudí tě. —"
  },
  {
   "texto": "Paní moje, paní zlatá,"
  },
  {
   "texto": "zdali nemocí jsi jata?"
  },
  {
   "texto": "Jestli nemoc ta závada"
  },
  {
   "texto": "nech, ať přijde moudrá rada."
  },
  {
   "texto": "V poli mnoho bylin stojí,"
  },
  {
   "texto": "snad některá tebe zhojí."
  },
  {
   "texto": "Pakli v býlí není síly,"
  },
  {
   "texto": "mocné slovo neomýlí."
  },
  {
   "texto": "Mocné slovo mračna vodí,"
  },
  {
   "texto": "v bouři líté chrání lodi."
  },
  {
   "texto": "Mocné slovo ohni káže,"
  },
  {
   "texto": "skálu zdrtí, draka sváže."
  },
  {
   "texto": "Jasnou hvězdu strhne z nebe:"
  },
  {
   "texto": "slovo mocné zhojí tebe.“ —"
  },
  {
   "texto": "„Ó pane můj, milý pane,"
  },
  {
   "texto": "nechtěj dbáti řeči plané."
  },
  {
   "texto": "Co souzeno při zrození,"
  },
  {
   "texto": "tomu nikdež léku není."
  },
  {
   "texto": "Co sudice komu káže,"
  },
  {
   "texto": "slovo lidské nerozváže!"
  },
  {
   "texto": "Ač bezduchá na svém loži,"
  },
  {
   "texto": "vždy jsem přece v moci Boží."
  },
  {
   "texto": "Vždy jsem přece v Boží moci,"
  },
  {
   "texto": "jenž mne chrání každé noci."
  },
  {
   "texto": "Ač co mrtvé mi je spáti,"
  },
  {
   "texto": "ráno duch se zase vrátí."
  },
  {
   "texto": "Ráno zdráva vstáti mohu:"
  },
  {
   "texto": "protož poruč Pánu Bohu!“ —"
  },
  {
   "texto": "Darmo, paní, jsou tvá slova,"
  },
  {
   "texto": "pán úmysl jiný chová."
  },
  {
   "texto": "Sedí babka při ohnisku,"
  },
  {
   "texto": "měří vodu z misky v misku,"
  },
  {
   "texto": "dvanáct misek v jedné řadě."
  },
  {
   "texto": "Pán u baby na poradě."
  },
  {
   "texto": "„Slyšíš, matko, ty víš mnoho:"
  },
  {
   "texto": "víš, co potkati má koho,"
  },
  {
   "texto": "víš, kde se čí nemoc rodí,"
  },
  {
   "texto": "kudy smrtná žena chodí."
  },
  {
   "texto": "Pověz ty mi zjevně nyní,"
  },
  {
   "texto": "co se s mojí paní činí?"
  },
  {
   "texto": "Večer lehne zdráva, svěží,"
  },
  {
   "texto": "v noci tělo mrtvo leží,"
  },
  {
   "texto": "ani ruchu, ani sluchu,"
  },
  {
   "texto": "ni zdání o jejím duchu;"
  },
  {
   "texto": "studené jest její tělo,"
  },
  {
   "texto": "jak by zpráchnivěti chtělo.“ —"
  },
  {
   "texto": "„Kterak nemá mrtva býti,"
  },
  {
   "texto": "když má jen půl živobytí?"
  },
  {
   "texto": "Ve dne s tebou živa v domě,"
  },
  {
   "texto": "v noci duše její v stromě."
  },
  {
   "texto": "Jdi k potoku pod oborou,"
  },
  {
   "texto": "najdeš vrbu s bílou korou;"
  },
  {
   "texto": "žluté proutí roste na ní:"
  },
  {
   "texto": "s tou je duše tvojí paní!“ —"
  },
  {
   "texto": "„Nechtěl jsem já paní míti,"
  },
  {
   "texto": "aby s vrbou měla žíti;"
  },
  {
   "texto": "paní má ať se mnou žije"
  },
  {
   "texto": "a vrba ať v zemi hnije.“ —"
  },
  {
   "texto": "Vzal sekeru na ramena,"
  },
  {
   "texto": "uťal vrbu od kořena;"
  },
  {
   "texto": "padla těžce do potoka,"
  },
  {
   "texto": "zašuměla od hluboka,"
  },
  {
   "texto": "zašuměla, zavzdychala,"
  },
  {
   "texto": "jak by matka skonávala,"
  },
  {
   "texto": "jak by matka umírajíc,"
  },
  {
   "texto": "po dítku se ohlédajíc. —"
  },
  {
   "texto": "„Jaký shon to k mému domu?"
  },
  {
   "texto": "Komu zní hodinka, komu?“ —"
  },
  {
   "texto": "„Umřela tvá paní milá,"
  },
  {
   "texto": "jak by kosou sťata byla;"
  },
  {
   "texto": "zdráva chodíc při své práci,"
  },
  {
   "texto": "padla, jako strom se skácí;"
  },
  {
   "texto": "zavzdychala umírajíc,"
  },
  {
   "texto": "po dítku se ohlédajíc.“ —"
  },
  {
   "texto": "„Ó běda mi, běda, běda,"
  },
  {
   "texto": "paní zabil jsem nevěda,"
  },
  {
   "texto": "a z děťátka v tuž hodinu"
  },
  {
   "texto": "učinil jsem sirotinu!"
  },
  {
   "texto": "Ó ty vrbo, vrbo bílá,"
  },
  {
   "texto": "což jsi ty mne zarmoutila!"
  },
  {
   "texto": "Vzalas mi půl živobytí:"
  },
  {
   "texto": "co mám s tebou učiniti?“ —"
  },
  {
   "texto": "„Dej mne z vody vytáhnouti,"
  },
  {
   "texto": "osekej mé žluté proutí;"
  },
  {
   "texto": "dej prkének nařezati,"
  },
  {
   "texto": "kolébku z nich udělati;"
  },
  {
   "texto": "na kolébku vlož děťátko,"
  },
  {
   "texto": "ať nepláče ubožátko."
  },
  {
   "texto": "Když se bude kolébati,"
  },
  {
   "texto": "matka bude je chovati."
  },
  {
   "texto": "Proutí zasaď podle vody,"
  },
  {
   "texto": "by nevzalo žádné škody"
  },
  {
   "texto": "Až doroste hoch maličký,"
  },
  {
   "texto": "bude řezat píšťaličky;"
  },
  {
   "texto": "na píšťalku bude pěti —"
  },
  {
   "texto": "se svou matkou rozprávěti!“"
  }
 ]
}