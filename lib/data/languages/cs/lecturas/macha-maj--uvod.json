 "parrafos": [
  {
   "texto": "Máj (úvod)"
  },
  {
   "texto": "Mnohováženému pánu a panu"
  },
  {
   "texto": "HYNKOVI KOMMOVI"
  },
  {
   "texto": "usedlému měšťanu pražskému,"
  },
  {
   "texto": "vlastenci horlivému,"
  },
  {
   "texto": "na důkaz uctivosti obětuje"
  },
  {
   "texto": "SPISOVATEL"
  },
  {
   "texto": "Čechové jsou národ dobrý!"
  },
  {
   "texto": "Nešťastný, jenž v nouzi lká,"
  },
  {
   "texto": "nechť se k Čechovi obrátí,"
  },
  {
   "texto": "ten mu rychlou pomoc dá;"
  },
  {
   "texto": "byť i Čecha nepřítelem,"
  },
  {
   "texto": "nešetří Čech jeho vin."
  },
  {
   "texto": "Čechové jsou národ dobrý,"
  },
  {
   "texto": "a Ty Čechů věrný syn!"
  },
  {
   "texto": "Sbor"
  },
  {
   "texto": "Věrný syn i bratr náš,"
  },
  {
   "texto": "dobré srdce Čechů máš!"
  },
  {
   "texto": "Čechové jsou národ statný,"
  },
  {
   "texto": "nepřemožen český voj."
  },
  {
   "texto": "Nechť se s vítězstvím rozloučí,"
  },
  {
   "texto": "proti němuž český boj."
  },
  {
   "texto": "Čech kde stojí, krutá bitva"
  },
  {
   "texto": "tamť, i mnohý slavný čin."
  },
  {
   "texto": "Čechové jsou národ statný,"
  },
  {
   "texto": "a Ty Čechů věrný syn!"
  },
  {
   "texto": "Sbor"
  },
  {
   "texto": "Věrný syn i bratr náš,"
  },
  {
   "texto": "statné srdce Čechů máš!"
  },
  {
   "texto": "Čechové jsou národ věrný,"
  },
  {
   "texto": "věrnost jejich první čest;"
  },
  {
   "texto": "vlasti své i svému králi"
  },
  {
   "texto": "Čech i v smrti věrný jest."
  },
  {
   "texto": "Bůh můj - král můj - vlasti moje!"
  },
  {
   "texto": "poslední je Čecha vzdech."
  },
  {
   "texto": "Čechové jsou národ věrný,"
  },
  {
   "texto": "a ty syn jich - věrný Čech!"
  },
  {
   "texto": "Sbor"
  },
  {
   "texto": "Věrný Čech i bratr náš,"
  },
  {
   "texto": "věrné Čechů srdce máš!"
  },
  {
   "texto": "Věrný syn jsi Čechů kmene,"
  },
  {
   "texto": "věrný bratr bratřím svým;"
  },
  {
   "texto": "jazyk český je i Tobě"
  },
  {
   "texto": "otců drahým dědictvím."
  },
  {
   "texto": "České hory - české doly -"
  },
  {
   "texto": "české luhy - český háj -"
  },
  {
   "texto": "šírá vlasť - ta česká země"
  },
  {
   "texto": "nejmilejšíť Tobě ráj."
  },
  {
   "texto": "Sbor"
  },
  {
   "texto": "Věrný Čech jsi - vlastenec,"
  },
  {
   "texto": "protož vděčný u věnec"
  },
  {
   "texto": "květ Ti vije Čecha máj!"
  }
 ]
}