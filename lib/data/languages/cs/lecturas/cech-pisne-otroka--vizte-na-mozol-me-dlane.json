 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Vizte, na mozol mé dlaně"
  },
  {
   "texto": "náhodou si motýl sedá,"
  },
  {
   "texto": "křídla skvoucí kloní, zvedá,"
  },
  {
   "texto": "a já hledím zadumaně"
  },
  {
   "texto": "na tu břitkou protivu:"
  },
  {
   "texto": "na pleť drsnou, svrasklou, temnou,"
  },
  {
   "texto": "plnou jizev práce krušné,"
  },
  {
   "texto": "a ty lehké tvary vzdušné,"
  },
  {
   "texto": "barev skvostných září jemnou"
  },
  {
   "texto": "oko zvoucí k obdivu."
  },
  {
   "texto": "Nenadálý vzácný hoste,"
  },
  {
   "texto": "ustrojený v zář a duhu,"
  },
  {
   "texto": "milče kvetoucího luhu,"
  },
  {
   "texto": "bytí tvé, ó živý skvoste,"
  },
  {
   "texto": "jeden za rozkoší let:"
  },
  {
   "texto": "tančíš jenom po své zvůli"
  },
  {
   "texto": "v modru volném, v teplém jase,"
  },
  {
   "texto": "v lásky hrách a věčném kvase,"
  },
  {
   "texto": "k němuž v nektar svůj ti z důli"
  },
  {
   "texto": "kyne sterý zářný květ."
  },
  {
   "texto": "Zatím v poutech ruka moje"
  },
  {
   "texto": "z jitra k noci každé chvíle"
  },
  {
   "texto": "lopotí se v krušném díle,"
  },
  {
   "texto": "věčně splývá ručej znoje"
  },
  {
   "texto": "s čela, jež se kloní v prach;"
  },
  {
   "texto": "jako v pluhu skot se vleku"
  },
  {
   "texto": "pod ranami kruté pěsti,"
  },
  {
   "texto": "neznám požitku ni štěstí,"
  },
  {
   "texto": "neznám životního vděku,"
  },
  {
   "texto": "znám jen péči, žal a strach."
  },
  {
   "texto": "A přec nezávidím tobě,"
  },
  {
   "texto": "motýle, tvůj život hravý,"
  },
  {
   "texto": "požitku rej kolotavý,"
  },
  {
   "texto": "ve zlata i nachu zdobě"
  },
  {
   "texto": "stálý tanec lučinou:"
  },
  {
   "texto": "Nechtěl bych jen sníti líně,"
  },
  {
   "texto": "za rozkoší jen se honit,"
  },
  {
   "texto": "osud náš: pot v půdu ronit,"
  },
  {
   "texto": "po zdárných jen činech v klíně"
  },
  {
   "texto": "ruce sladko spočinou."
  },
  {
   "texto": "Rád bych volnou, čestnou prací"
  },
  {
   "texto": "ducha napínal i paže,"
  },
  {
   "texto": "prácí, již hlas vlastní káže,"
  },
  {
   "texto": "která pracovníku splácí"
  },
  {
   "texto": "žitím hodným člověka;"
  },
  {
   "texto": "prácí, která k dobru čelí,"
  },
  {
   "texto": "z níž by vzaly plody zlaté"
  },
  {
   "texto": "bytosti s mým srdcem spjaté,"
  },
  {
   "texto": "lid můj, vlasť, sbor lidstva celý,"
  },
  {
   "texto": "budoucnost i daleká."
  },
  {
   "texto": "Ale kletbou práce tato"
  },
  {
   "texto": "ujařmená, ponížená,"
  },
  {
   "texto": "znesvěcená, znevážená,"
  },
  {
   "texto": "kterou v rámě, poutem spjato,"
  },
  {
   "texto": "koná v důtek svistění,"
  },
  {
   "texto": "která pro jiného vije"
  },
  {
   "texto": "rozkošnictví mrzké kvítí,"
  },
  {
   "texto": "jíž on za mzdu v čelo ryje"
  },
  {
   "texto": "korunu z všech trnů žití"
  },
  {
   "texto": "a své moci znamení."
  }
 ]
}