{
 "id": "neruda-knihy-versu--z-melnicke-skaly",
 "titulo": "Z mělnické skály",
 "autor": "Jan Neruda",
 "muerteAutor": 1891,
 "fuenteUrl": "https://cs.wikisource.org/wiki/Knihy_ver%C5%A1%C5%AF/Z_m%C4%9Blnick%C3%A9_sk%C3%A1ly",
 "fuente": "cs.wikisource.org, «Knihy veršů»",
 "licencia": "dominio público (autor muerto en 1891)",
 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción mezcla el infinitivo antiguo en «-ti» (2 formas) con el actual en «-t» (12). Se conserva tal cual: es la grafía de la edición, no un error. Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "neruda-knihy-versu",
  "titulo": "Knihy veršů",
  "orden": 25
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Z tvých vlasů ruka přírody"
  },
  {
   "texto": "si půvab ráje spředla —"
  },
  {
   "texto": "mělnický kraji, milko má,"
  },
  {
   "texto": "ty's mne až k slzám svedla."
  },
  {
   "texto": "Tvá krev tak prudká, ohnivá,"
  },
  {
   "texto": "že prorazila skály"
  },
  {
   "texto": "a po skalách se ohnivé"
  },
  {
   "texto": "nám révy rozesmály."
  },
  {
   "texto": "V tvém lůně chci být pohroben,"
  },
  {
   "texto": "pak aspoň umru v ráji —"
  },
  {
   "texto": "kdož není milky otrokem."
  },
  {
   "texto": "když krví ho napájí?"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Aj, jak se víno červené"
  },
  {
   "texto": "ve sklenkách jasně blyští,"
  },
  {
   "texto": "ba jak ta lidská rudá krev,"
  },
  {
   "texto": "když ze srdce se pryští!"
  },
  {
   "texto": "Snad se to všech těch bláznů krev"
  },
  {
   "texto": "nám do lahví zde shlukla,"
  },
  {
   "texto": "jimž pro nějaký marný žel"
  },
  {
   "texto": "kdys marně srdce pukla."
  },
  {
   "texto": "Snad našich nepřátel to krev,"
  },
  {
   "texto": "již myšlénky se bojí"
  },
  {
   "texto": "a proti všemu pokroku"
  },
  {
   "texto": "jak čínské copy stojí."
  },
  {
   "texto": "Nuž pijme, pijme! — pitím snad"
  },
  {
   "texto": "krev špatnou předěláme,"
  },
  {
   "texto": "a snad se pitím bláznovství"
  },
  {
   "texto": "po světě celém zláme!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Pojď, Míno, sem a na klín můj,"
  },
  {
   "texto": "není to na poprvé,"
  },
  {
   "texto": "já k vínu musím rty tvé mít,"
  },
  {
   "texto": "jeť obé jako z krve."
  },
  {
   "texto": "Jsem zvyklý vína oheň pít"
  },
  {
   "texto": "a mladé líbat líce,"
  },
  {
   "texto": "až nerozeznám blažený"
  },
  {
   "texto": "rty tvé od vína více."
  },
  {
   "texto": "A ty's tak dobra! — ku konci,"
  },
  {
   "texto": "když ospalý pak sklesnu,"
  },
  {
   "texto": "tu trpíš, že na klínu tvém"
  },
  {
   "texto": "jak malé dítě zesnu."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Jen český granát ohnivý"
  },
  {
   "texto": "jak české, rudé víno, —"
  },
  {
   "texto": "já vše, co české, miluju —"
  },
  {
   "texto": "ba také tebe — Míno!"
  },
  {
   "texto": "Jen pro vlno mne nekárej,"
  },
  {
   "texto": "má praslovanská Míno!"
  },
  {
   "texto": "ty na hrdle chceš granát mít,"
  },
  {
   "texto": "já do hrdla chci víno."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Mé víno je tak ohnivé!"
  },
  {
   "texto": "Snad révy slunce vssály,"
  },
  {
   "texto": "když jeho palní prškové"
  },
  {
   "texto": "v kraj vinní ostře pláli."
  },
  {
   "texto": "Chuť pikantní se k lehounké"
  },
  {
   "texto": "trpkosti mile kloní —"
  },
  {
   "texto": "když tvář už prací hořela,"
  },
  {
   "texto": "snad tekla slza po ní!"
  },
  {
   "texto": "A skluzké tak, až milo pít —"
  },
  {
   "texto": "snad pot v něm s lůzy čela,"
  },
  {
   "texto": "když po vinicích ku práci"
  },
  {
   "texto": "svá vlékla mdlá už těla!"
  },
  {
   "texto": "Ba nač by byla lůza ta,"
  },
  {
   "texto": "ať dělá — posnídáme!"
  },
  {
   "texto": "ať třeba oči vypláče,"
  },
  {
   "texto": "jen když my víno máme!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Vím, proč se vína bojíte —"
  },
  {
   "texto": "že jazyk rozvazuje"
  },
  {
   "texto": "a nám, že jenom herci jste,"
  },
  {
   "texto": "pak jasně dokazuje."
  },
  {
   "texto": "My, již jsme k bratrům poctivi,"
  },
  {
   "texto": "svých slov se nebojíme,"
  },
  {
   "texto": "vždy stejný směr a stejný hlas -"
  },
  {
   "texto": "my víno směle pijme!"
  },
  {
   "texto": "Kdo nikdy vína nezkusil,"
  },
  {
   "texto": "zaslouží vždy jen vodu pít:"
  },
  {
   "texto": "kdo nikdy hlouposť nechvástal,"
  },
  {
   "texto": "jak může někdy moudrým být?"
  },
  {
   "texto": "Já chvástal dost už hloupostí"
  },
  {
   "texto": "a pil a byl jsem ještě mlád,"
  },
  {
   "texto": "a teď jsem velkým mudrcem —"
  },
  {
   "texto": "jsem tomu rád, ba tuze rád!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Každého jara kmeny rév"
  },
  {
   "texto": "přehořké slzy lijou,"
  },
  {
   "texto": "že těch tak málo ve světě,"
  },
  {
   "texto": "již jenom víno pijou."
  },
  {
   "texto": "Mně vše už jedno, zda-li svět"
  },
  {
   "texto": "teď stojí neb se točí,"
  },
  {
   "texto": "jen nad osudem truchlých rév"
  },
  {
   "texto": "zas pláčou moje oči."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Já Němcům jenom závidím"
  },
  {
   "texto": "ty jejich vinní sklepy,"
  },
  {
   "texto": "ve sklepích mají milou tmu"
  },
  {
   "texto": "a člověk prý jak slepý."
  },
  {
   "texto": "Tu piják aspoň nevidí,"
  },
  {
   "texto": "kde vedou ven zas dvéře"
  },
  {
   "texto": "a mnoho-li as pitím svým"
  },
  {
   "texto": "zas bratrům pití béře."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Už véřím tomu, víno že"
  },
  {
   "texto": "ve mlhách lépe zraje,"
  },
  {
   "texto": "vždyť po víně mně mozkem mým"
  },
  {
   "texto": "vždy lehká mlha hraje."
  },
  {
   "texto": "A mívám pěkný, krásný čas,"
  },
  {
   "texto": "když mlha k zemi sklesne,"
  },
  {
   "texto": "však když jde k výši, hlava má"
  },
  {
   "texto": "pod těžkým mrakem zesne."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Ve první knize moudrosti"
  },
  {
   "texto": "hned první hlava praví:"
  },
  {
   "texto": "kdo rozum měl a pozbyl ho,"
  },
  {
   "texto": "jen ten měl rozum zdravý."
  },
  {
   "texto": "Můj rozum je tak churavý,"
  },
  {
   "texto": "že mne to nutí k slze,"
  },
  {
   "texto": "vždyť jsem ho dosud nepozbyl"
  },
  {
   "texto": "v své každodenní mlze!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Jen smějte se, že v křivo jdu,"
  },
  {
   "texto": "po víně nemůž' jinak být,"
  },
  {
   "texto": "a kdo je nad vás moudřejším,"
  },
  {
   "texto": "můž' toho také odznak mít."
  },
  {
   "texto": "Být nechci, jak ten hloupý lid,"
  },
  {
   "texto": "jenž hrd už chladnou chůzí svou"
  },
  {
   "texto": "po hlavě chodit neumím,"
  },
  {
   "texto": "nuž tedy špatně po nohou!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Já nechci nikdy pivo pít,"
  },
  {
   "texto": "chci červené jen víno,"
  },
  {
   "texto": "po pivě bývá v myšlénkách"
  },
  {
   "texto": "mých skoro strašně líno."
  },
  {
   "texto": "Pro pivo v českém pokroku"
  },
  {
   "texto": "jde vše až hrůza líno,"
  },
  {
   "texto": "a chcem-li pomoct lidstvu dál,"
  },
  {
   "texto": "nuž víno — víno — víno!"
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "U nechte mne v mé hospůdce"
  },
  {
   "texto": "jen tiše dále píti;"
  },
  {
   "texto": "když mně nic po vás, nač má vám"
  },
  {
   "texto": "přede po mně něco býti?"
  },
  {
   "texto": "Vás ke všemu, co svatého,"
  },
  {
   "texto": "ctižádost jenom víže,"
  },
  {
   "texto": "však já—já nejsem schopen té"
  },
  {
   "texto": "nečestně čestné tíže."
  },
  {
   "texto": "Z vás vždy je jeden polobůh"
  },
  {
   "texto": "a druzí blbí skopci,"
  },
  {
   "texto": "již přisahají na slovo"
  },
  {
   "texto": "a slepě za ním hopcí."
  },
  {
   "texto": "Já nemám sebe za boha,"
  },
  {
   "texto": "vím ale, co z vás žádný:"
  },
  {
   "texto": "když plný džbánek vypiju,"
  },
  {
   "texto": "že nejsem pak už prázdný."
  },
  {
   "texto": "Já v hospůdce své králem jsem"
  },
  {
   "texto": "a vše mne zde poslouchá,"
  },
  {
   "texto": "třeba mne někdy sklepnice"
  },
  {
   "texto": "z přátelství loktem šťouchá."
  },
  {
   "texto": "Mé království je chudé jen"
  },
  {
   "texto": "a není pozlaceno,"
  },
  {
   "texto": "však všechno dobré i vše zlé"
  },
  {
   "texto": "poctivě zaplaceno."
  },
  {
   "texto": "Až přijde ale činů den,"
  },
  {
   "texto": "však já vám leccos zkazím —"
  },
  {
   "texto": "pak hybaj, sic vám kovaným"
  },
  {
   "texto": "svým džbánkem hlavu srazím!"
  }
 ]
}