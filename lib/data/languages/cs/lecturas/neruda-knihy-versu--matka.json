 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "Pod vodou měl ji sedm let"
  },
  {
   "texto": "a měla s ním dvě děti,"
  },
  {
   "texto": "pak řekl Vodník: „Můžeš teď"
  },
  {
   "texto": "zas domov uviděti."
  },
  {
   "texto": "Déle se však tam nesdržuj"
  },
  {
   "texto": "než tři dni a tři noci,"
  },
  {
   "texto": "sic zde tvé děti zardousím"
  },
  {
   "texto": "a umrou bez pomoci."
  },
  {
   "texto": "Déle se mně tam nesdržuj,"
  },
  {
   "texto": "to žádám ještě jednou,"
  },
  {
   "texto": "sic vlny ze dna děti tvé"
  },
  {
   "texto": "jak mrtvý leknín zvednou!“ —"
  },
  {
   "texto": "Plynula noc a plynul den,"
  },
  {
   "texto": "co zas je navrácena,"
  },
  {
   "texto": "co s ní se těší družka zas"
  },
  {
   "texto": "i matka skormoucená."
  },
  {
   "texto": "V noci ji matka uspává"
  },
  {
   "texto": "přemnohou průpovědí"
  },
  {
   "texto": "a ve dne s družkou zpívají"
  },
  {
   "texto": "kde kterou píseň vědí."
  },
  {
   "texto": "Plynula noc a plyne deň"
  },
  {
   "texto": "a plyne noc již třetí:"
  },
  {
   "texto": "„Již musím od vás, volají"
  },
  {
   "texto": "mne moje drobné děti."
  },
  {
   "texto": "Musím již od vás, ku kapli"
  },
  {
   "texto": "jdu zbavit vší se tíže,"
  },
  {
   "texto": "o matko, dejte ruku svou"
  },
  {
   "texto": "a požehnání kříže!“"
  },
  {
   "texto": "Rychle se matce vytrhla"
  },
  {
   "texto": "a dveřmi rychle kráčí:"
  },
  {
   "texto": "„Kam, družko drahá, v spěchu tak,"
  },
  {
   "texto": "že sotva dech ti stačí?“"
  },
  {
   "texto": "Ona však kolem okénka"
  },
  {
   "texto": "Dál dále rychle kráčí,"
  },
  {
   "texto": "A matka za ní z komůrky:"
  },
  {
   "texto": "„Nenech mne, dcero, v pláči!“"
  },
  {
   "texto": "Sklesla před Panny obrazem:"
  },
  {
   "texto": "„Mou matku starou chrani! —“"
  },
  {
   "texto": "a doma matka modlí se:"
  },
  {
   "texto": "„Ach dceři cestu brani!“"
  },
  {
   "texto": "Se zdi se Panna sklonila"
  },
  {
   "texto": "zázračném u zjevení:"
  },
  {
   "texto": "„Víc nepůjdeš již k muži zpět,"
  },
  {
   "texto": "sic přijdeš o spasení."
  },
  {
   "texto": "Pro tebe více muže tam"
  },
  {
   "texto": "ni dětí více není,"
  },
  {
   "texto": "a půjdeš-li tam předce zpět"
  },
  {
   "texto": "ty dojdeš zatracení!“"
  },
  {
   "texto": "Oko se slzou zalívá"
  },
  {
   "texto": "a srdce smutkem puká:"
  },
  {
   "texto": "„Ach Panno, k dětem půjdu zas"
  },
  {
   "texto": "přes všechna pekel muka!"
  },
  {
   "texto": "Rci mně, o Panno, kdyby v tom"
  },
  {
   "texto": "i věčná byla vina,"
  },
  {
   "texto": "zda byla bys kdy mohla ty"
  },
  {
   "texto": "snad opustiti syna?“"
  }
 ]
}