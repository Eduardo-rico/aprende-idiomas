 "parrafos": [
  {
   "texto": "Do lomů jde Bárta z rána,"
  },
  {
   "texto": "skály láme, zpřevrhá,"
  },
  {
   "texto": "hromu klín je každá rána,"
  },
  {
   "texto": "div se země nestrhá."
  },
  {
   "texto": "Zastaví se v smutném stesku:"
  },
  {
   "texto": "„Tak jsi, země, bohata,"
  },
  {
   "texto": "knížatům dáš slávy, lesku,"
  },
  {
   "texto": "trůn i palác od zlata.“"
  },
  {
   "texto": "A zas buší v horkém potu:"
  },
  {
   "texto": "„A co červ já chudobný!"
  },
  {
   "texto": "Palác můj je sotva z plotu,"
  },
  {
   "texto": "boudě psí spíš podobný."
  },
  {
   "texto": "Ale mít tak z tvého lože"
  },
  {
   "texto": "jeden kámen ze zlata,"
  },
  {
   "texto": "ženu na to — pane bože,"
  },
  {
   "texto": "byla by to záplata!“"
  },
  {
   "texto": "Zabeře se v rozjímání,"
  },
  {
   "texto": "ruce klade do klína —"
  },
  {
   "texto": "co to plá mu v tvrdé dlani?"
  },
  {
   "texto": "Zlata plná slitina."
  },
  {
   "texto": "Hned se kámen v palác klene,"
  },
  {
   "texto": "prostřed bílá komnata,"
  },
  {
   "texto": "v síních stoly rozprostřené"
  },
  {
   "texto": "pro pány a knížata."
  },
  {
   "texto": "Na stolech co hrdlo ráčí,"
  },
  {
   "texto": "vína, jídel na stohy,"
  },
  {
   "texto": "hudba drnká na pavlači,"
  },
  {
   "texto": "až to trhá pod nohy."
  },
  {
   "texto": "V síních tenké vodojemy,"
  },
  {
   "texto": "v tanci dívčí kročeje,"
  },
  {
   "texto": "zrovna jak když s liliemi"
  },
  {
   "texto": "samé růže proseje."
  },
  {
   "texto": "A ty růže světlo v oku,"
  },
  {
   "texto": "lilje hlavou pokynou —"
  },
  {
   "texto": "„Bárto, Bárto, hni se v kroku,"
  },
  {
   "texto": "vyber si, však jedinou!“"
  },
  {
   "texto": "Hned se v živý věnec klenou"
  },
  {
   "texto": "rty a šíje bělostné,"
  },
  {
   "texto": "všude, na rtech, na ramenou"
  },
  {
   "texto": "vděky jsou tak pohostné."
  },
  {
   "texto": "Měkce obtočí ho k sobě,"
  },
  {
   "texto": "sladce mluví: „Náš jsi, náš,"
  },
  {
   "texto": "sláva tobě, sláva tobě,"
  },
  {
   "texto": "jednu-li jen zulíbáš!“"
  },
  {
   "texto": "Bárta je však samá láska,"
  },
  {
   "texto": "líbá všecky v beztrudí,"
  },
  {
   "texto": "v tom zeď od základů praská —"
  },
  {
   "texto": "ráz! a on se probudí."
  },
  {
   "texto": "Ten tam z ruky poklad zlata,"
  },
  {
   "texto": "palác, síně, přístěny —"
  },
  {
   "texto": "v dlani mozol a kus bláta,"
  },
  {
   "texto": "náruč bez děv, bez ženy."
  },
  {
   "texto": "Vstal a hned si žáhu spraví:"
  },
  {
   "texto": "rukávy si vykasá,"
  },
  {
   "texto": "pere do skal, až se taví,"
  },
  {
   "texto": "až se země otřásá."
  }
 ]
}