  {
   "texto": "12"
  },
  {
   "texto": "Všechny ty vířivé planety,"
  },
  {
   "texto": "s měsíci přílepky,"
  },
  {
   "texto": "vylétly do světa širého"
  },
  {
   "texto": "ze Slunce z kolébky."
  },
  {
   "texto": "Všechny ty vířivé planety"
  },
  {
   "texto": "za svoji za dobu"
  },
  {
   "texto": "slétnou zas ze světa širého"
  },
  {
   "texto": "do Slunce do hrobu."
  },
  {
   "texto": "Také to Slunce ohnivé"
  },
  {
   "texto": "pomalu pousíná,"
  },
  {
   "texto": "přijde i jeho hodinka,"
  },
  {
   "texto": "zhasne a mrtvě zsiná."
  },
  {
   "texto": "A jen když za čas planeta"
  },
  {
   "texto": "na prsa zpět mu skane,"
  },
  {
   "texto": "zase pak dávným plamem svým"
  },
  {
   "texto": "na chvíli ještě vzplane."
  },
  {
   "texto": "Ach což ta láska mateřská"
  },
  {
   "texto": "přes časy, přes hrob hoří,"
  },
  {
   "texto": "neumrazíš jí na horách,"
  },
  {
   "texto": "neuhasíš jí v moři!"
  },
  {
   "texto": "Matičce dáš-li do hrobu"
  },
  {
   "texto": "na prsa dítě její,"
  },
  {
   "texto": "ještě se vpadlé, ztlelé rty"
  },
  {
   "texto": "radostí pozachvějí."
  },
  {
   "texto": "Zem byla dítětem; myslela,"
  },
  {
   "texto": "ona že vesmíru pyšný střed"
  },
  {
   "texto": "a kvůli ní Slunce i obloha"
  },
  {
   "texto": "a celý širý Svět."
  },
  {
   "texto": "Přišlo jí také už poznání,"
  },
  {
   "texto": "divně se chvěje jí srdce dnes"
  },
  {
   "texto": "a je jí jak panence rozkvětlé,"
  },
  {
   "texto": "když vešla v první ples."
  },
  {
   "texto": "Po sále hvězdy se chechtají:"
  },
  {
   "texto": "„Velký svět není jí ještě znám,"
  },
  {
   "texto": "však - hezounká, milounká panenko -"
  },
  {
   "texto": "tys zato známa nám!"
  },
  {
   "texto": "Na tebe my jsme už hleděly,"
  },
  {
   "texto": "když bylas v poupěti drobný květ,"
  },
  {
   "texto": "když rostla jsi do krásy - samý sen"
  },
  {
   "texto": "a sobě celý svět!“"
  },
  {
   "texto": "Měsíček čekal hned u vchodu:"
  },
  {
   "texto": "„Panenko, žádám vás - ať tak dím -"
  },
  {
   "texto": "za taneček první a poslední"
  },
  {
   "texto": "a za ty mezi tím!“"
  },
  {
   "texto": "Měsíček, pěkný mládenec,"
  },
  {
   "texto": "s jemně zářící lící,"
  },
  {
   "texto": "oblétá Zemi panenku"
  },
  {
   "texto": "jak holub holubici."
  },
  {
   "texto": "Když ji hled jeho políbí,"
  },
  {
   "texto": "zvlní se ňadra její,"
  },
  {
   "texto": "oheň se vnitřní rozkypí"
  },
  {
   "texto": "a rty se žárem chvějí."
  },
  {
   "texto": "Přece se věčně upejpá,"
  },
  {
   "texto": "ret její vždy zas chladne,"
  },
  {
   "texto": "stoudně si vede vpovzdálí -"
  },
  {
   "texto": "a Měsíc schne a vadne."
  },
  {
   "texto": "Znej ty panenky jako já,"
  },
  {
   "texto": "budeš si vést jináče:"
  },
  {
   "texto": "ve dne se každá upejpá -"
  },
  {
   "texto": "a v noci blahem pláče."
  },
  {
   "texto": "Panenka Zem po celou noc"
  },
  {
   "texto": "hledí k tvé slíčné tváři -"
  },
  {
   "texto": "k ránu je plno rosných slz"
  },
  {
   "texto": "jak dívčím po polštáři."
  }
 ]
