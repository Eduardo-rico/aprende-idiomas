 "parrafos": [
  {
   "texto": "CLVI."
  },
  {
   "texto": "Tak málo přírodě jsme věrní,"
  },
  {
   "texto": "až nehodno to mudrce —"
  },
  {
   "texto": "ti jedni citem malicherní,"
  },
  {
   "texto": "ti druzí zhola bez srdce."
  },
  {
   "texto": "A ještě hůř kdo v převrácení"
  },
  {
   "texto": "ten trochu lidství natrhnou,"
  },
  {
   "texto": "že znavení a přesycení"
  },
  {
   "texto": "i tužby lidské zavrhnou."
  },
  {
   "texto": "Jak zcela v jiné stojí tváři"
  },
  {
   "texto": "ta velká všeho mistryně:"
  },
  {
   "texto": "s tisíci světů hospodaří"
  },
  {
   "texto": "a broučka pozve k hostině."
  },
  {
   "texto": "V den slunce na noc doprovází,"
  },
  {
   "texto": "v noc hvězdy tká si do roucha,"
  },
  {
   "texto": "a přec u každé poupě vchází"
  },
  {
   "texto": "a jeho přáním naslouchá."
  },
  {
   "texto": "A přec pro hled svůj všehomírný"
  },
  {
   "texto": "ni stéblo láskou nemine,"
  },
  {
   "texto": "a ještě její cit nesmírný"
  },
  {
   "texto": "co rosa v den se rozplyne."
  },
  {
   "texto": "Sotva více píseň velká"
  },
  {
   "texto": "pravdy v sobě uvírá,"
  },
  {
   "texto": "mnoho-li pták do hrdélka"
  },
  {
   "texto": "ze srdce jí nasbírá."
  },
  {
   "texto": "Sotva více krásy něžné"
  },
  {
   "texto": "do té pravdy ujme se,"
  },
  {
   "texto": "co jí kvítko malé, sněžné"
  },
  {
   "texto": "z poupátka si vynese."
  },
  {
   "texto": "Sotva více třpytu, jasna"
  },
  {
   "texto": "z pravdy té se roznítí,"
  },
  {
   "texto": "co ta hvězda drobnokrásná"
  },
  {
   "texto": "sobě na noc rozsvítí."
  },
  {
   "texto": "A co vy jste, písně drobné"
  },
  {
   "texto": "o té velké přírodě?"
  },
  {
   "texto": "Jen tak jako kapky zdobné"
  },
  {
   "texto": "na kalíšků lahodě."
  },
  {
   "texto": "Starou lípu ťali v lebku."
  },
  {
   "texto": "„Nač to bude?“ — „Těžko říci,"
  },
  {
   "texto": "chudí prosí na kolébku,"
  },
  {
   "texto": "pán povídá: šibenici.“"
  },
  {
   "texto": "Chudým v dar ji dejte kalý,"
  },
  {
   "texto": "ať má nebe aspoň v lůžku,"
  },
  {
   "texto": "a ten andělíček malý"
  },
  {
   "texto": "lesů písně za podušku."
  },
  {
   "texto": "Matka dřímá; nad kolébkou"
  },
  {
   "texto": "hájův sny a dechy vanou —"
  },
  {
   "texto": "ať má srdce, duši hebkou,"
  },
  {
   "texto": "božím dechem dotýkanou…"
  },
  {
   "texto": "„Drahý pane, nač ty trudy?"
  },
  {
   "texto": "Má jen pán se všeho zříci?"
  },
  {
   "texto": "Kolébku má každý chudý,"
  },
  {
   "texto": "ne každý pán šibenici.“"
  },
  {
   "texto": "Ty dítko tváří červánkových,"
  },
  {
   "texto": "s tím v oku nebes blankytem,"
  },
  {
   "texto": "čtu z tebe píseň zvuků nových"
  },
  {
   "texto": "s nesmírně blahým pocitem."
  },
  {
   "texto": "Ach, snad mi z oka tvého zrůstá,"
  },
  {
   "texto": "co nové pravdy stanoví,"
  },
  {
   "texto": "a co nevědí naše ústa,"
  },
  {
   "texto": "tvůj ret snad nám to dopoví."
  },
  {
   "texto": "Z tvých očí úsvitu mně svítá"
  },
  {
   "texto": "jak příštích věků svědomí,"
  },
  {
   "texto": "to teprv naše skutky sčítá"
  },
  {
   "texto": "a každou pečeť odlomí."
  },
  {
   "texto": "Ba z tvého oka cos mi září,"
  },
  {
   "texto": "jak všeobsáhlý božstva hled,"
  },
  {
   "texto": "já pokleknul bych před tvou tváří"
  },
  {
   "texto": "a modlitbám se učil hned."
  }
 ]
}