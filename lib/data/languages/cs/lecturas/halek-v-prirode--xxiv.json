 "nivel": "B1",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "halek-v-prirode",
  "titulo": "V přírodě",
  "orden": 7
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "XXIV."
  },
  {
   "texto": "Bloudila v hájů sklepení,"
  },
  {
   "texto": "zahrabat dítě v lupení —"
  },
  {
   "texto": "před časem květ byl utrhlý,"
  },
  {
   "texto": "za to ji lidé vyvrhli."
  },
  {
   "texto": "Příroda — také matička —"
  },
  {
   "texto": "tonula v slasti celička,"
  },
  {
   "texto": "blažená prostřed rozenců"
  },
  {
   "texto": "tvořila květy z pupenců."
  },
  {
   "texto": "„Ustaň a nelam poupě to,"
  },
  {
   "texto": "mám pro ně v život zaseto:"
  },
  {
   "texto": "viz, jak mu volám ze hrobu"
  },
  {
   "texto": "jaro i všecku ozdobu."
  },
  {
   "texto": "Vyvádím jemu k obsluze"
  },
  {
   "texto": "ptactvo i stromů haluze,"
  },
  {
   "texto": "matka jsem všeho odvěká —"
  },
  {
   "texto": "stvořím-li, blažím člověka."
  },
  {
   "texto": "A kdo se na něm prohřeší,"
  },
  {
   "texto": "nechť ho nic v světě netěší,"
  },
  {
   "texto": "jaro mu vadni v starobě —"
  },
  {
   "texto": "zvrh’ť se mi v lidské podobě.“"
  },
  {
   "texto": "Stříbrné lesa praménky —"
  },
  {
   "texto": "tam les má ty své myšlénky,"
  },
  {
   "texto": "tam bublá, bublá, napoví,"
  },
  {
   "texto": "než to svým šumem vysloví."
  },
  {
   "texto": "Tam možná v dno mu hleděti,"
  },
  {
   "texto": "až do duše, jak dítěti,"
  },
  {
   "texto": "jak vše to v něm se obráží,"
  },
  {
   "texto": "co pomyslí, co uváží."
  },
  {
   "texto": "Tam srnky chodí v úradu"
  },
  {
   "texto": "a kvítka pro svou omladu,"
  },
  {
   "texto": "tam mušky letí v návštěvy"
  },
  {
   "texto": "a ptáčci pro své nápěvy."
  },
  {
   "texto": "Tam bludní kleknou poutníci"
  },
  {
   "texto": "a pijou nápoj sílicí —"
  },
  {
   "texto": "tam duše ve svět hozená"
  },
  {
   "texto": "se najde znovuzrozená."
  },
  {
   "texto": "Co to? Jsem kvítkem mezi kvítky,"
  },
  {
   "texto": "druh druhům, něhou vítězným:"
  },
  {
   "texto": "nevím co jsem, však rozumím jim,"
  },
  {
   "texto": "i hrám, i snům jich líbezným."
  },
  {
   "texto": "Mám s nimi jako jedno srdce"
  },
  {
   "texto": "a jako jednu utrobu,"
  },
  {
   "texto": "mám s nimi stesk i rozkoš jednu,"
  },
  {
   "texto": "i dech i žití zásobu."
  },
  {
   "texto": "Mám s nimi jako jednu touhu,"
  },
  {
   "texto": "i šept i v lásce žasnutí,"
  },
  {
   "texto": "mám jeden háj a jeden pramen,"
  },
  {
   "texto": "i lesk, i jedno zhasnutí."
  },
  {
   "texto": "Na jedno k nim se kladu lůžko;"
  },
  {
   "texto": "až noc se v spáncích utopí,"
  },
  {
   "texto": "jim víla rosou zkropí víčka —"
  },
  {
   "texto": "zda také moje pokropí?"
  },
  {
   "texto": "Pozeptaly se písně mé,"
  },
  {
   "texto": "kde vlastí jsou a rodem,"
  },
  {
   "texto": "a já plul s nimi po slzách"
  },
  {
   "texto": "až k duši křišťálovým vchodem."
  },
  {
   "texto": "A bylo tam jak v zahradě,"
  },
  {
   "texto": "vše pučelo a kvetlo,"
  },
  {
   "texto": "radost i žal co poupata,"
  },
  {
   "texto": "a z myšlének teplounké světlo."
  },
  {
   "texto": "A nebe láska klenula,"
  },
  {
   "texto": "a žal byl hájem tmavým,"
  },
  {
   "texto": "s oblohy rosa kanula,"
  },
  {
   "texto": "a háj byl smutkem usmívavým."
  },
  {
   "texto": "A bylo slyšet šum a dech,"
  },
  {
   "texto": "jak hledá struny zlaté,"
  },
  {
   "texto": "poupátka k tanci vstávala,"
  },
  {
   "texto": "a každé bylo boubelaté."
  },
  {
   "texto": "Křidélka jako motýlek,"
  },
  {
   "texto": "jak andělíček líce —"
  },
  {
   "texto": "poznaly písně domov svůj,"
  },
  {
   "texto": "a sester měly na tisíce."
  }
 ]
}