 "nivel": "B2",
 "notaOrtografia": "Texto en NFC con los diacríticos checos de la fuente (háček, čárka, kroužek). La transcripción sigue la ortografía actual (infinitivo en «-t», «z» en cultismos). Nivel declarado a mano: la densidad polisilábica subestima el verso (monosílabos, frase corta) y lo pondría en A2.",
 "serie": {
  "id": "neruda-pisne-kosmicke",
  "titulo": "Písně kosmické",
  "orden": 12
 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "35"
  },
  {
   "texto": "Přijdou dnové, léta, věky, věků věky."
  },
  {
   "texto": "Kolem Slunce mdlobou hasnoucího"
  },
  {
   "texto": "kroužit budou planet mrtvoly."
  },
  {
   "texto": "Země bude siná, tichá, němá."
  },
  {
   "texto": "Dávno bude po všech lidstva synech -"
  },
  {
   "texto": "v prach a jíní rozpadla se těla,"
  },
  {
   "texto": "dávno bude po všech slávy činech -"
  },
  {
   "texto": "touha někam v vesmír odletěla;"
  },
  {
   "texto": "dávno po srdci i jeho bolu,"
  },
  {
   "texto": "dávno dohořelo milování,"
  },
  {
   "texto": "jásot odvanut i žalování,"
  },
  {
   "texto": "dávno, dávno, poslední co píseň"
  },
  {
   "texto": "zoufalou svou vzduchem chvěla tíseň -"
  },
  {
   "texto": "všechen život v mraznou ztuhnul plíseň,"
  },
  {
   "texto": "bol i radost v kámen ztuhly spolu."
  },
  {
   "texto": "K příkrovnímu, lhostejnému nebi"
  },
  {
   "texto": "povrch Země příšerně se šklebí,"
  },
  {
   "texto": "Zem je samá dlouhá, hlubná vráska."
  },
  {
   "texto": "Mrazný éter do povrchu pere,"
  },
  {
   "texto": "šklebinou se k Země nitru dere -"
  },
  {
   "texto": "Země puká tiše, nezapraská,"
  },
  {
   "texto": "Zem se trhá tiše, beze zvuku,"
  },
  {
   "texto": "Zem je němá, dožila svou muku. -"
  },
  {
   "texto": "Přejdou dnové, léta, věky, věků věky."
  },
  {
   "texto": "Šerou prostorou jak černá rakev"
  },
  {
   "texto": "Země krouží slabnouc, slabnouc v letu,"
  },
  {
   "texto": "jak když orel těžce postřelený"
  },
  {
   "texto": "ve spirále děsně obrovité"
  },
  {
   "texto": "dolů letí - letí - letí -"
  },
  {
   "texto": "Dopadne Země k Slunci zpět,"
  },
  {
   "texto": "ze Slunce šlehne plamů květ"
  },
  {
   "texto": "jak života na úsvitě,"
  },
  {
   "texto": "a vzdálené hvězdy a širý Svět"
  },
  {
   "texto": "zví, že se tu naposled - naposled"
  },
  {
   "texto": "líbají matka a dítě."
  },
  {
   "texto": "Aj, tamhle dřímavých jiskerek,"
  },
  {
   "texto": "jak když rukou rozhodí květů,"
  },
  {
   "texto": "to letí prostorou kometa,"
  },
  {
   "texto": "kostnice umrlých světů."
  },
  {
   "texto": "Hvězdo, oděná rubášem,"
  },
  {
   "texto": "dumnou nám píseň hudeš,"
  },
  {
   "texto": "v ní veliký obsah, málo slov:"
  },
  {
   "texto": "„Ty popel jsi, popel budeš!“"
  },
  {
   "texto": "A tamhle zásvit zas jako sen,"
  },
  {
   "texto": "jak když den se rozbřesknout bojí,"
  },
  {
   "texto": "tam prach se k novému životu"
  },
  {
   "texto": "v nebeském zákoutí pojí."
  },
  {
   "texto": "Příštích světů ty zábřesku,"
  },
  {
   "texto": "mlžino mladě žhnoucí,"
  },
  {
   "texto": "jakž ku srdci sáhá píseň tvá:"
  },
  {
   "texto": "„Zas vstanete s lící skvoucí!“"
  },
  {
   "texto": "Ó hvězdy, hymny vy zářivé,"
  },
  {
   "texto": "naslouchám vám v roznětu svatém,"
  },
  {
   "texto": "nechť smrt, či vzkříšení hlásáte,"
  },
  {
   "texto": "duši mi plníte zlatem!"
  },
  {
   "texto": "Srdce celičké vystláno"
  },
  {
   "texto": "nesmrtelnosti kvítím -"
  },
  {
   "texto": "co potřebuju já věčným být,"
  },
  {
   "texto": "když věčnost již teď procítím!"
  },
  {
   "texto": "37"
  },
  {
   "texto": "Ty věčné hlasy proroků,"
  },
  {
   "texto": "že také mrtvi budem,"
  },
  {
   "texto": "nuž ano, ano, víme to -"
  },
  {
   "texto": "my Světa nepřebudem!"
  },
  {
   "texto": "Co rozkvétá, to odkvétá,"
  },
  {
   "texto": "co vzešlo, zase chřadne,"
  },
  {
   "texto": "a Zem i s lidstvem rozkvětlým"
  },
  {
   "texto": "jak bílá růže zvadne."
  },
  {
   "texto": "Však proto smrti myšlénkou"
  },
  {
   "texto": "my srdce nezbodáme!"
  },
  {
   "texto": "My vyžijem a dožijem"
  },
  {
   "texto": "a Světu příklad dáme!"
  },
  {
   "texto": "Dřív Světa původ seznáme"
  },
  {
   "texto": "a sil všech tajné zdroje,"
  },
  {
   "texto": "dřív na dno časů sestoupnem"
  },
  {
   "texto": "a sečtem světů roje!"
  },
  {
   "texto": "Před žádnou, žádnou záhadou"
  },
  {
   "texto": "své šíje neskloníme,"
  },
  {
   "texto": "o nebes klenby nejzazší"
  },
  {
   "texto": "svým duchem zazvoníme!"
  },
  {
   "texto": "My umřem, avšak dříve si"
  },
  {
   "texto": "hrob vystelem slávou,"
  },
  {
   "texto": "Svět celý musí nad hrobem"
  },
  {
   "texto": "stát s obnaženou hlavou."
  },
  {
   "texto": "Až planety sklesnou k Slunci zpět"
  },
  {
   "texto": "a mrazem se Slunce rozskočí,"
  },
  {
   "texto": "až drobty ty, smrtí poštvány,"
  },
  {
   "texto": "si v divokou elipsu zabočí,"
  },
  {
   "texto": "až pohřební, truchlý průvod ten,"
  },
  {
   "texto": "pln hrůzy, prost života vděků,"
  },
  {
   "texto": "se vesmírem dalekým promete"
  },
  {
   "texto": "přes milion, milion věků;"
  },
  {
   "texto": "až konečně někde v koutečku"
  },
  {
   "texto": "se po letu dlouhém zastaví"
  },
  {
   "texto": "a prášek z nás světů bývalých"
  },
  {
   "texto": "se ve nový chaos rozžhaví,"
  },
  {
   "texto": "až v chaosu tam boj plamenný,"
  },
  {
   "texto": "boj titánský poznovu vzplane"
  },
  {
   "texto": "a z plamenů žárných až nový svět"
  },
  {
   "texto": "jak čarovný fénix zas vstane;"
  },
  {
   "texto": "až na novém, kyprém světě tom,"
  },
  {
   "texto": "boj ustoupí mladu životu"
  },
  {
   "texto": "a luh bude samý barev smích"
  },
  {
   "texto": "a háj plný sladkého šumotu,"
  },
  {
   "texto": "až na světě tom zas vypučí"
  },
  {
   "texto": "tvor se srdcem, se zpěvnou tísní:"
  },
  {
   "texto": "pak snad zase drobounký atom můj"
  },
  {
   "texto": "tam zazvoní kosmickou písní!"
  }
 ]
}