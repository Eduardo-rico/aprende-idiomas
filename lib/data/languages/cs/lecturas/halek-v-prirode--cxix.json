 },
 "variante": "cs",
 "modo": "texto",
 "parrafos": [
  {
   "texto": "CXIX."
  },
  {
   "texto": "Sluníčko boží"
  },
  {
   "texto": "z hory si vyskočí,"
  },
  {
   "texto": "v zlaceném loži"
  },
  {
   "texto": "červánkem zatočí."
  },
  {
   "texto": "V radosti pravé"
  },
  {
   "texto": "celý svět pozdraví,"
  },
  {
   "texto": "veselé, smavé,"
  },
  {
   "texto": "cestu si upraví."
  },
  {
   "texto": "Všude se staví,"
  },
  {
   "texto": "ke všem si pospěší,"
  },
  {
   "texto": "sílu dá, zdraví"
  },
  {
   "texto": "a slzy utěší."
  },
  {
   "texto": "Všeho si udbá,"
  },
  {
   "texto": "na všecko zavolá,"
  },
  {
   "texto": "jako když hudba"
  },
  {
   "texto": "zahraje do kola."
  },
  {
   "texto": "Všem blaho zmnoží,"
  },
  {
   "texto": "nejvíce člověku —"
  },
  {
   "texto": "sluníčko boží"
  },
  {
   "texto": "od věku do věku."
  },
  {
   "texto": "Na kvítka louky zelenavé"
  },
  {
   "texto": "dnes duše má mi rozkvetla,"
  },
  {
   "texto": "pak pila rosy poprchavé,"
  },
  {
   "texto": "pak rostla v modro, do světla."
  },
  {
   "texto": "Na teplých vánků hudbu hravou"
  },
  {
   "texto": "dnes duše má mi roztála,"
  },
  {
   "texto": "pak skladbu jara dojímavou"
  },
  {
   "texto": "všem kvítkům v tance zahrála."
  },
  {
   "texto": "Na zlatá křídla paprsková"
  },
  {
   "texto": "dnes duše má se povznáší,"
  },
  {
   "texto": "a s jarní hudbou kvítka nová"
  },
  {
   "texto": "do měkkých duší roznáší."
  },
  {
   "texto": "Ve kvítka hlavě zlatovlasé"
  },
  {
   "texto": "jsem našel moudrost všelikou,"
  },
  {
   "texto": "jak kapku rosy do průhledna,"
  },
  {
   "texto": "za svaté knihy velikou."
  },
  {
   "texto": "Tak sladkou, že z ní včelka jarní"
  },
  {
   "texto": "pel do všech úhlů rozváží,"
  },
  {
   "texto": "tak vznešenou, že polní skřivan"
  },
  {
   "texto": "až nebesa s ní proráží."
  },
  {
   "texto": "Tak dětinnou, že srdce staré"
  },
  {
   "texto": "vždy dojde u ní omlady,"
  },
  {
   "texto": "a pravdivou, že promění se"
  },
  {
   "texto": "jen s všehomíra základy."
  },
  {
   "texto": "Tak výmluvnou, že mluva její"
  },
  {
   "texto": "nad kejkle všecky, zázraky —"
  },
  {
   "texto": "tak mluví bůh, ne zahalený"
  },
  {
   "texto": "v keř ohnivý a v oblaky."
  },
  {
   "texto": "Vy stromy, v lesy spolčené,"
  },
  {
   "texto": "vy kamarádi švarní,"
  },
  {
   "texto": "na všechny spusťte nástroje"
  },
  {
   "texto": "a zahrajte nám jarní."
  },
  {
   "texto": "Tak po přátelsku veselou,"
  },
  {
   "texto": "jak čerpáte ji právě,"
  },
  {
   "texto": "když roznášejí prameny"
  },
  {
   "texto": "tu zeleň po doubravě."
  },
  {
   "texto": "Tak po mladicku lahodnou,"
  },
  {
   "texto": "jak kapete ji v číše,"
  },
  {
   "texto": "jež každé kvítko nastaví,"
  },
  {
   "texto": "že pěknou vůní dýše."
  },
  {
   "texto": "A v teplém hrajte oddechu,"
  },
  {
   "texto": "jak z pravé písně vane,"
  },
  {
   "texto": "kdy každý, kdo jen uslyší,"
  },
  {
   "texto": "má srdce dotýkané!"
  },
  {
   "texto": "Už vím, jak země mladne,"
  },
  {
   "texto": "jak probudí se v květ:"
  },
  {
   "texto": "když přijde jaro ladné"
  },
  {
   "texto": "a modrý upne hled."
  },
  {
   "texto": "A do moře pak sáhne,"
  },
  {
   "texto": "mrak vyndá, pozlatí:"
  },
  {
   "texto": "ten k ní co posel táhne"
  },
  {
   "texto": "a srdce uchvátí."
  },
  {
   "texto": "Pak kývne na své ptáky,"
  },
  {
   "texto": "tu zvukochlubnou krev:"
  },
  {
   "texto": "ti lítnou za oblaky,"
  },
  {
   "texto": "a božský hudou zpěv."
  },
  {
   "texto": "Pak výmluvně se schýlí"
  },
  {
   "texto": "a sluncem dýchne v ret —"
  },
  {
   "texto": "jak nemladnout tu chvíli,"
  },
  {
   "texto": "jak nebudit se v květ!"
  }
 ]
}