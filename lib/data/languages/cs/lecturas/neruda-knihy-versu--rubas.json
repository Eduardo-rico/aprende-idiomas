 "parrafos": [
  {
   "texto": "Jasno v horách, jasno v dole,"
  },
  {
   "texto": "paní obchází si pole."
  },
  {
   "texto": "„Což na jednom živobytí!"
  },
  {
   "texto": "ze lnu může rubáš býti;"
  },
  {
   "texto": "košilička dlouhá, bílá,"
  },
  {
   "texto": "ráda bych ji muži šila.“"
  },
  {
   "texto": "Paní ví, čím srdce vadne,"
  },
  {
   "texto": "ví, čím v těle krev vychladne."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Slunce jak by vyhořelo,"
  },
  {
   "texto": "podzim přišel, leto mřelo."
  },
  {
   "texto": "V letě manžel postonává,"
  },
  {
   "texto": "v podzim manžel dokonává."
  },
  {
   "texto": "„Nebudeš mne míti více,"
  },
  {
   "texto": "pojď sem k loži, rozžži svíce."
  },
  {
   "texto": "Svět se kolem se mnou točí,"
  },
  {
   "texto": "zatlač, paní, kalné oči."
  },
  {
   "texto": "Nemohu-li více žíti,"
  },
  {
   "texto": "pokojně chci v hrobě shníti."
  },
  {
   "texto": "Z hedbáví mně rubáš uší,"
  },
  {
   "texto": "jak se spravedlivým sluší."
  },
  {
   "texto": "Třeba dokonal já v pátek,"
  },
  {
   "texto": "neválej jej do mše v svátek."
  },
  {
   "texto": "Neupřádej ve sobotu,"
  },
  {
   "texto": "ať nepošleš na mne slotu,"
  },
  {
   "texto": "nemohl bych shnít pak v hrobě,"
  },
  {
   "texto": "smrt bys předla sama sobě.“"
  },
  {
   "texto": "Zvoní zvony na vše strany,"
  },
  {
   "texto": "zvoní, zvoní troje hrany."
  },
  {
   "texto": "Zvoní, zvoní na vše strany:"
  },
  {
   "texto": "Hladem chudí — jedem páni."
  },
  {
   "texto": "- - -"
  },
  {
   "texto": "Mračno v horách, mračno v dole —"
  },
  {
   "texto": "„Obohacím svaté pole.“"
  },
  {
   "texto": "Paní vraští bílé čelo:"
  },
  {
   "texto": "„Nač by hedbáví být mělo?"
  },
  {
   "texto": "Což s rubášem za novotu!"
  },
  {
   "texto": "Upředeme ve sobotu, —"
  },
  {
   "texto": "hotovi jsme do mše v svátek, —"
  },
  {
   "texto": "aj — proč zemřel manžel v pátek!“"
  },
  {
   "texto": "Dlouho, pane, nežli tobě"
  },
  {
   "texto": "zroste kvítí na tvém hrobě;"
  },
  {
   "texto": "dlouho, nežli tráva zroste —"
  },
  {
   "texto": "a již k svatbě jedou hosté!"
  },
  {
   "texto": "Jedou hosté, prach se zdvíhá —"
  },
  {
   "texto": "„Strojte hody, čas ubíhá!"
  },
  {
   "texto": "Ať se čistotou vše bělí,"
  },
  {
   "texto": "jizba, dům i dvůr můj celý!"
  },
  {
   "texto": "Aj, zde ještě lenost vaše"
  },
  {
   "texto": "nechá zbytky od rubáše."
  },
  {
   "texto": "Což nám babské do povídky —"
  },
  {
   "texto": "do plamenu s těmi zbytky!“"
  },
  {
   "texto": "Než se paní k ohni sehne,"
  },
  {
   "texto": "žhavý plamen ven vyšlehne."
  },
  {
   "texto": "Letí domem divá paní,"
  },
  {
   "texto": "letí rudý plamen za ní."
  },
  {
   "texto": "A než v poplach zvony bijí,"
  },
  {
   "texto": "plamen věnec svůj dovíjí;"
  },
  {
   "texto": "a než k pomoci se brali,"
  },
  {
   "texto": "černé kosti vyhrabali;"
  },
  {
   "texto": "a než hosté se tu sjeli,"
  },
  {
   "texto": "místo svatby — pohřeb měli."
  }
 ]
}